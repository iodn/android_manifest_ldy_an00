diff --git a/scripts/build-ldy-an00.sh b/scripts/build-ldy-an00.sh
new file mode 100755
index 0000000000000000000000000000000000000000..e35f01b4013859a859609bef37f19ecf1adead93
--- /dev/null
+++ b/scripts/build-ldy-an00.sh
@@ -0,0 +1,25 @@
+#!/bin/sh
+# Run from an Android Kleaf workspace; set SOURCE_DATE_EPOCH only to reproduce a build.
+set -eu
+
+workspace_dir=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
+if [ ! -x "$workspace_dir/tools/bazel" ]; then
+    echo "An Android Kleaf workspace with tools/bazel is required." >&2
+    exit 2
+fi
+
+SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH:-$(date -u +%s)}
+case "$SOURCE_DATE_EPOCH" in
+    *[!0-9]*|"") echo "SOURCE_DATE_EPOCH must be a positive Unix timestamp." >&2; exit 2 ;;
+esac
+if [ "$SOURCE_DATE_EPOCH" -le 0 ]; then
+    echo "SOURCE_DATE_EPOCH must be greater than zero." >&2
+    exit 2
+fi
+export SOURCE_DATE_EPOCH
+export KLEAF_EXTRA_GIT_PROJECTS="${KLEAF_EXTRA_GIT_PROJECTS:+${KLEAF_EXTRA_GIT_PROJECTS}:}common"
+printf 'Kernel build SOURCE_DATE_EPOCH=%s\n' "$SOURCE_DATE_EPOCH" >&2
+
+cd "$workspace_dir"
+exec tools/bazel build --config=stamp --lto=none --rust \
+    --sandbox_default_allow_network=false //common:kernel_aarch64
diff --git a/scripts/setlocalversion b/scripts/setlocalversion
index 5818465abba98461817bc86372bdcdb8b006e137..149f2ccb50e9d37a9fc65f8de71bfd2b2adf56b1 100755
--- a/scripts/setlocalversion
+++ b/scripts/setlocalversion
@@ -205,4 +205,7 @@ elif [ "${LOCALVERSION+set}" != "set" ]; then
 	scm_version="$(scm_version --short)"
 fi
 
-echo "${KERNELVERSION}${file_localversion}${config_localversion}${LOCALVERSION}${scm_version}"
+# Retain the GKI interface label alongside device branding, revision and page size.
+device_localversion="${file_localversion}${config_localversion}${LOCALVERSION}${scm_version}"
+device_localversion=$(printf '%s' "$device_localversion" | sed -E 's/^-LDY-AN00($|-)/\1/')
+echo "${KERNELVERSION}-LDY-AN00${device_localversion}"
