diff --git a/drivers/platform/ldy_reset_guard.c b/drivers/platform/ldy_reset_guard.c
new file mode 100644
index 0000000000000000000000000000000000000000..7be172810ead5ca5e120842d3b9dd95e811073c2
--- /dev/null
+++ b/drivers/platform/ldy_reset_guard.c
@@ -0,0 +1,206 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* HONOR LDY-AN00: lock-dependent MT6661 long-press reset control. */
+#include <linux/device.h>
+#include <linux/init.h>
+#include <linux/kobject.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+#include <linux/sysfs.h>
+#include <linux/uidgid.h>
+#include <linux/cred.h>
+#include "ldy_reset_guard_fields.h"
+
+static DEFINE_MUTEX(guard_lock);
+static struct device *key_device;
+static struct regmap *pmic_map;
+static unsigned int normal_enable, normal_mode;
+/* Opt-in: retain rescue until the framework has evaluated the user's setting. */
+static bool requested;
+static int applied = -1, last_error = -EAGAIN;
+
+static int guard_read(void *context, unsigned int reg, unsigned int *value)
+{
+	return regmap_read_bypassed(context, reg, value);
+}
+
+static int guard_update(void *context, unsigned int reg, unsigned int mask,
+			unsigned int value)
+{
+	return regmap_write_bits(context, reg, mask, value);
+}
+
+static int apply_locked(void)
+{
+	struct ldy_reset_io io = { pmic_map, guard_read, guard_update };
+
+	last_error = pmic_map ? ldy_reset_apply(&io, requested, normal_enable,
+						normal_mode) :
+				-EAGAIN;
+	applied = last_error ? -1 : requested;
+	return last_error;
+}
+
+static int guard_existing_device(struct device *dev, void *unused);
+
+static ssize_t protected_store(struct kobject *kobj,
+			       struct kobj_attribute *attr, const char *buf,
+			       size_t count)
+{
+	bool value;
+	int ret;
+
+	/* Enforce the init/root boundary even on permissive SELinux test boots. */
+	if (!uid_eq(current_euid(), GLOBAL_ROOT_UID))
+		return -EPERM;
+	if (sysfs_streq(buf, "1"))
+		value = true;
+	else if (sysfs_streq(buf, "0"))
+		value = false;
+	else
+		return -EINVAL;
+	/* Retry a transient regmap/snapshot failure on an already bound key driver. */
+	bus_for_each_dev(&platform_bus_type, NULL, NULL, guard_existing_device);
+	mutex_lock(&guard_lock);
+	requested = value;
+	ret = apply_locked();
+	mutex_unlock(&guard_lock);
+	if (ret)
+		return ret;
+	return count;
+}
+
+static ssize_t status_show(struct kobject *kobj, struct kobj_attribute *attr,
+			   char *buf)
+{
+	ssize_t count;
+
+	mutex_lock(&guard_lock);
+	count = sysfs_emit(buf,
+			   "requested=%u applied=%d attached=%u error=%d\n",
+			   requested, applied, pmic_map != NULL, last_error);
+	mutex_unlock(&guard_lock);
+	return count;
+}
+
+static struct kobj_attribute protected_attr =
+	__ATTR(protected, 0200, NULL, protected_store);
+static struct kobj_attribute status_attr = __ATTR_RO(status);
+static struct attribute *guard_attrs[] = { &protected_attr.attr,
+					   &status_attr.attr, NULL };
+static const struct attribute_group guard_group = { .attrs = guard_attrs };
+
+static bool is_honor_key_device(struct device *dev)
+{
+	u32 address[2];
+
+	return dev->parent &&
+	       of_device_is_compatible(dev->of_node, "mediatek,mt6661-keys") &&
+	       of_device_is_compatible(dev->parent->of_node,
+				       "mediatek,mt6661") &&
+	       !of_property_read_u32_array(dev->parent->of_node, "reg", address,
+					   2) &&
+	       address[0] == 4;
+}
+
+/* Called with the device bound, after the stock driver's reset setup has finished. */
+static void attach_locked(struct device *dev)
+{
+	struct regmap *map;
+	unsigned int enable, mode;
+	int ret;
+
+	if (key_device == dev || key_device || !dev->driver ||
+	    !is_honor_key_device(dev))
+		return;
+	map = dev_get_regmap(dev->parent, NULL);
+	if (!map) {
+		last_error = -ENODEV;
+		return;
+	}
+	ret = regmap_read_bypassed(map, LDY_RESET_ENABLE_REG, &enable);
+	if (!ret)
+		ret = regmap_read_bypassed(map, LDY_RESET_MODE_REG, &mode);
+	if (ret) {
+		last_error = ret;
+		return;
+	}
+	normal_enable = enable & LDY_RESET_ENABLE_MASK;
+	normal_mode = mode & LDY_RESET_MODE_MASK;
+	key_device = get_device(dev);
+	pmic_map = map;
+	/* No writes before a real protection request; the original state is already active. */
+	if (requested)
+		apply_locked();
+	else {
+		applied = 0;
+		last_error = 0;
+	}
+}
+
+static int guard_bus_event(struct notifier_block *nb, unsigned long event,
+			   void *data)
+{
+	struct device *dev = data;
+
+	if (event != BUS_NOTIFY_BOUND_DRIVER &&
+	    event != BUS_NOTIFY_UNBIND_DRIVER)
+		return NOTIFY_DONE;
+	mutex_lock(&guard_lock);
+	if (event == BUS_NOTIFY_BOUND_DRIVER)
+		attach_locked(dev);
+	else if (dev == key_device) {
+		struct ldy_reset_io io = { pmic_map, guard_read, guard_update };
+
+		last_error =
+			ldy_reset_apply(&io, 0, normal_enable, normal_mode);
+		if (last_error)
+			dev_err(dev,
+				"reset guard: restore on unbind failed: %d\n",
+				last_error);
+		put_device(key_device);
+		key_device = NULL;
+		pmic_map = NULL;
+		applied = -1;
+	}
+	mutex_unlock(&guard_lock);
+	return NOTIFY_OK;
+}
+
+static struct notifier_block guard_notifier = { .notifier_call =
+							guard_bus_event };
+
+static int guard_existing_device(struct device *dev, void *unused)
+{
+	if (!is_honor_key_device(dev))
+		return 0;
+	device_lock(dev);
+	mutex_lock(&guard_lock);
+	attach_locked(dev);
+	mutex_unlock(&guard_lock);
+	device_unlock(dev);
+	return 0;
+}
+
+static int __init ldy_reset_guard_init(void)
+{
+	struct kobject *kobj;
+	int ret;
+
+	kobj = kobject_create_and_add("ldy_reset_guard", kernel_kobj);
+	if (!kobj)
+		return -ENOMEM;
+	ret = sysfs_create_group(kobj, &guard_group);
+	if (ret)
+		goto failed;
+	ret = bus_register_notifier(&platform_bus_type, &guard_notifier);
+	if (ret)
+		goto failed;
+	bus_for_each_dev(&platform_bus_type, NULL, NULL, guard_existing_device);
+	return 0;
+failed:
+	kobject_put(kobj);
+	return ret;
+}
+late_initcall(ldy_reset_guard_init);
diff --git a/drivers/platform/ldy_reset_guard_fields.h b/drivers/platform/ldy_reset_guard_fields.h
new file mode 100644
index 0000000000000000000000000000000000000000..24ba2eb88fb20532d38709d319bc7c4385354adb
--- /dev/null
+++ b/drivers/platform/ldy_reset_guard_fields.h
@@ -0,0 +1,55 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef LDY_RESET_GUARD_FIELDS_H
+#define LDY_RESET_GUARD_FIELDS_H
+
+#include <linux/errno.h>
+
+#define LDY_RESET_ENABLE_REG 0xa16
+#define LDY_RESET_MODE_REG 0xa17
+#define LDY_RESET_ENABLE_MASK 0x1c
+#define LDY_RESET_MODE_MASK 0x30
+
+struct ldy_reset_io {
+	void *context;
+	int (*read)(void *context, unsigned int reg, unsigned int *value);
+	int (*update)(void *context, unsigned int reg, unsigned int mask,
+		      unsigned int value);
+};
+
+/* Match the stock LP_DISABLE sequence; preserve timeout and smart-reset bits. */
+static inline int ldy_reset_apply(struct ldy_reset_io *io, int protect,
+				  unsigned int normal_enable,
+				  unsigned int normal_mode)
+{
+	unsigned int first_reg = protect ? LDY_RESET_ENABLE_REG :
+					   LDY_RESET_MODE_REG;
+	unsigned int first_mask = protect ? LDY_RESET_ENABLE_MASK :
+					    LDY_RESET_MODE_MASK;
+	unsigned int first_value = protect ? 0 : normal_mode;
+	unsigned int second_reg = protect ? LDY_RESET_MODE_REG :
+					    LDY_RESET_ENABLE_REG;
+	unsigned int second_mask = protect ? LDY_RESET_MODE_MASK :
+					     LDY_RESET_ENABLE_MASK;
+	unsigned int second_value = protect ? LDY_RESET_MODE_MASK :
+					      normal_enable;
+	unsigned int value;
+	int ret;
+
+	/* Verify disable before selection changes, and selection before reset is re-enabled. */
+	ret = io->update(io->context, first_reg, first_mask, first_value);
+	if (ret)
+		return ret;
+	ret = io->read(io->context, first_reg, &value);
+	if (ret)
+		return ret;
+	if ((value & first_mask) != first_value)
+		return -EIO;
+	ret = io->update(io->context, second_reg, second_mask, second_value);
+	if (ret)
+		return ret;
+	ret = io->read(io->context, second_reg, &value);
+	if (ret)
+		return ret;
+	return (value & second_mask) == second_value ? 0 : -EIO;
+}
+#endif
