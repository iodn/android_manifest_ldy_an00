diff --git a/drivers/platform/Kconfig b/drivers/platform/Kconfig
index 960fd6a82450a4c7b97d51ea3bc29795ee74efd1..00508dfb3b795d0304d1089009bccdc56c281e78 100644
--- a/drivers/platform/Kconfig
+++ b/drivers/platform/Kconfig
@@ -18,3 +18,14 @@ source "drivers/platform/surface/Kconfig"
 source "drivers/platform/x86/Kconfig"
 
 source "drivers/platform/arm64/Kconfig"
+
+config LDY_AN00_LOCKED_RESET_GUARD
+	bool "HONOR LDY-AN00 locked-device reset guard"
+	depends on ARM64 && OF && REGMAP && SYSFS
+	help
+	  Provide a restricted control for the MT6661 key-reset sources on
+	  HONOR LDY-AN00. Init explicitly requests lock-state protection and
+	  restores the original reset configuration when it ends. Normal key
+	  interrupts remain enabled. No register writes occur before opt-in.
+	  A locked-state kernel hang may require recovery without the usual
+	  long-press reset combination. This does not modify the bootloader.
