 scripts/setlocalversion | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/scripts/setlocalversion b/scripts/setlocalversion
index 5818465ab..2024fe04a 100755
--- a/scripts/setlocalversion
+++ b/scripts/setlocalversion
@@ -205,4 +205,7 @@ elif [ "${LOCALVERSION+set}" != "set" ]; then
 	scm_version="$(scm_version --short)"
 fi
 
-echo "${KERNELVERSION}${file_localversion}${config_localversion}${LOCALVERSION}${scm_version}"
+# Keep device branding separate from the GKI label, retaining revision and page size.
+device_localversion="${file_localversion}${config_localversion}${LOCALVERSION}${scm_version}"
+device_localversion=$(printf '%s' "$device_localversion" | sed -E 's/^-android[0-9]+-[0-9]+//')
+echo "${KERNELVERSION}-LDY-AN00${device_localversion}"
