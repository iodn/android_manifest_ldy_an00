From 70f67f1acd5b4871106fb7e9e945fd8bd764816a Mon Sep 17 00:00:00 2001
From: iodn <114117719+iodn@users.noreply.github.com>
Date: Wed, 11 Nov 2026 20:24:47 +0000
Subject: [PATCH] Retain GKI interface name for automatic kernel recognition

Change-Id: I92ccff8ec688152bdc3549dbb719ec4a32d7a95b
---
 scripts/setlocalversion | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/scripts/setlocalversion b/scripts/setlocalversion
index eafffc08e..149f2ccb5 100755
--- a/scripts/setlocalversion
+++ b/scripts/setlocalversion
@@ -205,7 +205,7 @@ elif [ "${LOCALVERSION+set}" != "set" ]; then
 	scm_version="$(scm_version --short)"
 fi
 
-# Keep device branding separate from the GKI label, retaining revision and page size.
+# Retain the GKI interface label alongside device branding, revision and page size.
 device_localversion="${file_localversion}${config_localversion}${LOCALVERSION}${scm_version}"
-device_localversion=$(printf '%s' "$device_localversion" | sed -E 's/^-android[0-9]+-[0-9]+//; s/^-LDY-AN00($|-)/\1/')
+device_localversion=$(printf '%s' "$device_localversion" | sed -E 's/^-LDY-AN00($|-)/\1/')
 echo "${KERNELVERSION}-LDY-AN00${device_localversion}"
-- 
2.53.0

