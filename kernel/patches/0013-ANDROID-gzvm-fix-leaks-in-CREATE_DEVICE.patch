From d8eddc5fb80b3061efc6541dda5ca97315374f0a Mon Sep 17 00:00:00 2001
From: Willie-TH Huang <willie-th.huang@mediatek.com>
Date: Wed, 4 Nov 2026 14:47:51 +0800
Subject: [PATCH 13/13] ANDROID: gzvm: fix leaks in CREATE_DEVICE

free_pages_exact(ptr, 0) frees nothing, and the attr_size check
returns before gzvm_dev is freed. Free each buffer with its real size
and route that error through the common cleanup label.

Also drop the eventfd context reference on the kmalloc() and EEXIST
error paths in gzvm_assign_ioeventfd().

Bug: 585395913
Signed-off-by: Willie-TH Huang <willie-th.huang@mediatek.com>
Change-Id: Ia702c6a6f72f357a75ca1d271eb8d8b04440f400

(cherry picked from Android common 49a783c9f498563f2aa26e0b5c8b956ce7ea7301)
Signed-off-by: iodn <114117719+iodn@users.noreply.github.com>
---
 drivers/virt/geniezone/gzvm_ioeventfd.c |  4 +++-
 drivers/virt/geniezone/gzvm_vm.c        | 12 ++++++++----
 2 files changed, 11 insertions(+), 5 deletions(-)

diff --git a/drivers/virt/geniezone/gzvm_ioeventfd.c b/drivers/virt/geniezone/gzvm_ioeventfd.c
index 98afcfdd4..4ab14e2a1 100644
--- a/drivers/virt/geniezone/gzvm_ioeventfd.c
+++ b/drivers/virt/geniezone/gzvm_ioeventfd.c
@@ -150,8 +150,10 @@ static int gzvm_assign_ioeventfd(struct gzvm *gzvm, struct gzvm_ioeventfd *args)
 		return PTR_ERR(evt_ctx);
 
 	evt = kmalloc(sizeof(*evt), GFP_KERNEL);
-	if (!evt)
+	if (!evt) {
+		eventfd_ctx_put(evt_ctx);
 		return -ENOMEM;
+	}
 	*evt = (struct gzvm_ioevent) {
 		.addr = args->addr,
 		.len = args->len,
diff --git a/drivers/virt/geniezone/gzvm_vm.c b/drivers/virt/geniezone/gzvm_vm.c
index 7d885eacd..a36df53e1 100644
--- a/drivers/virt/geniezone/gzvm_vm.c
+++ b/drivers/virt/geniezone/gzvm_vm.c
@@ -194,6 +194,7 @@ static int gzvm_vm_ioctl_create_device(struct gzvm *gzvm, void __user *argp)
 {
 	struct gzvm_create_device *gzvm_dev;
 	void *dev_data = NULL;
+	size_t dev_data_size = 0;
 	int ret;
 
 	gzvm_dev = (struct gzvm_create_device *)alloc_pages_exact(PAGE_SIZE,
@@ -210,14 +211,17 @@ static int gzvm_vm_ioctl_create_device(struct gzvm *gzvm, void __user *argp)
 		void __user *attr_addr = u64_to_user_ptr(gzvm_dev->attr_addr);
 
 		/* Size of device specific data should not be over a page. */
-		if (attr_size > PAGE_SIZE)
-			return -EINVAL;
+		if (attr_size > PAGE_SIZE) {
+			ret = -EINVAL;
+			goto err_free_dev;
+		}
 
 		dev_data = alloc_pages_exact(attr_size, GFP_KERNEL);
 		if (!dev_data) {
 			ret = -ENOMEM;
 			goto err_free_dev;
 		}
+		dev_data_size = attr_size;
 
 		if (copy_from_user(dev_data, attr_addr, attr_size)) {
 			ret = -EFAULT;
@@ -229,9 +233,9 @@ static int gzvm_vm_ioctl_create_device(struct gzvm *gzvm, void __user *argp)
 	ret = gzvm_arch_create_device(gzvm->vm_id, gzvm_dev);
 err_free_dev_data:
 	if (dev_data)
-		free_pages_exact(dev_data, 0);
+		free_pages_exact(dev_data, dev_data_size);
 err_free_dev:
-	free_pages_exact(gzvm_dev, 0);
+	free_pages_exact(gzvm_dev, PAGE_SIZE);
 	return ret;
 }
 
-- 
