diff --git a/services/audioflinger/sws0730_candidate/Sws0730Engine.cpp b/services/audioflinger/sws0730_candidate/Sws0730Engine.cpp
new file mode 100644
index 0000000..cc4b26e
--- /dev/null
+++ b/services/audioflinger/sws0730_candidate/Sws0730Engine.cpp
@@ -0,0 +1,43 @@
+#include "Sws0730Engine.h"
+#include <dlfcn.h>
+#include <memory>
+#include <mutex>
+namespace honor::sws0730 {
+namespace {
+struct LoadedEngine {
+    explicit LoadedEngine(void* value) : handle(value) {}
+    ~LoadedEngine() { dlclose(handle); }
+    void* const handle;
+    Capi functions;
+};
+std::mutex factoryMutex;
+std::weak_ptr<LoadedEngine> liveEngine;
+template<class T> bool resolve(void* handle, const char* name, T& out) {
+    dlerror();
+    void* symbol = dlsym(handle, name);
+    if (dlerror() || !symbol) return false;
+    out = reinterpret_cast<T>(symbol); // POSIX dlsym function-pointer conversion.
+    return true;
+}
+}
+std::optional<Capi> loadEngine() {
+    std::lock_guard lock(factoryMutex);
+    auto engine = liveEngine.lock();
+    if (!engine) {
+        void* handle = dlopen("lib64honorsound73.so", RTLD_NOW | RTLD_LOCAL);
+        if (!handle) return std::nullopt;
+        engine = std::make_shared<LoadedEngine>(handle);
+        auto& api = engine->functions;
+        if (!resolve(handle, "HonorSoundMobileGetSize", api.getSize) ||
+            !resolve(handle, "HonorSoundMobileInit", api.init) ||
+            !resolve(handle, "HonorSoundMobileChkPara", api.check) ||
+            !resolve(handle, "HonorSoundMobileSetPara", api.set) ||
+            !resolve(handle, "HonorSoundMobileApply", api.apply)) return std::nullopt;
+        api.execution = std::make_shared<std::mutex>();
+        liveEngine = engine;
+    }
+    Capi result = engine->functions;
+    result.library = std::move(engine);
+    return result;
+}
+}
