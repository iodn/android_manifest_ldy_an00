diff --git a/services/camera/libcameraservice/aidl/HonorFaceCameraId.h b/services/camera/libcameraservice/aidl/HonorFaceCameraId.h
new file mode 100644
index 0000000..d0fd95d
--- /dev/null
+++ b/services/camera/libcameraservice/aidl/HonorFaceCameraId.h
@@ -0,0 +1,26 @@
+// Copyright (C) 2026 The LineageOS Project
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+#include <private/android_filesystem_config.h>
+#include <string>
+#include <string_view>
+#include <sys/types.h>
+
+namespace android::frameworks::cameraservice::service::implementation {
+
+// The caller suffix never supplies a package name or bypasses CameraService authorization.
+inline std::string resolveHonorFaceCameraId(const std::string& original, uid_t callerUid,
+        std::string_view model, std::string_view device, std::string_view hardware) {
+    constexpr std::string_view suffix = "_vendor.honor.hardware.biometrics.hwfacerecognize";
+    if (callerUid != AID_SYSTEM || model != "LDY-AN00" || device != "ldy_an00"
+            || hardware != "mt6993" || original.size() <= suffix.size()
+            || original.compare(original.size() - suffix.size(), suffix.size(), suffix) != 0) {
+        return original;
+    }
+    const std::string cameraId = original.substr(0, original.size() - suffix.size());
+    return cameraId.find('_') == std::string::npos && cameraId.find(char{0}) == std::string::npos
+            ? cameraId : original;
+}
+
+} // namespace android::frameworks::cameraservice::service::implementation
