+    if (!found) return {};
+    error = prepared->mApi.check(prepared->mProfile.base.data(), prepared->mProfile.extended.data());
+    if (error) return {};
+    return prepared;
+}
+Status Core::commitPrepared(const PreparedProfile& prepared) {
+    // The owning output callback exclusively owns mutable Core state at this boundary.
+    if (mClosed) return Status::Closed;
+    if (mFailed) return Status::BackendFailure;
+    if (prepared.mPool.get() != mPool.get() ||
+        prepared.mApi.library.get() != mApi.library.get() ||
+        prepared.mApi.execution.get() != mApi.execution.get() ||
+        prepared.mApi.check != mApi.check) return Status::Invalid;
+    mProfile = prepared.mProfile; mControls = prepared.mControls;
+    mHpScene = prepared.mHpScene; mConfigured = true;
+    return Status::Ok;
+}
+void Core::resetQueues() { mQueue.reset(); mAux.clear(); mSeek = {}; }
+Status Core::configure(const Controls& controls, int& error) {
+    std::lock_guard lock(mMutex); error = 0;
+    if (mClosed) return Status::Closed;
+    if (mFailed) return Status::BackendFailure;
+    if (controls.level < -758 || controls.level > 0) return Status::Invalid;
+    Profile profile; int hpScene = mHpScene;
+    const bool found = controls.route == Controls::Route::Speaker ?
+        mPool->select(controls.speakerKey(), profile) :
+        headphoneProfile(*mPool, controls, profile, hpScene);
+    if (!found) return Status::Invalid;
+    if ((error = mApi.check(profile.base.data(), profile.extended.data()))) {
+        mFailed = true;
+        return Status::BackendFailure;
+    }
+    mProfile = profile;
+    mControls = controls; mHpScene = hpScene; mConfigured = true;
+    return Status::Ok;
+}
+Status Core::seek(int value) {
+    std::lock_guard lock(mMutex);
+    if (mClosed) return Status::Closed;
+    mSeek.set(value, mControls.userEnable);
+    return Status::Ok;
+}
+Status Core::process(std::span<const int32_t> input, std::span<int32_t> output, int& error,
+                     std::optional<bool> runtimeGate) {
+    std::lock_guard lock(mMutex); error = 0;
+    if (mClosed) return Status::Closed;
+    if (mFailed) return Status::BackendFailure;
+    if (!mConfigured || input.size() != output.size() || input.size() % 2 ||
+        input.size() > mStage.size()) return Status::Invalid;
+    // Stock replays SetPara before every output callback, even for unchanged records.
+    if ((error = mApi.set(mBank0.data(), mScratch, mProfile.base.data(),
+                          mProfile.extended.data()))) {
+        mFailed = true;
+        return Status::BackendFailure;
+    }
+    mSeek.beforeCallback();
+    int raw = mControls.userEnable != 0 && runtimeGate.value_or(mControls.processingGate != 0);
+    if (mControls.route != Controls::Route::Speaker && (mHpScene == 0 || mHpScene == 7))
+        raw = 0;
+    const bool fade = raw || mHpScene == 0 || mHpScene == 7; // Selected gUiType1.
+    for (size_t frame = 0; frame < input.size() / 2; ++frame) {
+        if (mQueue.push(input[2 * frame], input[2 * frame + 1])) {
+            alignas(8) auto block = mAux.process(mQueue.pending(), fade);
+            alignas(16) Config cfg{block.data(), mAlgorithmOutput.data(), 480,
+                                   uint32_t(raw), 0, mControls.level, 2, 2};
+            if ((error = mApi.apply(mBank0.data(), mBank1.data(), mScratch, &cfg))) {
+                mFailed = true;
+                return Status::BackendFailure; // Caller output unchanged.
+            }
+            mSeek.process(mAlgorithmOutput, mControls.userEnable, raw);
+            if (!mQueue.commit(mAlgorithmOutput)) {
+                mFailed = true; return Status::BackendFailure;
+            }
+        }
+        if (!mQueue.pop(mStage.data() + 2 * frame)) {
+            mFailed = true; return Status::BackendFailure;
+        }
+    }
+    std::copy_n(mStage.begin(), input.size(), output.begin());
+    return Status::Ok;
+}
+void Core::close() {
+    std::lock_guard lock(mMutex);
+    if (mClosed) return;
+    mClosed = true; mConfigured = false;
+    for (auto& region : mMemory) region.reset();
+    mBank0.fill(nullptr); mBank1.fill(nullptr); mScratch = nullptr;
+    mPool.reset(); mApi.library.reset(); mApi.execution.reset(); resetQueues();
+}
+}
diff --git a/services/audioflinger/sws0730_candidate/Sws0730.h b/services/audioflinger/sws0730_candidate/Sws0730.h
