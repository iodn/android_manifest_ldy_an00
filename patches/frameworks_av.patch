@@ -0,0 +1,390 @@
+// SPDX-License-Identifier: Apache-2.0
+// Lifecycle plumbing only. The substituted engine NEVER returns apply success.
+#define HONOR_SWS_OWNER_LIFECYCLE_TEST 1
+#include "Sws0730Owner.cpp"
+#include <utils/Thread.h>
+#include <array>
+#include <atomic>
+#include <cassert>
+#include <chrono>
+#include <cstdlib>
+#include <iostream>
+#include <new>
+#include <pthread.h>
+#include <thread>
+
+using namespace honor::sws0730;
+namespace {
+thread_local size_t allocations = 0, releases = 0;
+std::array<std::atomic<void*>, 256> banks{};
+std::atomic<size_t> bankFrees{0}, wrongBankThread{0}, applyCalls{0};
+std::atomic<uintptr_t> workerId{0};
+std::atomic<size_t> checkCalls{0}, setCalls{0};
+std::atomic<int> lastRaw{-1};
+std::atomic<bool> blockCheck{false}, checkEntered{false}, releaseCheck{false};
+uintptr_t threadId() { return static_cast<uintptr_t>(pthread_self()); }
+void track(void* p) {
+    for (auto& slot : banks) {
+        void* empty = nullptr;
+        if (slot.compare_exchange_strong(empty, p)) return;
+    }
+    std::abort();
+}
+template<class Predicate> void await(Predicate predicate) {
+    const auto until = std::chrono::steady_clock::now() + std::chrono::seconds(5);
+    while (!predicate()) {
+        assert(std::chrono::steady_clock::now() < until);
+        std::this_thread::yield();
+    }
+}
+int getSize(uint32_t* sizes, const Config*) {
+    const uint32_t expected[]{10256, 585224, 129840, 135364};
+    std::copy(std::begin(expected), std::end(expected), sizes);
+    return 0;
+}
+int initialize(void** a, void** b) {
+    const auto id = threadId();
+    const auto prior = workerId.exchange(id);
+    assert(prior == 0 || prior == id);
+    for (size_t i = 0; i < 3; ++i) { track(a[i]); track(b[i]); }
+    return 0; // Allocation/ownership plumbing only, not native DSP initialization.
+}
+int check(const void*, const void*) {
+    ++checkCalls;
+    if (blockCheck.load()) {
+        checkEntered = true;
+        while (!releaseCheck.load()) std::this_thread::yield();
+    }
+    return 0;
+}
+int set(void**, void*, const void*, const void*) { ++setCalls; return 0; }
+int apply(void**, void**, void*, const Config* cfg) {
+    lastRaw = cfg->rawFlag;
+    ++applyCalls;
+    return -777; // Fail closed. No simulated DSP output or success.
+}
+FrameworkControl control(int handle) {
+    FrameworkControl c;
+    c.spec.outputHandle = handle; c.spec.allocationEpoch = 1;
+    c.spec.sampleRate = 48000; c.spec.channels = 2;
+    c.spec.outputFlags = 2; c.spec.maxFrames = 480;
+    c.spec.format = PcmFormat::Int16; c.spec.normalMixer = true;
+    c.routeEpoch = c.revision = 1; c.musicIndex = 8; c.confirmedSpeaker = true;
+    return c;
+}
+}
+void* operator new(size_t n) {
+    if (void* p = std::malloc(n ? n : 1)) { ++allocations; return p; }
+    throw std::bad_alloc();
+}
+void operator delete(void* p) noexcept { if (p) ++releases; std::free(p); }
+void operator delete(void* p, size_t) noexcept { ::operator delete(p); }
+void* operator new[](size_t n) { return ::operator new(n); }
+void operator delete[](void* p) noexcept { ::operator delete(p); }
+void operator delete[](void* p, size_t) noexcept { ::operator delete(p); }
+extern "C" void __real_free(void*);
+extern "C" void __wrap_free(void* p) {
+    if (p) for (auto& slot : banks) {
+        void* found = p;
+        if (slot.compare_exchange_strong(found, nullptr)) {
+            ++bankFrees;
+            if (threadId() != workerId.load()) ++wrongBankThread;
+            break;
+        }
+    }
+    __real_free(p);
+}
+namespace honor::sws0730 {
+std::optional<Capi> loadEngine() {
+    Capi api;
+    api.getSize = getSize; api.init = initialize; api.check = ::check;
+    api.set = ::set; api.apply = ::apply;
+    api.library = std::make_shared<int>(1);
+    api.execution = std::make_shared<std::mutex>();
+    return api;
+}
+// The only private seam, available solely in this test translation unit.
+// All production operations still use the real owner, mailbox and CommandThread.
+struct OwnerLifecycleTestAccess {
+    static std::array<uint64_t,5> counters(const std::shared_ptr<OutputState>& s) {
+        return {s->mCoreRaw0NewCalls.load(),s->mCoreRaw1NewCalls.load(),
+                s->mSkippedNewCalls.load(),s->mBackendFailureNewCalls.load(),
+                s->mUnknownNewCalls.load()};
+    }
+    static uint64_t outcome(const std::shared_ptr<OutputState>& s) {
+        return s->mLastOutcome.load();
+    }
+    static std::array<uint64_t,3> calls(const std::shared_ptr<OutputState>& s) {
+        return {s->mProcessed.load(),s->mRefused.load(),s->mRetries.load()};
+    }
+    static void drain() { OutputRegistry::instance().mWorker.wait_for_all_tasks(); }
+    static void enqueue(std::function<void()> task) {
+        assert(OutputRegistry::instance().mWorker.add("test-barrier", std::move(task)));
+    }
+    static bool ready(const std::shared_ptr<OutputState>& s) { return s->mReady.load(); }
+    static bool closed(const std::shared_ptr<OutputState>& s) { return s->mClosed.load(); }
+    static bool mailbox(const std::shared_ptr<OutputState>& s) {
+        return s->mReaderMailbox.load() != nullptr;
+    }
+    static bool retained(const std::shared_ptr<OutputState>& s) {
+        bool found = false;
+        enqueue([&] {
+            const auto& m = OutputRegistry::instance().mStates;
+            const auto i = m.find(s->mHandle);
+            found = i != m.end() && i->second.get() == s.get();
+        });
+        drain();
+        return found;
+    }
+};
+}
+using Access = OwnerLifecycleTestAccess;
+struct Barrier {
+    std::atomic<bool> entered{false}, released{false};
+    Barrier() {
+        Access::enqueue([this] {
+            entered = true;
+            while (!released.load()) std::this_thread::yield();
+        });
+        await([&] { return entered.load(); });
+    }
+    void release() { released = true; Access::drain(); }
+    ~Barrier() { assert(released.load()); }
+};
+void close(const std::shared_ptr<OutputState>& s) {
+    s->retire(); s->readerJoined(); Access::drain();
+    assert(Access::closed(s) && !Access::mailbox(s));
+}
+void prematureMailbox(uint64_t allocation) {
+    auto c = control(101); c.spec.allocationEpoch = allocation;
+    Barrier barrier;
+    auto s = OutputState::create(c);
+    assert(!Access::mailbox(s));
+    std::array<int16_t, 960> input{}; input.fill(123);
+    auto bytes = std::span<uint8_t>(reinterpret_cast<uint8_t*>(input.data()), sizeof(input));
+    const auto before = applyCalls.load();
+    const auto a = allocations, d = releases;
+    auto r = s->process(c.spec, {1, 1, 1, true, {true, true, true}}, bytes);
+    assert(r.disposition == OutputDisposition::Unqualified);
+    assert(allocations == a && releases == d);
+    barrier.release();
+    assert(Access::ready(s) && Access::mailbox(s));
+    const auto a2 = allocations, d2 = releases;
+    r = s->process(c.spec, {1, 1, 1, true, {true, false, false}}, bytes);
+    assert(r.disposition == OutputDisposition::Unqualified && r.replayed &&
+           r.decision.known && r.decision.shouldProcess && r.decision.runtimeGate &&
+           applyCalls == before);
+    assert(allocations == a2 && releases == d2);
+    r = s->process(c.spec, {2, 1, 1, true, {true, true, true}}, bytes);
+    assert(r.disposition == OutputDisposition::BackendFailure && r.nativeError == -777);
+    assert(applyCalls == before + 1);
+    for (auto v : input) assert(v == 123); // Error output does not corrupt sink.
+    const auto a3 = allocations, d3 = releases;
+    r = s->process(c.spec, {2, 1, 1, true, {true, true, true}}, bytes);
+    assert(r.replayed && r.disposition == OutputDisposition::BackendFailure);
+    assert(applyCalls == before + 1 && allocations == a3 && releases == d3);
+    close(s);
+}
+void pendingRetire() {
+    auto c = control(102);
+    Barrier barrier;
+    auto s = OutputState::create(c);
+    s->retire();
+    barrier.release();
+    assert(!Access::closed(s) && !Access::mailbox(s));
+    s->readerJoined(); Access::drain();
+    assert(Access::closed(s));
+}
+void retireDuringPrepare() {
+    blockCheck = true; checkEntered = false; releaseCheck = false;
+    auto s = OutputState::create(control(107));
+    await([&] { return checkEntered.load(); });
+    assert(Access::mailbox(s) && !Access::ready(s));
+    const auto before = bankFrees.load();
+    s->retire();
+    releaseCheck = true; Access::drain(); blockCheck = false;
+    assert(!Access::closed(s) && Access::mailbox(s) && bankFrees == before);
+    s->readerJoined(); Access::drain();
+    assert(Access::closed(s) && bankFrees >= before + 6);
+}
+void staleReadyAndHandleReuse() {
+    auto c = control(103);
+    auto old = OutputState::create(c); Access::drain();
+    assert(Access::ready(old) && Access::retained(old));
+    auto invalid = c; invalid.spec.sampleRate = 44100; invalid.revision = 2;
+    old->update(invalid); Access::drain();
+    assert(!Access::ready(old)); // Regression: ContextMismatch used to retain ready=true.
+    auto replacement = OutputState::create(c); Access::drain();
+    assert(!Access::ready(replacement) && !Access::mailbox(replacement));
+    assert(Access::retained(old) && !Access::retained(replacement));
+    close(old);
+    replacement->update(c); Access::drain();
+    assert(Access::ready(replacement) && Access::retained(replacement));
+    old->readerJoined(); Access::drain(); // Late duplicate cleanup must not erase replacement.
+    assert(Access::retained(replacement) && Access::ready(replacement));
+    close(replacement);
+}
+void liveReaderRetainsHeavyResources() {
+    auto c = control(104);
+    auto s = OutputState::create(c); Access::drain();
+    assert(Access::ready(s));
+    const auto before = bankFrees.load();
+    std::atomic<bool> stop{false};
+    std::atomic<size_t> count{0};
+    std::thread reader([&] {
+        std::array<int16_t, 2> data{123, 456};
+        const auto a = allocations, d = releases;
