+            if (quiet < 11) { state = 0; prev = cur; continue; }
+            if (amp > 5 * std::abs(prev) &&
+                (std::abs(cur - prev) > 100 || std::abs(cur + prev) > 100)) return i;
+            budget = 13; state = 2; peak = amp; marked = i;
+        } else if (budget >= 1 && amp < 2 * peak) {
+            --budget; peak = std::max(peak, amp);
+        } else {
+            if (amp > 5 * std::abs(prev) &&
