+::honor::sws0730::FrameworkControl PlaybackThread::honorSwsControl_l() const {
+    using namespace ::honor::sws0730;
+    FrameworkControl control;
+    auto& spec = control.spec;
+    spec.outputHandle = mId;
+    spec.allocationEpoch = mHonorSwsAllocationEpoch;
+    spec.sampleRate = mSampleRate; spec.channels = mChannelCount;
+    spec.outputFlags = mOutput ? static_cast<uint32_t>(mOutput->flags) : 0;
+    spec.maxFrames = mNormalFrameCount;
+    switch (mFormat) {
+        case AUDIO_FORMAT_PCM_16_BIT: spec.format = PcmFormat::Int16; break;
+        case AUDIO_FORMAT_PCM_32_BIT: spec.format = PcmFormat::Int32; break;
+        case AUDIO_FORMAT_PCM_FLOAT: spec.format = PcmFormat::Float32; break;
+        default: spec.format = PcmFormat::Unsupported;
+    }
+    spec.normalMixer = mType == MIXER;
+    spec.fastMixer = hasFastMixer(); spec.haptics = mHapticChannelCount != 0;
+    spec.spatializer = mType == SPATIALIZER; spec.duplicating = mType == DUPLICATING;
+    spec.bitPerfect = mOutput && (mOutput->flags & AUDIO_OUTPUT_FLAG_BIT_PERFECT);
+    control.routeEpoch = mHonorSwsControls.routeEpoch;
+    control.revision = mHonorSwsControls.revision;
+    control.musicIndex = mHonorSwsControls.musicIndex;
+    control.confirmedSpeaker = mHonorSwsControls.confirmedSpeaker;
+    return control;
+}
+
+void PlaybackThread::publishHonorSwsControl() {
+    std::shared_ptr<::honor::sws0730::OutputState> owner;
+    ::honor::sws0730::FrameworkControl control;
+    {
+        audio_utils::lock_guard lock(mutex());
+        if (exitPending()) return;
+        owner = mHonorSwsOutput;
+        if (!owner) return;
+        control = honorSwsControl_l();
+    }
+    // The synchronous config requester queues preparation after the audio thread
+    // completed its event. No worker queue allocation occurs in create/release_l.
+    owner->update(control);
+}
