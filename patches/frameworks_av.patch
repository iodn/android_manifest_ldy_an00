index 0000000..a5c617f
--- /dev/null
+++ b/services/audioflinger/sws0730_candidate/Sws0730.h
@@ -0,0 +1,169 @@
+#pragma once
+#include <optional>
+// Research canonical stereo core. Not an Android effect or all-route integration.
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <map>
+#include <memory>
+#include <mutex>
+#include <span>
+#include <vector>
+
+namespace honor::sws0730 {
+constexpr size_t kFrames = 480, kSamples = 960;
+using Block = std::array<int32_t, kSamples>;
+struct alignas(8) Config {
+    int32_t* input;
+    int32_t* output;
+    uint32_t frames, rawFlag, unknown18;
+    int32_t level;
+    uint32_t format, channels;
+};
+static_assert(sizeof(void*) == 8 && sizeof(Config) == 40);
+static_assert(offsetof(Config, frames) == 0x10 && offsetof(Config, channels) == 0x24);
+struct Capi {
+    int (*getSize)(uint32_t*, const Config*) = nullptr;
+    int (*init)(void**, void**) = nullptr;
+    int (*check)(const void*, const void*) = nullptr;
+    int (*set)(void**, void*, const void*, const void*) = nullptr;
+    int (*apply)(void**, void**, void*, const Config*) = nullptr;
+    // Must own the verified engine DSO until all instances are closed.
+    std::shared_ptr<void> library;
+    // Factory-shared identity retained for prepared-profile compatibility checks.
+    // Core uses per-instance ownership/mMutex; it does not take this global lock.
+    std::shared_ptr<std::mutex> execution;
+};
+struct Profile {
+    alignas(8) std::array<uint8_t, 838> base;
+    alignas(8) std::array<uint8_t, 2640> extended;
+};
+struct Tables {
+    std::map<int, std::pair<int, int>> rows;
+    std::map<int, std::array<uint8_t, 838>> base;
+    std::map<int, std::array<uint8_t, 2552>> extended;
+    std::array<uint8_t, 576> headphoneTypes;
+    // spa, sdc, lph, tws1, tws2, sur, teh, asc1, asc2, act.
+    std::array<std::vector<uint8_t>, 10> blobs;
+};
+class TuningPool {
+public:
+    // Pointer tails refer to this owner's immutable blob storage.
+    TuningPool(const TuningPool&) = delete;
+    TuningPool& operator=(const TuningPool&) = delete;
+    TuningPool(TuningPool&&) = delete;
+    TuningPool& operator=(TuningPool&&) = delete;
+    static std::shared_ptr<const TuningPool> create(Tables tables);
+    bool select(int key, Profile& out) const;
+    bool headphoneType(Profile& p, int type) const;
+private:
+    explicit TuningPool(Tables tables);
+    void fix(int key, uintptr_t tws1, uintptr_t tws2);
+    Tables mTables;
+    std::map<int, std::array<uint8_t, 2640>> mExtended;
+};
+struct Controls {
+    enum class Route { Speaker, Headset, A2dp } route = Route::Speaker;
+    // These are engine defaults, not Honor Java/UI defaults.
+    int fold = 0, speakerMode = 0, scene = 0, volumeIndex = 5;
+    int userEnable = 0, processingGate = 0;
+    int headphoneMode = 1, headphoneType = 0; // InitSws defaults, not UI preference.
+    std::array<int16_t, 10> eq{};
+    int eqType = 0, globalEqLimit = 0;
+    uint8_t extraByte = 100; // InitSws writes this byte; native constructor initially zeros it.
+    uint16_t extraWord = 0;
+    int level = -32; // Truncation of native initial float -32.9999275; units unnamed.
+    int speakerKey() const;
+};
+bool headphoneProfile(const TuningPool&, const Controls&, Profile&, int& hpScene);
+class PreparedProfile {
+public:
+    // Control-thread preparation only; last owner release is also control-thread work.
+    static std::shared_ptr<const PreparedProfile> create(
+            Capi, std::shared_ptr<const TuningPool>, const Controls&, int& nativeError);
+    const Controls& controls() const { return mControls; }
+private:
+    friend class Core;
+    Capi mApi;
+    std::shared_ptr<const TuningPool> mPool;
+    Controls mControls;
+    Profile mProfile{};
+    int mHpScene = 0;
+};
+size_t raising(const Block&, unsigned channel);
+size_t falling(const Block&, unsigned channel);
+void fadeIn(Block&, size_t start, unsigned channel);
+void fadeOut(Block&, size_t start, unsigned channel);
+class Auxiliary {
+public:
+    void clear();
+    Block process(const Block&, bool fade);
+private:
+    std::array<int32_t, 96> mCache{};
+};
+struct SeekState {
+    int value = 0, counter = 0, latched = 0;
+    void set(int newValue, int userEnable);
+    void beforeCallback();
+    void process(Block&, int userEnable, int rawFlag);
+};
+enum class Status { Ok, Invalid, Closed, BackendFailure };
+class StereoQueue {
+public:
+    void reset();
+    bool push(int32_t left, int32_t right);
+    const Block& pending() const { return mInput; }
+    bool commit(const Block&);
+    bool pop(int32_t* stereo);
+private:
+    alignas(8) Block mInput{};
+    std::array<int32_t, 1920> mReady{};
+    size_t mPending = 0, mHead = 0, mTail = 960, mCount = 960;
+};
+enum class SinkPreparation { NeedsProcessing, Replayed, Invalid };
+class SinkGeneration {
+public:
+    explicit SinkGeneration(size_t capacity) : mBytes(capacity) {}
+    SinkPreparation prepare(uint64_t generation, std::span<uint8_t> sink);
+    bool capture(uint64_t generation, std::span<const uint8_t> sink);
+    void reset();
+private:
+    std::vector<uint8_t> mBytes;
+    uint64_t mGeneration = 0;
+    size_t mSize = 0;
+    bool mValid = false, mPrepared = false;
+};
+class Core {
+public:
+    static std::shared_ptr<Core> create(Capi api, std::shared_ptr<const TuningPool> pool,
+                                       size_t maxCallbackFrames, int& nativeError);
+    ~Core();
+    Status configure(const Controls&, int& nativeError);
+    // Callback-exclusive boundary operation: never race with configure/process/close.
+    // Prepared object must remain owned off callback; no shared-owner update here.
+    Status commitPrepared(const PreparedProfile&);
+    Status seek(int value);
+    Status process(std::span<const int32_t> input, std::span<int32_t> output,
+                   int& nativeError, std::optional<bool> runtimeGate = std::nullopt);
+    void close();
+private:
+    Core(Capi, std::shared_ptr<const TuningPool>, size_t);
+    bool initialize(int&);
+    void resetQueues();
+    mutable std::mutex mMutex;
+    Capi mApi;
+    std::shared_ptr<const TuningPool> mPool;
+    std::array<std::shared_ptr<void>, 7> mMemory;
+    alignas(16) std::array<void*, 3> mBank0{}, mBank1{};
+    void* mScratch = nullptr;
+    Controls mControls;
+    int mHpScene = 0;
+    bool mConfigured = false, mClosed = false, mFailed = false;
+    Auxiliary mAux;
+    SeekState mSeek;
+    Profile mProfile{};
+    alignas(8) Block mAlgorithmOutput{};
+    StereoQueue mQueue;
+    std::vector<int32_t> mStage;
+};
+}
diff --git a/services/audioflinger/sws0730_candidate/Sws0730Bundle.cpp b/services/audioflinger/sws0730_candidate/Sws0730Bundle.cpp
new file mode 100644
index 0000000..6d1cb7a
--- /dev/null
+++ b/services/audioflinger/sws0730_candidate/Sws0730Bundle.cpp
@@ -0,0 +1,75 @@
+#include "Sws0730Bundle.h"
+#include <cstring>
+#include <limits>
+#include <utility>
+namespace honor::sws0730 {
+namespace {
+struct Reader {
+    std::span<const uint8_t> bytes;
+    size_t offset = 0;
+    bool read(void* out, size_t count) {
+        if (count > bytes.size() - offset) return false;
+        std::memcpy(out, bytes.data() + offset, count); offset += count; return true;
+    }
+    bool u32(uint32_t& out) {
+        uint8_t b[4];
+        if (!read(b, 4)) return false;
+        out = uint32_t(b[0]) | (uint32_t(b[1]) << 8) |
+              (uint32_t(b[2]) << 16) | (uint32_t(b[3]) << 24);
+        return true;
+    }
+    bool id(int& out) {
+        uint32_t value;
+        if (!u32(value) || value > uint32_t(std::numeric_limits<int>::max())) return false;
+        out = int(value); return true;
+    }
+};
+}
+bool parseTuningBundle(std::span<const uint8_t> bytes, Tables& out) {
+    // This exact version is the pinned LDY0730 shape, not an extensible untrusted XML loader.
+    if (bytes.size() > 2 * 1024 * 1024) return false;
+    Reader r{bytes};
+    char magic[8]; uint32_t version, bases, extended, rows, hp, blobs;
+    if (!r.read(magic, 8) || std::memcmp(magic, "SWS0730B", 8) ||
+        !r.u32(version) || version != 1 || !r.u32(bases) || bases != 141 ||
+        !r.u32(extended) || extended != 141 || !r.u32(rows) || rows != 377 ||
+        !r.u32(hp) || hp != 576 || !r.u32(blobs) || blobs != 10) return false;
+    Tables result;
+    int previous = -1;
+    for (uint32_t i = 0; i < bases; ++i) {
+        int id; std::array<uint8_t, 838> value;
+        if (!r.id(id) || id <= previous || !(id & 1) || !r.read(value.data(), value.size()))
+            return false;
+        result.base.emplace(id, value); previous = id;
+    }
+    previous = -1;
+    for (uint32_t i = 0; i < extended; ++i) {
+        int id; std::array<uint8_t, 2552> value;
+        if (!r.id(id) || id <= previous || (id & 1) || !r.read(value.data(), value.size()))
+            return false;
+        result.extended.emplace(id, value); previous = id;
+    }
+    previous = -1;
+    for (uint32_t i = 0; i < rows; ++i) {
+        int key, b, e;
+        if (!r.id(key) || key <= previous || !r.id(b) || !r.id(e) ||
+            !result.base.contains(b) || !result.extended.contains(e)) return false;
+        result.rows.emplace(key, std::pair{b,e}); previous = key;
+    }
+    if (!r.read(result.headphoneTypes.data(), result.headphoneTypes.size())) return false;
+    constexpr uint32_t sizes[] = {22572,24630,82120,131360,131360,5120,19200,4106,8210,1200};
+    for (uint32_t i = 0; i < 10; ++i) {
+        uint32_t index, size;
+        if (!r.u32(index) || index != i || !r.u32(size) || size != sizes[i]) return false;
+        result.blobs[i].resize(size);
+        if (!r.read(result.blobs[i].data(), size)) return false;
+    }
+    if (r.offset != bytes.size()) return false;
+    out = std::move(result); return true;
+}
+std::shared_ptr<const TuningPool> loadTuningBundle(std::span<const uint8_t> bytes) {
+    Tables tables;
+    if (!parseTuningBundle(bytes, tables)) return {};
+    return TuningPool::create(std::move(tables));
+}
+}
