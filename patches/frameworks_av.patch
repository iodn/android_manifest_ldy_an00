+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include <cstddef>
+#include <cstdint>
+namespace honor::sws0730 {
+// POD snapshots collected at the early prepareTracks boundary, before final-volume updates.
+struct GateInput {
+    size_t activeTracks = 0, eligibleTracks = 0, silentMusicTracks = 0;
+    uint32_t configuredChannelMask = 0, currentChannelMask = 0, deviceMask = 0;
+    bool normalMixer = false, hasFastMixer = false, anyPatch = false;
+    bool effectFlag = false, factory = false, diagnosticBypass = false;
+};
+struct RuntimeDecision {
+    bool known = false, shouldProcess = false, runtimeGate = false;
+};
+class GateState {
+public:
+    RuntimeDecision prepare(const GateInput&);
+    bool silenceBypass() const { return mSilenceBypass; }
+    int remaining() const { return mRemaining; }
+    // Count each active track once; mode must be a captured framework POD.
+    static bool eligible(int stream, bool isStatic);
+    static bool silentMusic(int stream, float previousFinalVolume, int mode, bool effectFlag);
+private:
+#ifdef HONOR_SWS_GATE_TEST
+    friend struct GateStateTestAccess;
+#endif
+    bool mSilenceBypass = false;
+    int mRemaining = 200;
+};
+} // namespace honor::sws0730
diff --git a/services/audioflinger/sws0730_candidate/Sws0730Mailbox.cpp b/services/audioflinger/sws0730_candidate/Sws0730Mailbox.cpp
new file mode 100644
index 0000000..e01499d
--- /dev/null
+++ b/services/audioflinger/sws0730_candidate/Sws0730Mailbox.cpp
@@ -0,0 +1,72 @@
+#include "Sws0730Mailbox.h"
+#include <cassert>
+namespace honor::sws0730 {
+std::unique_ptr<OutputMailbox> OutputMailbox::create(int32_t handle, size_t capacity) {
+    if(handle<=0 || !capacity || capacity>65536*8)return {};
+    return std::unique_ptr<OutputMailbox>(new OutputMailbox(handle,capacity));
+}
+OutputMailbox::OutputMailbox(int32_t handle, size_t capacity)
+    : mOutputHandle(handle),mCapacity(capacity),mSnapshot(capacity) {
+    mRetired.reserve(2);
+}
+OutputMailbox::~OutputMailbox() { quiescentClose(); }
+bool OutputMailbox::publish(OutputPublication publication) {
+    if(publication.spec.outputHandle!=mOutputHandle ||
+       (publication.adapter && publication.adapter->spec()!=publication.spec))return false;
+    auto next=std::make_unique<Entry>(std::move(publication));
+    auto old=std::move(mCurrent);
+    mCurrent=std::move(next);
+    mPublished.store(mCurrent.get(),std::memory_order_seq_cst);
+    if(old)mRetired.push_back(std::move(old));
+    collect();return true;
+}
+void OutputMailbox::collect() {
+    const Entry* protectedEntry=mHazard.load(std::memory_order_seq_cst);
+    for(auto i=mRetired.begin();i!=mRetired.end();) {
+        if(i->get()!=protectedEntry)i=mRetired.erase(i);
+        else ++i;
+    }
+}
+void OutputMailbox::quiescentClose() {
+    // Caller must have joined the reader; a null hazard alone does not prove quiescence.
+    assert(mHazard.load(std::memory_order_seq_cst)==nullptr);
+    mPublished.store(nullptr,std::memory_order_seq_cst);
+    mCurrent.reset();mRetired.clear();
+}
+OutputResult OutputMailbox::process(const OutputSpec& spec, const GenerationState& state,
+                                   std::span<uint8_t> sink) {
+    const size_t width=pcmSampleBytes(spec.format);
+    if(spec.outputHandle!=mOutputHandle || !spec.allocationEpoch || !state.generation || !width || spec.channels!=2 ||
+       sink.empty() || sink.size()>mCapacity || sink.size()%(2*width)) return {};
+    if(spec.allocationEpoch!=mReaderSpec.allocationEpoch) {
+        if(spec.allocationEpoch<mReaderSpec.allocationEpoch)return {};
+        mSnapshot.reset();mReaderSpec=spec;mReaderGeneration=0;
+    }
+    if(spec!=mReaderSpec || state.generation<mReaderGeneration)return {};
+    const auto cached=mSnapshot.prepare(state.generation,sink);
+    if(cached==SinkPreparation::Invalid)return {};
+    if(cached==SinkPreparation::Replayed) {
+        auto result=mReaderResult;result.replayed=true;return result;
+    }
+    mReaderGeneration=state.generation;
+    OutputResult result{OutputDisposition::Unqualified,false,0,state.routeEpoch,state.controlRevision,state.decision};
+    // Standard load/publish/revalidate hazard protocol. Never dereference before validation.
+    for(unsigned attempt=0;attempt<2;++attempt) {
+        const Entry* entry=mPublished.load(std::memory_order_seq_cst);
+        mHazard.store(entry,std::memory_order_seq_cst);
+        if(entry!=mPublished.load(std::memory_order_seq_cst)) {
+            mHazard.store(nullptr,std::memory_order_seq_cst);continue;
+        }
+        if(entry) {
+            const auto& p=entry->publication;
+            if(p.spec==spec && p.routeEpoch==state.routeEpoch &&
+               p.controlRevision==state.controlRevision && p.adapter && p.prepared)
+                result=p.adapter->process(spec,state,p.prepared.get(),sink);
+        }
+        mHazard.store(nullptr,std::memory_order_seq_cst);break;
+    }
+    // Also freeze readiness refusal: an entry arriving on a partial retry cannot start DSP.
+    if(!mSnapshot.capture(state.generation,sink))return {};
+    mReaderResult=result;return result;
+}
+}
diff --git a/services/audioflinger/sws0730_candidate/Sws0730Mailbox.h b/services/audioflinger/sws0730_candidate/Sws0730Mailbox.h
new file mode 100644
index 0000000..71b82a5
--- /dev/null
+++ b/services/audioflinger/sws0730_candidate/Sws0730Mailbox.h
@@ -0,0 +1,40 @@
+#pragma once
+#include "Sws0730Output.h"
+#include <atomic>
+#include <utility>
+namespace honor::sws0730 {
+struct OutputPublication {
+    OutputSpec spec;
+    uint64_t routeEpoch = 0, controlRevision = 0;
+    std::shared_ptr<OutputAdapter> adapter;
+    std::shared_ptr<const PreparedProfile> prepared;
+};
+class OutputMailbox {
+public:
+    // Single control-worker producer, single output-callback reader.
+    // Capacity allocated on control worker; larger sink returns InvalidContext.
+    static std::unique_ptr<OutputMailbox> create(int32_t outputHandle, size_t maxEncodedBytes);
+    // Destructor/control methods only on worker AFTER callback exit/join.
+    ~OutputMailbox();
+    OutputMailbox(const OutputMailbox&) = delete;
+    OutputMailbox& operator=(const OutputMailbox&) = delete;
+    bool publish(OutputPublication); // Dedicated normal-priority control worker only.
+    void collect(); // Worker only; never wait for reader.
+    void quiescentClose(); // Worker only, after reader joined; no further process.
+    OutputResult process(const OutputSpec&, const GenerationState&, std::span<uint8_t>);
+private:
+    explicit OutputMailbox(int32_t outputHandle, size_t maxEncodedBytes);
+    struct Entry { explicit Entry(OutputPublication p) : publication(std::move(p)) {} OutputPublication publication; };
+    static_assert(std::atomic<const Entry*>::is_always_lock_free);
+    std::atomic<const Entry*> mPublished{nullptr}, mHazard{nullptr};
+    std::unique_ptr<Entry> mCurrent;
+    std::vector<std::unique_ptr<Entry>> mRetired;
+    const int32_t mOutputHandle;
+    const size_t mCapacity;
+    SinkGeneration mSnapshot;
+    // Reader-owned fields; worker never touches while reader is live.
+    OutputSpec mReaderSpec;
+    uint64_t mReaderGeneration = 0;
+    OutputResult mReaderResult;
+};
+}
diff --git a/services/audioflinger/sws0730_candidate/Sws0730Output.cpp b/services/audioflinger/sws0730_candidate/Sws0730Output.cpp
new file mode 100644
index 0000000..dbf780f
--- /dev/null
+++ b/services/audioflinger/sws0730_candidate/Sws0730Output.cpp
@@ -0,0 +1,77 @@
+#include "Sws0730Output.h"
+#include <utility>
+#include <algorithm>
+namespace honor::sws0730 {
+namespace {
+bool admitted(const OutputSpec& s) {
+    return s.outputHandle > 0 && s.allocationEpoch && s.sampleRate && s.channels == 2 &&
+            s.maxFrames && s.maxFrames <= 65536 && pcmSampleBytes(s.format) &&
+            (s.outputFlags == 2 || s.outputFlags == 8) && s.normalMixer &&
+            !s.fastMixer && !s.haptics && !s.spatializer && !s.bitPerfect && !s.duplicating;
+}
+}
+std::unique_ptr<OutputAdapter> OutputAdapter::create(
+        Capi api, std::shared_ptr<const TuningPool> pool, const OutputSpec& spec, int& error) {
+    error = 0;
+    if (!admitted(spec)) return {};
+    auto core = Core::create(std::move(api),std::move(pool),spec.maxFrames,error);
+    if (!core) return {};
+    return std::unique_ptr<OutputAdapter>(new OutputAdapter(std::move(core),spec));
+}
+OutputAdapter::OutputAdapter(std::shared_ptr<Core> core, const OutputSpec& spec)
+    : mCore(std::move(core)),mSpec(spec),
+      mSink(spec.maxFrames*2*pcmSampleBytes(spec.format)),
+      mInput(spec.maxFrames*2),mOutput(spec.maxFrames*2) {}
+OutputAdapter::~OutputAdapter() { close(); }
+OutputResult OutputAdapter::process(const OutputSpec& spec, const GenerationState& state,
+                                   const PreparedProfile* prepared, std::span<uint8_t> sink) {
+    const auto width=pcmSampleBytes(mSpec.format);
+    if (mClosed || mInvalid || spec != mSpec || !state.generation || sink.empty() ||
+        sink.size()%(2*width) || sink.size() > mSpec.maxFrames*2*width ||
+        state.generation < mLastGeneration) {
+        mInvalid = true; return {};
+    }
+    const auto cache=mSink.prepare(state.generation,sink);
+    if (cache==SinkPreparation::Invalid) { mInvalid=true; return {}; }
+    if (cache==SinkPreparation::Replayed) {
+        auto result=mLastResult; result.replayed=true; return result;
+    }
+    mLastGeneration=state.generation;
+    const bool current=state.routeEpoch >= mLatestRouteEpoch &&
+                       state.controlRevision >= mLatestControlRevision;
+    mLatestRouteEpoch=std::max(mLatestRouteEpoch,state.routeEpoch);
+    mLatestControlRevision=std::max(mLatestControlRevision,state.controlRevision);
+    OutputResult result{OutputDisposition::Unqualified,false,0,state.routeEpoch,
+                        state.controlRevision,state.decision};
+    if (state.decision.known && !state.decision.shouldProcess) {
+        result.disposition=OutputDisposition::Skipped;
+    } else if (state.decision.known && state.decision.shouldProcess &&
+        state.confirmedSpeaker && state.routeEpoch && state.controlRevision &&
+        current && prepared &&
+        prepared->controls().route==Controls::Route::Speaker) {
+        const size_t samples=sink.size()/width;
+        auto input=std::span(mInput).first(samples), output=std::span(mOutput).first(samples);
+        if (!decodeStereo(mSpec.format,sink,input)) result.disposition=OutputDisposition::InvalidInput;
+        else {
+            const auto committed=mCore->commitPrepared(*prepared);
+            if (committed==Status::Ok) {
+                const auto status=mCore->process(input,output,result.nativeError,state.decision.runtimeGate);
+                if (status==Status::Ok) {
+                    if (!encodeStereo(mSpec.format,output,sink)) {
+                        mInvalid=true; return {};
+                    }
+                    result.disposition=OutputDisposition::Processed;
+                } else result.disposition=OutputDisposition::BackendFailure;
+            } else if (committed==Status::BackendFailure || committed==Status::Closed)
+                result.disposition=OutputDisposition::BackendFailure;
+        }
+    }
+    // Cache unchanged encoded input on refusal/failure as well; never rerun same callback.
+    if (!mSink.capture(state.generation,sink)) { mInvalid=true; return {}; }
+    mLastResult=result; return result;
+}
+void OutputAdapter::close() {
+    if (mClosed) return;
+    mClosed=true; mCore->close(); mCore.reset();
+}
+}
diff --git a/services/audioflinger/sws0730_candidate/Sws0730Output.h b/services/audioflinger/sws0730_candidate/Sws0730Output.h
new file mode 100644
index 0000000..1b08975
--- /dev/null
+++ b/services/audioflinger/sws0730_candidate/Sws0730Output.h
@@ -0,0 +1,55 @@
+#pragma once
+#include "Sws0730.h"
+#include "Sws0730Pcm.h"
+#include "Sws0730Gate.h"
+namespace honor::sws0730 {
+struct OutputSpec {
+    int32_t outputHandle = 0;
+    uint64_t allocationEpoch = 0;
+    uint32_t sampleRate = 0, channels = 0, outputFlags = 0;
+    size_t maxFrames = 0;
+    PcmFormat format = PcmFormat::Unsupported;
+    bool normalMixer = false, fastMixer = false, haptics = false;
+    bool spatializer = false, bitPerfect = false, duplicating = false;
+    bool operator==(const OutputSpec&) const = default;
+};
+struct GenerationState {
+    uint64_t generation = 0, routeEpoch = 0, controlRevision = 0;
+    bool confirmedSpeaker = false;
+    RuntimeDecision decision;
+};
+enum class OutputDisposition { Processed, Skipped, Unqualified, InvalidInput, BackendFailure, InvalidContext };
+struct OutputResult {
+    OutputDisposition disposition = OutputDisposition::InvalidContext;
+    bool replayed = false;
+    int nativeError = 0;
+    uint64_t routeEpoch = 0, controlRevision = 0;
+    RuntimeDecision decision;
+};
+class OutputAdapter {
+public:
+    OutputAdapter(const OutputAdapter&) = delete;
+    OutputAdapter& operator=(const OutputAdapter&) = delete;
+    OutputAdapter(OutputAdapter&&) = delete;
+    OutputAdapter& operator=(OutputAdapter&&) = delete;
+    // Control-thread create/retire only. No concurrent process/control/close calls.
+    static std::unique_ptr<OutputAdapter> create(
+            Capi, std::shared_ptr<const TuningPool>, const OutputSpec&, int& nativeError);
+    ~OutputAdapter();
+    const OutputSpec& spec() const { return mSpec; }
+    // One callback owner. Borrowed prepared remains owned by caller off callback.
+    // Sink is the whole encoded generation, not the remaining partial-write slice.
+    OutputResult process(const OutputSpec&, const GenerationState&, const PreparedProfile*,
+                         std::span<uint8_t> sink);
+    void close(); // After callback exit/join, outside AF/effect locks, on control thread.
+private:
+    OutputAdapter(std::shared_ptr<Core>, const OutputSpec&);
+    std::shared_ptr<Core> mCore;
+    const OutputSpec mSpec;
+    SinkGeneration mSink;
+    std::vector<int32_t> mInput, mOutput;
+    uint64_t mLastGeneration = 0, mLatestRouteEpoch = 0, mLatestControlRevision = 0;
+    OutputResult mLastResult;
+    bool mClosed = false, mInvalid = false;
+};
+}
diff --git a/services/audioflinger/sws0730_candidate/Sws0730Owner.cpp b/services/audioflinger/sws0730_candidate/Sws0730Owner.cpp
new file mode 100644
index 0000000..cda1d3a
--- /dev/null
+++ b/services/audioflinger/sws0730_candidate/Sws0730Owner.cpp
@@ -0,0 +1,229 @@
+// SPDX-License-Identifier: Apache-2.0
+#include "Sws0730Owner.h"
+#include "Sws0730Bundle.h"
+#include "Sws0730Engine.h"
+#include <condition_variable>
+#include <audio_utils/CommandThread.h>
+#include <utils/Log.h>
+#include <fstream>
+#include <map>
+#include <optional>
+#include <sstream>
+#include <vector>
+
+namespace honor::sws0730 {
+class OutputRegistry {
+public:
+    static OutputRegistry& instance() {
+        // No quit/destructor: queued owner captures must never be discarded on an AF caller.
+        [[clang::no_destroy]] static OutputRegistry registry;
+        return registry;
+    }
+    void enqueue(const char* name, const std::shared_ptr<OutputState>& state,
+                 std::optional<FrameworkControl> control) {
+        const bool accepted = mWorker.add(name, [this, state, control] {
+            if (control) prepare(state, *control);
+            else finish(state);
+        });
+        // mWorker is private, process-lifetime and never quit. Its only rejection is quit.
+        LOG_ALWAYS_FATAL_IF(!accepted, "SWS control worker unexpectedly rejected a task");
+    }
+private:
+#ifdef HONOR_SWS_OWNER_LIFECYCLE_TEST
+    friend struct OwnerLifecycleTestAccess;
+#endif
+    enum Setup { Pending, BackendUnavailable, AwaitingControls, Unqualified,
+                 Ready, Retired, Closed, ContextMismatch, NativeFailure };
+    bool backend() {
+        if (mAttempted) return mApi.has_value() && mPool;
+        mAttempted = true;
+        constexpr size_t size = 914208;
+        std::ifstream file("/system_ext/etc/honor/sws0730.bin", std::ios::binary | std::ios::ate);
+        if (!file || file.tellg() != std::streampos(size)) return false;
+        std::vector<uint8_t> bytes(size);
+        file.seekg(0);
+        if (!file.read(reinterpret_cast<char*>(bytes.data()), bytes.size())) return false;
+        auto pool = loadTuningBundle(bytes);
+        auto api = loadEngine();
+        if (!pool || !api) return false;
+        mPool = std::move(pool); mApi = std::move(api);
+        return true;
+    }
+    void prepare(const std::shared_ptr<OutputState>& state, const FrameworkControl& control) {
+        if (state->mRetired.load()) { finish(state); return; }
+        auto [slot, inserted] = mStates.emplace(state->mHandle, state);
+        if (!inserted && slot->second.get() != state.get()) {
+            state->mSetup.store(ContextMismatch); return;
+        }
+        if (control.spec.outputHandle != state->mHandle ||
+            control.spec.allocationEpoch < state->mWorkerAllocation ||
+            (control.spec.allocationEpoch == state->mWorkerAllocation &&
+                    control.revision < state->mWorkerRevision)) return;
+        state->mWorkerAllocation = control.spec.allocationEpoch;
+        state->mWorkerRevision = control.revision;
+        state->mAllocation.store(control.spec.allocationEpoch);
+        state->mRoute.store(control.routeEpoch); state->mRevision.store(control.revision);
+        state->mRate.store(control.spec.sampleRate); state->mFlags.store(control.spec.outputFlags);
+        state->mFrames.store(control.spec.maxFrames);
+        if (!state->mMailbox) {
+            state->mMailbox = OutputMailbox::create(state->mHandle, 65536 * 8);
+            if (!state->mMailbox) { state->mSetup.store(ContextMismatch); return; }
+            if (!state->mRetired.load()) {
+                state->mReaderMailbox.store(state->mMailbox.get(), std::memory_order_release);
+            }
+        }
+        if (!backend()) { state->mSetup.store(BackendUnavailable); return; }
+        if (state->mRetired.load()) { finish(state); return; }
+        state->mMailbox->collect();
+        if (control.musicIndex < 0 || control.musicIndex > 15) {
+            state->mReady.store(false); state->mSetup.store(AwaitingControls); return;
+        }
+        if (!control.confirmedSpeaker || !control.routeEpoch || !control.revision) {
+            state->mReady.store(false); state->mSetup.store(Unqualified); return;
+        }
+        int error = 0;
+        if (!state->mAdapter || state->mAdapter->spec() != control.spec) {
+            if (state->mAdapter &&
+                    control.spec.allocationEpoch <= state->mAdapter->spec().allocationEpoch) {
+                state->mReady.store(false);
+                state->mSetup.store(ContextMismatch); return;
+            }
+            auto adapter = OutputAdapter::create(*mApi, mPool, control.spec, error);
+            if (!adapter) {
+                state->mReady.store(false); state->mNativeError.store(error);
+                state->mSetup.store(error ? NativeFailure : Unqualified); return;
+            }
+            state->mAdapter = std::shared_ptr<OutputAdapter>(std::move(adapter));
+        }
+        // Native constructor proves fold/mode/scene=0. Stock PostProcInitSws sends
+        // HIFIPARA=true (userEnable=1); framework gate remains caller-proven, never guessed.
+        Controls controls;
+        controls.userEnable = 1;
+        // The callback supplies the proven per-generation raw gate; not a profile revision.
+        controls.processingGate = 0;
+        controls.volumeIndex = control.musicIndex;
+        auto prepared = PreparedProfile::create(*mApi, mPool, controls, error);
+        if (!prepared) {
+            state->mReady.store(false); state->mNativeError.store(error);
+            state->mSetup.store(error ? NativeFailure : Unqualified); return;
+        }
+        if (state->mRetired.load()) { finish(state); return; }
+        const bool published = state->mMailbox->publish(
+                {control.spec, control.routeEpoch, control.revision, state->mAdapter, prepared});
+        state->mReady.store(published); state->mNativeError.store(error);
+        state->mSetup.store(published ? Ready : ContextMismatch);
+    }
+    void finish(const std::shared_ptr<OutputState>& state) {
+        if (!state->mRetired.load() || !state->mJoined.load()) return;
+        state->mReaderMailbox.store(nullptr, std::memory_order_release);
+        state->mReady.store(false);
+        if (state->mMailbox) {
+            state->mMailbox->quiescentClose();
+            state->mMailbox.reset();
+        }
+        state->mAdapter.reset(); // All final Core/DSO/pool owner release stays on worker.
+        state->mSetup.store(Closed); state->mClosed.store(true);
+        const auto it = mStates.find(state->mHandle);
+        if (it != mStates.end() && it->second.get() == state.get()) mStates.erase(it);
+    }
+    bool mAttempted = false;
+    std::optional<Capi> mApi;
+    std::shared_ptr<const TuningPool> mPool;
+    std::map<int32_t, std::shared_ptr<OutputState>> mStates;
+    // Separate from AF/TB callback queues; 120 means SCHED_OTHER nice0.
+    android::audio_utils::CommandThread mWorker{"LDY_SwsControl", 120};
+};
+std::shared_ptr<OutputState> OutputState::create(const FrameworkControl& control) {
+    if (control.spec.outputHandle <= 0) return {};
+    auto state = std::shared_ptr<OutputState>(new OutputState(control.spec.outputHandle));
+    OutputRegistry::instance().enqueue("create", state, control);
+    return state;
+}
+void OutputState::update(const FrameworkControl& control) {
+    if (!mRetired.load()) OutputRegistry::instance().enqueue("prepare", shared_from_this(), control);
+}
+void OutputState::retire() { mRetired.store(true); }
+void OutputState::readerJoined() {
+    mRetired.store(true); mJoined.store(true);
+    OutputRegistry::instance().enqueue("retire", shared_from_this(), std::nullopt);
+}
+OutputResult OutputState::process(const OutputSpec& spec, const GenerationState& state,
+                                 std::span<uint8_t> sink) {
+    OutputResult result{OutputDisposition::Unqualified, false, 0,
+                        state.routeEpoch, state.controlRevision,state.decision};
+    if (spec.outputHandle != mHandle || !spec.allocationEpoch || !state.generation) return {};
+    const bool retry = spec.allocationEpoch == mLastCallAllocation
+            && state.generation == mLastCallGeneration;
+    mLastCallAllocation = spec.allocationEpoch; mLastCallGeneration = state.generation;
+    auto* mailbox = mReaderMailbox.load(std::memory_order_acquire);
+    if (!mailbox) {
+        if (!retry) mNoMailboxResult = result;
+        result = mNoMailboxResult;
+        result.replayed = retry;
+        mNoMailboxAllocation = spec.allocationEpoch;
+        mNoMailboxGeneration = state.generation;
+    } else if (mNoMailboxAllocation != spec.allocationEpoch ||
+               mNoMailboxGeneration != state.generation) {
+        result = mailbox->process(spec, state, sink);
+    } else {
+        result = mNoMailboxResult;
+        result.replayed = retry;
+    }
+    // A mailbox arriving mid-partial-write must not start DSP in that pending raw generation.
+    if (retry) mRetries.fetch_add(1, std::memory_order_relaxed);
+    else {
+        if (result.disposition == OutputDisposition::Processed) {
+            mProcessed.fetch_add(1, std::memory_order_relaxed);
+            // Processed means Core accepted this callback, including initial queue prefill.
+            // It does not prove a native Apply call occurred or an audible DSP result.
+            if (result.decision.known && result.decision.shouldProcess) {
+                auto& counter = result.decision.runtimeGate ? mCoreRaw1NewCalls : mCoreRaw0NewCalls;
+                counter.fetch_add(1, std::memory_order_relaxed);
+            }
+        } else {
+            mRefused.fetch_add(1, std::memory_order_relaxed);
+            if (result.disposition == OutputDisposition::Skipped)
+                mSkippedNewCalls.fetch_add(1, std::memory_order_relaxed);
+            else if (result.disposition == OutputDisposition::BackendFailure)
+                mBackendFailureNewCalls.fetch_add(1, std::memory_order_relaxed);
+        }
+        if (!result.decision.known) mUnknownNewCalls.fetch_add(1, std::memory_order_relaxed);
+    }
+    if (result.nativeError) mNativeError.store(result.nativeError, std::memory_order_relaxed);
+    const auto& decision = result.decision; // Cached result, never this retry's requested gate.
+    const uint64_t outcome = 1 | (uint64_t(decision.known) << 1)
+            | (uint64_t(decision.shouldProcess) << 2) | (uint64_t(decision.runtimeGate) << 3)
+            | (uint64_t(retry) << 4) | (uint64_t(result.replayed) << 5)
+            | (static_cast<uint64_t>(result.disposition) << 8);
+    mLastOutcome.store(outcome, std::memory_order_relaxed);
+    return result;
+}
+std::string OutputState::diagnostics() const {
+    std::ostringstream out;
+    const uint64_t latest = mLastOutcome.load(std::memory_order_relaxed);
+    out << "SWS output=" << mHandle << " ready=" << mReady.load()
+        << " retired=" << mRetired.load() << " joined=" << mJoined.load()
+        << " closed=" << mClosed.load()
+        << " mailbox=" << (mReaderMailbox.load(std::memory_order_acquire) != nullptr)
+        << " allocation=" << mAllocation.load()
+        << " rate=" << mRate.load() << " flags=" << mFlags.load()
+        << " frames=" << mFrames.load() << " route=" << mRoute.load()
+        << " revision=" << mRevision.load() << " setup=" << mSetup.load()
+        << " nativeError=" << mNativeError.load()
+        << " latestRecorded=" << (latest & 1)
+        << " latestKnown=" << ((latest >> 1) & 1)
+        << " latestShouldProcess=" << ((latest >> 2) & 1)
+        << " latestRuntimeGate=" << ((latest >> 3) & 1)
+        << " latestOwnerRetry=" << ((latest >> 4) & 1)
+        << " latestReplayed=" << ((latest >> 5) & 1)
+        << " latestDisposition=" << ((latest >> 8) & 0xff)
+        << " processedNewCalls=" << mProcessed.load() << " refusedNewCalls=" << mRefused.load()
+        << " retryCalls=" << mRetries.load()
+        << " coreRaw0NewCalls=" << mCoreRaw0NewCalls.load()
+        << " coreRaw1NewCalls=" << mCoreRaw1NewCalls.load()
+        << " skippedNewCalls=" << mSkippedNewCalls.load()
+        << " backendFailureNewCalls=" << mBackendFailureNewCalls.load()
+        << " unknownDecisionNewCalls=" << mUnknownNewCalls.load();
+    return out.str();
+}
+} // namespace honor::sws0730
diff --git a/services/audioflinger/sws0730_candidate/Sws0730Owner.h b/services/audioflinger/sws0730_candidate/Sws0730Owner.h
new file mode 100644
index 0000000..231db1b
--- /dev/null
+++ b/services/audioflinger/sws0730_candidate/Sws0730Owner.h
@@ -0,0 +1,60 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include "Sws0730Mailbox.h"
+#include <atomic>
+#include <memory>
+#include <string>
+
+namespace honor::sws0730 {
+struct FrameworkControl {
+    OutputSpec spec;
+    uint64_t routeEpoch = 0, revision = 0;
+    int musicIndex = -1;
+    bool confirmedSpeaker = false;
+};
+class OutputRegistry;
+class OutputState : public std::enable_shared_from_this<OutputState> {
+public:
+    static std::shared_ptr<OutputState> create(const FrameworkControl&);
+    void update(const FrameworkControl&); // Control caller only, no AF raw capture.
+    void retire(); // Before requesting callback exit; does not free anything.
+    void readerJoined(); // ONLY after requestExitAndWait returned NO_ERROR.
+    OutputResult process(const OutputSpec&, const GenerationState&, std::span<uint8_t>);
+    std::string diagnostics() const; // Dump/control caller only.
+    OutputState(const OutputState&) = delete;
+    OutputState& operator=(const OutputState&) = delete;
+private:
+    friend class OutputRegistry;
+#ifdef HONOR_SWS_OWNER_LIFECYCLE_TEST
+    friend struct OwnerLifecycleTestAccess;
+#endif
+    explicit OutputState(int32_t outputHandle) : mHandle(outputHandle) {}
+    const int32_t mHandle;
+    std::atomic<bool> mRetired{false}, mJoined{false}, mReady{false}, mClosed{false};
+    std::atomic<OutputMailbox*> mReaderMailbox{nullptr};
+    static_assert(std::atomic<OutputMailbox*>::is_always_lock_free);
+    static_assert(std::atomic<uint64_t>::is_always_lock_free);
+    static_assert(std::atomic<int>::is_always_lock_free);
+    // Worker owns all heavy resources. Registry keeps State alive until joined cleanup.
+    std::unique_ptr<OutputMailbox> mMailbox;
+    std::shared_ptr<OutputAdapter> mAdapter;
+    uint64_t mWorkerAllocation = 0, mWorkerRevision = 0;
+    std::atomic<uint64_t> mAllocation{0}, mRoute{0}, mRevision{0};
+    std::atomic<uint32_t> mRate{0}, mFlags{0};
+    std::atomic<size_t> mFrames{0};
+    std::atomic<int> mSetup{0}, mNativeError{0};
+    std::atomic<uint64_t> mProcessed{0}, mRefused{0}, mRetries{0};
+    // Counts first calls per consecutive (allocation,generation), never frames/Apply calls.
+    // The single-reader producer must keep generations monotonic; partial retries do not count.
+    std::atomic<uint64_t> mCoreRaw0NewCalls{0}, mCoreRaw1NewCalls{0};
+    std::atomic<uint64_t> mSkippedNewCalls{0}, mBackendFailureNewCalls{0}, mUnknownNewCalls{0};
+    // One packed snapshot: recorded/known/should/raw/retry/replayed in bits0..5,
+    // disposition in bits8..15. A single dump load observes a coherent last outcome.
+    std::atomic<uint64_t> mLastOutcome{
+            static_cast<uint64_t>(OutputDisposition::InvalidContext) << 8};
+    // One callback reader only. No worker access to this readiness latch.
+    uint64_t mNoMailboxAllocation = 0, mNoMailboxGeneration = 0;
+    OutputResult mNoMailboxResult;
+    uint64_t mLastCallAllocation = 0, mLastCallGeneration = 0;
+};
+} // namespace honor::sws0730
diff --git a/services/audioflinger/sws0730_candidate/Sws0730Pcm.cpp b/services/audioflinger/sws0730_candidate/Sws0730Pcm.cpp
new file mode 100644
index 0000000..fa875ee
--- /dev/null
+++ b/services/audioflinger/sws0730_candidate/Sws0730Pcm.cpp
@@ -0,0 +1,52 @@
+#include "Sws0730Pcm.h"
+#include <audio_utils/primitives.h>
+#include <cmath>
+#include <cstring>
+#include <limits>
+namespace honor::sws0730 {
+size_t pcmSampleBytes(PcmFormat format) {
+    switch(format) {
+        case PcmFormat::Int16: return 2;
+        case PcmFormat::Float32: case PcmFormat::Int32: return 4;
+        default: return 0;
+    }
+}
+namespace {
+bool shape(PcmFormat format, const void* bytes, size_t count, size_t samples) {
+    const auto width=pcmSampleBytes(format);
+    return width && samples && !(samples%2) &&
+            samples<=std::numeric_limits<size_t>::max()/width &&
+            count==samples*width && reinterpret_cast<uintptr_t>(bytes)%width==0;
+}
+}
+bool decodeStereo(PcmFormat format, std::span<const uint8_t> input, std::span<int32_t> output) {
+    if(!shape(format,input.data(),input.size(),output.size())) return false;
+    switch(format) {
+        case PcmFormat::Int16:
+            memcpy_to_i32_from_i16(output.data(),reinterpret_cast<const int16_t*>(input.data()),
+                                  output.size()); return true;
+        case PcmFormat::Float32: {
+            const auto* values=reinterpret_cast<const float*>(input.data());
+            for(size_t i=0;i<output.size();++i) if(!std::isfinite(values[i])) return false;
+            memcpy_to_i32_from_float(output.data(),values,output.size()); return true;
+        }
+        case PcmFormat::Int32:
+            std::memcpy(output.data(),input.data(),input.size()); return true;
+        default: return false;
+    }
+}
+bool encodeStereo(PcmFormat format, std::span<const int32_t> input, std::span<uint8_t> output) {
+    if(!shape(format,output.data(),output.size(),input.size())) return false;
+    switch(format) {
+        case PcmFormat::Int16:
+            memcpy_to_i16_from_i32(reinterpret_cast<int16_t*>(output.data()),input.data(),
+                                  input.size()); return true;
+        case PcmFormat::Float32:
+            memcpy_to_float_from_i32(reinterpret_cast<float*>(output.data()),input.data(),
+                                    input.size()); return true;
+        case PcmFormat::Int32:
+            std::memcpy(output.data(),input.data(),output.size()); return true;
+        default: return false;
+    }
+}
+}
