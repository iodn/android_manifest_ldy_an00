+// SPDX-License-Identifier: Apache-2.0
+#include "Sws0730Gate.h"
+namespace honor::sws0730 {
+bool GateState::eligible(int stream, bool isStatic) {
+    return !isStatic && (stream == 2 || stream == 3 || stream == 4 || stream == 13);
+}
+bool GateState::silentMusic(int stream, float volume, int mode, bool effectFlag) {
+    return stream == 3 && volume == 0 && mode != 2 && mode != 3 && effectFlag;
+}
+RuntimeDecision GateState::prepare(const GateInput& in) {
+    // Reject inconsistent caller snapshots without advancing the native counter.
+    if (in.eligibleTracks > in.activeTracks || in.silentMusicTracks > in.activeTracks)
+        return {};
+    const bool positive = in.silentMusicTracks > 0 &&
+            in.silentMusicTracks == in.eligibleTracks;
+    if (!positive || in.configuredChannelMask != in.currentChannelMask) {
+        mSilenceBypass = false;
+        mRemaining = 200;
+    } else if (!mSilenceBypass && in.silentMusicTracks == in.activeTracks) {
+        const int old = mRemaining--;
+        if (old <= 0) mSilenceBypass = true;
+    } else {
+        mRemaining = 200;
+    }
+    const bool info2 = in.normalMixer && (!in.hasFastMixer ||
+            (in.deviceMask & 0x04000380) != 0 || in.anyPatch);
+    const bool should = in.effectFlag && !in.factory && !mSilenceBypass && info2;
+    return {true, should, in.eligibleTracks > 0 && !in.diagnosticBypass};
+}
+} // namespace honor::sws0730
