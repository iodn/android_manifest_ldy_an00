@@ -0,0 +1,31 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include <string_view>
+
+namespace android::honor_sws {
+// New framework-owned protocol. These are not private Honor HAL commands.
+inline constexpr std::string_view kMusicIndexKey = "lineage_sws_music_index";
+inline constexpr const char* kControlProperty = "ro.audio.honor_sws_output";
+
+inline bool parseMusicIndexPayload(std::string_view value, int& index) {
+    constexpr std::string_view prefix = "v1:speaker:";
+    if (value.size() <= prefix.size() || value.substr(0, prefix.size()) != prefix) return false;
+    const std::string_view digits = value.substr(prefix.size());
+    if (digits.size() == 1 && digits[0] >= '0' && digits[0] <= '9') {
+        index = digits[0] - '0';
+    } else if (digits.size() == 2 && digits[0] == '1'
+            && digits[1] >= '0' && digits[1] <= '5') {
+        index = 10 + digits[1] - '0';
+    } else {
+        return false;
+    }
+    return true;
+}
+
+inline bool isCanonicalMusicCommand(std::string_view command, std::string_view payload) {
+    return command.size() == kMusicIndexKey.size() + 1 + payload.size()
+            && command.substr(0, kMusicIndexKey.size()) == kMusicIndexKey
+            && command[kMusicIndexKey.size()] == '='
+            && command.substr(kMusicIndexKey.size() + 1) == payload;
+}
+} // namespace android::honor_sws
