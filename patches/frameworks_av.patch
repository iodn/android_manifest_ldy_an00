diff --git a/media/libaudiohal/impl/HonorLegacyVendorParameters_test.cpp b/media/libaudiohal/impl/HonorLegacyVendorParameters_test.cpp
new file mode 100644
index 0000000..cdbd701
--- /dev/null
+++ b/media/libaudiohal/impl/HonorLegacyVendorParameters_test.cpp
@@ -0,0 +1,93 @@
+// SPDX-License-Identifier: Apache-2.0
+// Include the internal implementation once to test it with generated AIDL types.
+#include <gtest/gtest.h>
+#include <android/binder_parcel.h>
+#include "ConversionHelperAidl.h"
+#include "DevicesFactoryHalAidl.cpp"
+
+namespace android {
+namespace {
+using Extension = aidl::android::media::audio::IHalAdapterVendorExtension;
+using Parameter = aidl::android::hardware::audio::core::VendorParameter;
+
+std::shared_ptr<Extension> localExtension() {
+    return ndk::SharedRefBase::make<HalAdapterVendorExtensionWrapper>(true);
+}
+
+TEST(HonorLegacyVendorParameters, RawKeysRemainOneId) {
+    auto ext = localExtension();
+    for (const auto& raw : {"audio_capability#sws_ui_type", "a;b", "", "x=a=b"}) {
+        std::vector<std::string> ids{"previous", "must be replaced"};
+        ASSERT_TRUE(ext->parseVendorParameterIds({}, raw, &ids).isOk());
+        ASSERT_EQ(1u, ids.size());
+        EXPECT_EQ(raw, ids.front());
+    }
+}
+
+TEST(HonorLegacyVendorParameters, RawValuesUseSyncOnly) {
+    auto ext = localExtension();
+    for (const auto& raw : {"HP_MODE=2", "x=1;x=2", "SWS_TYPEC_RESTORE=;", ""}) {
+        std::vector<Parameter> sync, async;
+        ASSERT_TRUE(ext->parseVendorParameters({}, raw, &sync, &async).isOk());
+        ASSERT_EQ(1u, sync.size());
+        EXPECT_EQ(raw, sync.front().id);
+        EXPECT_TRUE(async.empty());
+    }
+}
+
+TEST(HonorLegacyVendorParameters, NativeParcelableRoundTrip) {
+    auto ext = localExtension();
+    std::vector<Parameter> sync, async;
+    ASSERT_TRUE(ext->parseVendorParameters({}, "HP_MODE=2", &sync, &async).isOk());
+    auto parcel = ndk::ScopedAParcel(AParcel_create());
+    ASSERT_NE(nullptr, parcel.get());
+    ASSERT_EQ(STATUS_OK, sync.front().writeToParcel(parcel.get()));
+    ASSERT_EQ(STATUS_OK, AParcel_setDataPosition(parcel.get(), 0));
+    Parameter restored;
+    ASSERT_EQ(STATUS_OK, restored.readFromParcel(parcel.get()));
+    EXPECT_EQ("HP_MODE=2", restored.id);
+    // The holder is default-constructed by the real generated VendorParameter.
+    // No private Parcelable descriptor or handwritten wire layout is introduced.
+}
+
+TEST(HonorLegacyVendorParameters, FirstResponseIdIsUsed) {
+    auto ext = localExtension();
+    Parameter first, second;
+    first.id = "HONORIGNOREKEY=1";
+    second.id = "ignored=2";
+    std::string result = "previous";
+    ASSERT_TRUE(ext->processVendorParameters({}, {first, second}, &result).isOk());
+    EXPECT_EQ(first.id, result);
+}
+
+TEST(HonorLegacyVendorParameters, EmptyResponseRefused) {
+    std::string result = "unchanged";
+    EXPECT_FALSE(localExtension()->processVendorParameters({}, {}, &result).isOk());
+    EXPECT_EQ("unchanged", result);
+}
+}  // namespace
+}  // namespace android
+
+namespace android {
+namespace {
+TEST(HonorLegacyVendorParameters, ReturnedMarkerFollowsDeviceOptIn) {
+    Parameter value;
+    value.id = "HONORIGNOREKEY=1";
+    String8 result("standard=ok");
+    ASSERT_EQ(OK, fillKeyValuePairsFromVendorParameters(
+            localExtension(), {}, {value}, &result));
+    EXPECT_STREQ(property_get_bool("ro.audio.honor_legacy_parameters", false)
+            ? "standard=ok;1" : "standard=ok;HONORIGNOREKEY=1", result.c_str());
+}
+
+TEST(HonorLegacyVendorParameters, MultipleResponsesDoNotUnwrap) {
+    Parameter first, second;
+    first.id = "HONORIGNOREKEY=1";
+    second.id = "ignored=2";
+    String8 result;
+    ASSERT_EQ(OK, fillKeyValuePairsFromVendorParameters(
+            localExtension(), {}, {first, second}, &result));
+    EXPECT_STREQ("HONORIGNOREKEY=1", result.c_str());
+}
+}  // namespace
+}  // namespace android
