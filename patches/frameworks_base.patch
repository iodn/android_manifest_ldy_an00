+
+package com.android.server.health;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.fail;
+import static org.mockito.Mockito.*;
+
+import android.hardware.health.BatteryHealthData;
+import android.hardware.health.IHealth;
+import android.os.BatteryManager;
+import android.os.BatteryProperty;
+import android.os.RemoteException;
+import android.os.ServiceSpecificException;
+
+import androidx.test.filters.SmallTest;
+import androidx.test.runner.AndroidJUnit4;
+
+import org.junit.After;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.function.Supplier;
+
+@SmallTest
+@RunWith(AndroidJUnit4.class)
+public class HonorBatterySerialNumberTest {
+    // Synthetic fixture only; never a device's pack or device serial.
+    private static final String SERIAL = "PACKSN0ABCX12345";
+    private HealthServiceWrapperAidl mWrapper;
+
+    @After
+    public void tearDown() {
+        if (mWrapper != null) mWrapper.getHandlerThread().quitSafely();
+    }
+
+    @Test
+    public void parserAcceptsNativeShape() {
+        assertEquals(SERIAL, HonorBatterySerialNumber.parse(SERIAL + "\n"));
+    }
+
+    @Test
+    public void parserRejectsWrongLengthEncodingAndErrorText() {
+        for (String value : new String[] {"", "IC ERROR", "ERROR:Can't get sn from IC",
+                SERIAL + "0", SERIAL.substring(1), "PACKSN0GBCX12345", "PACKSN0aBCX12345",
+                "PACKSN0ABCX1234g", "PACKSN0ABC\u000012345", "PACKSN0ABCＸ12345"}) {
+            assertEquals("", HonorBatterySerialNumber.parse(value));
+        }
+    }
+
+    @Test
+    public void otherDeviceNeverReadsPrivateSerial() {
+        assertEquals("", HonorBatterySerialNumber.read("other", "ldy_an00", "mt6993",
+                () -> { throw new AssertionError("unexpected private read"); }));
+    }
+
+    private IHealth wrapper(Supplier<String> fallback) throws Exception {
+        IHealth hal = mock(IHealth.class);
+        HealthServiceWrapperAidl.ServiceManagerStub manager =
+                mock(HealthServiceWrapperAidl.ServiceManagerStub.class);
+        when(manager.waitForDeclaredService(HealthServiceWrapperAidl.SERVICE_NAME)).thenReturn(hal);
+        mWrapper = new HealthServiceWrapperAidl(null, manager, () -> 0, fallback);
+        return hal;
+    }
+
+    private BatteryProperty property() {
+        BatteryProperty property = new BatteryProperty();
+        property.setString("unchanged");
+        return property;
+    }
+
+    @Test
+    public void nonemptyHalSerialWinsWithoutPrivateRead() throws Exception {
+        IHealth hal = wrapper(() -> { throw new AssertionError("unexpected fallback"); });
+        BatteryHealthData data = new BatteryHealthData();
+        data.batterySerialNumber = "HAL-value";
+        when(hal.getBatteryHealthData()).thenReturn(data);
+        BatteryProperty property = property();
+        assertEquals(0, mWrapper.getProperty(BatteryManager.BATTERY_PROPERTY_SERIAL_NUMBER,
+                property));
+        assertEquals("HAL-value", property.getString());
+    }
+
+    @Test
+    public void nullAndEmptyHalSerialUseFreshFallback() throws Exception {
+        AtomicInteger reads = new AtomicInteger();
+        IHealth hal = wrapper(() -> reads.getAndIncrement() == 0 ? SERIAL : "");
+        BatteryHealthData data = new BatteryHealthData();
+        when(hal.getBatteryHealthData()).thenReturn(data);
+        BatteryProperty property = property();
+        assertEquals(0, mWrapper.getProperty(BatteryManager.BATTERY_PROPERTY_SERIAL_NUMBER,
+                property));
+        assertEquals(SERIAL, property.getString());
+        data.batterySerialNumber = "";
+        assertEquals(0, mWrapper.getProperty(BatteryManager.BATTERY_PROPERTY_SERIAL_NUMBER,
+                property));
+        assertEquals("", property.getString());
+        assertEquals(2, reads.get());
+    }
+
+    @Test
+    public void otherDevicePreservesNullHalSerial() throws Exception {
+        IHealth hal = wrapper(() -> HonorBatterySerialNumber.read("other", "ldy_an00",
+                "mt6993", () -> { throw new AssertionError("unexpected private read"); }));
+        when(hal.getBatteryHealthData()).thenReturn(new BatteryHealthData());
+        BatteryProperty property = property();
+        assertEquals(0, mWrapper.getProperty(BatteryManager.BATTERY_PROPERTY_SERIAL_NUMBER,
+                property));
+        assertEquals(null, property.getString());
+    }
+
+    @Test
+    public void unsupportedHalUsesValidSerial() throws Exception {
+        IHealth hal = wrapper(() -> SERIAL);
+        when(hal.getBatteryHealthData()).thenThrow(new UnsupportedOperationException());
+        BatteryProperty property = property();
+        assertEquals(0, mWrapper.getProperty(BatteryManager.BATTERY_PROPERTY_SERIAL_NUMBER,
+                property));
+        assertEquals(SERIAL, property.getString());
+    }
+
+    @Test
+    public void unsupportedWithoutSerialPreservesError() throws Exception {
+        IHealth hal = wrapper(() -> "");
+        when(hal.getBatteryHealthData()).thenThrow(new UnsupportedOperationException());
+        BatteryProperty property = property();
+        assertEquals(-1, mWrapper.getProperty(BatteryManager.BATTERY_PROPERTY_SERIAL_NUMBER,
+                property));
+        assertEquals("unchanged", property.getString());
+    }
+
+    @Test
+    public void serviceSpecificErrorNeverUsesFallback() throws Exception {
+        IHealth hal = wrapper(() -> { throw new AssertionError("unexpected fallback"); });
+        when(hal.getBatteryHealthData()).thenThrow(new ServiceSpecificException(7));
+        BatteryProperty property = property();
+        assertEquals(-2, mWrapper.getProperty(BatteryManager.BATTERY_PROPERTY_SERIAL_NUMBER,
+                property));
+        assertEquals("unchanged", property.getString());
+    }
+
+    @Test
+    public void remoteExceptionPropagatesWithoutFallback() throws Exception {
+        IHealth hal = wrapper(() -> { throw new AssertionError("unexpected fallback"); });
+        when(hal.getBatteryHealthData()).thenThrow(new RemoteException("test"));
+        BatteryProperty property = property();
+        try {
+            mWrapper.getProperty(BatteryManager.BATTERY_PROPERTY_SERIAL_NUMBER, property);
+            fail("RemoteException must propagate");
+        } catch (RemoteException expected) {
+            assertEquals("unchanged", property.getString());
+        }
+    }
+
+    @Test
+    public void partStatusDoesNotUseSerialFallback() throws Exception {
+        IHealth hal = wrapper(() -> { throw new AssertionError("unexpected fallback"); });
+        when(hal.getBatteryHealthData()).thenReturn(new BatteryHealthData());
+        BatteryProperty property = property();
+        assertEquals(0, mWrapper.getProperty(BatteryManager.BATTERY_PROPERTY_PART_STATUS, property));
+        assertEquals(0L, property.getLong());
+    }
+}
