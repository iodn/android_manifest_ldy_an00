+        assertEquals(0, mVendor.authCalls);
+        assertEquals(Error.HW_UNAVAILABLE, mCallback.error);
+    }
+
+    private static final class MemoryLockout implements HonorLdyAn00FaceLockout.Storage {
+        HonorLdyAn00FaceLockout.Record record;
+        boolean failWrites;
+        int writes;
+        @Override public HonorLdyAn00FaceLockout.Record read() { return record; }
+        @Override public void write(HonorLdyAn00FaceLockout.Record value) throws IOException {
+            if (failWrites) throw new IOException("Injected fsync failure");
+            record = value;
+            writes++;
+        }
+    }
+
+    private static final class RecordingCallback extends ISessionCallback.Default {
+        final Binder binder = new Binder();
+        int authSucceeded, faceId, error, errors, lockoutCleared, timedLockouts, sessionClosed;
+        int enrollments, enrolledId;
+        long challenge, revoked, authenticatorId = -1;
+        HardwareAuthToken hat;
+        int[] enumerated, removed;
+        @Override public IBinder asBinder() { return binder; }
+        @Override public void onChallengeGenerated(long value) { challenge = value; }
+        @Override public void onChallengeRevoked(long value) { revoked = value; }
+        @Override public void onAuthenticatorIdRetrieved(long value) { authenticatorId = value; }
+        @Override public void onEnrollmentsEnumerated(int[] value) { enumerated = value; }
+        @Override public void onEnrollmentsRemoved(int[] value) { removed = value; }
+        @Override public void onError(byte value, int vendor) { error = value; errors++; }
+        @Override public void onLockoutCleared() { lockoutCleared++; }
+        @Override public void onSessionClosed() { sessionClosed++; }
+        @Override public void onLockoutTimed(long duration) { timedLockouts++; }
+        @Override public void onEnrollmentProgress(int id, int remaining) {
+            assertEquals(0, remaining); enrollments++; enrolledId = id;
+        }
+        @Override public void onAuthenticationSucceeded(int id, HardwareAuthToken token) {
+            authSucceeded++; faceId = id; hat = token;
+        }
+    }
+
+    private static final class FakeVendor extends Binder {
+        static final long CHALLENGE = 0x1122334455667788L;
+        IBinder callback;
+        Runnable duringSetFlag, duringSetNotify, duringRelease;
+        boolean previewReceived;
+        boolean autoStartupAck = true, autoCloseAck = true, initQueued, initCanceled, releaseQueued;
+        int groupCalls, releaseCalls, expectedUser, initCalls, notifyCalls;
+        byte[] enrollmentHat;
+        int enrollCalls, cancelEnrollCalls, lastFlag, postEnrollResult;
+        final java.util.ArrayList<String> enrollmentSequence = new java.util.ArrayList<>();
+        int[] ids = {11};
+        int mutators, authCalls, cancelAuthCalls, cancelRemoveCalls, preEnrollCalls, postEnrollCalls;
+        FakeVendor() { attachInterface(null, HonorLdyAn00FaceVendorClient.DESCRIPTOR); }
+        @Override protected boolean onTransact(int code, Parcel data, Parcel reply, int flags)
+                throws RemoteException {
+            data.enforceInterface(HonorLdyAn00FaceVendorClient.DESCRIPTOR);
+            reply.writeNoException();
+            switch (code) {
+                case 0xffffff: reply.writeInt(2); break;
+                case 0xfffffe: reply.writeString(HonorLdyAn00FaceVendorClient.HASH); break;
+                case 22:
+                    callback = data.readStrongBinder(); mutators++; notifyCalls++;
+                    if (duringSetNotify != null) duringSetNotify.run();
+                    reply.writeLong(42); break;
+                case 9:
+                    data.readString(); mutators++; initCalls++;
+                    assertTrue("Initial group must precede init", groupCalls > 0);
+                    initQueued = true; reply.writeInt(0); break;
+                case 13:
+                    data.readString(); mutators++; releaseCalls++; releaseQueued = true;
+                    if (duringRelease != null) duringRelease.run();
+                    reply.writeInt(0); break;
+                case 19:
+                    if (initQueued) { initCanceled = true; initQueued = false; }
+                    groupCalls++;
+                    assertEquals(expectedUser, data.readInt());
+                    IBinder result = data.readStrongBinder(); mutators++;
+                    Parcel request = Parcel.obtain(result);
+                    Parcel response = Parcel.obtain();
+                    try {
+                        request.writeInterfaceToken(HonorLdyAn00FaceVendorClient.PREFIX
+                                + "IFaceInfoCallback");
+                        request.writeIntArray(ids);
+                        assertTrue(result.transact(1, request, response, 0));
+                        response.readException();
+                    } finally { response.recycle(); request.recycle(); }
+                    break;
+                case 11: preEnrollCalls++; mutators++; reply.writeLong(CHALLENGE); break;
+                case 10: postEnrollCalls++; mutators++; reply.writeInt(postEnrollResult); break;
+                case 21:
+                    lastFlag = data.readInt(); enrollmentSequence.add("flag:" + lastFlag); mutators++;
+                    if (duringSetFlag != null) duringSetFlag.run();
+                    reply.writeInt(0); break;
+                case 1:
+                    assertEquals(0, data.readLong()); assertEquals(expectedUser, data.readInt());
+                    authCalls++; mutators++; reply.writeInt(0); break;
+                case 2:
+                    cancelAuthCalls++; mutators++; reply.writeInt(0);
+                    if ((initQueued && autoStartupAck)
+                            || (releaseQueued && autoCloseAck)) cancelAck(2);
+                    break;
+                case 3: cancelEnrollCalls++; mutators++; reply.writeInt(0); break;
+                case 5:
+                    assertEquals("Enrollment must carry the stock new-face sentinel", -1, lastFlag);
+                    enrollmentSequence.add("enroll");
+                    enrollmentHat = data.createFixedArray(byte[].class, 69);
+                    assertEquals(expectedUser, data.readInt());
+                    enrollCalls++; mutators++; reply.writeInt(0); break;
+                case 24:
+                    enrollmentSequence.add("surface");
+                    Surface surface = data.readTypedObject(Surface.CREATOR);
+                    assertNotNull(surface);
+                    assertTrue("Vendor received an invalid preview Surface", surface.isValid());
+                    previewReceived = true;
+                    surface.release();
+                    mutators++; reply.writeInt(0); break;
+                case 4: cancelRemoveCalls++; mutators++; reply.writeInt(0); break;
+                case 14:
+                    assertEquals(expectedUser, data.readInt()); assertEquals(11, data.readInt());
+                    ids = new int[0]; mutators++; reply.writeInt(0); break;
+                default: throw new AssertionError("Unexpected fake vendor transaction " + code);
+            }
+            data.enforceNoDataAvail();
+            return true;
+        }
+        void authResult(int id, int error) throws Exception { emit(2, id, error); }
+        void removedResult(int user, int error) throws Exception { emit(6, user, error); }
+        void enrollResult(int id, int user, int error) throws Exception { emit(5, id, user, error); }
+        void cancelAck(int type) throws RemoteException {
+            if (type == 2 && initQueued) initQueued = false; // FIFO init completed before ACK.
+            if (type == 2 && releaseQueued) releaseQueued = false; // ReleaseTask returned, no success ABI.
+            emit(3, type);
+        }
+        void emit(int code, int... values) throws RemoteException {
+            Parcel data = Parcel.obtain(callback);
+            try {
+                data.writeInterfaceToken(HonorLdyAn00FaceVendorClient.PREFIX
+                        + "IBiometricsFaceRecognizeClientCallback");
+                for (int value : values) data.writeInt(value);
+                assertTrue(callback.transact(code, data, null, IBinder.FLAG_ONEWAY));
+            } finally { data.recycle(); }
+        }
+    }
+}
