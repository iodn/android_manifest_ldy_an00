+        Session(Rpc remote, OperationCallbacks callbacks) {
+            mRemote = remote;
+            mCallbacks = callbacks;
+        }
+        @Override public IBinder asBinder() { return mRemote.binder; }
+        @Override public int getInterfaceVersion() { return STANDARD_VERSION; }
+        @Override public String getInterfaceHash() { return STANDARD_HASH; }
+        @Override public void generateChallenge() throws RemoteException {
+            mRemote.run(1, p -> {  });
+        }
+        @Override public void revokeChallenge(long challenge) throws RemoteException {
+            mRemote.run(2, p -> { p.writeLong(challenge); });
+        }
