+import org.mockito.stubbing.Answer;
+
+@SmallTest
+@RunWith(AndroidJUnit4.class)
+public class SdrHdrCapTransportTest {
+    @Rule public final ExtendedMockitoRule rule = new ExtendedMockitoRule.Builder(this)
+            .setStrictness(Strictness.LENIENT).spyStatic(SystemProperties.class).build();
+    private boolean mTypeEnabled;
+    private TestLooper mLooper;
+    private Handler mHandler;
+    private CapPluginStorageFixture mFixture;
+    private SdrHdrBrightnessCapController mController;
+    private int mChanges;
+
+    @Before public void setUp() {
+        mTypeEnabled = true;
+        doAnswer((Answer<Boolean>) invocation -> mTypeEnabled).when(() ->
+                SystemProperties.getBoolean("ro.display.sdr_hdr_caps", false));
+        mLooper = new TestLooper();
+        mHandler = new Handler(mLooper.getLooper());
+    }
+
+    private void create() {
+        mFixture = new CapPluginStorageFixture(
+                mock(Context.class), mock(DisplayManagerFlags.class));
+        mController = new SdrHdrBrightnessCapController(
+                mHandler, mFixture.manager, () -> mChanges++, true, "panel");
+        mLooper.dispatchAll();
+    }
+
+    private SdrHdrBrightnessCaps caps(float value, float rate) {
+        return new SdrHdrBrightnessCaps(value, value, value, true, true, rate, 8);
+    }
+
+    private SdrHdrBrightnessCapController.Frame frame(String display) {
+        return mController.snapshot(display, 4, 2, new DisplayPowerRequest());
+    }
+
+    @Test public void propertyOffRejectsTypeInRealStorage() {
+        mTypeEnabled = false;
+        create(); // Consumer deliberately enabled to test actual storage gate separately.
+        mFixture.storage.updateValue(PluginType.SDR_HDR_BRIGHTNESS_CAPS, "panel", caps(.3f, 1));
+        mLooper.dispatchAll();
+        assertFalse(frame("panel").active());
+        assertEquals(0, mChanges);
+    }
+
+    @Test public void globalFallbackAndTrueNullUseActualStorage() {
+        create();
+        mFixture.storage.updateGlobalValue(PluginType.SDR_HDR_BRIGHTNESS_CAPS, caps(.7f, 1));
+        mFixture.storage.updateValue(PluginType.SDR_HDR_BRIGHTNESS_CAPS, "panel", caps(.3f, 1));
+        mLooper.dispatchAll();
+        assertEquals(.3f, frame("panel").beforeHdr(.8f), 0);
+        mFixture.storage.updateValue(PluginType.SDR_HDR_BRIGHTNESS_CAPS, "panel", null);
+        mLooper.dispatchAll();
+        assertEquals(.7f, frame("panel").beforeHdr(.8f), 0);
+        mFixture.storage.updateGlobalValue(PluginType.SDR_HDR_BRIGHTNESS_CAPS, null);
+        mLooper.dispatchAll();
+        assertFalse(frame("panel").active());
+    }
+
+    @Test public void queuedOldDisplayUpdateCannotReachReplacement() {
+        create();
+        mFixture.storage.updateValue(PluginType.SDR_HDR_BRIGHTNESS_CAPS, "panel", caps(.1f, 1));
+        mController.onDisplayChanged("replacement");
+        mLooper.dispatchAll();
+        assertFalse(frame("replacement").active());
+        mFixture.storage.updateValue(
+                PluginType.SDR_HDR_BRIGHTNESS_CAPS, "replacement", caps(.6f, 1));
+        mLooper.dispatchAll();
+        assertEquals(.6f, frame("replacement").beforeHdr(.8f), 0);
+    }
+
+    @Test public void stopCancelsQueuedDeliveryAndUnsubscribes() {
+        create();
+        mFixture.storage.updateValue(PluginType.SDR_HDR_BRIGHTNESS_CAPS, "panel", caps(.1f, 1));
+        mController.stop();
+        mLooper.dispatchAll();
+        assertFalse(frame("panel").active());
+        assertEquals(0, mChanges);
+        mFixture.storage.updateGlobalValue(PluginType.SDR_HDR_BRIGHTNESS_CAPS, caps(.2f, 1));
+        mLooper.dispatchAll();
+        assertEquals(0, mChanges);
+    }
+
+    @Test public void realStorageRateOnlyUpdateAndOneFrameTuple() {
+        create();
+        mFixture.storage.updateValue(PluginType.SDR_HDR_BRIGHTNESS_CAPS, "panel", caps(.4f, 1));
+        mLooper.dispatchAll();
+        var original = frame("panel");
+        int before = mChanges;
+        mFixture.storage.updateValue(PluginType.SDR_HDR_BRIGHTNESS_CAPS, "panel", caps(.4f, 2));
+        mLooper.dispatchAll();
+        assertEquals(before + 1, mChanges);
+        assertEquals(1f, original.transitionRate(true), 0);
+        assertEquals(2f, frame("panel").transitionRate(true), 0);
+        assertTrue(original.revision() < frame("panel").revision());
+    }
+    private void assertOutOfOrderNotificationKeepsLatest(boolean clearFirst) throws Exception {
+        mFixture = new CapPluginStorageFixture(
+                mock(Context.class), mock(DisplayManagerFlags.class));
+        var initial = caps(.6f, 1);
+        var first = clearFirst ? null : caps(.8f, 1);
+        var latest = caps(.2f, 1);
+        mFixture.storage.updateValue(PluginType.SDR_HDR_BRIGHTNESS_CAPS, "panel", initial);
+        CountDownLatch firstCommitted = new CountDownLatch(1);
+        CountDownLatch releaseFirst = new CountDownLatch(1);
+        AtomicReference<Throwable> failure = new AtomicReference<>();
+        PluginManager.PluginChangeListener<SdrHdrBrightnessCaps> blocker = value -> {
+            if (Objects.equals(value, first)) {
+                firstCommitted.countDown();
+                try {
+                    if (!releaseFirst.await(5, TimeUnit.SECONDS)) {
+                        throw new AssertionError("First notification release timed out");
+                    }
+                } catch (InterruptedException e) {
+                    Thread.currentThread().interrupt();
+                    throw new AssertionError(e);
+                }
+            }
+        };
+        // Listener insertion order is real storage's LinkedHashSet order. Pause the
+        // first writer after its commit but before the controller receives its value.
+        mFixture.manager.subscribe(PluginType.SDR_HDR_BRIGHTNESS_CAPS, "panel", blocker);
+        mController = new SdrHdrBrightnessCapController(
+                mHandler, mFixture.manager, () -> mChanges++, true, "panel");
+        mLooper.dispatchAll();
+        Thread writer = new Thread(() -> {
+            try {
+                mFixture.storage.updateValue(
+                        PluginType.SDR_HDR_BRIGHTNESS_CAPS, "panel", first);
+            } catch (Throwable error) {
+                failure.set(error);
+            }
+        }, "old-cap-notification");
+        writer.start();
+        try {
+            assertTrue(firstCommitted.await(5, TimeUnit.SECONDS));
+            mFixture.storage.updateValue(PluginType.SDR_HDR_BRIGHTNESS_CAPS, "panel", latest);
+            mLooper.dispatchAll();
+            assertEquals(.2f, frame("panel").beforeHdr(.9f), 0);
+            int beforeOldDelivery = mChanges;
+            releaseFirst.countDown();
+            writer.join(5_000);
+            assertFalse(writer.isAlive());
+            assertTrue("Background writer failed: " + failure.get(), failure.get() == null);
+            mLooper.dispatchAll();
+            assertTrue(frame("panel").active());
+            assertEquals(.2f, frame("panel").beforeHdr(.9f), 0);
+            assertEquals(beforeOldDelivery, mChanges);
+        } finally {
+            releaseFirst.countDown();
+            writer.join(5_000);
+            mFixture.manager.unsubscribe(
+                    PluginType.SDR_HDR_BRIGHTNESS_CAPS, "panel", blocker);
+            mController.stop();
+        }
+    }
+
+    @Test public void olderSameDisplayValueCannotOverwriteNewerCommit() throws Exception {
+        assertOutOfOrderNotificationKeepsLatest(false);
+    }
+
+    @Test public void olderSameDisplayNullCannotClearNewerCommit() throws Exception {
+        assertOutOfOrderNotificationKeepsLatest(true);
+    }
+
+}
