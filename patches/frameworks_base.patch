+ */
+package android.hardware.face;
+
+import android.os.BadParcelableException;
+import android.os.Binder;
+import android.os.IBinder;
+import android.os.IInterface;
+import android.os.Parcel;
+import android.os.RemoteException;
+import android.view.Surface;
+
+import java.util.Objects;
+
+/**
+ * Typed wire client for stock113 Honor's private face V2.
+ * Construction checks identity only. The session owner explicitly controls registration, user,
+ * operation ordering and cancellation drains; this class never discovers or registers a service.
+ */
+final class HonorLdyAn00FaceVendorClient {
+    static final String PREFIX = "vendor.honor.hardware.biometrics.hwfacerecognize.";
+    static final String DESCRIPTOR = PREFIX + "IBiometricsFaceRecognize";
+    static final String SERVICE = DESCRIPTOR + "/default";
+    static final String HASH = "9bc1ab5543e4ca61000044b260530fe62afb41df";
+    static final int VERSION = 2;
+    private static final int HASH_TRANSACTION = 0xfffffe;
+    private static final int VERSION_TRANSACTION = 0xffffff;
+    private final IBinder mBinder;
+
+    HonorLdyAn00FaceVendorClient(IBinder binder) throws RemoteException {
+        mBinder = Objects.requireNonNull(binder);
+        if (!DESCRIPTOR.equals(binder.getInterfaceDescriptor())
+                || call(VERSION_TRANSACTION, p -> {}, HonorLdyAn00FaceVendorClient::readInt) != VERSION
+                || !HASH.equals(call(HASH_TRANSACTION, p -> {}, Parcel::readString))) {
+            throw new RemoteException("Unexpected Honor face interface");
+        }
+    }
+
+    IBinder asBinder() { return mBinder; }
+
+    int authenticate(long operationId, int userId) throws RemoteException {
+        return call(1, p -> { p.writeLong(operationId); p.writeInt(userId); }, HonorLdyAn00FaceVendorClient::readInt);
+    }
+    int cancelAuthenticate() throws RemoteException {
+        return call(2, p -> {}, HonorLdyAn00FaceVendorClient::readInt);
+    }
+    int cancelEnroll() throws RemoteException {
+        return call(3, p -> {}, HonorLdyAn00FaceVendorClient::readInt);
+    }
+    int cancelRemove() throws RemoteException {
+        return call(4, p -> {}, HonorLdyAn00FaceVendorClient::readInt);
+    }
+    int enroll(byte[] hat, int userId) throws RemoteException {
+        if (hat == null || hat.length != 69) {
+            throw new IllegalArgumentException("Enrollment requires a 69-byte HAT");
+        }
+        return call(5, p -> { p.writeFixedArray(hat, 0, 69); p.writeInt(userId); },
+                HonorLdyAn00FaceVendorClient::readInt);
+    }
+    void getStatus(int statusId, StatusCallback callback) throws RemoteException {
+        Objects.requireNonNull(callback);
+        call(7, p -> { p.writeInt(statusId); p.writeStrongInterface(callback); }, p -> null);
+    }
+    int init(String client) throws RemoteException {
+        Objects.requireNonNull(client);
+        return call(9, p -> p.writeString(client), HonorLdyAn00FaceVendorClient::readInt);
+    }
+    int postEnroll() throws RemoteException {
+        return call(10, p -> {}, HonorLdyAn00FaceVendorClient::readInt);
+    }
+    long preEnroll() throws RemoteException {
+        return call(11, p -> {}, HonorLdyAn00FaceVendorClient::readLong);
+    }
+    int release(String client) throws RemoteException {
+        Objects.requireNonNull(client);
+        return call(13, p -> p.writeString(client), HonorLdyAn00FaceVendorClient::readInt);
+    }
+    int remove(int userId, int faceId) throws RemoteException {
+        return call(14, p -> { p.writeInt(userId); p.writeInt(faceId); }, HonorLdyAn00FaceVendorClient::readInt);
+    }
+    int sendCommand(int command, byte[] payload) throws RemoteException {
+        Objects.requireNonNull(payload);
+        return call(16, p -> { p.writeInt(command); p.writeByteArray(payload); }, HonorLdyAn00FaceVendorClient::readInt);
+    }
+    void setActiveGroup(int userId, FaceIdsCallback callback) throws RemoteException {
+        Objects.requireNonNull(callback);
+        call(19, p -> { p.writeInt(userId); p.writeStrongInterface(callback); }, p -> null);
+    }
+    int setFlag(int flags) throws RemoteException {
+        return call(21, p -> p.writeInt(flags), HonorLdyAn00FaceVendorClient::readInt);
+    }
+    long setNotify(ClientCallback callback) throws RemoteException {
+        Objects.requireNonNull(callback);
+        return call(22, p -> p.writeStrongInterface(callback), HonorLdyAn00FaceVendorClient::readLong);
+    }
