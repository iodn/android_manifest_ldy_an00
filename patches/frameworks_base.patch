+                boolean closed = false;
+                try {
+                    mRemote.run(11, p -> {  });
+                    closed = true;
+                } catch (RemoteException e) {
+                    failure[0] = e;
+                    Slog.e(TAG, "Owned fingerprint session close failed", e);
+                } catch (RuntimeException e) {
