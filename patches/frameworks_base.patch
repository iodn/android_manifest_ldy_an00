diff --git a/services/core/java/com/android/server/display/SdrHdrBrightnessCapController.java b/services/core/java/com/android/server/display/SdrHdrBrightnessCapController.java
new file mode 100644
index 0000000000000000000000000000000000000000..4b8806138056d16c8343611bb309149a7346315f
--- /dev/null
+++ b/services/core/java/com/android/server/display/SdrHdrBrightnessCapController.java
@@ -0,0 +1,191 @@
+// SPDX-License-Identifier: Apache-2.0
+package com.android.server.display;
+
+import android.annotation.Nullable;
+import android.annotation.SuppressLint;
+import android.hardware.display.DisplayManagerInternal.DisplayPowerRequest;
+import android.os.Handler;
+import android.view.Display;
+
+import com.android.server.display.brightness.BrightnessReason;
+import com.android.server.display.plugin.PluginManager;
+import com.android.server.display.plugin.PluginType;
+import com.android.server.display.plugin.types.SdrHdrBrightnessCaps;
+
+import java.util.Objects;
+
+/** Display-handler-owned, default-inactive coherent cap transport. */
+final class SdrHdrBrightnessCapController {
+    private final Handler mHandler;
+    private final PluginManager mPlugins;
+    private final Runnable mChanged;
+    private final boolean mEnabled;
+    private String mDisplayId;
+    private PluginManager.PluginChangeListener<SdrHdrBrightnessCaps> mListener;
+    private SdrHdrBrightnessCaps mCaps;
+    private long mGeneration;
+    private long mRevision;
+    private boolean mStopped;
+
+    SdrHdrBrightnessCapController(Handler handler, PluginManager plugins, Runnable changed,
+            boolean enabled, String initialDisplayId) {
+        mHandler = new Handler(handler.getLooper());
+        mPlugins = plugins;
+        mChanged = changed;
+        mEnabled = enabled;
+        mHandler.post(() -> {
+            if (mGeneration == 0 && !mStopped) onDisplayChanged(initialDisplayId);
+        });
+    }
+
+    // Constructor calls this through our handler. DPC replacement/stop already runs there.
+    @SuppressLint("MissingPermission")
+    void onDisplayChanged(String displayId) {
+        if (mStopped) return;
+        final long generation = ++mGeneration;
+        if (mListener != null) {
+            mPlugins.unsubscribe(PluginType.SDR_HDR_BRIGHTNESS_CAPS, mDisplayId, mListener);
+        }
+        mListener = null;
+        mDisplayId = displayId;
+        mCaps = null;
+        mRevision++;
+        if (!mEnabled || displayId == null) return;
+        mListener = ignoredValue -> mHandler.post(() -> {
+            if (mStopped || generation != mGeneration
+                    || !Objects.equals(displayId, mDisplayId)) return;
+            // Storage notifies outside its lock: treat the callback as invalidation,
+            // not a revision. A delayed callback must not restore an older cap or null.
+            SdrHdrBrightnessCaps value = mPlugins.getCurrentValue(
+                    PluginType.SDR_HDR_BRIGHTNESS_CAPS, displayId);
+            if (!Objects.equals(mCaps, value)) {
+                mCaps = value; // PluginStorage has already resolved display/global fallback.
+                mRevision++;
+                mChanged.run();
+            }
+        });
+        mPlugins.subscribe(PluginType.SDR_HDR_BRIGHTNESS_CAPS, displayId, mListener);
+    }
+
+    @SuppressLint("MissingPermission")
+    void stop() {
+        mStopped = true;
+        mGeneration++;
+        if (mListener != null) {
+            mPlugins.unsubscribe(PluginType.SDR_HDR_BRIGHTNESS_CAPS, mDisplayId, mListener);
+        }
+        mListener = null;
+        mCaps = null;
+        mHandler.removeCallbacksAndMessages(null);
+    }
+
+    Frame snapshot(String displayId, int reason, int state, DisplayPowerRequest request) {
+        // Stock doze, private app-no-limit, camera/APL scenes are not represented here.
+        // No producer is enabled until it can assert the supported ordinary policy.
+        boolean ordinary = mEnabled && !mStopped && Objects.equals(displayId, mDisplayId)
+                && state == Display.STATE_ON && request.policy == DisplayPowerRequest.POLICY_BRIGHT
+                && !request.lowPowerMode && !request.boostScreenBrightness;
+        boolean automatic = ordinary && reason == BrightnessReason.REASON_AUTOMATIC
+                && mCaps != null && mCaps.ordinaryAuto();
+        boolean manual = ordinary && reason == BrightnessReason.REASON_MANUAL
+                && mCaps != null && mCaps.manual();
+        return new Frame(mGeneration, mRevision, automatic || manual ? mCaps : null, automatic);
+    }
+
+    final class Frame {
+        private final long mFrameGeneration;
+        private final long mFrameRevision;
+        @Nullable private final SdrHdrBrightnessCaps mFrameCaps;
+        private final boolean mAutomatic;
+
+        private Frame(long generation, long revision, SdrHdrBrightnessCaps caps, boolean automatic) {
+            mFrameGeneration = generation;
+            mFrameRevision = revision;
+            mFrameCaps = caps;
+            mAutomatic = automatic;
+        }
+
+        boolean active() {
+            return mFrameCaps != null && !mStopped && mFrameGeneration == mGeneration;
+        }
+
+        long revision() { return mFrameRevision; }
+
+        float beforeHdr(float strategyValue) {
+            return active() && mAutomatic
+                    ? cap(strategyValue, mFrameCaps.automaticInputCap()) : strategyValue;
+        }
+
+        float sdrMaximum(float original) {
+            return active() ? Math.min(original, mFrameCaps.sdrOutputCap()) : original;
+        }
+
+        float sdrMinimum(float original, float maximum) {
+            return active() ? Math.min(original, maximum) : original;
+        }
+
+        Output finish(float sdr, float main) {
+            if (!active()) return new Output(sdr, main);
+            float limitedSdr = cap(sdr, mFrameCaps.sdrOutputCap());
+            float limitedMain = cap(main, mFrameCaps.hdrOutputCap());
+            if (validOutput(limitedSdr) && validOutput(limitedMain)) {
+                limitedSdr = Math.min(limitedSdr, limitedMain);
+            }
+            return new Output(limitedSdr, limitedMain);
+        }
+
+        Output finishSdr(float sdr, float main) {
+            if (!active()) return new Output(sdr, main);
+            float limitedSdr = cap(sdr, mFrameCaps.sdrOutputCap());
+            float limitedMain = cap(main, mFrameCaps.sdrOutputCap());
+            if (validOutput(limitedSdr) && validOutput(limitedMain)) {
+                limitedSdr = Math.min(limitedSdr, limitedMain);
+            }
+            return new Output(limitedSdr, limitedMain);
+        }
+
+        boolean changed(float originalInput, float sdr, float main, Output output) {
+            return active() && (Float.compare(beforeHdr(originalInput), originalInput) != 0
+                    || Float.compare(output.sdr(), sdr) != 0
+                    || Float.compare(output.main(), main) != 0);
+        }
+
+        float transitionRate(boolean limited) {
+            return active() && limited ? mFrameCaps.customTransitionRate() : -1f;
+        }
+
+        int reasonModifier(boolean limited) {
+            return active() && limited ? mFrameCaps.reasonModifier() : BrightnessReason.MODIFIER_NONE;
+        }
+
+        DisplayBrightnessState reportingState(DisplayBrightnessState state, Output output,
+                boolean limited) {
+            if (!active()) return state;
+            DisplayBrightnessState.Builder result = DisplayBrightnessState.Builder.from(state);
+            float maximum = sdrMaximum(state.getMaxBrightness());
+            if (maximum < state.getMaxBrightness()) {
+                result.setMaxBrightness(maximum);
+                result.setMinBrightness(Math.min(state.getMinBrightness(), maximum));
+                result.setBrightnessMaxReason(
+                        android.hardware.display.BrightnessInfo.BRIGHTNESS_MAX_REASON_PLUGIN);
+            }
+            result.setBrightness(output.sdr());
+            // Keep legacy HDR provenance unset: it is not a new-clamper HDR boost.
+            if (state.getHdrBrightness() != DisplayBrightnessState.BRIGHTNESS_NOT_SET) {
+                result.setHdrBrightness(output.main());
+            }
+            result.getBrightnessReason().addModifier(reasonModifier(limited));
+            return result.build();
+        }
+    }
+
+    record Output(float sdr, float main) {}
+
+    private static boolean validOutput(float value) {
+        return Float.isFinite(value) && value >= 0f;
+    }
+
+    private static float cap(float value, float maximum) {
+        return validOutput(value) ? Math.min(value, maximum) : value;
+    }
+}
