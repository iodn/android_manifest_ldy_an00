+            mRemote.run(6, p -> {  });
+        }
+        @Override public void removeEnrollments(int[] enrollmentIds) throws RemoteException {
+            mRemote.run(7, p -> { p.writeIntArray(enrollmentIds); });
+        }
+        @Override public void getAuthenticatorId() throws RemoteException {
+            mRemote.run(8, p -> {  });
+        }
+        @Override public void invalidateAuthenticatorId() throws RemoteException {
+            mRemote.run(9, p -> {  });
+        }
