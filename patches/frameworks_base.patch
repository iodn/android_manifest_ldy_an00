--- /dev/null
+++ b/core/java/android/hardware/face/HonorLdyAn00FaceBootFence.java
@@ -0,0 +1,57 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package android.hardware.face;
+
+import java.io.IOException;
+
+/** Retains unknown native ownership across system_server restart in the same kernel boot. */
+final class HonorLdyAn00FaceBootFence {
+    static final class Record {
+        final String boot;
+        final boolean pending;
+        Record(String boot, boolean pending) {
+            if (boot == null || !boot.matches(
+                    "[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}")) {
+                throw new IllegalArgumentException("Invalid kernel boot identity");
+            }
+            this.boot = boot; this.pending = pending;
+        }
+    }
+    interface Storage {
+        Record read() throws IOException;
+        void write(Record record) throws IOException;
+    }
+    private final Storage mStorage;
+    private final String mBoot;
+    private boolean mReserved;
+
+    HonorLdyAn00FaceBootFence(Storage storage, String boot) {
+        mStorage = storage; mBoot = new Record(boot, false).boot;
+    }
+
+    void reserve() throws IOException {
+        if (mReserved) throw new IOException("Face session already reserved");
+        Record old = mStorage.read();
+        if (old != null && old.boot.equals(mBoot) && old.pending) {
+            throw new IOException("Previous native face ownership is unknown in this boot");
+        }
+        // A different kernel UUID proves the previous userspace/native workers no longer exist.
+        // Persist before callback registration or any other native face mutation.
+        mStorage.write(new Record(mBoot, true));
+        mReserved = true;
+    }
+
+    void release() throws IOException {
+        if (!mReserved) throw new IOException("No face session reservation");
+        Record current = mStorage.read();
+        if (current == null || !current.boot.equals(mBoot) || !current.pending) {
+            throw new IOException("Face ownership record changed");
+        }
+        // Called only after the owned release-task FIFO ACK and a post-return failure fence.
+        // The private ABI exposes no release-resource success result.
+        mStorage.write(new Record(mBoot, false));
+        mReserved = false;
+    }
+}
diff --git a/core/java/android/hardware/face/HonorLdyAn00FaceBootFenceFile.java b/core/java/android/hardware/face/HonorLdyAn00FaceBootFenceFile.java
new file mode 100644
index 0000000000000000000000000000000000000000..7e425cf14fb5f359e32c58a0331a3e320bc6df61
--- /dev/null
+++ b/core/java/android/hardware/face/HonorLdyAn00FaceBootFenceFile.java
@@ -0,0 +1,110 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package android.hardware.face;
+
+import android.os.Environment;
+import android.system.ErrnoException;
+import android.system.Os;
+import android.system.OsConstants;
+import android.util.AtomicFile;
+
+import java.io.DataInputStream;
+import java.io.DataOutputStream;
+import java.io.File;
+import java.io.FileDescriptor;
+import java.io.FileNotFoundException;
+import java.io.FileInputStream;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.nio.file.Files;
+
+/** Global framework-owned DE reservation, retained across runtime restart; no template data. */
+final class HonorLdyAn00FaceBootFenceFile implements HonorLdyAn00FaceBootFence.Storage {
+    private static final int MAGIC = 0x48465331;
+    private final AtomicFile mFile;
+
+    HonorLdyAn00FaceBootFenceFile() {
+        this(new File(Environment.getDataSystemDeDirectory(0), "honor_face_session.bin"));
+    }
+
+    HonorLdyAn00FaceBootFenceFile(File path) {
+        mFile = new AtomicFile(path);
+    }
+
+    static HonorLdyAn00FaceBootFence create() throws IOException {
+        byte[] bytes;
+        try (FileInputStream input = new FileInputStream("/proc/sys/kernel/random/boot_id")) {
+            bytes = input.readNBytes(38);
+        }
+        if (bytes.length != 37 || bytes[36] != 10) {
+            throw new IOException("Kernel boot identity unavailable");
+        }
+        String boot = new String(bytes, 0, 36, java.nio.charset.StandardCharsets.US_ASCII);
+        try { return new HonorLdyAn00FaceBootFence(new HonorLdyAn00FaceBootFenceFile(), boot); }
+        catch (IllegalArgumentException invalid) {
+            throw new IOException("Kernel boot identity invalid", invalid);
+        }
+    }
+
+    @Override public HonorLdyAn00FaceBootFence.Record read() throws IOException {
+        try (FileInputStream raw = mFile.openRead();
+                DataInputStream input = new DataInputStream(raw)) {
+            android.system.StructStat stat = Os.fstat(raw.getFD());
+            if (stat.st_uid != android.os.Process.myUid() || (stat.st_mode & 0777) != 0600
+                    || !OsConstants.S_ISREG(stat.st_mode)) {
+                throw new IOException("Face ownership file ownership/mode invalid");
+            }
+            if (input.readInt() != MAGIC) throw new IOException("Face ownership framing");
+            String boot = input.readUTF();
+            int pending = input.readUnsignedByte();
+            if (pending > 1 || input.read() != -1) throw new IOException("Face ownership framing");
+            try { return new HonorLdyAn00FaceBootFence.Record(boot, pending == 1); }
+            catch (IllegalArgumentException invalid) {
+                throw new IOException("Face ownership data invalid", invalid);
+            }
+        } catch (FileNotFoundException absent) {
+            File base = mFile.getBaseFile();
+            // Permission errors, partial first writes and backup recovery failures are not
+            // interpreted as zero failures. Only a provably absent three-file set is new state.
+            if (Files.notExists(base.toPath())
+                    && Files.notExists(new File(base.getPath() + ".bak").toPath())
+                    && Files.notExists(new File(base.getPath() + ".new").toPath())) return null;
+            throw absent;
+        } catch (ErrnoException failure) {
+            throw new IOException("Face ownership stat failed", failure);
+        }
+    }
+
+    @Override public void write(HonorLdyAn00FaceBootFence.Record record) throws IOException {
+        FileOutputStream output = null;
+        try {
+            output = mFile.startWrite();
+            Os.fchmod(output.getFD(), 0600);
+            DataOutputStream data = new DataOutputStream(output);
+            data.writeInt(MAGIC); data.writeUTF(record.boot);
+            data.writeBoolean(record.pending); data.flush();
+            Os.fsync(output.getFD()); // AtomicFile.finishWrite itself logs some sync errors.
+            mFile.finishWrite(output); output = null;
+            FileDescriptor directory = Os.open(mFile.getBaseFile().getParent(),
+                    OsConstants.O_RDONLY | OsConstants.O_CLOEXEC, 0);
+            try {
+                if (!OsConstants.S_ISDIR(Os.fstat(directory).st_mode)) {
+                    throw new IOException("Face ownership parent is not a directory");
+                }
+                Os.fsync(directory);
+            }
+            finally { Os.close(directory); }
+            HonorLdyAn00FaceBootFence.Record actual = read();
+            if (actual == null || !actual.boot.equals(record.boot) || actual.pending != record.pending
+                    || (Os.stat(mFile.getBaseFile().getPath()).st_mode & 0777) != 0600) {
+                throw new IOException("Face ownership write not verified");
+            }
+        } catch (ErrnoException failure) {
+            throw new IOException("Face ownership durability failed", failure);
+        } finally {
+            if (output != null) mFile.failWrite(output);
+        }
+    }
+}
