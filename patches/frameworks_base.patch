+        LdyAn00FingerprintTouchMode.stop(closing, true); // Synchronous terminal before return.
+        check(LdyAn00FingerprintTouchMode.owns(closing));
+        check(!LdyAn00FingerprintTouchMode.active(closing)); // Terminal before start return.
+        LdyAn00FingerprintTouchMode.finishStart(closing);
+        check(order.equals(Arrays.asList("close")));
+        check(!LdyAn00FingerprintTouchMode.owns(closing));
+
+        // Begin failure must still drain deferred close exactly once and release reservation.
+        LdyAn00FingerprintTouchMode.Token beginFailure =
+                LdyAn00FingerprintTouchMode.reserve(enabled -> !enabled);
+        check(!LdyAn00FingerprintTouchMode.requestClose(beginFailure, () -> {
