@@ -0,0 +1,24 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package android.hardware.face;
+
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+
+/** Packed hw_auth_token_t transport, matching HardwareAuthTokenUtils on this LE device. */
+final class HonorLdyAn00FaceHatCodec {
+    private HonorLdyAn00FaceHatCodec() { }
+
+    static byte[] encode(long challenge, long userId, long authenticatorId, int authenticatorType,
+            long timestampMillis, byte[] mac) {
+        if (mac == null || mac.length != 32) {
+            throw new IllegalArgumentException("Credential HAT MAC must contain32bytes");
+        }
+        return ByteBuffer.allocate(69).order(ByteOrder.LITTLE_ENDIAN)
+                .put((byte) 0).putLong(challenge).putLong(userId).putLong(authenticatorId)
+                .order(ByteOrder.BIG_ENDIAN).putInt(authenticatorType).putLong(timestampMillis)
+                .put(mac).array();
+    }
+}
