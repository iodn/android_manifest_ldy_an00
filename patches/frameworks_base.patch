+                data.enforceNoDataAvail();
+                reply.writeNoException();
+                if (code == VERSION_TRANSACTION) reply.writeInt(VERSION);
+                else reply.writeString(HASH);
+                return true;
+            }
+            if (dispatch(code, data)) {
