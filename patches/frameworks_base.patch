+        Objects.requireNonNull(surface);
+        return call(24, p -> p.writeTypedObject(surface, 0), HonorLdyAn00FaceVendorClient::readInt);
+    }
+
+    private static int readInt(Parcel data) {
+        requireBytes(data, 4);
+        return data.readInt();
+    }
+    private static long readLong(Parcel data) {
+        requireBytes(data, 8);
+        return data.readLong();
+    }
+    private static void requireBytes(Parcel data, int bytes) {
+        if (data.dataAvail() != bytes) {
+            throw new BadParcelableException("Malformed Honor face parcel");
+        }
+    }
+    private static void requireArrayFrame(Parcel data, int itemBytes) {
+        if (data.dataAvail() < 4) {
+            throw new BadParcelableException("Missing Honor face array");
+        }
+        int position = data.dataPosition();
+        int length = data.readInt();
+        long bytes = length < 0 ? 0 : ((long) length * itemBytes + 3) & ~3L;
+        if (length < -1 || bytes != data.dataAvail()) {
+            throw new BadParcelableException("Malformed Honor face array");
+        }
+        data.setDataPosition(position);
+    }
+
+    private interface Writer { void write(Parcel data); }
+    private interface Reader<T> { T read(Parcel reply); }
+
+    private <T> T call(int code, Writer writer, Reader<T> reader) throws RemoteException {
+        Parcel data = Parcel.obtain(mBinder);
+        Parcel reply = Parcel.obtain();
+        try {
+            data.writeInterfaceToken(DESCRIPTOR);
+            writer.write(data);
+            if (!mBinder.transact(code, data, reply, 0)) {
+                throw new RemoteException("Honor face transaction unavailable: " + code);
+            }
+            reply.readException();
+            T result = reader.read(reply);
+            reply.enforceNoDataAvail();
+            return result;
+        } finally {
+            reply.recycle();
+            data.recycle();
+        }
+    }
+
+    /** Stable private callback metadata; subclasses deliver semantic callbacks to the owner. */
+    abstract static class Callback extends Binder implements IInterface {
+        private final String mDescriptor;
+        private final boolean mOneway;
+        Callback(String name, boolean oneway) {
+            mDescriptor = PREFIX + name;
+            mOneway = oneway;
+            attachInterface(this, mDescriptor);
+            markVintfStability();
+        }
+        @Override public final IBinder asBinder() { return this; }
+        @Override protected final boolean onTransact(int code, Parcel data, Parcel reply, int flags)
