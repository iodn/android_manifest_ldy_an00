+    }
+
+    abstract static class ClientCallback extends Callback {
+        ClientCallback() { super("IBiometricsFaceRecognizeClientCallback", true); }
+        abstract void onAuthenticationAcquired(int acquired) throws RemoteException;
+        abstract void onAuthenticationResult(int faceId, int error) throws RemoteException;
+        abstract void onCancel(int type) throws RemoteException;
+        abstract void onEnrollAcquired(int acquired, int process) throws RemoteException;
+        abstract void onEnrollResult(int faceId, int userId, int error) throws RemoteException;
+        abstract void onRemovedResult(int userId, int error) throws RemoteException;
+        @Override final boolean dispatch(int code, Parcel data) throws RemoteException {
+            if (code < 1 || code > 6) return false;
+            requireBytes(data, code == 5 ? 12 : (code == 2 || code >= 4) ? 8 : 4);
+            int first = data.readInt();
+            int second = (code == 2 || code >= 4) ? data.readInt() : 0;
+            int third = code == 5 ? data.readInt() : 0;
+            data.enforceNoDataAvail();
+            switch (code) {
+                case 1: onAuthenticationAcquired(first); break;
+                case 2: onAuthenticationResult(first, second); break;
+                case 3: onCancel(first); break;
+                case 4: onEnrollAcquired(first, second); break;
+                case 5: onEnrollResult(first, second, third); break;
+                case 6: onRemovedResult(first, second); break;
+            }
+            return true;
+        }
+    }
+
+    abstract static class StatusCallback extends Callback {
+        StatusCallback() { super("IGetStatusCallback", false); }
+        abstract void onStatusResult(int result, int status1, int status2, byte[] data)
+                throws RemoteException;
+        @Override final boolean dispatch(int code, Parcel data) throws RemoteException {
+            if (code != 1) return false;
+            if (data.dataAvail() < 16) {
+                throw new BadParcelableException("Missing Honor face status");
+            }
+            int result = data.readInt();
+            int status1 = data.readInt();
+            int status2 = data.readInt();
+            requireArrayFrame(data, 1);
+            byte[] bytes = data.createByteArray();
+            data.enforceNoDataAvail();
+            onStatusResult(result, status1, status2, bytes);
+            return true;
+        }
+    }
+
+    abstract static class FaceIdsCallback extends Callback {
+        FaceIdsCallback() { super("IFaceInfoCallback", false); }
+        abstract void onFaceIds(int[] ids) throws RemoteException;
+        @Override final boolean dispatch(int code, Parcel data) throws RemoteException {
+            if (code != 1) return false;
+            requireArrayFrame(data, 4);
+            int[] ids = data.createIntArray();
+            data.enforceNoDataAvail();
+            onFaceIds(ids);
+            return true;
