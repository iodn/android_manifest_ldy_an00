+
+package com.android.server.health;
+
+import android.os.SystemProperties;
+
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.time.DateTimeException;
+import java.time.LocalDate;
+import java.time.ZoneOffset;
+import java.util.function.Supplier;
+
+/** Read-only adaptation of the retained Honor battery checker's calendar date. */
+final class HonorBatteryManufacturingDate {
+    private static final Path DATE_PATH = Path.of("/sys/devices/platform/honor_batt_info/"
+            + "honor_batt_info:battery_checker@0/manufacturing_date");
+
+    static long read() {
+        return read(SystemProperties.get("ro.product.product.model"),
+                SystemProperties.get("ro.product.product.device"), SystemProperties.get("ro.hardware"),
+                () -> {
+                    try {
+                        return Files.readString(DATE_PATH);
+                    } catch (IOException | SecurityException e) {
+                        return "";
+                    }
+                });
+    }
+
+    static long read(String model, String device, String hardware, Supplier<String> reader) {
+        if (!isSupportedDevice(model, device, hardware)) return 0;
+        return parse(reader.get());
+    }
+
+    static boolean isSupportedDevice(String model, String device, String hardware) {
+        return "LDY-AN00".equals(model) && "ldy_an00".equals(device) && "mt6993".equals(hardware);
+    }
+
+    static long parse(String raw) {
+        String date = raw.trim();
+        if (date.length() != 8) return 0;
+        for (int i = 0; i < date.length(); i++) {
+            if (date.charAt(i) < '0' || date.charAt(i) > '9') return 0;
+        }
+        int year = Integer.parseInt(date.substring(0, 4));
+        if (year < 2000 || year > 2099) return 0;
+        try {
+            return LocalDate.of(year, Integer.parseInt(date.substring(4, 6)),
+                    Integer.parseInt(date.substring(6, 8))).atStartOfDay(ZoneOffset.UTC).toEpochSecond();
+        } catch (DateTimeException e) {
+            return 0;
+        }
+    }
+
+    private HonorBatteryManufacturingDate() {}
+}
