+        verify(mClient).onAuthenticated(any(), eq(true), eq(new ArrayList<Byte>()));
+    }
+
+    @Test
+    public void staleHardwareErrorCannotFailNewSessionClientOrClearIt() {
+        when(mCallback.isStaleSession(mResponse)).thenReturn(true);
