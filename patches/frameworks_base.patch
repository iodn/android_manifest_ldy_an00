index 0000000000000000000000000000000000000000..b352bf16fa49a9ee418a1b208f3a00c8fbb70862
--- /dev/null
+++ b/core/java/android/hardware/face/HonorLdyAn00FaceLockout.java
@@ -0,0 +1,73 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package android.hardware.face;
+
+import java.io.IOException;
+import java.util.function.LongSupplier;
+
+/** Durable per-user software rate limiter for the selected convenience-only face adapter. */
+final class HonorLdyAn00FaceLockout {
+    static final long TIMED_MS = 30_000;
+    static final int PERMANENT_ATTEMPTS = 20;
+    static final int TIMED_ATTEMPTS = 5;
+
+    static final class Record {
+        final int attempts;
+        final boolean timed;
+        Record(int attempts, boolean timed) {
+            if (attempts < 0 || attempts > PERMANENT_ATTEMPTS
+                    || (timed && (attempts == 0 || attempts >= PERMANENT_ATTEMPTS
+                            || attempts % TIMED_ATTEMPTS != 0))) {
+                throw new IllegalArgumentException("Invalid persisted face lockout");
+            }
+            this.attempts = attempts; this.timed = timed;
+        }
+    }
+    interface Storage {
+        Record read() throws IOException;
+        void write(Record record) throws IOException;
+    }
+    private final Storage mStorage;
+    private final LongSupplier mNow;
+    private Record mRecord;
+    private long mStartedAt, mUntil;
+
+    HonorLdyAn00FaceLockout(Storage storage, LongSupplier now) throws IOException {
+        mStorage = storage; mNow = now;
+        mRecord = storage.read();
+        if (mRecord == null) mRecord = new Record(0, false);
+        // Old elapsedRealtime/wall time is never reused. A process restart or reboot
+        // conservatively restarts the persisted active timed wait; total failures remain.
+        if (mRecord.timed) { mStartedAt = now.getAsLong(); mUntil = mStartedAt + TIMED_MS; }
+    }
+
+    boolean permanent() { return mRecord.attempts >= PERMANENT_ATTEMPTS; }
+
+    long remaining() throws IOException {
+        if (!mRecord.timed) return 0;
+        long now = mNow.getAsLong();
+        if (now < mStartedAt) throw new IOException("Face lockout monotonic clock reversed");
+        if (now >= mUntil) {
+            replace(new Record(mRecord.attempts, false));
+            return 0;
+        }
+        return mUntil - now;
+    }
+
+    void failedMatch() throws IOException {
+        if (permanent() || remaining() != 0) throw new IOException("Face matching was locked out");
+        int attempts = mRecord.attempts + 1;
+        boolean timed = attempts < PERMANENT_ATTEMPTS && attempts % TIMED_ATTEMPTS == 0;
+        replace(new Record(attempts, timed));
+        if (timed) { mStartedAt = mNow.getAsLong(); mUntil = mStartedAt + TIMED_MS; }
+    }
+
+    void clear() throws IOException { replace(new Record(0, false)); }
+
+    private void replace(Record next) throws IOException {
+        mStorage.write(next); // No state change or success callback before durable storage succeeds.
+        mRecord = next;
+    }
+}
