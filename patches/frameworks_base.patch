--- /dev/null
+++ b/core/tests/face-operation-owner/HonorFaceStrongResetHostTest.java
@@ -0,0 +1,49 @@
+/* Copyright (C) 2026 The LineageOS Project. SPDX-License-Identifier: Apache-2.0 */
+package com.android.server.biometrics.sensors;
+
+/** Tests the actual producer origin object; no Android service, HAL or token signatures faked. */
+public final class HonorFaceStrongResetHostTest {
+    private static int checks;
+    private static void check(boolean value) { if (!value) throw new AssertionError(); checks++; }
+    private static final class Authority implements HonorFaceStrongReset.Authority {
+        long epoch = 7, recordedEpoch, challenge;
+        int strength = 15, captures, queries, grants, user, source, recordedStrength;
+        byte[] received;
+        public long captureEpoch(int userId) { captures++; return epoch; }
+        public int currentStrength(int sensor) { queries++; check(sensor == 0); return strength; }
+        public void authorize(int userId, int sensor, int value, long capturedEpoch,
+                long operationId, byte[] hat) {
+            grants++; user = userId; source = sensor; recordedStrength = value;
+            recordedEpoch = capturedEpoch; challenge = operationId; received = hat;
+        }
+    }
+    public static void main(String[] args) {
+        Authority authority = new Authority(); byte[] hat = new byte[69];
+        var origin = new HonorFaceStrongReset(true, 10, 0, true, 55, authority);
+        check(authority.captures == 1 && authority.queries == 0 && authority.grants == 0);
+        authority.epoch = 8; // Work queued before a credential change must retain old7.
+        origin.verified(hat);
+        check(authority.grants == 1 && authority.recordedEpoch == 7);
+        check(authority.user == 10 && authority.source == 0 && authority.recordedStrength == 15);
+        check(authority.challenge == 55 && authority.received == hat);
+        for (int strength : new int[]{0, 255, 4095}) {
+            authority.strength = strength;
+            int grants = authority.grants; origin.verified(hat); check(authority.grants == grants);
+        }
+        Authority invalid = new Authority();
+        new HonorFaceStrongReset(false, 0, 0, true, 0, invalid).verified(hat);
+        new HonorFaceStrongReset(true, 0, 1, true, 0, invalid).verified(hat);
+        new HonorFaceStrongReset(true, 0, 0, false, 0, invalid).verified(hat);
+        new HonorFaceStrongReset(true, -1, 0, true, 0, invalid).verified(hat);
+        check(invalid.captures == 0 && invalid.queries == 0 && invalid.grants == 0);
+        Authority disabled = new Authority(); disabled.epoch = -1;
+        new HonorFaceStrongReset(true, 0, 0, true, 0, disabled).verified(hat);
+        check(disabled.grants == 0 && disabled.queries == 0);
+        // The same post-success hook precedes both platformBP and nonBP dispatch paths.
+        Authority bp = new Authority(), nonBp = new Authority();
+        new HonorFaceStrongReset(true, 0, 0, true, 0, bp).verified(hat);
+        new HonorFaceStrongReset(true, 0, 0, true, 0, nonBp).verified(hat);
+        check(bp.grants == 1 && nonBp.grants == 1);
+        System.out.println("FACE_STRONG_ORIGIN_HOST_OK checks=" + checks);
+    }
+}
diff --git a/core/tests/face-operation-owner/HonorLdyAn00FaceBootFenceHostTest.java b/core/tests/face-operation-owner/HonorLdyAn00FaceBootFenceHostTest.java
