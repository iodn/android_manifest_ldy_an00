+        check(order.equals(Arrays.asList("close", "failed-start-close")));
+        check(!LdyAn00FingerprintTouchMode.owns(beginFailure));
+
+        LdyAn00FingerprintTouchMode.Token idleClose = start(calls);
+        check(LdyAn00FingerprintTouchMode.requestClose(idleClose, () -> {
+            LdyAn00FingerprintTouchMode.stop(idleClose, true);
+            check(LdyAn00FingerprintTouchMode.owns(idleClose)); // Keep close call reservation.
+        }));
+        check(!LdyAn00FingerprintTouchMode.owns(idleClose));
