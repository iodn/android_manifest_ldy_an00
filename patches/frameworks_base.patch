+        private final Setter setter;
+        private boolean startPending = true;
+        private Runnable closeAfterStart;
+        private int calls = 1; // Reservation covers the pending fingerprint start RPC.
+        private boolean writing, clean = true, stopping, quiesced, cancelClaimed;
+        private Token(Setter setter) { this.setter = setter; }
+    }
+    private static final Object LOCK = new Object();
+    private static Token sOwner;
+
+    static Token reserve(Setter setter) {
+        synchronized (LOCK) {
+            if (sOwner != null) return null;
+            sOwner = new Token(setter);
+            return sOwner;
+        }
+    }
+
+    static boolean enable(Token token) {
+        synchronized (LOCK) {
+            if (sOwner != token || token.stopping) return false;
+            token.clean = false; // A failed setter may still change the remote mode.
+            token.writing = true;
+        }
+        boolean enabled = write(token, true);
+        boolean stopping;
+        synchronized (LOCK) {
+            token.writing = false;
+            token.stopping |= !enabled;
+            stopping = token.stopping;
+        }
+        if (stopping) stop(token, false);
+        synchronized (LOCK) {
+            return enabled && sOwner == token && !token.stopping;
+        }
+    }
+
+    /** Fence the captured cancellation before invoking its native signal. */
+    static boolean claimCancel(Token token) {
+        synchronized (LOCK) {
+            if (sOwner != token || token.cancelClaimed || token.quiesced) return false;
+            token.cancelClaimed = true;
+            token.stopping = true;
+            ++token.calls;
+            return true;
+        }
+    }
+
+    /** Own close cannot overtake a reserved/in-flight fingerprint start. */
+    static boolean requestClose(Token token, Runnable close) {
+        boolean claimed;
+        synchronized (LOCK) {
+            claimed = token != null && sOwner == token;
+            if (claimed && token.startPending) {
+                if (token.closeAfterStart != null) throw new IllegalStateException("Duplicate close");
+                token.closeAfterStart = close;
+                return false;
+            }
+            if (claimed) ++token.calls;
+        }
+        try { close.run(); }
+        finally { if (claimed) finishCall(token); }
+        return true;
+    }
+
+    static void finishStart(Token token) {
+        Runnable close;
+        synchronized (LOCK) {
+            if (!token.startPending) throw new IllegalStateException("Duplicate start completion");
+            token.startPending = false;
+            close = token.closeAfterStart;
+            token.closeAfterStart = null;
+        }
+        // Retain the captured start reservation until any deferred native close returns.
+        try { if (close != null) close.run(); }
+        finally { finishCall(token); }
+    }
+
+    static void finishCall(Token token) {
+        synchronized (LOCK) {
+            if (token.calls <= 0) throw new IllegalStateException("Unowned native completion");
+            --token.calls;
+            releaseIfDone(token);
+        }
+    }
+
+    /** Terminal=false requests cleanup but fences reuse until an acknowledged terminal. */
+    static void stop(Token token, boolean terminal) {
+        boolean cleanup;
+        synchronized (LOCK) {
+            if (sOwner != token) return;
+            token.stopping = true;
+            token.quiesced |= terminal;
+            cleanup = !token.writing && !token.clean;
+            if (cleanup) token.writing = true;
+            releaseIfDone(token);
+        }
+        if (!cleanup) return; // In-flight enable/disable owns the eventual cleanup.
+        boolean clean = write(token, false);
+        synchronized (LOCK) {
+            token.writing = false;
+            token.clean = clean;
+            releaseIfDone(token);
+        }
+    }
+
+    static boolean active(Token token) {
+        synchronized (LOCK) { return token != null && sOwner == token && !token.stopping; }
+    }
+
+    static boolean owns(Token token) {
+        synchronized (LOCK) { return token != null && sOwner == token; }
+    }
+
+    private static void releaseIfDone(Token token) {
+        if (sOwner == token && token.stopping && token.quiesced
+                && token.clean && !token.writing && token.calls == 0) sOwner = null;
+    }
+
+    private static boolean write(Token token, boolean enabled) {
+        try { return token.setter.set(enabled); }
+        catch (RuntimeException failure) { return false; }
+    }
+}
