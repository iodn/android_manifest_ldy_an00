diff --git a/services/core/java/com/android/server/biometrics/sensors/HonorFaceStrongReset.java b/services/core/java/com/android/server/biometrics/sensors/HonorFaceStrongReset.java
new file mode 100644
index 0000000000000000000000000000000000000000..eb314987ec551295c12c81c23f7e809e4f8116e8
--- /dev/null
+++ b/services/core/java/com/android/server/biometrics/sensors/HonorFaceStrongReset.java
@@ -0,0 +1,33 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.server.biometrics.sensors;
+
+/** Captured before scheduling; used only after AuthenticationClient accepts a native success. */
+final class HonorFaceStrongReset {
+    interface Authority {
+        long captureEpoch(int userId);
+        int currentStrength(int fromSensorId);
+        void authorize(int userId, int fromSensorId, int currentStrength, long epoch,
+                long operationId, byte[] hat);
+    }
+    private final Authority mAuthority;
+    private final int mUserId, mFromSensorId;
+    private final long mEpoch, mOperationId;
+
+    HonorFaceStrongReset(boolean fingerprintClient, int userId, int fromSensorId,
+            boolean capturedStrong, long operationId, Authority authority) {
+        mAuthority = authority;
+        mUserId = userId; mFromSensorId = fromSensorId; mOperationId = operationId;
+        mEpoch = fingerprintClient && capturedStrong && userId >= 0 && fromSensorId == 0
+                ? authority.captureEpoch(userId) : -1;
+    }
+
+    void verified(byte[] hat) {
+        if (mEpoch < 0) return;
+        int strength = mAuthority.currentStrength(mFromSensorId);
+        if (strength != 15 /* Authenticators.BIOMETRIC_STRONG */) return;
+        mAuthority.authorize(mUserId, mFromSensorId, strength, mEpoch, mOperationId, hat);
+    }
+}
