+package com.android.server.health;
+
+import android.os.SystemProperties;
+
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.function.Supplier;
+
+/** The individual checker's pack SN, not its chip UUID or the aggregate battery ID. */
+final class HonorBatterySerialNumber {
+    private static final Path SERIAL_PATH = Path.of("/sys/devices/platform/honor_batt_info/"
+            + "honor_batt_info:battery_checker@0/batt_id");
+
+    static String read() {
+        return read(SystemProperties.get("ro.product.product.model"),
+                SystemProperties.get("ro.product.product.device"), SystemProperties.get("ro.hardware"),
+                () -> {
+                    try {
+                        return Files.readString(SERIAL_PATH);
+                    } catch (IOException | SecurityException e) {
+                        return "";
+                    }
+                });
+    }
+
+    static String read(String model, String device, String hardware, Supplier<String> reader) {
+        if (!HonorBatteryManufacturingDate.isSupportedDevice(model, device, hardware)) return "";
+        return parse(reader.get());
+    }
+
+    static String parse(String raw) {
+        String serial = raw.trim();
+        if (serial.length() != 16) return "";
+        for (int i = 0; i < serial.length(); i++) {
+            char value = serial.charAt(i);
+            if (value < '!' || value > '~') return "";
+            // sh_battct_sn_bin2asc emits uppercase hex at these positions.
+            if (((0xfb80 >> i) & 1) != 0
+                    && !(value >= '0' && value <= '9' || value >= 'A' && value <= 'F')) {
+                return "";
+            }
+        }
+        return serial;
+    }
+
+    private HonorBatterySerialNumber() {}
+}
