+            data.writeInterfaceToken(OEM + "IFaceInfoCallback");
+            data.writeIntArray(new int[] {81, 82});
+            assertThat(ids.transact(1, data, reply, 0)).isTrue();
+            reply.readException();
+            reply.enforceNoDataAvail();
+        } finally {
+            reply.recycle();
+            data.recycle();
+        }
+        assertThat(result).containsExactly("0:287454020:1432778632:[1, 2, 3]", "[81, 82]")
+                .inOrder();
+    }
+
+    private static void deliver(RecordingCallback callback, int code, int... values)
+            throws RemoteException {
+        Parcel data = Parcel.obtain(callback);
+        try {
+            data.writeInterfaceToken(OEM + "IBiometricsFaceRecognizeClientCallback");
+            for (int value : values) data.writeInt(value);
+            assertThat(callback.transact(code, data, null, IBinder.FLAG_ONEWAY)).isTrue();
+        } finally {
+            data.recycle();
+        }
+    }
+
+    private static final class RecordingCallback
+            extends HonorLdyAn00FaceVendorClient.ClientCallback {
+        final ArrayList<String> events = new ArrayList<>();
+        @Override void onAuthenticationAcquired(int acquired) { events.add("authAcquire:" + acquired); }
+        @Override void onAuthenticationResult(int id, int error) {
+            events.add("auth:" + id + ":" + error);
+        }
+        @Override void onCancel(int type) { events.add("cancel:" + type); }
+        @Override void onEnrollAcquired(int acquired, int process) {
+            events.add("acquire:" + acquired + ":" + process);
+        }
+        @Override void onEnrollResult(int id, int user, int error) {
+            events.add("enroll:" + id + ":" + user + ":" + error);
+        }
+        @Override void onRemovedResult(int user, int error) {
+            events.add("remove:" + user + ":" + error);
+        }
+    }
+
+    private static final class FakeVendor extends Binder {
+        final ArrayList<Integer> calls = new ArrayList<>();
+        int version = 2;
+        String hash = HASH;
+        IBinder callback;
+        long operationId;
+        int userId;
+        int faceId;
+        int enrollFlag;
+        byte[] hat;
+        FakeVendor() { attachInterface(null, OEM + "IBiometricsFaceRecognize"); }
+        @Override protected boolean onTransact(int code, Parcel data, Parcel reply, int flags) {
+            data.enforceInterface(OEM + "IBiometricsFaceRecognize");
+            assertThat(flags).isEqualTo(0);
+            calls.add(code);
+            switch (code) {
+                case 0xffffff:
+                    data.enforceNoDataAvail();
+                    reply.writeNoException(); reply.writeInt(version); return true;
+                case 0xfffffe:
+                    data.enforceNoDataAvail();
+                    reply.writeNoException(); reply.writeString(hash); return true;
+                case 21:
+                    enrollFlag = data.readInt();
+                    data.enforceNoDataAvail();
+                    reply.writeNoException(); reply.writeInt(0); return true;
+                case 22:
+                    callback = data.readStrongBinder();
+                    data.enforceNoDataAvail();
+                    reply.writeNoException(); reply.writeLong(0x1122334455667788L); return true;
+                case 1:
+                    operationId = data.readLong(); userId = data.readInt();
+                    data.enforceNoDataAvail();
+                    reply.writeNoException(); reply.writeInt(0); return true;
+                case 14:
+                    userId = data.readInt(); faceId = data.readInt();
+                    data.enforceNoDataAvail();
+                    reply.writeNoException(); reply.writeInt(0); return true;
+                case 2: case 3: case 4: case 10:
+                    data.enforceNoDataAvail();
+                    reply.writeNoException(); reply.writeInt(0); return true;
+                case 11:
+                    data.enforceNoDataAvail();
+                    reply.writeNoException(); reply.writeLong(0x1020304050607080L); return true;
+                case 5:
+                    hat = data.createFixedArray(byte[].class, 69); userId = data.readInt();
+                    data.enforceNoDataAvail();
+                    reply.writeNoException(); reply.writeInt(0); return true;
+                default: return false;
+            }
+        }
+    }
+}
