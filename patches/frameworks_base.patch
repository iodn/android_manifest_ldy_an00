@@ -0,0 +1,36 @@
+package android.hardware.face;
+
+import java.util.Arrays;
+import java.util.HexFormat;
+
+public final class HonorLdyAn00FaceHatCodecHostTest {
+    public static void main(String[] args) {
+        byte[] mac = new byte[32];
+        for (int i = 0; i < mac.length; i++) mac[i] = (byte) i;
+        byte[] packed = HonorLdyAn00FaceHatCodec.encode(0x0102030405060708L,
+                0x1112131415161718L, 0x2122232425262728L, 0x31323334,
+                0x4142434445464748L, mac);
+        String expected = "00" + "0807060504030201" + "1817161514131211"
+                + "2827262524232221" + "31323334" + "4142434445464748"
+                + "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f";
+        if (!expected.equals(HexFormat.of().formatHex(packed))) {
+            throw new AssertionError("Packed HAT endian/field order");
+        }
+        Arrays.fill(mac, (byte) 0);
+        if (!expected.equals(HexFormat.of().formatHex(packed))) {
+            throw new AssertionError("Input aliasing");
+        }
+        for (byte[] invalid : new byte[][]{null, new byte[31], new byte[33]}) {
+            try {
+                HonorLdyAn00FaceHatCodec.encode(1, 2, 3, 4, 5, invalid);
+                throw new AssertionError("Malformed MAC accepted");
+            } catch (IllegalArgumentException expectedFailure) { }
+        }
+        byte[] signed = HonorLdyAn00FaceHatCodec.encode(-1L, Long.MIN_VALUE, -3L,
+                Integer.MIN_VALUE, Long.MIN_VALUE, new byte[32]);
+        if (signed.length != 69 || signed[8] != (byte) 0xff
+                || signed[16] != (byte) 0x80 || signed[25] != (byte) 0x80
+                || signed[29] != (byte) 0x80) throw new AssertionError("Signed fields changed");
+        System.out.println("HAT_CODEC_HOST_OK checks=6");
+    }
+}
diff --git a/core/tests/face-operation-owner/HonorLdyAn00FaceOperationHostTest.java b/core/tests/face-operation-owner/HonorLdyAn00FaceOperationHostTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..468634197fe0d135a4f73d2e45a06ac0f8a35259
--- /dev/null
+++ b/core/tests/face-operation-owner/HonorLdyAn00FaceOperationHostTest.java
@@ -0,0 +1,134 @@
+package android.hardware.face;
+
+import static android.hardware.face.HonorLdyAn00FaceOperation.Kind.*;
+import static android.hardware.face.HonorLdyAn00FaceOperation.State.*;
+
+/** Runs the actual production gate source, without framework/vendor service mocks. */
+public final class HonorLdyAn00FaceOperationHostTest {
+    private static int checks;
+    private static void check(boolean value) {
+        checks++;
+        if (!value) throw new AssertionError("check " + checks);
+    }
+    private static void rejects(Runnable r) {
+        checks++;
+        try { r.run(); } catch (IllegalStateException expected) { return; }
+        throw new AssertionError("expected rejection " + checks);
+    }
+    public static void main(String[] args) throws Exception {
+        normalDrain(); cancellation(); staleLocalCancellation(); unknownCompletion();
+        badAcknowledgement(); concurrentTerminalAndCancel(); callbackBeforeMethodReturn();
+        System.out.println("OPERATION_OWNER_HOST_OK checks=" + checks);
+    }
+    private static void normalDrain() {
+        HonorLdyAn00FaceOperation gate = new HonorLdyAn00FaceOperation();
+        check(gate.state() == IDLE);
+        var t = gate.begin(AUTHENTICATE);
+        check(gate.running(AUTHENTICATE) == t && gate.running(ENROLL) == null);
+        rejects(() -> gate.begin(ENROLL));
+        rejects(gate::close);
+        int[] delivered = {0};
+        check(gate.terminal(t, () -> delivered[0]++));
+        check(gate.state() == DRAINING && gate.running(AUTHENTICATE) == null);
+        check(!gate.terminal(t, () -> { throw new AssertionError("duplicate terminal"); }));
+        check(delivered[0] == 0);
+        rejects(() -> gate.begin(AUTHENTICATE));
+        Runnable completion = gate.drained(2, () -> { throw new AssertionError("unexpected drain failure"); });
+        check(delivered[0] == 0 && gate.state() == IDLE);
+        completion.run();
+        check(delivered[0] == 1);
+        gate.close(); gate.close();
+        check(gate.state() == CLOSED);
+        rejects(() -> gate.begin(AUTHENTICATE));
+        check(gate.drained(2, () -> { throw new AssertionError("unexpected drain failure"); }) == null);
+    }
+    private static void cancellation() {
+        for (var kind : HonorLdyAn00FaceOperation.Kind.values()) {
+            for (boolean terminalFirst : new boolean[]{false, true}) {
+                HonorLdyAn00FaceOperation gate = new HonorLdyAn00FaceOperation();
+                var t = gate.begin(kind);
+                int[] delivered = {0};
+                if (terminalFirst) check(gate.terminal(t, () -> delivered[0] = 1));
+                check(gate.cancel(t, () -> delivered[0] = 2) == !terminalFirst);
+                check(!gate.cancel(t, () -> delivered[0] = 3));
+                check(!gate.terminal(t, () -> delivered[0] = 4));
+                check(delivered[0] == 0);
+                gate.drained(kind.cancelType, () -> { throw new AssertionError("unexpected drain failure"); }).run();
+                check(delivered[0] == 2 && gate.state() == IDLE);
+            }
+        }
+    }
+    private static void staleLocalCancellation() {
+        HonorLdyAn00FaceOperation gate = new HonorLdyAn00FaceOperation();
+        var old = gate.begin(ENROLL);
+        gate.terminal(old, () -> {}); gate.drained(1, () -> { throw new AssertionError("unexpected drain failure"); }).run();
+        var current = gate.begin(AUTHENTICATE);
+        check(!gate.cancel(old, () -> { throw new AssertionError("old cancellation"); }));
+        check(!gate.terminal(old, () -> { throw new AssertionError("old terminal"); }));
+        check(gate.running(AUTHENTICATE) == current);
+    }
+    private static void unknownCompletion() {
+        for (boolean terminalFirst : new boolean[]{false, true}) {
+            HonorLdyAn00FaceOperation gate = new HonorLdyAn00FaceOperation();
+            var t = gate.begin(AUTHENTICATE);
+            if (terminalFirst) gate.terminal(t, () -> { throw new AssertionError("lost success"); });
+            int[] unavailable = {0};
+            Runnable failed = gate.fail(() -> unavailable[0]++);
+            check(unavailable[0] == 0 && gate.state() == FAILED);
+            failed.run();
+            check(unavailable[0] == 1);
+            check(gate.fail(() -> { throw new AssertionError("duplicate failure"); }) == null);
+            check(gate.drained(2, () -> { throw new AssertionError("unexpected drain failure"); }) == null);
+            check(!gate.cancel(t, () -> {}));
+            rejects(() -> gate.begin(AUTHENTICATE));
+            gate.close(); check(gate.state() == CLOSED);
+        }
+        var idle = new HonorLdyAn00FaceOperation();
+        check(idle.fail(() -> { throw new AssertionError("idle failure callback"); }) == null);
+        check(idle.state() == FAILED);
+    }
+    private static void badAcknowledgement() {
+        for (boolean running : new boolean[]{false, true}) {
+            HonorLdyAn00FaceOperation gate = new HonorLdyAn00FaceOperation();
+            var t = gate.begin(AUTHENTICATE);
+            if (!running) gate.terminal(t, () -> { throw new AssertionError("bad ack success"); });
+            int[] errors = {0};
+            Runnable unavailable = gate.drained(running ? 2 : 1, () -> errors[0]++);
+            check(errors[0] == 0); unavailable.run(); check(errors[0] == 1);
+            check(gate.state() == FAILED);
+            rejects(() -> gate.begin(AUTHENTICATE));
+        }
+        HonorLdyAn00FaceOperation idle = new HonorLdyAn00FaceOperation();
+        check(idle.drained(2, () -> { throw new AssertionError("idle error callback"); }) == null);
+        check(idle.state() == FAILED);
+    }
+    private static void concurrentTerminalAndCancel() throws Exception {
+        // Internal locking must never execute callbacks or lose cancellation, irrespective of
+        // which request reaches the gate first. Normal owner delivery is still executor-confined.
+        for (int i = 0; i < 100; i++) {
+            HonorLdyAn00FaceOperation gate = new HonorLdyAn00FaceOperation();
+            var t = gate.begin(AUTHENTICATE);
+            int[] drains = {0, 0};
+            int[] delivered = {0};
+            Thread first = new Thread(() -> {
+                if (gate.terminal(t, () -> delivered[0] = 1)) drains[0]++;
+            });
+            Thread second = new Thread(() -> {
+                if (gate.cancel(t, () -> delivered[0] = 2)) drains[1]++;
+            });
+            first.start(); second.start(); first.join(); second.join();
+            check(drains[0] + drains[1] == 1 && delivered[0] == 0);
+            gate.drained(2, () -> { throw new AssertionError("unexpected drain failure"); }).run(); check(delivered[0] == 2);
+        }
+    }
+    private static void callbackBeforeMethodReturn() {
+        HonorLdyAn00FaceOperation gate = new HonorLdyAn00FaceOperation();
+        var t = gate.begin(AUTHENTICATE);
+        // The owner establishes state before making a synchronous Binder call. A reentrant
+        // callback can be queued before that call returns; no remote call is made by the gate.
+        int[] delivered = {0};
+        check(gate.terminal(t, () -> delivered[0]++));
+        check(delivered[0] == 0);
+        gate.drained(2, () -> { throw new AssertionError("unexpected drain failure"); }).run(); check(delivered[0] == 1);
+    }
+}
diff --git a/core/tests/face-operation-owner/HonorLdyAn00FaceResetHostTest.java b/core/tests/face-operation-owner/HonorLdyAn00FaceResetHostTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..e8f6a25fe8e0b9d94934f537854f6084d5ee5dda
--- /dev/null
+++ b/core/tests/face-operation-owner/HonorLdyAn00FaceResetHostTest.java
@@ -0,0 +1,176 @@
+package android.hardware.face;
+
+import java.io.IOException;
+import java.util.Arrays;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.TimeUnit;
+
+public final class HonorLdyAn00FaceResetHostTest {
+    private static int checks;
+    private static void check(boolean value) {
+        if (!value) throw new AssertionError("check " + checks);
+        checks++;
+    }
+    private static byte[] token(long challenge) {
+        byte[] mac = new byte[32]; Arrays.fill(mac, (byte) 0x5a);
+        // Secure SID intentionally differs from the Android userID passed to the registry.
+        return HonorLdyAn00FaceHatCodec.encode(challenge, 0x12345678, 77, 1, 1234, mac);
+    }
+    public static void main(String[] args) throws Exception {
+        provenance(); strongFingerprint(); expiryAndEpoch(); atomicClear(); lockoutPersistence();
+        System.out.println("FACE_RESET_HOST_OK checks=" + checks);
+    }
+    private static void provenance() {
+        long[] now = {100}; var permits = new HonorLdyAn00FaceResetPermits(() -> now[0]);
+        byte[] hat = token(0);
+        check(!permits.consume(0, 1, hat)); // Public reset alone has no authority.
+        check(permits.grant(0, 1, permits.epoch(0), 0, hat));
+        check(!permits.consume(10, 1, hat));
+        check(!permits.consume(0, 2, hat));
+        byte[] changed = hat.clone(); changed[37] ^= 1;
+        check(!permits.consume(0, 1, changed));
+        check(permits.consume(0, 1, hat));
+        check(!permits.consume(0, 1, hat)); // Replay.
+        check(!permits.grant(0, 1, permits.epoch(0), 99, hat));
+        check(!permits.grant(0, 2, permits.epoch(0), 0, hat));
+        check(!permits.grant(-1, 1, 0, 0, hat));
+        for (byte[] bad : new byte[][]{null, new byte[68], new byte[70]}) {
+            check(!permits.grant(0, 1, permits.epoch(0), 0, bad));
+        }
+        byte[] badVersion = hat.clone(); badVersion[0] = 1;
+        check(!permits.grant(0, 1, permits.epoch(0), 0, badVersion));
+        byte[] biometric = hat.clone(); biometric[28] = 2;
+        check(!permits.grant(0, 1, permits.epoch(0), 0, biometric));
+        check(permits.grant(0, 1, permits.epoch(0), 0, hat));
+        byte[] saved = hat.clone(); Arrays.fill(hat, (byte) 0);
+        check(permits.consume(0, 1, saved)); // Registry copied the verified response.
+        byte[] nonzero = token(999);
+        check(permits.grant(10, 1, permits.epoch(10), 999, nonzero));
+        check(permits.consume(10, 1, nonzero));
+    }
+    private static void strongFingerprint() throws Exception {
+        long[] now = {100};
+        var permits = new HonorLdyAn00FaceResetPermits(() -> now[0]);
+        byte[] fp = token(55); fp[28] = 2; // Packed authenticator_type is BE.
+        check(!permits.consume(0, 1, fp)); // Public reset/source claims mint nothing.
+        check(!permits.grantStrongFingerprint(0, 1, 15, 0, 55, fp));
+        for (int strength : new int[]{0, 255, 4095}) {
+            check(!permits.grantStrongFingerprint(0, 0, strength, 0, 55, fp));
+        }
+        check(!permits.grantStrongFingerprint(0, 0, 15, 0, 56, fp));
+        check(!permits.grantStrongFingerprint(0, 0, 15, 0, 55, token(55)));
+        check(permits.grantStrongFingerprint(0, 0, 15, 0, 55, fp));
+        check(!permits.consume(10, 1, fp)); check(!permits.consume(0, 0, fp));
+        byte[] forged = fp.clone(); forged[45] ^= 1;
+        check(!permits.consume(0, 1, forged));
+        check(permits.consume(0, 1, fp)); check(!permits.consume(0, 1, fp));
+        check(permits.grantStrongFingerprint(0, 0, 15, 0, 55, fp));
+        now[0] += 15_001; check(!permits.consume(0, 1, fp));
+        long queued = permits.epoch(0); permits.invalidate(0);
+        check(!permits.grantStrongFingerprint(0, 0, 15, queued, 55, fp));
+        check(permits.grantStrongFingerprint(0, 0, 15, permits.epoch(0), 55, fp));
+        int[] clears = {0};
+        check(permits.consumeAndClear(0, 1, fp, () -> clears[0]++)); check(clears[0] == 1);
+    }
+
+    private static void expiryAndEpoch() {
+        long[] now = {100}; var permits = new HonorLdyAn00FaceResetPermits(() -> now[0]);
+        byte[] hat = token(0);
+        check(permits.grant(0, 1, 0, 0, hat)); now[0] += 15_001;
+        check(!permits.consume(0, 1, hat));
+        check(permits.grant(0, 1, 0, 0, hat)); now[0]--;
+        check(!permits.consume(0, 1, hat));
+        long old = permits.epoch(0);
+        check(permits.grant(0, 1, old, 0, hat));
+        permits.invalidate(0);
+        check(!permits.consume(0, 1, hat));
+        check(!permits.grant(0, 1, old, 0, hat)); // Old queued authentication after PIN change.
+        long changed = permits.epoch(0);
+        permits.invalidate(0); // Removal/recreation retains a higher userID tombstone.
+        check(permits.epoch(0) > changed);
+        check(!permits.grant(0, 1, changed, 0, hat));
+        check(permits.grant(0, 1, permits.epoch(0), 0, hat));
+        var afterBoot = new HonorLdyAn00FaceResetPermits(() -> now[0]);
+        check(!afterBoot.consume(0, 1, hat)); // Permits never persist across process/boot.
+        byte[] next = token(0); next[40]++;
+        check(permits.grant(0, 1, permits.epoch(0), 0, next));
+        check(!permits.consume(0, 1, hat));
+        check(permits.consume(0, 1, next));
+    }
+    private static void atomicClear() throws Exception {
+        var permits = new HonorLdyAn00FaceResetPermits(() -> 100L);
+        byte[] hat = token(0); int[] clears = {0};
+        check(!permits.consumeAndClear(0, 1, hat, () -> clears[0]++));
+        check(clears[0] == 0);
+        check(permits.grant(0, 1, 0, 0, hat));
+        try {
+            permits.consumeAndClear(0, 1, hat, () -> { throw new IOException("failed fsync"); });
+            throw new AssertionError("clear failure swallowed");
+        } catch (IOException expected) { checks++; }
+        check(!permits.consume(0, 1, hat)); // Failed durable clear still consumes the one-use permit.
+        check(permits.grant(0, 1, 0, 0, hat));
+        CountDownLatch inClear = new CountDownLatch(1), release = new CountDownLatch(1);
+        CountDownLatch invalidateDone = new CountDownLatch(1);
+        Throwable[] failure = {null};
+        Thread reset = new Thread(() -> {
+            try {
+                permits.consumeAndClear(0, 1, hat, () -> {
+                    inClear.countDown();
+                    try {
+                        if (!release.await(5, TimeUnit.SECONDS)) throw new IOException("test timeout");
+                    } catch (InterruptedException interrupted) { throw new IOException(interrupted); }
+                });
+            } catch (Throwable error) { failure[0] = error; }
+        });
+        reset.start(); check(inClear.await(5, TimeUnit.SECONDS));
+        Thread invalidator = new Thread(() -> { permits.invalidate(0); invalidateDone.countDown(); });
+        invalidator.start(); check(!invalidateDone.await(30, TimeUnit.MILLISECONDS));
+        release.countDown(); reset.join(5000); invalidator.join(5000);
+        check(!reset.isAlive() && !invalidator.isAlive() && failure[0] == null);
+        check(permits.epoch(0) == 1);
+    }
+    private static final class MemoryStore implements HonorLdyAn00FaceLockout.Storage {
+        HonorLdyAn00FaceLockout.Record record;
+        boolean fail;
+        @Override public HonorLdyAn00FaceLockout.Record read() { return record; }
+        @Override public void write(HonorLdyAn00FaceLockout.Record value) throws IOException {
+            if (fail) throw new IOException("Injected persistence failure");
+            record = value;
+        }
+    }
+    private static void lockoutPersistence() throws Exception {
+        long[] now = {100}; MemoryStore store = new MemoryStore();
+        var lockout = new HonorLdyAn00FaceLockout(store, () -> now[0]);
+        check(!lockout.permanent() && lockout.remaining() == 0);
+        for (int i = 0; i < 4; i++) lockout.failedMatch();
+        check(store.record.attempts == 4 && lockout.remaining() == 0);
+        lockout.failedMatch(); check(lockout.remaining() == 30_000 && store.record.timed);
+        try { lockout.failedMatch(); throw new AssertionError("Matching during lockout"); }
+        catch (IOException expected) { checks++; }
+        now[0] += 25_000; check(lockout.remaining() == 5_000);
+        // A new process/boot cannot reuse old elapsed/wall time to skip an active wait.
+        now[0] = 5; lockout = new HonorLdyAn00FaceLockout(store, () -> now[0]);
+        check(lockout.remaining() == 30_000 && store.record.attempts == 5);
+        now[0] += 30_000; check(lockout.remaining() == 0 && !store.record.timed);
+        for (int i = 6; i <= 20; i++) {
+            lockout.failedMatch();
+            if (i < 20 && i % 5 == 0) { now[0] += 30_000; lockout.remaining(); }
+        }
+        check(lockout.permanent() && store.record.attempts == 20);
+        var restarted = new HonorLdyAn00FaceLockout(store, () -> now[0]);
+        check(restarted.permanent());
+        store.fail = true;
+        try { restarted.clear(); throw new AssertionError("Persistence failure swallowed"); }
+        catch (IOException expected) { checks++; }
+        check(restarted.permanent() && store.record.attempts == 20);
+        store.fail = false; restarted.clear();
+        check(!restarted.permanent() && store.record.attempts == 0);
+        MemoryStore otherUser = new MemoryStore();
+        var other = new HonorLdyAn00FaceLockout(otherUser, () -> now[0]);
+        other.failedMatch(); check(otherUser.record.attempts == 1 && store.record.attempts == 0);
+        try { new HonorLdyAn00FaceLockout.Record(-1, false); throw new AssertionError(); }
+        catch (IllegalArgumentException expected) { checks++; }
+        try { new HonorLdyAn00FaceLockout.Record(1, true); throw new AssertionError(); }
+        catch (IllegalArgumentException expected) { checks++; }
+    }
+}
