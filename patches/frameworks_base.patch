+        mLooper.dispatchAll();
+
+        verify(mClient).onAuthenticated(any(), eq(true), eq(new ArrayList<Byte>()));
+        verify(mClient, never()).onError(anyInt(), anyInt());
+    }
+
+    @Test
+    public void nonStrongNullHatSurvivesGeneratedProxyParcelAndStub() throws RemoteException {
