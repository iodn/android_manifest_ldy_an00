+package android.hardware.face;
+
+import static org.junit.Assert.*;
+import android.app.AppGlobals;
+import android.system.Os;
+import java.io.File;
+import java.io.IOException;
+import java.nio.file.Files;
+import org.junit.After;
+import org.junit.Before;
+import org.junit.Test;
+
+/** Real AtomicFile/OS I/O, isolated entirely in this test APK cache; no templates or system DE. */
+public class HonorLdyAn00FaceMetadataFileTest {
+    private File mDirectory;
+    @Before public void setup() throws Exception {
+        mDirectory = Files.createTempDirectory(AppGlobals.getInitialApplication().getCacheDir()
+                .toPath(), "honor-face-metadata-").toFile();
+    }
+    @After public void cleanup() throws Exception {
+        for (File file : mDirectory.listFiles()) Files.delete(file.toPath());
+        Files.delete(mDirectory.toPath());
+    }
+    interface Action { void run() throws IOException; }
+    private static void refuses(Action action) throws IOException {
+        try { action.run(); } catch (IOException expected) { return; }
+        fail("Invalid metadata accepted");
+    }
+    @Test public void lockoutRoundTripPreservesTimedAndPermanentState() throws Exception {
+        File path = new File(mDirectory, "lockout");
+        var store = new HonorLdyAn00FaceLockoutFile(10, 1, path);
+        assertNull(store.read()); store.write(new HonorLdyAn00FaceLockout.Record(5, true));
+        var reopened = new HonorLdyAn00FaceLockoutFile(10, 1, path);
+        assertEquals(5, reopened.read().attempts); assertTrue(reopened.read().timed);
+        assertEquals(0600, Os.stat(path.getPath()).st_mode & 0777);
+        reopened.write(new HonorLdyAn00FaceLockout.Record(20, false));
+        assertEquals(20, store.read().attempts); assertFalse(store.read().timed);
+    }
+    @Test public void malformedAndWrongUserRecordsAreNotNewState() throws Exception {
+        File path = new File(mDirectory, "lockout");
+        var store = new HonorLdyAn00FaceLockoutFile(10, 1, path);
+        store.write(new HonorLdyAn00FaceLockout.Record(5, true));
+        refuses(() -> new HonorLdyAn00FaceLockoutFile(11, 1, path).read());
+        Files.write(path.toPath(), new byte[]{1, 2, 3});
+        refuses(store::read);
+    }
+    @Test public void unsafeModeAndPartialFirstWriteAreNotZeroFailures() throws Exception {
+        File path = new File(mDirectory, "lockout");
+        var store = new HonorLdyAn00FaceLockoutFile(10, 1, path);
+        Files.write(new File(path + ".new").toPath(), new byte[]{1});
+        refuses(store::read); Files.delete(new File(path + ".new").toPath());
+        store.write(new HonorLdyAn00FaceLockout.Record(5, true));
+        Os.chmod(path.getPath(), 0644); refuses(store::read);
+    }
+    @Test public void atomicBackupRecoversPriorValidState() throws Exception {
+        File path = new File(mDirectory, "lockout");
+        var store = new HonorLdyAn00FaceLockoutFile(10, 1, path);
+        store.write(new HonorLdyAn00FaceLockout.Record(5, true));
+        File backup = new File(path + ".bak");
+        Files.copy(path.toPath(), backup.toPath()); Os.chmod(backup.getPath(), 0600);
+        Files.write(path.toPath(), new byte[]{1});
+        assertEquals(5, store.read().attempts); assertTrue(store.read().timed);
+    }
+    @Test public void bootPendingSurvivesReopenAndKnownCloseClearsIt() throws Exception {
+        File path = new File(mDirectory, "owner");
+        String boot = "00000000-0000-0000-0000-000000000001";
+        var first = new HonorLdyAn00FaceBootFence(new HonorLdyAn00FaceBootFenceFile(path), boot);
+        first.reserve();
+        refuses(new HonorLdyAn00FaceBootFence(new HonorLdyAn00FaceBootFenceFile(path), boot)
+                ::reserve);
+        first.release();
+        new HonorLdyAn00FaceBootFence(new HonorLdyAn00FaceBootFenceFile(path), boot).reserve();
+    }
+    @Test public void fileInsteadOfParentCannotProduceSuccessfulDurableWrite() throws Exception {
+        File parent = new File(mDirectory, "not-directory"); Files.write(parent.toPath(), new byte[0]);
+        var store = new HonorLdyAn00FaceLockoutFile(10, 1, new File(parent, "lockout"));
+        refuses(() -> store.write(new HonorLdyAn00FaceLockout.Record(5, true)));
+    }
+}
