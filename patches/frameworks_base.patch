+        assertNotNull(privacy.listener);
+        cancellation.cancel(); mLooper.dispatchAll();
+        assertNotNull(privacy.listener); // Native camera still owned until ACK.
+        mVendor.cancelAck(2); mLooper.dispatchAll();
