+    private void prepareCoherentCaps(boolean enabled, boolean automatic, boolean hdr) {
+        mHolder.dpc.stop();
+        advanceTime(1);
+        doAnswer((Answer<Boolean>) invocation -> enabled).when(() ->
+                SystemProperties.getBoolean("ro.display.sdr_hdr_caps", false));
+        mCoherentStorage = new com.android.server.display.plugin.CapPluginStorageFixture(
+                mContext, mDisplayManagerFlagsMock);
+        mMockPluginManager = mCoherentStorage.manager;
+        Settings.System.putInt(mContext.getContentResolver(), Settings.System.SCREEN_BRIGHTNESS_MODE,
+                automatic ? Settings.System.SCREEN_BRIGHTNESS_MODE_AUTOMATIC
+                        : Settings.System.SCREEN_BRIGHTNESS_MODE_MANUAL);
+        mHolder = createDisplayPowerController(DISPLAY_ID, UNIQUE_ID);
+        when(mHolder.displayPowerState.getScreenState()).thenReturn(Display.STATE_ON);
+        when(mHolder.displayPowerState.getColorFadeLevel()).thenReturn(1f);
+        when(mHolder.automaticBrightnessController.getAutomaticScreenBrightness(
+                any(BrightnessEvent.class))).thenReturn(.8f);
+        when(mHolder.brightnessSetting.getBrightness()).thenReturn(.8f);
+        ArgumentCaptor<BrightnessSetting.BrightnessSettingListener> listener =
+                ArgumentCaptor.forClass(BrightnessSetting.BrightnessSettingListener.class);
+        verify(mHolder.brightnessSetting).registerListener(listener.capture());
+        listener.getValue().onBrightnessChanged(.8f);
+        when(mHolder.clamperController.clamp(any(), any(), anyFloat(), anyBoolean(), anyInt()))
+                .thenAnswer(invocation -> DisplayBrightnessState.Builder.from(
+                        (DisplayBrightnessState) invocation.getArgument(0))
+                        .setBrightness(invocation.getArgument(2))
+                        .setHdrBrightness(hdr
+                                ? (float) Math.sqrt((Float) invocation.getArgument(2))
+                                : DisplayBrightnessState.BRIGHTNESS_NOT_SET)
+                        .setMaxBrightness(1f).setCustomAnimationRate(-1f).build());
+        mCoherentStorage.storage.updateValue(
+                com.android.server.display.plugin.PluginType.SDR_HDR_BRIGHTNESS_CAPS, UNIQUE_ID,
+                new com.android.server.display.plugin.types.SdrHdrBrightnessCaps(
+                        .4f, .4f, .7f, true, true, 2f,
+                        BrightnessReason.MODIFIER_THROTTLED));
+        advanceTime(1);
+        clearInvocations(mHolder.animator, mHolder.hbmController, mHolder.clamperController);
+    }
