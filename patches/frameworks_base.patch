@@ -0,0 +1,183 @@
+package android.hardware.fingerprint;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.TimeUnit;
+
+public final class TouchModeHostTest {
+    private static int checks;
+    private static final java.util.concurrent.atomic.AtomicReference<Throwable> threadFailure =
+            new java.util.concurrent.atomic.AtomicReference<>();
+    private static synchronized void check(boolean value) {
+        ++checks;
+        if (!value) throw new AssertionError("check " + checks);
+    }
+    private static void await(CountDownLatch latch) {
+        try { check(latch.await(3, TimeUnit.SECONDS)); }
+        catch (InterruptedException e) { throw new AssertionError(e); }
+    }
+    private static void join(Thread thread) {
+        try { thread.join(3000); check(!thread.isAlive());
+            if (threadFailure.get() != null) throw new AssertionError(threadFailure.get()); }
+        catch (InterruptedException e) { throw new AssertionError(e); }
+    }
+    private static Thread thread(Runnable action) {
+        return new Thread(() -> {
+            try { action.run(); }
+            catch (Throwable failure) { threadFailure.compareAndSet(null, failure); }
+        });
+    }
+    private static LdyAn00FingerprintTouchMode.Token start(List<Boolean> calls) {
+        LdyAn00FingerprintTouchMode.Token token = LdyAn00FingerprintTouchMode.reserve(
+                enabled -> { calls.add(enabled); return true; });
+        check(token != null && LdyAn00FingerprintTouchMode.enable(token));
+        LdyAn00FingerprintTouchMode.finishStart(token);
+        return token;
+    }
+    public static void main(String[] args) {
+        List<Boolean> calls = new ArrayList<>();
+        LdyAn00FingerprintTouchMode.Token first = start(calls);
+        check(LdyAn00FingerprintTouchMode.reserve(enabled -> true) == null);
+        // Authentication failure is nonterminal: no stop, no mode mutation.
+        check(LdyAn00FingerprintTouchMode.owns(first) && calls.equals(Arrays.asList(true)));
+        LdyAn00FingerprintTouchMode.stop(first, true);
+        check(!LdyAn00FingerprintTouchMode.owns(first)
+                && calls.equals(Arrays.asList(true, false)));
+        LdyAn00FingerprintTouchMode.Token second = start(calls);
+        // Captured old cleanup/timeout/cancellation cannot touch a later operation.
+        LdyAn00FingerprintTouchMode.stop(first, true);
+        check(!LdyAn00FingerprintTouchMode.claimCancel(first));
+        check(LdyAn00FingerprintTouchMode.owns(second)
+                && calls.equals(Arrays.asList(true, false, true)));
+        LdyAn00FingerprintTouchMode.stop(second, true);
+
+        calls.clear();
+        LdyAn00FingerprintTouchMode.Token cancel = start(calls);
+        check(LdyAn00FingerprintTouchMode.claimCancel(cancel));
+        check(!LdyAn00FingerprintTouchMode.claimCancel(cancel));
+        LdyAn00FingerprintTouchMode.stop(cancel, true); // Synchronous terminal in cancel RPC.
+        check(LdyAn00FingerprintTouchMode.owns(cancel));
+        check(LdyAn00FingerprintTouchMode.reserve(enabled -> true) == null);
+        LdyAn00FingerprintTouchMode.finishCall(cancel);
+        check(!LdyAn00FingerprintTouchMode.owns(cancel));
+
+        calls.clear();
+        LdyAn00FingerprintTouchMode.Token waiting = start(calls);
+        check(LdyAn00FingerprintTouchMode.claimCancel(waiting));
+        LdyAn00FingerprintTouchMode.stop(waiting, false);
+        LdyAn00FingerprintTouchMode.finishCall(waiting); // Cancel return alone isn't terminal.
+        check(LdyAn00FingerprintTouchMode.owns(waiting));
+        check(LdyAn00FingerprintTouchMode.reserve(enabled -> true) == null);
+        LdyAn00FingerprintTouchMode.stop(waiting, true); // Error/close/death acknowledgement.
+        check(!LdyAn00FingerprintTouchMode.owns(waiting));
+
+        calls.clear();
+        LdyAn00FingerprintTouchMode.Token timed = start(calls);
+        LdyAn00FingerprintTouchMode.stop(timed, false); // Enrollment timeout fences native.
+        check(LdyAn00FingerprintTouchMode.owns(timed));
+        check(!LdyAn00FingerprintTouchMode.active(timed)); // A reserved frame must not dispatch.
+        check(LdyAn00FingerprintTouchMode.claimCancel(timed)); // Still permit owned cancellation.
+        LdyAn00FingerprintTouchMode.stop(timed, true);
+        LdyAn00FingerprintTouchMode.finishCall(timed);
+        check(!LdyAn00FingerprintTouchMode.owns(timed));
+
+        boolean[] cleanup = {false};
+        LdyAn00FingerprintTouchMode.Token dirty = LdyAn00FingerprintTouchMode.reserve(
+                enabled -> enabled || cleanup[0]);
+        check(LdyAn00FingerprintTouchMode.enable(dirty));
+        LdyAn00FingerprintTouchMode.finishStart(dirty);
+        LdyAn00FingerprintTouchMode.stop(dirty, true);
+        check(LdyAn00FingerprintTouchMode.owns(dirty));
+        check(!LdyAn00FingerprintTouchMode.claimCancel(dirty)); // Already terminal.
+        check(LdyAn00FingerprintTouchMode.reserve(enabled -> true) == null);
+        cleanup[0] = true;
+        LdyAn00FingerprintTouchMode.stop(dirty, true);
+        check(!LdyAn00FingerprintTouchMode.owns(dirty));
+
+        calls.clear();
+        LdyAn00FingerprintTouchMode.Token failed = LdyAn00FingerprintTouchMode.reserve(
+                enabled -> { calls.add(enabled); return !enabled; });
+        check(!LdyAn00FingerprintTouchMode.enable(failed));
+        LdyAn00FingerprintTouchMode.stop(failed, true);
+        LdyAn00FingerprintTouchMode.finishStart(failed);
+        check(!LdyAn00FingerprintTouchMode.owns(failed)
+                && calls.equals(Arrays.asList(true, false)));
+
+        // A terminal on another thread during enable must not deadlock or disable too early.
+        CountDownLatch entered = new CountDownLatch(1);
+        CountDownLatch returnEnable = new CountDownLatch(1);
+        calls.clear();
+        LdyAn00FingerprintTouchMode.Token concurrent = LdyAn00FingerprintTouchMode.reserve(
+                enabled -> {
+                    calls.add(enabled);
+                    if (enabled) { entered.countDown(); await(returnEnable); }
+                    return true;
+                });
+        boolean[] enabledResult = {true};
+        Thread writer = thread(() -> enabledResult[0] =
+                LdyAn00FingerprintTouchMode.enable(concurrent));
+        writer.start(); await(entered);
+        LdyAn00FingerprintTouchMode.stop(concurrent, true);
+        check(calls.equals(Arrays.asList(true))); // Disable waits for enable return.
+        check(LdyAn00FingerprintTouchMode.reserve(enabled -> true) == null);
+        returnEnable.countDown(); join(writer);
+        check(!enabledResult[0] && calls.equals(Arrays.asList(true, false)));
+        check(LdyAn00FingerprintTouchMode.owns(concurrent)); // Pending native-start frame.
+        LdyAn00FingerprintTouchMode.finishStart(concurrent);
+        check(!LdyAn00FingerprintTouchMode.owns(concurrent));
+
+        // Setter can obtain the same state lock from another callback thread while RPC is active.
+        LdyAn00FingerprintTouchMode.Token[] reentrant = new LdyAn00FingerprintTouchMode.Token[1];
+        reentrant[0] = LdyAn00FingerprintTouchMode.reserve(enabled -> {
+            if (enabled) {
+                Thread callback = thread(() ->
+                        LdyAn00FingerprintTouchMode.stop(reentrant[0], true));
+                callback.start(); join(callback);
+            }
+            return true;
+        });
+        check(!LdyAn00FingerprintTouchMode.enable(reentrant[0]));
+        LdyAn00FingerprintTouchMode.finishStart(reentrant[0]);
+        check(!LdyAn00FingerprintTouchMode.owns(reentrant[0]));
+        // Close arriving while a start is reserved cannot overtake its dispatch frame.
+        List<String> order = new ArrayList<>();
+        LdyAn00FingerprintTouchMode.Token closing =
+                LdyAn00FingerprintTouchMode.reserve(enabled -> true);
