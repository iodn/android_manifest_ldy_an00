+package android.hardware.face;
+
+import android.os.Environment;
+import android.system.ErrnoException;
+import android.system.Os;
+import android.system.OsConstants;
+import android.util.AtomicFile;
+
+import java.io.DataInputStream;
+import java.io.DataOutputStream;
+import java.io.File;
+import java.io.FileDescriptor;
+import java.io.FileNotFoundException;
+import java.io.FileInputStream;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.nio.file.Files;
+
+/** Framework-owned DE metadata; private vendor template/TEE storage is unchanged. */
+final class HonorLdyAn00FaceLockoutFile implements HonorLdyAn00FaceLockout.Storage {
+    private static final int MAGIC = 0x48464c31;
+    private final int mUserId, mSensorId;
+    private final AtomicFile mFile;
+
+    HonorLdyAn00FaceLockoutFile(int userId, int sensorId) {
+        this(userId, sensorId, new File(Environment.getDataSystemDeDirectory(userId),
+                "honor_face_lockout_" + sensorId + ".bin"));
+    }
+
+    HonorLdyAn00FaceLockoutFile(int userId, int sensorId, File path) {
+        mUserId = userId; mSensorId = sensorId;
+        mFile = new AtomicFile(path);
+    }
+
+    @Override public HonorLdyAn00FaceLockout.Record read() throws IOException {
+        try (FileInputStream raw = mFile.openRead();
+                DataInputStream input = new DataInputStream(raw)) {
+            android.system.StructStat stat = Os.fstat(raw.getFD());
+            if (stat.st_uid != android.os.Process.myUid() || (stat.st_mode & 0777) != 0600
+                    || !OsConstants.S_ISREG(stat.st_mode)) {
+                throw new IOException("Face lockout file ownership/mode invalid");
+            }
+            if (input.readInt() != MAGIC || input.readInt() != mUserId
+                    || input.readInt() != mSensorId) throw new IOException("Face lockout identity");
+            int attempts = input.readInt();
+            int timed = input.readUnsignedByte();
+            if (timed > 1 || input.read() != -1) throw new IOException("Face lockout framing");
+            try { return new HonorLdyAn00FaceLockout.Record(attempts, timed == 1); }
+            catch (IllegalArgumentException invalid) {
+                throw new IOException("Face lockout data invalid", invalid);
+            }
+        } catch (FileNotFoundException absent) {
+            File base = mFile.getBaseFile();
+            // Permission errors, partial first writes and backup recovery failures are not
+            // interpreted as zero failures. Only a provably absent three-file set is new state.
+            if (Files.notExists(base.toPath())
+                    && Files.notExists(new File(base.getPath() + ".bak").toPath())
+                    && Files.notExists(new File(base.getPath() + ".new").toPath())) return null;
+            throw absent;
+        } catch (ErrnoException failure) {
+            throw new IOException("Face lockout stat failed", failure);
+        }
+    }
+
+    @Override public void write(HonorLdyAn00FaceLockout.Record record) throws IOException {
+        FileOutputStream output = null;
+        try {
+            output = mFile.startWrite();
+            Os.fchmod(output.getFD(), 0600);
+            DataOutputStream data = new DataOutputStream(output);
+            data.writeInt(MAGIC); data.writeInt(mUserId); data.writeInt(mSensorId);
+            data.writeInt(record.attempts); data.writeBoolean(record.timed); data.flush();
+            Os.fsync(output.getFD()); // AtomicFile.finishWrite itself logs some sync errors.
+            mFile.finishWrite(output); output = null;
+            FileDescriptor directory = Os.open(mFile.getBaseFile().getParent(),
+                    OsConstants.O_RDONLY | OsConstants.O_CLOEXEC, 0);
+            try {
+                if (!OsConstants.S_ISDIR(Os.fstat(directory).st_mode)) {
+                    throw new IOException("Face lockout parent is not a directory");
+                }
+                Os.fsync(directory);
+            }
+            finally { Os.close(directory); }
+            HonorLdyAn00FaceLockout.Record actual = read();
+            if (actual == null || actual.attempts != record.attempts || actual.timed != record.timed
+                    || (Os.stat(mFile.getBaseFile().getPath()).st_mode & 0777) != 0600) {
+                throw new IOException("Face lockout write not verified");
+            }
+        } catch (ErrnoException failure) {
+            throw new IOException("Face lockout durability failed", failure);
+        } finally {
+            if (output != null) mFile.failWrite(output);
+        }
+    }
+}
