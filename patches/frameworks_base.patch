+package android.hardware.fingerprint;
+
+public final class GeometryHostTest {
+    static void check(boolean value) { if (!value) throw new AssertionError(); }
+    public static void main(String[] args) {
+        check(LdyAn00FingerprintGeometry.accepts(1216,2640,1216,2640,""));
+        check(LdyAn00FingerprintGeometry.accepts(1216,2640,1216,2640,"1216,2640"));
+        check(!LdyAn00FingerprintGeometry.accepts(1080,2340,1216,2640,""));
+        check(!LdyAn00FingerprintGeometry.accepts(1216,2640,1080,2340,""));
+        check(!LdyAn00FingerprintGeometry.accepts(2640,1216,1216,2640,""));
+        check(!LdyAn00FingerprintGeometry.accepts(1216,2640,2640,1216,""));
+        check(!LdyAn00FingerprintGeometry.accepts(0,0,1216,2640,""));
+        check(!LdyAn00FingerprintGeometry.accepts(1216,2640,1216,2640,null));
+        check(!LdyAn00FingerprintGeometry.accepts(1216,2640,1216,2640,"1080,2340"));
+        check(!LdyAn00FingerprintGeometry.accepts(1216,2640,1216,2640,"0,0"));
+        check(!LdyAn00FingerprintGeometry.accepts(1216,2640,1216,2640,"1216,2640 "));
+        check(!LdyAn00FingerprintGeometry.accepts(1216,2640,1216,2640,"1216,2640,1"));
+        // Exact original Java algorithm: round each normalized corner before integer averaging.
+        int left = Math.round(440 * 1216.0f / 1000);
+        int right = Math.round(560 * 1216.0f / 1000);
+        int top = Math.round(712 * 2640.0f / 1000);
+        int bottom = Math.round(766 * 2640.0f / 1000);
+        check(left == 535 && right == 681 && top == 1880 && bottom == 2022);
+        check((left + right) / 2 == 608 && (top + bottom) / 2 == 1951);
+        System.out.println("GEOMETRY_HOST_PASS native-size/override refusal + stock arithmetic");
+    }
+}
