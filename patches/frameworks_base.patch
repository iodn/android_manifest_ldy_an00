+        privacy.change(true); mLooper.dispatchAll();
+        mDeadlines.moveTimeForward(10_000); mDeadlines.dispatchAll(); mLooper.dispatchAll();
+        privacy.change(false); mLooper.dispatchAll();
+        assertEquals(Error.HW_UNAVAILABLE, mCallback.error);
+        assertEquals(2, mVendor.cancelAuthCalls);
+        assertEquals(1, mVendor.authCalls);
+        try { mAdapter.createSession(1, 0, new RecordingCallback()); fail(); }
+        catch (RemoteException expected) { }
+        mVendor.cancelAck(2); mLooper.dispatchAll();
+        assertEquals(0, mCallback.authSucceeded);
