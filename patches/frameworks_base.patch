@@ -0,0 +1,99 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package android.hardware.face;
+
+import java.io.IOException;
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.security.MessageDigest;
+import java.util.Arrays;
+import java.util.HashMap;
+import java.util.function.LongSupplier;
+
+/** Process-local one-use provenance from verified credentials or a qualified STRONG fingerprint. */
+final class HonorLdyAn00FaceResetPermits {
+    static final long MAX_AGE_MS = 15_000;
+    private static final int SENSOR_ID = 1;
+    private final LongSupplier mNow;
+    private final HashMap<Integer, Long> mEpochs = new HashMap<>();
+    private final HashMap<Integer, Permit> mPermits = new HashMap<>();
+
+    private static final class Permit {
+        final long epoch, issuedAt;
+        final byte[] hat;
+        Permit(long epoch, long issuedAt, byte[] hat) {
+            this.epoch = epoch; this.issuedAt = issuedAt; this.hat = hat.clone();
+        }
+        void erase() { Arrays.fill(hat, (byte) 0); }
+    }
+
+    HonorLdyAn00FaceResetPermits(LongSupplier now) { mNow = now; }
+
+    synchronized long epoch(int userId) {
+        return mEpochs.getOrDefault(userId, 0L);
+    }
+
+    synchronized void invalidate(int userId) {
+        mEpochs.put(userId, epoch(userId) + 1);
+        erase(userId);
+    }
+
+    synchronized boolean grant(int userId, int sensorId, long epoch, long challenge, byte[] hat) {
+        if (userId < 0 || sensorId != SENSOR_ID || epoch != epoch(userId)
+                || !matchesHat(hat, challenge, 1 /* password */)) return false;
+        erase(userId);
+        mPermits.put(userId, new Permit(epoch, mNow.getAsLong(), hat));
+        return true;
+    }
+
+    /** Only the successful framework AuthenticationClient producer may call this path. */
+    synchronized boolean grantStrongFingerprint(int userId, int fromSensorId, int currentStrength,
+            long epoch, long operationId, byte[] hat) {
+        // Exact retained LDY-AN00 fingerprint is sensor0; source strength is freshly queried
+        // at the trusted success producer.15 is Authenticators.BIOMETRIC_STRONG in this tree.
+        if (userId < 0 || fromSensorId != 0 || currentStrength != 15 || epoch != epoch(userId)
+                || !matchesHat(hat, operationId, 2 /* fingerprint */)) return false;
+        erase(userId);
+        mPermits.put(userId, new Permit(epoch, mNow.getAsLong(), hat));
+        return true;
+    }
+
+    synchronized boolean consume(int userId, int sensorId, byte[] hat) {
+        if (sensorId != SENSOR_ID || hat == null || hat.length != 69) return false;
+        Permit permit = mPermits.get(userId);
+        if (permit == null) return false;
+        long age = mNow.getAsLong() - permit.issuedAt;
+        if (permit.epoch != epoch(userId) || age < 0 || age > MAX_AGE_MS) {
+            erase(userId); return false;
+        }
+        if (!MessageDigest.isEqual(permit.hat, hat)) return false;
+        erase(userId);
+        return true;
+    }
+
+    interface Clear { void run() throws IOException; }
+
+    synchronized boolean consumeAndClear(int userId, int sensorId, byte[] hat, Clear clear)
+            throws IOException {
+        if (!consume(userId, sensorId, hat)) return false;
+        // Serialize the exact durable metadata clear with credential/user epoch invalidation.
+        // Never perform Binder, framework callbacks or Gatekeeper/SP operations in this action.
+        clear.run();
+        return true;
+    }
+
+    private void erase(int userId) {
+        Permit old = mPermits.remove(userId);
+        if (old != null) old.erase();
+    }
+
+    private static boolean matchesHat(byte[] hat, long challenge, int authenticatorType) {
+        if (hat == null || hat.length != 69 || hat[0] != 0) return false;
+        ByteBuffer token = ByteBuffer.wrap(hat);
+        // Gatekeeper's secure user ID is deliberately not compared to the Android userId.
+        return token.order(ByteOrder.LITTLE_ENDIAN).getLong(1) == challenge
+                && token.order(ByteOrder.BIG_ENDIAN).getInt(25) == authenticatorType;
+    }
+}
