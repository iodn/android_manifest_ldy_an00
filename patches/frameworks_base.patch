@@ -0,0 +1,25 @@
+// SPDX-License-Identifier: Apache-2.0
+package com.android.server.display.plugin.types;
+
+import com.android.internal.annotations.Keep;
+import com.android.server.display.brightness.BrightnessReason;
+
+/** One resolved policy revision. It supplies limits and never enables HDR. */
+@Keep
+public record SdrHdrBrightnessCaps(float automaticInputCap, float sdrOutputCap,
+        float hdrOutputCap, boolean ordinaryAuto, boolean manual,
+        float customTransitionRate, int reasonModifier) {
+    public SdrHdrBrightnessCaps {
+        if (!validCap(automaticInputCap) || !validCap(sdrOutputCap)
+                || !validCap(hdrOutputCap)
+                || !(customTransitionRate == -1f
+                        || Float.isFinite(customTransitionRate) && customTransitionRate > 0f)
+                || (reasonModifier & ~BrightnessReason.MODIFIER_MASK) != 0) {
+            throw new IllegalArgumentException("Invalid brightness cap policy");
+        }
+    }
+
+    private static boolean validCap(float cap) {
+        return Float.isFinite(cap) && cap >= 0f && cap <= 1f;
+    }
+}
