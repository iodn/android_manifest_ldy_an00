+
+        verify(mClient).onError(FACE_ERROR_UNABLE_TO_PROCESS, 0);
+        verify(mClient, never()).onAuthenticated(any(), anyBoolean(), any());
+    }
+
+    @Test
+    public void strongHatPreservesSerializedToken() {
+        when(mClient.isStrongBiometric()).thenReturn(true);
+        HardwareAuthToken hat = new HardwareAuthToken();
+        hat.challenge = 0x0102030405060708L;
+        hat.userId = 0x1112131415161718L;
+        hat.authenticatorId = 0x2122232425262728L;
+        hat.authenticatorType = 2;
+        hat.timestamp = new Timestamp();
+        hat.timestamp.milliSeconds = 0x3132333435363738L;
+        hat.mac = new byte[32];
+        for (int i = 0; i < hat.mac.length; i++) hat.mac[i] = (byte) i;
+        mResponse.onAuthenticationSucceeded(8, hat);
+        mLooper.dispatchAll();
+
+        ArgumentCaptor<ArrayList<Byte>> token = ArgumentCaptor.forClass(ArrayList.class);
+        verify(mClient).onAuthenticated(any(), eq(true), token.capture());
+        byte[] actual = new byte[token.getValue().size()];
+        for (int i = 0; i < actual.length; i++) actual[i] = token.getValue().get(i);
+        assertThat(libcore.util.HexEncoding.encodeToString(actual, false)).isEqualTo(
+                "0008070605040302011817161514131211282726252423222100000002"
+                + "3132333435363738000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f");
+    }
+
+    @Test
+    public void successResultWithNonStrongNullHatUsesSamePath() {
+        when(mClient.isStrongBiometric()).thenReturn(false);
