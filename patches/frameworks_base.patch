index 0000000000000000000000000000000000000000..9936a3f13008f43d6e9f6e2b49c55fdc8804a762
--- /dev/null
+++ b/core/tests/face-operation-owner/HonorLdyAn00FaceBootFenceHostTest.java
@@ -0,0 +1,47 @@
+/* Copyright (C) 2026 The LineageOS Project. SPDX-License-Identifier: Apache-2.0 */
+package android.hardware.face;
+import java.io.IOException;
+
+public final class HonorLdyAn00FaceBootFenceHostTest {
+    private static final String BOOT = "00000000-0000-0000-0000-000000000001";
+    private static final String NEXT = "00000000-0000-0000-0000-000000000002";
+    private static int checks;
+    private static void check(boolean ok) { if (!ok) throw new AssertionError(); checks++; }
+    interface Action { void run() throws IOException; }
+    private static void refuses(Action action) throws IOException {
+        try { action.run(); } catch (IOException expected) { checks++; return; }
+        throw new AssertionError("ownership accepted");
+    }
+    private static final class Store implements HonorLdyAn00FaceBootFence.Storage {
+        HonorLdyAn00FaceBootFence.Record record;
+        boolean writeThenFail;
+        int writes;
+        public HonorLdyAn00FaceBootFence.Record read() { return record; }
+        public void write(HonorLdyAn00FaceBootFence.Record value) throws IOException {
+            record = value; writes++;
+            if (writeThenFail) throw new IOException("Uncertain durability");
+        }
+    }
+    public static void main(String[] args) throws Exception {
+        Store store = new Store();
+        var first = new HonorLdyAn00FaceBootFence(store, BOOT);
+        refuses(first::release); first.reserve(); check(store.record.pending);
+        refuses(first::reserve);
+        var restartedProcess = new HonorLdyAn00FaceBootFence(store, BOOT);
+        refuses(restartedProcess::reserve); check(store.writes == 1);
+        first.release(); check(!store.record.pending); refuses(first::release);
+        restartedProcess.reserve(); check(store.record.pending);
+        var afterKernelReboot = new HonorLdyAn00FaceBootFence(store, NEXT);
+        afterKernelReboot.reserve(); check(store.record.boot.equals(NEXT));
+        refuses(restartedProcess::release); check(store.record.pending);
+        afterKernelReboot.release(); check(!store.record.pending);
+        store.writeThenFail = true;
+        var uncertain = new HonorLdyAn00FaceBootFence(store, NEXT);
+        refuses(uncertain::reserve); check(store.record.pending);
+        store.writeThenFail = false;
+        refuses(new HonorLdyAn00FaceBootFence(store, NEXT)::reserve);
+        try { new HonorLdyAn00FaceBootFence(store, "bad"); throw new AssertionError(); }
+        catch (IllegalArgumentException expected) { checks++; }
+        System.out.println("FACE_BOOT_FENCE_HOST_OK checks=" + checks);
+    }
+}
