+                            || (faceId == -1 && mIds.length == 1))) {
+                        terminal(HonorLdyAn00FaceOperation.Kind.AUTHENTICATE,
+                                () -> authenticated(faceId, use));
+                    } else if (error == 3) {
+                        terminal(HonorLdyAn00FaceOperation.Kind.AUTHENTICATE,
+                                () -> completeCameraUse(use, Session.this::rejected));
+                    } else {
+                        if (Build.IS_DEBUGGABLE && mapError(error) == Error.UNABLE_TO_PROCESS) {
+                            Slog.i(TAG, "UnableToProcess origin=authenticate-result");
+                        }
+                        terminal(HonorLdyAn00FaceOperation.Kind.AUTHENTICATE,
+                                () -> notifyError(mapError(error), "authentication-result"));
+                    }
+                });
+            }
+            @Override void onEnrollResult(int faceId, int userId, int error) {
+                mHandler.post(() -> {
+                    if (Build.IS_DEBUGGABLE) {
+                        Slog.i(TAG, "Enroll callback vendorError=" + error
+                                + " faceIdPresent=" + (faceId != 0)
+                                + " userMatches=" + (userId == mUserId)
+                                + " operationState=" + mOperation.state()
+                                + " ownedEnroll=" + (mOperation.running(
+                                        HonorLdyAn00FaceOperation.Kind.ENROLL) != null));
+                    }
+                    if (error == 22) return; // Informational enrollment-with-glasses indication.
+                    if (userId != mUserId) { fail(); return; }
+                    final CameraUse use = mCameraUse;
+                    terminal(HonorLdyAn00FaceOperation.Kind.ENROLL, () -> {
+                        if (cameraBlocked(use)) {
+                            notifyError(Error.HW_UNAVAILABLE);
+                            return;
+                        }
+                        if (error == 0 && faceId > 0) {
+                            if (!contains(mIds, faceId)) { fail(); return; }
+                            completeCameraUse(use, () -> notifyFramework(
+                                    () -> mCallback.onEnrollmentProgress(faceId, 0)));
+                        } else notifyError(mapError(error), "enrollment-result");
+                    });
+                });
+            }
+            @Override void onRemovedResult(int userId, int error) {
+                mHandler.post(() -> {
+                    if (userId != mUserId) { fail(); return; }
+                    terminal(HonorLdyAn00FaceOperation.Kind.REMOVE, () -> {
+                        if (error == 0) { mRemovalIndex++; removeNext(); }
+                        else notifyFramework(() -> mCallback.onError(Error.UNABLE_TO_REMOVE, 0));
+                    });
+                });
+            }
+            @Override void onCancel(int type) {
+                // Capture ownership at receipt, not only after a synchronous Binder returns.
+                final boolean ownedCloseAck = mCloseAckExpected;
+                mHandler.post(() -> {
+                    if (mFailed || mClosed) return;
+                    if (mClosing) {
+                        if (!ownedCloseAck || type != 2) { fail(); return; }
+                        mCloseAckExpected = false;
+                        invoke(Session.this::completeCloseAfterWorkerAck);
+                        return;
+                    }
+                    if (mStartupDrainPending) {
+                        if (type != 2) { fail(); return; }
+                        mStartupDrainPending = false;
+                        clearDeadline();
+                        mReady = true;
+                        while (!mAfterInitialize.isEmpty()) invoke(mAfterInitialize.removeFirst());
+                        return;
+                    }
+                    final boolean enrollment = mCameraUse != null
+                            && mCameraUse.ticket != null
+                            && mCameraUse.ticket.kind == HonorLdyAn00FaceOperation.Kind.ENROLL;
+                    clearDeadline();
+                    Runnable completion = mOperation.drained(type, Session.this::fail);
+                    if (mOperation.state() == HonorLdyAn00FaceOperation.State.FAILED) {
+                        fail(); return;
+                    }
+                    if (mPreview != null) { mPreview.release(); mPreview = null; }
+                    if (enrollment) {
+                        // A canceled enrollment may already have committed a native template.
+                        // Read only after the owned worker ACK; never query an unknown drain.
+                        armDeadline(QUERY_TIMEOUT_MS);
+                        invoke(() -> readIds(ids -> {
+                            mIds = ids;
+                            clearDeadline();
+                            if (completion != null) completion.run();
+                            invoke(Session.this::endCameraUse);
+                        }));
+                    } else {
+                        if (completion != null) completion.run();
+                        invoke(Session.this::endCameraUse);
+                    }
+                });
+            }
+        };
+    }
+
+    private static void requireSuccess(int result) throws RemoteException {
+        if (result != 0) throw new RemoteException("Honor face operation refused");
+    }
+    private static void requireIds(int[] ids) {
+        if (ids == null || ids.length > 256) throw new IllegalArgumentException("Invalid face IDs");
+        for (int i = 0; i < ids.length; i++) {
+            if (ids[i] <= 0) throw new IllegalArgumentException("Invalid face ID");
+            for (int j = 0; j < i; j++) {
+                if (ids[i] == ids[j]) throw new IllegalArgumentException("Duplicate face ID");
+            }
+        }
+    }
+    private static boolean contains(int[] ids, int id) {
+        return Arrays.stream(ids).anyMatch(value -> value == id);
+    }
+    static byte[] serializeHat(HardwareAuthToken hat) {
+        if (hat == null || hat.timestamp == null || hat.mac == null || hat.mac.length != 32) {
+            throw new IllegalArgumentException("A genuine complete credential HAT is required");
+        }
+        return HonorLdyAn00FaceHatCodec.encode(hat.challenge, hat.userId, hat.authenticatorId,
+                hat.authenticatorType, hat.timestamp.milliSeconds, hat.mac);
+    }
+    private static Surface copySurface(Surface original) {
+        if (!original.isValid()) throw new IllegalArgumentException("Invalid enrollment preview");
+        Parcel parcel = Parcel.obtain();
+        try {
+            parcel.writeTypedObject(original, 0); parcel.setDataPosition(0);
+            Surface copied = parcel.readTypedObject(Surface.CREATOR);
+            if (copied == null || !copied.isValid()) {
+                if (copied != null) copied.release();
+                throw new IllegalArgumentException("Cannot retain enrollment preview");
+            }
+            return copied;
+        } finally { parcel.recycle(); }
+    }
+    private static byte mapError(int error) {
+        switch (error) {
+            case 2: return Error.CANCELED;
+            case 4: return Error.TIMEOUT;
+            case 5: case 6: return Error.HW_UNAVAILABLE;
+            case 7: return Error.NO_SPACE;
+            default: return Error.UNABLE_TO_PROCESS;
+        }
+    }
+}
