+            @Override
+            public IInterface queryLocalInterface(String descriptor) {
+                return null;
+            }
+
+            @Override
+            protected boolean onTransact(int code, Parcel data, Parcel reply, int flags)
+                    throws RemoteException {
+                return target.transact(code, data, reply, flags);
+            }
+        };
+        final ISessionCallback proxy = ISessionCallback.Stub.asInterface(remoteView);
+        assertThat(proxy).isNotSameInstanceAs(mResponse);
+        proxy.onAuthenticationSucceeded(8, null);
+        verifyNoInteractions(mClient);
+        mLooper.dispatchAll();
+
+        verify(mClient).onAuthenticated(any(), eq(true), eq(new ArrayList<Byte>()));
+        verify(mClient, never()).onError(anyInt(), anyInt());
+    }
+
+    @Test
