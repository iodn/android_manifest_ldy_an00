+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package android.hardware.face;
+
+import android.os.SystemClock;
+
+import java.io.IOException;
+
+/**
+ * Device-only in-process link from LockSettings' verified Gatekeeper response to the local face
+ * adapter. No Binder, intent or property endpoint can mint a permit in the system_server heap.
+ * @hide
+ */
+public final class HonorLdyAn00FaceCredentialReset {
+    private static final HonorLdyAn00FaceResetPermits PERMITS =
+            new HonorLdyAn00FaceResetPermits(SystemClock::elapsedRealtime);
+
+    private HonorLdyAn00FaceCredentialReset() { }
+
+    public static long captureCredentialEpoch(int userId) {
+        return HonorLdyAn00FaceAdapter.enabled() ? PERMITS.epoch(userId) : -1;
+    }
+
+    public static void invalidateUser(int userId) {
+        if (HonorLdyAn00FaceAdapter.enabled()) PERMITS.invalidate(userId);
+    }
+
+    /** Called only at BiometricDeferredQueue's face-specific fresh verified-HAT handoff. */
+    public static void authorizeVerifiedGatekeeperHat(int userId, int sensorId, long epoch,
+            long expectedChallenge, byte[] hat) {
+        if (HonorLdyAn00FaceAdapter.enabled()) {
+            PERMITS.grant(userId, sensorId, epoch, expectedChallenge, hat);
+        }
+    }
+
+    /** Trusted producer: a foreground/user-qualified successful fingerprint AuthenticationClient. */
+    public static void authorizeVerifiedStrongFingerprintHat(int userId, int fromSensorId,
+            int currentStrength, long epoch, long operationId, byte[] hat) {
+        if (HonorLdyAn00FaceAdapter.enabled()) {
+            PERMITS.grantStrongFingerprint(userId, fromSensorId, currentStrength, epoch,
+                    operationId, hat);
+        }
+    }
+
+    static boolean consumeAndClear(int userId, int sensorId, byte[] hat,
+            HonorLdyAn00FaceLockout lockout, java.util.function.BooleanSupplier mayClear)
+            throws IOException {
+        return HonorLdyAn00FaceAdapter.enabled()
+                && PERMITS.consumeAndClear(userId, sensorId, hat, () -> {
+                    if (!mayClear.getAsBoolean()) throw new IOException("Face reset fenced");
+                    lockout.clear();
+                });
+    }
+}
