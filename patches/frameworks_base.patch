@@ -0,0 +1,134 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package android.hardware.face;
+
+import java.util.Objects;
+
+/**
+ * Owns the untagged callbacks of stock113 Honor face's single native worker.
+ *
+ * A terminal result precedes native camera/algorithm cleanup. Keep the callback registration and
+ * operation owned until a subsequently queued cancel acknowledgement drains that worker. The
+ * caller serializes vendor callbacks and framework requests on one executor, performs every Binder
+ * call outside this object's lock, and executes the returned completion on that same executor.
+ * This does not establish ownership against a second OEM client or independently queued camera
+ * callbacks. Such clients must be excluded before an adapter using this gate is enabled.
+ */
+final class HonorLdyAn00FaceOperation {
+    enum Kind {
+        ENROLL(1), AUTHENTICATE(2), REMOVE(3);
+        final int cancelType;
+        Kind(int cancelType) { this.cancelType = cancelType; }
+    }
+
+    enum State { IDLE, RUNNING, DRAINING, FAILED, CLOSED }
+
+    /** Local request identity. Vendor callbacks themselves carry no request identity. */
+    static final class Ticket {
+        final Kind kind;
+        private Ticket(Kind kind) { this.kind = kind; }
+    }
+
+    private State mState = State.IDLE;
+    private Ticket mTicket;
+    private Runnable mCompletion;
+    private boolean mCancellationRequested;
+
+    synchronized State state() { return mState; }
+
+    synchronized Ticket begin(Kind kind) {
+        Objects.requireNonNull(kind);
+        if (mState != State.IDLE) {
+            throw new IllegalStateException("Honor face worker is not idle");
+        }
+        mTicket = new Ticket(kind);
+        mCancellationRequested = false;
+        mState = State.RUNNING;
+        return mTicket;
+    }
+
+    /** Returns the owned ticket for this callback kind, or null for an unowned/late callback. */
+    synchronized Ticket running(Kind kind) {
+        return mState == State.RUNNING && mTicket.kind == kind ? mTicket : null;
+    }
+
+    /**
+     * Holds the first terminal callback. A true result requires exactly one queued vendor cancel
+     * for ticket.kind, even on success. Do not forward the terminal callback at this point.
+     */
+    synchronized boolean terminal(Ticket ticket, Runnable completion) {
+        Objects.requireNonNull(completion);
+        if (ticket != mTicket || mState != State.RUNNING) return false;
+        mCompletion = completion;
+        mState = State.DRAINING;
+        return true;
+    }
+
+    /**
+     * Framework cancellation supersedes a held terminal result. A false result means a drain was
+     * already requested, or this cancellation belongs to an earlier request; never send another
+     * cancel in either case. This also handles cancel racing the queued terminal result.
+     */
+    synchronized boolean cancel(Ticket ticket, Runnable canceled) {
+        Objects.requireNonNull(canceled);
+        if (ticket != mTicket || (mState != State.RUNNING && mState != State.DRAINING)
+                || mCancellationRequested) return false;
+        boolean requestDrain = mState == State.RUNNING;
+        mCancellationRequested = true;
+        mCompletion = canceled;
+        mState = State.DRAINING;
+        return requestDrain;
+    }
+
+    /**
+     * Accept only the expected acknowledgement after the owned drain request. The caller executes
+     * the returned completion outside the lock before accepting the next framework operation.
+     * An unexpected acknowledgement fails closed and returns unavailable for the owned operation.
+     */
+    synchronized Runnable drained(int cancelType, Runnable unavailable) {
+        Objects.requireNonNull(unavailable);
+        if (mState == State.CLOSED || mState == State.FAILED) return null;
+        if (mState != State.DRAINING || mTicket.kind.cancelType != cancelType) {
+            boolean hadOperation = mTicket != null;
+            failLocked();
+            return hadOperation ? unavailable : null;
+        }
+        Runnable completion = mCompletion;
+        mCompletion = null;
+        mTicket = null;
+        mCancellationRequested = false;
+        mState = State.IDLE;
+        return completion;
+    }
+
+    /**
+     * Binder death, transaction failure or drain timeout cannot prove cleanup. Suppress the held
+     * result, refuse further work, and return the caller's hardware-unavailable notification.
+     * The caller must create a fresh owner only after independently establishing a fresh service
+     * and exclusive callback registration; a local timeout never permits another operation.
+     */
+    synchronized Runnable fail(Runnable unavailable) {
+        Objects.requireNonNull(unavailable);
+        if (mState == State.FAILED || mState == State.CLOSED) return null;
+        boolean hadOperation = mTicket != null;
+        failLocked();
+        return hadOperation ? unavailable : null;
+    }
+
+    private void failLocked() {
+        mState = State.FAILED;
+        mTicket = null;
+        mCompletion = null;
+        mCancellationRequested = false;
+    }
+
+    synchronized void close() {
+        if (mState == State.CLOSED) return;
+        if (mState != State.IDLE && mState != State.FAILED) {
+            throw new IllegalStateException("Honor face worker must drain before close");
+        }
+        mState = State.CLOSED;
+    }
+}
