+/**
+ * In-process bridge to the stock113 secure 2D face backend. Never registered as a Binder service.
+ * Requires the LDY-AN00 device opt-in. Native callback ownership and the durable boot fence remain
+ * held until the owned worker drain proves quiescence; a hardware error alone is not that proof.
+ */
+final class HonorLdyAn00FaceAdapter extends IFace.Default {
+    static final String INSTANCE = "honor_ldy_an00";
+    static final int SENSOR_ID = 1; // Retained fingerprint owns sensor0.
+    private static final String TAG = "LdyAn00Face";
+    private static final String CLIENT = "android.hardware.face.HonorLdyAn00FaceAdapter";
+    private static final int VERSION = 5;
+    private static final String HASH = "e6029311951274040efcf19821646c9166f30810";
+    private static final long QUERY_TIMEOUT_MS = 20_000;
+    private static final long DRAIN_TIMEOUT_MS = 10_000;
+    private static final long CHALLENGE_REUSE_MS = 60_000;
+    private final HonorLdyAn00FaceVendorClient mVendor;
+    private final ModeGuard mModeGuard;
+    private final Handler mDeadlineHandler;
+    private final LockoutStorageFactory mLockoutStorageFactory;
+    private final ResetAuthorizer mResetAuthorizer;
+    private final BootFenceFactory mBootFenceFactory;
+    private final CameraPrivacy mCameraPrivacy;
+    private final EnrollmentQuery mEnrollmentQuery;
+    private Handler mHandler;
+    // Native callback ownership is global even when getIFace creates another Java adapter.
+    static final class Ownership { Session session; }
+    private static final Ownership PROCESS_OWNER = new Ownership();
+    private final Ownership mOwnership;
+
+    static boolean enabled() {
+        return "LDY-AN00".equals(Build.MODEL) && "ldy_an00".equals(Build.DEVICE)
+                && SystemProperties.getBoolean("ro.lineage.ldy_an00.face_bridge", false);
+    }
+
+    static boolean isSelected(String fqName) {
+        return enabled() && (IFace.DESCRIPTOR + "/" + INSTANCE).equals(fqName);
+    }
+
+    static boolean isHardwareDetected() {
+        return isHardwareDetected(enabled(), HonorLdyAn00FaceAdapter::requireStockMode,
+                () -> ServiceManager.checkService(HonorLdyAn00FaceVendorClient.SERVICE) != null);
+    }
+
+    // Side-effect-free discovery: never allocate an adapter or touch the native session.
+    static boolean isHardwareDetected(boolean selected, ModeGuard mode,
+            java.util.function.BooleanSupplier servicePresent) {
+        if (!selected) return false;
+        try {
+            mode.check();
+            return servicePresent.getAsBoolean();
+        } catch (RemoteException | RuntimeException unavailable) {
+            return false;
+        }
+    }
+
+    static IFace connect() {
+        try {
+            requireStockMode();
+            IBinder binder = Binder.allowBlocking(ServiceManager.checkService(
+                    HonorLdyAn00FaceVendorClient.SERVICE));
+            return binder == null ? null : new HonorLdyAn00FaceAdapter(
+                    new HonorLdyAn00FaceVendorClient(binder));
+        } catch (RemoteException | RuntimeException failure) {
+            // Deliberately do not log Binder exception messages or biometric identifiers/tokens.
+            Slog.e(TAG, "Honor face backend unavailable");
+            return null;
+        }
+    }
+
+    private static void requireStockMode() throws RemoteException {
+        if (!"1".equals(SystemProperties.get("ro.odm.config.support_face_mode"))
+                || !"1".equals(SystemProperties.get("ro.config.support_face_mode"))
+                || !"6.1.0".equals(SystemProperties.get("htee.version"))
+                || !SystemProperties.get("htee.basic").isEmpty()) {
+            throw new RemoteException("Honor secure 2D configuration not qualified");
+        }
+    }
+
+    HonorLdyAn00FaceAdapter(HonorLdyAn00FaceVendorClient vendor) {
+        this(vendor, null, HonorLdyAn00FaceAdapter::requireStockMode, null,
+                HonorLdyAn00FaceLockoutFile::new, HonorLdyAn00FaceCredentialReset::consumeAndClear,
+                PROCESS_OWNER, HonorLdyAn00FaceBootFenceFile::create,
+                HonorLdyAn00FaceCameraPrivacy.forSystemServer());
+    }
+
+    // Test injection avoids changing global device properties or starting an owner thread.
+    interface ModeGuard { void check() throws RemoteException; }
+    interface EnrollmentQuery { List<Face> forUser(int userId); }
+
+    // FaceService reads the requested user's framework enrollment store, not the native HAL.
+    static List<Face> frameworkEnrollments(IFaceService service, int userId) {
+        try {
+            return service == null ? null : service.getEnrolledFaces(SENSOR_ID, userId, "android");
+        } catch (RemoteException | RuntimeException unavailable) {
+            return null;
+        }
+    }
+
+    private static List<Face> frameworkEnrollments(int userId) {
+        return frameworkEnrollments(IFaceService.Stub.asInterface(
+                ServiceManager.checkService(Context.FACE_SERVICE)), userId);
+    }
+    interface CameraPrivacy {
+        boolean blocked();
+        void start(Runnable onBlocked);
+        void stop();
+    }
+    // Test camera privacy does not discover global Android services.
+    private static final CameraPrivacy TEST_CAMERA_PRIVACY = new CameraPrivacy() {
+        public boolean blocked() { return false; }
+        public void start(Runnable onBlocked) { }
+        public void stop() { }
+    };
+    interface BootFenceFactory { HonorLdyAn00FaceBootFence create() throws IOException; }
+    interface LockoutStorageFactory {
+        HonorLdyAn00FaceLockout.Storage forUser(int userId, int sensorId);
+    }
+    interface ResetAuthorizer {
+        boolean clear(int userId, int sensorId, byte[] hat, HonorLdyAn00FaceLockout lockout,
+                java.util.function.BooleanSupplier mayClear) throws IOException;
+    }
+    HonorLdyAn00FaceAdapter(HonorLdyAn00FaceVendorClient vendor, Handler handler,
+            ModeGuard modeGuard) {
+        this(vendor, handler, modeGuard, null);
+    }
+    HonorLdyAn00FaceAdapter(HonorLdyAn00FaceVendorClient vendor, Handler handler,
+            ModeGuard modeGuard, Handler deadlineHandler) {
+        this(vendor, handler, modeGuard, deadlineHandler, HonorLdyAn00FaceLockoutFile::new);
+    }
+    HonorLdyAn00FaceAdapter(HonorLdyAn00FaceVendorClient vendor, Handler handler,
+            ModeGuard modeGuard, Handler deadlineHandler, LockoutStorageFactory storageFactory) {
+        this(vendor, handler, modeGuard, deadlineHandler, storageFactory,
+                HonorLdyAn00FaceCredentialReset::consumeAndClear);
+    }
+    HonorLdyAn00FaceAdapter(HonorLdyAn00FaceVendorClient vendor, Handler handler,
+            ModeGuard modeGuard, Handler deadlineHandler, LockoutStorageFactory storageFactory,
+            ResetAuthorizer resetAuthorizer) {
+        this(vendor, handler, modeGuard, deadlineHandler, storageFactory, resetAuthorizer,
+                PROCESS_OWNER);
+    }
+    HonorLdyAn00FaceAdapter(HonorLdyAn00FaceVendorClient vendor, Handler handler,
+            ModeGuard modeGuard, Handler deadlineHandler, LockoutStorageFactory storageFactory,
+            ResetAuthorizer resetAuthorizer, Ownership ownership) {
+        this(vendor, handler, modeGuard, deadlineHandler, storageFactory, resetAuthorizer,
+                ownership, HonorLdyAn00FaceAdapter::frameworkEnrollments);
+    }
+    HonorLdyAn00FaceAdapter(HonorLdyAn00FaceVendorClient vendor, Handler handler,
+            ModeGuard modeGuard, Handler deadlineHandler, LockoutStorageFactory storageFactory,
+            ResetAuthorizer resetAuthorizer, Ownership ownership, EnrollmentQuery enrollmentQuery) {
+        this(vendor, handler, modeGuard, deadlineHandler, storageFactory, resetAuthorizer,
+                ownership, () -> new HonorLdyAn00FaceBootFence(
+                        new HonorLdyAn00FaceBootFence.Storage() {
+                            HonorLdyAn00FaceBootFence.Record record;
+                            public HonorLdyAn00FaceBootFence.Record read() { return record; }
+                            public void write(HonorLdyAn00FaceBootFence.Record value) { record = value; }
+                        }, "00000000-0000-0000-0000-000000000000"),
+                TEST_CAMERA_PRIVACY, enrollmentQuery);
+    }
+    // Test injection isolates its persistent reservation from production system DE metadata.
+    HonorLdyAn00FaceAdapter(HonorLdyAn00FaceVendorClient vendor, Handler handler,
+            ModeGuard modeGuard, Handler deadlineHandler, LockoutStorageFactory storageFactory,
+            ResetAuthorizer resetAuthorizer, Ownership ownership, BootFenceFactory bootFenceFactory) {
+        this(vendor, handler, modeGuard, deadlineHandler, storageFactory, resetAuthorizer,
+                ownership, bootFenceFactory, TEST_CAMERA_PRIVACY);
+    }
+    HonorLdyAn00FaceAdapter(HonorLdyAn00FaceVendorClient vendor, Handler handler,
+            ModeGuard modeGuard, Handler deadlineHandler, LockoutStorageFactory storageFactory,
+            ResetAuthorizer resetAuthorizer, Ownership ownership, BootFenceFactory bootFenceFactory,
+            CameraPrivacy cameraPrivacy) {
+        this(vendor, handler, modeGuard, deadlineHandler, storageFactory, resetAuthorizer,
+                ownership, bootFenceFactory, cameraPrivacy,
+                HonorLdyAn00FaceAdapter::frameworkEnrollments);
+    }
+    HonorLdyAn00FaceAdapter(HonorLdyAn00FaceVendorClient vendor, Handler handler,
+            ModeGuard modeGuard, Handler deadlineHandler, LockoutStorageFactory storageFactory,
+            ResetAuthorizer resetAuthorizer, Ownership ownership, BootFenceFactory bootFenceFactory,
+            CameraPrivacy cameraPrivacy, EnrollmentQuery enrollmentQuery) {
+        mEnrollmentQuery = Objects.requireNonNull(enrollmentQuery);
+        mCameraPrivacy = Objects.requireNonNull(cameraPrivacy);
+        mVendor = Objects.requireNonNull(vendor);
+        mModeGuard = Objects.requireNonNull(modeGuard);
+        mHandler = handler;
+        mDeadlineHandler = deadlineHandler;
+        mLockoutStorageFactory = Objects.requireNonNull(storageFactory);
+        mResetAuthorizer = Objects.requireNonNull(resetAuthorizer);
+        mOwnership = Objects.requireNonNull(ownership);
+        mBootFenceFactory = Objects.requireNonNull(bootFenceFactory);
+    }
+
+    @Override public IBinder asBinder() { return mVendor.asBinder(); }
+    @Override public int getInterfaceVersion() { return VERSION; }
+    @Override public String getInterfaceHash() { return HASH; }
+
+    @Override public SensorProps[] getSensorProps() {
+        CommonProps common = new CommonProps();
+        common.sensorId = SENSOR_ID;
+        common.sensorStrength = SensorStrength.CONVENIENCE;
+        // This initial integration intentionally offers one enrollment, not OEM alternate faces.
+        common.maxEnrollmentsPerUser = 1;
+        common.componentInfo = new ComponentInfo[0];
+        SensorProps prop = new SensorProps();
+        prop.commonProps = common;
+        prop.sensorType = FaceSensorType.RGB;
+        prop.halControlsPreview = true;
+        prop.previewDisplayId = 0;
+        // HTee FaceCamera.InitImageReader0x12bf10 selected2D mode uses640x480. Preview
+        // geometry/lifetime still need Android UI/hardware qualification before feature enable.
+        prop.enrollPreviewWidth = 640;
+        prop.enrollPreviewHeight = 480;
+        prop.enrollPreviewScale = 1;
+        prop.supportsDetectInteraction = false;
+        return new SensorProps[]{prop};
+    }
+
+    @Override public ISession createSession(int sensorId, int userId, ISessionCallback callback)
+            throws RemoteException {
+        if (sensorId != SENSOR_ID || userId < 0 || callback == null) {
+            throw new RemoteException("Invalid Honor face session identity");
+        }
+        mModeGuard.check();
+        Session session;
+        synchronized (mOwnership) {
+            if (mOwnership.session != null) throw new RemoteException("Honor face session already owned");
+            if (mHandler == null) {
+                HandlerThread thread = new HandlerThread("LdyAn00FaceOwner");
+                thread.start();
+                mHandler = new Handler(thread.getLooper());
+            }
+            session = new Session(userId, callback);
+            mOwnership.session = session;
+        }
+        mHandler.post(session::initialize);
+        return session;
+    }
+
+    private interface Call { void run() throws RemoteException, IOException; }
+
+    private static final class Deadlines {
+        static final Handler HANDLER;
+        static {
+            HandlerThread thread = new HandlerThread("LdyAn00FaceDeadline");
+            thread.start();
+            HANDLER = new Handler(thread.getLooper());
+        }
+    }
+
+    private final class Session extends ISession.Default {
+        final int mUserId;
+        final ISessionCallback mCallback;
+        final HonorLdyAn00FaceOperation mOperation = new HonorLdyAn00FaceOperation();
+        final ArrayDeque<Call> mAfterInitialize = new ArrayDeque<>();
+        final ArrayDeque<Surface> mQueuedPreviews = new ArrayDeque<>();
+        final Object mDeadlineLock = new Object();
+        final IBinder.DeathRecipient mVendorDeath = () -> fail("vendor-death", "none");
+        final IBinder.DeathRecipient mClientDeath = () -> fail("client-death", "none");
+        volatile boolean mFailed;
+        volatile boolean mClosed;
+        Object mDeadline;
+        Object mQuery;
+        boolean mReady;
+        boolean mStartupDrainPending;
+        boolean mClosing;
+        boolean mHardwareUnavailableClose;
+        boolean mExplicitCloseRequested;
+        boolean mCloseNotified;
+        volatile String mStage = "new";
+        volatile boolean mCloseAckExpected;
+        boolean mBound;
+        int[] mIds = new int[0];
+        HonorLdyAn00FaceLockout mLockout;
+        HonorLdyAn00FaceBootFence mBootFence;
+        Runnable mLockoutCheck;
+        long mChallenge;
+        long mChallengeCreatedAt;
+        int mChallengeReferences;
+        Surface mPreview;
+        CameraUse mCameraUse;
+        final class CameraUse {
+            volatile boolean revoked;
+            HonorLdyAn00FaceOperation.Ticket ticket;
+        }
+
+        boolean cameraBlocked(CameraUse use) {
+            return use == null || use.revoked || mCameraPrivacy.blocked();
+        }
+
+        boolean beginCameraUse() {
+            if (mCameraUse != null) throw new IllegalStateException("Camera already owned");
+            final CameraUse use = new CameraUse();
+            mCameraUse = use;
+            // Register first, then sample, so a toggle racing registration cannot be missed.
+            mCameraPrivacy.start(() -> {
+                use.revoked = true; // Fence success immediately, even while owner is in Binder.
+                mHandler.post(() -> cancelForCameraPrivacy(use));
+            });
+            if (!cameraBlocked(use)) return true;
+            endCameraUse();
+            notifyError(Error.HW_UNAVAILABLE);
+            return false;
+        }
+
+        void cancelForCameraPrivacy(CameraUse use) {
+            if (mFailed || mClosed || use == null || mCameraUse != use || use.ticket == null) return;
+            use.revoked = true;
+            if (mOperation.cancel(use.ticket,
+                    () -> notifyError(Error.HW_UNAVAILABLE))) {
+                requestDrain(use.ticket);
+            }
+        }
+
+        boolean continueCameraUse() {
+            if (!cameraBlocked(mCameraUse)) return true;
+            cancelForCameraPrivacy(mCameraUse);
+            return false;
+        }
+
+        void endCameraUse() {
+            if (mCameraUse == null) return;
+            mCameraPrivacy.stop();
+            mCameraUse = null;
+        }
+
+        void completeCameraUse(CameraUse use, Runnable completion) {
+            // Also query now: the SensorPrivacyManager listener may still be queued remotely.
+            if (cameraBlocked(use)) {
+                notifyError(Error.HW_UNAVAILABLE);
+            } else completion.run();
+        }
+        int[] mRemovalIds;
+        int mRemovalIndex;
+
+        Session(int userId, ISessionCallback callback) {
+            mUserId = userId;
+            mCallback = callback;
