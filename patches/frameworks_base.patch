+        mLooper.dispatchAll();
+        verify(mClient, never()).onError(anyInt(), anyInt());
+        verify(mCallback, never()).onHardwareUnavailable();
+    }
+
+    @Test
+    public void closeIdentityIsCheckedAtDeliveryAfterNewSessionReplacesOld() {
+        mResponse.onSessionClosed();
+        when(mCallback.isStaleSession(mResponse)).thenReturn(true);
+        mLooper.dispatchAll();
+        verify(mScheduler, never()).onUserStopped();
+    }
+
+    @Test
+    public void currentSessionCloseStillStopsItsUser() {
+        mResponse.onSessionClosed();
+        mLooper.dispatchAll();
+        verify(mScheduler).onUserStopped();
+    }
+
+    @Test
+    public void currentStartupHardwareErrorIsHandledAfterUserSessionAssignment() {
+        // FaceStartUser creates/assigns its AidlSession synchronously on this Handler before
+        // the queued response executes. The callback may arrive during createSession itself.
+        when(mCallback.isStaleSession(mResponse)).thenReturn(true);
+        mResponse.onError(android.hardware.biometrics.face.Error.HW_UNAVAILABLE, 0);
+        when(mCallback.isStaleSession(mResponse)).thenReturn(false);
+        mLooper.dispatchAll();
+        verify(mClient).onError(android.hardware.biometrics.BiometricConstants
+                .BIOMETRIC_ERROR_HW_UNAVAILABLE, 0);
+        verify(mCallback).onHardwareUnavailable();
+    }
+
+    @Test
+    public void staleSuccessForEnrollmentClientIsIgnored() {
+        when(mScheduler.getCurrentClient()).thenReturn(mEnrollClient);
+        mResponse.onAuthenticationSucceeded(8, null);
+        mLooper.dispatchAll();
+
+        verifyNoInteractions(mClient, mEnrollClient);
+    }
+}
