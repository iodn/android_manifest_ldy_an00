+                SystemProperties.get("ro.config.default_screensize"))) {
+            throw new RemoteException("LDY-AN00 fingerprint requires native 1216x2640 display");
+        }
+    }
+
+    private HonorLdyAn00FingerprintAdapter(Rpc remote) throws RemoteException {
+        remote.requireIdentity();
