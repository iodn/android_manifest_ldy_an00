+                "mt6993", () -> { reads.incrementAndGet(); return "20240229"; }));
+        assertEquals(0L, HonorBatteryManufacturingDate.read("LDY-AN00", "ldy_an00",
+                "mt6993", () -> { reads.incrementAndGet(); return "0"; }));
+        assertEquals(2, reads.get());
+    }
