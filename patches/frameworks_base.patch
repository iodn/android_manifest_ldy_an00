+            privacy.change(false);
+            // HW_UNAVAILABLE invalidates the framework session. A fresh session reads the native
+            // enrollment that committed before cancellation and refuses a duplicate template.
+            ISession next = session();
+            next.generateChallenge(); mLooper.dispatchAll();
+            next.enrollWithOptions(enrollOptions(preview)); mLooper.dispatchAll();
+            assertEquals(1, mVendor.enrollCalls);
