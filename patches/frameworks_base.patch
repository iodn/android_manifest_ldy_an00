+ */
+package com.android.server.biometrics.sensors;
+
+import static org.junit.Assert.*;
+import static org.mockito.ArgumentMatchers.*;
+import static org.mockito.Mockito.*;
+
+import android.app.ActivityManager;
+import android.app.ActivityTaskManager;
+import android.content.ComponentName;
+import android.content.Context;
+import android.content.pm.PackageManager;
+import android.content.res.Resources;
+import android.hardware.biometrics.BiometricManager;
+import android.hardware.biometrics.IBiometricSensorReceiver;
+import android.hardware.fingerprint.Fingerprint;
+import android.hardware.fingerprint.FingerprintAuthenticateOptions;
+import android.os.Binder;
+import android.os.RemoteException;
+
+import com.android.internal.R;
+import com.android.server.biometrics.log.BiometricContext;
+import com.android.server.biometrics.log.BiometricLogger;
+
+import java.lang.reflect.Field;
+import java.util.ArrayList;
+import java.util.List;
+import org.junit.Before;
+import org.junit.Test;
+
+/** Actual AuthenticationClient success/foreground branches, with no real Keystore/HAL calls. */
+public class AuthenticationClientHonorStrongResetTest {
+    private Context mContext;
+    private BiometricManager mManager;
+    private ActivityTaskManager mTasks;
+    private IBiometricSensorReceiver mReceiver;
+    private Authority mAuthority;
+
+    private static final class Authority implements HonorFaceStrongReset.Authority {
+        long epoch = 7, captured;
+        int strength = 15, grants;
+        public long captureEpoch(int userId) { return epoch; }
+        public int currentStrength(int sensorId) { return strength; }
+        public void authorize(int userId, int sensorId, int strength, long epoch,
+                long operationId, byte[] hat) {
+            assertEquals(10, userId); assertEquals(0, sensorId); assertEquals(15, strength);
+            assertEquals(55, operationId); assertEquals(69, hat.length);
+            captured = epoch; grants++;
+        }
+    }
+    private static final class StopBeforeKeystore extends RuntimeException { }
+
+    @Before public void setup() {
+        mContext = mock(Context.class); mManager = mock(BiometricManager.class);
+        mTasks = mock(ActivityTaskManager.class); mReceiver = mock(IBiometricSensorReceiver.class);
+        mAuthority = new Authority();
+        Resources resources = mock(Resources.class);
+        when(mContext.getResources()).thenReturn(resources);
+        when(resources.getString(R.string.config_keyguardComponent)).thenReturn("guard/.Lockscreen");
+        when(mContext.checkCallingOrSelfPermission(anyString()))
+                .thenReturn(PackageManager.PERMISSION_DENIED);
+        when(mContext.getSystemServiceName(BiometricManager.class))
+                .thenReturn(Context.BIOMETRIC_SERVICE);
+        when(mContext.getSystemService(Context.BIOMETRIC_SERVICE)).thenReturn(mManager);
+        ActivityManager.RunningTaskInfo task = new ActivityManager.RunningTaskInfo();
+        task.topActivity = new ComponentName("caller", "Activity");
+        when(mTasks.getTasks(anyInt())).thenReturn(List.of(task));
+    }
+
+    private AuthenticationClient<Object, FingerprintAuthenticateOptions> client(boolean bp)
+            throws Exception {
+        FingerprintAuthenticateOptions options = new FingerprintAuthenticateOptions.Builder()
+                .setUserId(10).setSensorId(0).setOpPackageName("caller").build();
+        AuthenticationClient<Object, FingerprintAuthenticateOptions> client =
+                new AuthenticationClient<>(mContext, Object::new, new Binder(),
+                        new ClientMonitorCallbackConverter(mReceiver), 55, false, options,
+                        bp ? 4 : 0, false, mock(BiometricLogger.class),
+                        mock(BiometricContext.class), true, null, null, false, false, 15) {
+                    @Override protected ActivityTaskManager getActivityTaskManager() { return mTasks; }
+                    @Override protected void startHalOperation() { }
+                    @Override protected void stopHalOperation() { }
+                    @Override protected void handleLifecycleAfterAuth(boolean success) { }
+                    @Override public boolean wasUserDetected() { return true; }
+                };
+        // Inject this test's process-local producer before the client can enter a queue.
+        // The real object does not enable global properties or manufacture a token.
+        Field origin = AuthenticationClient.class.getDeclaredField("mHonorFaceStrongReset");
+        origin.setAccessible(true);
+        origin.set(client, new HonorFaceStrongReset(true, 10, 0, true, 55, mAuthority));
+        client.waitForCookie(mock(ClientMonitorCallback.class));
+        return client;
+    }
+    private ArrayList<Byte> token() {
+        ArrayList<Byte> token = new ArrayList<>();
+        for (int i = 0; i < 69; i++) token.add((byte) i);
+        return token; // Synthetic bytes stay inside test doubles; no Keystore or real face service.
+    }
+
+    @Test public void biometricPromptSuccessRegistersBeforeReceiverHandoff() throws Exception {
+        var client = client(true);
+        client.onAuthenticated(new Fingerprint("test", 1, 0), true, token());
+        assertEquals(1, mAuthority.grants);
+        verify(mReceiver).onAuthenticationSucceeded(eq(0), any(byte[].class));
+    }
+    @Test public void nonPromptSuccessRegistersBeforeFrameworkResetWithoutKeystoreCall()
+            throws Exception {
+        var client = client(false);
+        doThrow(new StopBeforeKeystore()).when(mManager).resetLockoutTimeBound(
+                any(), any(), anyInt(), anyInt(), any());
+        try {
+            client.onAuthenticated(new Fingerprint("test", 1, 0), true, token());
+            fail("Test must stop at mocked reset before Keystore");
+        } catch (StopBeforeKeystore expected) { }
+        assertEquals(1, mAuthority.grants);
+    }
+    @Test public void backgroundRejectionCannotRegisterStrongOrigin() throws Exception {
+        var client = client(true);
+        when(mTasks.getTasks(anyInt())).thenReturn(List.of());
+        client.onAuthenticated(new Fingerprint("test", 1, 0), true, token());
+        assertEquals(0, mAuthority.grants); assertFalse(client.wasAuthSuccessful());
+    }
+    @Test public void failedMatchCannotRegisterStrongOrigin() throws Exception {
+        client(true).onAuthenticated(new Fingerprint("test", 1, 0), false, token());
+        assertEquals(0, mAuthority.grants);
+    }
+    @Test public void currentStrengthDowngradeCannotRegister() throws Exception {
+        var client = client(true); mAuthority.strength = 255;
+        client.onAuthenticated(new Fingerprint("test", 1, 0), true, token());
+        assertEquals(0, mAuthority.grants);
+    }
+    @Test public void queuedAuthenticationRetainsItsOldCredentialEpoch() throws Exception {
+        var client = client(true); mAuthority.epoch = 8;
+        client.onAuthenticated(new Fingerprint("test", 1, 0), true, token());
+        assertEquals(7, mAuthority.captured); // Actual registry rejects stale7 against current8.
+    }
+}
