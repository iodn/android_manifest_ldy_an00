+        mVendor.ids = new int[0];
+        ISession session = session(); session.generateChallenge(); mLooper.dispatchAll();
+        SurfaceTexture texture = new SurfaceTexture(false);
+        Surface preview = new Surface(texture);
+        try {
+            session.enrollWithOptions(enrollOptions(preview)); mLooper.dispatchAll();
+            assertEquals(1, mVendor.enrollCalls);
+            privacy.change(true); mLooper.dispatchAll();
+            mVendor.ids = new int[]{22};
