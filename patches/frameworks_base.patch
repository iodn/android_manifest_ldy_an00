@@ -0,0 +1,63 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package android.hardware.face;
+
+import android.app.ActivityThread;
+import android.content.Context;
+import android.hardware.SensorPrivacyManager;
+
+/** Current-user combined camera privacy for the in-process system_server face bridge only. */
+final class HonorLdyAn00FaceCameraPrivacy implements HonorLdyAn00FaceAdapter.CameraPrivacy {
+    private final SensorPrivacyManager mManager;
+    private SensorPrivacyManager.OnSensorPrivacyChangedListener mListener;
+
+    static HonorLdyAn00FaceAdapter.CameraPrivacy forSystemServer() {
+        ActivityThread thread = ActivityThread.currentActivityThread();
+        Context context = thread == null ? null : thread.getSystemContext();
+        return new HonorLdyAn00FaceCameraPrivacy(context == null ? null
+                : context.getSystemService(SensorPrivacyManager.class));
+    }
+
+    HonorLdyAn00FaceCameraPrivacy(SensorPrivacyManager manager) { mManager = manager; }
+
+    @Override public boolean blocked() {
+        if (mManager == null) return true;
+        try {
+            return mManager.areAnySensorPrivacyTogglesEnabled(SensorPrivacyManager.Sensors.CAMERA);
+        } catch (RuntimeException unavailable) {
+            return true;
+        }
+    }
+
+    @Override public void start(Runnable onBlocked) {
+        if (mManager == null || mListener != null) {
+            throw new IllegalStateException("Camera privacy observer unavailable");
+        }
+        mListener = new SensorPrivacyManager.OnSensorPrivacyChangedListener() {
+            @Override public void onSensorPrivacyChanged(
+                    SensorPrivacyManager.OnSensorPrivacyChangedListener
+                            .SensorPrivacyChangedParams params) {
+                if (params.getSensor() == SensorPrivacyManager.Sensors.CAMERA
+                        && (params.isEnabled() || blocked())) {
+                    onBlocked.run();
+                }
+            }
+            @Override public void onSensorPrivacyChanged(int sensor, boolean enabled) {
+                if (sensor == SensorPrivacyManager.Sensors.CAMERA && enabled) onBlocked.run();
+            }
+        };
+        // Run the small revocation fence directly; native cancellation is posted to its owner.
+        mManager.addSensorPrivacyListener(SensorPrivacyManager.Sensors.CAMERA,
+                Runnable::run, mListener);
+    }
+
+    @Override public void stop() {
+        SensorPrivacyManager.OnSensorPrivacyChangedListener listener = mListener;
+        mListener = null;
+        if (listener != null) {
+            mManager.removeSensorPrivacyListener(SensorPrivacyManager.Sensors.CAMERA, listener);
+        }
+    }
+}
