+ */
+#pragma once
+
+#include <cstdint>
+#include <vector>
+
+namespace android::surfaceflinger::ldy_an00 {
+
+// Semantic snapshot, never the private stock FrameTimeline C++ ABI.
+enum class CpuPresentMetadata : uint8_t { OnTime, Late, Early, Unknown };
+
+struct FrameHistorySample {
+    int64_t actualStartNs = 0;
+    int64_t actualEndNs = 0;
+    int64_t actualPresentNs = 0;
+    CpuPresentMetadata presentMetadata = CpuPresentMetadata::Unknown;
+};
+
+// Preserve the FrameTimeline deque's chronological order. Include all completed
+// positive-present samples, including Unknown metadata: stock's scan continues
+// past an Unknown nonmatching sample but stops on a known nonmatching sample.
+using CpuPolicyHistory = std::vector<FrameHistorySample>;
+
+} // namespace android::surfaceflinger::ldy_an00
diff --git a/services/surfaceflinger/ldy_an00_composerext/tests/ComposerExtClientTest.cpp b/services/surfaceflinger/ldy_an00_composerext/tests/ComposerExtClientTest.cpp
new file mode 100644
index 0000000..fda200b
--- /dev/null
