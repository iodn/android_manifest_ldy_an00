@@ -0,0 +1,135 @@
+// Copyright (C) 2026 The LineageOS Project; SPDX-License-Identifier: Apache-2.0
+#include <ldy_an00/ComposerExtClient.h>
+#include <cassert>
+#include <cerrno>
+#include <fcntl.h>
+#include <iostream>
+#include <limits>
+#include <unistd.h>
+using namespace android::surfaceflinger::ldy_an00;
+namespace {
+int checks = 0;
+void check(bool value) { ++checks; assert(value); }
+bool closed(int fd) { errno = 0; return fcntl(fd, F_GETFD) == -1 && errno == EBADF; }
+struct Owner : CallbackOwner {
+    bool accepted = true, expireDuringCall = false;
+    int enableCalls = 0, onceCalls = 0, unknownCalls = 0;
+    uint8_t rawEnable = 0;
+    CallbackTicket queued;
+    std::shared_ptr<CallbackGate> gate;
+    bool enqueueEnable(const CallbackTicket& ticket, const EnableRequest& request) override {
+        ++enableCalls; queued = ticket; rawEnable = request.enable;
+        if (expireDuringCall) gate->close();
+        return accepted;
+    }
+    bool enqueueOnce(const CallbackTicket& ticket, uint64_t) override {
+        ++onceCalls; queued = ticket; return accepted;
+    }
+    bool unknownSync(const CallbackTicket&, int64_t opcode, const Bytes&, const Fds&,
+                     const Handles&, Reply* reply) override {
+        ++unknownCalls;
+        if (opcode != 99) return false;
+        reply->result = -7; reply->outputParams = {9}; return true;
+    }
+};
+}
+int main() {
+    check(!decodeEnable(std::nullopt)); check(!decodeOnce(std::nullopt));
+    for (size_t n : {0u, 7u, 8u, 12u, 14u, 16u}) check(!decodeEnable(std::vector<uint8_t>(n)));
+    for (size_t n : {0u, 7u, 9u, 13u, 16u}) check(!decodeOnce(std::vector<uint8_t>(n)));
+    auto bytes = encodeRetrigger(0xfedcba9876543210ULL, -2);
+    check(bytes && bytes->size() == 16); check((*bytes)[0] == 0x10 && (*bytes)[7] == 0xfe);
+    check((*bytes)[8] == 0xfe && (*bytes)[15] == 0xff);
+    auto minimum = encodeRetrigger(0, std::numeric_limits<int64_t>::min());
+    check((*minimum)[8] == 0 && (*minimum)[15] == 0x80);
+    Bytes once = std::vector<uint8_t>(bytes->begin(), bytes->begin() + 8);
+    check(decodeOnce(once) == 0xfedcba9876543210ULL);
+    Bytes enable = std::vector<uint8_t>(13, 0); (*enable)[8] = 0x78; (*enable)[9] = 0x56;
+    (*enable)[10] = 0x34; (*enable)[11] = 0x12; (*enable)[12] = 0xfe;
+    check(decodeEnable(enable)->fps == 0x12345678 && decodeEnable(enable)->enable == 0xfe);
+    auto gate = std::make_shared<CallbackGate>();
+    check(!gate->ticket().isAdmissible()); check(!gate->ticket().isCurrent());
+    check(gate->beginRegistration()); check(!gate->beginRegistration());
+    auto ticket = gate->ticket(); check(ticket.isAdmissible()); check(!ticket.isCurrent());
+    auto owner = std::make_shared<Owner>(); owner->gate = gate;
+    Reply reply;
+    dispatchSync(owner, ticket, kEnable, enable, std::nullopt, std::nullopt, &reply);
+    check(reply.result == 0 && reply.outputParams == std::vector<uint8_t>{1});
+    check(owner->rawEnable == 0xfe && !owner->queued.isCurrent());
+    check(gate->commitRegistration()); check(owner->queued.isCurrent());
+    owner->accepted = false;
+    dispatchSync(owner, ticket, kOnce, once, std::nullopt, std::nullopt, &reply);
+    check(reply.result == 0 && reply.outputParams == std::vector<uint8_t>{0});
+    dispatchSync(owner, ticket, kEnable, std::vector<uint8_t>(14), std::nullopt, std::nullopt, &reply);
+    check(reply.result == -22 && reply.outputParams.empty() && owner->enableCalls == 1);
+    dispatchSync(owner, ticket, 99, std::nullopt, std::nullopt, std::nullopt, &reply);
+    check(reply.result == -7 && reply.outputParams == std::vector<uint8_t>{9});
+    dispatchSync(owner, ticket, 100, std::nullopt, std::nullopt, std::nullopt, &reply);
+    check(reply.result == -22 && reply.outputParams.empty());
+    owner->expireDuringCall = true;
+    dispatchSync(owner, ticket, kEnable, enable, std::nullopt, std::nullopt, &reply);
+    check(reply.result == -22 && reply.outputParams.empty());
+    check(!ticket.isCurrent() && !ticket.isAdmissible()); check(!gate->commitRegistration());
+    check(!gate->beginRegistration());
+    auto next = std::make_shared<CallbackGate>(); check(next->beginRegistration());
+    check(next->commitRegistration()); check(next->ticket().isCurrent()); check(!ticket.isCurrent());
+    auto failedRegistration = std::make_shared<CallbackGate>(); check(failedRegistration->beginRegistration());
+    auto pending = failedRegistration->ticket(); failedRegistration->close();
+    check(!pending.isCurrent() && !failedRegistration->commitRegistration());
+    std::weak_ptr<CallbackOwner> expired;
+    dispatchSync(expired, next->ticket(), kOnce, once, std::nullopt, std::nullopt, &reply);
+    check(reply.result == -22);
+    int first, extra;
+    ndk::ScopedFileDescriptor kept;
+    {
+        std::vector<ndk::ScopedFileDescriptor> fds;
+        first = open("/dev/null", O_RDONLY); extra = open("/dev/null", O_RDONLY);
+        check(first >= 0 && extra >= 0); fds.emplace_back(first); fds.emplace_back(extra);
+        kept = takeRetriggerFence(next->ticket(), 0, fds);
+        check(kept.get() == first && fds.front().get() == -1); check(!closed(extra));
+    }
+    check(!closed(first) && closed(extra)); kept.set(-1); check(closed(first));
+    {
+        int fd = open("/dev/null", O_RDONLY);
+        { std::vector<ndk::ScopedFileDescriptor> fds; fds.emplace_back(fd);
+          check(takeRetriggerFence(next->ticket(), -7, fds).get() == -1 && fds.front().get() == fd); }
+        check(closed(fd));
+    }
+    { std::vector<ndk::ScopedFileDescriptor> fds; check(takeRetriggerFence(next->ticket(), 0, fds).get() == -1); }
+    {
+        std::vector<ndk::ScopedFileDescriptor> fds; fds.emplace_back(-1);
+        extra = open("/dev/null", O_RDONLY); fds.emplace_back(extra);
+        check(takeRetriggerFence(next->ticket(), 0, fds).get() == -1);
+    }
+    check(closed(extra));
+    // Late response after local close cannot transfer its first descriptor.
+    {
+        auto late = std::make_shared<CallbackGate>(); check(late->beginRegistration());
+        check(late->commitRegistration()); auto stale = late->ticket(); late->close();
+        first = open("/dev/null", O_RDONLY);
+        { std::vector<ndk::ScopedFileDescriptor> fds; fds.emplace_back(first);
+          check(takeRetriggerFence(stale, 0, fds).get() == -1 && fds.front().get() == first); }
+        check(closed(first));
+    }
+    // Nonempty params/NativeHandles do not impose an invented exact-one-FD restriction.
+    {
+        int handleFd = open("/dev/null", O_RDONLY);
+        {
+            Reply response; response.result = 0; response.outputParams = {7, 8};
+            response.outputHandles.emplace_back();
+            response.outputHandles.front().fds.emplace_back(handleFd);
+            first = open("/dev/null", O_RDONLY); response.outputFds.emplace_back(first);
+            kept = takeRetriggerFence(next->ticket(), response.result, response.outputFds);
+            check(kept.get() == first);
+        }
+        check(closed(handleFd) && !closed(first)); kept.set(-1); check(closed(first));
+    }
+    // A real descriptor0 is not an invalid opaque handle or a fake signaled fence.
+    int savedStdin = dup(STDIN_FILENO); close(STDIN_FILENO);
+    { std::vector<ndk::ScopedFileDescriptor> fds; int zero = open("/dev/null", O_RDONLY);
+      check(zero == 0); fds.emplace_back(zero); auto fd = takeRetriggerFence(next->ticket(), 0, fds); check(fd.get() == 0); }
+    check(closed(0)); if (savedStdin >= 0) { dup2(savedStdin, 0); close(savedStdin); }
+    next->close(); check(!next->ticket().isCurrent());
+    std::cout << "COMPOSEREXT_CODEC_DISPATCH_FD_GATE_PASS checks=" << checks
+              << "; no Binder RPC, remote drain or SurfaceFlinger integration claim\n";
+}
