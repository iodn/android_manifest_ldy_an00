+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <functional>
+#include <memory>
+
+#include <ldy_an00/SfCpuPolicyHistory.h>
+
+namespace android::surfaceflinger::ldy_an00 {
+
+namespace cpu_policy_abi {
+// Reconstructed stock C-call payload. No private FrameTimeline object crosses this ABI.
+struct alignas(8) Config {
+    int64_t increaseWindowNs;
+    int32_t increaseOffset;
+    int32_t reserved12;
+    int64_t decreaseWindowNs;
+    int32_t decreaseOffset;
+    int32_t reserved28;
+    int64_t targetTimeNs;
+    int32_t renderEngineTid;
+    int32_t suspendReason;
+    uint8_t suspendMid;
+    uint8_t forcePolicy;
+    uint8_t foregroundPolicy;
+    uint8_t reserved51;
+    uint8_t reserved52;
+    uint8_t multiDisplay;
+    uint8_t recording;
+    uint8_t validFps;
+    int32_t systemCpuMask;
+    int32_t reserved60;
+};
+
+class Measurements {
+public:
+    virtual ~Measurements() = default;
+    virtual bool needIncreasePerf(int64_t startNs, int64_t endNs, int64_t targetNs) = 0;
+    virtual bool needReducePerf(int64_t startNs, int64_t endNs, int64_t targetNs) = 0;
+};
+} // namespace cpu_policy_abi
+
+class SfCpuPolicyBridge final {
+public:
+    using SnapshotHistory = std::function<CpuPolicyHistory()>;
+
+    struct FrameFacts {
+        float renderFps = 0;
+        int64_t sfWorkDurationNs = 0;
+        int32_t renderEngineTid = 0;
+        uint32_t poweredDisplayCount = 0;
+        // Exact CPU early-transaction predicate, not broad EarlyGpu/refresh-rate state.
+        bool transactionEarly = false;
+        // Previous completed composite coverage, captured before SF clears its display map.
+        bool previousGpuComposition = false;
+        bool usesClientComposition = false;
+        bool reusedClientComposition = false;
+        // Stock's case-sensitive active layer-name "Record" test, supplied by SF.
+        bool recording = false;
+        bool powerSuspended = false;
+        // Explicit stock debug overrides. No override is the real normal state.
+        bool userHeavyLoading = false;
+        bool forcePolicy = false;
+        bool foregroundPolicy = false;
+        int32_t systemCpuMask = 0;
+    };
+
+    struct Settings {
+        int32_t hardwareMinFps = 60;
+        int32_t clientMinFps = 30;
+        bool earlyHeavy = true;
+        bool boostEarly = true;
+        bool boostRecording = false;
+        bool hardwareSuspend = true;
+        bool hardwareHighFpsSuspend = false;
+        bool forceSuspend = false;
+        int64_t increaseWindowNs = 25'000'000;
+        int64_t decreaseWindowNs = 125'000'000;
+        int32_t earlyIncreaseOffset = 30;
+        int32_t normalIncreaseOffset = 10;
+        int32_t earlyDecreaseOffset = 5;
+        int32_t normalDecreaseOffset = 5;
+        // Target bands <=8ms, <=11ms, >11ms, instruction-proven stock defaults.
+        std::array<int32_t, 3> increaseMarginsNs{500'000, 500'000, 500'000};
+        std::array<int32_t, 3> decreaseMarginsNs{2'000'000, 2'000'000, 2'000'000};
+    };
+
+    // Resolves the complete stock symbol set before create. Null means unavailable.
+    // The snapshot callback may run on the plugin worker and must only acquire
+    // FrameTimeline's own lock; never wait for SF/main or acquire SF state locks.
+    static std::unique_ptr<SfCpuPolicyBridge> create(SnapshotHistory, int32_t sfTid);
+    // Isolated ABI tests can select a fake plugin/settings without any real policy/syscalls.
+    static std::unique_ptr<SfCpuPolicyBridge> createForTesting(
+            SnapshotHistory, int32_t sfTid, const Settings&, const char* libraryName);
+
+    ~SfCpuPolicyBridge();
+    bool ready() const;
+    bool configure(const FrameFacts&);
+    bool startFrame(int64_t vsyncId, int64_t frameBeginNs);
+    bool finishFrame(int64_t vsyncId, int64_t actualFrameEndNs);
+    void notifyHwcTid(int32_t tid);
+    void speedUpRenderEngine(int32_t hint);
+    void clearCorrection(bool clearIncrease, bool clearDecrease);
+    void resetCalculation();
+    void changeToForeground();
+    // Explicitly before FrameTimeline destruction. Destroy/join precedes clearing
+    // its borrowed measurement owner and dlclose; safe to call repeatedly.
+    void shutdown();
+
+    SfCpuPolicyBridge(const SfCpuPolicyBridge&) = delete;
+    SfCpuPolicyBridge& operator=(const SfCpuPolicyBridge&) = delete;
+
+private:
+    class Impl;
+    explicit SfCpuPolicyBridge(std::unique_ptr<Impl>);
+    std::unique_ptr<Impl> mImpl;
+};
+
+} // namespace android::surfaceflinger::ldy_an00
