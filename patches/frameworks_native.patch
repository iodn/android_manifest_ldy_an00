+// Copyright (C) 2026 The LineageOS Project; SPDX-License-Identifier: Apache-2.0
+#include <ldy_an00/ComposerExtTiming.h>
+#include <ldy_an00/ComposerExtCodec.h>
+#include <cassert>
+#include <cstdio>
+#include <limits>
+using namespace android::surfaceflinger::ldy_an00;
+int main() {
+    unsigned checks = 0;
+    auto check = [&](bool value) { assert(value); ++checks; };
+    ComposerExtTiming legacy(true, false, 1);
+    check(!legacy.snapshot());
+    legacy.addDisplay(8, 1); legacy.setActiveDisplay(8);
+    check(!legacy.snapshot()->decoupled);
+    check(!legacy.setComposition(9, true));
+    check(legacy.setComposition(8, true));
+    check(legacy.onDisplayRefresh()->decoupled);
+    check(legacy.setComposition(8, false));
+    for (int i = 0; i < 3; ++i) check(legacy.onDisplayRefresh()->decoupled);
+    check(!legacy.onDisplayRefresh()->decoupled);
+    check(legacy.setComposition(8, true));
+    check(legacy.onDisplayRefresh()->decoupled);
+    legacy.addDisplay(8, 2);
+    check(legacy.snapshot()->generation == 2 && !legacy.snapshot()->decoupled);
+    legacy.removeDisplay(8); check(!legacy.snapshot());
+    ComposerExtTiming extra(true, true, 1);
+    extra.addDisplay(8, 7); extra.setActiveDisplay(8);
+    check(extra.snapshot()->extraVsync == 1);
+    check(extra.setComposition(8, true) && !extra.onDisplayRefresh()->decoupled);
+    check(extra.setExtraVsync(8, 3) == 3 && extra.snapshot()->extraVsync == 3);
+    check(extra.setExtraVsync(8, 0) == 0 && extra.snapshot()->extraVsync == 1);
+    check(!extra.setExtraVsync(9, 2));
+    extra.clear(); check(!extra.snapshot() && !extra.setExtraVsync(8, 1));
+    for (int32_t value : {0, 1, -1, std::numeric_limits<int32_t>::min(),
+                          std::numeric_limits<int32_t>::max()}) {
+        check(decodeInt32(encodeInt32(value)) == value);
+    }
+    check(!decodeInt32(std::nullopt));
+    check(!decodeInt32(std::vector<uint8_t>(3)));
+    check(!decodeComposition(std::vector<uint8_t>(15)));
+    auto comp = std::vector<uint8_t>(16); comp[0] = 8; comp[8] = 1;
+    check(decodeComposition(comp)->display == 8 && decodeComposition(comp)->mode == 1);
+    check(!decodeExtraVsync(std::nullopt));
+    check(!decodeExtraVsync(std::vector<uint8_t>(19)));
+    auto request = std::vector<uint8_t>(20); request[0] = 8; request[16] = 3;
+    check(decodeExtraVsync(request)->display == 8 && decodeExtraVsync(request)->count == 3);
+    request[8] = 1; check(!decodeExtraVsync(request));
+    request.resize(28); request[16] = 99; request[24] = 4;
+    auto decoded = decodeExtraVsync(request);
+    check(decoded && decoded->layers == std::vector<uint64_t>{99} && decoded->count == 4);
+    for (int i = 8; i < 16; ++i) request[i] = 255;
+    check(!decodeExtraVsync(request));
+    std::printf("COMPOSER_TIMING_CODEC_HOST_OK checks=%u\n", checks);
+}
