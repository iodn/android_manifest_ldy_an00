+++ b/services/surfaceflinger/ldy_an00_composerext/include/ldy_an00/ComposerExtGate.h
@@ -0,0 +1,67 @@
+// Copyright (C) 2026 The LineageOS Project; SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include <cstdint>
+#include <memory>
+#include <mutex>
+
+namespace android::surfaceflinger::ldy_an00 {
+class CallbackGate;
+class CallbackTicket {
+public:
+    bool isCurrent() const;
+    bool isAdmissible() const;
+private:
+    friend class CallbackGate;
+    std::weak_ptr<CallbackGate> gate;
+    uint64_t generation = 0;
+};
+// One connection only. Closing never reopens or claims callbacks have drained.
+class CallbackGate : public std::enable_shared_from_this<CallbackGate> {
+public:
+    bool beginRegistration() {
+        std::lock_guard guard(mMutex);
+        if (mState != State::Pending) return false;
+        mState = State::Registering;
+        return true;
+    }
+    bool commitRegistration() {
+        std::lock_guard guard(mMutex);
+        if (mState != State::Registering) return false;
+        mState = State::Active;
+        return true;
+    }
+    CallbackTicket ticket() {
+        std::lock_guard guard(mMutex);
+        CallbackTicket result;
+        result.gate = weak_from_this();
+        if (mState == State::Registering || mState == State::Active) result.generation = mGeneration;
+        return result;
+    }
+    bool close() {
+        std::lock_guard guard(mMutex);
+        if (mState == State::Closed) return false;
+        mState = State::Closed;
+        ++mGeneration;
+        return true;
+    }
+private:
+    friend class CallbackTicket;
+    bool current(uint64_t generation, bool admission) const {
+        std::lock_guard guard(mMutex);
+        return generation == mGeneration && (mState == State::Active
+                || (admission && mState == State::Registering));
+    }
+    enum class State { Pending, Registering, Active, Closed };
+    mutable std::mutex mMutex;
+    State mState = State::Pending;
+    uint64_t mGeneration = 1;
+};
+inline bool CallbackTicket::isCurrent() const {
+    auto owner = gate.lock();
+    return owner && owner->current(generation, false);
+}
+inline bool CallbackTicket::isAdmissible() const {
+    auto owner = gate.lock();
+    return owner && owner->current(generation, true);
+}
+}  // namespace android::surfaceflinger::ldy_an00
