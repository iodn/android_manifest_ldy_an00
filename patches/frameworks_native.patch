+    void close();
+    void shutdown();
+    uint32_t extraVsync(PhysicalDisplayId) const;
+    int extraBuffers() const;
+    // Called after ordinary commit bookkeeping; never replaces real composite work.
+    void committed(PhysicalDisplayId, int64_t expectedPresentNs, bool pureRetrigger,
+                   bool mustComposite, const std::function<bool()>& normalWorkPending);
+    bool enqueueEnable(const CallbackTicket&, const EnableRequest&) override;
+    bool enqueueOnce(const CallbackTicket&, uint64_t display) override;
+    bool unknownSync(const CallbackTicket&, int64_t, const Bytes&, const Fds&,
+                     const Handles&, Reply*) override;
+    void unknownAsync(const CallbackTicket&, int64_t, const Bytes&, const Fds&,
+                      const Handles&) override;
+    void onConnectionClosed() override;
+private:
+    ComposerExtOwner(const sp<SurfaceFlinger>&, std::unique_ptr<SfCpuPolicyBridge>);
+    void post(std::function<void(ComposerExtOwner&, SurfaceFlinger&)>);
+    void applyEnable(const CallbackTicket&, EnableRequest);
+    void applyComposition(const CallbackTicket&, CompositionRequest);
+    void cleanup(SurfaceFlinger&);
+    void diagnosticOnce(uint32_t bit, const char* message);
+    void refreshCpuPower(SurfaceFlinger&);
+    std::optional<SfCpuPolicyBridge::FrameFacts> frameFacts(SurfaceFlinger&) const;
+    struct Display {
+        PhysicalDisplayId physical;
+        wp<DisplayDevice> device;
+        uint64_t generation;
+        int32_t mode;
+        int32_t power;
+        uint64_t lease = 0;
+        uint8_t type = 0;
+        CallbackTicket ticket;
+    };
+    const wp<SurfaceFlinger> mFlinger;
+    std::unique_ptr<SfCpuPolicyBridge> mCpu;
+    std::unique_ptr<ComposerExtClient> mClient;
+    ComposerExtTiming mTiming;
+    std::map<uint64_t, Display> mDisplays; // SF main thread only.
+    // CPU policy has SF process lifetime; these two flags describe only the connection.
+    std::atomic<bool> mClosed{false}, mReady{false};
+    std::atomic<bool> mShutdown{false}, mCpuReady{false};
+    std::optional<int64_t> mCpuFrameVsyncId; // Actual accepted real-frame start, SF thread only.
+    bool mAttempted = false, mDynamicDuration = false, mRetriggerEnabled = false;
+    bool mLastDecoupled = false;
+    std::optional<bool> mCpuPowerSuspended;
+    bool mPreviousGpuComposition = false;
+    std::atomic<bool> mExtraSupported{false};
+    uint64_t mGeneration = 0;
+    const int mExtraBuffers;
