+surfaceflinger::ldy_an00::CpuPolicyHistory FrameTimeline::snapshotCpuPolicyHistory() const {
+    using namespace surfaceflinger::ldy_an00;
+    std::lock_guard lock(mMutex);
+    CpuPolicyHistory history;
+    history.reserve(mDisplayFrames.size());
+    for (const auto& frame : mDisplayFrames) {
+        const auto actual = frame->getActuals();
+        if (actual.presentTime <= 0 || actual.presentTime == Fence::SIGNAL_TIME_PENDING) continue;
+        CpuPresentMetadata metadata = CpuPresentMetadata::Unknown;
+        switch (frame->getFramePresentMetadata()) {
+            case FramePresentMetadata::OnTimePresent: metadata = CpuPresentMetadata::OnTime; break;
+            case FramePresentMetadata::LatePresent: metadata = CpuPresentMetadata::Late; break;
+            case FramePresentMetadata::EarlyPresent: metadata = CpuPresentMetadata::Early; break;
+            case FramePresentMetadata::UnknownPresent: break;
+        }
+        history.push_back({actual.startTime, actual.endTime, actual.presentTime, metadata});
+    }
+    return history;
+}
