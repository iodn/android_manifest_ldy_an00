@@ -0,0 +1,91 @@
+/* Copyright (C) 2026 The LineageOS Project. SPDX-License-Identifier: Apache-2.0 */
+#include <ldy_an00/SfCpuPolicyBridge.h>
+#include <condition_variable>
+#include <mutex>
+#include <thread>
+#include <array>
+#include <limits>
+using namespace android::surfaceflinger::ldy_an00;
+namespace {
+std::mutex stateMutex;
+std::array<int64_t, 22> stats{};
+cpu_policy_abi::Config lastConfig{};
+struct Policy {
+    std::mutex mutex;
+    std::condition_variable cv;
+    bool stopping = false;
+    unsigned jobs = 0;
+    cpu_policy_abi::Measurements* measurements = nullptr;
+    std::thread worker{[this] {
+        std::unique_lock lock(mutex);
+        for (;;) {
+            cv.wait(lock, [this] { return stopping || jobs; });
+            if (stopping) return;
+            --jobs;
+            auto* callback = measurements;
+            lock.unlock();
+            if (callback) {
+                const bool up = callback->needIncreasePerf(0, 1'000'000'000, 10'000'000);
+                const bool down = callback->needReducePerf(0, 1'000'000'000, 10'000'000);
+                std::lock_guard state(stateMutex);
+                ++stats[7]; stats[8] = up; stats[9] = down;
+            }
+            lock.lock();
+        }
+    }};
+};
+Policy* active = nullptr;
+void count(size_t index) { std::lock_guard lock(stateMutex); ++stats[index]; }
+}
+extern "C" {
+void* createSfCpuPolicy() {
+    count(0);
+    active = new Policy;
+    return active;
+}
+void destroySfCpuPolicy(void* handle) {
+    auto* p = static_cast<Policy*>(handle);
+    { std::lock_guard lock(p->mutex); p->stopping = true; p->cv.notify_all(); }
+    p->worker.join();
+    delete p; active = nullptr; count(1);
+}
+void setupPerfMeas(void* handle, cpu_policy_abi::Measurements* callback) {
+    auto* p = static_cast<Policy*>(handle);
+    std::lock_guard lock(p->mutex); p->measurements = callback;
+}
+void setupConfig(void*, cpu_policy_abi::Config* config, bool synchronous) {
+    std::lock_guard lock(stateMutex);
+    ++stats[2]; stats[12] = synchronous; lastConfig = *config;
+    stats[19] = stats[14]; // Clear must have happened before this setup.
+}
+void notifyFrameStart(void*, int64_t, int64_t id, bool) {
+    std::lock_guard lock(stateMutex); ++stats[3]; stats[20] = id;
+}
+#ifndef OMIT_FRAME_END
+void notifyFrameEnd(void* handle, int64_t end, int64_t id, bool suspended) {
+    { std::lock_guard lock(stateMutex); ++stats[4]; if (!end) ++stats[5]; stats[11] = suspended; stats[21] = id; }
+    if (end) {
+        auto* p = static_cast<Policy*>(handle);
+        std::lock_guard lock(p->mutex); ++p->jobs; p->cv.notify_one();
+    }
+}
+#endif
+void notifySpeedUpRE(void*, int32_t, int64_t) { count(16); }
+void notifyClearCorrection(void*, int64_t, bool up, bool down) {
+    std::lock_guard lock(stateMutex); ++stats[14]; stats[17] = up; stats[18] = down;
+}
+void notifyResetCalculation(void*, int64_t) { count(13); }
+void notifyHwcHwbinderTid(void*, int32_t tid) {
+    std::lock_guard lock(stateMutex); stats[6] = tid;
+}
+void changeToForeground(void*) { count(15); }
+int64_t fakeGet(unsigned index) { std::lock_guard lock(stateMutex); return stats.at(index); }
+void fakeConfig(cpu_policy_abi::Config* out) { std::lock_guard lock(stateMutex); *out = lastConfig; }
+bool fakeEvaluate(bool increase, int64_t start, int64_t end, int64_t target) {
+    auto* p = active;
+    if (!p) return false;
+    auto* callback = p->measurements;
+    return increase ? callback->needIncreasePerf(start, end, target)
+                    : callback->needReducePerf(start, end, target);
+}
+}
diff --git a/services/surfaceflinger/ldy_an00_composerext/tests/SfCpuPolicyBridgeHostTest.cpp b/services/surfaceflinger/ldy_an00_composerext/tests/SfCpuPolicyBridgeHostTest.cpp
