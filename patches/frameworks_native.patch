@@ -0,0 +1,77 @@
+// Copyright (C) 2026 The LineageOS Project; SPDX-License-Identifier: Apache-2.0
+#include <ldy_an00/ComposerExtTiming.h>
+namespace android::surfaceflinger::ldy_an00 {
+void ComposerExtTiming::setExtraSupported(bool supported) {
+    std::lock_guard guard(mMutex);
+    mExtraSupported = supported;
+}
+void ComposerExtTiming::addDisplay(uint64_t display, uint64_t generation) {
+    std::lock_guard guard(mMutex);
+    auto it = mDisplays.find(display);
+    if (it == mDisplays.end() || it->second.generation != generation) {
+        mDisplays.insert_or_assign(display, Display{generation});
+    }
+}
+void ComposerExtTiming::removeDisplay(uint64_t display) {
+    std::lock_guard guard(mMutex);
+    mDisplays.erase(display);
+    if (mActive == display) mActive.reset();
+}
+void ComposerExtTiming::setActiveDisplay(std::optional<uint64_t> display) {
+    std::lock_guard guard(mMutex);
+    mActive = display && mDisplays.count(*display) ? display : std::nullopt;
+}
+bool ComposerExtTiming::setComposition(uint64_t display, bool decoupled) {
+    std::lock_guard guard(mMutex);
+    auto it = mDisplays.find(display);
+    if (it == mDisplays.end()) return false;
+    auto& state = it->second;
+    if (state.latest != decoupled && state.cooldown == 0) {
+        state.cooldown = 5;
+        state.firstTransition = decoupled;
+    }
+    state.latest = decoupled;
+    return true;
+}
+std::optional<uint32_t> ComposerExtTiming::setExtraVsync(uint64_t display, uint32_t count) {
+    std::lock_guard guard(mMutex);
+    auto it = mDisplays.find(display);
+    if (it == mDisplays.end()) return std::nullopt;
+    it->second.extra = count;
+    return count;
+}
+std::optional<ComposerExtTiming::Snapshot> ComposerExtTiming::snapshotLocked() const {
+    if (!mActive) return std::nullopt;
+    return snapshotForLocked(*mActive);
+}
+std::optional<ComposerExtTiming::Snapshot> ComposerExtTiming::snapshotForLocked(uint64_t display) const {
+    auto it = mDisplays.find(display);
+    if (it == mDisplays.end()) return std::nullopt;
+    const auto& state = it->second;
+    const bool decoupled = mDynamicDuration && !mExtraSupported
+            && (state.cooldown ? state.firstTransition : state.latest);
+    return Snapshot{display, state.generation, decoupled,
+                    mExtraSupported ? (state.extra ? state.extra : mDefaultExtra) : 0};
+}
+std::optional<ComposerExtTiming::Snapshot> ComposerExtTiming::onDisplayRefresh() {
+    std::lock_guard guard(mMutex);
+    for (auto& [id, state] : mDisplays) {
+        (void)id;
+        if (state.cooldown) --state.cooldown;
+    }
+    return snapshotLocked();
+}
+std::optional<ComposerExtTiming::Snapshot> ComposerExtTiming::snapshot() const {
+    std::lock_guard guard(mMutex);
+    return snapshotLocked();
+}
+std::optional<ComposerExtTiming::Snapshot> ComposerExtTiming::snapshotFor(uint64_t display) const {
+    std::lock_guard guard(mMutex);
+    return snapshotForLocked(display);
+}
+void ComposerExtTiming::clear() {
+    std::lock_guard guard(mMutex);
+    mDisplays.clear();
+    mActive.reset();
+}
+} // namespace android::surfaceflinger::ldy_an00
diff --git a/services/surfaceflinger/ldy_an00_composerext/README.txt b/services/surfaceflinger/ldy_an00_composerext/README.txt
new file mode 100644
index 0000000..c65b880
--- /dev/null
+++ b/services/surfaceflinger/ldy_an00_composerext/README.txt
@@ -0,0 +1,78 @@
+LDY-AN00 private ComposerExt wire transport (not enabled in SurfaceFlinger)
+
+The four AIDL files reconstruct the stock113 Binder wire layout; their original
+vendor argument/field names are unknown. Version1/hash022c728d211f6b275911cb0602f6641afdd275d6
+are observed frozen endpoint metadata, not a claim these reconstructed source
+names naturally hash to the vendor's original API dump. No fake .hash or frozen
+API snapshot is supplied.
+
+The normal host aidl tool generates four CPP files and twelve headers ONLY as
+build intermediates. All five input AIDL files are declared: four local wire
+files plus a narrowly visible filegroup exporting exact common NativeHandle v2.
+The command stages imports inside genDir to avoid undeclared source paths or
+hardcoded Soong intermediates. Frozen NativeHandle retains its upstream Apache
+notice in hardware/interfaces; reconstructed wire files retain their provenance
+comments unchanged.
+
+The static library uses real libbinder_ndk/common-V2-ndk exported headers and
+BINDER_STABILITY_SUPPORT, matching the normal stable platform NDK backend.
+Per-output genrule tags select only the four CPP files; generated include headers
+are exported separately. No compiler-generated C++ is checked into this tree.
+
+There is no SurfaceFlinger dependency, PRODUCT_PACKAGES entry, runtime registration
+or feature enablement here. This module is manually buildable for review; normal
+systemimage has no consumer. The typed client below supplies callback admission, codec, FD ownership and local
+lifecycle handling only. The real feature policy/render/commit/fence engine and
+hardware qualification remain necessary before use.
+
+Stock wire provenance: composer_ext-V1-ndk.so SHA256
+37d5b2206ba28f33f0c45cfe3819035538119983afba5733c6b6facbf2138293.
+The independent native and generated-source review receipts remain under
+artifacts/autonomous-device-check-20261024/stock-warning-followup/display-port-aidl1.
+
+Typed client (host-staged, no SurfaceFlinger hook)
+
+libhonor_ldy_an00_composerext_client performs one nonblocking named lookup, verifies
+version1/hash022c728d211f6b275911cb0602f6641afdd275d6, links death notification and
+registers <pid>_SurfaceFlinger. A result0 opaque signed64 client value, including0,
+is accepted. No HIDL fallback, automatic reconnect, retry or runtime flag is added.
+CallResult.dispatched describes register/retrigger/destroy dispatch, not the earlier
+read-only metadata RPCs. Callers retain the Client throughout every method call.
+
+The exact13-byte enable and8-byte once callback payloads are decoded explicitly
+little endian. Enable's raw byte is preserved for the future native-policy engine;
+no invented canonical-byte restriction is attributed to stock. Known callbacks
+return result0 plus the Owner's genuine queue-admission bool. Unknown synchronous
+opcodes are forwarded to Owner or return-22; asynchronous opcodes remain forwarded.
+Borrowed payload/FD/handle arguments must not escape an Owner method.
+
+Connect and queued intent application share the caller's SF owner executor.
+Registering callbacks may enqueue but their Ticket cannot apply until registerClient
+returns BinderOK/result0 and commits Active. A callback never waits for SF main.
+The actual queued render work MUST check Ticket.isCurrent() at application, not
+merely at receipt. Failed registration, death and local close permanently invalidate
+that generation. This component has no render-state engine to apply such work.
+
+Retrigger sends opcode0x26 (decimal38), an engaged16-byte display/time payload and
+NULL FD/NativeHandle optionals. Only BinderOK/result0/current-ticket/nonempty FD
+results can transfer the first descriptor. All extra FDs and NativeHandle FDs close
+by real NDK RAII; absent/negative FDs never become fake signaled fences. The caller
+also checks canApplyFence() at actual sample application; close/death may race RPC.
+
+Outgoing RPCs retain the connection/callback snapshot without holding our mutex.
+An atomic nonblocking outbound-admission flag rejects concurrent calls with-16.
+Destroy closes admission first; BUSY means no destroy was sent and an explicit first
+dispatch is possible after the other call returns. A sent destroy is never resent.
+It uses opcode0 and all NULL optionals. BinderOK/result0 is NOT a remote queue-drain
+acknowledgment. A known successful registration can retain a cleanup handle after
+concurrent local close; explicit destroy can consume it once. Unknown registrations
+are never guessed or retried. Destructor/detach only close locally; they do not prove
+remote unregistration or synchronous callback drain.
+
+A death cookie contains only a weak Gate and is deleted exclusively by onUnlinked,
+including link-error paths. Scoped recipient deletion automatically unlinks; it does
+not permit freeing a cookie synchronously. No raw SurfaceFlinger pointer is stored.
+
+Direct tests exercise production codec/dispatcher/Gate/ScopedFileDescriptor behavior.
+No Binder RPC, real death/unlink delivery, remote registration/destruction, normal
+Soong client link, SurfaceFlinger integration or hardware behavior is claimed by them.
