@@ -0,0 +1,18 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+#include <cstdint>
+
+namespace android {
+
+// Dataspace classification only; caller owns visibility, HDR admission and output filtering.
+// Extended range is a dataspace property, not proof of a particular image container.
+constexpr int32_t hdrLayerTypeFlags(uint32_t dataspace) {
+    constexpr uint32_t transferMask = 0x07c00000;
+    constexpr uint32_t rangeMask = 0x38000000;
+    const uint32_t transfer = dataspace & transferMask;
+    return (transfer == 0x02000000 ? 0x400 : transfer == 0x01c00000 ? 0x800 : 0)
+            | ((dataspace & rangeMask) == 0x18000000 ? 0x1000 : 0);
+}
+
+} // namespace android
