+bool SurfaceFlinger::mtkNormalWorkPending() const {
+    if (mMustComposite.load() || mTransactionFlags.load()
+            || mPowerModeInProgressCount > 0 || mPowerModeChangeInProgress.load()
+            || mScheduler->getVsyncSchedule()->isModeChangeInProgress()) return true;
+    for (const auto& [_, layer] : mLegacyLayers) {
+        const auto counter = layer->getPendingBufferCounter();
+        if (counter && counter->load() > 0) return true;
+    }
+    for (const auto& [id, _] : FTL_FAKE_GUARD(mStateLock, mPhysicalDisplays)) {
+        if (mDisplayModeController.isModeSetPending(id)) return true;
+    }
+    return false;
+}
