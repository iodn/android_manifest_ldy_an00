@@ -0,0 +1,63 @@
+// Copyright (C) 2026 The LineageOS Project; SPDX-License-Identifier: Apache-2.0
+#include <ldy_an00/ComposerExtCodec.h>
+#include <cstring>
+
+namespace android::surfaceflinger::ldy_an00 {
+static uint64_t readLe(const std::vector<uint8_t>& b, size_t start, size_t size) {
+    uint64_t value = 0;
+    for (size_t i = 0; i < size; ++i) value |= uint64_t(b[start + i]) << (8 * i);
+    return value;
+}
+std::optional<int32_t> decodeInt32(const Bytes& b) {
+    if (!b || b->size() != 4) return std::nullopt;
+    uint32_t bits = uint32_t(readLe(*b, 0, 4));
+    int32_t value;
+    std::memcpy(&value, &bits, sizeof(value));
+    return value;
+}
+Bytes encodeInt32(int32_t value) {
+    uint32_t bits;
+    std::memcpy(&bits, &value, sizeof(bits));
+    return std::vector<uint8_t>{uint8_t(bits), uint8_t(bits >> 8),
+                                uint8_t(bits >> 16), uint8_t(bits >> 24)};
+}
+std::optional<CompositionRequest> decodeComposition(const Bytes& b) {
+    if (!b || b->size() != 16) return std::nullopt;
+    const uint32_t bits = uint32_t(readLe(*b, 8, 4));
+    int32_t mode;
+    std::memcpy(&mode, &bits, sizeof(mode));
+    return CompositionRequest{readLe(*b, 0, 8), mode, uint32_t(readLe(*b, 12, 4))};
+}
+std::optional<ExtraVsyncRequest> decodeExtraVsync(const Bytes& b) {
+    if (!b || b->size() < 20) return std::nullopt;
+    const uint64_t count = readLe(*b, 8, 8);
+    // Check against the supplied bounded vector before multiplication/allocation.
+    if (count != (b->size() - 20) / 8 || (b->size() - 20) % 8) return std::nullopt;
+    ExtraVsyncRequest request{readLe(*b, 0, 8), {},
+                              uint32_t(readLe(*b, b->size() - 4, 4))};
+    request.layers.reserve(size_t(count));
+    for (size_t i = 0; i < size_t(count); ++i) {
+        request.layers.push_back(readLe(*b, 16 + i * 8, 8));
+    }
+    return request;
+}
+std::optional<EnableRequest> decodeEnable(const Bytes& b) {
+    if (!b || b->size() != 13) return std::nullopt;
+    return EnableRequest{readLe(*b, 0, 8), uint32_t(readLe(*b, 8, 4)), (*b)[12]};
+}
+std::optional<uint64_t> decodeOnce(const Bytes& b) {
+    if (!b || b->size() != 8) return std::nullopt;
+    return readLe(*b, 0, 8);
+}
+Bytes encodeRetrigger(uint64_t display, int64_t time) {
+    uint64_t bits;
+    static_assert(sizeof(bits) == sizeof(time));
+    std::memcpy(&bits, &time, sizeof(bits));
+    std::vector<uint8_t> result(16);
+    for (size_t i = 0; i < 8; ++i) {
+        result[i] = uint8_t(display >> (8 * i));
+        result[8 + i] = uint8_t(bits >> (8 * i));
+    }
+    return result;
+}
+}  // namespace android::surfaceflinger::ldy_an00
diff --git a/services/surfaceflinger/ldy_an00_composerext/ComposerExtDispatch.cpp b/services/surfaceflinger/ldy_an00_composerext/ComposerExtDispatch.cpp
new file mode 100644
index 0000000..ca56af5
--- /dev/null
+++ b/services/surfaceflinger/ldy_an00_composerext/ComposerExtDispatch.cpp
@@ -0,0 +1,43 @@
+// Copyright (C) 2026 The LineageOS Project; SPDX-License-Identifier: Apache-2.0
+#include <ldy_an00/ComposerExtClient.h>
+
+namespace android::surfaceflinger::ldy_an00 {
+void dispatchSync(const std::weak_ptr<CallbackOwner>& weak, const CallbackTicket& ticket,
+                  int64_t opcode, const Bytes& params, const Fds& fds,
+                  const Handles& handles, Reply* reply) {
+    *reply = Reply{};
+    reply->result = -22;
+    auto owner = weak.lock();
+    if (!owner || !ticket.isAdmissible()) return;
+    bool accepted;
+    if (opcode == kEnable) {
+        auto request = decodeEnable(params);
+        if (!request) return;
+        accepted = owner->enqueueEnable(ticket, *request);
+    } else if (opcode == kOnce) {
+        auto display = decodeOnce(params);
+        if (!display) return;
+        accepted = owner->enqueueOnce(ticket, *display);
+    } else {
+        if (!owner->unknownSync(ticket, opcode, params, fds, handles, reply)
+                || !ticket.isAdmissible()) {
+            *reply = Reply{};
+            reply->result = -22;
+        }
+        return;
+    }
+    if (!ticket.isAdmissible()) return;
+    reply->result = 0;
+    reply->outputParams = {uint8_t(accepted ? 1 : 0)};
+}
+void dispatchAsync(const std::weak_ptr<CallbackOwner>& weak, const CallbackTicket& ticket,
+                   int64_t opcode, const Bytes& params, const Fds& fds, const Handles& handles) {
+    auto owner = weak.lock();
+    if (owner && ticket.isAdmissible()) owner->unknownAsync(ticket, opcode, params, fds, handles);
+}
+ndk::ScopedFileDescriptor takeRetriggerFence(const CallbackTicket& ticket, int32_t result,
+                                            std::vector<ndk::ScopedFileDescriptor>& fds) {
+    if (!ticket.isCurrent() || result != 0 || fds.empty()) return {};
+    return ndk::ScopedFileDescriptor(fds.front().release());
+}
+}  // namespace android::surfaceflinger::ldy_an00
diff --git a/services/surfaceflinger/ldy_an00_composerext/ComposerExtOwner.cpp b/services/surfaceflinger/ldy_an00_composerext/ComposerExtOwner.cpp
new file mode 100644
index 0000000..1ac2673
--- /dev/null
+++ b/services/surfaceflinger/ldy_an00_composerext/ComposerExtOwner.cpp
@@ -0,0 +1,411 @@
+// Copyright (C) 2026 The LineageOS Project; SPDX-License-Identifier: Apache-2.0
+#undef LOG_TAG
+#define LOG_TAG "LdyAn00Display"
+#include <ldy_an00/ComposerExtOwner.h>
+#include <ldy_an00/SfCpuPolicyBridge.h>
+#include "../SurfaceFlinger.h"
+#include "../Layer.h"
+#include <android-base/properties.h>
+#include <ftl/cast.h>
+#include <limits>
+#include <log/log.h>
+
+namespace android::surfaceflinger::ldy_an00 {
+std::shared_ptr<ComposerExtOwner> ComposerExtOwner::create(
+        const sp<SurfaceFlinger>& sf, std::unique_ptr<SfCpuPolicyBridge> cpu) {
+    if (!sf || !cpu) return {};
+    auto owner = std::shared_ptr<ComposerExtOwner>(new ComposerExtOwner(sf, std::move(cpu)));
+    owner->mClient = std::make_unique<ComposerExtClient>(owner);
+    return owner;
+}
+ComposerExtOwner::ComposerExtOwner(const sp<SurfaceFlinger>& sf,
+                                   std::unique_ptr<SfCpuPolicyBridge> cpu)
+      : mFlinger(sf), mCpu(std::move(cpu)),
+        mTiming(base::GetBoolProperty("vendor.debug.sf.dynamic_duration.switch", true),
+                false, 0),
+        mExtraBuffers(base::GetIntProperty("vendor.debug.sf.dynamic_duration.extra_buffers", 1)),
+        mDebugDiagnostics(base::GetBoolProperty("ro.debuggable", false)) {
+    mDynamicDuration = base::GetBoolProperty("vendor.debug.sf.dynamic_duration.switch", true);
+    mRetriggerEnabled = base::GetBoolProperty("ro.vendor.display.sf.mtk_retrigger", true);
+}
+ComposerExtOwner::~ComposerExtOwner() { shutdown(); }
+void ComposerExtOwner::diagnosticOnce(uint32_t bit, const char* message) {
+    if (!mDebugDiagnostics || (mDiagnosticsSeen.load(std::memory_order_relaxed) & bit)) return;
+    if (!(mDiagnosticsSeen.fetch_or(bit, std::memory_order_relaxed) & bit)) ALOGI("%s", message);
+}
+void ComposerExtOwner::shutdown() {
+    // Only SF owner destruction ends the process-lifetime CPU policy.
+    if (mShutdown.exchange(true)) return;
+    mCpuReady.store(false);
+    mReady.store(false);
+    mClosed.store(true);
+    if (mClient) mClient->detach();
+    if (mCpu) mCpu->shutdown(); // Joins plugin before its typed history provider can disappear.
+}
+void ComposerExtOwner::post(std::function<void(ComposerExtOwner&, SurfaceFlinger&)> work) {
+    auto sf = mFlinger.promote();
+    if (!sf) return;
+    const std::weak_ptr<ComposerExtOwner> weak = weak_from_this();
+    static_cast<void>(sf->mScheduler->schedule([weak, work = std::move(work)] {
+        auto owner = weak.lock();
+        if (!owner) return;
+        auto flinger = owner->mFlinger.promote();
+        if (flinger) work(*owner, *flinger);
+    }));
+}
+void ComposerExtOwner::start() {
+    ftl::FakeGuard mainGuard(kMainThreadContext);
+    if (mAttempted || mClosed.load()) return;
+    mAttempted = true;
+    refreshDisplays(); // Authoritative internal identities precede reentrant callbacks.
+    if (!mCpuReady.load()) {
+        diagnosticOnce(1u << 0, "startup failed: CPU facts/configuration");
+        close(); return;
+    }
+    auto sf = mFlinger.promote();
+    auto result = mClient->connect();
+    if (!result.status.isOk() || result.result != 0 || mClosed.load()) {
+        diagnosticOnce(1u << 0, "startup failed: composer registration");
+        close(); return;
+    }
+    bool extraSupported = false;
+    if (mDynamicDuration) {
+        const auto support = mClient->queryFeature(1);
+        if (!support || mClosed.load()) {
+            diagnosticOnce(1u << 0, "startup failed: capability query");
+            close(); return;
+        } // Unknown is not unsupported.
+        extraSupported = *support > 0;
+    }
+    mExtraSupported.store(extraSupported);
+    mTiming.setExtraSupported(extraSupported);
+    mReady.store(true);
+    diagnosticOnce(1u << 1, "owner ready: CPU configured and composer registered");
+    if (auto sf = mFlinger.promote()) sf->mScheduler->setMtkDurationState(mDynamicDuration, false);
+}
+std::optional<SfCpuPolicyBridge::FrameFacts> ComposerExtOwner::frameFacts(
+        SurfaceFlinger& sf) const {
+    ftl::FakeGuard mainGuard(kMainThreadContext);
+    const auto renderTid = sf.getRenderEngine().getRenderEngineTid();
+    if (!renderTid || *renderTid <= 0) return std::nullopt;
+    SfCpuPolicyBridge::FrameFacts facts;
+    facts.renderEngineTid = *renderTid;
+    facts.renderFps = sf.mScheduler->getPacesetterRefreshRate().getValue();
+    facts.sfWorkDurationNs = sf.mScheduler->vsyncModulator().getVsyncConfig()
+                                    .sfWorkDuration.count();
+    facts.transactionEarly = sf.mScheduler->vsyncModulator().isEarlyTransactionConfig();
+    facts.previousGpuComposition = mPreviousGpuComposition;
+    {
+        Mutex::Autolock lock(sf.mStateLock);
+        for (const auto& [_, device] : sf.mDisplays) {
+            if (device->isPoweredOn()) ++facts.poweredDisplayCount;
+            const auto& state = device->getCompositionDisplay()->getState();
+            facts.usesClientComposition |= state.usesClientComposition;
+            facts.reusedClientComposition |= state.reusedClientComposition;
+        }
+    }
+    facts.powerSuspended = facts.poweredDisplayCount == 0;
+    for (const auto& [_, layer] : sf.mLegacyLayers) {
+        if (layer->getName().find("Record") != std::string::npos) {
+            facts.recording = true;
+            break;
+        }
+    }
+    // Normal stock state has no vendor debug force/heavy/CPU-mask transaction.
+    return facts;
+}
+void ComposerExtOwner::refreshCpuPower(SurfaceFlinger& sf) {
+    if (mShutdown.load()) return;
+    const auto facts = frameFacts(sf);
+    if (!facts) {
+        mCpuReady.store(false);
+        close();
+        return;
+    }
+    if (!mCpuReady.load() || !mCpuPowerSuspended
+            || *mCpuPowerSuspended != facts->powerSuspended) {
+        const bool configured = mCpu->configure(*facts);
+        mCpuReady.store(configured && mCpu->ready());
+        if (!mCpuReady.load()) { close(); return; }
+        mCpuPowerSuspended = facts->powerSuspended;
+    }
+}
+void ComposerExtOwner::frameStarted(int64_t vsyncId, int64_t frameBeginNs) {
+    if (mShutdown.load()) return;
+    if (!mCpuReady.load()) {
+        if (auto sf = mFlinger.promote()) refreshCpuPower(*sf);
+    }
+    if (!mCpuReady.load()) return;
+    if (mCpu->startFrame(vsyncId, frameBeginNs)) {
+        mCpuFrameVsyncId = vsyncId;
+    } else {
+        mCpuReady.store(false);
+        close();
+    }
+}
+void ComposerExtOwner::frameFinished(int64_t vsyncId, int64_t frameEndNs, bool previousGpu) {
+    mPreviousGpuComposition = previousGpu;
+    if (mShutdown.load()) return;
+    auto sf = mFlinger.promote();
+    const auto facts = sf ? frameFacts(*sf) : std::nullopt;
+    const bool configured = facts && mCpu->configure(*facts);
+    mCpuReady.store(configured && mCpu->ready());
+    if (configured) mCpuPowerSuspended = facts->powerSuspended;
+    // A real accepted start still gets its real end if the next configuration
+    // is unavailable. No synthetic frame or guessed replacement facts are sent.
+    const bool started = mCpuFrameVsyncId && *mCpuFrameVsyncId == vsyncId;
+    const bool finished = started && mCpu->finishFrame(vsyncId, frameEndNs);
+    if (started) mCpuFrameVsyncId.reset();
+    if (!mCpuReady.load() || (started && !finished)) { close(); return; }
+    if (!started || !mReady.load() || mClosed.load()) return;
+    diagnosticOnce(1u << 2, "first CPU frame pair completed");
+    // Stock99a61c is reached only from composite via47799c/49be58.
+    // Timing-only retrigger samples must not advance its five-refresh countdown.
+    const auto duration = mTiming.onDisplayRefresh();
+    const bool decoupled = duration && duration->decoupled;
+    if (decoupled != mLastDecoupled) {
+        mLastDecoupled = decoupled;
+        sf->mScheduler->setMtkDurationState(mDynamicDuration, decoupled);
+    }
+}
+void ComposerExtOwner::cleanup(SurfaceFlinger& sf) {
+    ftl::FakeGuard mainGuard(kMainThreadContext);
+    for (auto& [_, display] : mDisplays) {
+        if (display.lease) {
+            if (auto device = display.device.promote()) {
+                sf.releaseMtkRetriggerPolicy(device, display.lease);
+            }
+        }
+    }
+    mDisplays.clear();
+    mTiming.clear();
+    sf.mScheduler->setMtkDurationState(false, false);
+}
+void ComposerExtOwner::close() {
+    mReady.store(false);
+    const bool alreadyClosed = mClosed.exchange(true);
+    diagnosticOnce(1u << 7, "owner closed");
+    // Known healthy local shutdown submits exactly one destroy. Transport death/
+    // unknown completion already closed admission and must not provoke another RPC.
+    if (!alreadyClosed && mClient) {
+        static_cast<void>(mClient->destroy());
+    }
+    if (auto sf = mFlinger.promote()) cleanup(*sf);
+    if (mClient) mClient->detach();
+}
+void ComposerExtOwner::onConnectionClosed() {
+    mReady.store(false);
+    mClosed.store(true); // Immediate admission fence, cleanup never waits for the SF executor.
+    diagnosticOnce(1u << 7, "connection closed");
+    post([](ComposerExtOwner& owner, SurfaceFlinger& sf) {
+        owner.cleanup(sf);
+        if (owner.mClient) owner.mClient->detach();
+        sf.mScheduler->scheduleFrame();
+    });
+}
+void ComposerExtOwner::refreshDisplays() {
+    ftl::FakeGuard mainGuard(kMainThreadContext);
+    auto sf = mFlinger.promote();
+    if (!sf || mShutdown.load()) return;
+    if (mClosed.load()) { refreshCpuPower(*sf); return; }
+    std::map<uint64_t, Display> current;
+    {
+        Mutex::Autolock lock(sf->mStateLock);
+        for (const auto& [_, device] : sf->mDisplays) {
+            if (device->isVirtual()) continue;
+            const auto physical = device->getPhysicalId();
+            if (!sf->mPhysicalDisplays.get(physical)
+                         .transform(&android::display::PhysicalDisplay::isInternal).value_or(false)) continue;
+            const auto hwc = sf->getHwComposer().fromPhysicalDisplayId(physical);
+            if (!hwc || !device->isPoweredOn()) continue;
+            const auto mode = ftl::to_underlying(device->refreshRateSelector()
+                                                       .getActiveMode().modePtr->getId());
+            const int32_t power = static_cast<int32_t>(device->getPowerMode());
+            auto previous = mDisplays.find(*hwc);
+            if (previous != mDisplays.end() && previous->second.device.promote() == device
+                    && previous->second.mode == mode && previous->second.power == power) {
+                current.emplace(*hwc, previous->second);
+            } else {
+                current.emplace(*hwc, Display{physical, device, ++mGeneration, mode, power});
+            }
+        }
+    }
+    // No state/selector lock is held over policy application.
+    for (const auto& [hwc, old] : mDisplays) {
+        auto fresh = current.find(hwc);
+        if (fresh == current.end() || fresh->second.generation != old.generation) {
+            if (old.lease) {
+                if (auto device = old.device.promote()) {
+                    sf->releaseMtkRetriggerPolicy(device, old.lease);
+                }
+            }
+            mTiming.removeDisplay(hwc);
+        }
+    }
+    mDisplays.swap(current);
+    for (const auto& [hwc, display] : mDisplays) mTiming.addDisplay(hwc, display.generation);
+    mTiming.setActiveDisplay(sf->getHwComposer().fromPhysicalDisplayId(
+            sf->mScheduler->getPacesetterDisplayId()));
+    const auto state = mTiming.snapshot();
+    const bool decoupled = state && state->decoupled;
+    if (mReady.load() && decoupled != mLastDecoupled) {
+        mLastDecoupled = decoupled;
+        sf->mScheduler->setMtkDurationState(mDynamicDuration, decoupled);
+    }
+    // Power-off can stop real frames entirely. Publish suspension without
+    // manufacturing an endFrame or waiting for another composition.
+    refreshCpuPower(*sf);
+}
+bool ComposerExtOwner::enqueueEnable(const CallbackTicket& ticket, const EnableRequest& request) {
+    if (mClosed.load() || !ticket.isAdmissible() || request.enable > 2) return false;
+    post([ticket, request](ComposerExtOwner& owner, SurfaceFlinger&) {
+        owner.applyEnable(ticket, request);
+    });
+    return true; // Queue admission only; application rechecks current generation.
+}
+bool ComposerExtOwner::enqueueOnce(const CallbackTicket& ticket, uint64_t display) {
+    return enqueueEnable(ticket, EnableRequest{display, 0, 2});
+}
+void ComposerExtOwner::applyEnable(const CallbackTicket& ticket, EnableRequest request) {
+    ftl::FakeGuard mainGuard(kMainThreadContext);
+    if (!mReady.load() || !ticket.isCurrent()) return;
+    refreshDisplays();
+    auto sf = mFlinger.promote();
+    auto it = mDisplays.find(request.display);
+    if (!sf || it == mDisplays.end() || !mRetriggerEnabled) return;
+    diagnosticOnce(1u << 3, "first current enable callback observed");
+    auto& display = it->second;
+    if (request.enable == 2 && display.type != 0) return; // Stock once deduplicates any entry.
+    auto device = display.device.promote();
+    if (!device) return;
+    if (request.enable == 0) {
+        if (display.lease) sf->releaseMtkRetriggerPolicy(device, display.lease);
+        display.lease = 0; display.type = 0;
+        return;
+    }
+    if (request.enable == 1) {
+        if (sf->updateMtkRetriggerPolicy(device, request.fps, &display.lease) != NO_ERROR) return;
+    }
+    display.type = request.enable;
+    display.ticket = ticket;
+    sf->mScheduler->scheduleRetriggerFrame();
+}
+void ComposerExtOwner::applyComposition(const CallbackTicket& ticket, CompositionRequest request) {
+    ftl::FakeGuard mainGuard(kMainThreadContext);
+    if (!mReady.load() || !ticket.isCurrent()) return;
+    refreshDisplays();
+    if (mTiming.setComposition(request.display, request.mode > 0)) {
+        diagnosticOnce(1u << 4, "first current composition callback applied");
+        if (auto sf = mFlinger.promote()) sf->mScheduler->scheduleFrame();
+    }
+}
+bool ComposerExtOwner::unknownSync(const CallbackTicket& ticket, int64_t opcode,
+        const Bytes& bytes, const Fds& fds, const Handles& handles, Reply* reply) {
+    if (mClosed.load() || !ticket.isAdmissible() || (fds && !fds->empty())
+            || (handles && !handles->empty())) return false;
+    if (opcode == kExtraVsync) {
+        const auto request = decodeExtraVsync(bytes);
+        if (!request) return false;
+        const auto accepted = mTiming.setExtraVsync(request->display, request->count);
+        if (!accepted || !ticket.isAdmissible()) return false;
+        diagnosticOnce(1u << 5, "first admissible extra-VSYNC callback accepted");
+        reply->result = 0;
+        reply->outputParams = *encodeInt32(static_cast<int32_t>(*accepted));
+        return true;
+    }
+    if (opcode == kTest && bytes && !bytes->empty()) {
+        reply->result = 0;
+        reply->outputParams = {uint8_t((*bytes)[0] & 1)};
+        return true;
+    }
+    return false;
+}
+void ComposerExtOwner::unknownAsync(const CallbackTicket& ticket, int64_t opcode,
+        const Bytes& bytes, const Fds&, const Handles&) {
+    if (mClosed.load() || !ticket.isAdmissible()) return;
+    if (opcode == kHwcTid) {
+        if (const auto tid = decodeInt32(bytes); tid && *tid > 0) {
+            post([ticket, tid = *tid](ComposerExtOwner& owner, SurfaceFlinger&) {
+                if (owner.mReady.load() && ticket.isCurrent()) {
+                    owner.mCpu->notifyHwcTid(tid);
+                    owner.diagnosticOnce(1u << 6, "first current HWC-TID callback forwarded");
+                }
+            });
+        }
+    } else if (opcode == kComposition) {
+        if (const auto request = decodeComposition(bytes)) {
+            post([ticket, request = *request](ComposerExtOwner& owner, SurfaceFlinger&) {
+                owner.applyComposition(ticket, request);
+            });
+        }
+    }
+    // Stock15/16/40 and async test are explicit no-ops; borrowed handles remain RAII-owned.
+}
+uint32_t ComposerExtOwner::extraVsync(PhysicalDisplayId id) const {
+    if (!mReady.load() || mClosed.load()) return 0;
+    for (const auto& [hwc, display] : mDisplays) {
+        if (display.physical == id) {
+            const auto state = mTiming.snapshotFor(hwc);
+            return state ? state->extraVsync : 0;
+        }
+    }
+    return 0;
+}
+int ComposerExtOwner::extraBuffers() const {
+    return mReady.load() && !mClosed.load() && mExtraSupported.load() ? mExtraBuffers : 0;
+}
+void ComposerExtOwner::committed(PhysicalDisplayId active, int64_t expectedPresentNs,
+        bool pureRetrigger, bool mustComposite, const std::function<bool()>& normalWorkPending) {
+    ftl::FakeGuard mainGuard(kMainThreadContext);
+    if (!mReady.load() || mClosed.load()) return;
+    refreshDisplays();
+    auto sf = mFlinger.promote();
+    if (!sf) return;
+    bool continuous = false;
+    // Binder may enqueue display/mode work. Never retain a map iterator/reference
+    // across the subsequent refresh of authoritative display identities.
+    const std::vector<std::pair<uint64_t, Display>> pending(mDisplays.begin(), mDisplays.end());
+    for (const auto& [hwc, display] : pending) {
+        if (display.type == 0) continue;
+        if (display.lease) {
+            const auto lease = sf->mMtkRetriggerPolicyLeases.find(display.physical);
+            if (lease == sf->mMtkRetriggerPolicyLeases.end()
+                    || lease->second.token != display.lease) {
+                auto current = mDisplays.find(hwc);
+                if (current != mDisplays.end()
+                        && current->second.generation == display.generation) {
+                    current->second.lease = 0;
+                    current->second.type = 0;
+                }
+                continue; // An accepted external policy revoked this exact lease.
+            }
+        }
+        const bool once = display.type == 2;
+        continuous |= !once;
+        if (once) {
+            auto current = mDisplays.find(hwc);
+            if (current != mDisplays.end() && current->second.generation == display.generation) {
+                current->second.type = 0; // Never retry an unknown once RPC.
+            }
+        }
+        if (!pureRetrigger || mustComposite || normalWorkPending() || !display.ticket.isCurrent()) {
+            continue;
+        }
+        const uint64_t generation = display.generation;
+        auto result = mClient->retrigger(hwc, expectedPresentNs);
+        if (!result.status.isOk() || result.result != 0) {
+            close(); sf->mScheduler->scheduleFrame(); return;
+        }
+        if (!result.canApplyFence() || normalWorkPending()) continue;
+        refreshDisplays();
+        auto current = mDisplays.find(hwc);
+        if (current == mDisplays.end() || current->second.generation != generation
+                || !result.canApplyFence()) continue;
+        if (!once && current->second.physical == active) {
+            const auto fence = sp<Fence>::make(result.fence.release());
+            sf->mScheduler->addPresentFence(active, std::make_shared<FenceTime>(fence));
+        }
+    }
+    if (continuous && !mClosed.load()) sf->mScheduler->scheduleRetriggerFrame();
+}
+} // namespace android::surfaceflinger::ldy_an00
