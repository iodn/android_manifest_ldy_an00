+uint32_t SurfaceFlinger::calculateMtkRetriggerFps(uint32_t requestedFps, Fps physicalCeiling,
+                                                Fps activeRenderFps, uint32_t originalFps) {
+    // Stock calculatedRenderFps: integer truncation and upward divisor rounding are intentional.
+    const auto ceiling = static_cast<uint32_t>(physicalCeiling.getValue());
+    if (requestedFps > physicalCeiling.getValue()) return ceiling;
+    if (originalFps == 0 && activeRenderFps.getValue() > requestedFps) {
+        return static_cast<uint32_t>(activeRenderFps.getValue());
+    }
+    const uint32_t divisor = requestedFps ? ceiling / requestedFps : 0;
+    return ceiling != divisor * requestedFps ? (divisor ? ceiling / divisor : 0) : requestedFps;
+}
+
+status_t SurfaceFlinger::updateMtkRetriggerPolicy(const sp<DisplayDevice>& display,
+                                                 uint32_t requestedFps, uint64_t* lease) {
+    if (!display || display->isVirtual() || !lease) return BAD_VALUE;
+    if (mDebugDisplayModeSetByBackdoor) return INVALID_OPERATION;
+    auto& selector = display->refreshRateSelector();
+    const auto displayId = display->getPhysicalId();
+    const bool currentDisplay = [&] {
+        MODE_TRANSITION_LOCK();
+        return getDisplayDeviceLocked(displayId) == display;
+    }();
+    if (!currentDisplay) return DEAD_OBJECT;
+    const auto activeMode = selector.getActiveMode();
+    auto it = mMtkRetriggerPolicyLeases.find(displayId);
+    if (*lease) {
+        if (it == mMtkRetriggerPolicyLeases.end() || it->second.token != *lease ||
+            it->second.display.promote() != display ||
+            it->second.modeId != activeMode.modePtr->getId()) {
+            return DEAD_OBJECT;
+        }
+        // Stock only adjusts the rate when the requested rate exceeds the saved original.
+        if (requestedFps <= it->second.originalFps) return NO_ERROR;
+    } else {
+        if (it != mMtkRetriggerPolicyLeases.end() && it->second.display.promote() != display) {
+            // A replaced DisplayDevice has a distinct selector. Never touch its predecessor's policy.
+            mMtkRetriggerPolicyLeases.erase(it);
+            it = mMtkRetriggerPolicyLeases.end();
+        }
+        if (it != mMtkRetriggerPolicyLeases.end() || selector.hasOverridePolicy() ||
+            mNextMtkRetriggerPolicyToken == UINT64_MAX) {
+            return INVALID_OPERATION;
+        }
+        // Stock enable(0) records the request but performs no render-policy mutation.
+        if (requestedFps == 0) return NO_ERROR;
+        it = mMtkRetriggerPolicyLeases
+                     .emplace(displayId,
+                              MtkRetriggerPolicyLease{++mNextMtkRetriggerPolicyToken, display,
+                                                      activeMode.modePtr->getId(), 0})
+                     .first;
+    }
+
+    const auto renderFps =
+            calculateMtkRetriggerFps(requestedFps, activeMode.modePtr->getPeakFps(),
+                                    activeMode.fps, it->second.originalFps);
+    if (renderFps == static_cast<uint32_t>(activeMode.fps.getValue())) {
+        // Stock skips the setter if already at the requested rate. Keep only a revocable
+        // reservation; it does not claim the selector's override slot.
+        if (it->second.originalFps == 0) it->second.originalFps = renderFps;
+        *lease = it->second.token;
+        return NO_ERROR;
+    }
+    scheduler::RefreshRateSelector::OverridePolicy policy;
+    // Preserve every current policy field before replacing the stock-constrained mode/ranges.
+    static_cast<scheduler::RefreshRateSelector::Policy&>(policy) = selector.getCurrentPolicy();
+    policy.defaultMode = activeMode.modePtr->getId();
+    const FpsRange physical{activeMode.modePtr->getPeakFps(), activeMode.modePtr->getPeakFps()};
+    const FpsRange render{Fps::fromValue(10), Fps::fromValue(renderFps)};
+    policy.primaryRanges = {physical, render};
+    policy.appRequestRanges = {physical, render};
+    const auto status = setDesiredDisplayModeSpecsInternal(display, policy, nullptr,
+                                                          DisplayPolicyOrigin::MtkRetrigger);
+    it = mMtkRetriggerPolicyLeases.find(displayId);
+    if (it != mMtkRetriggerPolicyLeases.end()) {
+        // An apply error does not undo the accepted selector mutation: retain release authority.
