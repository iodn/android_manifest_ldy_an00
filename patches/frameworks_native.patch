index 0000000..d743a39
--- /dev/null
+++ b/services/surfaceflinger/ldy_an00_composerext/tests/SfCpuPolicyBridgeHostTest.cpp
@@ -0,0 +1,174 @@
+/* Copyright (C) 2026 The LineageOS Project. SPDX-License-Identifier: Apache-2.0 */
+#include <ldy_an00/SfCpuPolicyBridge.h>
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstdlib>
+#include <cstring>
+#include <dlfcn.h>
+#include <iostream>
+#include <mutex>
+#include <sys/syscall.h>
+#include <thread>
+#include <unistd.h>
+using namespace android::surfaceflinger::ldy_an00;
+// Host fixture supplies property lookup only. No Android device/properties are contacted.
+extern "C" int property_get(const char*, char* value, const char* fallback) {
+    std::strcpy(value, fallback); return std::strlen(fallback);
+}
+namespace {
+int checks = 0;
+void check(bool value) { if (!value) std::abort(); ++checks; }
+struct History {
+    std::mutex mutex;
+    std::condition_variable cv;
+    CpuPolicyHistory frames;
+    bool block = false, entered = false, release = false;
+    CpuPolicyHistory snapshot() {
+        std::unique_lock lock(mutex);
+        if (block) { entered = true; cv.notify_all(); cv.wait(lock, [&] { return release; }); }
+        return frames;
+    }
+};
+FrameHistorySample sample(int64_t start, int64_t end, CpuPresentMetadata metadata) {
+    return {start, end, end + 1, metadata};
+}
+}
+int main(int argc, char** argv) {
+    check(argc == 3);
+    void* library = dlopen(argv[1], RTLD_NOW);
+    check(library != nullptr);
+    auto get = reinterpret_cast<int64_t (*)(unsigned)>(dlsym(library, "fakeGet"));
+    auto config = reinterpret_cast<void (*)(cpu_policy_abi::Config*)>(dlsym(library, "fakeConfig"));
+    auto evaluate = reinterpret_cast<bool (*)(bool,int64_t,int64_t,int64_t)>(
+            dlsym(library, "fakeEvaluate"));
+    check(get && config && evaluate);
+    auto history = std::make_shared<History>();
+    SfCpuPolicyBridge::Settings settings;
+    const int32_t tid = syscall(SYS_gettid);
+    check(!SfCpuPolicyBridge::createForTesting([history] { return history->snapshot(); },
+                                             tid, settings, argv[2]));
+    check(get(0) == 0); // Complete symbol-set resolution must precede creation.
+    check(!SfCpuPolicyBridge::createForTesting({}, tid, settings, argv[1]));
+    check(!SfCpuPolicyBridge::createForTesting([history] { return history->snapshot(); },
+                                             tid + 100000, settings, argv[1]));
+    auto bridge = SfCpuPolicyBridge::createForTesting(
+            [history] { return history->snapshot(); }, tid, settings, argv[1]);
+    check(bridge && !bridge->ready() && get(0) == 1);
+    SfCpuPolicyBridge::FrameFacts facts;
+    facts.renderFps = 120; facts.sfWorkDurationNs = 9'000'000;
+    facts.renderEngineTid = tid; facts.poweredDisplayCount = 1;
+    check(bridge->configure(facts) && bridge->ready());
+    cpu_policy_abi::Config c{};
+    config(&c);
+    check(c.targetTimeNs == 8'000'000 && c.renderEngineTid == tid);
+    check(c.increaseWindowNs == 25'000'000 && c.increaseOffset == 10);
+    check(c.decreaseWindowNs == 125'000'000 && c.decreaseOffset == 5);
+    check(!c.suspendMid && !c.multiDisplay && !c.recording && c.validFps);
+    check(get(17) == 0 && get(18) == 0 && get(19) == get(14));
+    facts.previousGpuComposition = true;
+    for (const auto& [fps, budget, expected] :
+         std::array<std::array<int64_t, 3>, 7>{{{144, 30'000'000, 6'000'000},
+          {100, 30'000'000, 8'000'000}, {90, 30'000'000, 11'000'000},
+          {60, 30'000'000, 16'000'000}, {60, 15'000'000, 12'300'000},
+          {30, 30'000'000, 25'000'000}, {144, 4'000'000, 4'000'000}}}) {
+        facts.renderFps = fps; facts.sfWorkDurationNs = budget;
+        check(bridge->configure(facts)); config(&c); check(c.targetTimeNs == expected);
+    }
+    facts.renderFps = 120; facts.sfWorkDurationNs = 9'000'000;
+    bool wrongThreadAccepted = true;
+    std::thread wrongThread([&] { wrongThreadAccepted = bridge->configure(facts); });
+    wrongThread.join(); check(!wrongThreadAccepted);
+    facts.transactionEarly = true; facts.recording = true; facts.poweredDisplayCount = 2;
+    check(bridge->configure(facts));
+    config(&c);
+    check(c.increaseOffset == 30 && c.multiDisplay && c.recording);
+    check(get(17) == 1 && get(18) == 1 && get(19) == get(14));
+    check(c.forcePolicy && c.foregroundPolicy && c.systemCpuMask == 0);
+    facts.forcePolicy = true; facts.foregroundPolicy = false; facts.transactionEarly = false;
+    facts.systemCpuMask = 0x55;
+    check(bridge->configure(facts)); config(&c);
+    check(c.forcePolicy && !c.foregroundPolicy && c.systemCpuMask == 0x55);
+    auto setFrames = [&](CpuPolicyHistory frames) {
+        std::lock_guard lock(history->mutex); history->frames = std::move(frames);
+    };
+    constexpr auto Known = CpuPresentMetadata::OnTime;
+    constexpr auto Unknown = CpuPresentMetadata::Unknown;
+    setFrames({sample(1, 5'000'001, Known), sample(20'000'000, 40'000'000, Known)});
+    check(!evaluate(true, 0, 100'000'000, 10'000'000)); // Known first non-late stops.
+    setFrames({sample(1, 5'000'001, Unknown), sample(20'000'000, 40'000'000, Known)});
+    check(evaluate(true, 0, 100'000'000, 10'000'000));
+    setFrames({sample(1, 5'000'001, Known), sample(20'000'000, 40'000'000, Known)});
+    check(!evaluate(false, 0, 100'000'000, 10'000'000)); // Known non-early vetoes.
+    setFrames({sample(1, 5'000'001, Known), sample(20'000'000, 40'000'000, Unknown)});
+    check(evaluate(false, 0, 100'000'000, 10'000'000));
+    setFrames({sample(1, 8'000'001, Known)});
+    check(!evaluate(false, 0, 100'000'000, 10'000'000)); // Strict 8ms bound.
+    check(!evaluate(true, 100'000'000, 1, 10'000'000));
+    check(!evaluate(false, 0, 100'000'000, 0));
+    setFrames({});
+    check(!evaluate(true, 0, 100'000'000, 10'000'000));
+    check(!evaluate(false, 0, 100'000'000, 10'000'000));
+    bridge->notifyHwcTid(321); check(get(6) == 321);
+    bridge->notifyHwcTid(-1); check(get(6) == 321);
+    check(bridge->startFrame(1, 1'000'000));
+    check(bridge->startFrame(2, 2'000'000)); // Prior uncomposited start only zero-closes.
+    check(get(5) == 1);
+    check(!bridge->finishFrame(1, 3'000'000));
+    check(bridge->finishFrame(2, 3'000'000));
+    check(!bridge->finishFrame(2, 3'000'000));
+    // Genuine immediate frames preserve the original default VsyncId(-1); zero is also not a sentinel.
+    check(bridge->startFrame(-1, 3'000'001)); check(get(20) == -1);
+    check(bridge->finishFrame(-1, 3'000'002)); check(get(21) == -1);
+    check(!bridge->finishFrame(-1, 3'000'003));
+    check(bridge->startFrame(0, 3'000'004)); check(get(20) == 0);
+    check(bridge->finishFrame(0, 3'000'005)); check(get(21) == 0);
+    check(!bridge->finishFrame(0, 3'000'006));
+    // A failed NEXT configuration sends no native setup and cannot strand the
+    // genuine frame already started under the last accepted native configuration.
+    check(bridge->startFrame(8, 3'100'000));
+    const auto setupsBeforeInvalid = get(2);
+    const auto endsBeforeInvalid = get(4);
+    const auto zeroEndsBeforeInvalid = get(5);
+    facts.sfWorkDurationNs = 0;
+    check(!bridge->configure(facts) && !bridge->ready());
+    check(get(2) == setupsBeforeInvalid && get(4) == endsBeforeInvalid);
+    check(!bridge->finishFrame(9, 3'200'000)); // No completion for another frame.
+    check(get(4) == endsBeforeInvalid);
+    check(bridge->finishFrame(8, 3'200'000)); // Only the actual matching real end.
+    check(get(4) == endsBeforeInvalid + 1 && get(21) == 8);
+    check(get(5) == zeroEndsBeforeInvalid); // No synthetic zero-timestamp end.
+    check(!bridge->finishFrame(8, 3'200'001)); // Exactly once.
+    check(get(4) == endsBeforeInvalid + 1);
+
+    check(!bridge->startFrame(3, 3'000'000));
+    facts.sfWorkDurationNs = 9'000'000;
+    check(bridge->configure(facts));
+    // Drain a real fake-plugin worker callback before destroying its borrowed owner.
+    {
+        std::unique_lock lock(history->mutex);
+        history->block = true;
+        history->entered = false;
+    }
+    check(bridge->startFrame(4, 4'000'000));
+    check(bridge->finishFrame(4, 5'000'000));
+    {
+        std::unique_lock lock(history->mutex);
+        check(history->cv.wait_for(lock, std::chrono::seconds(2), [&] { return history->entered; }));
+    }
+    std::weak_ptr<History> weak = history;
+    auto* release = history.get();
+    history.reset();
+    std::atomic<bool> done = false;
+    std::thread stopper([&] { bridge->shutdown(); done = true; });
+    std::this_thread::sleep_for(std::chrono::milliseconds(20));
+    check(!done && !weak.expired());
+    { std::lock_guard lock(release->mutex); release->release = true; release->cv.notify_all(); }
+    stopper.join();
+    check(done && weak.expired() && get(1) == 1);
+    check(!bridge->ready() && !bridge->startFrame(5, 5'000'000));
+    bridge->shutdown(); bridge.reset(); check(get(1) == 1);
+    dlclose(library);
+    std::cout << "SF_CPU_POLICY_BRIDGE_HOST_PASS checks=" << checks
+              << " fakePluginOnly noDevicePolicyCalls\n";
+}
