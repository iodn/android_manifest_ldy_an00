+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+#include <ldy_an00/SfCpuPolicyBridge.h>
+
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <cstddef>
+#include <cstdlib>
+#include <dlfcn.h>
+#include <limits>
+#include <string>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+#include <cutils/properties.h>
+
+namespace android::surfaceflinger::ldy_an00 {
+namespace {
+using Config = cpu_policy_abi::Config;
+static_assert(sizeof(Config) == 64 && alignof(Config) == 8);
+static_assert(offsetof(Config, increaseWindowNs) == 0);
+static_assert(offsetof(Config, increaseOffset) == 8);
+static_assert(offsetof(Config, decreaseWindowNs) == 16);
+static_assert(offsetof(Config, decreaseOffset) == 24);
+static_assert(offsetof(Config, targetTimeNs) == 32);
+static_assert(offsetof(Config, renderEngineTid) == 40);
+static_assert(offsetof(Config, suspendReason) == 44);
+static_assert(offsetof(Config, suspendMid) == 48);
+static_assert(offsetof(Config, forcePolicy) == 49);
+static_assert(offsetof(Config, foregroundPolicy) == 50);
+static_assert(offsetof(Config, multiDisplay) == 53);
+static_assert(offsetof(Config, recording) == 54);
+static_assert(offsetof(Config, validFps) == 55);
+static_assert(offsetof(Config, systemCpuMask) == 56);
+static_assert(sizeof(cpu_policy_abi::Measurements) == sizeof(void*));
+
+int64_t nowNs() {
+    return std::chrono::duration_cast<std::chrono::nanoseconds>(
+                   std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+
+int32_t overrideProperty(const char* suffix, int32_t initial, bool nonnegative = false) {
+    const std::string key = std::string("vendor.debug.sf.cpupolicy.") + suffix;
+    char text[PROPERTY_VALUE_MAX];
+    property_get(key.c_str(), text, "-1");
+    // Same signed-integer/sentinel contract as the retained stock adapter.
+    const int value = std::atoi(text);
+    return value == -1 || (nonnegative && value < 0) ? initial : value;
+}
+
+SfCpuPolicyBridge::Settings readSettings() {
+    SfCpuPolicyBridge::Settings s;
+    s.hardwareMinFps = overrideProperty("hw_comp_min", s.hardwareMinFps, true);
+    s.clientMinFps = overrideProperty("gpu_comp_min", s.clientMinFps, true);
+    s.earlyHeavy = overrideProperty("early_heavy", s.earlyHeavy) != 0;
+    s.boostEarly = overrideProperty("boost_early", s.boostEarly) != 0;
+    s.boostRecording = overrideProperty("boost_sr", s.boostRecording) != 0;
+    s.hardwareSuspend = overrideProperty("hw_comp_suspend", s.hardwareSuspend, true) != 0;
+    s.hardwareHighFpsSuspend = overrideProperty("hw_hfr_suspend", 0, true) != 0;
+    s.forceSuspend = overrideProperty("force_suspend", 0, true) != 0;
+    s.increaseWindowNs = overrideProperty("power_up_time", static_cast<int32_t>(s.increaseWindowNs));
+    s.decreaseWindowNs = overrideProperty("power_down_time", static_cast<int32_t>(s.decreaseWindowNs));
+    s.earlyIncreaseOffset = overrideProperty("high_power_up_offset", s.earlyIncreaseOffset);
+    s.normalIncreaseOffset = overrideProperty("power_up_offset", s.normalIncreaseOffset);
+    s.earlyDecreaseOffset = overrideProperty("high_power_down_offset", s.earlyDecreaseOffset);
+    s.normalDecreaseOffset = overrideProperty("power_down_offset", s.normalDecreaseOffset);
+    const char* up[] = {"power_up_120", "power_up_90", "power_up_margin"};
+    const char* down[] = {"power_down_120", "power_down_90", "power_down_margin"};
+    for (size_t i = 0; i < 3; ++i) {
+        s.increaseMarginsNs[i] = overrideProperty(up[i], s.increaseMarginsNs[i]);
+        s.decreaseMarginsNs[i] = overrideProperty(down[i], s.decreaseMarginsNs[i]);
+    }
+    return s;
+}
+
+int64_t targetTime(int fps, int64_t workDuration) {
+    const int64_t target = fps >= 126 ? 6'000'000
+            : fps >= 96 ? 8'000'000
+            : fps >= 69 ? 11'000'000
+            : fps >= 36 ? (workDuration > 15'999'999 ? 16'000'000 : 12'300'000)
+                        : 25'000'000;
+    return std::min(target, workDuration);
+}
+
+bool eligible(const FrameHistorySample& f, int64_t start, int64_t end) {
+    return f.actualPresentNs > 0 && f.actualStartNs >= start && f.actualEndNs <= end
+            && f.actualStartNs >= 0 && f.actualEndNs >= f.actualStartNs;
+}
+
+float historyFps(const CpuPolicyHistory& frames) {
+    std::vector<int64_t> presents;
+    for (const auto& frame : frames) {
+        if (frame.actualPresentNs > 0) presents.push_back(frame.actualPresentNs);
+    }
+    if (presents.size() < 16) return 0;
+    int64_t previous = -1, duration = 0, count = 0;
+    for (size_t i = presents.size() - 16; i < presents.size(); ++i) {
+        const int64_t present = presents[i];
+        if (previous != -1 && present != previous) {
+            if (present < previous || duration > std::numeric_limits<int64_t>::max()
+                                                  - (present - previous)) return 0;
+            duration += present - previous;
+            ++count;
+        }
+        previous = present;
+    }
+    return duration > 0 ? static_cast<float>(count * 1'000'000'000.0 / duration) : 0;
+}
+
+struct Functions {
+    void* (*create)() = nullptr;
+    void (*destroy)(void*) = nullptr;
+    void (*setup)(void*, Config*, bool) = nullptr;
+    void (*measure)(void*, cpu_policy_abi::Measurements*) = nullptr;
+    void (*start)(void*, int64_t, int64_t, bool) = nullptr;
+    void (*speed)(void*, int32_t, int64_t) = nullptr;
+    void (*end)(void*, int64_t, int64_t, bool) = nullptr;
+    void (*clear)(void*, int64_t, bool, bool) = nullptr;
+    void (*reset)(void*, int64_t) = nullptr;
+    void (*tid)(void*, int32_t) = nullptr;
+    void (*foreground)(void*) = nullptr;
+
+    bool resolve(void* library) {
+#define RESOLVE(member, symbol) member = reinterpret_cast<decltype(member)>(dlsym(library, symbol)); if (!member) return false
+        RESOLVE(create, "createSfCpuPolicy");
+        RESOLVE(destroy, "destroySfCpuPolicy");
+        RESOLVE(setup, "setupConfig");
+        RESOLVE(measure, "setupPerfMeas");
+        RESOLVE(start, "notifyFrameStart");
+        RESOLVE(speed, "notifySpeedUpRE");
+        RESOLVE(end, "notifyFrameEnd");
+        RESOLVE(clear, "notifyClearCorrection");
+        RESOLVE(reset, "notifyResetCalculation");
+        RESOLVE(tid, "notifyHwcHwbinderTid");
+        RESOLVE(foreground, "changeToForeground");
+#undef RESOLVE
+        return true;
+    }
+};
+
+class Metrics final : public cpu_policy_abi::Measurements {
+public:
+    Metrics(SfCpuPolicyBridge::SnapshotHistory snapshot,
+            const SfCpuPolicyBridge::Settings& settings)
+          : mSnapshot(std::move(snapshot)), mSettings(settings) {}
+
+    CpuPolicyHistory snapshot() const { return mSnapshot ? mSnapshot() : CpuPolicyHistory{}; }
+    void clear() { mSnapshot = {}; } // Only after plugin destroy has joined its worker.
+
+    bool needIncreasePerf(int64_t start, int64_t end, int64_t target) override {
+        int64_t adjusted;
+        if (!threshold(start, end, target, mSettings.increaseMarginsNs, adjusted)) return false;
+        const int64_t limit = std::max(target, adjusted);
+        for (const auto& frame : snapshot()) {
+            if (!eligible(frame, start, end)) continue;
+            if (frame.actualEndNs - frame.actualStartNs > limit) return true;
+            if (frame.presentMetadata != CpuPresentMetadata::Unknown) break;
+        }
+        return false;
+    }
+    bool needReducePerf(int64_t start, int64_t end, int64_t target) override {
+        int64_t adjusted;
+        if (!threshold(start, end, target, mSettings.decreaseMarginsNs, adjusted)) return false;
+        const int64_t limit = std::min(target, adjusted);
+        bool early = false;
+        for (const auto& frame : snapshot()) {
+            if (!eligible(frame, start, end)) continue;
+            if (frame.actualEndNs - frame.actualStartNs < limit) early = true;
+            else if (frame.presentMetadata != CpuPresentMetadata::Unknown) return false;
+        }
+        return early;
+    }
+
+private:
+    static bool threshold(int64_t start, int64_t end, int64_t target,
+                          const std::array<int32_t, 3>& margins, int64_t& adjusted) {
+        if (start < 0 || end < start || target <= 0) return false;
+        const int64_t margin = margins[target < 8'000'001 ? 0 : target < 11'000'001 ? 1 : 2];
+        if (margin < 0 && target > std::numeric_limits<int64_t>::max() + margin) return false;
+        adjusted = target - margin;
+        return true;
+    }
+
+    SfCpuPolicyBridge::SnapshotHistory mSnapshot;
+    const SfCpuPolicyBridge::Settings mSettings;
+};
+} // namespace
+
+class SfCpuPolicyBridge::Impl {
+public:
+    Impl(SnapshotHistory snapshot, int32_t sfTid, Settings settings)
+          : metrics(std::move(snapshot), settings), settings(std::move(settings)), sfTid(sfTid) {}
+    ~Impl() { shutdown(); }
+
+    bool open(const char* name) {
+        if (!name || sfTid <= 0 || sfTid != syscall(SYS_gettid)
+                || settings.increaseWindowNs <= 0 || settings.decreaseWindowNs <= 0) return false;
+        library = dlopen(name, RTLD_NOW | RTLD_LOCAL);
+        if (!library || !fn.resolve(library)) return false;
+        policy = fn.create();
+        if (!policy) return false;
+        fn.measure(policy, &metrics);
+        return true;
+    }
+
+    void shutdown() {
+        std::lock_guard lock(mutex);
+        closed = true;
+        configured = false;
+        if (policy) {
+            fn.destroy(policy); // Joins before the borrowed metrics/history owner is cleared.
+            policy = nullptr;
+        }
+        metrics.clear();
+        if (library) { dlclose(library); library = nullptr; }
+    }
+
+    bool ready() const {
+        std::lock_guard lock(mutex);
+        return !closed && policy && configured;
+    }
+
+    bool active() const { return !closed && policy && syscall(SYS_gettid) == sfTid; }
+    bool suspensionActive() const { return hadEnd && suspended; }
+    void resetIfActive() { if (!suspensionActive()) fn.reset(policy, nativeVsyncId); }
+
+    bool configure(const FrameFacts& facts) {
+        std::lock_guard lock(mutex);
+        if (!active()) return false;
+        if (!std::isfinite(facts.renderFps) || facts.renderFps < 0 || facts.renderFps > 1000
+                || (!facts.powerSuspended && facts.renderFps == 0)
+                || facts.sfWorkDurationNs <= 0 || facts.renderEngineTid <= 0) {
+            configured = false;
+            return false;
+        }
+        const int fps = static_cast<int>(std::round(facts.renderFps));
+        const bool multi = facts.poweredDisplayCount > 1;
+        const bool heavy = multi || facts.userHeavyLoading || facts.usesClientComposition
+                || facts.reusedClientComposition || (facts.transactionEarly && settings.earlyHeavy);
+        const bool clientOrHeavy = facts.usesClientComposition || heavy;
+        // Stock consumes the PREVIOUS composition coverage before recalculating suspension.
+        if (!suspensionActive())
+            fn.clear(policy, nativeVsyncId, facts.previousGpuComposition, heavy);
+        const bool recordingBoost = settings.boostRecording && facts.recording && fps > 60;
+        const bool earlyBoost = settings.boostEarly && facts.transactionEarly && fps > 60;
+        Config config{};
+        config.increaseWindowNs = settings.increaseWindowNs;
+        config.increaseOffset = facts.transactionEarly ? settings.earlyIncreaseOffset
+                                                       : settings.normalIncreaseOffset;
+        config.decreaseWindowNs = settings.decreaseWindowNs;
+        config.decreaseOffset = facts.transactionEarly ? settings.earlyDecreaseOffset
+                                                       : settings.normalDecreaseOffset;
+        config.targetTimeNs = targetTime(fps, facts.sfWorkDurationNs);
+        config.renderEngineTid = facts.renderEngineTid;
+        config.multiDisplay = multi;
+        config.recording = facts.recording;
+        config.validFps = fps != 0;
+        config.forcePolicy = facts.forcePolicy || recordingBoost || earlyBoost;
+        config.foregroundPolicy = facts.foregroundPolicy || earlyBoost;
+        config.systemCpuMask = facts.systemCpuMask;
+
+        const int64_t now = nowNs();
+        int reason = fps > 65 ? (fps < 96 ? 5 : 6) : 4;
+        if (clientOrHeavy && fps >= settings.clientMinFps) reason = 2;
+        if (fps >= settings.hardwareMinFps) reason = 1;
+        bool needSuspend = clientOrHeavy && fps < settings.hardwareMinFps
+                ? fps < settings.clientMinFps : fps < settings.hardwareMinFps;
+        const int previousBand = band;
+        float actualFps = lastHistoryFps;
+        if (fps != 0 && !facts.powerSuspended) {
+            actualFps = historyFps(metrics.snapshot());
+            lastHistoryFps = actualFps;
+            if (actualFps >= 95) {
+                highFrames = clientOrHeavy ? 0 : std::min(highFrames + 1, 5);
+                band = 6;
+                if (!clientOrHeavy && highFrames > 4 && settings.hardwareHighFpsSuspend) {
+                    needSuspend = true; reason = 6;
+                }
+            } else if (actualFps >= 69) {
+                ninetyFrames = previousBand == 5 ? std::min(ninetyFrames + 1, 45) : 0;
+                band = 5;
+                if (ninetyFrames > 44) {
+                    if (!clientOrHeavy && settings.hardwareHighFpsSuspend) {
+                        needSuspend = true; reason = 5;
+                    }
+                    config.targetTimeNs = targetTime(90, facts.sfWorkDurationNs);
+                }
+            } else {
+                sixtyFrames = previousBand < 5 ? std::min(sixtyFrames + 1, 20) : 0;
+                band = 4;
+                if (sixtyFrames > 19) {
+                    if (!clientOrHeavy && settings.hardwareSuspend) {
+                        needSuspend = true; reason = 4;
+                    }
+                    config.targetTimeNs = targetTime(60, facts.sfWorkDurationNs);
+                }
+                if (actualFps <= 35) {
+                    thirtyFrames = previousBand < 4 ? std::min(thirtyFrames + 1, 20) : 0;
+                    band = 3;
+                    if (thirtyFrames > 19) {
+                        if (!clientOrHeavy && settings.hardwareSuspend) {
+                            needSuspend = true; reason = 3;
+                        }
+                        config.targetTimeNs = targetTime(60, facts.sfWorkDurationNs);
+                    }
+                }
+            }
+        }
+
+        if (!facts.powerSuspended) {
+            const int64_t idle = lastConfigureNs == 0 ? 0 : now - lastConfigureNs;
+            if (!clientOrHeavy && lastConfigureNs != 0 && idle > 99'999'999) resetIfActive();
+            if ((!clientOrHeavy && slowFrameFps > 0
+                 && (slowFrameFps <= 10 || actualFps <= 10))
+                    || (slowFrameFps > 0 && slowFrameFps <= 5)) {
+                config.targetTimeNs = targetTime(10, facts.sfWorkDurationNs);
+                needSuspend = true;
+                resetIfActive();
+            }
+            if (actualFps < 1 && lastConfigureNs != 0 && idle > 999'999'999) {
+                config.targetTimeNs = targetTime(10, facts.sfWorkDurationNs);
+                needSuspend = true;
+                reason = 0;
+            }
+            lastConfigureNs = now;
+            needSuspend = needSuspend || settings.forceSuspend;
+        }
+        const bool wasSuspended = suspended;
+        suspended = facts.powerSuspended || needSuspend;
+        config.suspendReason = facts.powerSuspended ? 0 : reason;
+        if (suspended && !wasSuspended) resetIfActive();
+
+        fn.setup(policy, &config, suspensionActive());
+        configured = true;
+        return true;
+    }
+
+    bool start(int64_t vsyncId, int64_t begin) {
+        std::lock_guard lock(mutex);
+        if (!active() || !configured || begin <= 0) return false;
+        const int64_t now = nowNs();
+        if (slowBaseNs == 0 || lastEndNs == 0 || now - lastEndNs < 40'000'000) {
+            slowFrameFps = 0; slowCount = 0; slowBaseNs = lastEndNs;
+        } else if (now > slowBaseNs) {
+            ++slowCount;
+            if (now - slowBaseNs >= 300'000'000)
+                slowFrameFps = static_cast<float>(slowCount * 1'000'000'000.0
+                                                  / (now - slowBaseNs));
+        }
+        if (!hadEnd) {
+            // Stock's bookkeeping closure, never a real present or history sample.
+            fn.end(policy, 0, nativeVsyncId, false);
+            hadEnd = true;
+        }
+        fn.start(policy, begin, vsyncId, suspended);
+        pendingVsyncId = vsyncId;
+        framePending = true;
+        if (!suspended) { nativeVsyncId = vsyncId; hadEnd = false; }
+        return true;
+    }
+
+    bool finish(int64_t vsyncId, int64_t end) {
+        std::lock_guard lock(mutex);
+        // An invalid NEXT configuration cannot invalidate an already accepted real start.
+        // Its matching real end uses the last accepted native configuration.
+        if (!active() || !framePending || vsyncId != pendingVsyncId || end <= 0) return false;
+        lastEndNs = nowNs();
+        fn.end(policy, end, nativeVsyncId, suspensionActive());
+        hadEnd = true;
+        framePending = false;
+        return true;
+    }
+
+    mutable std::mutex mutex;
+    Metrics metrics;
+    Settings settings;
+    const int32_t sfTid;
+    Functions fn;
+    void* library = nullptr;
+    void* policy = nullptr;
+    bool closed = false, configured = false, suspended = false, hadEnd = true;
+    bool framePending = false;
+    int64_t nativeVsyncId = 0, pendingVsyncId = 0, lastEndNs = 0, lastConfigureNs = 0;
+    int64_t slowBaseNs = 0, slowCount = 0;
+    float slowFrameFps = 0, lastHistoryFps = 0;
+    int band = 6, highFrames = 0, ninetyFrames = 0, sixtyFrames = 0, thirtyFrames = 0;
+};
+
+std::unique_ptr<SfCpuPolicyBridge> SfCpuPolicyBridge::create(
+        SnapshotHistory snapshot, int32_t sfTid) {
+    return createForTesting(std::move(snapshot), sfTid, readSettings(), "/system_ext/lib64/libsf_cpupolicy.so");
+}
+std::unique_ptr<SfCpuPolicyBridge> SfCpuPolicyBridge::createForTesting(
+        SnapshotHistory snapshot, int32_t sfTid, const Settings& settings, const char* name) {
+    if (!snapshot) return nullptr;
+    auto impl = std::make_unique<Impl>(std::move(snapshot), sfTid, settings);
+    if (!impl->open(name)) return nullptr;
+    return std::unique_ptr<SfCpuPolicyBridge>(new SfCpuPolicyBridge(std::move(impl)));
+}
+SfCpuPolicyBridge::SfCpuPolicyBridge(std::unique_ptr<Impl> impl) : mImpl(std::move(impl)) {}
+SfCpuPolicyBridge::~SfCpuPolicyBridge() { shutdown(); }
+bool SfCpuPolicyBridge::ready() const { return mImpl->ready(); }
+bool SfCpuPolicyBridge::configure(const FrameFacts& facts) { return mImpl->configure(facts); }
+bool SfCpuPolicyBridge::startFrame(int64_t id, int64_t begin) { return mImpl->start(id, begin); }
+bool SfCpuPolicyBridge::finishFrame(int64_t id, int64_t end) { return mImpl->finish(id, end); }
+void SfCpuPolicyBridge::notifyHwcTid(int32_t tid) {
+    std::lock_guard lock(mImpl->mutex);
+    if (mImpl->active() && tid > 0) mImpl->fn.tid(mImpl->policy, tid);
+}
+void SfCpuPolicyBridge::speedUpRenderEngine(int32_t hint) {
+    std::lock_guard lock(mImpl->mutex);
+    if (mImpl->active()) mImpl->fn.speed(mImpl->policy, hint, mImpl->nativeVsyncId);
+}
+void SfCpuPolicyBridge::clearCorrection(bool increase, bool decrease) {
+    std::lock_guard lock(mImpl->mutex);
+    if (mImpl->active() && !mImpl->suspensionActive())
+        mImpl->fn.clear(mImpl->policy, mImpl->nativeVsyncId, increase, decrease);
+}
+void SfCpuPolicyBridge::resetCalculation() {
+    std::lock_guard lock(mImpl->mutex);
+    if (mImpl->active()) mImpl->resetIfActive();
+}
+void SfCpuPolicyBridge::changeToForeground() {
+    std::lock_guard lock(mImpl->mutex);
+    if (mImpl->active()) mImpl->fn.foreground(mImpl->policy);
+}
+void SfCpuPolicyBridge::shutdown() { if (mImpl) mImpl->shutdown(); }
+
+} // namespace android::surfaceflinger::ldy_an00
