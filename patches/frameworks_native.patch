+class Callback final : public wire::BnComposerExtCallback {
+public:
+    Callback(std::weak_ptr<CallbackOwner> owner, std::weak_ptr<CallbackGate> gate)
+          : mOwner(std::move(owner)), mGate(std::move(gate)) {}
+    ndk::ScopedAStatus syncPerform(int64_t opcode, const Bytes& params, const Fds& fds,
+                                   const Handles& handles, Reply* reply) override {
+        auto gate = mGate.lock();
+        dispatchSync(mOwner, gate ? gate->ticket() : CallbackTicket{},
+                     opcode, params, fds, handles, reply);
+        return ndk::ScopedAStatus::ok();
+    }
+    ndk::ScopedAStatus asyncPerform(int64_t opcode, const Bytes& params, const Fds& fds,
+                                    const Handles& handles) override {
+        auto gate = mGate.lock();
+        dispatchAsync(mOwner, gate ? gate->ticket() : CallbackTicket{},
+                      opcode, params, fds, handles);
+        return ndk::ScopedAStatus::ok();
+    }
+private:
+    const std::weak_ptr<CallbackOwner> mOwner;
+    const std::weak_ptr<CallbackGate> mGate;
+};
+struct DeathCookie { std::weak_ptr<CallbackGate> gate; std::weak_ptr<CallbackOwner> owner; };
+void died(void* raw) {
+    auto* cookie = static_cast<DeathCookie*>(raw);
+    if (auto gate = cookie->gate.lock(); gate && gate->close()) {
+        if (auto owner = cookie->owner.lock()) owner->onConnectionClosed();
+    }
+}
+void unlinked(void* raw) { delete static_cast<DeathCookie*>(raw); }
+struct Connection {
+    std::shared_ptr<wire::IComposerExt> proxy;
+    std::shared_ptr<Callback> callback;
+    ndk::SpAIBinder binder;
+    ndk::ScopedAIBinder_DeathRecipient death;
+    int64_t client = 0;  // Opaque signed64; zero is valid after result0.
+};
+// Admission only, never a blocking lock. Binder callbacks cannot wait on this flag.
+struct Outbound {
+    explicit Outbound(std::atomic_flag& flag) : flag(flag), admitted(!flag.test_and_set()) {}
+    ~Outbound() { if (admitted) flag.clear(); }
+    std::atomic_flag& flag;
+    bool admitted;
+};
+}  // namespace
+struct ComposerExtClient::Impl {
+    explicit Impl(std::weak_ptr<CallbackOwner> owner) : owner(std::move(owner)) {}
+    std::mutex mutex;
+    std::atomic_flag outbound = ATOMIC_FLAG_INIT;
+    bool attempted = false;
+    const std::weak_ptr<CallbackOwner> owner;
+    const std::shared_ptr<CallbackGate> gate = std::make_shared<CallbackGate>();
+    std::shared_ptr<Connection> connection;
+    void closeGate() {
+        if (gate->close()) {
+            if (auto target = owner.lock()) target->onConnectionClosed();
+        }
+    }
+};
+ComposerExtClient::ComposerExtClient(std::weak_ptr<CallbackOwner> owner)
+      : mImpl(std::make_shared<Impl>(std::move(owner))) {}
+ComposerExtClient::~ComposerExtClient() { detach(); }
+CallResult ComposerExtClient::connect() {
+    const auto state = mImpl;
+    CallResult result;
+    Outbound operation(state->outbound);
+    if (!operation.admitted) { result.result = -16; return result; }
+    {
+        std::lock_guard guard(state->mutex);
+        if (state->attempted) return result;
+        state->attempted = true;
+    }
+    auto connection = std::make_shared<Connection>();
+    connection->binder = ndk::SpAIBinder(AServiceManager_checkService(kService));
+    if (!connection->binder.get() || state->owner.expired()) { state->closeGate(); return result; }
+    connection->proxy = wire::IComposerExt::fromBinder(connection->binder);
+    if (!connection->proxy) { state->closeGate(); return result; }
+    int32_t version = 0;
+    std::string hash;
+    result.status = connection->proxy->getInterfaceVersion(&version);
+    if (result.status.isOk()) result.status = connection->proxy->getInterfaceHash(&hash);
+    if (!result.status.isOk()) { result.result = -112; state->closeGate(); return result; }
+    if (version != 1 || hash != kHash) { result.result = -22; state->closeGate(); return result; }
+    connection->callback = ndk::SharedRefBase::make<Callback>(state->owner, state->gate);
+    connection->death = ndk::ScopedAIBinder_DeathRecipient(AIBinder_DeathRecipient_new(died));
+    AIBinder_DeathRecipient_setOnUnlinked(connection->death.get(), unlinked);
+    // Binder owns this cookie until onUnlinked, INCLUDING linkToDeath error paths.
+    auto* cookie = new DeathCookie{state->gate, state->owner};
+    binder_status_t linked = AIBinder_linkToDeath(connection->binder.get(),
+                                                connection->death.get(), cookie);
+    if (linked != STATUS_OK) {
+        result.status = ndk::ScopedAStatus::fromStatus(linked);
+        result.result = -112;
+        state->closeGate();
+        return result;
+    }
+    if (!state->gate->beginRegistration()) return result;
+    wire::parcelable_registerClient reply;
+    const std::string name = std::to_string(getpid()) + "_SurfaceFlinger";
+    result.dispatched = true;
+    result.status = connection->proxy->registerClient(name, connection->callback, &reply);
+    if (!result.status.isOk()) { result.result = -112; state->closeGate(); return result; }
+    result.result = reply.result;
+    if (reply.result != 0) { state->closeGate(); return result; }
+    connection->client = reply.client;
+    {
+        std::lock_guard guard(state->mutex);
+        state->connection = connection;  // Keep known cleanup handle even if death closed the gate.
+    }
+    if (!state->gate->commitRegistration()) result.result = -112;
+    return result;
+}
+CallResult ComposerExtClient::retrigger(uint64_t display, int64_t time) {
+    const auto state = mImpl;
+    CallResult result;
+    Outbound operation(state->outbound);
+    if (!operation.admitted) { result.result = -16; return result; }
+    std::shared_ptr<Connection> connection;
+    {
+        std::lock_guard guard(state->mutex);
+        connection = state->connection;
+    }
+    result.ticket = state->gate->ticket();
+    if (!connection || !result.ticket.isCurrent()) return result;
+    Reply reply;
+    result.dispatched = true;
+    result.status = connection->proxy->syncPerform(connection->client, kRetrigger,
+                                                   encodeRetrigger(display, time),
+                                                   std::nullopt, std::nullopt, &reply);
+    if (!result.status.isOk()) { result.result = -112; state->closeGate(); return result; }
+    result.result = reply.result;
+    // The synchronous RPC may finish after death/detach. Do not return a late usable FD.
+    result.fence = takeRetriggerFence(result.ticket, reply.result, reply.outputFds);
+    if (!result.ticket.isCurrent()) result.fence.set(-1);
+    // Caller rechecks canApplyFence() at actual owner-thread sample application.
+    return result;
+}
+std::optional<int32_t> ComposerExtClient::queryFeature(int32_t feature) {
+    const auto state = mImpl;
+    Outbound operation(state->outbound);
+    if (!operation.admitted) return std::nullopt;
+    std::shared_ptr<Connection> connection;
+    {
+        std::lock_guard guard(state->mutex);
+        connection = state->connection;
+    }
+    const auto ticket = state->gate->ticket();
+    if (!connection || !ticket.isCurrent()) return std::nullopt;
+    Reply reply;
+    auto status = connection->proxy->syncPerform(connection->client, kQueryFeature,
+                                                 encodeInt32(feature), std::nullopt,
+                                                 std::nullopt, &reply);
+    if (!status.isOk()) { state->closeGate(); return std::nullopt; }
+    if (!ticket.isCurrent() || reply.result != 0 || !reply.outputFds.empty()
+            || !reply.outputHandles.empty()) return std::nullopt;
+    return decodeInt32(reply.outputParams);
+}
+CallResult ComposerExtClient::destroy() {
+    const auto state = mImpl;
+    state->closeGate();
+    CallResult result;
+    Outbound operation(state->outbound);
+    if (!operation.admitted) { result.result = -16; return result; }
+    std::shared_ptr<Connection> connection;
+    {
+        std::lock_guard guard(state->mutex);
+        connection.swap(state->connection);
+    }
+    if (!connection) return result;
+    Reply reply;
+    result.dispatched = true;
+    result.status = connection->proxy->syncPerform(connection->client, kDestroy,
+                                                   std::nullopt, std::nullopt, std::nullopt, &reply);
+    result.result = result.status.isOk() ? reply.result : -112;
+    // Neither BinderOK nor result0 establishes remote callback/render-queue drain.
+    return result;
+}
+void ComposerExtClient::detach() {
+    const auto state = mImpl;
+    state->closeGate();
+    std::shared_ptr<Connection> old;
+    {
+        std::lock_guard guard(state->mutex);
+        old.swap(state->connection);
+    }
+    // Scoped recipient deletion unlinks without synchronous cookie reclamation.
+    // old (callback/proxy/binder) is destroyed outside our mutex; cookie survives to onUnlinked.
+}
+}  // namespace android::surfaceflinger::ldy_an00
