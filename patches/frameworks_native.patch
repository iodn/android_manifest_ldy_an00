+// SPDX-License-Identifier: Apache-2.0
+#include <gtest/gtest.h>
+#include "HdrLayerInfoReporter.h"
+#include "HdrLayerInfoTypes.h"
+
+namespace android {
+TEST(HdrLayerInfoTypesTest, TransferAndRangeClassification) {
+    for (uint32_t transfer = 0; transfer < 32; ++transfer) {
+        for (uint32_t range = 0; range < 8; ++range) {
+            const uint32_t dataspace = (transfer << 22) | (range << 27);
+            const int32_t expected = (transfer == 8 ? 0x400 : transfer == 7 ? 0x800 : 0)
+                    | (range == 3 ? 0x1000 : 0);
+            EXPECT_EQ(expected, hdrLayerTypeFlags(dataspace));
+            EXPECT_EQ(expected, hdrLayerTypeFlags(dataspace | 0x003fffff));
+        }
+    }
+}
+TEST(HdrLayerInfoTypesTest, MixedTypesAndFlagsOnlyChanges) {
+    HdrLayerInfoReporter::HdrLayerInfo hlg;
+    hlg.numberOfHdrLayers = 1; hlg.maxW = 100; hlg.maxH = 200;
+    hlg.maxDesiredHdrSdrRatio = 2;
+    hlg.flags = hdrLayerTypeFlags(0x02000000);
+    auto pq = hlg;
+    pq.flags = hdrLayerTypeFlags(0x01c00000);
+    EXPECT_NE(hlg, pq); // Type-only transition must dispatch despite identical count/area/ratio.
+    auto mixed = hlg;
+    mixed.flags |= pq.flags | hdrLayerTypeFlags(0x18000000);
+    EXPECT_EQ(0x1c00, mixed.flags);
+    mixed = HdrLayerInfoReporter::HdrLayerInfo{};
+    EXPECT_EQ(0, mixed.flags); // Existing mirroring/no-HDR reset clears classification too.
+}
+} // namespace android
