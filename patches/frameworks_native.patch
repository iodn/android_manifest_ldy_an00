+namespace android::surfaceflinger::ldy_an00 {
+// One connection's duration state. Display identities are enrolled only by SF's main
+// thread; the synchronous callback publishes under this lock without waiting for SF.
+class ComposerExtTiming {
+public:
+    struct Snapshot { uint64_t display, generation; bool decoupled; uint32_t extraVsync; };
+    ComposerExtTiming(bool dynamicDuration, bool extraSupported, uint32_t defaultExtra)
+          : mDynamicDuration(dynamicDuration), mExtraSupported(extraSupported),
+            mDefaultExtra(defaultExtra) {}
+    void addDisplay(uint64_t display, uint64_t generation);
+    void setExtraSupported(bool supported);
+    void removeDisplay(uint64_t display);
+    void setActiveDisplay(std::optional<uint64_t> display);
+    bool setComposition(uint64_t display, bool decoupled);
+    std::optional<uint32_t> setExtraVsync(uint64_t display, uint32_t count);
+    // Stock decrements all cooldowns before selecting this refresh's effective mode.
+    std::optional<Snapshot> onDisplayRefresh();
+    std::optional<Snapshot> snapshot() const;
+    std::optional<Snapshot> snapshotFor(uint64_t display) const;
+    void clear();
+private:
+    struct Display {
+        uint64_t generation;
+        bool latest = false, firstTransition = false;
+        uint32_t cooldown = 0, extra = 0;
+    };
+    std::optional<Snapshot> snapshotLocked() const;
+    std::optional<Snapshot> snapshotForLocked(uint64_t display) const;
+    const bool mDynamicDuration;
+    bool mExtraSupported;
+    const uint32_t mDefaultExtra;
+    mutable std::mutex mMutex;
