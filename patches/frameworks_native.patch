+void SurfaceFlinger::initializeMtkDisplayExtension() {
+    if (getMtkDisplayExtension()
+            || base::GetProperty("ro.product.product.model", "") != "LDY-AN00"
+            || base::GetProperty("ro.product.product.device", "") != "ldy_an00"
+            || base::GetProperty("ro.hardware", "") != "mt6993"
+            || !base::GetBoolProperty("persist.sf.debug.mtk_composer_ext", true)
+            || !base::GetBoolProperty("ro.vendor.display.sf_debug_cpu_policy", false)) return;
+    auto cpu = surfaceflinger::ldy_an00::SfCpuPolicyBridge::create(
+            [this] { return mFrameTimeline->snapshotCpuPolicyHistory(); }, gettid());
+    if (!cpu) return;
+    const auto owner = surfaceflinger::ldy_an00::ComposerExtOwner::create(
+            sp<SurfaceFlinger>::fromExisting(this), std::move(cpu));
+    if (!owner) return;
+    std::atomic_store(&mMtkDisplayExtension, owner);
+    const std::weak_ptr<surfaceflinger::ldy_an00::ComposerExtOwner> weak = owner;
+    mScheduler->setMtkExtraVsyncProvider([weak](PhysicalDisplayId id) {
+        auto owner = weak.lock();
+        return owner ? owner->extraVsync(id) : 0;
+    });
+    owner->start();
