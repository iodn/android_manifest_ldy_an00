+// Copyright (C) 2026 The LineageOS Project; SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include <ldy_an00/ComposerExtCodec.h>
+#include <ldy_an00/ComposerExtGate.h>
+#include <aidl/vendor/mediatek/hardware/composer_ext/parcelable_perform.h>
+#include <android/binder_auto_utils.h>
+#include <memory>
+
+namespace android::surfaceflinger::ldy_an00 {
+using Reply = aidl::vendor::mediatek::hardware::composer_ext::parcelable_perform;
+using Fds = std::optional<std::vector<ndk::ScopedFileDescriptor>>;
+using Handles = std::optional<std::vector<std::optional<::aidl::android::hardware::common::NativeHandle>>>;
+class CallbackOwner {
+public:
+    virtual ~CallbackOwner() = default;
+    // Queue only; never wait for SurfaceFlinger main thread. The queued work MUST
+    // recheck ticket.isCurrent() before changing render state. Borrowed args must not escape.
+    // Called after admission is closed. Queue cleanup only; never wait for SF.
+    virtual void onConnectionClosed() {}
+    virtual bool enqueueEnable(const CallbackTicket&, const EnableRequest&) = 0;
+    virtual bool enqueueOnce(const CallbackTicket&, uint64_t display) = 0;
+    virtual bool unknownSync(const CallbackTicket&, int64_t, const Bytes&, const Fds&,
+                             const Handles&, Reply*) { return false; }
+    virtual void unknownAsync(const CallbackTicket&, int64_t, const Bytes&, const Fds&,
+                              const Handles&) {}
+};
+// Actual callback dispatcher, separated from Binder entry for direct host tests.
+void dispatchSync(const std::weak_ptr<CallbackOwner>& owner, const CallbackTicket& ticket,
+                  int64_t opcode, const Bytes&, const Fds&, const Handles&, Reply*);
+void dispatchAsync(const std::weak_ptr<CallbackOwner>& owner, const CallbackTicket& ticket,
+                   int64_t opcode, const Bytes&, const Fds&, const Handles&);
+ndk::ScopedFileDescriptor takeRetriggerFence(const CallbackTicket& ticket, int32_t result,
+                                            std::vector<ndk::ScopedFileDescriptor>& fds);
+struct CallResult {
+    ndk::ScopedAStatus status = ndk::ScopedAStatus::ok();
+    int32_t result = -1;
+    ndk::ScopedFileDescriptor fence;
+    bool dispatched = false;
+    CallbackTicket ticket;
+    bool canApplyFence() const {
+        return status.isOk() && result == 0 && fence.get() >= 0 && ticket.isCurrent();
+    }
+};
+class ComposerExtClient {
+public:
+    explicit ComposerExtClient(std::weak_ptr<CallbackOwner> owner);
+    ~ComposerExtClient();
+    ComposerExtClient(const ComposerExtClient&) = delete;
+    ComposerExtClient& operator=(const ComposerExtClient&) = delete;
+    // Connect and queued callback application share the caller's SF owner executor. Registering
+    // callbacks only enqueue: their tickets cannot apply until connect commits and returns.
+    // Lookup is nonblocking; Binder RPCs are synchronous and must run without SF/owner locks.
+    // One connect attempt, no automatic reconnect/retry. Concurrent outbound calls return-16.
+    CallResult connect();
+    CallResult retrigger(uint64_t display, int64_t time);
+    // Exact stock opcode7/feature request; unknown/malformed replies are not false.
+    std::optional<int32_t> queryFeature(int32_t feature);
+    // Inert locally BEFORE RPC. Busy means no destroy sent; caller may dispatch once after
+    // its other worker call returns. A sent destroy is never resent and is NOT a drain ack.
+    CallResult destroy();
+    // No outgoing Binder RPC and no synchronous callback drain, including in destructor.
+    void detach();
+private:
+    struct Impl;
+    std::shared_ptr<Impl> mImpl;
+};
+}  // namespace android::surfaceflinger::ldy_an00
