+        ArgumentCaptor<Message> replies = ArgumentCaptor.forClass(Message.class);
+        verify(phone, atLeastOnce()).setRadioCapability(requests.capture(), replies.capture());
+        RadioCapability request = requests.getValue();
+        RadioCapability response = new RadioCapability(request.getPhoneId(), request.getSession(),
