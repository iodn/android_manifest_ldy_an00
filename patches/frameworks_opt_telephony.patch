+        controller.disableDataForNonDefaultNonOpportunisticSubscriptions();
+        check(!PhoneFactory.phones[1].data.enabled,
+                "replacement physical card receives normal automatic disable");
+        service.target = new DefaultDataSelectionIntent.PhysicalTarget(true, false, 1, "card-a");
+        PhoneFactory.phones[1].data.enabled = true;
+        service.authority.recordExplicitSelection(1); // Same DDS as temporary fallback.
+        controller.disableDataForNonDefaultNonOpportunisticSubscriptions();
