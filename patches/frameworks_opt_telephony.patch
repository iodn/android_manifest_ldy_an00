+        cases++;f=returned();f.begin(3);f.port.records.add(f.port.new OpenLogicalChannelRecord(new com.android.internal.telephony.IccLogicalChannelRequest()));
+        f.port.epoch++;Handler.advance(100);unknown(f);
+        cases++;f=returned();f.old.unknown();f.port.disposed=true;f.begin(3);Handler.runReady();
+        check(f.sink.last()==HonorScopedApduChannel.UNKNOWN);none(f);
+        String diagnostics=String.join("\n",android.util.Log.lines);
