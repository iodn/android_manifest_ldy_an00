+    }
+    Action oldRecordUnlinked(Object record,boolean removed,Context context,long now) {
+        if(state!=State.UNLINKING_OLD) return Action.NONE;
+        if(!current(context,now) || record!=expected.record || !removed || !old.reclaimed(reservation))
+            return stop();
+        freshReadFloor=freshState.successfulResponses();
+        readToken=new Object();state=State.READING_FRESH;return Action.READ_FRESH;
+    }
+    Action readsCompleted(Object token,Object handle,Context context,String actualEid,
+            boolean targetProfileObserved,long now) {
+        if(state!=State.READING_FRESH || token!=readToken) return Action.NONE;
+        if(!current(context,now) || handle!=freshHandle
+                || old.state()!=HonorScopedChannelState.State.RETIRED
+                || freshState.state()!=HonorScopedChannelState.State.OPEN
