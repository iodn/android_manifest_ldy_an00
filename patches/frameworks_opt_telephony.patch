+package com.android.internal.telephony.uicc;
+import android.os.*;
+import com.android.internal.telephony.CommandException;
+/** Real scoped implementation; deterministic modem callbacks, not a modem allocation claim. */
+public final class HonorReadOpenErrorHostTest {
+    static int checks;
+    static void check(boolean v){checks++;if(!v)throw new AssertionError("check "+checks);}
+    static final class Fixture {
+        final UiccPort port=new UiccPort();
+        final HonorScopedReclamationAsyncHostTest.Client client=new HonorScopedReclamationAsyncHostTest.Client();
+        final HonorScopedReclamationAsyncHostTest.Sink sink=new HonorScopedReclamationAsyncHostTest.Sink();
+        final HonorScopedApduChannel channel=new HonorScopedApduChannel(port,port.profile,1,port.ci,port.card,client);
+        Fixture(){Handler.reset();channel.open("A0000005591010FFFFFFFF8900000100",0,sink.next());}
+        void failed(){port.profile.deliver(1,null,new CommandException());}
+        int code(){return sink.last();}
+    }
+    public static void main(String[] args) {
+        var f=new Fixture();f.failed();
+        check(f.code()==HonorScopedApduChannel.READ_OPEN_FAILED);
+        check(f.sink.results.get(f.sink.results.size()-1).channel==-1 && f.sink.results.get(f.sink.results.size()-1).data==null);
+        check(f.port.profile.opens==1 && f.port.profile.commands.isEmpty() && f.port.profile.closed.isEmpty());
+        int replies=f.sink.results.size();
+        f.port.profile.lastDelivered.sendToTarget();Handler.runReady();
+        check(f.sink.results.size()==replies); // duplicate native callback cannot become a new request.
+
+        f.channel.close(f.sink.next());Handler.runReady();check(f.code()==HonorScopedApduChannel.UNKNOWN);
+        check(f.port.profile.closed.isEmpty());
+        // The old object cannot retry or reuse an integer; a fresh request can open independently.
+        f.channel.open("A0000005591010FFFFFFFF8900000100",0,f.sink.next());Handler.runReady();
+        check(f.port.profile.opens==1);
+        var fresh=new HonorScopedApduChannel(f.port,f.port.profile,1,f.port.ci,f.port.card,f.client);
+        fresh.open("A0000005591010FFFFFFFF8900000100",0,f.sink.next());
+        f.port.profile.deliver(1,new int[]{1},null);
+        check(f.code()==HonorScopedApduChannel.OPENED && f.port.profile.opens==2);
+        f=new Fixture();Handler.advance(60_000);f.failed();check(f.code()==HonorScopedApduChannel.UNKNOWN);
+        f=new Fixture();f.channel.unknown();f.failed();check(f.code()==HonorScopedApduChannel.UNKNOWN);
+        f=new Fixture();f.port.epoch++;f.failed();check(f.code()==HonorScopedApduChannel.UNKNOWN);
+        f=new Fixture();f.port.currentProfile=new UiccProfile();f.failed();check(f.code()==HonorScopedApduChannel.UNKNOWN);
+        f=new Fixture();f.port.profile.deliver(1,null,new RuntimeException());check(f.code()==HonorScopedApduChannel.UNKNOWN);
+        f=new Fixture();f.port.profile.deliver(1,new int[]{0},new CommandException());check(f.code()==HonorScopedApduChannel.UNKNOWN);
+        f=new Fixture();f.port.profile.deliver(1,"mixed payload",new CommandException());check(f.code()==HonorScopedApduChannel.UNKNOWN);
+        f=new Fixture();f.channel.close(f.sink.next());f.failed();check(f.code()==HonorScopedApduChannel.UNKNOWN);
+        f=new Fixture();f.channel.transmit(new byte[]{0,0,0,0,0},f.sink.next());f.failed();check(f.code()==HonorScopedApduChannel.UNKNOWN);
+        f=new Fixture();f.port.currentCi=new com.android.internal.telephony.CommandsInterface(){};f.failed();check(f.code()==HonorScopedApduChannel.UNKNOWN);
+        f=new Fixture();f.port.currentCard=new UiccCard();f.failed();check(f.code()==HonorScopedApduChannel.UNKNOWN);
+        System.out.println("PASS "+checks+" actual initial READ OPEN error checks");
+    }
+}
