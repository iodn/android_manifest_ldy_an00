+package com.android.internal.telephony.uicc;
+import android.os.*;import com.android.internal.telephony.*;
+import java.util.concurrent.atomic.AtomicBoolean;
+/** Actual update prefix/provenance/state/scoped helper, deterministic platform/native boundaries. */
+public final class HonorIccidRefreshCloseHostTest {
+ static int checks;static void check(boolean value){checks++;if(!value)throw new AssertionError("check "+checks);}
+ static final String EID="12345678901234567890123456789012",ICCID="89123456789012345678";
+ static final class F {
+  final UiccPort port=new UiccPort();final RIL ril=new RIL();
+  final HonorScopedReclamationAsyncHostTest.Client client=new HonorScopedReclamationAsyncHostTest.Client();
+  final HonorScopedReclamationAsyncHostTest.Sink sink=new HonorScopedReclamationAsyncHostTest.Sink();
+  final AtomicBoolean live=new AtomicBoolean(true);final HonorScopedApduChannel old;
+  F(){this(true);}
+  F(boolean capture){
+   Handler.reset();ril.capture=capture;port.currentCi=ril;
+   ril.apdu=(cla,ins,p1,p2,p3,data,es10,result)->
+     port.profile.iccTransmitApduLogicalChannel(3,cla,ins,p1,p2,p3,data,es10,result);
+   old=new HonorScopedApduChannel(port,port.profile,1,ril,port.card,client);
+   old.open("A0000005591010FFFFFFFF8900000100",0,sink.next());port.profile.deliver(1,new int[]{3},null);
+   check(sink.last()==(capture?HonorScopedApduChannel.OPENED:HonorScopedApduChannel.UNKNOWN));
+  }
+  IccCardStatus status(String iccid){IccCardStatus s=new IccCardStatus();s.eid=EID;s.iccid=iccid;return s;}
+  void update(String iccid){port.updateEpoch(ril,status(iccid),port.card);}
+  void positive(boolean updateFirst){
+   old.transmit(new byte[]{(byte)0x80,(byte)0xe2,(byte)0x91,0,0},sink.next());
+   if(updateFirst)update(ICCID);
+   port.profile.deliver(4,new IccIoResult(0x90,0,null),null);
+   check(sink.last()==HonorScopedApduChannel.RESPONSE);
+   if(!updateFirst)update(ICCID);
+  }
+  void prepare(int kind,String eid){old.prepareResetReclamation(new HonorScopedApduChannel.ReclamationRequest(
+    new Object(),new Object(),9,101,7,kind,eid,ICCID,live::get),sink.next());Handler.runReady();}
+  void prepare(int kind){prepare(kind,EID);}
+  void close(){old.close(sink.next());Handler.runReady();}
+ }
+ public static void main(String[]args){
+  for(int kind:new int[]{2,3})for(boolean before:new boolean[]{false,true}){
+   F f=new F();f.positive(before);f.prepare(kind);
+   check(f.sink.last()==HonorScopedApduChannel.NO_RECLAMATION);
+   check(f.port.profile.opens==1);f.close();check(f.sink.last()==HonorScopedApduChannel.CLOSED);
+   check(f.ril.dispatches==1&&f.port.profile.closed.isEmpty()&&f.port.records.isEmpty());
+  }
+  F f=new F();f.positive(false);f.prepare(2);f.ril.waits=2;f.close();
+  check(f.ril.dispatches==0);Handler.advance(100);check(f.ril.dispatches==0);Handler.advance(100);
+  check(f.ril.dispatches==1&&f.sink.last()==HonorScopedApduChannel.CLOSED);
+  Handler.advance(1000);check(f.ril.dispatches==1);
+  for(int fault=0;fault<9;fault++){
+   f=new F();f.positive(false);f.prepare(2);f.ril.waits=1;f.close();check(f.ril.dispatches==0);
+   switch(fault){
+    case 0 -> f.update("89222222222222222222");
+    case 1 -> f.port.currentCard=new UiccCard();
+    case 2 -> f.port.currentProfile=new UiccProfile();
+    case 3 -> f.client.alive=false;
+    case 4 -> f.live.set(false);
+    case 5 -> f.ril.refuse=true;
+    case 6 -> f.port.records.clear();
+    case 7 -> f.port.available=false;
+    case 8 -> f.ril.radioState=android.telephony.TelephonyManager.RADIO_POWER_UNAVAILABLE;
+   }
+   Handler.advance(100);check(f.ril.dispatches==0&&f.sink.last()==
+      (fault==2?HonorScopedApduChannel.RETIRED:HonorScopedApduChannel.UNKNOWN));
+  }
+  // No transmit authority is restored by close-only preparation.
+  f=new F();f.positive(true);f.prepare(3);int commands=f.port.profile.commands.size();
+  f.old.transmit(new byte[]{0,0,0,0,0},f.sink.next());Handler.runReady();
+  check(f.sink.last()==HonorScopedApduChannel.UNKNOWN&&f.port.profile.commands.size()==commands&&f.ril.dispatches==0);
+  for(int fault=0;fault<8;fault++){
+   f=new F();f.old.transmit(new byte[]{(byte)0x80,(byte)0xe2,(byte)0x91,0,0},f.sink.next());
