+/* Copyright (C) 2026 The LineageOS Project. SPDX-License-Identifier: Apache-2.0 */
+package com.android.internal.telephony.uicc;
+
+/** Actual scoped bridge state. A retired generation is never a target for a native close. */
+final class HonorScopedChannelState {
+    enum Generation { CURRENT, DISPOSED, CHANGED }
+    enum State { NEW, OPENING, OPEN, TRANSMITTING, CLOSING, CLOSED, RETIRED, UNQUALIFIED, RECLAIMING, UNKNOWN }
+    private State state=State.NEW;
+    private Object pending;
+    private long successfulResponses;
+    private boolean disposed,changed,closeAttempted;
+    synchronized State state() { return state; }
+    synchronized long successfulResponses() {return successfulResponses;}
+    private void observe(Generation generation) {
+        disposed|=generation==Generation.DISPOSED;
+        changed|=generation!=Generation.CURRENT;
+    }
+    private Object begin(State from,State to,Generation generation) {
+        observe(generation);
+        if(state!=from || disposed || changed || pending!=null) return null;
+        pending=new Object();state=to;return pending;
+    }
+    synchronized Object open(Generation generation) { return begin(State.NEW,State.OPENING,generation); }
+    synchronized Object transmit(Generation generation) { return begin(State.OPEN,State.TRANSMITTING,generation); }
+    /** null means no native close: caller reads RETIRED/CLOSED versus refusal separately. */
+    synchronized Object close(Generation generation) {
+        closeAttempted=true;
+        observe(generation);
+        if((state==State.OPEN || state==State.UNQUALIFIED) && pending==null && disposed) {
+            state=State.RETIRED;return null;
+        }
+        return begin(State.OPEN,State.CLOSING,generation);
+    }
+    private boolean owns(Object token,State expected) { return token!=null && token==pending && state==expected; }
+    synchronized boolean opened(Object token,Generation generation,boolean positive) {
+        if(!owns(token,State.OPENING)) return false;
+        observe(generation);pending=null;
+        if(!positive || changed) {state=State.UNKNOWN;return false;}
+        state=State.OPEN;return true;
+    }
+    /** A matching final APDU response may be delivered from the captured old generation.
+     * Further APDUs are refused; only disposal can qualify a later non-dispatch retirement. */
+    synchronized boolean transmitted(Object token,Generation generation,boolean positive) {
+        if(!owns(token,State.TRANSMITTING)) return false;
+        observe(generation);pending=null;
+        if(!positive) {state=State.UNKNOWN;return false;}
+        successfulResponses++;
+        state=disposed ? State.RETIRED : changed ? State.UNQUALIFIED : State.OPEN;
+        return true;
+    }
+    synchronized boolean closed(Object token,Generation generation,boolean positive) {
+        if(!owns(token,State.CLOSING)) return false;
+        observe(generation);pending=null;
+        if(!positive || changed && !disposed) {state=State.UNKNOWN;return false;}
+        state=disposed ? State.RETIRED : State.CLOSED;return true;
+    }
+    /** A genuine later port epoch change, observed after the final APDU, never a synthetic reset. */
+    synchronized boolean observeResetRetirement() {
+        if(state!=State.OPEN || pending!=null || disposed || closeAttempted || successfulResponses==0) return false;
+        changed=true;state=State.UNQUALIFIED;return true;
+    }
