+                fail ? RadioCapability.RC_STATUS_FAIL : RadioCapability.RC_STATUS_SUCCESS);
+        Message reply = Message.obtain(replies.getValue());
+        AsyncResult.forMessage(reply, response, null);
+        reply.sendToTarget();
+        processAllMessages();
+    }
+
+    private void startResponses() {
