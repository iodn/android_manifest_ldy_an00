+    }
+    /** Caller has a genuine fresh allocation of the same ID and unlinked the exact old record. */
+    synchronized boolean reclaimed(Object token) {
+        if(!owns(token,State.RECLAIMING) || disposed || closeAttempted) return false;
+        pending=null;state=State.RETIRED;return true;
+    }
