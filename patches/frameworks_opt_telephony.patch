+/* Copyright (C) 2026 The LineageOS Project. SPDX-License-Identifier: Apache-2.0 */
+package com.android.internal.telephony.uicc;
+
+/** Actual scoped bridge state. A retired generation is never a target for a native close. */
+final class HonorScopedChannelState {
+    enum Generation { CURRENT, DISPOSED, CHANGED }
+    enum State { NEW, OPENING, OPEN, TRANSMITTING, CLOSING, CLOSED, OPEN_FAILED, RETIRED, UNQUALIFIED, RECLAIMING, UNKNOWN }
+    private State state=State.NEW;
+    private Object pending;
+    private long successfulResponses;
+    private boolean disposed,changed,closeAttempted;
+    synchronized State state() { return state; }
+    /** Caller holds exact port-disposal provenance; this never dispatches a channel close. */
+    synchronized boolean retireDisposedAfterResponse() {
+        if(state!=State.OPEN || pending!=null || closeAttempted || successfulResponses==0)
+            return false;
+        observe(Generation.DISPOSED);state=State.RETIRED;return true;
+    }
+    synchronized boolean retiredWithoutClose() {
+        return state==State.RETIRED && pending==null && disposed && !closeAttempted
+                && successfulResponses>0;
+    }
+    synchronized long successfulResponses() {return successfulResponses;}
+    private void observe(Generation generation) {
+        disposed|=generation==Generation.DISPOSED;
+        changed|=generation!=Generation.CURRENT;
+    }
+    private Object begin(State from,State to,Generation generation) {
+        observe(generation);
+        if(state!=from || disposed || changed || pending!=null) return null;
+        pending=new Object();state=to;return pending;
+    }
+    synchronized Object open(Generation generation) { return begin(State.NEW,State.OPENING,generation); }
+    synchronized Object transmit(Generation generation) { return begin(State.OPEN,State.TRANSMITTING,generation); }
+    /** null means no native close: caller reads RETIRED/CLOSED versus refusal separately. */
+    synchronized Object close(Generation generation) {
+        closeAttempted=true;
+        observe(generation);
+        if((state==State.OPEN || state==State.UNQUALIFIED) && pending==null && disposed) {
+            state=State.RETIRED;return null;
+        }
+        return begin(State.OPEN,State.CLOSING,generation);
+    }
+    /** Close-only continuation after exact ICCID provenance and allocation ownership checks. */
+    synchronized Object closeAfterIccidRefresh(Generation generation) {
+        if(generation!=Generation.CURRENT || (state!=State.OPEN && state!=State.UNQUALIFIED)
+                || pending!=null || disposed || closeAttempted || successfulResponses==0) return null;
+        closeAttempted=true;
+        changed=false; // No OPEN/transmit state is restored; this token permits only final CLOSE.
+        pending=new Object();state=State.CLOSING;return pending;
+    }
+    /** Exact positive step plus a consumed later RESET witness; never remote close proof. */
+    synchronized boolean retireExpectedRefresh() {
+        if((state!=State.OPEN && state!=State.UNQUALIFIED) || pending!=null
+                || disposed || closeAttempted || successfulResponses==0) return false;
+        changed=true;state=State.RETIRED;return true;
+    }
+    /** Caller proves the exact guarded CLOSE has never entered native dispatch. */
+    synchronized boolean retireUndispatchedCloseForRefresh(Object token) {
+        if(!owns(token,State.CLOSING) || disposed || successfulResponses==0) return false;
+        changed=true;pending=null;state=State.RETIRED;return true;
+    }
+    /** Exact close callback is still local/undispatched; disposal needs no modem integer close. */
+    synchronized boolean retireUndispatchedCloseForDisposal(Object token) {
+        if(!owns(token,State.CLOSING) || successfulResponses==0) return false;
+        observe(Generation.DISPOSED);pending=null;state=State.RETIRED;return true;
+    }
+    private boolean owns(Object token,State expected) { return token!=null && token==pending && state==expected; }
+    synchronized boolean opened(Object token,Generation generation,boolean positive) {
+        if(!owns(token,State.OPENING)) return false;
+        observe(generation);pending=null;
+        if(!positive || changed) {state=State.UNKNOWN;return false;}
+        state=State.OPEN;return true;
+    }
+    /** A matched initial OPEN error ended this request, without exposing a usable channel. */
+    synchronized boolean openFailed(Object token,Generation generation) {
+        if(!owns(token,State.OPENING) || generation!=Generation.CURRENT || disposed || changed
+                || closeAttempted || successfulResponses!=0)
+            return false;
+        pending=null;state=State.OPEN_FAILED;return true;
+    }
+    /** A matching final APDU response may be delivered from the captured old generation.
+     * Further APDUs are refused; only disposal can qualify a later non-dispatch retirement. */
+    synchronized boolean transmitted(Object token,Generation generation,boolean positive) {
+        if(!owns(token,State.TRANSMITTING)) return false;
+        observe(generation);pending=null;
+        if(!positive) {state=State.UNKNOWN;return false;}
+        successfulResponses++;
+        state=disposed ? State.RETIRED : changed ? State.UNQUALIFIED : State.OPEN;
+        return true;
+    }
+    /** Retire only a correlated terminal close response after a proved same-card refresh.
+     * This releases local ownership and does not assert that the modem closed the channel.
+     */
+    synchronized boolean retireCompletedRefreshClose(Object token,Generation generation) {
+        if(!owns(token,State.CLOSING) || generation!=Generation.CURRENT || disposed
+                || !closeAttempted || successfulResponses==0) return false;
+        pending=null;changed=true;state=State.RETIRED;return true;
+    }
+    synchronized boolean closed(Object token,Generation generation,boolean positive) {
+        if(!owns(token,State.CLOSING)) return false;
+        observe(generation);pending=null;
+        if(!positive || changed && !disposed) {state=State.UNKNOWN;return false;}
+        state=disposed ? State.RETIRED : State.CLOSED;return true;
+    }
+    /** A genuine later port epoch change, observed after the final APDU, never a synthetic reset. */
+    synchronized boolean observeResetRetirement() {
+        if(state!=State.OPEN || pending!=null || disposed || closeAttempted || successfulResponses==0) return false;
+        changed=true;state=State.UNQUALIFIED;return true;
+    }
+    /** One allocation-only probe before any old close attempt; not a native retry. */
+    synchronized Object reserveReclamation() {
+        if(state!=State.UNQUALIFIED || pending!=null || disposed || !changed || closeAttempted) return null;
+        pending=new Object();state=State.RECLAIMING;return pending;
+    }
+    /** Caller has a genuine fresh allocation of the same ID and unlinked the exact old record. */
+    synchronized boolean reclaimed(Object token) {
+        if(!owns(token,State.RECLAIMING) || disposed || closeAttempted) return false;
+        pending=null;state=State.RETIRED;return true;
+    }
+    synchronized void unknown() { state=State.UNKNOWN; } // Timeout/death never dispatches cleanup.
+}
