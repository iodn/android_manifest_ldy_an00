+        ArgumentCaptor<Handler> handlers = ArgumentCaptor.forClass(Handler.class);
+        ArgumentCaptor<Integer> events = ArgumentCaptor.forClass(Integer.class);
+        verify(mPhone).registerForRadioCapabilityChanged(handlers.capture(), events.capture(), any());
+        mCapabilityHandler = handlers.getValue();
+        mCapabilityEvent = events.getValue();
+    }
+
+    private void configurePhone(Phone phone, int id, String uuid) {
+        doReturn(RAF).when(phone).getRadioAccessFamily();
