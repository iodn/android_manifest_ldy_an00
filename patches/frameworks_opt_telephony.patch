@@ -0,0 +1,93 @@
+package com.android.internal.telephony.uicc;
+import android.os.*;
+import com.android.internal.telephony.*;
+/** Actual port disposal bodies are injected by run-disposal-record-proof-tests.py. */
+public final class HonorDisposalRecordProofHostTest {
+ static int checks;
+ static void check(boolean value){checks++;if(!value)throw new AssertionError("check "+checks);}
+ static HonorScopedReclamationAsyncHostTest.Fixture fresh(){
+  return new HonorScopedReclamationAsyncHostTest.Fixture();
+ }
+ static void finalReply(HonorScopedReclamationAsyncHostTest.Fixture f,int sw){
+  f.respond(sw,0,null);check(f.sink.last()==HonorScopedApduChannel.RESPONSE);
+ }
+ static void transmit(HonorScopedReclamationAsyncHostTest.Fixture f){
+  f.old.transmit(new byte[]{(byte)0x80,(byte)0xe2,(byte)0x91,0,0},f.sink.next());
+ }
+ static void replace(HonorScopedReclamationAsyncHostTest.Fixture f){
+  f.port.dispose();f.port.currentProfile=new UiccProfile();
+ }
+ static HonorScopedReclamationAsyncHostTest.Fixture disposed(boolean responseBefore){
+  var f=fresh();transmit(f);
+  if(responseBefore)finalReply(f,0x6f);
+  replace(f);
+  if(!responseBefore)finalReply(f,0x6f);
+  return f;
+ }
+ static void denied(HonorScopedReclamationAsyncHostTest.Fixture f,int kind){
+  f.begin(kind);Handler.runReady();
+  check(f.sink.last()==HonorScopedApduChannel.UNKNOWN);
+  check(f.port.profile.closed.isEmpty() && f.port.profile.opens==1);
+ }
+ public static void main(String[] args)throws Exception{
+  for(boolean before:new boolean[]{false,true})for(int kind:new int[]{2,3}){
+   var f=disposed(before);
+   check(f.port.records.isEmpty() && f.oldRecord.request.binder==null);
+   check(f.port.honorRecordRetiredByDisposal(f.oldRecord,f.port.profile,1,f.port.ci,f.port.card,2));
+   f.begin(kind);Handler.runReady();check(f.sink.last()==HonorScopedApduChannel.NO_RECLAMATION);
+   f.old.close(f.sink.next());Handler.runReady();check(f.sink.last()==HonorScopedApduChannel.RETIRED);
+   check(f.port.profile.closed.isEmpty() && f.port.profile.opens==1 && f.port.profile.commands.size()==1);
+   f.old.transmit(new byte[]{0,0,0,0,0},f.sink.next());Handler.runReady();
+   check(f.sink.last()==HonorScopedApduChannel.UNKNOWN && f.port.profile.commands.size()==1);
+  }
+  var f=disposed(true);f.port.epoch++;denied(f,2);
+  f=disposed(false);f.port.currentCi=new CommandsInterface(){};denied(f,2);
+  f=disposed(false);f.port.currentCard=new UiccCard();denied(f,3);
+  f=disposed(false);f.port.available=false;denied(f,2);
+  f=disposed(false);f.port.physicalSlot=0;denied(f,3);
+  f=disposed(false);f.port.portIndex=1;denied(f,2);
+  f=disposed(false);f.client.alive=false;denied(f,2);
+  f=disposed(false);f.grantLive.set(false);denied(f,3);
+  f=disposed(false);f.stepLive.set(false);denied(f,2);
+  f=disposed(false);f.old.close(f.sink.next());Handler.runReady();denied(f,2);
+  // Generic bookkeeping removal does not mint disposal provenance.
+  f=fresh();transmit(f);f.port.removeHonorChannelRecord(f.oldRecord);
+  replace(f);finalReply(f,0x6f);
+  check(!f.port.honorRecordRetiredByDisposal(f.oldRecord,f.port.profile,1,f.port.ci,f.port.card,2));
+  denied(f,2);
+  f=fresh();transmit(f);f.port.onLogicalChannelClosed(3);
+  replace(f);finalReply(f,0x6f);denied(f,2);
+  f=fresh();transmit(f);
+  var genericCleanup=UiccPort.class.getDeclaredMethod("cleanupOpenLogicalChannelRecordsIfNeeded");
+  genericCleanup.setAccessible(true);genericCleanup.invoke(f.port);
+  replace(f);finalReply(f,0x6f);denied(f,3);
+  f=fresh();transmit(f);f.port.epoch++;replace(f);finalReply(f,0x6f);denied(f,2);
+  // A failed unlink cannot supply positive retirement evidence even when the list is emptied.
+  f=fresh();transmit(f);f.client.recipients.clear();replace(f);finalReply(f,0x6f);denied(f,3);
+  // A foreign live record prevents the empty-port retirement path.
+  f=disposed(false);
+  IccLogicalChannelRequest request=new IccLogicalChannelRequest();request.channel=8;request.binder=f.client;
+  try{f.port.registerHonorChannelRecord(f.port.new OpenLogicalChannelRecord(request));}
+  catch(RemoteException failure){throw new AssertionError(failure);}
+  denied(f,2);
+  f=disposed(false);
+  request=new IccLogicalChannelRequest();request.channel=9;request.binder=f.client;
+  check(!f.port.honorRecordRetiredByDisposal(f.port.new OpenLogicalChannelRecord(request),
+    f.port.profile,1,f.port.ci,f.port.card,2));
+  // No final callback: disposal alone cannot qualify an in-flight APDU.
+  f=fresh();transmit(f);replace(f);denied(f,2);
+  // No final APDU at all: an arbitrary OPEN handle cannot claim a known completed mutation.
+  f=fresh();replace(f);denied(f,3);
+  // A genuine late final callback after timeout cannot undo UNKNOWN.
+  f=fresh();transmit(f);Handler.advance(60_001);replace(f);
+  f.respond(0x6f,0,null);denied(f,2);
+  HonorScopedChannelState state=new HonorScopedChannelState();
+  Object token=state.open(HonorScopedChannelState.Generation.CURRENT);
+  check(state.opened(token,HonorScopedChannelState.Generation.CURRENT,true));
+  token=state.transmit(HonorScopedChannelState.Generation.CURRENT);
+  check(state.transmitted(token,HonorScopedChannelState.Generation.CHANGED,true));
+  check(!state.retireDisposedAfterResponse()); // UNQUALIFIED is not this disposal-only path.
+  state.unknown();check(!state.retireDisposedAfterResponse());
+  System.out.println("PASS "+checks+" actual dispose/provenance/scoped async checks; no modem proof");
+ }
+}
