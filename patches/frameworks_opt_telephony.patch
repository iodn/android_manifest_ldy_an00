+        final HonorScopedChannelState freshState=new HonorScopedChannelState();
+        final Object fresh=new Object();
+        HonorChannelReclamation model;
+        Fixture() {
+            Object opened=old.open(HonorScopedChannelState.Generation.CURRENT);
+            check(old.opened(opened,HonorScopedChannelState.Generation.CURRENT,true));
+            Object transmit=old.transmit(HonorScopedChannelState.Generation.CURRENT);
+            check(old.transmitted(transmit,HonorScopedChannelState.Generation.CHANGED,true));
+            check(old.state()==HonorScopedChannelState.State.UNQUALIFIED);
+            model=new HonorChannelReclamation(old,context(10),4,1000);
+        }
+        HonorChannelReclamation.Context context(long serial) {return context(refs,1,serial,1,0,2,TEST_ONLY_EID,true,true,true,true,true,true);}
+        HonorChannelReclamation.Context context(Object[] r,long epoch,long serial,int slot,int port,int card,
+                String eid,boolean mode,boolean ready,boolean positive,boolean one,boolean closed,boolean alive) {
