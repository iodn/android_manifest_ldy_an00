index 0000000000000000000000000000000000000000..97a402b4a332f095b6dd20007c8570fc7d538f28
--- /dev/null
+++ b/src/java/com/android/internal/telephony/HonorLogicalChannelOwnership.java
@@ -0,0 +1,236 @@
+/* Copyright (C) 2026 The LineageOS Project. SPDX-License-Identifier: Apache-2.0 */
+package com.android.internal.telephony;
+
+import java.util.HashMap;
+import java.util.IdentityHashMap;
+import java.util.Map;
+
+/** RIL-local allocation provenance. Callers serialize dispatch and completion on this object. */
+final class HonorLogicalChannelOwnership {
+    enum Close { WAIT, REFUSED, DISPATCHED }
+    enum Retirement { WAIT, REFUSED, RETIRED }
+    static final class RefreshBoundary {
+        final Receipt receipt;
+        final Object safety;
+        final long reset,nativeReset;
+        boolean consumed;
+        RefreshBoundary(Receipt receipt,Object safety,long reset,long nativeReset) {
+            this.receipt=receipt;this.safety=safety;this.reset=reset;this.nativeReset=nativeReset;
+        }
+    }
+    static final class Receipt {
+        final Object epoch, allocation;
+        boolean retired;
+        final int channel, serial;
+        Receipt(Object epoch, Object allocation, int channel, int serial) {
+            this.epoch=epoch;this.allocation=allocation;this.channel=channel;this.serial=serial;
+        }
+    }
+    private static final class Pending {
+        final boolean open, reset;
+        final int channel, serial;
+        final Object epoch;
+        Pending(boolean open,boolean reset,int channel,int serial,Object epoch) {
+            this.open=open;this.reset=reset;this.channel=channel;this.serial=serial;this.epoch=epoch;
+        }
+    }
+    private static final int MAX_PENDING=64;
+    private Object epoch=new Object();
+    private boolean uncertain;
+    private Object refreshSafety=new Object();
+    private long refreshReset,nativeReset;
+    // Kept across allocation-epoch retirement until the exact final radio callback drains.
+    private final Map<Object,Integer> refreshPending=new IdentityHashMap<>();
+    private void dispatched(Object request,int serial) {
+        if(request==null || refreshPending.containsKey(request)
+                || refreshPending.size()>=MAX_PENDING) {
+            unsafeRefresh();return;
+        }
+        refreshPending.put(request,serial);
+    }
+    private void drained(Object request,int serial) {
+        Integer expected=refreshPending.get(request);
+        if(expected!=null && expected==serial) refreshPending.remove(request);
+    }
+    void unsafeRefresh() {refreshSafety=new Object();refreshPending.clear();retiredPending.clear();}
+    void simRefresh(int result) {
+        if(result==2) {nativeReset++;applicationRefresh();}
+        else if(result==1) {unsafeRefresh();invalidate();}
+    }
+    // A verified local app reset retires allocation provenance, but is not a native RESET.
+    void applicationRefresh() {
+        refreshReset++;
+        retireAllocationEpoch();
+    }
+    /** RF availability retires local allocation authority, not proof of a card RESET. */
+    void radioPowerChanged() {
+        boolean wasUncertain=uncertain;
+        retireAllocationEpoch();
+        uncertain|=wasUncertain;
+    }
+    private void retireAllocationEpoch() {
+        if(retiredPending.size()+pending.size()>MAX_PENDING) {unknown();return;}
+        Map<Object,Pending> retiring=new IdentityHashMap<>(retiredPending);
+        retiring.putAll(pending);
+        invalidate();
+        retiredPending.putAll(retiring);
+    }
+    RefreshBoundary refreshBoundary(Receipt receipt) {
+        return current(receipt) ? new RefreshBoundary(receipt,refreshSafety,refreshReset,nativeReset) : null;
+    }
+    Retirement retirementStatus(Receipt receipt,RefreshBoundary boundary) {
+        if(receipt==null || boundary==null || boundary.receipt!=receipt || receipt.retired
+                || boundary.consumed || boundary.safety!=refreshSafety || uncertain)
+            return Retirement.REFUSED;
+        // A safe radio power transition also retires the captured allocation epoch.
+        // This is local retirement; no modem-close success is inferred.
+        return (refreshReset==boundary.reset && receipt.epoch==epoch) || !refreshPending.isEmpty()
+                ? Retirement.WAIT : Retirement.RETIRED;
+    }
+    Retirement expectedResetStatus(Receipt receipt,RefreshBoundary boundary) {
+        Retirement status=retirementStatus(receipt,boundary);
+        return status!=Retirement.REFUSED && nativeReset==boundary.nativeReset ? Retirement.WAIT : status;
+    }
+    Retirement retire(Receipt receipt,RefreshBoundary boundary) {
+        Retirement status=retirementStatus(receipt,boundary);
+        if(status!=Retirement.RETIRED) return status;
+        boundary.consumed=true;receipt.retired=true;
+        if(allocated.get(receipt.channel)==receipt.allocation) allocated.remove(receipt.channel);
+        responses.entrySet().removeIf(x->x.getValue()==receipt);
+        return Retirement.RETIRED;
+    }
+    private final Map<Object,Pending> pending=new IdentityHashMap<>();
+    // Terminal provenance survives known epoch retirement; it never authorizes an old allocation.
+    private final Map<Object,Pending> retiredPending=new IdentityHashMap<>();
+    private final Map<Integer,Object> allocated=new HashMap<>();
+    private final Map<int[],Receipt> responses=new IdentityHashMap<>();
+
+    void opening(Object request,int serial) {
+        dispatched(request,serial);
+        if(uncertain) return;
+        if(request==null || pending.containsKey(request) || retiredPending.containsKey(request)
+                || pending.size()+retiredPending.size()>=MAX_PENDING) {unknown();return;}
+        pending.put(request,new Pending(true,false,-1,serial,epoch));
+    }
+    void closing(Object request,int serial,int channel) {
+        dispatched(request,serial);
+        if(uncertain) return;
+        if(request==null || pending.containsKey(request) || retiredPending.containsKey(request)
+                || pending.size()+retiredPending.size()>=MAX_PENDING) {unknown();return;}
+        allocated.remove(channel);
+        responses.entrySet().removeIf(x->x.getValue().channel==channel);
+        pending.put(request,new Pending(false,false,channel,serial,epoch));
+    }
+    void resetting(Object request,int serial) {
+        unsafeRefresh();
+        invalidate();
+        dispatched(request,serial);
+        pending.put(request,new Pending(false,true,-1,serial,epoch));
+    }
+    // OPEN returns channel ID first; trailing SELECT bytes do not allocate a channel.
+    private static boolean negativeWithoutAllocation(Object response) {
+        return response==null || response instanceof int[] raw && (raw.length==0
+                || (raw[0]==0 || raw[0]==-1));
+    }
+    /** Called only by the actual OPEN response entry, including an unmatched/late serial. */
+    void openCompleted(Object request,int serial,boolean success,Object response) {
+        Pending step=pending.get(request);
+        if(step!=null && step.open && step.epoch==epoch && step.serial==serial) {
+            completed(request,serial,success,response);
+        } else if(retiredPending.containsKey(request) && retiredPending.get(request).open
+                && retiredPending.get(request).serial==serial) {
+            retiredPending.remove(request);drained(request,serial);
+            revokeOpenResult(success,response);
+        } else if(success || !negativeWithoutAllocation(response)) {
+            unknown(); // A late allocation cannot be silently ignored after a reset/new OPEN.
+        }
+    }
+    /** Called only by actual CLOSE/SIM-power response entries, never generic void responses. */
+    void mutationCompleted(Object request,int serial,boolean success,boolean reset) {
+        Pending step=pending.get(request);
+        Pending retired=retiredPending.get(request);
+        if(step!=null && !step.open && step.reset==reset && step.epoch==epoch
+                && step.serial==serial) {
+            completed(request,serial,success,null);
+        } else if(retired!=null && !retired.open && retired.reset==reset
+                && retired.serial==serial) {
+            retiredPending.remove(request);drained(request,serial);
+            if(reset) {
+                if(success) retireAllocationEpoch();else unknown();
+            } else revokeChannel(retired.channel);
+        } else if(success) {
+            unknown();
+        }
+    }
+    void completed(Object request,int serial,boolean success,Object response) {
+        Pending step=pending.get(request);
+        if(step==null || step.epoch!=epoch || step.serial!=serial) return;
+        drained(request,serial);pending.remove(request);
+        if(step.reset) {if(success) retireAllocationEpoch();else unknown();return;}
+        if(!step.open) {
+            // Any accepted close might have released this ID, including a delayed completion.
+            revokeChannel(step.channel);
+            return;
+        }
+        if(!success) {
+            // A matched failed OPEN never grants authority, even if its returned ID is usable.
+            revokeOpenResult(false,response);
+            return;
+        }
+        if(!(response instanceof int[] raw) || raw.length==0 || raw[0]<1 || raw[0]>19) {
+            unknown();return;
+        }
+        if(uncertain || pending.values().stream().anyMatch(x->x.reset
+                || !x.open && x.channel==raw[0])
+                || retiredPending.values().stream().anyMatch(x->x.reset || x.open
+                    || x.channel==raw[0])) return;
+        Object allocation=new Object();
+        responses.entrySet().removeIf(x->x.getValue().channel==raw[0]);
+        allocated.put(raw[0],allocation);
+        responses.put(raw,new Receipt(epoch,allocation,raw[0],step.serial));
+    }
+    /** A known terminal OPEN names at most one affected ID, never a new close authority. */
+    private void revokeOpenResult(boolean success,Object response) {
+        if(response instanceof int[] raw && raw.length>0 && raw[0]>=1 && raw[0]<=19) {
+            revokeChannel(raw[0]);
+        } else if(success || !negativeWithoutAllocation(response)) {
+            unknown();
+        }
+    }
+    private void revokeChannel(int channel) {
+        allocated.remove(channel);
+        responses.entrySet().removeIf(x->x.getValue().channel==channel);
+    }
+    Receipt capture(int[] exactResponse) {
+        Receipt receipt=responses.remove(exactResponse);
+        return current(receipt) ? receipt : null;
+    }
+    boolean current(Receipt receipt) {
+        return !uncertain && receipt!=null && !receipt.retired && receipt.epoch==epoch
+                && allocated.get(receipt.channel)==receipt.allocation;
+    }
+    Close closeStatus(Receipt receipt) {
+        if(!current(receipt)) return Close.REFUSED;
+        return pending.isEmpty() ? Close.DISPATCHED : Close.WAIT;
+    }
+    boolean guardedClose(Receipt receipt,Object request,int serial) {
+        if(closeStatus(receipt)!=Close.DISPATCHED) return false;
+        closing(request,serial,receipt.channel);
+        return true;
+    }
+    void abandoned(Object request,int serial) {
+        Integer outstanding=refreshPending.get(request);
+        Pending step=pending.get(request),retired=retiredPending.get(request);
+        if(outstanding!=null && outstanding==serial || step!=null && step.serial==serial
+                || retired!=null && retired.serial==serial) unknown();
+    }
+    String diagnosticState() {
+        return "uncertain="+uncertain+" pending="+pending.size()
+                +" retiredPending="+retiredPending.size()+" allocated="+allocated.size()
+                +" responses="+responses.size()+" refreshPending="+refreshPending.size();
+    }
+    void unknown() {unsafeRefresh();invalidate();uncertain=true;}
+    void invalidate() {
+        epoch=new Object();pending.clear();retiredPending.clear();allocated.clear();responses.clear();uncertain=false;
+    }
+}
