+/* Copyright (C) 2026 The LineageOS Project. SPDX-License-Identifier: Apache-2.0 */
+package com.android.internal.telephony.uicc;
+
+import android.os.AsyncResult;
+import android.os.Handler;
+import android.os.IBinder;
+import android.os.Message;
+import com.android.internal.telephony.IccLogicalChannelRequest;
+
+/** Phone-local captured port/profile/record. No raw current-slot integer cleanup is used. */
+public final class HonorScopedApduChannel {
+    public static final int UNKNOWN=0,OPENED=1,CLOSED=2,RETIRED=3,RESPONSE=4,RECLAIMED=5,NO_RECLAMATION=6;
+    public static final class Outcome {
+        public final int code,channel;
+        public final byte[] data;
+        Outcome(int code,int channel,byte[] data) {this.code=code;this.channel=channel;this.data=data;}
+    }
+    private static final long TIMEOUT_MS=60_000;
+    private final UiccPort port;
+    private final UiccProfile profile;
+    private final long epoch;
+    private final IBinder client;
+    private final com.android.internal.telephony.CommandsInterface ci;
+    private final UiccCard card;
+    private Reclamation reclamation,openReclamation;
+    private final HonorScopedChannelState state=new HonorScopedChannelState();
+    private UiccPort.OpenLogicalChannelRecord record;
+    private int channel=-1,openP2=-1;
+    private String openAid;
+    private Call active;
+    private ResetPreparation resetPreparation;
+    HonorScopedApduChannel(UiccPort port,UiccProfile profile,long epoch,
+            com.android.internal.telephony.CommandsInterface ci,UiccCard card,IBinder client) {
+        this.port=port;this.profile=profile;this.epoch=epoch;this.ci=ci;this.card=card;this.client=client;
+    }
+    private static void reply(Message target,Outcome value) {
+        AsyncResult.forMessage(target,value,null);target.sendToTarget();
+    }
+    private final class Call {
+        final int kind;
+        final Object token;
+        final Message target;
+        final Handler events;
+        boolean finished;
+        Runnable timeout;
+        Call(int kind,Object token,Message target) {
+            this.kind=kind;this.token=token;this.target=target;
+            events=new Handler(target.getTarget().getLooper());
+        }
+        Message callback() {
+            Handler callback=new Handler(target.getTarget().getLooper()) {
+                @Override public void handleMessage(Message message) { completed(Call.this,message); }
+            };
+            Message result=callback.obtainMessage(kind,this);
+            timeout=()->{
+                synchronized(HonorScopedApduChannel.this) {
+                    if(finished) return;
+                    state.unknown();finish(new Outcome(UNKNOWN,channel,null));
+                }
+            };
+            if(!events.postDelayed(timeout,TIMEOUT_MS)) {state.unknown();finish(new Outcome(UNKNOWN,channel,null));return null;}
+            return result;
+        }
+        void finish(Outcome outcome) {
+            if(finished) return;finished=true;
+            if(timeout!=null) events.removeCallbacks(timeout);
+            if(active==this) active=null;
+            reply(target,outcome);
+        }
+    }
+    private void refuse(Message response) {reply(response,new Outcome(UNKNOWN,channel,null));}
+    void open(String aid,int p2,Message response) {
+        port.withHonorChannel(profile,epoch,null,generation->{
+            synchronized(this) {
+                Object token=state.open(generation);
+                if(token==null || client==null || !client.isBinderAlive()) {state.unknown();refuse(response);return null;}
+                openAid=aid;openP2=p2;
+                Call call=new Call(OPENED,token,response);active=call;
+                try {Message callback=call.callback();if(callback!=null)profile.iccOpenLogicalChannel(aid,p2,callback);}
+                catch(RuntimeException failure) {state.unknown();call.finish(new Outcome(UNKNOWN,channel,null));}
+                return null;
