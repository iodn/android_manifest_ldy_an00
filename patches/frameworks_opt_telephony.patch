@@ -0,0 +1,16 @@
+/* Copyright (C) 2026 The LineageOS Project. SPDX-License-Identifier: Apache-2.0 */
+package com.android.internal.telephony.uicc;
+
+/** LPAC50cdf15 interface.c uses a five-byte header and uint8_t Lc/Le, no extended APDUs. */
+final class HonorShortApdu {
+    final int cla,ins,p1,p2,p3;
+    final String data;
+    HonorShortApdu(byte[] command) {
+        if(command==null || command.length<4 || command.length>260) throw new IllegalArgumentException("Unsupported APDU size");
+        cla=command[0]&255;ins=command[1]&255;p1=command[2]&255;p2=command[3]&255;
+        p3=command.length>4 ? command[4]&255 : -1;
+        if(command.length>5 && (p3==0 || command.length!=5+p3))
+            throw new IllegalArgumentException("Extended, malformed or case-4 APDU unsupported");
+        data=command.length>5 ? java.util.HexFormat.of().withUpperCase().formatHex(command,5,command.length) : null;
+    }
+}
