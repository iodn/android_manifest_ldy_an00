+  if(r!=receipt||b!=boundary||unsafe||consumed)return HonorRetirementResult.REFUSED;
+  return !reset||pending>0?HonorRetirementResult.WAIT:HonorRetirementResult.RETIRED;
+ }
+ public HonorRetirementResult honorLogicalChannelExpectedResetStatus(HonorLogicalChannelReceipt r,HonorRefreshBoundary b){
+  return honorLogicalChannelRetirementStatus(r,b);
+ }
+ public HonorRetirementResult consumeHonorLogicalChannelRetirement(HonorLogicalChannelReceipt r,HonorRefreshBoundary b){
+  var value=honorLogicalChannelRetirementStatus(r,b);
+  if(value==HonorRetirementResult.RETIRED){consumed=true;retirements++;}
+  return value;
+ }
+ public interface Apdu {void send(int cla,int ins,int p1,int p2,int p3,String data,boolean es10,Message result);}
+ public Apdu apdu;
+ public boolean transmitHonorLogicalChannel(HonorLogicalChannelReceipt given,int cla,int ins,int p1,int p2,
+    int p3,String data,boolean es10,Message result){
+  if(given!=receipt||!capture||refuse)return false;
+  apdu.send(cla,ins,p1,p2,p3,data,es10,result);return true;
+ }
+ public boolean deferClose;public Message deferredClose;
+ public boolean capture,refuse;public int waits,dispatches,calls;
+ public int radioState=android.telephony.TelephonyManager.RADIO_POWER_ON;
+ public int getRadioState(){return radioState;}
+ private final HonorLogicalChannelReceipt receipt=new HonorLogicalChannelReceipt();
+ public HonorLogicalChannelReceipt captureHonorLogicalChannelReceipt(int[] exact){return capture?receipt:null;}
+ public HonorCloseResult honorLogicalChannelCloseStatus(HonorLogicalChannelReceipt given){
+  if(refuse||given!=receipt)return HonorCloseResult.REFUSED;
+  return waits>0?HonorCloseResult.WAIT:HonorCloseResult.DISPATCHED;
+ }
+ public HonorCloseResult closeHonorLogicalChannel(HonorLogicalChannelReceipt given,boolean es10,Message result){
+  calls++;if(refuse||given!=receipt)return HonorCloseResult.REFUSED;
+  if(waits-->0)return HonorCloseResult.WAIT;
+  dispatches++;if(deferClose){deferredClose=result;return HonorCloseResult.DISPATCHED;}
+  AsyncResult.forMessage(result,null,null);result.sendToTarget();return HonorCloseResult.DISPATCHED;
+ }
