+                "matched restored DDS keeps its original consented data state");
+        check(!PhoneFactory.phones[0].data.enabled,
+                "after return the other plan follows ordinary default-data policy");
+        System.out.println("PASS actual automatic-disable body: " + checks + " checks");
+    }
