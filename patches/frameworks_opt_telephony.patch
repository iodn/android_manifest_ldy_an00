+        cases++;f=returned();f.begin(3);f.old.close(f.sink.next());unknown(f);f.port.epoch++;Handler.advance(100);none(f);
+        cases++;f=returned();f.begin(3);f.old.unknown();unknown(f);int count2=f.sink.results.size();
+        f.old.unknown();Handler.advance(60_000);check(f.sink.results.size()==count2);
