+++ b/tests/host/com/android/internal/telephony/uicc/HonorRefreshResetRetirementHostTest.java
@@ -0,0 +1,107 @@
+package com.android.internal.telephony.uicc;
+import android.os.*;import com.android.internal.telephony.*;
+/** Real Scoped/State and extracted Port guards; central RESET model is separately tested. */
+public final class HonorRefreshResetRetirementHostTest {
+ static int checks;static void check(boolean b){checks++;if(!b)throw new AssertionError("check "+checks);}
+ static HonorIccidRefreshCloseHostTest.F fresh(){
+  var f=new HonorIccidRefreshCloseHostTest.F();f.ril.boundaryEnabled=true;f.positive(false);return f;
+ }
+ public static void main(String[]args){
+  for(int kind:new int[]{2,3}){
+   var f=fresh();f.ril.refuse=true;f.ril.pending=1;f.prepare(kind);
+   check(f.port.profile.opens==1&&f.ril.dispatches==0&&f.ril.retirements==0);
+   Handler.advance(100);check(f.port.profile.opens==1);
+   f.ril.reset=true;Handler.advance(100);check(f.ril.retirements==0);
+   f.ril.pending=0;Handler.advance(100);
+   check(f.sink.last()==HonorScopedApduChannel.NO_RECLAMATION&&f.ril.retirements==1);
+   f.close();check(f.sink.last()==HonorScopedApduChannel.RETIRED&&f.port.records.isEmpty());
+   check(f.ril.dispatches==0&&f.port.profile.closed.isEmpty()&&f.port.profile.opens==1);
+  }
+  for(int count:new int[]{1,2}){
+   var f=fresh();
+   for(int i=0;i<count;i++)check(f.port.resetAppWithAid("",true));
+   f.ril.refuse=true;f.ril.reset=true;f.prepare(2);
+   check(f.sink.last()==HonorScopedApduChannel.NO_RECLAMATION);
+   f.close();check(f.sink.last()==HonorScopedApduChannel.RETIRED);
+   check(f.port.records.isEmpty()&&f.ril.dispatches==0&&f.ril.retirements==1);
+  }
+  {
+   var f=fresh();long epoch=f.port.epoch;
+   f.port.currentProfile.refreshChanged=false;
+   check(!f.port.resetAppWithAid("",true));check(f.port.epoch==epoch);
+  }
+  {
+   var f=new HonorIccidRefreshCloseHostTest.F();f.ril.boundaryEnabled=true;
+   f.old.transmit(new byte[]{(byte)0x80,(byte)0xe2,(byte)0x91,0,0},f.sink.next());
+   f.port.profile.deliver(4,new IccIoResult(0x90,0,null),null);
+   check(f.port.resetAppWithAid("",true));
+   f.update(HonorIccidRefreshCloseHostTest.ICCID);
+   f.ril.refuse=true;f.ril.reset=true;f.prepare(2);
+   check(f.sink.last()==HonorScopedApduChannel.NO_RECLAMATION);
+   f.close();check(f.sink.last()==HonorScopedApduChannel.RETIRED);
+  }
+  // ICCID first cannot publish readiness or dispatch old CLOSE before queued RESET.
+  var f=fresh();f.prepare(2);
+  check(f.sink.last()!=HonorScopedApduChannel.NO_RECLAMATION&&f.ril.dispatches==0);
+  Handler.advance(100);check(f.ril.retirements==0&&f.port.profile.opens==1);
+  f.ril.reset=true;f.ril.pending=1;Handler.advance(100);
+  check(f.ril.retirements==0);f.ril.pending=0;Handler.advance(100);
+  check(f.sink.last()==HonorScopedApduChannel.NO_RECLAMATION&&f.ril.retirements==1);
+  f.close();check(f.sink.last()==HonorScopedApduChannel.RETIRED&&f.ril.dispatches==0);
+  for(int fault=0;fault<9;fault++){
+   f=fresh();f.ril.refuse=true;f.prepare(2);
+   switch(fault){
+    case 0 -> f.live.set(false);
+    case 1 -> f.client.alive=false;
+    case 2 -> f.port.currentCard=new UiccCard();
+    case 3 -> f.port.currentCi=new CommandsInterface(){};
+    case 4 -> f.port.currentProfile=new UiccProfile();
+    case 5 -> f.ril.unsafe=true;
+    case 6 -> f.ril.radioState=android.telephony.TelephonyManager.RADIO_POWER_UNAVAILABLE;
+    case 7 -> f.update("89222222222222222222");
+    case 8 -> f.port.records.clear();
+   }
+   f.ril.reset=true;Handler.advance(100);
+   check(f.ril.retirements==0&&f.ril.dispatches==0);
+  }
+  // A missing/replaced profile also cannot publish before the queued RESET drains.
+  for(boolean absent:new boolean[]{false,true}) {
+   f=fresh();f.port.currentProfile=absent ? null : new UiccProfile();
+   f.prepare(2);check(f.sink.last()!=HonorScopedApduChannel.NO_RECLAMATION);
+   check(f.ril.dispatches==0&&f.port.profile.opens==1);
+   f.ril.reset=true;Handler.advance(100);
+   check(f.sink.last()==HonorScopedApduChannel.NO_RECLAMATION&&f.ril.dispatches==0);
+  }
+  // No RESET / INIT-only equivalent never retires or allocates a speculative probe.
+  f=fresh();f.ril.refuse=true;f.prepare(3);Handler.advance(60000);
+  check(f.sink.last()==HonorScopedApduChannel.UNKNOWN&&f.ril.retirements==0&&f.port.profile.opens==1);
+  // In-flight transmit cannot prepare even with a RESET witness.
+  f=new HonorIccidRefreshCloseHostTest.F();f.ril.boundaryEnabled=true;
+  f.old.transmit(new byte[]{0,0,0,0,0},f.sink.next());f.ril.reset=true;f.prepare(2);
+  check(f.sink.last()==HonorScopedApduChannel.UNKNOWN&&f.ril.retirements==0);
+  // Wrong kind retains existing fail-closed behavior.
+  f=fresh();f.ril.refuse=true;f.ril.reset=true;f.prepare(4);
+  check(f.sink.last()==HonorScopedApduChannel.UNKNOWN&&f.ril.retirements==0);
+  // A native CLOSE already dispatched with lost callback cannot be reclassified as retirement.
+  f=new HonorIccidRefreshCloseHostTest.F();f.positive(false);f.prepare(2);f.ril.deferClose=true;f.close();check(f.ril.dispatches==1);
+  f.ril.reset=true;f.ril.refuse=true;Handler.advance(60000);
+  check(f.sink.last()==HonorScopedApduChannel.UNKNOWN&&f.ril.retirements==0);
+  // A RESET arriving during this exact pending command can qualify only its positive final result.
+  f=new HonorIccidRefreshCloseHostTest.F();f.ril.boundaryEnabled=true;
+  f.old.transmit(new byte[]{(byte)0x80,(byte)0xe2,(byte)0x91,0,0},f.sink.next());
+  f.ril.reset=true;f.port.profile.deliver(4,new IccIoResult(0x90,0,null),null);
+  f.update(HonorIccidRefreshCloseHostTest.ICCID);f.ril.refuse=true;f.prepare(2);
+  check(f.sink.last()==HonorScopedApduChannel.NO_RECLAMATION&&f.ril.retirements==1);
+  f.close();int commands=f.port.profile.commands.size();
+  f.old.transmit(new byte[]{0,0,0,0,0},f.sink.next());Handler.runReady();
+  check(f.sink.last()==HonorScopedApduChannel.UNKNOWN&&f.port.profile.commands.size()==commands);
+  // A newly accepted command discards the earlier positive boundary before dispatch.
+  f=new HonorIccidRefreshCloseHostTest.F();f.ril.boundaryEnabled=true;
+  f.old.transmit(new byte[]{0,0,0,0,0},f.sink.next());
+  f.port.profile.deliver(4,new IccIoResult(0x90,0,null),null);
+  f.old.transmit(new byte[]{0,0,0,0,0},f.sink.next());
+  f.ril.reset=true;f.port.profile.deliver(4,null,new RuntimeException());f.prepare(2);
+  check(f.sink.last()==HonorScopedApduChannel.UNKNOWN&&f.ril.retirements==0);
+  System.out.println("PASS "+checks+" actual Scoped/State/Port RESET retirement checks; RIL boundary doubled");
+ }
+}
diff --git a/tests/host/com/android/internal/telephony/uicc/HonorScopedChannelStateHostTest.java b/tests/host/com/android/internal/telephony/uicc/HonorScopedChannelStateHostTest.java
