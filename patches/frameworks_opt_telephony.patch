+package com.android.internal.telephony.uicc;
+
+public final class HonorScopedChannelStateHostTest {
+ static int checks;
+ static void ok(boolean value) {if(!value)throw new AssertionError();checks++;}
+ static void bad(Runnable action) {try{action.run();throw new AssertionError();}catch(IllegalArgumentException expected){checks++;}}
+ static HonorScopedChannelState opened() {
+  var state=new HonorScopedChannelState();Object token=state.open(HonorScopedChannelState.Generation.CURRENT);
+  ok(token!=null);ok(state.opened(token,HonorScopedChannelState.Generation.CURRENT,true));return state;
+ }
+ public static void main(String[] args) {
+  var current=HonorScopedChannelState.Generation.CURRENT;var disposed=HonorScopedChannelState.Generation.DISPOSED;var changed=HonorScopedChannelState.Generation.CHANGED;
+  var state=opened();Object call=state.transmit(current);ok(call!=null);ok(state.transmitted(call,current,true));
+  Object close=state.close(current);ok(close!=null);ok(state.closed(close,current,true));ok(state.state()==HonorScopedChannelState.State.CLOSED);
+  for(var generation:new HonorScopedChannelState.Generation[]{changed,disposed}) {
+   state=new HonorScopedChannelState();call=state.open(current);ok(!state.opened(call,generation,true));
+   ok(state.state()==HonorScopedChannelState.State.UNKNOWN);ok(state.close(current)==null); // No helpful stale-open close.
+  }
+  state=opened();call=state.transmit(current);ok(state.transmitted(call,disposed,true));
+  ok(state.state()==HonorScopedChannelState.State.RETIRED);ok(state.close(disposed)==null); // No native dispatch.
+  state=opened();call=state.transmit(current);ok(state.transmitted(call,changed,true));
+  ok(state.state()==HonorScopedChannelState.State.UNQUALIFIED);ok(state.close(changed)==null);
+  ok(state.state()!=HonorScopedChannelState.State.RETIRED);ok(state.transmit(current)==null); // Availability again cannot restore epoch.
+  state=new HonorScopedChannelState();call=state.open(current);state.unknown();ok(!state.opened(call,current,true));ok(state.close(disposed)==null);
+  state=opened();call=state.transmit(current);state.unknown();ok(!state.transmitted(call,disposed,true));ok(state.state()==HonorScopedChannelState.State.UNKNOWN);
+  var old=opened();close=old.close(current);ok(old.closed(close,current,true));var fresh=opened();
+  old.unknown(); // Already-delivered old death callback after unlink cannot affect a fresh handle.
+  ok(fresh.state()==HonorScopedChannelState.State.OPEN);ok(fresh.transmit(current)!=null);
+  state=opened();ok(state.transmit(changed)==null);ok(state.close(current)==null); // Remember a past reset even after radio available.
+  state=opened();close=state.close(current);ok(!state.closed(close,changed,true));ok(state.state()==HonorScopedChannelState.State.UNKNOWN);
+  state=new HonorScopedChannelState();call=state.open(current);ok(!state.opened(new Object(),current,true));state.unknown();ok(!state.opened(call,current,true));
+  var store=new HonorShortApdu(new byte[]{(byte)0x80,(byte)0xE2,(byte)0x91,0,3,1,2,3});
+  ok(store.cla==128 && store.ins==226 && store.p1==145 && store.p3==3 && store.data.equals("010203"));
+  var response=new HonorShortApdu(new byte[]{0,(byte)0xC0,0,0,0});ok(response.p3==0 && response.data==null);
+  var noLength=new HonorShortApdu(new byte[]{0,0,0,0});ok(noLength.data==null && noLength.p3==-1);
+  byte[] max=new byte[260];max[4]=(byte)255;ok(new HonorShortApdu(max).p3==255);
+  bad(()->new HonorShortApdu(new byte[]{0,0,0}));bad(()->new HonorShortApdu(new byte[261]));
+  bad(()->new HonorShortApdu(new byte[]{0,0,0,0,0,1,0})); // Extended length is rejected before dispatch.
+  bad(()->new HonorShortApdu(new byte[]{0,0,0,0,2,1})); // Truncated Lc.
+  bad(()->new HonorShortApdu(new byte[]{0,0,0,0,1,1,0})); // Unsupported case-4/extra byte.
+  System.out.println("HONOR_SCOPED_CHANNEL_HOST_PASS checks="+checks);
+ }
+}
