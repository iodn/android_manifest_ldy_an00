+public interface IRadio {
+    void setRadioCapability(int serial,RadioCapability capability) throws android.os.RemoteException;
+}""")
+    put("com/android/internal/telephony/RadioCapability.java", """package com.android.internal.telephony;
+public final class RadioCapability {
