+    private static boolean needsHonorEndpointPreparation(int command) {
+        return command == CMD_GET_EID || command == CMD_GET_EUICC_PROFILE_INFO_LIST
+                || command == CMD_DOWNLOAD_SUBSCRIPTION || command == CMD_DELETE_SUBSCRIPTION
+                || command == CMD_SWITCH_TO_SUBSCRIPTION || command == CMD_UPDATE_SUBSCRIPTION_NICKNAME;
+    }
+
+    private static int honorPreparationPort(Message command) {
+        if (command.what == CMD_HONOR_PREPARE_ONLY) return command.arg2;
+        if (command.what == CMD_SWITCH_TO_SUBSCRIPTION) {
+            SwitchRequest request = (SwitchRequest) command.obj;
+            return request.mUsePortIndex ? command.arg2 : 0;
+        }
+        if (command.what == CMD_DOWNLOAD_SUBSCRIPTION) {
+            int port = ((DownloadRequest) command.obj).mPortIndex;
+            return port == -1 ? TelephonyManager.DEFAULT_PORT_INDEX : port; // Legacy unspecified port only.
         }
+        return 0;
+    }
