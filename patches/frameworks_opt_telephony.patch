+        if ("0".equals(uuid) || "1".equals(uuid)) uuid = "modem_ps" + uuid;
+        RadioCapability response = new RadioCapability(request.getPhoneId(), request.getSession(),
+                RadioCapability.RC_PHASE_UNSOL_RSP, request.getRadioAccessFamily(), uuid,
+                fail ? RadioCapability.RC_STATUS_FAIL : RadioCapability.RC_STATUS_SUCCESS);
+        mCapabilityHandler.obtainMessage(mCapabilityEvent,
+                new AsyncResult(null, response, null)).sendToTarget();
+        processAllMessages();
+    }
+
+    private void finishResponses(boolean fail) {
+        replyToLast(mPhone, fail);
+        replyToLast(mPhone2, fail);
+    }
