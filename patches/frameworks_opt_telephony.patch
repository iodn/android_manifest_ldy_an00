+#!/usr/bin/env python3
+"""Test the actual outgoing method and generated AIDL parcelable on a host JVM.
+
+Parcel and radio endpoints are deterministic host adapters. No Binder driver,
+modem library, Android process or device is contacted.
+"""
+import argparse
+import hashlib
+import json
+import re
+import shutil
+import subprocess
+from pathlib import Path
+
+
+def method(source, signature):
+    start = source.index(signature)
+    opening = source.index("{", start)
+    depth = 1
+    end = opening + 1
+    while depth:
+        depth += (source[end] == "{") - (source[end] == "}")
+        end += 1
+    return source[start:end]
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--framework-base", type=Path, required=True)
+    parser.add_argument("--hardware-interfaces", type=Path, required=True)
+    parser.add_argument("--telephony-enums", type=Path, required=True)
+    parser.add_argument("--generated-modem-aidl", type=Path, required=True)
+    parser.add_argument("--jdk", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    root = Path(__file__).resolve().parents[2]
+    sources = root / "src/java/com/android/internal/telephony"
+    proxy = sources / "RadioModemProxy.java"
+    ril = sources / "RILUtils.java"
+    # A mutation control recreates the observed missing-conversion defect even after commit.
+    signature = "public void setRadioCapability(int serial, RadioCapability rc)"
+    new_method = method(proxy.read_text(), signature)
+    old_method = new_method.replace(
+        "RILUtils.convertToHalRadioAccessFamilyAidl(rc.getRadioAccessFamily())",
+        "rc.getRadioAccessFamily()", 1)
+    if old_method == new_method:
+        raise AssertionError("Required AIDL conversion is missing")
+    converters = [
+        method(ril.read_text(), "public static int convertToHalRadioAccessFamilyAidl("),
+        method(ril.read_text(), "public static int convertHalNetworkTypeBitMask("),
+        method(ril.read_text(), "public static String convertNullToEmptyString("),
+    ]
+    tm_file = args.framework_base / "telephony/java/android/telephony/TelephonyManager.java"
+    tm = tm_file.read_text()
+    network_types = dict(re.findall(r"public static final int NETWORK_TYPE_(\w+)\s*=\s*(\d+)\s*;", tm))
+    network_types.update(dict(re.findall(r"NETWORK_TYPE_(\w+)\s*=\s*(\d+)\s*;", args.telephony_enums.read_text())))
+    needed = sorted(set(re.findall(r"NETWORK_TYPE_BITMASK_(\w+)", "\n".join(converters))))
+    tm_fields = "\n".join(
+        "public static final long NETWORK_TYPE_BITMASK_%s = 1L << (%s - 1);" % (name, network_types[name])
+        for name in needed
+    )
+    technology_file = args.hardware_interfaces / "radio/aidl/android/hardware/radio/RadioTechnology.aidl"
+    technology_body = re.sub(r"/\*.*?\*/", "", technology_file.read_text(), flags=re.S)
+    technology_body = technology_body.split("enum RadioTechnology {", 1)[1].split("}", 1)[0]
+    technologies = {}
+    next_value = 0
+    for entry in technology_body.split(","):
+        entry = entry.strip()
+        if not entry:
+            continue
+        match = re.fullmatch(r"(\w+)(?:\s*=\s*(\d+))?", entry)
+        if not match:
+            raise ValueError("Unsupported RadioTechnology enum entry: " + entry)
+        if match.group(2):
+            next_value = int(match.group(2))
+        technologies[match.group(1)] = str(next_value)
+        next_value += 1
+    raf_file = args.hardware_interfaces / "radio/aidl/android/hardware/radio/RadioAccessFamily.aidl"
+    rafs = re.findall(r"^\s*(\w+)\s*=\s*1\s*<<\s*RadioTechnology\.(\w+)", raf_file.read_text(), re.M)
+    raf_fields = "\n".join(
+        "public static final int %s = 1 << %s;" % (name, technologies[technology])
+        for name, technology in rafs
+    )
+    source_dir = args.output / "src"
+    source_dir.mkdir(parents=True, exist_ok=True)
+
+    def put(name, value):
+        target = source_dir / name
+        target.parent.mkdir(parents=True, exist_ok=True)
+        target.write_text(value)
+
+    put("android/telephony/TelephonyManager.java",
+        "package android.telephony; public class TelephonyManager {"
+        "public @interface NetworkTypeBitMask {} public static final int NETWORK_TYPE_UNKNOWN=0;"
+        + tm_fields + "}")
+    put("android/telephony/ServiceState.java",
+        "package android.telephony; public class ServiceState {"
+        "public static final int RIL_RADIO_TECHNOLOGY_IWLAN=" + technologies["IWLAN"] + ";}")
+    put("android/hardware/radio/RadioAccessFamily.java",
+        "package android.hardware.radio; public class RadioAccessFamily {" + raf_fields + "}")
+    for version in ("V1_0", "V1_4"):
+        put("android/hardware/radio/" + version + "/RadioAccessFamily.java",
+            "package android.hardware.radio." + version + "; public class RadioAccessFamily"
+            " extends android.hardware.radio.RadioAccessFamily {}")
+    put("android/os/RemoteException.java",
+        "package android.os; public class RemoteException extends Exception {}")
+    put("android/os/BadParcelableException.java",
+        "package android.os; public class BadParcelableException extends RuntimeException {"
+        "public BadParcelableException(String value) {super(value);}}")
+    put("android/os/Parcelable.java", """package android.os;
+public interface Parcelable {
+    int PARCELABLE_STABILITY_VINTF=1;
+    int getStability();
+    void writeToParcel(Parcel parcel,int flags);
+    int describeContents();
+    interface Creator<T> {T createFromParcel(Parcel parcel);T[] newArray(int size);}
+}""")
+    put("android/os/Parcel.java", """package android.os;
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.nio.charset.StandardCharsets;
+public final class Parcel {
+    private final ByteBuffer data=ByteBuffer.allocate(4096).order(ByteOrder.LITTLE_ENDIAN);
+    private int size;
+    public int dataPosition() {return data.position();}
+    public void setDataPosition(int position) {data.position(position);}
+    public void writeInt(int value) {data.putInt(value);size=Math.max(size,data.position());}
+    public int readInt() {return data.getInt();}
+    public void writeString(String value) {
+        if(value==null) {writeInt(-1);return;}
+        writeInt(value.length());
+        data.put(value.getBytes(StandardCharsets.UTF_16LE));data.putShort((short)0);
+        while((data.position()&3)!=0)data.put((byte)0);
+        size=Math.max(size,data.position());
+    }
+    public String readString() {
+        int length=readInt();if(length<0)return null;
+        byte[] bytes=new byte[length*2];data.get(bytes);data.getShort();
+        while((data.position()&3)!=0)data.get();
+        return new String(bytes,StandardCharsets.UTF_16LE);
+    }
+    public byte[] marshall() {return java.util.Arrays.copyOf(data.array(),size);}
+}""")
+    generated = args.generated_modem_aidl / "RadioCapability.java"
+    destination = source_dir / "android/hardware/radio/modem/RadioCapability.java"
+    destination.parent.mkdir(parents=True, exist_ok=True)
+    shutil.copyfile(generated, destination)  # Exact generated code, not a hand-written serializer.
+    put("android/hardware/radio/modem/IRadioModem.java", """package android.hardware.radio.modem;
+public interface IRadioModem {
+    void setRadioCapability(int serial,RadioCapability capability) throws android.os.RemoteException;
+}""")
+    put("android/hardware/radio/V1_0/RadioCapability.java", """package android.hardware.radio.V1_0;
