+package com.android.internal.telephony.uicc;
+import android.os.*;import java.util.*;import com.android.internal.telephony.*;
+final class UiccPort {
+ final UiccProfile profile=new UiccProfile();final CommandsInterface ci=new CommandsInterface(){};final UiccCard card=new UiccCard();
+ long epoch=1;boolean available=true,disposed;UiccProfile currentProfile=profile;CommandsInterface currentCi=ci;UiccCard currentCard=card;final ArrayList<OpenLogicalChannelRecord> records=new ArrayList<>();
+ class OpenLogicalChannelRecord implements IBinder.DeathRecipient{final IccLogicalChannelRequest request;OpenLogicalChannelRecord(IccLogicalChannelRequest r){request=r;}public void binderDied(){throw new AssertionError("legacy raw integer close forbidden");}}
+ synchronized <T>T withHonorChannel(UiccProfile p,long e,OpenLogicalChannelRecord r,java.util.function.Function<HonorScopedChannelState.Generation,T> fn){
+  return fn.apply(disposed||p!=profile?HonorScopedChannelState.Generation.DISPOSED:epoch!=e||!available||r!=null&&!records.contains(r)?HonorScopedChannelState.Generation.CHANGED:HonorScopedChannelState.Generation.CURRENT);}
+ synchronized void registerHonorChannelRecord(OpenLogicalChannelRecord r)throws RemoteException{r.request.binder.linkToDeath(r,0);records.add(r);}
+ synchronized boolean removeHonorChannelRecord(OpenLogicalChannelRecord r){if(!records.remove(r))return false;r.request.binder.unlinkToDeath(r,0);r.request.binder=null;return true;}
+ void prepareHonorReclamation(HonorScopedApduChannel old,HonorScopedApduChannel.ReclamationRequest r,Message response){HonorScopedApduChannel.Reclamation work;
+  synchronized(this){work=old.prepareReclamation(this,disposed?null:currentProfile,epoch,currentCi,currentCard,1,0,records.size()==1&&records.contains(old.reclamationRecord()),r,response);}if(work!=null)work.start();}
+ synchronized boolean honorReclamationCurrent(UiccProfile p,CommandsInterface c,UiccCard card,long e){return !disposed&&available&&p==currentProfile&&c==currentCi&&card==currentCard&&e==epoch;}
+ synchronized boolean finishHonorReclamation(HonorScopedApduChannel old,HonorScopedApduChannel.ReclamationRequest request,int serial){return old.finishReclamationLocked(request,serial);}
+}
