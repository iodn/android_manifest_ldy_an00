+    private static boolean isDeleteCommandCurrent(Message command) {
+        if (command.what != CMD_DELETE_SUBSCRIPTION) return true;
+        DeleteRequest request = (DeleteRequest) command.obj;
+        return request.mCurrent == null || request.mCurrent.getAsBoolean();
+    }
