+        int getDefaultDataSubId() { return dds; }
+        SubscriptionInfoInternal getSubscriptionInfoInternal(int sub) {
+            return new SubscriptionInfoInternal();
+        }
+        boolean shouldPreserveDataEnabledForSharedRoute(int sub) {
+            return authority.shouldPreserveDataEnabled(sub, target, 101);
+        }
+    }
+    static final class Controller {
+        final Service mSubscriptionManagerService;
+        final Context mContext = new Context();
+        Controller(Service service) { mSubscriptionManagerService = service; }
+        boolean isReadyToReevaluate() { return true; }
+        boolean areSubscriptionsInSameGroup(int first, int second) { return false; }
+        void log(String text) {}
+__AUTOMATIC_DISABLE_BODY__
+    }
+
+    public static void main(String[] args) {
+        Service service = new Service();
+        service.authority.recordExplicitSelection(2);
+        var token = service.authority.preservePhysicalSim2(
+                service.authority.snapshot(), 2, 2, "card-a", service.target, 100, 1000, () -> {});
