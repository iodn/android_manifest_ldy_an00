+        check(diagnostics.contains("profileSame=false") && diagnostics.contains("singleRecord=false"));
+        check(!diagnostics.contains(HonorScopedReclamationAsyncHostTest.EID)
+                && !diagnostics.contains(HonorScopedReclamationAsyncHostTest.ICCID)
