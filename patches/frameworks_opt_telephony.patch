+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.internal.telephony.euicc;
+
+import android.app.Application;
+import android.os.Build;
+import android.os.Process;
+import android.os.SELinux;
+import android.os.SystemProperties;
+import java.util.function.BooleanSupplier;
+import java.util.function.Consumer;
+
+/** One in-process Phone-owned restoration hook. No Binder service, radio client or lease. */
+public final class HonorEuiccEndpointPreparation {
+    public enum Result { NO_HISTORY, READY, REFUSED }
+    public interface Restorer {
+        void prepare(int cardId, int port, int selectedLpaUid, BooleanSupplier requestCurrent,
+                Consumer<Result> reply);
+    }
+    private static volatile Restorer restorer;
+
+    private HonorEuiccEndpointPreparation() {}
+
+    static boolean isQualifiedDevice() {
+        return "LDY-AN00".equals(Build.MODEL) && "ldy_an00".equals(Build.DEVICE)
+                && SystemProperties.getBoolean("ro.lineage.ldy_an00.esim_bridge", false);
+    }
+
+    /** Installed once by the already-qualified real Owner, never by binding or a UI snapshot. */
+    public static synchronized void install(Restorer provider) {
+        if (!isQualifiedDevice() || Process.myUid() != 1001
+                || !"com.android.phone".equals(Application.getProcessName())
+                || !"u:r:radio:s0".equals(SELinux.getContext()))
+            throw new SecurityException("Phone radio process required");
+        if (restorer != null || provider == null)
+            throw new IllegalStateException("Endpoint restorer already installed or invalid");
+        restorer = provider;
+    }
+
+    static void prepare(int cardId, int port, int selectedLpaUid, BooleanSupplier requestCurrent,
+            Consumer<Result> reply) {
+        Restorer current = restorer;
+        if (current == null) {
+            reply.accept(Result.NO_HISTORY);
+            return;
+        }
+        try {
+            current.prepare(cardId, port, selectedLpaUid, requestCurrent, reply);
+        } catch (RuntimeException refused) {
+            reply.accept(Result.REFUSED);
+        }
+    }
+}
