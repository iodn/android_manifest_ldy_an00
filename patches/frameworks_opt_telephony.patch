+#!/usr/bin/env python3
+# Copyright (C) 2026 The LineageOS Project
+# SPDX-License-Identifier: Apache-2.0
+"""Exercise the actual process-owned authority and verify the complete setter classification."""
+import os
+import re
+from pathlib import Path
+import subprocess
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[2]
+production = ROOT / "src/java/com/android/internal/telephony/subscription"
+controller = (ROOT / "src/java/com/android/internal/telephony/MultiSimSettingController.java").read_text()
+service = (production / "SubscriptionManagerService.java").read_text()
+# The sole direct explicit call is the USER-data-enable branch. Automatic default selection,
+# converted-profile fallback and saved-preference restoration are distinct from a new user choice.
+assert controller.count("mSubscriptionManagerService.setDefaultDataSubId(") == 1
+assert "SETTING_USER_PREF_DATA_SUB, subId);\n            mSubscriptionManagerService.setDefaultDataSubId(subId);" in controller
+assert controller.count("mSubscriptionManagerService.setDefaultDataSubIdAutomatically(") == 6
+assert controller.count("mSubscriptionManagerService::setDefaultDataSubIdAutomatically") == 1
+assert "setDefaultDataSubId(subId, true);" in service
+assert "setDefaultDataSubId(subId, false);" in service
+start = service.index("private void setDefaultDataSubId(int subId, boolean explicit)")
+end = service.index("private void remapRafIfApplicable()", start)
+method = service[start:end]
+assert method.index("enforcePermissions(") < method.index("recordExplicitSelection(")
+assert method.index("enforceTelephonyFeatureWithException(") < method.index("recordExplicitSelection(")
+assert method.index("subId == SubscriptionManager.DEFAULT_SUBSCRIPTION_ID") < method.index("recordExplicitSelection(")
+assert method.index("recordExplicitSelection(") < method.index("mDefaultDataSubId.set(subId)")
+assert "synchronized (mDefaultDataSelectionIntent)" in method
+assert method.index("if (changed)") > method.index("mDefaultDataSubId.set(subId)")
+assert "!mSubscriptionManagerService.shouldPreserveDataEnabledForSharedRoute(" in controller
+# Direct USER writes remain in their original branch. Preservation is only consulted in the
+# existing automatic disable condition, never in DataSettingsManager's user setter.
+disable = controller[controller.index("protected void disableDataForNonDefaultNonOpportunisticSubscriptions()"):
+                     controller.index("private boolean areSubscriptionsInSameGroup")]
+assert disable.index("phone.isUserDataEnabled()") < disable.index("shouldPreserveDataEnabledForSharedRoute")
+assert disable.index("shouldPreserveDataEnabledForSharedRoute") < disable.index("setDataEnabled(")
+assert "DATA_ENABLED_REASON_USER, false" in disable
+restore = service[service.index("public boolean restoreDefaultDataSubIdAfterSharedRoute("):
+                  service.index("private void remapRafIfApplicable()")]
+assert "setDataEnabled(" not in restore and "setUserDataEnabled(" not in restore
+assert method.index("isPreserved(") < method.index("mDefaultDataSubId.set(subId)")
+assert method.index("canRestorePhysicalSim2(") < method.index("mDefaultDataSubId.set(subId)")
