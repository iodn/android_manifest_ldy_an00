+++ b/tests/host/com/android/internal/telephony/subscription/DefaultDataSelectionIntentHostTest.java
@@ -0,0 +1,169 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.internal.telephony.subscription;
+
+public final class DefaultDataSelectionIntentHostTest {
+    private static int checks;
+
+    private static void check(boolean condition, String name) {
+        checks++;
+        if (!condition) throw new AssertionError(name);
+    }
+
+    public static void main(String[] args) throws Exception {
+        var owner = new DefaultDataSelectionIntent();
+        var initial = owner.snapshot();
+        check(initial.generation() == 0 && initial.selectedSubId() == -1,
+                "fresh service makes no explicit choice");
+        check(owner.isCurrent(initial), "same live owner current");
+        check(!owner.isCurrent(null), "absent token rejected");
+        check(!new DefaultDataSelectionIntent().isCurrent(initial),
+                "service recreation cannot inherit authority");
+
+        owner.recordExplicitSelection(2);
+        var chosen = owner.snapshot();
+        check(chosen.selectedSubId() == 2 && chosen.generation() == 1,
+                "explicit request records chosen subscriber");
+        check(!owner.isCurrent(initial), "old generation retired");
+        check(owner.isCurrent(chosen), "fresh explicit authority current");
+        // A later explicit choice is significant even when DDS already equals this value.
+        owner.recordExplicitSelection(2);
+        var sameValue = owner.snapshot();
+        check(sameValue.generation() == 2, "same-value explicit request advances intent");
+        check(!owner.isCurrent(chosen), "same-value override retires older excursion");
+        check(chosen.generation() == 1 && chosen.selectedSubId() == 2,
+                "captured snapshots stay immutable");
+        owner.recordExplicitSelection(1);
+        check(!owner.isCurrent(sameValue), "different-plan choice retires prior authority");
+        check(owner.snapshot().selectedSubId() == 1, "latest explicit plan retained");
+        check(!new DefaultDataSelectionIntent().isCurrent(owner.snapshot()),
+                "matching numeric generations do not cross owners");
+        check(!chosen.toString().contains("2"), "diagnostic omits subscriber");
+
+        var exactTarget = new DefaultDataSelectionIntent.PhysicalTarget(true, false, 1, "card-a");
+        var beforeExcursion = owner.snapshot();
+        check(owner.canRestorePhysicalSim2(beforeExcursion, 1, 1, "card-a", exactTarget),
+                "same physical card and unchanged intent may restore selected data SIM");
+        check(!owner.canRestorePhysicalSim2(beforeExcursion, 2, 1, "card-a", exactTarget),
+                "changed current default refuses compare-and-apply");
+        check(!owner.canRestorePhysicalSim2(beforeExcursion, 1, 1, "card-b", exactTarget),
+                "new physical card never inherits earlier data selection");
+        check(!owner.canRestorePhysicalSim2(beforeExcursion, 1, 1, "card-a",
+                        new DefaultDataSelectionIntent.PhysicalTarget(true, true, 1, "card-a")),
+                "embedded profile cannot inherit physical card data choice");
+        check(!owner.canRestorePhysicalSim2(beforeExcursion, 1, 1, "card-a",
+                        new DefaultDataSelectionIntent.PhysicalTarget(false, false, 1, "card-a")),
+                "inactive returned subscriber is not proof of restoration readiness");
+        check(!owner.canRestorePhysicalSim2(beforeExcursion, 1, 1, "card-a",
+                        new DefaultDataSelectionIntent.PhysicalTarget(true, false, 0, "card-a")),
+                "another physical slot cannot inherit shared-slot data choice");
+        check(!owner.canRestorePhysicalSim2(beforeExcursion, 1, 1, "", exactTarget)
+                        && !owner.canRestorePhysicalSim2(beforeExcursion, 1, 1, null, exactTarget),
+                "missing identity never authorizes restore");
+        check(!owner.canRestorePhysicalSim2(beforeExcursion, 1, 1, "card-a", null),
+                "missing current subscriber refuses restore");
+        owner.recordExplicitSelection(1);
+        check(!owner.canRestorePhysicalSim2(beforeExcursion, 1, 1, "card-a", exactTarget),
+                "later same-default explicit choice wins over saved physical intent");
+        check(!new DefaultDataSelectionIntent().canRestorePhysicalSim2(
+                        beforeExcursion, 1, 1, "card-a", exactTarget),
+                "process loss cannot reconstruct a restoration token");
+
+        var scoped = new DefaultDataSelectionIntent();
+        scoped.recordExplicitSelection(2);
+        var scopedIntent = scoped.snapshot();
+        var hold = scoped.preservePhysicalSim2(scopedIntent, 2, 2, "card-a", exactTarget, 100, 1000, () -> {});
+        check(hold != null, "qualified current physical DDS creates an opaque hold");
+        check(scoped.shouldPreserveDataEnabled(2, exactTarget, 101),
+                "only causal automatic non-default disable is suppressed");
+        check(!scoped.shouldPreserveDataEnabled(1, exactTarget, 101),
+                "another data plan is never protected by the physical token");
+        check(!scoped.shouldPreserveDataEnabled(2,
+                        new DefaultDataSelectionIntent.PhysicalTarget(true, false, 1, "card-b"), 101),
+                "replacement card cannot borrow automatic-disable suppression");
+        check(!scoped.shouldPreserveDataEnabled(2,
+                        new DefaultDataSelectionIntent.PhysicalTarget(true, true, 1, "card-a"), 101),
+                "eSIM profile cannot borrow physical enable-state preservation");
+        check(!scoped.shouldPreserveDataEnabled(2, exactTarget, 1100),
+                "expired hold cannot have indefinite data-toggle effects");
+        check(scoped.preservePhysicalSim2(scopedIntent, 2, 2, "card-a", exactTarget, 101, 1000, () -> {}) == null,
+                "a concurrent caller cannot replace or reuse the live excursion");
+        check(!new DefaultDataSelectionIntent().release(hold),
+                "foreign service cannot release or inherit an opaque token");
+        check(scoped.release(hold), "normal completion or death releases the exact hold");
+        check(!scoped.shouldPreserveDataEnabled(2, exactTarget, 102),
+                "release immediately restores ordinary disable policy");
+        check(!scoped.release(hold), "released token cannot be reused");
+        var afterRelease = scoped.preservePhysicalSim2(
+                scopedIntent, 2, 2, "card-a", exactTarget, 200, 1000, () -> {});
+        check(afterRelease != null && afterRelease != hold, "fresh excursion gets distinct custody");
+        scoped.recordExplicitSelection(2);
+        check(!scoped.shouldPreserveDataEnabled(2, exactTarget, 201),
+                "same-value later explicit selection immediately retires hold effects");
+        check(!scoped.isPreserved(afterRelease, 2, exactTarget, 201),
+                "retired intent cannot authorize restoration");
+        check(!scoped.release(afterRelease), "explicit request already revoked the old hold");
+        check(scoped.preservePhysicalSim2(scopedIntent, 2, 2, "card-a", exactTarget, 202, 1000, () -> {}) == null,
+                "stale intent cannot mint a new hold");
+        var current = scoped.snapshot();
+        check(scoped.preservePhysicalSim2(current, 2, 1, "card-a", exactTarget, 202, 1000, () -> {}) == null,
+                "a prior physical subscriber not currently DDS cannot mint a hold");
+        check(!new DefaultDataSelectionIntent().isPreserved(hold, 2, exactTarget, 203),
+                "service recreation never reconstructs an earlier excursion");
+        var timed = new DefaultDataSelectionIntent();
+        var timedIntent = timed.snapshot();
+        var expired = timed.preservePhysicalSim2(timedIntent, 2, 2, "card-a", exactTarget, 100, 10, () -> {});
+        var renewed = timed.preservePhysicalSim2(timedIntent, 2, 2, "card-a", exactTarget, 110, 10, () -> {});
+        check(renewed != null && renewed != expired, "expired custody cannot block a new qualified scope");
+        check(!timed.release(expired), "late cleanup cannot clear a successor token");
+        check(timed.isPreserved(renewed, 2, exactTarget, 111), "successor authority remains intact");
+        timed.recordExplicitSelection(1);
+        var afterExplicit = timed.preservePhysicalSim2(
+                timed.snapshot(), 2, 2, "card-a", exactTarget, 112, 10, () -> {});
+        check(afterExplicit != null && afterExplicit != renewed,
+                "invalidated custody cannot block fresh current choice");
+        check(!timed.release(renewed), "old explicit-intent cleanup cannot retire a successor");
+
+        var userToggle = new DefaultDataSelectionIntent();
+        userToggle.recordExplicitSelection(2);
+        var beforeToggle = userToggle.snapshot();
+        final int[] retirements = {0};
+        var userHold = userToggle.preservePhysicalSim2(beforeToggle, 2, 2, "card-a",
+                exactTarget, 100, 1000, () -> retirements[0]++);
+        Runnable retire = userToggle.recordExplicitUserDataRequest();
+        check(retire != null && !userToggle.isCurrent(beforeToggle),
+                "USER request retires intent before asynchronous data routing");
+        check(!userToggle.shouldPreserveDataEnabled(2, exactTarget, 101),
+                "USER request immediately removes automatic-disable suppression");
+        check(retirements[0] == 0, "notification is returned for dispatch outside authority lock");
+        retire.run();
+        check(retirements[0] == 1, "exact owned excursion receives the invalidation event");
+        check(userToggle.snapshot().selectedSubId() == 2,
+                "USER toggle is not a fabricated new default-data-SIM selection");
+        check(!userToggle.release(userHold), "retired token cannot be released as a live successor");
+        var currentToggle = userToggle.snapshot();
+        userToggle.recordExplicitUserDataRequest(); // Same-value toggle is still a newer request.
+        check(!userToggle.isCurrent(currentToggle),
+                "same-value USER request cannot be lost just because no callback changes a value");
+
+        // Binder requests may arrive concurrently. Each accepted request must be distinguishable.
+        final var concurrent = new DefaultDataSelectionIntent();
+        Thread[] threads = new Thread[4];
+        for (int i = 0; i < threads.length; i++) {
+            final int sub = i;
+            threads[i] = new Thread(() -> {
+                for (int request = 0; request < 1000; request++) {
+                    concurrent.recordExplicitSelection(sub);
+                }
+            });
+            threads[i].start();
+        }
+        for (Thread thread : threads) thread.join();
+        check(concurrent.snapshot().generation() == 4000,
+                "concurrent same and different value requests retain all generations");
+        check(!concurrent.isCurrent(initial), "unrelated owner token cannot match concurrency result");
+        System.out.println("PASS explicit data intent: " + checks + " checks");
+    }
+}
