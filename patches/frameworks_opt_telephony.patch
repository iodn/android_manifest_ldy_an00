+        PhoneFactory.phones = new Phone[] { new Phone(1, true), new Phone(2, true) };
+        controller.disableDataForNonDefaultNonOpportunisticSubscriptions();
+        check(PhoneFactory.phones[1].data.enabled && PhoneFactory.phones[1].data.writes == 0,
+                "original enabled physical data is not disabled during temporary fallback");
