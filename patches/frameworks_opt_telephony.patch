+    @After
+    public void tearDown() throws Exception {
+        mController = null;
+        super.tearDown();
+    }
+
+    private boolean requestPrimary(int phoneId) {
+        Handler completion = new Handler(mController.mHandler.getLooper(), message -> {
+            AsyncResult result = (AsyncResult) message.obj;
+            assertSame(mCookie, result.userObj);
+            mResults.add((ProxyController.PrimaryCapabilityResult) result.result);
+            return true;
+        });
+        return mController.setPrimaryRadioCapability(phoneId, completion.obtainMessage(1, mCookie));
+    }
+
+    private void assertOutcome(ProxyController.PrimaryCapabilityResult outcome) {
+        assertEquals(1, mResults.size());
+        assertEquals(outcome, mResults.get(0));
+    }
+
+    private RadioCapability lastRequest(Phone phone) {
+        ArgumentCaptor<RadioCapability> requests = ArgumentCaptor.forClass(RadioCapability.class);
+        verify(phone, atLeastOnce()).setRadioCapability(requests.capture(), any());
+        return requests.getValue();
+    }
+
+    private void replyToLast(Phone phone, boolean fail) {
