+#!/usr/bin/env python3
+"""Compile the actual UiccSlot card-status update method against deterministic boundaries."""
+import argparse, subprocess, tempfile
+from pathlib import Path
+parser=argparse.ArgumentParser()
+parser.add_argument("--jdk",required=True,type=Path)
+parser.add_argument("--source",type=Path)
+args=parser.parse_args()
+root=Path(__file__).resolve().parents[2]
+source=args.source or root/"src/java/com/android/internal/telephony/uicc/UiccSlot.java"
+text=source.read_text()
+start=text.index("    public void update(CommandsInterface ci, IccCardStatus ics, int phoneId, int slotIndex)")
+brace=text.index("{",start); end=brace+1; depth=1
+while depth:
+    if text[end]=="{":depth+=1
+    elif text[end]=="}":depth-=1
+    end+=1
+fixture=(root/"tests/host/slot-type-parity-fixture.java.in").read_text()
+with tempfile.TemporaryDirectory(prefix="slot-type-parity-") as temp:
+    path=Path(temp)/"UiccSlot.java"
+    path.write_text(fixture.replace("__ACTUAL_UPDATE__",text[start:end]))
+    subprocess.run([str(args.jdk/"bin/javac"),"-d",temp,str(path)],check=True)
+    subprocess.run([str(args.jdk/"bin/java"),"-cp",temp,"UiccSlot"],check=True)
