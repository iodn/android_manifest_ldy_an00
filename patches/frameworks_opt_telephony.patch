@@ -0,0 +1,127 @@
+/* Copyright (C) 2026 The LineageOS Project. SPDX-License-Identifier: Apache-2.0 */
+package com.android.internal.telephony.uicc;
+
+/** Single-old-handle state used by the captured scoped-channel helper.
+ * Context facts come from the trusted Phone lease/controller; this is not authentication.
+ * Only the fresh captured handle may be closed. No action ever closes the old modem integer.
+ */
+final class HonorChannelReclamation {
+    enum State { NEW, OPENING, UNLINKING_OLD, READING_FRESH, CLOSING_FRESH, RECONCILING, READY, STOP }
+    enum Action { NONE, OPEN_FRESH, UNLINK_EXACT_OLD_RECORD, READ_FRESH, CLOSE_FRESH, RECONCILE, READY, STOP }
+    static final class Context {
+        final Object lease,client,oldHandle,record,port,profile,ci,nativeStep;
+        final long radioEpoch,routeSerial;
+        // operationKind is native ENABLE=2/DISABLE=3/DELETE=4, NOT the outer lease workflow.
+        final int physicalSlot,portIndex,cardId,operationKind;
+        private final String eid;
+        final boolean ownedMode1,readyDefaultPort,positiveResetStep,singleOldHandle,othersClosed,clientAlive;
+        Context(Object lease,Object client,Object oldHandle,Object record,Object port,Object profile,
+                Object ci,Object nativeStep,long radioEpoch,long routeSerial,int physicalSlot,
+                int portIndex,int cardId,String eid,boolean ownedMode1,boolean readyDefaultPort,
+                boolean positiveResetStep,boolean singleOldHandle,boolean othersClosed,boolean clientAlive,int operationKind) {
+            this.lease=lease;this.client=client;this.oldHandle=oldHandle;this.record=record;
+            this.port=port;this.profile=profile;this.ci=ci;this.nativeStep=nativeStep;
+            this.radioEpoch=radioEpoch;this.routeSerial=routeSerial;this.physicalSlot=physicalSlot;
+            this.portIndex=portIndex;this.cardId=cardId;this.eid=eid;this.ownedMode1=ownedMode1;
+            this.readyDefaultPort=readyDefaultPort;this.positiveResetStep=positiveResetStep;
+            this.singleOldHandle=singleOldHandle;this.othersClosed=othersClosed;this.clientAlive=clientAlive;
+            this.operationKind=operationKind;
+        }
+        private boolean valid() {
+            if(lease==null || client==null || oldHandle==null || record==null || port==null
+                    || profile==null || ci==null || nativeStep==null || radioEpoch<=0 || routeSerial<=0
+                    || physicalSlot!=1 || portIndex<0 || cardId<0 || !ownedMode1 || !readyDefaultPort
+                    || operationKind<2 || operationKind>4 || !positiveResetStep || !singleOldHandle || !othersClosed || !clientAlive || eid==null || eid.length()!=32)
+                return false;
+            for(int i=0;i<eid.length();i++) if(eid.charAt(i)<'0' || eid.charAt(i)>'9') return false;
+            return true;
+        }
+        private boolean same(Context other) {
+            return other!=null && valid() && other.valid() && lease==other.lease
+                    && client==other.client && oldHandle==other.oldHandle && record==other.record
+                    && port==other.port && profile==other.profile && ci==other.ci
+                    && nativeStep==other.nativeStep && operationKind==other.operationKind && radioEpoch==other.radioEpoch
+                    && physicalSlot==other.physicalSlot && portIndex==other.portIndex
+                    && cardId==other.cardId && eid.equals(other.eid) && other.routeSerial>=routeSerial;
+        }
+        @Override public String toString() {return "ReclamationContext[identifiers omitted]";}
+    }
+    private final HonorScopedChannelState old;
+    private final Context expected;
+    private final int oldId;
+    private final long deadline;
+    private State state=State.NEW;
+    private Object reservation,openToken,readToken,closeToken,freshHandle;
+    private HonorScopedChannelState freshState;
+    private boolean sameId,readVerified;
+    private long lastNow,postCloseRouteFloor,freshReadFloor;
+    HonorChannelReclamation(HonorScopedChannelState old,Context expected,int oldId,long deadline) {
+        this.old=old;this.expected=expected;this.oldId=oldId;this.deadline=deadline;
+    }
+    State state() {return state;}
+    Object openToken() {return openToken;}
+    Object readToken() {return readToken;}
+    Object closeToken() {return closeToken;}
+    private Action stop() {
+        if(reservation!=null) old.unknown();state=State.STOP;return Action.STOP;
+    }
+    private boolean current(Context context,long now) {
+        if(state==State.STOP || state==State.READY) return false;
+        if(now<lastNow || now<0 || now>=deadline || !expected.same(context)) {stop();return false;}
+        lastNow=now;return true;
+    }
+    Action begin(boolean allocationQualified,Context context,long now) {
+        if(state!=State.NEW) return Action.NONE;
+        if(!allocationQualified || old==null || expected==null || oldId<1 || oldId>19
+                || !current(context,now)) return stop();
+        reservation=old.reserveReclamation();
+        if(reservation==null) return stop();
+        openToken=new Object();state=State.OPENING;return Action.OPEN_FRESH;
+    }
+    Action opened(Object token,Context context,Object handle,HonorScopedChannelState fresh,
+            int channel,boolean positive,long now) {
+        if(state!=State.OPENING || token!=openToken) return Action.NONE;
+        if(!current(context,now) || old.state()!=HonorScopedChannelState.State.RECLAIMING
+                || !positive || handle==null || handle==expected.oldHandle || fresh==null || fresh==old
+                || fresh.state()!=HonorScopedChannelState.State.OPEN || channel<1 || channel>19)
+            return stop();
+        freshHandle=handle;freshState=fresh;sameId=channel==oldId;
+        if(sameId) {state=State.UNLINKING_OLD;return Action.UNLINK_EXACT_OLD_RECORD;}
+        closeToken=new Object();state=State.CLOSING_FRESH;return Action.CLOSE_FRESH;
+    }
+    Action oldRecordUnlinked(Object record,boolean removed,Context context,long now) {
+        if(state!=State.UNLINKING_OLD) return Action.NONE;
+        if(!current(context,now) || record!=expected.record || !removed || !old.reclaimed(reservation))
+            return stop();
+        freshReadFloor=freshState.successfulResponses();
+        readToken=new Object();state=State.READING_FRESH;return Action.READ_FRESH;
+    }
+    Action readsCompleted(Object token,Object handle,Context context,String actualEid,
+            boolean targetProfileObserved,long now) {
+        if(state!=State.READING_FRESH || token!=readToken) return Action.NONE;
+        if(!current(context,now) || handle!=freshHandle
+                || old.state()!=HonorScopedChannelState.State.RETIRED
+                || freshState.state()!=HonorScopedChannelState.State.OPEN
+                || freshState.successfulResponses()-freshReadFloor<2
+                || !expected.eid.equals(actualEid)) return stop();
+        readVerified=targetProfileObserved;
+        closeToken=new Object();state=State.CLOSING_FRESH;return Action.CLOSE_FRESH;
+    }
+    Action freshClosed(Object token,Object handle,Context context,boolean positive,long now) {
+        if(state!=State.CLOSING_FRESH || token!=closeToken) return Action.NONE;
+        if(!current(context,now) || handle!=freshHandle || !positive
+                || freshState.state()!=HonorScopedChannelState.State.CLOSED) return stop();
+        if(!sameId || !readVerified) return stop(); // Fresh channel closed; old/target proof incomplete.
+        if(old.state()!=HonorScopedChannelState.State.RETIRED) return stop();
+        postCloseRouteFloor=context.routeSerial;state=State.RECONCILING;return Action.RECONCILE;
+    }
+    Action reconciled(Context fresh,boolean localJniDrained,long now) {
+        if(state!=State.RECONCILING) return Action.NONE;
+        if(!current(fresh,now) || fresh.routeSerial<=postCloseRouteFloor
+                || !localJniDrained || old.state()!=HonorScopedChannelState.State.RETIRED
+                || freshState.state()!=HonorScopedChannelState.State.CLOSED) return stop();
+        state=State.READY;return Action.READY; // Owner still holds ACTIVE lease, not CLEAN.
+    }
+    void unavailable() {stop();}
+    void expire(long now) {if(now<lastNow || now>=deadline) stop();}
+}
