+        boolean isUserDataEnabled() { return data.enabled; }
+        DataSettings getDataSettingsManager() { return data; }
+    }
+    static final class PhoneFactory {
+        static Phone[] phones;
+        static Phone[] getPhones() { return phones; }
+    }
+    static final class Service {
