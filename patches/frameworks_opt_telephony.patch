+            assertFalse(TelephonyIntents.ACTION_SET_RADIO_CAPABILITY_DONE.equals(intent.getAction()));
+        }
+    }
+
+    private void timeout(int session) {
+        mController.mHandler.obtainMessage(ProxyController.EVENT_TIMEOUT, session, 0)
