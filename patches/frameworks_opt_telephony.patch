index 0000000000000000000000000000000000000000..1245707cf0bec214e774b74570b70408793bf55e
--- /dev/null
+++ b/src/java/com/android/internal/telephony/uicc/euicc/HonorReconciliationCodec.java
@@ -0,0 +1,96 @@
+/* Copyright (C) 2026 The LineageOS Project. SPDX-License-Identifier: Apache-2.0 */
+package com.android.internal.telephony.uicc.euicc;
+
+import com.android.internal.telephony.uicc.IccUtils;
+import com.android.internal.telephony.uicc.asn1.Asn1Decoder;
+import com.android.internal.telephony.uicc.asn1.Asn1Node;
+import java.util.HashSet;
+
+/** ISD-R read-only reconciliation codec. It never opens a channel or consults cached EID. */
+public final class HonorReconciliationCodec {
+    public enum Target { ENABLED, DISABLED, DELETED }
+    private HonorReconciliationCodec() {}
+    public static Target nativeTarget(int nativeKind) {
+        return switch(nativeKind) {
+            case 2 -> Target.ENABLED;
+            case 3 -> Target.DISABLED;
+            case 4 -> Target.DELETED;
+            default -> throw new IllegalArgumentException("Not a known-target profile step");
+        };
+    }
+    public static void requireIccid(String iccid) {
+        if(iccid==null || iccid.isEmpty() || iccid.length()>20)
+            throw new IllegalArgumentException("Invalid profile identity");
+        for(int i=0;i<iccid.length();i++) if(iccid.charAt(i)<'0' || iccid.charAt(i)>'9')
+            throw new IllegalArgumentException("Invalid profile identity");
+    }
+    public static byte[] eidRequest() {
+        return storeData(Asn1Node.newBuilder(Tags.TAG_GET_EID)
+                .addChildAsBytes(Tags.TAG_TAG_LIST,new byte[]{Tags.TAG_EID}).build().toBytes());
+    }
+    public static byte[] profilesRequest() {
+        return storeData(Asn1Node.newBuilder(Tags.TAG_GET_PROFILES)
+                .addChildAsBytes(Tags.TAG_TAG_LIST,new byte[]{Tags.TAG_ICCID,(byte)0x9f,0x70}).build().toBytes());
+    }
+    private static byte[] storeData(byte[] data) {
+        if(data.length>255) throw new IllegalArgumentException("Unsupported request length");
+        byte[] request=new byte[5+data.length];
+        request[0]=(byte)0x80;request[1]=(byte)0xe2;request[2]=(byte)0x91;
+        request[4]=(byte)data.length;System.arraycopy(data,0,request,5,data.length);return request;
+    }
+    private static Asn1Node root(byte[] response,int tag) throws Exception {
+        if(response==null || response.length==0 || response.length>65536)
+            throw new IllegalArgumentException("Invalid reconciliation response");
+        Asn1Decoder decoder=new Asn1Decoder(response);Asn1Node node=decoder.nextNode();
+        if(node.getTag()!=tag || decoder.hasNextNode())
+            throw new IllegalArgumentException("Unexpected reconciliation response");
+        return node;
+    }
+    public static String eid(byte[] response) throws Exception {
+        Asn1Node node=root(response,Tags.TAG_GET_EID);
+        if(node.getChildren().size()!=1 || node.getChildren().get(0).getTag()!=Tags.TAG_EID)
+            throw new IllegalArgumentException("Ambiguous eUICC identity");
+        byte[] value=node.getChild(Tags.TAG_EID).asBytes();
+        if(value.length!=16) throw new IllegalArgumentException("Invalid eUICC identity");
+        String eid=IccUtils.bytesToHexString(value);
+        for(int i=0;i<eid.length();i++) if(eid.charAt(i)<'0' || eid.charAt(i)>'9')
+            throw new IllegalArgumentException("Invalid eUICC identity");
+        return eid;
+    }
+    public static boolean target(byte[] response,String expected,Target desired,int port) throws Exception {
+        requireIccid(expected);
+        if(desired==null || port!=0) throw new IllegalArgumentException("Unqualified profile port");
+        Asn1Node root=root(response,Tags.TAG_GET_PROFILES);
+        if(root.getChildren().size()!=1 || root.getChildren().get(0).getTag()!=Tags.TAG_CTX_COMP_0)
+            throw new IllegalArgumentException("Ambiguous profile list");
+        var profiles=root.getChild(Tags.TAG_CTX_COMP_0).getChildren();
+        if(profiles.size()>512) throw new IllegalArgumentException("Unbounded profile response");
+        HashSet<String> seen=new HashSet<>();boolean found=false,matched=false;
+        for(Asn1Node profile:profiles) {
+            if(profile.getTag()!=Tags.TAG_PROFILE_INFO || profile.getChildren(Tags.TAG_ICCID).size()!=1
+                    || profile.getChildren(Tags.TAG_PROFILE_STATE).size()>1
+                    || profile.getChildren(Tags.TAG_PORT).size()>1)
+                throw new IllegalArgumentException("Ambiguous profile entry");
+            byte[] raw=profile.getChild(Tags.TAG_ICCID).asBytes();
+            if(raw.length!=10) throw new IllegalArgumentException("Invalid EFiccid length");
+            String iccid=IccUtils.stripTrailingFs(IccUtils.bchToString(raw,0,raw.length));
+            requireIccid(iccid);
+            if(!seen.add(iccid)) throw new IllegalArgumentException("Duplicate profile identity");
+            if(!iccid.equals(expected)) continue;
+            found=true;
+            if(desired==Target.DELETED) continue;
+            // State is OPTIONAL in the generic ASN.1, but this request explicitly asks for it.
+            // Missing data is not positive DISABLED proof (unlike the UI's liberal default).
+            int state=profile.getChild(Tags.TAG_PROFILE_STATE).asInteger();
+            if(state!=0 && state!=1) throw new IllegalArgumentException("Unknown profile state");
+            if(profile.hasChild(Tags.TAG_PORT)) {
+                int activePort=profile.getChild(Tags.TAG_PORT).asInteger();
+                if(activePort!=port) return false;
+                // Same as EuiccPort.buildProfile: a matching assigned port proves Enabled.
+                state=1;
+            }
+            matched=desired==Target.ENABLED ? state==1 : state==0;
+        }
+        return desired==Target.DELETED ? !found : found && matched;
+    }
+}
