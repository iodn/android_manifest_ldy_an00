+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#include "aidl/sensors/convert.h"
+
+#include <gtest/gtest.h>
+
+#include <iterator>
+
+namespace android::hardware::sensors::implementation {
+namespace {
+
+using aidl::android::hardware::sensors::Event;
+using aidl::android::hardware::sensors::SensorStatus;
+using aidl::android::hardware::sensors::SensorType;
+
+Event makeEvent(SensorType type) {
+    Event event{};
+    event.timestamp = 1234567890123;
+    event.sensorHandle = 17;
+    event.sensorType = type;
+    return event;
+}
+
+void expectHeader(const Event& event, const sensors_event_t& converted) {
+    EXPECT_EQ(sizeof(sensors_event_t), converted.version);
+    EXPECT_EQ(event.timestamp, converted.timestamp);
+    EXPECT_EQ(event.sensorHandle, converted.sensor);
+    EXPECT_EQ(static_cast<int32_t>(event.sensorType), converted.type);
+}
+
+class HonorScalarPayloadTest : public testing::TestWithParam<SensorType> {};
+
+TEST_P(HonorScalarPayloadTest, StandardScalarRemainsSupported) {
+    Event event = makeEvent(GetParam());
+    event.payload.set<Event::EventPayload::scalar>(12.5f);
+    sensors_event_t converted{};
+    convertToSensorEvent(event, &converted);
+    expectHeader(event, converted);
+    EXPECT_FLOAT_EQ(12.5f, converted.data[0]);
+    for (size_t i = 1; i < std::size(converted.data); ++i) {
+        EXPECT_FLOAT_EQ(0.0f, converted.data[i]);
+    }
+}
+
+TEST_P(HonorScalarPayloadTest, HonorDataPreservesDocumentedChannels) {
+    Event event = makeEvent(GetParam());
+    Event::EventPayload::Data data{};
+    for (size_t i = 0; i < data.values.size(); ++i) {
+        data.values[i] = static_cast<float>(i) + 0.25f;
+    }
+    event.payload.set<Event::EventPayload::data>(data);
+    sensors_event_t converted{};
+    convertToSensorEvent(event, &converted);
+    expectHeader(event, converted);
+    const size_t channels = GetParam() == SensorType::HINGE_ANGLE ? 16 : 3;
+    for (size_t i = 0; i < std::size(converted.data); ++i) {
+        EXPECT_FLOAT_EQ(i < channels ? data.values[i] : 0.0f, converted.data[i]);
+    }
+}
+
+TEST_P(HonorScalarPayloadTest, StandardOutboundUsesScalar) {
+    sensors_event_t source{};
+    source.version = sizeof(source);
+    source.type = static_cast<int32_t>(GetParam());
+    source.sensor = 23;
+    source.timestamp = 2345678901234;
+    for (size_t i = 0; i < std::size(source.data); ++i) {
+        source.data[i] = static_cast<float>(i) + 0.75f;
+    }
+    Event converted{};
+    convertFromSensorEvent(source, &converted, false);
+    expectHeader(converted, source);
+    ASSERT_EQ(Event::EventPayload::scalar, converted.payload.getTag());
+    EXPECT_FLOAT_EQ(source.data[0], converted.payload.get<Event::EventPayload::scalar>());
+}
+
+TEST_P(HonorScalarPayloadTest, HonorOutboundPreservesDocumentedChannels) {
+    sensors_event_t source{};
+    source.version = sizeof(source);
+    source.type = static_cast<int32_t>(GetParam());
+    source.sensor = 23;
+    source.timestamp = 2345678901234;
+    for (size_t i = 0; i < std::size(source.data); ++i) {
+        source.data[i] = static_cast<float>(i) + 0.75f;
+    }
+    Event converted{};
+    convertFromSensorEvent(source, &converted, true);
+    expectHeader(converted, source);
+    ASSERT_EQ(Event::EventPayload::data, converted.payload.getTag());
+    const auto& values = converted.payload.get<Event::EventPayload::data>().values;
+    const size_t channels = GetParam() == SensorType::HINGE_ANGLE ? 16 : 3;
+    for (size_t i = 0; i < values.size(); ++i) {
+        EXPECT_FLOAT_EQ(i < channels ? source.data[i] : 0.0f, values[i]);
+    }
+
+    sensors_event_t roundTrip{};
+    convertToSensorEvent(converted, &roundTrip);
+    expectHeader(converted, roundTrip);
+    for (size_t i = 0; i < std::size(roundTrip.data); ++i) {
+        EXPECT_FLOAT_EQ(i < channels ? source.data[i] : 0.0f, roundTrip.data[i]);
+    }
+}
+
+INSTANTIATE_TEST_SUITE_P(Honor, HonorScalarPayloadTest,
+                        testing::Values(SensorType::LIGHT, SensorType::PROXIMITY,
+                                        SensorType::HINGE_ANGLE));
+
+TEST(SensorsAidlConvertTest, OtherScalarTypeIsUnchanged) {
+    Event event = makeEvent(SensorType::PRESSURE);
+    event.payload.set<Event::EventPayload::scalar>(1001.5f);
+    sensors_event_t converted{};
+    convertToSensorEvent(event, &converted);
+    expectHeader(event, converted);
+    EXPECT_FLOAT_EQ(1001.5f, converted.data[0]);
+}
+
+TEST(SensorsAidlConvertTest, HonorModeLeavesOtherScalarTypesUnchanged) {
+    sensors_event_t source{};
+    source.version = sizeof(source);
+    source.type = static_cast<int32_t>(SensorType::PRESSURE);
+    source.sensor = 29;
+    source.timestamp = 3456789012345;
+    source.data[0] = 999.5f;
+    Event converted{};
+    convertFromSensorEvent(source, &converted, true);
+    expectHeader(converted, source);
+    ASSERT_EQ(Event::EventPayload::scalar, converted.payload.getTag());
+    EXPECT_FLOAT_EQ(source.data[0], converted.payload.get<Event::EventPayload::scalar>());
+}
+
+TEST(SensorsAidlConvertTest, StandardVectorIsUnchanged) {
+    Event event = makeEvent(SensorType::ACCELEROMETER);
+    Event::EventPayload::Vec3 vector{};
+    vector.x = 1.25f;
+    vector.y = -2.5f;
+    vector.z = 9.75f;
+    vector.status = SensorStatus::ACCURACY_HIGH;
+    event.payload.set<Event::EventPayload::vec3>(vector);
+    sensors_event_t converted{};
+    convertToSensorEvent(event, &converted);
+    expectHeader(event, converted);
+    EXPECT_FLOAT_EQ(vector.x, converted.acceleration.x);
+    EXPECT_FLOAT_EQ(vector.y, converted.acceleration.y);
+    EXPECT_FLOAT_EQ(vector.z, converted.acceleration.z);
+    EXPECT_EQ(static_cast<int32_t>(vector.status), converted.acceleration.status);
+}
+
+TEST(SensorsAidlConvertTest, StandardDataVectorIsUnchanged) {
+    Event event = makeEvent(SensorType::ROTATION_VECTOR);
+    Event::EventPayload::Data data{};
+    for (size_t i = 0; i < 5; ++i) {
+        data.values[i] = static_cast<float>(i) + 0.5f;
+    }
+    event.payload.set<Event::EventPayload::data>(data);
+    sensors_event_t converted{};
+    convertToSensorEvent(event, &converted);
+    expectHeader(event, converted);
+    for (size_t i = 0; i < 5; ++i) {
+        EXPECT_FLOAT_EQ(data.values[i], converted.data[i]);
+    }
+}
+
+}  // namespace
+}  // namespace android::hardware::sensors::implementation
