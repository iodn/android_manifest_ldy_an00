diff --git a/sensors/aidl/convert/convert_test.cpp b/sensors/aidl/convert/convert_test.cpp
new file mode 100644
index 00000000..8f1a59b4
--- /dev/null
+++ b/sensors/aidl/convert/convert_test.cpp
@@ -0,0 +1,178 @@
+/*
