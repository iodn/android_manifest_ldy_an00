+package com.android.devicediagnostics
+
+import android.content.Context
+import android.content.Intent
+import android.os.BatteryManager
+import android.os.Build
+import androidx.test.core.app.ApplicationProvider
+import com.android.devicediagnostics.Protos.BatteryInfo
+import com.android.devicediagnostics.Protos.ProductInfo
+import com.android.devicediagnostics.evaluated.getBatteryInfo
+import java.time.LocalDate
+import java.time.ZoneOffset
+import java.util.Locale
+import java.util.TimeZone
+import org.junit.*
+import org.junit.Assert.*
+import org.junit.runner.RunWith
+import org.mockito.Mockito.*
+import org.robolectric.Robolectric
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+import org.robolectric.util.ReflectionHelpers
+
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk=[37])
+class BatteryManufactureCalendarTest {
+    private val oldZone = TimeZone.getDefault()
+    private val oldIcuZone = android.icu.util.TimeZone.getDefault()
+    private val base: Context = ApplicationProvider.getApplicationContext()
+    @Before fun setUp() {
+        ReflectionHelpers.setStaticField(Build::class.java,"MODEL","LDY-AN00")
+        ReflectionHelpers.setStaticField(Build::class.java,"DEVICE","ldy_an00")
+        ReflectionHelpers.setStaticField(Build::class.java,"HARDWARE","mt6993")
+        zone("America/Los_Angeles")
+    }
+    @After fun restore() {TimeZone.setDefault(oldZone);android.icu.util.TimeZone.setDefault(oldIcuZone)}
+    private fun zone(zone: String) {
+        TimeZone.setDefault(TimeZone.getTimeZone(zone))
+        android.icu.util.TimeZone.setDefault(android.icu.util.TimeZone.getTimeZone(zone))
+    }
+    private fun epoch(date: String) = LocalDate.parse(date).atStartOfDay(ZoneOffset.UTC).toEpochSecond()
+    private fun honor() = ProductInfo.newBuilder().setModel("LDY-AN00").setDevice("ldy_an00")
+        .setManufacturer("HONOR").build()
+    private fun battery() = BatteryInfo.newBuilder().setManufactureTimestamp(epoch("2025-11-25"))
+        .setFirstUsageTimestamp(epoch("2025-11-25")+1234).build()
+    private fun policy(intent: Intent): Boolean {
+        val activity=Robolectric.buildActivity(BatteryActivity::class.java).get()
+        activity.intent=intent
+        return ReflectionHelpers.callInstanceMethod(activity,"readManufactureUtcCalendar")
+    }
+    @Test fun baselineIcuUsesLocalTimezoneManufactureUtcPreservesFactoryDay() {
+        val value=epoch("2025-11-25")
+        assertEquals("November 24, 2025",localizeDateTimestamp(Locale.US,value))
+        assertEquals("November 25, 2025",localizeManufactureDateTimestamp(Locale.US,value,true))
+        assertEquals(localizeDateTimestamp(Locale.US,value),localizeManufactureDateTimestamp(Locale.US,value,false))
+    }
+    @Test fun utcCalendarSurvivesNegativeExtremeYearAndLeapBoundaries() {
+        val dates=mapOf("2025-11-25" to "November 25, 2025","2024-02-29" to "February 29, 2024", "2025-01-01" to "January 1, 2025")
+        for (z in listOf("Etc/GMT+12","America/Los_Angeles","UTC","Asia/Tokyo","Pacific/Kiritimati")) {
+            zone(z)
+            for ((date,expected) in dates) assertEquals(expected,localizeManufactureDateTimestamp(Locale.US,epoch(date),true))
+        }
+    }
+    @Test fun manufactureFormattingRemainsLocalized() {
+        assertEquals("25 novembre 2025",localizeManufactureDateTimestamp(Locale.FRANCE,epoch("2025-11-25"),true))
+    }
+    @Test fun directLocalNoExtrasUsesExactHardwarePolicy() {
+        assertTrue(policy(Intent()))
+        ReflectionHelpers.setStaticField(Build::class.java,"HARDWARE","other")
+        assertFalse(policy(Intent()))
+    }
+    @Test fun remoteOtherProductDoesNotInheritHonorViewerPolicy() {
+        val other=honor().toBuilder().setModel("other").build()
+        assertFalse(policy(BatteryActivity.createIntent(base,battery(),34,other)))
+    }
+    @Test fun remoteHonorProductUsesOriginEvenOnOtherViewer() {
+        ReflectionHelpers.setStaticField(Build::class.java,"MODEL","other")
+        ReflectionHelpers.setStaticField(Build::class.java,"DEVICE","other")
+        ReflectionHelpers.setStaticField(Build::class.java,"HARDWARE","other")
+        assertFalse(localManufactureDateUsesUtcCalendar())
+        assertTrue(policy(BatteryActivity.createIntent(base,battery(),34,honor())))
+    }
+    @Test fun missingReportProductNeverFallsBackToViewerBuild() {
+        assertTrue(localManufactureDateUsesUtcCalendar())
+        assertFalse(policy(BatteryActivity.createIntent(base,battery(),34)))
+        assertFalse(policy(BatteryActivity.createIntent(base,battery(),34,ProductInfo.getDefaultInstance())))
+    }
+    @Test fun mismatchedReportModelDeviceManufacturerKeepLegacy() {
+        assertFalse(reportedManufactureDateUsesUtcCalendar(null))
+        assertFalse(reportedManufactureDateUsesUtcCalendar(honor().toBuilder().setModel("other").build()))
+        assertFalse(reportedManufactureDateUsesUtcCalendar(honor().toBuilder().setDevice("other").build()))
+        assertFalse(reportedManufactureDateUsesUtcCalendar(honor().toBuilder().setManufacturer("other").build()))
+    }
+    @Test fun intentPreservesActualProtoAndRawEpochs() {
+        val original=battery();val intent=BatteryActivity.createIntent(base,original,34,honor())
+        assertArrayEquals(original.toByteArray(),intent.getByteArrayExtra(BatteryActivity.INTENT_BATTERY_INFO))
+        val decoded=BatteryInfo.parseFrom(intent.getByteArrayExtra(BatteryActivity.INTENT_BATTERY_INFO))
+        assertEquals(original.manufactureTimestamp,decoded.manufactureTimestamp)
+        assertEquals(original.firstUsageTimestamp,decoded.firstUsageTimestamp)
+        assertEquals(34,intent.getIntExtra(BatteryActivity.INTENT_LAUNCH_LEVEL,-1))
+    }
+    @Test fun actualProducerOmitsNonpositiveDatesRatherThanInventingEpoch() {
+        val context=mock(Context::class.java);val manager=mock(BatteryManager::class.java)
+        `when`(context.getSystemService(Context.BATTERY_SERVICE)).thenReturn(manager)
+        `when`(manager.getIntProperty(anyInt())).thenReturn(-1)
+        for(value in listOf(0L,-1L,Long.MIN_VALUE)) {
+            `when`(manager.getLongProperty(anyInt())).thenReturn(value)
+            val info=getBatteryInfo(context)
+            assertFalse(info.hasManufactureTimestamp());assertFalse(info.hasFirstUsageTimestamp())
+        }
+    }
+    @Test fun actualProducerKeepsPositiveManufactureAndFirstUseSecondsUnchanged() {
+        val context=mock(Context::class.java);val manager=mock(BatteryManager::class.java)
+        `when`(context.getSystemService(Context.BATTERY_SERVICE)).thenReturn(manager)
+        `when`(manager.getIntProperty(anyInt())).thenReturn(-1)
+        val manufacture=epoch("2025-11-25")+3600;val first=manufacture+1234
+        `when`(manager.getLongProperty(BatteryManager.BATTERY_PROPERTY_MANUFACTURING_DATE)).thenReturn(manufacture)
+        `when`(manager.getLongProperty(BatteryManager.BATTERY_PROPERTY_FIRST_USAGE_DATE)).thenReturn(first)
+        val info=getBatteryInfo(context)
+        assertEquals(manufacture,info.manufactureTimestamp);assertEquals(first,info.firstUsageTimestamp)
+    }
+}
