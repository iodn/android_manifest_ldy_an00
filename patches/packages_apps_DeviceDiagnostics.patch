+
+/** UI-only manufacturing-calendar policy; it grants no identity or device capabilities. */
+fun localManufactureDateUsesUtcCalendar(): Boolean =
+    Build.MODEL == "LDY-AN00" && Build.DEVICE == "ldy_an00" && Build.HARDWARE == "mt6993"
+
+/** Use the evaluated report's product, never the viewing device, for remote battery information. */
+fun reportedManufactureDateUsesUtcCalendar(product: ProductInfo?): Boolean =
+    product != null && product.model == "LDY-AN00" && product.device == "ldy_an00" &&
+        product.manufacturer == "HONOR"
+
+fun localizeManufactureDateTimestamp(locale: Locale, seconds: Long, utcCalendar: Boolean): String {
+    if (!utcCalendar) return localizeDateTimestamp(locale, seconds)
+    val formatter = DateFormat.getDateInstance(DateFormat.LONG, locale)
+    formatter.timeZone = TimeZone.getTimeZone("UTC")
+    return formatter.format(Date.from(Instant.ofEpochSecond(seconds)))
+}
diff --git a/DeviceDiagnosticsLib/src/test/java/com/android/devicediagnostics/BatteryManufactureCalendarTest.kt b/DeviceDiagnosticsLib/src/test/java/com/android/devicediagnostics/BatteryManufactureCalendarTest.kt
