@@ -0,0 +1,37 @@
+package im.angry.openeuicc.core
+
+import android.telephony.UiccCardInfo
+
+/** Cached target identity, never a radio operation or a default/all-cards refresh. */
+internal class DownloadedProfileRefreshRequest(
+    private val slotId: Int,
+    private val portId: Int,
+    private val cardId: Int,
+    private val readCards: () -> List<UiccCardInfo>,
+    private val requestRefresh: (Int) -> Unit
+) : EuiccChannelManager.DownloadedProfileRefresh {
+    private fun card() = readCards().single {
+        it.cardId == cardId && it.physicalSlotIndex == slotId && it.isEuicc
+    }
+    private val eid: String
+    private val logicalSlot: Int
+
+    init {
+        require(slotId >= 0 && portId >= 0 && cardId >= 0)
+        val expected = card()
+        eid = checkNotNull(expected.eid)
+        check(eid.matches(Regex("[0-9]{32}")))
+        logicalSlot = expected.ports.single { it.portIndex == portId && it.isActive }.logicalSlotIndex
+        check(logicalSlot >= 0)
+    }
+
+    override fun request() {
+        val current = card()
+        check(current.eid == eid)
+        check(current.ports.any {
+            it.portIndex == portId && it.isActive && it.logicalSlotIndex == logicalSlot
+        })
+        // Zero is a valid public card ID, not an absent/default sentinel.
+        requestRefresh(cardId)
+    }
+}
