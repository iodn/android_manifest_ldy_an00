+++ b/host-tests/profile-publication/FrameworkProfileListTest.kt
@@ -0,0 +1,38 @@
+package im.angry.openeuicc.service
+
+import android.service.euicc.EuiccProfileInfo
+import net.typeblog.lpac_jni.LocalProfileInfo
+import net.typeblog.lpac_jni.ProfileClass
+import org.junit.Assert.*
+import org.junit.Test
+
+class FrameworkProfileListTest {
+    private fun profile(index:Int, enabled:Boolean, kind:ProfileClass=ProfileClass.Operational) =
+        LocalProfileInfo("8900000000000000000$index",
+            if(enabled) LocalProfileInfo.State.Enabled else LocalProfileInfo.State.Disabled,
+            "Profile $index","SIM $index","Provider $index","",kind)
+    @Test fun threeStoredOperationalProfilesIncludeBothDisabledNativeRows() {
+        val rows=frameworkProfileList(listOf(profile(1,true),profile(2,false),profile(3,false)),false)
+        assertEquals(3,rows.size)
+        assertEquals(listOf(EuiccProfileInfo.PROFILE_STATE_ENABLED,
+            EuiccProfileInfo.PROFILE_STATE_DISABLED,EuiccProfileInfo.PROFILE_STATE_DISABLED),rows.map {it.state})
+        assertEquals(listOf("SIM 1","SIM 2","SIM 3"),rows.map {it.nickname})
+        assertEquals(3,rows.map {it.iccid}.distinct().size)
+    }
+    @Test fun switchingBPublishesAInactiveAndBActiveWithoutDroppingC() {
+        val rows=frameworkProfileList(listOf(profile(1,false),profile(2,true),profile(3,false)),false)
+        assertEquals(3,rows.size)
+        assertEquals(listOf(EuiccProfileInfo.PROFILE_STATE_DISABLED,
+            EuiccProfileInfo.PROFILE_STATE_ENABLED,EuiccProfileInfo.PROFILE_STATE_DISABLED),rows.map {it.state})
+    }
+    @Test fun disablingAllStillPublishesThreeAvailableProfiles() {
+        val rows=frameworkProfileList((1..3).map {profile(it,false)},false)
+        assertEquals(3,rows.size)
+        assertTrue(rows.all {it.state==EuiccProfileInfo.PROFILE_STATE_DISABLED})
+    }
+    @Test fun ordinaryFilterExcludesTestingClassNotDisabledOperationalProfiles() {
+        val profiles=listOf(profile(1,false),profile(2,false,ProfileClass.Testing))
+        assertEquals(1,frameworkProfileList(profiles,false).size)
+        assertEquals(2,frameworkProfileList(profiles,true).size)
+    }
+}
