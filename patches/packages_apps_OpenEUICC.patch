@@ -0,0 +1,37 @@
+package im.angry.openeuicc.service
+
+/** One confirmed deletion; each operation owns its own Phone lease, never a native retry. */
+internal object FrameworkProfileDelete {
+    data class Snapshot(val eid: String, val profiles: List<FrameworkProfileDownload.Profile>)
+    class StateChanged : IllegalStateException("The selected eSIM profile or card changed")
+    interface Operations {
+        suspend fun snapshot(): Snapshot
+        suspend fun disable(target: String, expected: Snapshot)
+        suspend fun delete(target: String, expected: Snapshot)
+    }
+    private fun states(snapshot: Snapshot): Map<String,Boolean> {
+        if (!snapshot.eid.matches(Regex("[0-9]{32}")) ||
+            snapshot.profiles.any { it.iccid.isEmpty() } ||
+            snapshot.profiles.map { it.iccid }.distinct().size != snapshot.profiles.size)
+            throw StateChanged()
+        return snapshot.profiles.associate { it.iccid to it.enabled }
+    }
+    fun requireSame(expected: Snapshot, actual: Snapshot) {
+        if (expected.eid != actual.eid || states(expected) != states(actual)) throw StateChanged()
+    }
+    suspend fun run(target: String, operations: Operations) {
+        val before=operations.snapshot()
+        val original=states(before)
+        if (target !in original || original.values.count { it } > 1) throw StateChanged()
+        val disabled=if (original[target] == true) {
+            operations.disable(target,before)
+            val observed=operations.snapshot()
+            if (observed.eid != before.eid ||
+                states(observed) != original + (target to false)) throw StateChanged()
+            observed
+        } else before
+        operations.delete(target,disabled)
+        val after=operations.snapshot()
+        if (after.eid != before.eid || states(after) != states(disabled) - target) throw StateChanged()
+    }
+}
