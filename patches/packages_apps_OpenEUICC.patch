+    val worker=checkNotNull(fence.enqueueWork())
+    verify(queued.allowed());fence.beginClosing()
+    verify(!queued.allowed());verify(fence.enqueueWork()==null);verify(worker.allowed())
+    fence.freezeWork()
+    verify(!worker.allowed())
+    verify(!queued.allowed());verify(!fence.work().allowed())
