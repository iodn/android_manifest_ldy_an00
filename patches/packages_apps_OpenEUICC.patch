+package im.angry.openeuicc.core
+
+import net.typeblog.lpac_jni.*
+
+/** Actual wrapper and policy; no Android or native calls are executed by this host test. */
+fun main() {
+    var checks = 0
+    fun verify(value: Boolean) { check(value); checks++ }
+    verify(!SharedSlotOperationPolicy.blocked("LDY-AN00", "ldy_an00")) // Controlled-trial gate is enabled.
+    verify(!SharedSlotOperationPolicy.blocked("Other", "other"))
+    val inner = RecordingLpa()
