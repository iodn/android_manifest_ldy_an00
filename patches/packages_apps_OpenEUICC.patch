diff --git a/app-common/src/main/java/im/angry/openeuicc/service/FrameworkProfileDownload.kt b/app-common/src/main/java/im/angry/openeuicc/service/FrameworkProfileDownload.kt
new file mode 100644
index 0000000..566ecd7
--- /dev/null
+++ b/app-common/src/main/java/im/angry/openeuicc/service/FrameworkProfileDownload.kt
@@ -0,0 +1,79 @@
+package im.angry.openeuicc.service
+
+import net.typeblog.lpac_jni.ProfileDownloadInput
+import java.util.concurrent.atomic.AtomicReference
+import java.util.concurrent.atomic.AtomicBoolean
+
+/** One foreground operation: install and, only when requested, enable the exact new profile. */
+internal object FrameworkProfileDownload {
+    data class Profile(val iccid: String, val enabled: Boolean)
+
+    interface Operations {
+        suspend fun profiles(): List<Profile>
+        suspend fun download(input: ProfileDownloadInput, confirm: (String?) -> Boolean)
+        suspend fun enable(iccid: String): Boolean
+        suspend fun reconnect()
+    }
+
+    suspend fun run(
+        input: ProfileDownloadInput,
+        switchAfterDownload: Boolean,
+        policyRulesConsented: Boolean,
+        operations: Operations,
+        singleActiveProfile: Boolean = false
+    ) {
+        require(policyRulesConsented) { "Profile policy consent is required" }
+        val before = operations.profiles()
+        check(before.map { it.iccid }.distinct().size == before.size) { "Ambiguous profile list" }
+        val previousIds = before.map { it.iccid }.toSet()
+        if (singleActiveProfile) check(before.count { it.enabled } <= 1) { "Multiple active profiles are not qualified" }
+        val expected = AtomicReference<String?>()
+        val refused = AtomicBoolean()
+        operations.download(input) { iccid ->
+            val accepted = !iccid.isNullOrEmpty() && iccid !in previousIds &&
+                (expected.compareAndSet(null, iccid) || expected.get() == iccid)
+            if (!accepted) refused.set(true)
+            accepted
+        }
+        check(!refused.get()) { "Download metadata was refused" }
+        val expectedId = checkNotNull(expected.get()) { "Download metadata not confirmed" }
+        val after = operations.profiles()
+        check(after.map { it.iccid }.distinct().size == after.size) { "Ambiguous profile list" }
+        check(after.map { it.iccid }.toSet() - previousIds == setOf(expectedId)) {
+            "Downloaded profile was not uniquely observed"
+        }
+        check(after.map { it.iccid }.toSet().containsAll(previousIds)) { "Existing profiles were lost" }
+        val installed = after.single { it.iccid == expectedId }
+        if (!switchAfterDownload) {
+            check(!installed.enabled) { "Unexpected enabled profile state" }
+            check(before.all { old -> after.single { it.iccid == old.iccid }.enabled == old.enabled }) {
+                "Download changed an existing profile state"
+            }
+            return
+        }
+        if (!installed.enabled) {
+            // A false result may include a failed refresh after an accepted switch. Do not resend.
+            check(operations.enable(expectedId)) { "Enable outcome could not be confirmed" }
+        }
+        operations.reconnect()
+        val finalProfiles = operations.profiles()
+        check(finalProfiles.singleOrNull { it.iccid == expectedId }?.enabled == true) {
+            "Enabled profile was not observed after reconnect"
+        }
+        if (singleActiveProfile) requireSingleActiveSwitch(after,finalProfiles,expectedId,true)
+    }
+
+    /** Only the qualified Honor single-port path uses this postcondition; no MEP claim. */
+    fun requireSingleActiveSwitch(
+        before: List<Profile>, after: List<Profile>, target: String, enable: Boolean
+    ) {
+        check(before.map { it.iccid }.distinct().size == before.size &&
+            after.map { it.iccid }.distinct().size == after.size) { "Ambiguous profile list" }
+        check(before.map { it.iccid }.toSet() == after.map { it.iccid }.toSet()) { "Stored profiles changed during switch" }
+        check(after.single { it.iccid == target }.enabled == enable) { "Target profile state was not observed" }
+        check(after.count { it.enabled } <= 1) { "Multiple active profiles are not qualified" }
+        check(after.filter { it.iccid != target }.all { observed ->
+            if (enable) !observed.enabled else observed.enabled == before.single { it.iccid == observed.iccid }.enabled
+        }) { "Another profile state changed unexpectedly" }
+    }
+}
