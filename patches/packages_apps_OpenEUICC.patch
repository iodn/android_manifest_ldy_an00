+    val blocked = LocalProfileAssistantWrapper(inner) { guards++; error("blocked") }
+    val operations: List<(LocalProfileAssistantWrapper) -> Unit> = listOf(
+        { it.enableProfile("test", true) }, { it.disableProfile("test", false) },
+        { it.deleteProfile("test") },
+        { it.downloadProfile(ProfileDownloadInput("example.invalid", null, null, null)) { true } },
+        { it.deleteNotification(1) }, { it.handleNotification(1) },
+        { it.euiccMemoryReset() }, { it.setNickname("test", "test") }
+    )
+    operations.forEachIndexed { index, operation ->
+        val result = runCatching { operation(blocked) }
+        verify(result.exceptionOrNull() is IllegalStateException)
+        verify(guards == index + 1)
+        verify(inner.mutations == 0)
+    }
+    verify(blocked.valid)
+    verify(blocked.profiles.isEmpty())
+    verify(blocked.notifications.isEmpty())
+    verify(blocked.eID == "read-only")
+    verify(blocked.euiccInfo2 == null)
+    verify(guards == operations.size)
+    val allowed = LocalProfileAssistantWrapper(inner) { }
+    operations.forEachIndexed { index, operation ->
+        operation(allowed); verify(inner.mutations == index + 1)
+    }
+    val targets = mutableListOf<Pair<Int,String?>>()
+    val sequence = mutableListOf<String>()
+    inner.onMutation = { sequence.add("native") }
+    NativeMutationBoundary.observer.set(object : NativeMutationBoundary.Observer {
+        override fun before(kind: Int,lastProfileBefore: Boolean,targetIccid: String?) {
+            targets.add(kind to targetIccid);sequence.add("before")
+        }
+        override fun returned(kind: Int) {sequence.add("returned")}
+        override fun uncertain() {sequence.add("uncertain")}
+    })
+    val targetIccid = "89123456789012345678"
+    allowed.enableProfile(targetIccid,true)
+    allowed.disableProfile(targetIccid,true)
+    allowed.deleteProfile(targetIccid)
+    verify(targets == listOf(2 to targetIccid,3 to targetIccid,4 to targetIccid))
+    verify(sequence == List(3) {listOf("before","native","returned")}.flatten())
+    val prior = inner.mutations
+    NativeMutationBoundary.observer.set(object : NativeMutationBoundary.Observer {
+        override fun before(kind: Int,lastProfileBefore: Boolean,targetIccid: String?) {error("Version/target rejected")}
+        override fun returned(kind: Int) {error("No native command allowed")}
+        override fun uncertain() { }
+    })
+    verify(runCatching { allowed.enableProfile(targetIccid,true) }.isFailure)
+    verify(inner.mutations == prior)
+    NativeMutationBoundary.observer.remove()
+    inner.onMutation = null
+    blocked.invalidateWrapper()
+    verify(runCatching { blocked.eID }.isFailure)
+    println("SHARED_SLOT_GUARD_HOST_PASS checks=$checks")
+}
+
+private class RecordingLpa : LocalProfileAssistant {
+    var mutations = 0
+    var onMutation: (() -> Unit)? = null
+    private fun recordMutation() {onMutation?.invoke();mutations++}
+    override val valid = true
+    override val profiles = emptyList<LocalProfileInfo>()
+    override val notifications = emptyList<LocalProfileNotification>()
+    override val eID = "read-only"
+    override val euiccInfo2: EuiccInfo2? = null
+    override fun setEs10xMss(mss: Byte) { }
+    override fun enableProfile(iccid: String, refresh: Boolean): Boolean { recordMutation(); return true }
+    override fun disableProfile(iccid: String, refresh: Boolean): Boolean { recordMutation(); return true }
+    override fun deleteProfile(iccid: String): Boolean { recordMutation(); return true }
+    override fun downloadProfile(input: ProfileDownloadInput, callback: ProfileDownloadCallback) { recordMutation() }
+    override fun deleteNotification(seqNumber: Long): Boolean { recordMutation(); return true }
+    override fun handleNotification(seqNumber: Long): Boolean { recordMutation(); return true }
+    override fun euiccMemoryReset() { recordMutation() }
+    override fun setNickname(iccid: String, nickname: String) { recordMutation() }
+    override fun close() { }
+}
