+++ b/app-common/src/main/java/im/angry/openeuicc/core/NativeMutationBoundary.kt
@@ -0,0 +1,39 @@
+package im.angry.openeuicc.core
+
+/** A native false result is ambiguous; never return it to a caller that might resend. */
+internal object NativeMutationBoundary {
+    interface Observer {
+        fun before(kind: Int,lastProfileBefore: Boolean,targetIccid: String?)
+        fun returned(kind: Int)
+        fun rejected(kind: Int, code: Int) { error("Definitive native rejection is not supported") }
+        fun uncertain()
+    }
+    val observer = ThreadLocal<Observer?>()
+    fun <T> call(kind: Int,lastProfileBefore: Boolean = false,targetIccid: String? = null, operation: () -> T): T {
+        val current = observer.get()
+        try {
+            current?.before(kind,lastProfileBefore,targetIccid)
+            val result = operation()
+            if (current != null && result == false) {
+                error("eSIM native completion is uncertain")
+            }
+            current?.returned(kind)
+            return result
+        } catch (rejected: net.typeblog.lpac_jni.ProfileOperationRejectedException) {
+            if (current != null) {
+                try {
+                    check(rejected.kind == kind)
+                    current.rejected(kind,rejected.resultCode)
+                } catch (failure: Throwable) {
+                    current.uncertain()
+                    failure.addSuppressed(rejected)
+                    throw failure
+                }
+            }
+            throw rejected
+        } catch (failure: Throwable) {
+            current?.uncertain()
+            throw failure
+        }
+    }
+}
diff --git a/app-common/src/main/java/im/angry/openeuicc/core/PendingProfileAction.kt b/app-common/src/main/java/im/angry/openeuicc/core/PendingProfileAction.kt
