index 0000000000000000000000000000000000000000..fac75a0adf1024deb1b0d173ca85bd3ca86db2ef
--- /dev/null
+++ b/app-common/src/main/java/im/angry/openeuicc/core/HonorManagementSession.kt
@@ -0,0 +1,204 @@
+package im.angry.openeuicc.core
+
+import android.app.Activity
+import android.app.Application
+import android.content.ComponentName
+import android.content.Intent
+import android.content.pm.PackageManager
+import android.os.BadParcelableException
+import android.os.Bundle
+import android.os.Handler
+import android.os.Looper
+import android.os.ResultReceiver
+import android.service.euicc.EuiccService
+import im.angry.openeuicc.service.EuiccChannelManagerService
+import kotlinx.coroutines.*
+import java.lang.ref.WeakReference
+import java.util.Collections
+import java.util.IdentityHashMap
+
+/** A single nonpersistent Settings-owned management session. No route commands live here. */
+internal object HonorManagementSession {
+    const val VERSION = "honor_management_version"
+    const val NONCE = "honor_management_nonce"
+    const val RECEIVER = "honor_management_result"
+    const val DONE = "honor_management_done"
+    const val DRAINED = "honor_management_drained"
+    const val KEEP = "honor_management_keep_esim"
+    const val FACADE_ACTION = "com.android.settings.action.HONOR_LDY_AN00_MANAGE_ESIM"
+    val FACADE = ComponentName("com.android.settings",
+        "com.android.settings.network.HonorLdyAn00EsimManagementActivity")
+    private val main=Handler(Looper.getMainLooper())
+    private class Active(val nonce: String,var receiver: ResultReceiver?,activity: Activity) {
+        var root=WeakReference(activity)
+        val outcome=ManagementSessionOutcome(nonce)
+        val scope=CoroutineScope(SupervisorJob()+Dispatchers.Main.immediate)
+        val activities=Collections.newSetFromMap(IdentityHashMap<Activity,Boolean>())
+        val started=Collections.newSetFromMap(IdentityHashMap<Activity,Boolean>())
+        val external=mutableSetOf<Pair<Activity,Int>>()
+        var service: EuiccChannelManagerService?=null
+        @Volatile var closing=false
+        @Volatile var sent=false
+        var finishJob: Job?=null
+        var callbacks: Application.ActivityLifecycleCallbacks?=null
+    }
+    @Volatile private var active: Active?=null
+    fun hasEnvelope(intent: Intent) = try {
+        intent.hasExtra(VERSION) || intent.hasExtra(NONCE) || intent.hasExtra(RECEIVER)
+    } catch (_: BadParcelableException) {
+        true // A malformed incoming envelope must finish as refused, never become a fresh launcher.
+    }
+
+    @Suppress("DEPRECATION")
+    fun attach(activity: Activity,restored: Boolean): Boolean {
+        if (!HonorLpaLeaseClient.requiresCloseProof()
+            || activity.intent.action != EuiccService.ACTION_MANAGE_EMBEDDED_SUBSCRIPTIONS) return false
+        val caller=activity.callingActivity ?: return false
+        if (caller.packageName != "com.android.settings"
+            || caller.className != "com.android.settings.network.HonorLdyAn00EsimSetupActivity"
+            || activity.packageManager.checkSignatures("android","com.android.settings")
+                != PackageManager.SIGNATURE_MATCH) return false
+        val envelope = try {
+            val extras=activity.intent.extras ?: return false
+            val nonce=extras.get(NONCE) as? String ?: return false
+            if (extras.get(VERSION) != 1 || !nonce.matches(Regex("[0-9a-f]{32}"))) return false
+            val receiver=extras.getParcelable<android.os.Parcelable>(RECEIVER) as? ResultReceiver
+                ?: return false
+            nonce to receiver
+        } catch (_: BadParcelableException) {
+            return false // An unavailable sender-private parcelable is a refused envelope, not a crash.
+        }
+        val (nonce, receiver) = envelope
+        val previous=active
+        if (previous != null && !previous.sent) {
+            if (previous.nonce != nonce) return false
+            previous.root=WeakReference(activity)
+            previous.activities.add(activity)
+            return true
+        }
+        // A recreated Intent cannot reconstruct accepted intent or native closure after process death.
+        if (restored) return false
+        previous?.scope?.cancel()
+        val record=Active(nonce,receiver,activity)
+        record.activities.add(activity)
+        active=record
+        val callbacks=object : Application.ActivityLifecycleCallbacks {
+            override fun onActivityCreated(a: Activity,b: Bundle?) {
+                if (active === record && !record.sent && a.intent.action != Intent.ACTION_MAIN) record.activities.add(a)
+            }
+            override fun onActivityStarted(a: Activity) {
+                if (record.activities.contains(a)) record.started.add(a)
+            }
+            override fun onActivityStopped(a: Activity) {
+                if (!record.activities.contains(a)) return
+                record.started.remove(a)
+                if (!a.isChangingConfigurations) main.post {
+                    if (active === record && !record.sent && record.started.isEmpty()
+                        && record.external.isEmpty()) requestFinish()
+                }
+            }
+            override fun onActivityDestroyed(a: Activity) {
+                record.started.remove(a);record.activities.remove(a)
+                if (a === record.root.get() && !a.isChangingConfigurations && !record.sent) {
+                    record.outcome.interrupted()
+                    deliver(record,null)
+                }
+            }
+            override fun onActivityResumed(a: Activity) {}
+            override fun onActivityPaused(a: Activity) {}
+            override fun onActivitySaveInstanceState(a: Activity,b: Bundle) {}
+        }
+        record.callbacks=callbacks
+        activity.application.registerActivityLifecycleCallbacks(callbacks)
+        return true
+    }
+    fun attachService(service: EuiccChannelManagerService) {
+        active?.takeUnless { it.sent }?.let {
+            it.service=service
+            if (it.closing) startFinish(it)
+        }
+    }
+    fun isActive()=active?.sent == false
+    fun isClosing()=active?.closing == true
+    fun isActiveFor(activity: Activity?)=active?.let {
+        !it.sent && activity != null && it.activities.contains(activity)
+    } == true
+    fun isClosingFor(activity: Activity?)=active?.let {
+        activity != null && activity.intent.getStringExtra(NONCE) == it.nonce && it.closing
+    } == true
+    private val foregroundWork=ThreadLocal<ManagementSessionOutcome.Work?>()
+    fun captureWork(): ManagementSessionOutcome.Work? = foregroundWork.get()
+        ?: active?.takeUnless {it.sent}?.outcome?.work()
+    fun requireWork(work: ManagementSessionOutcome.Work?) {
+        if (work != null && !work.allowed()) throw HonorLpaLeaseClient.EndpointNotReady()
+    }
+    /** Capture before the service queues its asynchronous foreground-start wait. */
+    fun enqueueForegroundWork(): ManagementSessionOutcome.Work? {
+        val record=active?.takeUnless {it.sent} ?: return null
+        return record.outcome.enqueueWork() ?: throw HonorLpaLeaseClient.EndpointNotReady()
+    }
+    fun foregroundContext(work: ManagementSessionOutcome.Work?) = foregroundWork.asContextElement(work)
+    fun scopeGranted(): ManagementSessionOutcome.Grant? =
+        active?.takeUnless {it.sent}?.outcome?.granted()
+    fun scopeCompleted(stamp: ManagementSessionOutcome.Grant?,lease: com.honor.ldy_an00.lease.HonorLpaLease,
+        knownBlank: Boolean,kind: Int,target: String?) {
+        if (stamp == null) return
+        active?.takeUnless {it.sent || it.nonce != stamp.nonce}?.outcome?.scopeCompleted(stamp,
+            ManagementSessionOutcome.Scope(lease.cardId,lease.operation,lease.token,lease.generation.toLong(),
+                lease.routeSerial.toInt(),lease.observationSerial.toInt()),knownBlank,kind,target)
+    }
+    fun scopeUncertain(stamp: ManagementSessionOutcome.Grant?,native: Boolean) {
+        if (stamp == null) return
+        active?.takeUnless {it.sent || it.nonce != stamp.nonce}?.outcome?.interrupted(stamp,native)
+    }
+    fun childStarting(activity: Activity,intent: Intent,request: Int): Boolean {
+        val record=active ?: return false
+        if (record.sent || request < 0 || !record.activities.contains(activity)) return false
+        val target=intent.component?.packageName ?: intent.getPackage()
+            ?: activity.packageManager.resolveActivity(intent,PackageManager.MATCH_DEFAULT_ONLY)?.activityInfo?.packageName
+        if (target == activity.packageName) return false
+        record.external.add(activity to request)
+        return true
+    }
+    fun childReturned(activity: Activity,request: Int) { active?.external?.remove(activity to request) }
+    fun childFailed(activity: Activity,request: Int) = childReturned(activity,request)
+    fun requestFinish() {
+        val record=active ?: return
+        if (record.sent) return
+        record.outcome.beginClosing()
+        record.closing=true
+        startFinish(record)
+    }
+    private fun startFinish(record: Active) {
+        if (record.sent || record.finishJob?.isActive == true) return
+        val service=record.service ?: return
+        record.finishJob=record.scope.launch {
+            service.waitForForegroundTask() // Never cancels a foreground/native operation.
+            // Profile operations verify their own results. Closing only proves that no
+            // channel or unresolved operation remains before Settings checks the route.
+            val drained=HonorLpaLeaseClient.managementDone(
+                service.applicationContext,service.euiccChannelManager,
+                { record.outcome.hasClosedBlank() }, { record.outcome.freezeWork() })
+            deliver(record,record.outcome.complete(drained))
+        }
+    }
+    private fun deliver(record: Active,keep: Boolean?) {
+        if (record.sent) return
+        record.outcome.freezeWork()
+        record.sent=true;record.closing=true
+        val positive=keep != null
+        val data=Bundle().apply {
+            putInt(VERSION,1);putString(NONCE,record.nonce)
+            putBoolean(DONE,positive);putBoolean(DRAINED,positive);putBoolean(KEEP,keep == true)
+        }
+        val result=if(positive) Activity.RESULT_OK else Activity.RESULT_CANCELED
+        record.root.get()?.setResult(result,Intent().putExtras(data))
+        record.receiver?.send(result,data)
+        record.receiver=null
+        val application=record.root.get()?.application
+        record.callbacks?.let {application?.unregisterActivityLifecycleCallbacks(it)}
+        record.callbacks=null
+        record.activities.toList().asReversed().forEach {it.finish()}
+        record.activities.clear();record.started.clear();record.external.clear();record.service=null
+    }
+}
