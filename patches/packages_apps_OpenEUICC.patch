index 0000000..a7eb8e6
--- /dev/null
+++ b/app-common/src/main/java/im/angry/openeuicc/core/HonorLpaLeaseClient.kt
@@ -0,0 +1,301 @@
+package im.angry.openeuicc.core
+
+import android.content.ComponentName
+import android.content.Context
+import android.content.Intent
+import android.content.ServiceConnection
+import android.os.Binder
+import android.os.Build
+import android.os.IBinder
+import com.honor.ldy_an00.lease.HonorLpaLease
+import com.honor.ldy_an00.lease.IHonorLpaLease
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+import kotlinx.coroutines.CompletableDeferred
+import kotlinx.coroutines.NonCancellable
+import kotlinx.coroutines.asContextElement
+import kotlinx.coroutines.withContext
+import kotlinx.coroutines.withTimeout
+
+/** Actual Phone binding and local channel drain. It never selects an eUICC route. */
+internal object HonorLpaLeaseClient {
+    // Image-bound controlled trial only; hardware behavior remains unproven.
+    private const val CLIENT_RUNTIME_QUALIFIED = true
+    private val admission = LpaChannelAdmission()
+    private val sessionLock = Mutex()
+    @Volatile var knownBlankForUi = false
+        private set
+    class KnownBlankRoute : IllegalStateException("No active eSIM endpoint; return through SIM settings")
+    class EndpointNotReady : IllegalStateException("No eSIM endpoint is ready")
+    private val identity = ThreadLocal<Any?>()
+    private var journal: HonorLpaOperationJournal? = null
+    data class Target(val operation: Int, val slot: Int, val port: Int, val cardId: Int)
+    fun requiresCloseProof() = CLIENT_RUNTIME_QUALIFIED && isHonorBuild()
+    fun isHonorBuild() = Build.MODEL == "LDY-AN00" && Build.DEVICE == "ldy_an00"
+    @Synchronized fun initialize(context: Context) {
+        if (!CLIENT_RUNTIME_QUALIFIED || !isHonorBuild() || journal != null) return
+        try {
+            val loaded = HonorLpaOperationJournal(context)
+            if (!loaded.isClean()) admission.unknown()
+            journal = loaded
+        } catch (failure: Throwable) { admission.unknown(); throw failure }
+    }
+    @PublishedApi internal fun enterChannelAccess(): Boolean {
+        if (!CLIENT_RUNTIME_QUALIFIED || !isHonorBuild()) return false
+        check(journal != null) { "Operation journal unavailable" }
+        admission.enter(identity.get()); return true
+    }
+    @PublishedApi internal fun leaveChannelAccess(entered: Boolean) { if (entered) admission.leave() }
+    internal inline fun <T> withChannelAccess(block: () -> T): T {
+        val entered = enterChannelAccess()
+        try { return block() } finally { leaveChannelAccess(entered) }
+    }
+    /** Protected EuiccService operation, before discovery; never a passive Settings snapshot. */
+    suspend fun prepareKnownBlankForDiscovery(context: Context, slot: Int, port: Int, expectedCardId: Int = -1) {
+        if (!requiresCloseProof()) return
+        check(slot == 1 && port == 0 && expectedCardId >= -1) { "Only the qualified shared default port is supported" }
+        check(android.os.UserHandle.myUserId() == 0)
+        check(context.packageManager.checkSignatures("android","com.android.phone") ==
+            android.content.pm.PackageManager.SIGNATURE_MATCH)
+        withContext(Dispatchers.IO) {
+            sessionLock.withLock {
+                initialize(context)
+                val localOwner = Any()
+                admission.reserve(localOwner) // Existing UNKNOWN and active JNI readers remain blocked.
+                var bound = false
+                val connected = CompletableDeferred<IHonorLpaLease>()
+                val connection = object : ServiceConnection {
+                    override fun onServiceConnected(name: ComponentName, service: IBinder) {
+                        connected.complete(IHonorLpaLease.Stub.asInterface(service))
+                    }
+                    override fun onServiceDisconnected(name: ComponentName) {
+                        connected.completeExceptionally(IllegalStateException("Preparation disconnected"))
+                    }
+                    override fun onBindingDied(name: ComponentName) {
+                        connected.completeExceptionally(IllegalStateException("Preparation binding died"))
+                    }
+                    override fun onNullBinding(name: ComponentName) {
+                        connected.completeExceptionally(IllegalStateException("Preparation unavailable"))
+                    }
+                }
+                try {
+                    bound = context.bindService(Intent().setComponent(ComponentName("com.android.phone",
+                        "com.android.internal.telephony.honor.HonorLpaLeaseService")),connection,Context.BIND_AUTO_CREATE)
+                    check(bound) { "Preparation service unavailable" }
+                    val api = withTimeout(10_000) { connected.await() }
+                    // Never send the new transaction to a protocol-2 Phone.
+                    check(api.protocolVersion() == 4) { "Phone/LPA lease protocol version mismatch" }
+                    when (api.prepareKnownBlankEndpoint(slot,port,expectedCardId,Binder())) {
+                        IHonorLpaLease.PREPARE_NOT_NEEDED, IHonorLpaLease.PREPARE_READY -> {
+                            if (expectedCardId >= 0) {
+                                // A no-op is not a card certificate. Validate a real explicit target
+                                // before any UI enumerator can open an unrelated card.
+                                val tm = checkNotNull(context.getSystemService(android.telephony.TelephonyManager::class.java))
+                                val card = tm.uiccCardsInfo.singleOrNull {
+                                    it.cardId == expectedCardId && it.isEuicc && it.physicalSlotIndex == slot
+                                }
+                                check(card != null && tm.cardIdForDefaultEuicc == expectedCardId
+                                    && card.eid?.matches(Regex("[0-9]{32}")) == true
+                                    && card.ports.any { it.portIndex == port && it.isActive && it.logicalSlotIndex == 1 }) {
+                                    "Requested eUICC target is unavailable"
+                                }
+                            }
+                        }
+                        IHonorLpaLease.PREPARE_NOT_READY -> throw EndpointNotReady()
+                        else -> error("Known-blank endpoint preparation refused")
+                    }
+                } finally {
+                    if (bound) context.unbindService(connection)
+                    // This protocol method cannot grant/open/mutate. Do not clear an APDU journal;
+                    // its remote pending-read fence remains owned by Phone even on transport failure.
+                    admission.requireDrained(localOwner)
+                    admission.complete(localOwner)
+                }
+            }
+        }
+    }
+    fun requireMutationTarget(slot: Int, port: Int, cardId: Int) {
+        if (!isHonorBuild()) return
+        val session = NativeMutationBoundary.observer.get() as? Session
+            ?: error("A Phone-owned eSIM operation lease is required")
+        check(session.target.slot == slot && session.target.port == port && session.target.cardId == cardId)
+    }
+    private class Session(val api: IHonorLpaLease, val lease: HonorLpaLease,
+        val client: IBinder, val target: Target, val localOwner: Any) : NativeMutationBoundary.Observer {
+        var uncertain = false
+        var nativeInFlight = false
+        var resetPending = false
+        var lastKind = 0
+        var lastProfileBefore = false
+        var completedKnownBlank = false
+        override fun before(kind: Int,lastProfileBefore: Boolean,targetIccid: String?) {
+            check(!uncertain && !nativeInFlight && !resetPending)
+            if (!api.beginNativeTarget(lease, client, kind,lastProfileBefore,targetIccid)) { uncertain = true; error("Operation lease unavailable") }
+            lastKind=kind;this.lastProfileBefore=lastProfileBefore;nativeInFlight = true
+        }
+        override fun returned(kind: Int) {
+            check(nativeInFlight)
+            nativeInFlight = false
+            if (!api.nativeReturned(lease, client, true)) { uncertain = true; error("Native completion unavailable") }
+            resetPending = kind <= 4 || kind == 8
+        }
+        override fun uncertain() {
+            uncertain = true
+            if (nativeInFlight) {
+                nativeInFlight = false
+                try { api.nativeReturned(lease, client, false) } catch (_: Exception) { }
+            }
+        }
+    }
+    private fun activeSession(): Session {
+        val session = NativeMutationBoundary.observer.get() as? Session ?: error("Scoped channel session required")
+        check(!session.uncertain && !session.completedKnownBlank) { "Scoped channel session is uncertain or finished" }
+        return session
+    }
+    fun openScopedChannel(slot: Int,port: Int,card: Int,aid: String,p2: Int): com.honor.ldy_an00.lease.HonorLpaChannelResult {
+        requireMutationTarget(slot,port,card)
+        val session = activeSession()
+        try {
+            val result = session.api.openChannel(session.lease,session.client,aid,p2)
+            check(result != null && result.code == 1 && result.handle > 0 && result.channel in 1..19)
+            return result
+        } catch (failure: Throwable) { session.uncertain = true;throw failure }
+    }
+    fun transmitScopedChannel(handle: Long,command: ByteArray): ByteArray {
+        val session = activeSession()
+        try {
+            val result = session.api.transmitChannel(session.lease,session.client,handle,command)
+            check(result != null && result.handle == handle && result.code == 4 && result.data != null && result.data.size >= 2)
+            return result.data
+        } catch (failure: Throwable) { session.uncertain = true;throw failure }
+    }
+    fun closeScopedChannel(handle: Long): Int {
+        val session = activeSession()
+        try {
+            val result = session.api.closeChannel(session.lease,session.client,handle)
+            check(result != null && result.handle == handle && (result.code == 2 || result.code == 3))
+            return result.code
+        } catch (failure: Throwable) { session.uncertain = true;throw failure }
+    }
+    enum class ResetOutcome { READY, KNOWN_BLANK }
+    suspend fun closeAndRebindKnownNativeStep(manager: EuiccChannelManager): ResetOutcome {
+        if (!isHonorBuild()) return ResetOutcome.READY
+        val session = NativeMutationBoundary.observer.get() as? Session
+            ?: error("Operation lease required")
+        check(!session.uncertain && !session.nativeInFlight && session.resetPending)
+        // Reclamation must precede JNI finalization: any old close attempt is permanently ineligible.
+        val prepared=session.api.prepareResetReclamation(session.lease,session.client)
+        check(prepared==0 || prepared==1) { "Reset preparation was not confirmed" }
+        manager.invalidate() // Synchronous JNI fini/destroy; exact old retirement/close receipt required.
+        admission.requireDrained(session.localOwner)
+        val allowBlank=session.lastProfileBefore && (session.lastKind==3 || session.lastKind==4)
+        val result=session.api.reconcileResetStep(session.lease,session.client,true,allowBlank)
+        if(result==2 && allowBlank) {
+            session.resetPending=false;session.completedKnownBlank=true
+            return ResetOutcome.KNOWN_BLANK // No reopen, enumeration, notification or further APDU.
+        }
+        if(result!=1) {session.uncertain=true;error("Same-card route rebind was not confirmed")}
+        session.resetPending=false;return ResetOutcome.READY
+    }
+    suspend fun <T> withReadSession(context: Context,manager: EuiccChannelManager,target: Target,
+        operation: suspend () -> T): T {
+        if (!requiresCloseProof()) return operation()
+        val current = NativeMutationBoundary.observer.get() as? Session
+        if (current != null) {
+            requireMutationTarget(target.slot,target.port,target.cardId)
+            return operation()
+        }
+        return run(context,manager,target.copy(operation = 0),operation=operation)
+    }
+    suspend fun <T> run(context: Context,manager: EuiccChannelManager,requestedTarget: Target,
+        onKnownBlankCompleted: () -> Unit = {},operation: suspend () -> T): T =
+        withContext(Dispatchers.IO) {
+            sessionLock.withLock { runOnIo(context,manager,requestedTarget,onKnownBlankCompleted,operation) }
+        }
+    private suspend fun <T> runOnIo(context: Context, manager: EuiccChannelManager, requestedTarget: Target,
+        onKnownBlankCompleted: () -> Unit,operation: suspend () -> T): T {
+        check(CLIENT_RUNTIME_QUALIFIED && isHonorBuild()) { "Operation leases are not qualified" }
+        check(android.os.UserHandle.myUserId() == 0)
+        check(context.packageManager.checkSignatures("android","com.android.phone") == android.content.pm.PackageManager.SIGNATURE_MATCH)
+        val target = if (requestedTarget.cardId >= 0) requestedTarget else {
+            val tm = checkNotNull(context.getSystemService(android.telephony.TelephonyManager::class.java))
+            val card = tm.uiccCardsInfo.single { it.physicalSlotIndex == requestedTarget.slot && it.isEuicc }
+            check(card.ports.any { it.portIndex == requestedTarget.port && it.isActive && it.logicalSlotIndex == 1 })
+            requestedTarget.copy(cardId = card.cardId)
+        }
+        initialize(context)
+        val localOwner = Any()
+        admission.reserve(localOwner)
+        var bound = false
+        val connected = CompletableDeferred<IHonorLpaLease>()
+        val connection = object : ServiceConnection {
+            override fun onServiceConnected(name: ComponentName, service: IBinder) {
+                connected.complete(IHonorLpaLease.Stub.asInterface(service))
+            }
+            override fun onServiceDisconnected(name: ComponentName) { admission.unknown() }
+            override fun onBindingDied(name: ComponentName) { admission.unknown() }
+            override fun onNullBinding(name: ComponentName) { connected.completeExceptionally(IllegalStateException("Lease service unavailable")) }
+        }
+        var session: Session? = null
+        var knownNoGrant = false
+        try {
+            // Durable local admission closes the restart window BEFORE a remote grant or APDU.
+            journal!!.write(active = true)
+            return withContext(identity.asContextElement(localOwner)) {
+                manager.invalidate() // No other admitted reader or open attempt can race this close.
+                val intent = Intent().setComponent(ComponentName("com.android.phone",
+                    "com.android.internal.telephony.honor.HonorLpaLeaseService"))
+                bound = context.bindService(intent, connection, Context.BIND_AUTO_CREATE)
+                check(bound) { "Lease service unavailable" }
+                val api = withTimeout(10_000) { connected.await() }
+                val protocol=try { api.protocolVersion() }
+                    catch(failure: android.os.RemoteException) {
+                        throw IllegalStateException("Phone/LPA lease protocol version mismatch",failure)
+                    }
+                check(protocol==4) { "Phone/LPA lease protocol version mismatch" }
+                val client = Binder()
+                val grant = api.acquireV2(target.operation, target.slot, target.port, target.cardId, client)
+                check(grant != null)
+                if((grant.code==2 || grant.code==3) && grant.lease==null) {
+                    knownNoGrant=true
+                    if(grant.code==2) {knownBlankForUi=true;throw KnownBlankRoute()}
+                    throw EndpointNotReady()
+                }
+                check(grant.code==1)
+                val lease = grant.lease
+                check(lease != null && lease.physicalSlot == target.slot && lease.port == target.port && lease.cardId == target.cardId
+                    && lease.uid == android.os.Process.myUid() && lease.user == 0 && lease.operation == target.operation
+                    && lease.generation > 0 && ((lease.routeSerial > 0 && lease.observationSerial == -1)
+                        || (lease.routeSerial == 0 && lease.observationSerial > 0)) && lease.token.matches(Regex("[0-9a-f]{32}")))
+                val granted = Session(api, lease, client, target, localOwner); session = granted
+                withContext(NativeMutationBoundary.observer.asContextElement(granted)) {
+                    val result = operation()
+                    // This path is used only by the exact-profile reconciliation workflow.
+                    if(!granted.completedKnownBlank) manager.invalidate()
+                    admission.requireDrained(localOwner)
+                    check(!granted.uncertain && !granted.nativeInFlight && !granted.resetPending) { "Operation drain not confirmed" }
+                    if(!granted.completedKnownBlank) check(api.finish(lease, client, true)) { "Operation drain not confirmed" }
+                    journal!!.write(active = false)
+                    admission.complete(localOwner)
+                    if(granted.completedKnownBlank) {knownBlankForUi=true;onKnownBlankCompleted()}
+                    result
+                }
+            }
+        } catch (failure: Throwable) {
+            if(knownNoGrant) {
+                try {journal!!.write(active=false);admission.complete(localOwner)}
+                catch(clearFailure: Throwable) {admission.unknown();throw clearFailure}
+                throw failure // Only a positive typed no-grant receipt permits this local clear.
+            }
+            admission.unknown()
+            // No inferred drain on cancellation, transport loss, native false or close failure.
+            withContext(NonCancellable) {
+                session?.let { try { it.api.finish(it.lease, it.client, false) } catch (_: Exception) { } }
+            }
+            throw failure
+        } finally {
+            if (bound) context.unbindService(connection)
+        }
+    }
+}
