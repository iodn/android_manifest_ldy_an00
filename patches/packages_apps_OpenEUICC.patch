+++ b/app-common/src/test/java/im/angry/openeuicc/core/ManagementSessionOutcomeHostTest.kt
@@ -0,0 +1,103 @@
+package im.angry.openeuicc.core
+
+fun main() {
+    var checks=0
+    fun verify(value: Boolean) {checks++;check(value)}
+    val nonce="a".repeat(32)
+    val a="8900000000000000001";val b="8900000000000000002"
+    fun model()=ManagementSessionOutcome(nonce)
+    fun scope(op: Int=2,card: Int=7)=ManagementSessionOutcome.Scope(card,op,"b".repeat(32),1,3,-1)
+    // Already-enabled state is not an input or intent. Viewing never implies keep.
+    verify(model().complete(true) == false)
+    val use=model();use.accepted(2,7,a);verify(use.choice()==ManagementSessionOutcome.Choice(7,a))
+    verify(use.complete(true)==true);verify(use.complete(true)==null)
+    use.accepted(2,7,b);verify(use.choice()?.iccid==a)
+    for(kind in listOf(3,4)) {
+        val m=model();m.accepted(2,7,a);m.accepted(kind,7,b)
+        verify(m.choice()?.iccid==a)
+        m.accepted(kind,8,a);verify(m.choice()?.iccid==a)
+        m.accepted(kind,7,a);verify(m.choice()==null)
+        verify(m.complete(true)==false)
+    }
+    val notifications=model();notifications.accepted(2,7,a)
+    for(kind in listOf(1,5,6,7)) notifications.accepted(kind,7,null)
+    verify(notifications.choice()?.iccid==a)
+    val reset=model();reset.accepted(2,7,a);reset.accepted(8,7,null)
+    verify(reset.complete(true)==false)
+    // Only whole positive scope completion commits accepted framework/download-enable intent.
+    val framework=model();val fg=framework.granted()
+    verify(framework.choice()==null)
+    framework.scopeCompleted(fg,scope(),false,2,b)
+    verify(framework.choice()?.iccid==b)
+    verify(framework.complete(true)==true)
+    val downloadOnly=model();val dg=downloadOnly.granted()
+    downloadOnly.scopeCompleted(dg,scope(1),false,1,null)
+    verify(downloadOnly.complete(true)==false)
+    val failed=model();val failedGrant=failed.granted()
+    failed.interrupted(failedGrant,true)
+    failed.scopeCompleted(failedGrant,scope(),false,2,a)
+    verify(failed.choice()==null && failed.complete(true)==null)
+    val unconfirmed=model();unconfirmed.accepted(2,7,a)
+    verify(unconfirmed.complete(false)==null)
+    // Exact current nonce/sequence + native operation, never a historical UI bool.
+    val blank=model();val g=blank.granted()
+    blank.scopeCompleted(g,scope(2),true,3,a)
+    verify(blank.hasClosedBlank());verify(blank.choice()==null)
+    val later=blank.granted();verify(!blank.hasClosedBlank())
+    blank.scopeCompleted(g,scope(2),true,3,a);verify(!blank.hasClosedBlank())
+    blank.scopeCompleted(later,scope(3),true,4,a);verify(blank.hasClosedBlank())
+    blank.interrupted(later,false);verify(!blank.hasClosedBlank())
+    val previous=model();val old=previous.granted()
+    val newSession=ManagementSessionOutcome("c".repeat(32));newSession.granted()
+    newSession.scopeCompleted(old,scope(2),true,3,a)
+    verify(!newSession.hasClosedBlank());verify(newSession.choice()==null)
+    val deadProcess=ManagementSessionOutcome(nonce)
+    verify(!deadProcess.hasClosedBlank())
+    for(pair in listOf(2 to 4,3 to 3,1 to 3)) {
+        val mismatch=model();val mg=mismatch.granted()
+        mismatch.scopeCompleted(mg,scope(pair.first),true,pair.second,a)
+        verify(!mismatch.hasClosedBlank() && mismatch.complete(true)==null)
+    }
+    val wrongToken=model();val wt=wrongToken.granted()
+    wrongToken.scopeCompleted(wt,scope().copy(token="bad"),true,3,a)
+    verify(!wrongToken.hasClosedBlank() && wrongToken.complete(true)==null)
+    val staleLoss=model();val first=staleLoss.granted();val current=staleLoss.granted()
+    staleLoss.interrupted(first,true)
+    staleLoss.scopeCompleted(current,scope(),false,2,b)
+    verify(staleLoss.complete(true)==true)
+    // Reproduce the old unversioned callback: it incorrectly overwrites the newer choice.
+    val legacy=model();val legacyRead=legacy.granted()
+    legacy.scopeCompleted(legacyRead,scope().copy(operation=0),false,2,a)
+    val legacyFramework=legacy.granted()
+    legacy.scopeCompleted(legacyFramework,scope(),false,2,b)
+    legacy.accepted(2,7,a)
+    verify(legacy.choice()!=ManagementSessionOutcome.Choice(7,b))
+    // An earlier Use-current READ receipt cannot overwrite a later framework enable.
+    val ordered=model();val useGrant=ordered.granted()
+    ordered.scopeCompleted(useGrant,scope().copy(operation=0),false,2,a)
+    val newerGrant=ordered.granted()
+    ordered.scopeCompleted(newerGrant,scope(),false,2,b)
+    ordered.scopeCompleted(useGrant,scope().copy(operation=0),false,2,a)
+    verify(ordered.choice()==ManagementSessionOutcome.Choice(7,b))
+    verify(ordered.complete(true)==true)
+    val fence=model();val queued=fence.work()
+    val worker=checkNotNull(fence.enqueueWork())
+    val finalRead=fence.work(allowClosing=true,readOnly=true)
+    verify(queued.allowed());fence.beginClosing()
+    verify(!queued.allowed());verify(fence.enqueueWork()==null);verify(worker.allowed(3))
+    verify(finalRead.allowed(0));verify(!finalRead.allowed(2))
+    fence.freezeWork()
+    verify(!worker.allowed(3));verify(!finalRead.allowed(0))
+    verify(!queued.allowed());verify(!fence.work().allowed())
+    val nextSession=ManagementSessionOutcome("d".repeat(32))
+    verify(nextSession.work().allowed());verify(!queued.allowed())
+    val admission=LpaChannelAdmission();admission.requireIdle();verify(true)
+    val owner=Any();admission.reserve(owner)
+    val busy=runCatching {admission.requireIdle()}.exceptionOrNull()
+    verify(busy is LpaChannelAdmission.Unavailable && !busy.uncertain)
+    admission.complete(owner);admission.requireIdle();verify(true)
+    admission.reserve(owner);admission.unknownIfOwned(owner)
+    val unknown=runCatching {admission.requireIdle()}.exceptionOrNull()
+    verify(unknown is LpaChannelAdmission.Unavailable && unknown.uncertain)
+    println("MANAGEMENT_SESSION_OUTCOME_HOST_PASS checks=$checks")
+}
