diff --git a/host-tests/profile-publication/DownloadedProfileRefreshRequestTest.kt b/host-tests/profile-publication/DownloadedProfileRefreshRequestTest.kt
new file mode 100644
index 0000000..1fa4d8b
--- /dev/null
+++ b/host-tests/profile-publication/DownloadedProfileRefreshRequestTest.kt
@@ -0,0 +1,49 @@
+package im.angry.openeuicc.core
+
+import android.telephony.UiccCardInfo
+import android.telephony.UiccPortInfo
+import org.junit.Assert.*
+import org.junit.Test
+
+class DownloadedProfileRefreshRequestTest {
+    private val eid="89000000000000000000000000000001"
+    private fun card(id:Int=0, slot:Int=1, value:String=eid, euicc:Boolean=true,
+        ports:List<UiccPortInfo> = listOf(UiccPortInfo("",0,1,true))) =
+        UiccCardInfo(euicc,id,value,slot,true,false,ports)
+    private fun fails(block:()->Unit) {
+        try {block();fail("must refuse")} catch (_:IllegalArgumentException) {}
+        catch (_:IllegalStateException) {} catch (_:NoSuchElementException) {}
+    }
+    @Test fun requestUsesCapturedCardZeroNotDefaultOrAllCards() {
+        val requests=mutableListOf<Int>()
+        val target=DownloadedProfileRefreshRequest(1,0,0,{listOf(card(5,2),card())},{requests+=it})
+        target.request()
+        assertEquals(listOf(0),requests)
+    }
+    @Test fun missingOrAmbiguousCardRefusesBeforeAnyPublication() {
+        var requests=0
+        fails {DownloadedProfileRefreshRequest(1,0,0,{emptyList()},{requests++})}
+        fails {DownloadedProfileRefreshRequest(1,0,0,{listOf(card(),card())},{requests++})}
+        assertEquals(0,requests)
+    }
+    @Test fun captureRequiresRealEidActiveMappedPortAndEuicc() {
+        for (bad in listOf(card(value=""),card(euicc=false),
+            card(ports=listOf(UiccPortInfo("",0,-1,true))),
+            card(ports=listOf(UiccPortInfo("",0,1,false))),
+            card(ports=listOf(UiccPortInfo("",1,1,true))))) {
+            fails {DownloadedProfileRefreshRequest(1,0,0,{listOf(bad)},{fail("no request")})}
+        }
+    }
+    @Test fun changedEidCardSlotPortOrPhoneNeverRefreshes() {
+        for (bad in listOf(card(value="89000000000000000000000000000002"),card(id=5),
+            card(slot=2),card(ports=listOf(UiccPortInfo("",0,0,true))),
+            card(ports=listOf(UiccPortInfo("",1,1,true))),
+            card(ports=listOf(UiccPortInfo("",0,1,false))))) {
+            var cards=listOf(card());var requests=0
+            val target=DownloadedProfileRefreshRequest(1,0,0,{cards},{requests++})
+            cards=listOf(bad)
+            fails {target.request()}
+            assertEquals(0,requests)
+        }
+    }
+}
diff --git a/host-tests/profile-publication/EuiccUiRoutingTest.kt b/host-tests/profile-publication/EuiccUiRoutingTest.kt
new file mode 100644
index 0000000..4b88c10
--- /dev/null
+++ b/host-tests/profile-publication/EuiccUiRoutingTest.kt
@@ -0,0 +1,62 @@
+package im.angry.openeuicc.ui
+
+import android.content.ComponentName
+import android.content.Intent
+import android.service.euicc.EuiccService
+import android.telephony.UiccCardInfo
+import android.telephony.UiccPortInfo
+import org.junit.Assert.*
+import org.junit.Test
+
+class EuiccUiRoutingTest {
+    private val eid = "89000000000000000000000000000001"
+    private fun card(id: Int, slot: Int = 1, value: String = eid,
+        ports: List<UiccPortInfo> = listOf(UiccPortInfo("",0,1,true))) =
+        UiccCardInfo(true,id,value,slot,true,false,ports)
+    private fun manage() = Intent(EuiccService.ACTION_MANAGE_EMBEDDED_SUBSCRIPTIONS)
+
+    @Test fun managePreservesTargetExtrasFlagsAndOriginal() {
+        val source=manage().putExtra(EuiccService.EXTRA_RESOLUTION_CARD_ID,0)
+            .putExtra(EuiccService.EXTRA_RESOLUTION_PORT_INDEX,0)
+            .putExtra("android.telephony.euicc.extra.FORCE_PROVISION",false)
+            .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+        val target=ComponentName("im.angry.openeuicc","im.angry.openeuicc.ui.PrivilegedMainActivity")
+        val out=EuiccUiRouting.managementIntent(source,target)!!
+        assertEquals(target,out.component)
+        assertEquals(0,out.getIntExtra(EuiccService.EXTRA_RESOLUTION_CARD_ID,-1))
+        assertEquals(0,out.getIntExtra(EuiccService.EXTRA_RESOLUTION_PORT_INDEX,-1))
+        assertEquals(source.flags,out.flags)
+        assertFalse(out.getBooleanExtra("android.telephony.euicc.extra.FORCE_PROVISION",true))
+        assertNull(source.component)
+        assertNotSame(source,out)
+    }
+    @Test fun provisionStaysDownloadFlow() {
+        assertNull(EuiccUiRouting.managementIntent(
+            Intent(EuiccService.ACTION_PROVISION_EMBEDDED_SUBSCRIPTION),
+            ComponentName("im.angry.openeuicc","manager")))
+    }
+    @Test fun requestedCardZeroIsValidAndNeverUsesOtherCard() {
+        val source=manage().putExtra(EuiccService.EXTRA_RESOLUTION_CARD_ID,0)
+        assertEquals(listOf(1 to 0),EuiccUiRouting.managementPorts(source,5,listOf(card(5,2),card(0))))
+    }
+    @Test fun absentRequestedCardDoesNotFallBackToDefault() {
+        val source=manage().putExtra(EuiccService.EXTRA_RESOLUTION_CARD_ID,7)
+        assertTrue(EuiccUiRouting.managementPorts(source,5,listOf(card(5))).isEmpty())
+    }
+    @Test fun unknownDefaultDoesNotFallBackToAnyCard() {
+        assertTrue(EuiccUiRouting.managementPorts(manage(),-1,listOf(card(5))).isEmpty())
+    }
+    @Test fun defaultCardSelectsGenuineMappedEuicc() {
+        assertEquals(listOf(1 to 0),EuiccUiRouting.managementPorts(manage(),5,listOf(card(5))))
+    }
+    @Test fun requestedPortMustBeActiveAndMapped() {
+        val source=manage().putExtra(EuiccService.EXTRA_RESOLUTION_PORT_INDEX,1)
+        assertTrue(EuiccUiRouting.managementPorts(source,5,listOf(card(5))).isEmpty())
+        assertTrue(EuiccUiRouting.managementPorts(source,5,listOf(card(5,ports=listOf(UiccPortInfo("",1,-1,true))))).isEmpty())
+        assertTrue(EuiccUiRouting.managementPorts(source,5,listOf(card(5,ports=listOf(UiccPortInfo("",1,1,false))))).isEmpty())
+    }
+    @Test fun missingEidOrAmbiguousCardCannotSelect() {
+        assertTrue(EuiccUiRouting.managementPorts(manage(),5,listOf(card(5,value=""))).isEmpty())
+        assertTrue(EuiccUiRouting.managementPorts(manage(),5,listOf(card(5),card(5,2))).isEmpty())
+    }
+}
