diff --git a/libs/lpac-jni/src/test/java/net/typeblog/lpac_jni/ReadOnlyRecoveryHostTest.kt b/libs/lpac-jni/src/test/java/net/typeblog/lpac_jni/ReadOnlyRecoveryHostTest.kt
new file mode 100644
index 0000000000000000000000000000000000000000..8b7fa4ef265f5ea0a5e49d7e2f45921d0ca5fda1
--- /dev/null
+++ b/libs/lpac-jni/src/test/java/net/typeblog/lpac_jni/ReadOnlyRecoveryHostTest.kt
@@ -0,0 +1,66 @@
+package net.typeblog.lpac_jni
+
+fun main() {
+    var checks=0
+    fun verify(value: Boolean) {check(value);checks++}
+    class Apdu : ApduInterface {
+        var opened=false
+        override val valid: Boolean get()=opened
+        override fun connect() {}
+        override fun disconnect() {}
+        override fun logicalChannelOpen(aid: ByteArray): Int {check(!opened);opened=true;return 1}
+        override fun logicalChannelClose(handle: Int) {check(opened && handle == 1);opened=false}
+        override fun transmit(handle: Int,tx: ByteArray): ByteArray = error("No synthetic device execution")
+    }
+    class Calls(val fail: String?=null,val rows: Int=2) : ReadOnlyRecovery.Calls {
+        val events=mutableListOf<String>()
+        lateinit var apdu: ApduInterface
+        private fun step(name: String) {
+            events += name
+            if (fail == name) error("Synthetic $name failure")
+            if (fail == "cancel" && name == "eid") throw java.util.concurrent.CancellationException()
+        }
+        override fun create(apdu: ApduInterface): Long {
+            this.apdu=apdu;step("create");return if(fail == "no-context") 0 else 42
+        }
+        override fun init(context: Long): Int {
+            check(context == 42L);step("init")
+            if(fail == "init-negative") return -1
+            apdu.logicalChannelOpen(byteArrayOf(1));return 0
+        }
+        override fun eid(context: Long): String {
+            check(context == 42L);step("eid")
+            return if(fail == "bad-eid") "invalid" else "1".repeat(32)
+        }
+        override fun profiles(context: Long): Long {check(context == 42L);step("profiles");return if(rows == 0) 0 else 100}
+        override fun next(profile: Long): Long {step("next");return if(profile == 100L && rows > 1) 101 else 0}
+        override fun iccid(profile: Long): String {
+            step("iccid");return if(fail == "duplicate") "same" else "profile$profile"
+        }
+        override fun state(profile: Long): String {step("state");return if(fail == "bad-state") "unknown" else "disabled"}
+        override fun free(head: Long) {check(head == 0L || head == 100L);step("free")}
+        override fun finish(context: Long) {check(context == 42L);step("finish");apdu.logicalChannelClose(1)}
+        override fun destroy(context: Long) {check(context == 42L);step("destroy")}
+    }
+    val normal=Calls();val connection=Apdu()
+    verify(ReadOnlyRecovery.read(connection,normal) == 2)
+    verify(normal.events.count { it == "eid" } == 1 && normal.events.count { it == "profiles" } == 1)
+    verify(normal.events.takeLast(3) == listOf("free","finish","destroy") && !connection.valid)
+    val empty=Calls(rows=0);verify(ReadOnlyRecovery.read(Apdu(),empty) == 0)
+    verify(empty.events.takeLast(3) == listOf("free","finish","destroy"))
+    for (failure in listOf("create","no-context","init","init-negative","bad-eid","profiles","next","duplicate",
+        "bad-state","free","finish","destroy","cancel")) {
+        val calls=Calls(failure);val apdu=Apdu()
+        verify(runCatching { ReadOnlyRecovery.read(apdu,calls) }.isFailure)
+        if (failure == "create" || failure == "no-context") verify(calls.events == listOf("create"))
+        else {
+            verify(calls.events.last() == "destroy")
+            if (failure == "init" || failure == "init-negative") verify("finish" !in calls.events)
+            else verify("finish" in calls.events)
+        }
+        verify(calls.events.count { it == "create" } == 1)
+        verify(calls.events.count { it == "eid" } <= 1 && calls.events.count { it == "profiles" } <= 1)
+        if (failure == "bad-eid" || failure == "cancel") verify("profiles" !in calls.events)
+    }
+    println("READ_ONLY_RECOVERY_HOST_PASS checks=$checks")
+}
