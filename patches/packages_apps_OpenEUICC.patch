+            initialize(context)
+            val hash=journal!!.recoveryHash()
+            withRecoveryApi(context) { api ->
+                val status=recoveryRpc { api.recoveryStatus(recoveryHash) }
+                if (status == IHonorLpaLease.RECOVERY_DONE && (hash != null || admission.isUnknown())) {
+                    // Phone DONE requires current L1 C/no binding; stale DONE under a new U is refused.
+                    admission.acknowledgeRecoveryAfterDone(
+                        done = { recoveryRpc { api.recoveryStatus(recoveryHash) } == IHonorLpaLease.RECOVERY_DONE },
+                        markClean = { if (hash != null) journal!!.acknowledgeRecovery(hash) })
+                    knownBlankForUi=false
+                }
