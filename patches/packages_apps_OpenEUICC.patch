+    val unqualified = LogicalChannelCloseReceipt()
+    unqualified.opened(1);rejects { unqualified.closedScoped(1,0) };rejects { unqualified.requireAllClosed() }
+    // A drained real owner can observe asynchronous loss without hiding programming checks.
+    val lost = LpaChannelAdmission();val lostOwner=Any();val wrongOwner=Any()
+    lost.reserve(lostOwner);lost.unknownIfOwned(lostOwner)
