index 0000000000000000000000000000000000000000..7e4f4b223d37aa59bea213ecf7a57a012b2454f1
--- /dev/null
+++ b/libs/lpac-jni/src/main/jni/lpac-jni/lpac-download-proof.c
@@ -0,0 +1,95 @@
+#include "lpac-download-proof.h"
+#include <euicc/derutil.h>
+#include <string.h>
+
+void lpac_download_proof_clear(struct lpac_download_proof *proof) {
+    memset(proof,0,sizeof(*proof));
+}
+void lpac_download_proof_begin(struct lpac_download_proof *proof,const void *context,
+                             uint64_t nonce,bool fresh) {
+    lpac_download_proof_clear(proof);
+    proof->context=context;proof->nonce=nonce;proof->thread=pthread_self();proof->fresh=fresh;
+}
+static bool current(struct lpac_download_proof *proof) {
+    return proof->nonce!=0 && pthread_equal(proof->thread,pthread_self());
+}
+void lpac_download_proof_phase(struct lpac_download_proof *proof,unsigned phase) {
+    if(!current(proof) || phase<=proof->phase || phase>LPAC_DOWNLOAD_INSTALL) {
+        lpac_download_proof_clear(proof);return;
+    }
+    proof->phase=phase;
+}
+void lpac_download_proof_card_call(struct lpac_download_proof *proof,bool entered) {
+    if(!current(proof)) {lpac_download_proof_clear(proof);return;}
+    proof->card_call=entered;
+}
+void lpac_download_proof_before_io(struct lpac_download_proof *proof) {
+    if(proof->nonce && (proof->ready || !proof->card_call)) lpac_download_proof_clear(proof);
+}
+void lpac_download_proof_http_failure(struct lpac_download_proof *proof) {
+    proof->ready=current(proof) && proof->fresh && !proof->card_call
+        && (proof->phase==LPAC_DOWNLOAD_READ_ONLY || proof->phase==LPAC_DOWNLOAD_SESSION);
+    proof->cancel_reason=1; // Postponed: HTTP delivery did not finish.
+}
+void lpac_download_proof_user_cancel(struct lpac_download_proof *proof) {
+    if(!current(proof) || !proof->fresh || proof->card_call
+            || proof->phase>LPAC_DOWNLOAD_SESSION) {
+        lpac_download_proof_clear(proof);return;
+    }
+    // Phase zero qualifies only here: the explicit callback declined before any card dispatch.
+    if(proof->phase==LPAC_DOWNLOAD_UNKNOWN)proof->phase=LPAC_DOWNLOAD_READ_ONLY;
+    proof->cancel_reason=0;proof->ready=true;
+}
+unsigned lpac_download_proof_take(struct lpac_download_proof *proof,const void *context,uint64_t nonce,unsigned *reason) {
+    unsigned phase=proof->ready && current(proof) && proof->context==context && proof->nonce==nonce
+        ? proof->phase : LPAC_DOWNLOAD_UNKNOWN;
+    *reason=phase==LPAC_DOWNLOAD_UNKNOWN ? 127 : proof->cancel_reason;
+    lpac_download_proof_clear(proof); // Consume before any cancellation I/O, including on mismatch.
+    return phase;
+}
+/* Use the existing decoder, with exact canonical TLV boundaries and schema tags. */
+static bool first(struct euicc_derutil_node *out,const uint8_t *bytes,uint32_t length,uint16_t tag) {
+    unsigned head=tag>255 ? 2 : 1;
+    if(!bytes || length<=head || bytes[0]!=(tag>255 ? tag>>8 : tag)
+            || (head==2 && bytes[1]!=(tag&255))) return false;
+    unsigned count=bytes[head]&0x7f;
+    if(bytes[head]&0x80) {
+        if(count==0 || count>4 || length<=head+count || bytes[head+1]==0) return false;
+        uint32_t value=0;
+        for(unsigned i=0;i<count;i++)value=(value<<8)|bytes[head+1+i];
+        if(value<128) return false;
+    }
+    return euicc_derutil_unpack_first(out,bytes,length)==0 && out->tag==tag
+        && out->self.ptr==bytes && out->self.length<=length;
+}
+static bool child(struct euicc_derutil_node *out,const struct euicc_derutil_node *parent,
+                  uint32_t offset,uint16_t tag) {
+    return offset<parent->length && first(out,parent->value+offset,parent->length-offset,tag);
+}
+static bool oid(const uint8_t *bytes,uint32_t length) {
+    if(!length)return false;
+    bool beginning=true;
+    for(uint32_t i=0;i<length;i++) {
+        if(beginning && bytes[i]==0x80)return false;
+        beginning=(bytes[i]&0x80)==0;
+    }
+    return beginning;
+}
+bool lpac_download_cancel_accepted(const uint8_t *bytes,uint32_t length,
+                                  const uint8_t *transaction,uint32_t transaction_length,
+                                  unsigned reason) {
+    struct euicc_derutil_node outer,ok,signed_data,signature,id,smdp,why;
+    if(!transaction || transaction_length==0 || transaction_length>16 || reason>127
+            || !first(&outer,bytes,length,0xbf41) || outer.self.length!=length
+            || !child(&ok,&outer,0,0xa0) || ok.self.length!=outer.length
+            || !child(&signed_data,&ok,0,0x30)
+            || !child(&signature,&ok,signed_data.self.length,0x5f37)
+            || signed_data.self.length+signature.self.length!=ok.length || signature.length==0
+            || !child(&id,&signed_data,0,0x80) || id.length!=transaction_length
+            || memcmp(id.value,transaction,transaction_length)!=0
+            || !child(&smdp,&signed_data,id.self.length,0x81) || !oid(smdp.value,smdp.length)
+            || !child(&why,&signed_data,id.self.length+smdp.self.length,0x82)
+            || id.self.length+smdp.self.length+why.self.length!=signed_data.length
+            || why.length!=1 || why.value[0]!=reason) return false;
+    return true;
+}
