@@ -0,0 +1,22 @@
+package im.angry.openeuicc.core
+
+/** Positive closes only; a false/exception remains uncertain even if another handle closes. */
+class LogicalChannelCloseReceipt {
+    private val open = mutableSetOf<Int>()
+    private var uncertain = false
+    @Synchronized fun opened(handle: Int) { check(open.add(handle)) }
+    @Synchronized fun owns(handle: Int) = open.contains(handle)
+    @Synchronized fun hasOpen() = open.isNotEmpty()
+    @Synchronized fun closed(handle: Int, acknowledged: Boolean) {
+        check(open.contains(handle))
+        if (acknowledged) open.remove(handle) else uncertain = true
+    }
+    @Synchronized fun closedScoped(handle: Int,disposition: Int) {
+        if(disposition!=2 && disposition!=3) {uncertain=true;error("Unknown scoped channel close")}
+        closed(handle,true)
+    }
+    @Synchronized fun failed() { uncertain = true }
+    @Synchronized fun requireAllClosed() {
+        check(!uncertain && open.isEmpty()) { "Logical channel close is unconfirmed" }
+    }
+}
diff --git a/app-common/src/main/java/im/angry/openeuicc/core/LpaChannelAdmission.kt b/app-common/src/main/java/im/angry/openeuicc/core/LpaChannelAdmission.kt
