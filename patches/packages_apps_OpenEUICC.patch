@@ -0,0 +1,25 @@
+package im.angry.openeuicc.core
+
+/** Process-local admission. UNKNOWN cannot be released by cancellation or a timeout. */
+internal class LpaChannelAdmission {
+    class Unavailable : IllegalStateException("eSIM channels are reserved or unknown")
+    private enum class State { IDLE, RESERVED, UNKNOWN }
+    private var state = State.IDLE
+    private var owner: Any? = null
+    private var readers = 0
+    @Synchronized fun enter(token: Any?) {
+        if (!(state == State.IDLE || state == State.RESERVED && token === owner)) throw Unavailable()
+        readers++
+    }
+    @Synchronized fun leave() { check(readers > 0); readers-- }
+    @Synchronized fun reserve(token: Any) {
+        check(state == State.IDLE && readers == 0) { "eSIM channels are in use or unknown" }
+        state = State.RESERVED; owner = token
+    }
+    @Synchronized fun complete(token: Any) {
+        check(state == State.RESERVED && token === owner && readers == 0)
+        state = State.IDLE; owner = null
+    }
+    @Synchronized fun unknown() { state = State.UNKNOWN }
+    @Synchronized fun requireDrained(token: Any) { check(state == State.RESERVED && token === owner && readers == 0) }
+}
