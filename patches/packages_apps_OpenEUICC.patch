@@ -0,0 +1,52 @@
+package im.angry.openeuicc.core
+
+import android.content.Context
+import android.system.Os
+import android.system.OsConstants
+import android.util.AtomicFile
+import java.io.File
+
+/** An interrupted operation forbids new local channel opens after an LPA process restart. */
+internal class HonorLpaOperationJournal(context: Context) {
+    private val directory = context.createDeviceProtectedStorageContext().noBackupFilesDir
+    private val path = File(directory, "honor-ldy-lpa-operation")
+    private val file = AtomicFile(path)
+    private fun noInterruptedWrite() {
+        for (suffix in listOf(".new", ".bak")) {
+            try { Os.lstat(path.path + suffix); error("Interrupted operation journal") }
+            catch (e: android.system.ErrnoException) {
+                if (e.errno != OsConstants.ENOENT) throw e
+            }
+        }
+    }
+    fun isClean(): Boolean {
+        noInterruptedWrite()
+        if (!path.exists()) {
+            // Confirm ENOENT rather than treating an access error as a clean journal.
+            try { Os.lstat(path.path); error("Unreadable operation journal") }
+            catch (e: android.system.ErrnoException) {
+                if (e.errno != OsConstants.ENOENT) throw e
+            }
+            return true
+        }
+        return file.openRead().use { it.readNBytes(3).contentEquals(byteArrayOf(67, 10)) }
+    }
+    fun write(active: Boolean) {
+        noInterruptedWrite()
+        // Publish the Context-created directory before returning a native-operation grant.
+        for (dir in listOf(directory.parentFile!!, directory)) {
+            val fd = Os.open(dir.path, OsConstants.O_RDONLY or OsConstants.O_CLOEXEC, 0)
+            try { Os.fsync(fd) } finally { Os.close(fd) }
+        }
+        var stream: java.io.FileOutputStream? = file.startWrite()
+        try {
+            stream!!.write(if (active) byteArrayOf(65, 10) else byteArrayOf(67, 10))
+            stream.fd.sync()
+            file.finishWrite(stream); stream = null
+            val fd = Os.open(directory.path, OsConstants.O_RDONLY or OsConstants.O_CLOEXEC, 0)
+            try { Os.fsync(fd) } finally { Os.close(fd) }
+            noInterruptedWrite()
+            check(file.openRead().use { it.readNBytes(3).contentEquals(if (active) byteArrayOf(65,10) else byteArrayOf(67,10)) })
+        } finally { stream?.let { file.failWrite(it) } }
+    }
+}
