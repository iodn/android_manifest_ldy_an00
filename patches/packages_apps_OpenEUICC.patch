+    /** Passive status is checked before ordinary endpoint discovery, including after an app crash. */
+    suspend fun recoveryState(context: Context, waitForOperation: Boolean = true): RecoveryState =
+        traceWorkflow(Stage.STATUS) { trace ->
+        withContext(Dispatchers.IO) {
+        if (waitForOperation) sessionLock.lock()
+        else if (!sessionLock.tryLock()) return@withContext RecoveryState(
+            IHonorLpaLease.RECOVERY_IN_PROGRESS,false,true)
+        try {
+            initialize(context)
+            val hash=journal!!.recoveryHash()
+            withRecoveryApi(context) { api ->
+                val status=recoveryRpc { api.recoveryStatus(recoveryHash) }
+                if (status == IHonorLpaLease.RECOVERY_DONE && (hash != null || admission.isUnknown())) {
+                    // Phone DONE requires current L1 C/no binding; stale DONE under a new U is refused.
+                    admission.acknowledgeRecoveryAfterDone(
+                        done = { recoveryRpc { api.recoveryStatus(recoveryHash) } == IHonorLpaLease.RECOVERY_DONE },
+                        markClean = { if (hash != null) journal!!.acknowledgeRecovery(hash) })
+                    knownBlankForUi=false
+                }
+                RecoveryState(status,hash != null && status != IHonorLpaLease.RECOVERY_DONE,admission.isUnknown())
+            }
+        } finally { sessionLock.unlock() }
+    }
+        }
+
+    /** Positive management completion only; never writes a clean journal or selects a route. */
+    suspend fun managementDone(context: Context,manager: EuiccChannelManager,
+        closedBlankReceipt: () -> Boolean,freezeWork: () -> Unit): Boolean = try {
+        withContext(Dispatchers.IO) {
+            sessionLock.withLock {
+                initialize(context)
+                admission.requireIdle()
+                manager.invalidate()
+                admission.requireIdle()
+                val done = if (!journal!!.isClean()) false
+                    // Exact active-session result2+local completion, not historical UI state.
+                    else if (closedBlankReceipt()) true
+                    else withRecoveryApi(context) { api ->
+                        recoveryRpc { api.recoveryStatus(recoveryHash) } == IHonorLpaLease.RECOVERY_DONE
+                    }
+                // Same mutex as acquisition: already-queued session work cannot grant after Done.
+                if (done) freezeWork()
+                done
+            }
+        }
+    } catch (cancelled: kotlinx.coroutines.CancellationException) { throw cancelled }
+      catch (_: LpaChannelAdmission.Unavailable) { lifecycle(Stage.MANAGEMENT_RETURN).returned(Outcome.REFUSED_PRE_DISPATCH);false }
+      catch (_: HonorLpaOperationJournal.Unavailable) { lifecycle(Stage.MANAGEMENT_RETURN).returned(Outcome.STORAGE_FAILURE);false }
+      catch (_: RecoveryUnavailable) { lifecycle(Stage.MANAGEMENT_RETURN).returned(Outcome.TERMINAL_UNKNOWN);false }
+
+    /** Explicit user action only. Arming never starts recovery or reboots the device. */
+    suspend fun armRecovery(context: Context,manager: EuiccChannelManager): Int = traceWorkflow(Stage.RECOVERY_ARM) { trace ->
+        val managementWork=HonorManagementSession.captureWork()
+        withContext(Dispatchers.IO) {
+        sessionLock.withLock {
+            HonorManagementSession.requireWork(managementWork)
+            initialize(context)
+            withRecoveryApi(context) { api ->
+                if (recoveryRpc { api.recoveryStatus(recoveryHash) } != IHonorLpaLease.RECOVERY_REQUIRED)
+                    throw RecoveryUnavailable()
+                var hash=journal!!.recoveryHash()
+                if (hash == null) {
+                    // Explicit Restore only: Phone certified a valid durable UNKNOWN, not REFUSED.
+                    val owner=Any();admission.reserve(owner)
+                    try {
+                        withContext(NonCancellable + identity.asContextElement(owner)) {
+                            manager.invalidate()
+                            admission.requireDrained(owner)
+                            journal!!.write(active=true)
+                            admission.unknown()
+                        }
+                    } catch (failure: Throwable) { admission.unknown();throw failure }
+                    hash=journal!!.recoveryHash() ?: throw RecoveryUnavailable()
+                }
+                val client=Binder()
+                recoveryRpc { api.armRecovery(hash,client) }
+            }
+        }
+    }
+
+    /** New op-7 context only: no old handle, constructor, notification, reset or mutation replay. */
+    }
+
+    suspend fun recoverAccess(context: Context) = traceWorkflow(Stage.RECOVERY_BEGIN) { trace ->
+        val managementWork=HonorManagementSession.captureWork()
+        withContext(Dispatchers.IO) {
+        sessionLock.withLock {
+            HonorManagementSession.requireWork(managementWork)
+            initialize(context)
+            trace.enter(Stage.LOCAL_JOURNAL)
+            val hash=journal!!.recoveryHash() ?: throw RecoveryUnavailable()
+            trace.enter(Stage.BIND)
+            withRecoveryApi(context) { api ->
+                if (recoveryRpc { api.recoveryStatus(hash) } != IHonorLpaLease.RECOVERY_READY) throw RecoveryUnavailable()
+                withContext(NonCancellable) {
+                    val owner=Any();admission.reserveRecovery(owner)
+                    val client=Binder()
+                    var lease: HonorLpaLease?=null
+                    var finished=false
+                    var recoverySession: Session?=null
+                    try {
+                        trace.enter(Stage.RECOVERY_GRANT);trace.facts(Proof.UNKNOWN,Proof.YES,Proof.UNKNOWN)
+                        val grant=recoveryRpc { api.acquireRecovery(hash,client) }
+                        if (grant?.code == 3 && grant.lease == null) {
+                            admission.recoveryRefused(owner)
+                            throw RecoveryUnavailable()
+                        }
+                        val issued=grant?.lease ?: throw RecoveryUnavailable()
+                        lease=issued
+                        if (grant.code != 1 || issued.operation != 7 || issued.physicalSlot != 1
+                            || issued.port != 0 || issued.cardId < 0 || issued.uid != android.os.Process.myUid()
+                            || issued.user != 0 || issued.generation <= 0
+                            || issued.token?.matches(Regex("[0-9a-f]{32}")) != true
+                            || !((issued.routeSerial > 0 && issued.observationSerial == -1)
+                                || (issued.routeSerial == 0 && issued.observationSerial > 0)))
+                            throw RecoveryUnavailable()
+                        val scoped=Session(api,issued,client,Target(7,1,0,issued.cardId),owner,trace)
+                        recoverySession=scoped
+                        val receipt=LogicalChannelCloseReceipt()
+                        var channel: Int?=null
+                        var handle: Long?=null
+                        val apdu=object : net.typeblog.lpac_jni.ApduInterface {
+                            override fun connect() {}
+                            override fun disconnect() {}
+                            override val valid: Boolean get() = channel != null && !scoped.uncertain
+                            override fun logicalChannelOpen(aid: ByteArray): Int {
+                                check(channel == null && handle == null)
+                                val opened=openScopedChannel(1,0,issued.cardId,
+                                    aid.joinToString("") { "%02x".format(it.toInt() and 255) },0)
+                                channel=opened.channel;handle=opened.handle;receipt.opened(opened.channel)
+                                return opened.channel
+                            }
+                            override fun transmit(logical: Int,tx: ByteArray): ByteArray {
+                                check(channel == logical)
+                                return transmitScopedChannel(checkNotNull(handle),tx)
+                            }
+                            override fun logicalChannelClose(logical: Int) {
+                                try {
+                                    check(channel == logical)
+                                    if (closeScopedChannel(checkNotNull(handle)) != 2) throw RecoveryUnavailable()
+                                    receipt.closed(logical,true);channel=null;handle=null
+                                } catch (failure: Throwable) { receipt.failed();throw failure }
+                            }
+                        }
+                        withContext(identity.asContextElement(owner)
+                            + NativeMutationBoundary.observer.asContextElement(scoped)) {
+                            trace.enter(Stage.RECOVERY_TRANSCRIPT)
+                            withChannelAccess { net.typeblog.lpac_jni.ReadOnlyRecovery.read(apdu) }
+                            check(channel == null && handle == null)
+                            receipt.requireAllClosed();admission.requireDrained(owner)
+                            check(!scoped.uncertain && !scoped.nativeInFlight && !scoped.resetPending)
+                            trace.enter(Stage.RECOVERY_FINISH)
+                            if (!recoveryRpc { api.finishRecovery(issued,client,true) }) throw RecoveryUnavailable()
+                            finished=true
+                            trace.enter(Stage.RECOVERY_ACK)
+                            admission.acknowledgeRecoveryAfterDone(owner,
+                                done = { recoveryRpc { api.recoveryStatus(hash) } == IHonorLpaLease.RECOVERY_DONE },
+                                markClean = { journal!!.acknowledgeRecovery(hash) })
+                            knownBlankForUi=false
+                            trace.facts(Proof.YES,Proof.NO,Proof.YES);trace.returned(Outcome.OK)
+                        }
+                    } catch (failure: Throwable) {
+                        trace.failed(failure)
+                        admission.unknown()
+                        if (!finished) lease?.let {
+                            try { recoveryRpc { api.finishRecovery(it,client,false) } } catch (_: Exception) {}
+                        }
+                        if (failure is Exception && (recoverySession?.uncertain == true
+                            || failure is net.typeblog.lpac_jni.ReadOnlyRecovery.ReadFailure
+                            || failure is net.typeblog.lpac_jni.ProfileListReadException))
+                            throw RecoveryUnavailable(failure)
+                        throw failure
+                    }
+                }
+            }
+        }
+    }
+    }
+
+}
