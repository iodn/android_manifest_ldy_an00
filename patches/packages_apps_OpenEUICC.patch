+    val use=model();use.accepted(2,7,a);verify(use.choice()==ManagementSessionOutcome.Choice(7,a))
+    verify(use.complete(true)==true);verify(use.complete(true)==null)
+    use.accepted(2,7,b);verify(use.choice()?.iccid==a)
+    for(kind in listOf(3,4)) {
+        val m=model();m.accepted(2,7,a);m.accepted(kind,7,b)
+        verify(m.choice()?.iccid==a)
+        m.accepted(kind,8,a);verify(m.choice()?.iccid==a)
+        m.accepted(kind,7,a);verify(m.choice()==null)
+        verify(m.complete(true)==false)
+    }
+    val notifications=model();notifications.accepted(2,7,a)
+    for(kind in listOf(1,5,6,7)) notifications.accepted(kind,7,null)
+    verify(notifications.choice()?.iccid==a)
+    val reset=model();reset.accepted(2,7,a);reset.accepted(8,7,null)
+    verify(reset.complete(true)==false)
+    // Only whole positive scope completion commits accepted framework/download-enable intent.
+    val framework=model();val fg=framework.granted()
+    verify(framework.choice()==null)
+    framework.scopeCompleted(fg,scope(),false,2,b)
+    verify(framework.choice()?.iccid==b)
+    verify(framework.complete(true)==true)
+    val downloadOnly=model();val dg=downloadOnly.granted()
+    downloadOnly.scopeCompleted(dg,scope(1),false,1,null)
+    verify(downloadOnly.complete(true)==false)
+    val failed=model();val failedGrant=failed.granted()
+    failed.interrupted(failedGrant,true)
+    failed.scopeCompleted(failedGrant,scope(),false,2,a)
+    verify(failed.choice()==null && failed.complete(true)==null)
+    val unconfirmed=model();unconfirmed.accepted(2,7,a)
+    verify(unconfirmed.complete(false)==null)
+    // Exact current nonce/sequence + native operation, never a historical UI bool.
+    val blank=model();val g=blank.granted()
+    blank.scopeCompleted(g,scope(2),true,3,a)
+    verify(blank.hasClosedBlank());verify(blank.choice()==null)
+    val later=blank.granted();verify(!blank.hasClosedBlank())
+    blank.scopeCompleted(g,scope(2),true,3,a);verify(!blank.hasClosedBlank())
+    blank.scopeCompleted(later,scope(3),true,4,a);verify(blank.hasClosedBlank())
+    blank.interrupted(later,false);verify(!blank.hasClosedBlank())
+    val previous=model();val old=previous.granted()
+    val newSession=ManagementSessionOutcome("c".repeat(32));newSession.granted()
+    newSession.scopeCompleted(old,scope(2),true,3,a)
+    verify(!newSession.hasClosedBlank());verify(newSession.choice()==null)
+    val deadProcess=ManagementSessionOutcome(nonce)
+    verify(!deadProcess.hasClosedBlank())
+    for(pair in listOf(2 to 4,3 to 3,1 to 3)) {
+        val mismatch=model();val mg=mismatch.granted()
+        mismatch.scopeCompleted(mg,scope(pair.first),true,pair.second,a)
+        verify(!mismatch.hasClosedBlank() && mismatch.complete(true)==null)
+    }
