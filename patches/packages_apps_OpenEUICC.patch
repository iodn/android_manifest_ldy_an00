index 0000000000000000000000000000000000000000..666aeb0f1bc995ff52401bfdb0ef2dd91792b07d
--- /dev/null
+++ b/app-common/src/main/java/im/angry/openeuicc/core/ManagementSessionOutcome.kt
@@ -0,0 +1,69 @@
+package im.angry.openeuicc.core
+
+/** One active UI session's explicit intent and exact closed-blank receipt; never durable history. */
+internal class ManagementSessionOutcome(private val nonce: String) {
+    data class Choice(val cardId: Int, val iccid: String)
+    data class Grant(val nonce: String,val sequence: Long)
+    data class Scope(val cardId: Int,val operation: Int,val token: String,
+        val generation: Long,val routeSerial: Int,val observationSerial: Int)
+    private var keep: Choice? = null
+    private var uncertain = false
+    private var completed = false
+    private var sequence = 0L
+    private var workClosing = false
+    private var workFrozen = false
+    class Work internal constructor(private val session: ManagementSessionOutcome,
+        private val allowClosing: Boolean) {
+        fun allowed() = session.workAllowed(allowClosing)
+    }
+    @Synchronized private fun workAllowed(allowClosing: Boolean) =
+        !workFrozen && (!workClosing || allowClosing)
+    @Synchronized fun work() = Work(this,false)
+    @Synchronized fun enqueueWork(): Work? = if (workClosing || workFrozen) null else Work(this,true)
+    @Synchronized fun beginClosing() { workClosing = true }
+    @Synchronized fun freezeWork() { workFrozen = true }
+    private var blank: Pair<Grant,Scope>? = null
+    @Synchronized fun granted(): Grant {
+        blank=null
+        return Grant(nonce,++sequence)
+    }
+    @Synchronized fun scopeCompleted(grant: Grant,scope: Scope,knownBlank: Boolean,kind: Int,iccid: String?) {
+        if (completed || uncertain || grant.nonce != nonce || grant.sequence != sequence) return
+        blank=null
+        if (knownBlank) {
+            if (!(scope.operation == 2 && kind == 3 || scope.operation == 3 && kind == 4) || scope.cardId < 0
+                || !scope.token.matches(Regex("[0-9a-f]{32}")) || scope.generation <= 0
+                || !(scope.routeSerial > 0 && scope.observationSerial == -1
+                    || scope.routeSerial == 0 && scope.observationSerial > 0)) {
+                uncertain=true
+                return
+            }
+            blank=grant to scope
+        }
+        accepted(kind,scope.cardId,iccid)
+    }
+    @Synchronized fun accepted(kind: Int,cardId: Int,iccid: String?) {
+        if (completed || uncertain) return
+        if (kind == 2) {
+            if (cardId < 0 || iccid?.matches(Regex("[0-9]{18,22}")) != true) {
+                uncertain=true
+                return
+            }
+            keep=Choice(cardId,iccid)
+        } else if ((kind == 3 || kind == 4) && keep == Choice(cardId,iccid ?: "")) keep=null
+        else if (kind == 8 && keep?.cardId == cardId) keep=null
+    }
+    @Synchronized fun interrupted(grant: Grant? = null,native: Boolean = true) {
+        if (completed || grant != null && (grant.nonce != nonce || grant.sequence != sequence)) return
+        blank=null
+        if (native) uncertain=true
+    }
+    @Synchronized fun hasClosedBlank() = !completed && !uncertain && blank?.first == Grant(nonce,sequence)
+    @Synchronized fun choice(): Choice? = keep
+    /** null is interrupted/duplicate, never authority to restore. */
+    @Synchronized fun complete(drained: Boolean): Boolean? {
+        if (completed) return null
+        completed=true
+        return if (drained && !uncertain) keep != null else null
+    }
+}
diff --git a/app-common/src/main/java/im/angry/openeuicc/core/NativeMutationBoundary.kt b/app-common/src/main/java/im/angry/openeuicc/core/NativeMutationBoundary.kt
new file mode 100644
index 0000000000000000000000000000000000000000..914ca680efa4f8dfd81f5afda391c82598af7ca0
--- /dev/null
+++ b/app-common/src/main/java/im/angry/openeuicc/core/NativeMutationBoundary.kt
@@ -0,0 +1,81 @@
+package im.angry.openeuicc.core
+
+/** A native false result is ambiguous; never return it to a caller that might resend. */
+internal object NativeMutationBoundary {
+    interface Observer {
+        fun before(kind: Int,lastProfileBefore: Boolean,targetIccid: String?)
+        fun returned(kind: Int)
+        fun rejected(kind: Int, code: Int) { error("Definitive native rejection is not supported") }
+        fun uncertain()
+    }
+    val observer = ThreadLocal<Observer?>()
+    /** Only a witnessed stock refresh acknowledgement can complete a negative profile return. */
+    fun profileCall(kind: Int, lastProfileBefore: Boolean, targetIccid: String,
+                    refresh: Boolean, operation: () -> Boolean): Boolean {
+        val current = observer.get()
+        if (current == null) return call(kind,lastProfileBefore,targetIccid,operation)
+        return net.typeblog.lpac_jni.ProfileRefreshBoundary.withOperation(
+            current,kind,targetIccid,refresh
+        ) { scope ->
+            call(kind,lastProfileBefore,targetIccid) {
+                try { operation() }
+                catch (completion: net.typeblog.lpac_jni.ProfileRefreshBoundary.Completion) {
+                    check(scope.accept(completion)) { "Profile refresh completion is not current" }
+                    true // Phone returned(kind) and fresh reset/target reconciliation still follow.
+                }
+            }
+        }
+    }
+    fun <T> call(kind: Int,lastProfileBefore: Boolean = false,targetIccid: String? = null, operation: () -> T): T {
+        val current = observer.get()
+        var download: net.typeblog.lpac_jni.DownloadFailureBoundary.Attempt? = null
+        try {
+            current?.before(kind,lastProfileBefore,targetIccid)
+            if (kind == 1 && current != null)
+                download = net.typeblog.lpac_jni.DownloadFailureBoundary.begin(current)
+            val result = operation()
+            if (current != null && result == false) {
+                error("eSIM native completion is uncertain")
+            }
+            current?.returned(kind)
+            return result
+        } catch (failure: net.typeblog.lpac_jni.DownloadFailureBoundary.NotInstalled) {
+            try {
+                check(kind == 1 && current != null && download?.consume(current,failure) == true)
+                current.rejected(kind,net.typeblog.lpac_jni.DownloadFailureBoundary.REJECTED_NOT_INSTALLED)
+            } catch (unconfirmed: Throwable) {
+                current?.uncertain()
+                unconfirmed.addSuppressed(failure.original)
+                throw unconfirmed
+            }
+            throw failure.original // A failed download remains a failure, with original diagnostics.
+        } catch (delivery: net.typeblog.lpac_jni.NotificationDeliveryException) {
+            try {
+                check(kind == 7)
+                current?.returned(kind) // Existing Phone acknowledgement and final drain still apply.
+            } catch (failure: Throwable) {
+                current?.uncertain()
+                failure.addSuppressed(delivery)
+                throw failure
+            }
+            throw delivery
+        } catch (rejected: net.typeblog.lpac_jni.ProfileOperationRejectedException) {
+            if (current != null) {
+                try {
+                    check(rejected.kind == kind)
+                    current.rejected(kind,rejected.resultCode)
+                } catch (failure: Throwable) {
+                    current.uncertain()
+                    failure.addSuppressed(rejected)
+                    throw failure
+                }
+            }
+            throw rejected
+        } catch (failure: Throwable) {
+            current?.uncertain()
+            throw failure
+        } finally {
+            download?.close()
+        }
+    }
+}
diff --git a/app-common/src/main/java/im/angry/openeuicc/core/PendingProfileAction.kt b/app-common/src/main/java/im/angry/openeuicc/core/PendingProfileAction.kt
