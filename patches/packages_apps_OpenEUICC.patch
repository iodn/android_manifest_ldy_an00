@@ -0,0 +1,54 @@
+package im.angry.openeuicc.core
+
+import kotlinx.coroutines.*
+
+/** Actual pending-token state and coroutine cancellation ordering; no Android/modem claim. */
+fun main() = runBlocking {
+    var checks = 0
+    fun verify(value: Boolean) { check(value) { "pending-action check $checks" }; checks++ }
+    val first = "00000000000000000000000000000001"
+    val second = "00000000000000000000000000000002"
+    val action = PendingProfileAction.Action(PendingProfileAction.Kind.ADD, null, null)
+    val eid = "12345678901234567890123456789012"
+
+    PendingProfileAction.clear()
+    verify(PendingProfileAction.begin(first, action))
+    verify(PendingProfileAction.cancel(first)) // Facade unavailable before handoff.
+    verify(PendingProfileAction.begin(second, action)) // A second Add is available immediately.
+    verify(PendingProfileAction.take(second, eid, emptyList()) == action)
+
+    verify(PendingProfileAction.begin(first, action))
+    verify(!PendingProfileAction.cancel(second))
+    verify(!PendingProfileAction.begin(second, action))
+    verify(PendingProfileAction.take(first, eid, emptyList()) == action)
+
+    verify(PendingProfileAction.begin(first, action))
+    verify(PendingProfileAction.take(first, eid, emptyList()) == action) // Accepted handoff consumed it.
+    verify(PendingProfileAction.begin(second, action))
+    verify(!PendingProfileAction.cancel(first)) // Late cleanup cannot cancel the successor.
+    verify(PendingProfileAction.take(second, eid, emptyList()) == action)
+
+    verify(PendingProfileAction.begin(first, action))
+    val parent = Job()
+    var bodyRan = false
+    val neverStarted = CoroutineScope(parent + Dispatchers.Unconfined).launch(start = CoroutineStart.LAZY) {
+        bodyRan = true
+    }
+    neverStarted.invokeOnCompletion { PendingProfileAction.cancel(first) }
+    parent.cancel()
+    neverStarted.join()
+    verify(!bodyRan)
+    verify(PendingProfileAction.begin(second, action))
+    verify(PendingProfileAction.cancel(second))
+
+    verify(PendingProfileAction.begin(first, action))
+    val waiting = Job()
+    val barrier = CompletableDeferred<Unit>()
+    val job = CoroutineScope(waiting + Dispatchers.Unconfined).launch { barrier.await() }
+    job.invokeOnCompletion { PendingProfileAction.cancel(first) }
+    waiting.cancel(); job.join()
+    verify(PendingProfileAction.begin(second, action))
+    verify(PendingProfileAction.cancel(second))
+    PendingProfileAction.clear()
+    println("PENDING_ACTION_CANCELLATION_HOST_PASS checks=$checks")
+}
