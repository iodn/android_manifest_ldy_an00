@@ -0,0 +1,738 @@
+package im.angry.openeuicc.core
+
+import android.content.ComponentName
+import android.content.Context
+import android.content.Intent
+import android.content.ServiceConnection
+import android.os.Binder
+import android.os.Build
+import android.os.IBinder
+import com.honor.ldy_an00.lease.HonorLpaLease
+import com.honor.ldy_an00.lease.HonorLpaLifecycleTrace
+import com.honor.ldy_an00.lease.HonorLpaLifecycleTrace.Stage
+import com.honor.ldy_an00.lease.HonorLpaLifecycleTrace.Outcome
+import com.honor.ldy_an00.lease.HonorLpaLifecycleTrace.Proof
+import com.honor.ldy_an00.lease.HonorLpaResetTrace
+import com.honor.ldy_an00.lease.HonorLpaResetTrace.Phase
+import com.honor.ldy_an00.lease.IHonorLpaLease
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+import kotlinx.coroutines.CompletableDeferred
+import kotlinx.coroutines.NonCancellable
+import kotlinx.coroutines.asContextElement
+import kotlinx.coroutines.withContext
+import kotlinx.coroutines.withTimeout
+
+/** Actual Phone binding and local channel drain. It never selects an eUICC route. */
+internal object HonorLpaLeaseClient {
+    // Image-bound controlled trial only; hardware behavior remains unproven.
+    private const val CLIENT_RUNTIME_QUALIFIED = true
+    private val admission = LpaChannelAdmission()
+    private val sessionLock = Mutex()
+    @Volatile var knownBlankForUi = false
+        private set
+    class KnownBlankRoute : IllegalStateException("No active eSIM endpoint; return through SIM settings")
+    class ProfileRejected(val rejection: net.typeblog.lpac_jni.ProfileOperationRejectedException) :
+        Exception("The eSIM rejected this change", rejection)
+    class EndpointNotReady(cause: Throwable? = null) : IllegalStateException("No eSIM endpoint is ready",cause)
+    private inline fun <T> endpointReadRpc(call: () -> T): T = try { call() }
+        catch (cancelled: kotlinx.coroutines.CancellationException) { throw cancelled }
+        catch (failure: android.os.RemoteException) { throw EndpointNotReady(failure) }
+        catch (failure: IllegalStateException) { throw EndpointNotReady(failure) }
+        catch (failure: SecurityException) { throw EndpointNotReady(failure) }
+
+    private fun lifecycle(stage: Stage) = HonorLpaLifecycleTrace(HonorLpaLifecycleTrace.Side.LPA,
+        stage,android.os.SystemClock::elapsedRealtime) { android.util.Log.i("HonorLpaLifecycle",it) }
+    private suspend fun <T> traceWorkflow(stage: Stage,block: suspend (HonorLpaLifecycleTrace) -> T): T {
+        val trace=lifecycle(stage)
+        try {return block(trace)} catch(failure: Throwable) {trace.failed(failure);throw failure}
+    }
+    private val identity = ThreadLocal<Any?>()
+    private var journal: HonorLpaOperationJournal? = null
+    data class Target(val operation: Int, val slot: Int, val port: Int, val cardId: Int)
+    fun requiresCloseProof() = CLIENT_RUNTIME_QUALIFIED && isHonorBuild()
+    fun isHonorBuild() = Build.MODEL == "LDY-AN00" && Build.DEVICE == "ldy_an00"
+    @Synchronized fun initialize(context: Context) {
+        if (!CLIENT_RUNTIME_QUALIFIED || !isHonorBuild() || journal != null) return
+        try {
+            val loaded = HonorLpaOperationJournal(context)
+            if (!loaded.isClean()) admission.unknown()
+            journal = loaded
+        } catch (failure: Throwable) { admission.unknown(); throw failure }
+    }
+    @PublishedApi internal fun enterChannelAccess(): Boolean {
+        if (!CLIENT_RUNTIME_QUALIFIED || !isHonorBuild()) return false
+        if (journal == null) throw HonorLpaOperationJournal.Unavailable()
+        admission.enter(identity.get()); return true
+    }
+    @PublishedApi internal fun leaveChannelAccess(entered: Boolean) { if (entered) admission.leave() }
+    internal inline fun <T> withChannelAccess(block: () -> T): T {
+        val entered = enterChannelAccess()
+        try { return block() } finally { leaveChannelAccess(entered) }
+    }
+    /** Protected EuiccService operation, before discovery; never a passive Settings snapshot. */
+    suspend fun prepareKnownBlankForDiscovery(context: Context, slot: Int, port: Int, expectedCardId: Int = -1) {
+        if (!requiresCloseProof()) return
+        check(slot == 1 && port == 0 && expectedCardId >= -1) { "Only the qualified shared default port is supported" }
+        check(android.os.UserHandle.myUserId() == 0)
+        check(context.packageManager.checkSignatures("android","com.android.phone") ==
+            android.content.pm.PackageManager.SIGNATURE_MATCH)
+        val managementWork=HonorManagementSession.captureWork()
+        withContext(Dispatchers.IO) {
+            sessionLock.withLock {
+                HonorManagementSession.requireWork(managementWork)
+                initialize(context)
+                val localOwner = Any()
+                admission.reserve(localOwner) // Existing UNKNOWN and active JNI readers remain blocked.
+                var bound = false
+                val connected = CompletableDeferred<IHonorLpaLease>()
+                val connection = object : ServiceConnection {
+                    override fun onServiceConnected(name: ComponentName, service: IBinder) {
+                        connected.complete(IHonorLpaLease.Stub.asInterface(service))
+                    }
+                    override fun onServiceDisconnected(name: ComponentName) {
