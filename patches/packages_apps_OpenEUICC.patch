+ assert hashlib.sha256((args.lpac_source/"docs/asn1/rsp.asn").read_bytes()).hexdigest()==fixture["schema_sha256"]
+ header=Path(directory)/"asn1-cancel-golden.h"
+ header.write_text("\n".join("static const uint8_t compiler_"+name+"[]={"+",".join("0x%02x"%b for b in bytes.fromhex(value))+"};" for name,value in fixture["vectors"].items()))
+ # Compile the prior production predicate with its one wrong tag, as an explicit regression baseline.
+ proof=(native/"lpac-download-proof.c").read_text()
+ old=proof[proof.index("/* Use the existing decoder"):]
+ assert "child(&signed_data,&ok,0,0x30)" in old
+ old=old.replace("child(&signed_data,&ok,0,0x30)","child(&signed_data,&ok,0,0xa0)",1)
+ old=old.replace("bool lpac_download_cancel_accepted(","bool lpac_download_cancel_accepted_legacy(",1)
+ legacy=Path(directory)/"legacy-predicate.c"
+ legacy.write_text('#include "lpac-download-proof.h"\n#include <euicc/derutil.h>\n#include <string.h>\n'+old)
+ cmd=[*shlex.split(os.environ.get("CC","cc")),"-std=gnu11","-ffunction-sections","-fdata-sections",
+ "-Wl,--gc-sections","-pthread","-Wno-unused-parameter",
+ "-I"+str(Path(directory)),"-I"+str(native),"-I"+str(args.lpac_source),"-I"+str(args.jni_include),
+ str(root/"tests/host/download-failure-native.c"),
+ str(native/"lpac-download.c"),str(native/"lpac-download-proof.c"),str(legacy),
+ str(args.lpac_source/"euicc/derutil.c"),str(args.lpac_source/"euicc/base64.c"),"-o",str(out)]
+ subprocess.run(cmd,check=True)
+ subprocess.run([str(out)],check=True)
