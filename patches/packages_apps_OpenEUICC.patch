+package im.angry.openeuicc.core
+
+/** Image-bound controlled trial using Phone-owned leases; hardware behavior remains unproven. */
+internal object SharedSlotOperationPolicy {
+    private const val HONOR_COORDINATION_QUALIFIED = true
+    fun blocked(model: String, device: String) =
+        model == "LDY-AN00" && device == "ldy_an00" && !HONOR_COORDINATION_QUALIFIED
+}
