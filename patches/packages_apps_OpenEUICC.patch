@@ -0,0 +1,20 @@
+package im.angry.openeuicc.core
+
+import android.content.Context
+import android.telephony.SubscriptionManager
+
+/** Android subscription history, not a verified or complete read of the eUICC. */
+internal object FrameworkProfileCache {
+    data class Row(val eid: String, val iccid: String, val name: String, val provider: String)
+    fun read(context: Context): List<Row> {
+        val manager = context.getSystemService(SubscriptionManager::class.java) ?: return emptyList()
+        return try {
+            manager.allSubscriptionInfoList.orEmpty().filter { it.isEmbedded }.mapNotNull {
+                val eid = it.cardString
+                val iccid = it.iccId
+                if (!eid.matches(Regex("[0-9]{32}")) || !iccid.matches(Regex("[0-9]{18,22}"))) null
+                else Row(eid, iccid, it.displayName?.toString().orEmpty(), it.carrierName?.toString().orEmpty())
+            }.distinctBy { it.eid to it.iccid }
+        } catch (_: SecurityException) { emptyList() }
+    }
+}
diff --git a/app-common/src/main/java/im/angry/openeuicc/core/HonorLpaChannelAccess.kt b/app-common/src/main/java/im/angry/openeuicc/core/HonorLpaChannelAccess.kt
new file mode 100644
index 0000000000000000000000000000000000000000..6d3a9dbea7a8c9feb36a9289301444f6b2ce5c16
--- /dev/null
+++ b/app-common/src/main/java/im/angry/openeuicc/core/HonorLpaChannelAccess.kt
@@ -0,0 +1,38 @@
+package im.angry.openeuicc.core
+
+/** The privileged backend uses only opaque Phone-owned generation-bound handles on Honor. */
+object HonorLpaChannelAccess {
+    fun knownBlank() = HonorLpaLeaseClient.knownBlankForUi
+    fun isJournalUnavailableFailure(failure: Throwable) = failure is HonorLpaOperationJournal.Unavailable
+    fun isProfileListReadFailure(failure: Throwable) = failure is net.typeblog.lpac_jni.ProfileListReadException
+    fun isAccessUnavailableFailure(failure: Throwable) = failure is LpaChannelAdmission.Unavailable
+    fun isAccessUncertainFailure(failure: Throwable) =
+        (failure as? LpaChannelAdmission.Unavailable)?.uncertain == true
+    fun isEndpointNotReadyFailure(failure: Throwable) = failure is HonorLpaLeaseClient.EndpointNotReady
+    fun isKnownBlankFailure(failure: Throwable) = failure is HonorLpaLeaseClient.KnownBlankRoute
+    suspend fun prepareKnownBlankForDiscovery(context: android.content.Context, slot: Int, port: Int, expectedCardId: Int = -1) =
+        HonorLpaLeaseClient.prepareKnownBlankForDiscovery(context,slot,port,expectedCardId)
+    fun isConfirmedProfileRejection(failure: Throwable) = failure is HonorLpaLeaseClient.ProfileRejected
+    fun enabled() = HonorLpaLeaseClient.requiresCloseProof()
+    data class RecoveryState(val status: Int,val localMarker: Boolean,val unavailable: Boolean)
+    suspend fun recoveryState(context: android.content.Context, waitForOperation: Boolean = true): RecoveryState {
+        val state=HonorLpaLeaseClient.recoveryState(context,waitForOperation)
+        return RecoveryState(state.status,state.localMarker,state.unavailable)
+    }
+    suspend fun armRecovery(context: android.content.Context,manager: EuiccChannelManager) =
+        HonorLpaLeaseClient.armRecovery(context,manager)
+    fun isRecoveryUnavailableFailure(failure: Throwable) = failure is HonorLpaLeaseClient.RecoveryUnavailable
+    /** Lifecycle cleanup is not the operation owner and must not close its in-flight channels. */
+    fun cleanupIfUnowned(manager: EuiccChannelManager) {
+        try { manager.invalidate() }
+        catch (reserved: LpaChannelAdmission.Unavailable) { if (!enabled()) throw reserved }
+        catch (journal: HonorLpaOperationJournal.Unavailable) { if (!enabled()) throw journal }
+    }
+    data class Opened(val handle: Long, val channel: Int)
+    fun open(slot: Int, port: Int, card: Int, aid: String, p2: Int): Opened {
+        val result = HonorLpaLeaseClient.openScopedChannel(slot,port,card,aid,p2)
+        return Opened(result.handle,result.channel)
+    }
+    fun transmit(handle: Long, command: ByteArray) = HonorLpaLeaseClient.transmitScopedChannel(handle,command)
+    fun close(handle: Long) = HonorLpaLeaseClient.closeScopedChannel(handle)
+}
diff --git a/app-common/src/main/java/im/angry/openeuicc/core/HonorLpaDiscoveryIntent.kt b/app-common/src/main/java/im/angry/openeuicc/core/HonorLpaDiscoveryIntent.kt
