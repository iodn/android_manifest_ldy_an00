+            im.angry.openeuicc.common.R.string.download_wizard_slot_removed
+        access.isProfileListReadFailure(failure) -> im.angry.openeuicc.common.R.string.esim_profiles_read_failed
+        access.isJournalUnavailableFailure(failure) || access.isAccessUncertainFailure(failure) ->
+            im.angry.openeuicc.common.R.string.esim_access_unresolved
+        access.isAccessUnavailableFailure(failure) -> im.angry.openeuicc.common.R.string.esim_access_busy
+        access.isKnownBlankFailure(failure) || access.isEndpointNotReadyFailure(failure) ->
+            im.angry.openeuicc.common.R.string.esim_endpoint_not_ready_guidance
+        else -> null
+    }
+}
