+                            finished=true
+                            admission.acknowledgeRecoveryAfterDone(owner,
+                                done = { recoveryRpc { api.recoveryStatus(hash) } == IHonorLpaLease.RECOVERY_DONE },
+                                markClean = { journal!!.acknowledgeRecovery(hash) })
+                            knownBlankForUi=false
+                        }
+                    } catch (failure: Throwable) {
+                        admission.unknown()
+                        if (!finished) lease?.let {
+                            try { recoveryRpc { api.finishRecovery(it,client,false) } } catch (_: Exception) {}
+                        }
+                        if (failure is Exception && (recoverySession?.uncertain == true
+                            || failure is net.typeblog.lpac_jni.ReadOnlyRecovery.ReadFailure
+                            || failure is net.typeblog.lpac_jni.ProfileListReadException))
+                            throw RecoveryUnavailable(failure)
+                        throw failure
+                    }
+                }
+            }
+        }
+    }
+    }
+
+}
