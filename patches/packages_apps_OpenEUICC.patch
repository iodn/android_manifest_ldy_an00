+ fun setMessage(message:Int)=this
+ fun setPositiveButton(label:Int,action:(Any?,Int)->Unit)=this
+ fun setOnDismissListener(action:(Any?)->Unit):Builder {Effects.legacyFinishHandlers++;return this}
