+package im.angry.openeuicc.service
+
+import im.angry.openeuicc.core.EuiccChannelManager
+import kotlin.coroutines.*
+import org.junit.Assert.*
+import org.junit.Test
+
+class DownloadedProfilePublicationTest {
+    private fun execute(block:suspend()->Unit) {
+        var result:Result<Unit>?=null
+        block.startCoroutine(object:Continuation<Unit> {
+            override val context=EmptyCoroutineContext
+            override fun resumeWith(outcome:Result<Unit>) {result=outcome}
+        })
+        checkNotNull(result).getOrThrow()
+    }
+    @Test fun refreshFollowsWholeOperationIncludingDrainAndCompletion() {
+        val events=mutableListOf<String>()
+        execute {DownloadedProfilePublication.run(
+            { EuiccChannelManager.DownloadedProfileRefresh {events+="refresh"} }) {
+            events+="download";events+="native close";events+="lease finish";events+="journal clean"
+        }}
+        assertEquals(listOf("download","native close","lease finish","journal clean","refresh"),events)
+    }
+    @Test fun operationOrDrainUnknownNeverRequestsRefreshOrRetries() {
+        for (failureAt in 0..3) {
+            var calls=0;var requests=0
+            try {
+                execute {DownloadedProfilePublication.run(
+                    { EuiccChannelManager.DownloadedProfileRefresh {requests++} }) {
+                    calls++
+                    repeat(4) {if(it==failureAt) error("known failure or unknown completion")}
+                }}
+                fail("must propagate")
+            } catch (_:IllegalStateException) {}
+            assertEquals(1,calls);assertEquals(0,requests)
+        }
+    }
+    @Test fun staleTargetRefreshFailureDoesNotResendCompletedDownload() {
+        var calls=0;var requests=0
+        try {execute {DownloadedProfilePublication.run(
+            { EuiccChannelManager.DownloadedProfileRefresh {requests++;error("stale target")} }) {calls++}}
+            fail("must propagate")
+        } catch (failure:DownloadedProfilePublication.RefreshFailure) {
+            assertTrue(failure.cause is IllegalStateException)
+            assertTrue(failure.message!!.startsWith("Profile downloaded"))
+        }
+        assertEquals(1,calls);assertEquals(1,requests)
+    }
+    @Test fun staleCaptureRefusesBeforeDownloadAndDoesNotPublish() {
+        var calls=0
+        try {execute {DownloadedProfilePublication.run({error("no exact card")}) {calls++}}
+            fail("must refuse")
+        } catch (_:IllegalStateException) {}
+        assertEquals(0,calls)
+    }
+    @Test fun unprivilegedNoRefreshRequestStillCompletes() {
+        var calls=0
+        execute {DownloadedProfilePublication.run(null) {calls++}}
+        assertEquals(1,calls)
+    }
+}
