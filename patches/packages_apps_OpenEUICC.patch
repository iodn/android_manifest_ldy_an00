+ checkCase(uncertain.activity.finishCount==0,"no auto-close/restart")
+ for(item in 1..4)uncertain.click(item)
+ uncertain.add()
+ checkCase(uncertain.mutations==0 && uncertain.additions==0 && Effects.dialogs==0,"stale actions blocked")
+ val timeout=Screen()
+ runNow{timeout.failed(TimeoutCancellationException())}
+ checkCase(timeout.activity.checks==1,"Honor timeout shows one recovery UI")
+ checkCase(Effects.legacyDialogs==0 && Effects.legacyFinishHandlers==0,"Honor timeout must not install legacy finish dialog")
+ checkCase(timeout.adapter.profiles.isEmpty() && !timeout.fab.isEnabled,"Honor timeout stays unresolved")
+ checkCase(timeout.refreshes==0 && timeout.activity.finishCount==0,"Honor timeout no implicit reload/finish")
+ val rejected=Screen()
