+            "befbb7c5d3870c500e1f22715cf8ca8c4547ba92:"+path],text=True)
+    start=source.index("val err=outcome.error")+len("val err=outcome.error")
+    end=source.index("            fab.isEnabled = true",start)+len("            fab.isEnabled = true")
+    failure=source[start:end].replace("return@launch","return")
+    start=source.index("        private fun onMenuItemClicked")
+    end=source.index("\n    }\n\n    inner class EuiccProfileAdapter",start)
