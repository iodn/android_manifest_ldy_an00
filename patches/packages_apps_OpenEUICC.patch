@@ -0,0 +1,27 @@
+package im.angry.openeuicc.core
+
+/** One user gesture, held in memory only. Intents carry an opaque token, never an operation. */
+internal object PendingProfileAction {
+    const val EXTRA = "honor_management_action_token"
+    enum class Kind { ENABLE, DISABLE, DELETE, RENAME, ADD }
+    data class Action(val kind: Kind, val eid: String?, val iccid: String?)
+    private var pending: Pair<String, Action>? = null
+    @Synchronized fun begin(token: String, action: Action): Boolean {
+        require(token.matches(Regex("[0-9a-f]{32}")))
+        require(action.eid == null || action.eid.matches(Regex("[0-9]{32}")))
+        require(action.kind == Kind.ADD || action.eid != null && action.iccid?.matches(Regex("[0-9]{18,22}")) == true)
+        if (pending != null) return false
+        pending = token to action
+        return true
+    }
+    @Synchronized fun clear() { pending = null }
+    @Synchronized fun take(token: String?, eid: String, iccids: List<String>): Action? {
+        val request = pending ?: return null
+        if (token != request.first) return null
+        pending = null // Consume before checking the live identity; mismatch cannot retry elsewhere.
+        val action = request.second
+        if (action.eid != null && action.eid != eid) return null
+        if (action.kind != Kind.ADD && iccids.count { it == action.iccid } != 1) return null
+        return action
+    }
+}
diff --git a/app-common/src/main/java/im/angry/openeuicc/core/ProfileInventory.kt b/app-common/src/main/java/im/angry/openeuicc/core/ProfileInventory.kt
new file mode 100644
index 0000000000000000000000000000000000000000..a73689ea7b885375982bf7c74f0cd4a4d35dd326
--- /dev/null
+++ b/app-common/src/main/java/im/angry/openeuicc/core/ProfileInventory.kt
@@ -0,0 +1,143 @@
+package im.angry.openeuicc.core
+
+import java.io.ByteArrayInputStream
+import java.io.ByteArrayOutputStream
+import java.io.DataInputStream
+import java.io.DataOutputStream
+import java.io.File
+import java.io.FileOutputStream
+import java.io.IOException
+import java.nio.channels.FileChannel
+import java.nio.file.Files
+import java.nio.file.StandardOpenOption
+import java.nio.file.StandardCopyOption
+import java.security.MessageDigest
+
+/** Historical display data only: never a live card result or mutation authority. */
+internal object ProfileInventory {
+    private const val MAGIC = 0x4c504931
+    private const val MAX_BYTES = 262144
+    private const val MAX_CARDS = 16
+    data class Row(val iccid: String, val enabledWhenRead: Boolean, val name: String,
+        val nickname: String, val provider: String, val profileClass: String)
+    data class Snapshot(val eid: String, val verifiedAtMillis: Long, val profiles: List<Row>)
+    sealed interface State {
+        data object Unavailable : State
+        data class VerifiedEmpty(val snapshot: Snapshot) : State
+        data class Verified(val snapshot: Snapshot) : State
+    }
+    private fun validate(s: Snapshot) {
+        require(s.eid.matches(Regex("[0-9]{32}")) && s.verifiedAtMillis > 0)
+        require(s.profiles.size <= 128 && s.profiles.map { it.iccid }.distinct().size == s.profiles.size)
+        s.profiles.forEach {
+            require(it.iccid.matches(Regex("[0-9]{18,22}")))
+            require(listOf(it.name,it.nickname,it.provider).all { value -> value.length <= 512 })
+            require(it.profileClass in setOf("Testing","Provisioning","Operational"))
+        }
+    }
+    internal fun encode(s: Snapshot): ByteArray {
+        validate(s)
+        val bytes=ByteArrayOutputStream()
+        DataOutputStream(bytes).use { out ->
+            out.writeInt(MAGIC);out.writeUTF(s.eid);out.writeLong(s.verifiedAtMillis)
+            out.writeInt(s.profiles.size)
+            s.profiles.forEach {
+                out.writeUTF(it.iccid);out.writeBoolean(it.enabledWhenRead)
+                out.writeUTF(it.name);out.writeUTF(it.nickname);out.writeUTF(it.provider)
+                out.writeUTF(it.profileClass)
+            }
+        }
+        return bytes.toByteArray().also { require(it.size <= MAX_BYTES) }
+    }
+    internal fun decode(bytes: ByteArray): Snapshot {
+        require(bytes.size <= MAX_BYTES)
+        DataInputStream(ByteArrayInputStream(bytes)).use { input ->
+            require(input.readInt() == MAGIC)
+            val eid=input.readUTF();val time=input.readLong();val count=input.readInt()
+            require(count in 0..128)
+            val rows=List(count) {
+                val iccid=input.readUTF();val enabled=input.readUnsignedByte()
+                require(enabled in 0..1)
+                Row(iccid,enabled == 1,input.readUTF(),input.readUTF(),input.readUTF(),input.readUTF())
+            }
+            require(input.read() == -1)
+            return Snapshot(eid,time,rows).also { validate(it) }
+        }
+    }
+    private fun name(eid: String): String {
+        require(eid.matches(Regex("[0-9]{32}")))
+        return MessageDigest.getInstance("SHA-256").digest(eid.toByteArray(Charsets.US_ASCII))
+            .joinToString("") { "%02x".format(it) } + ".inventory"
+    }
+    private fun state(s: Snapshot): State =
+        if(s.profiles.isEmpty()) State.VerifiedEmpty(s) else State.Verified(s)
+
+    /** Caller supplies an app-private noBackup directory, never shared/external storage. */
+    class Store(private val directory: File) {
+        @Synchronized fun load(eid: String): State = read(File(directory,name(eid)),eid)
+        @Synchronized fun saved(): List<State> { return try {
+            if(!directory.exists()) return listOf(State.Unavailable)
+            val files=directory.listFiles() ?: return listOf(State.Unavailable)
+            // Never silently present a partial set after malformed or oversized storage.
+            if(files.size > MAX_CARDS*2 || files.any {
+                    !it.name.matches(Regex("[0-9a-f]{64}\\.inventory(\\.new)?")) })
+                return listOf(State.Unavailable)
+            // An interrupted unpublished .new file cannot hide an older committed snapshot.
+            val committed=files.filter { it.name.endsWith(".inventory") }
+            if(committed.isEmpty() || committed.size > MAX_CARDS) return listOf(State.Unavailable)
+            val states=committed.sortedBy { it.name }.map { read(it,null) }
+            if(states.any { it is State.Unavailable }) listOf(State.Unavailable) else states
+        } catch (_: SecurityException) { listOf(State.Unavailable) } }
+        private fun read(file: File, expected: String?): State = try {
+            val bytes=file.inputStream().use { it.readNBytes(MAX_BYTES+1) }
+            val s=decode(bytes)
+            require((expected == null || s.eid == expected) && file.name == name(s.eid))
+            state(s)
+        } catch (_: IOException) { State.Unavailable }
+          catch (_: IllegalArgumentException) { State.Unavailable }
+          catch (_: SecurityException) { State.Unavailable }
+
+        fun publish(s: Snapshot) = synchronized(ProfileInventory) {
+            val bytes=encode(s)
+            check(directory.isDirectory || directory.mkdirs())
+            check(directory.setReadable(false,false) && directory.setWritable(false,false)
+                && directory.setExecutable(false,false) && directory.setReadable(true,true)
+                && directory.setWritable(true,true) && directory.setExecutable(true,true))
+            val target=File(directory,name(s.eid))
+            val existing=directory.listFiles() ?: throw IOException("Inventory directory unavailable")
+            check(target.exists() || existing.size < MAX_CARDS)
+            val temp=File(directory,target.name+".new")
+            // This app has one process; all writers share this lock. Only a new verified read
+            // may replace an unpublished partial file; it is never interpreted as inventory.
+            check(temp.createNewFile() || temp.isFile)
+            try {
+                check(temp.setReadable(false,false) && temp.setWritable(false,false)
+                    && temp.setReadable(true,true) && temp.setWritable(true,true))
+                FileOutputStream(temp).use { out -> out.write(bytes);out.fd.sync() }
+                Files.move(temp.toPath(),target.toPath(),
+                    StandardCopyOption.ATOMIC_MOVE,StandardCopyOption.REPLACE_EXISTING)
+                FileChannel.open(directory.toPath(),StandardOpenOption.READ).use { it.force(true) }
+            } finally {
+                if(temp.exists() && !temp.delete()) throw IOException("Inventory temporary file retained")
+            }
+        }
+    }
+
+    data class Capture(val snapshot: Snapshot, val saved: Boolean)
+
+    /** Only saving can fail softly; ownership, READ and cancellation failures stay outside. */
+    internal suspend fun captureAndPublish(store: Store, outerRead: () -> Boolean,
+        completedRead: suspend () -> Snapshot): Capture {
+        check(outerRead()) { "Inventory capture requires an outer READ" }
+        val snapshot=completedRead()
+        val saved=try {
+            store.publish(snapshot)
+            true
+        } catch (cancelled: java.util.concurrent.CancellationException) { throw cancelled }
+          catch (_: IOException) { false }
+          catch (_: SecurityException) { false }
+          catch (_: IllegalArgumentException) { false }
+          catch (_: IllegalStateException) { false }
+        return Capture(snapshot,saved)
+    }
+}
