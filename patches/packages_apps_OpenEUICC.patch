diff --git a/libs/lpac-jni/src/test/java/net/typeblog/lpac_jni/ReadOnlyRecoveryHostTest.kt b/libs/lpac-jni/src/test/java/net/typeblog/lpac_jni/ReadOnlyRecoveryHostTest.kt
