@@ -0,0 +1,55 @@
+package net.typeblog.lpac_jni
+
+/** One Phone-owned download attempt; no history is reconstructed after restart or thread changes. */
+object DownloadFailureBoundary {
+    const val REJECTED_NOT_INSTALLED = 0x10000
+    class NotInstalled internal constructor(
+        val original: LocalProfileAssistant.ProfileDownloadException,
+        internal val receipt: Int
+    ) : Exception("The download ended before profile installation", original)
+
+    class Attempt internal constructor(private val owner: Any, val nonce: Long) {
+        private val thread = Thread.currentThread()
+        private var finished = false
+        private var consumed = false
+        private var closed = false
+        private var issued: NotInstalled? = null
+        private fun current() = !closed && Thread.currentThread() === thread &&
+            active.get() === this
+
+        /** A native receipt is meaningful only for this exact current one-shot attempt. */
+        internal fun notInstalled(receipt: Int, original: LocalProfileAssistant.ProfileDownloadException): NotInstalled? {
+            if (!current() || finished) return null
+            finished = true
+            if (receipt != 1 && receipt != 2) return null
+            return NotInstalled(original,receipt).also { issued = it }
+        }
+
+        fun consume(caller: Any, failure: NotInstalled): Boolean {
+            if (!current() || consumed || caller !== owner || issued !== failure ||
+                failure.receipt !in 1..2) return false
+            consumed = true
+            return true
+        }
+
+        fun close() {
+            if (active.get() === this) active.remove()
+            closed = true
+        }
+    }
+
+    private val next = java.util.concurrent.atomic.AtomicLong(1)
+    private val active = ThreadLocal<Attempt?>()
+
+    /** Called only after the operation observer has positively admitted native kind 1. */
+    fun begin(owner: Any): Attempt {
+        check(active.get() == null) { "A download attempt is already active" }
+        val nonce = next.getAndIncrement()
+        check(nonce > 0) { "Download attempt identifiers exhausted" }
+        return Attempt(owner,nonce).also { active.set(it) }
+    }
+
+    internal fun currentAttempt(): Attempt? = active.get()
+    fun isKnownRejection(kind: Int, code: Int) =
+        kind == 1 && code == REJECTED_NOT_INSTALLED
+}
