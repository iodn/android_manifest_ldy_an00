+    val a="8900000000000000001";val b="8900000000000000002"
+    fun model()=ManagementSessionOutcome(nonce)
+    fun scope(op: Int=2,card: Int=7)=ManagementSessionOutcome.Scope(card,op,"b".repeat(32),1,3,-1)
