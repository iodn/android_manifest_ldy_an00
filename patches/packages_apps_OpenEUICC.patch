+class Screen {
+ var invalid=false;var closing=false;var savedInventoryMode=false;val isUsb=false
+ val swipeRefresh=Swipe();val fab=Control();val adapter=Adapter()
+ var enabledProfile:LocalProfileInfo?=LocalProfileInfo(isEnabled=true)
+ val activity=MainActivity();val context=Any()
