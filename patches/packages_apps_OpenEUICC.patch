+#!/usr/bin/env python3
+"""Compile the bundled ASN.1 definitions independently to produce DER cancellation goldens."""
+import argparse,hashlib,json,re
+from pathlib import Path
+import asn1tools
+ap=argparse.ArgumentParser()
+ap.add_argument("--schema",required=True,type=Path)
+ap.add_argument("--output",required=True,type=Path)
+args=ap.parse_args()
+assert asn1tools.__version__=="0.169.0"
+source=args.schema.read_text()
+definitions={}
+matches=list(re.finditer(r"^([A-Za-z][A-Za-z0-9-]*)\s*::=",source,re.M))
+for i,match in enumerate(matches):
+ definitions[match[1]]=source[match.start():matches[i+1].start() if i+1<len(matches) else source.rindex("END")].strip()
+names=["TransactionId","CancelSessionReason","CancelSessionResponse","CancelSessionResponseOk","EuiccCancelSessionSigned"]
+schema="\n".join(source.splitlines()[:5])+"\n"+"\n".join(definitions[n]for n in names)+"\nEND\n"
+codec=asn1tools.compile_string(schema,"der")
+vectors={}
+for reason in (0,1):
+ value=("cancelSessionResponseOk",{
+  "euiccCancelSessionSigned":{"transactionId":bytes(range(1,17)),"smdpOid":"1.2.840.113549","reason":reason},
+  "euiccCancelSessionSignature":bytes([0x55]*64)})
+ encoded=codec.encode("CancelSessionResponse",value,check_constraints=True)
+ assert codec.decode("CancelSessionResponse",encoded)==value
+ vectors["reason"+str(reason)]=encoded.hex()
+error=("cancelSessionResponseError",5)
+encoded=codec.encode("CancelSessionResponse",error,check_constraints=True)
+assert codec.decode("CancelSessionResponse",encoded)==error
+vectors["error5"]=encoded.hex()
+result={"compiler":"asn1tools","version":asn1tools.__version__,"codec":"der",
+ "source":"lpac/docs/asn1/rsp.asn","schema_sha256":hashlib.sha256(args.schema.read_bytes()).hexdigest(),
+ "compiled_schema_sha256":hashlib.sha256(schema.encode()).hexdigest(),"compiled_schema":schema,
+ "tag_rule":"Explicit APPLICATION55 disables automatic tags for CancelSessionResponseOk; signed sequence remains UNIVERSAL30.",
+ "primary_tag_rule":"https://www.oss.com/asn1/resources/asn1-made-simple/asn1-quick-reference/asn1-tags.html",
+ "vectors":vectors,"scope":"Generated ASN.1 fixtures; no captured device response or hardware validation."}
+args.output.parent.mkdir(parents=True,exist_ok=True)
+args.output.write_text(json.dumps(result,indent=2)+"\n")
+print("PASS independent ASN.1 compiler encode/decode",vectors)
