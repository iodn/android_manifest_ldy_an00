diff --git a/app-common/src/test/java/im/angry/openeuicc/core/DownloadFailureBoundaryHostTest.kt b/app-common/src/test/java/im/angry/openeuicc/core/DownloadFailureBoundaryHostTest.kt
new file mode 100644
index 0000000000000000000000000000000000000000..03ad8193c0c89a972757ac41a6eda840f0da8432
--- /dev/null
+++ b/app-common/src/test/java/im/angry/openeuicc/core/DownloadFailureBoundaryHostTest.kt
@@ -0,0 +1,101 @@
+package im.angry.openeuicc.core
+
+import net.typeblog.lpac_jni.DownloadFailureBoundary
+import net.typeblog.lpac_jni.LocalProfileAssistant
+
+private var checks=0
+private fun verify(value:Boolean){checks++;check(value){"check $checks"}}
+private fun original()=LocalProfileAssistant.ProfileDownloadException("network",null,null,null,null)
+private class Observer : NativeMutationBoundary.Observer {
+    var before=0;var returned=0;var rejected=0;var uncertain=0
+    var denyBefore=false;var denyRejection=false
+    override fun before(kind:Int,lastProfileBefore:Boolean,targetIccid:String?){
+        before++
+        check(DownloadFailureBoundary.currentAttempt()==null)
+        check(!denyBefore)
+    }
+    override fun returned(kind:Int){returned++}
+    override fun rejected(kind:Int,code:Int){
+        check(kind==1 && code==0x10000 && !denyRejection)
+        rejected++
+    }
+    override fun uncertain(){uncertain++}
+}
+fun main(){
+    var lastNonce=0L
+    for(receipt in listOf(1,2)){
+        val observer=Observer();NativeMutationBoundary.observer.set(observer)
+        val error=original()
+        val thrown=runCatching {
+            NativeMutationBoundary.call<Unit>(1){
+                val attempt=checkNotNull(DownloadFailureBoundary.currentAttempt())
+                verify(attempt.nonce>lastNonce);lastNonce=attempt.nonce
+                throw checkNotNull(attempt.notInstalled(receipt,error))
+            }
+        }.exceptionOrNull()
+        verify(thrown===error)
+        verify(observer.before==1 && observer.rejected==1 && observer.returned==0 && observer.uncertain==0)
+        verify(DownloadFailureBoundary.currentAttempt()==null)
+    }
+    for(receipt in listOf(-1,0,3,0x10000)){
+        val observer=Observer();NativeMutationBoundary.observer.set(observer)
+        val error=original()
+        val thrown=runCatching {
+            NativeMutationBoundary.call<Unit>(1){
+                val attempt=checkNotNull(DownloadFailureBoundary.currentAttempt())
+                verify(attempt.notInstalled(receipt,error)==null)
+                verify(attempt.notInstalled(1,error)==null) // A second finish cannot upgrade UNKNOWN.
+                throw error
+            }
+        }.exceptionOrNull()
+        verify(thrown===error && observer.rejected==0 && observer.uncertain==1)
+        verify(DownloadFailureBoundary.currentAttempt()==null)
+    }
+    var observer=Observer();NativeMutationBoundary.observer.set(observer)
+    NativeMutationBoundary.call<Unit>(1){
+        verify(DownloadFailureBoundary.currentAttempt()!=null)
+    }
+    verify(observer.returned==1 && observer.rejected==0 && observer.uncertain==0)
+    verify(DownloadFailureBoundary.currentAttempt()==null)
+    observer=Observer();observer.denyBefore=true;NativeMutationBoundary.observer.set(observer)
+    runCatching{NativeMutationBoundary.call<Unit>(1){error("must not execute")}}
+    verify(observer.before==1 && observer.uncertain==1 && DownloadFailureBoundary.currentAttempt()==null)
+    observer=Observer();observer.denyRejection=true;NativeMutationBoundary.observer.set(observer)
+    runCatching{NativeMutationBoundary.call<Unit>(1){
+        throw checkNotNull(DownloadFailureBoundary.currentAttempt()?.notInstalled(1,original()))
+    }}
+    verify(observer.rejected==0 && observer.returned==0 && observer.uncertain==1)
+    verify(DownloadFailureBoundary.currentAttempt()==null)
+
+    val owner=Any();val attempt=DownloadFailureBoundary.begin(owner)
+    var crossThread=false
+    Thread{
+        crossThread=DownloadFailureBoundary.currentAttempt()==null &&
+            attempt.notInstalled(1,original())==null
+    }.apply{start();join()}
+    verify(crossThread)
+    val failure=checkNotNull(attempt.notInstalled(2,original()))
+    verify(!attempt.consume(Any(),failure))
+    verify(attempt.consume(owner,failure))
+    verify(!attempt.consume(owner,failure))
+    attempt.close()
+    verify(!attempt.consume(owner,failure) && DownloadFailureBoundary.currentAttempt()==null)
+    val next=DownloadFailureBoundary.begin(owner)
+    verify(next.nonce>attempt.nonce && !next.consume(owner,failure))
+    next.close()
+    val closed=DownloadFailureBoundary.begin(owner);closed.close()
+    verify(closed.notInstalled(1,original())==null)
+    observer=Observer();NativeMutationBoundary.observer.set(observer)
+    val stale=runCatching{NativeMutationBoundary.call<Unit>(1){throw failure}}.exceptionOrNull()
+    verify(stale!==failure.original && observer.rejected==0 && observer.uncertain==1)
+    observer=Observer();NativeMutationBoundary.observer.set(observer)
+    runCatching{NativeMutationBoundary.call<Unit>(2){throw failure}}
+    verify(observer.rejected==0 && observer.uncertain==1)
+    NativeMutationBoundary.observer.remove()
+    verify(DownloadFailureBoundary.currentAttempt()==null)
+    verify(DownloadFailureBoundary.isKnownRejection(1,0x10000))
+    verify(!DownloadFailureBoundary.isKnownRejection(2,0x10000))
+    verify(!DownloadFailureBoundary.isKnownRejection(1,0xffff))
+    verify(!DownloadFailureBoundary.isKnownRejection(1,0x10001))
+    println("PASS $checks actual download-attempt/boundary checks; native proof supplied by fixture")
+}
