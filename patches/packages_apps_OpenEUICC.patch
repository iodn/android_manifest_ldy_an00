@@ -0,0 +1,123 @@
+package im.angry.openeuicc.core
+
+import net.typeblog.lpac_jni.Es10cProfileResult
+import net.typeblog.lpac_jni.ProfileRefreshBoundary
+
+private var checks = 0
+private fun verify(value: Boolean) { checks++;check(value) { "check $checks" } }
+private fun rejects(block: () -> Unit) { verify(runCatching(block).isFailure) }
+private fun hex(text: String) = text.chunked(2).map { it.toInt(16).toByte() }.toByteArray()
+// Generated by real LPAC es10c.c/derutil.c/hexutil.c at gitlink 50cdf15ab40942b00f8819a1c2ca19997f1a6d34.
+private val golden = listOf(
+    "BF3111A00C5A0A981032547698103254FF8101FF",
+    "BF3111A00C5A0A981032547698103254F68101FF",
+    "BF3111A00C5A0A981032547698103254768101FF",
+    "BF3112A00D5A0B98103254769810325476F88101FF",
+    "BF3112A00D5A0B98103254769810325476988101FF"
+)
+private const val ICCID = "8901234567890123456"
+private fun command(bytes: ByteArray, sequence: Int = 0, last: Boolean = true, channel: Int = 1) =
+    byteArrayOf((0x80 or (channel and 15)).toByte(),0xe2.toByte(),
+        (if (last) 0x91 else 0x11).toByte(),sequence.toByte(),bytes.size.toByte()) + bytes
+private class Observer : NativeMutationBoundary.Observer {
+    var before=0;var returned=0;var uncertain=0;var rejected=0;var lastProfile=false
+    override fun before(kind: Int,lastProfileBefore: Boolean,targetIccid: String?) {
+        before++;lastProfile=lastProfileBefore
+    }
+    override fun returned(kind: Int) { returned++ }
+    override fun rejected(kind: Int,code: Int) { rejected++ }
+    override fun uncertain() { uncertain++ }
+}
+private fun response(owner: Any, bytes: ByteArray = hex(golden[1]), channel: Int = 1,
+                     slot: Int = 1, card: Int = 2, status: String = "6F00", seq: Int = 0,
+                     last: Boolean = true, commandOverride: ByteArray? = null) =
+    ProfileRefreshBoundary.observe(owner,slot,0,card,channel,
+        commandOverride ?: command(bytes,seq,last,channel),hex(status))
+
+fun main() {
+    for (kind in listOf(2,3)) {
+        for (index in golden.indices) {
+            val target="8901234567890123456789".take(18+index)
+            val bytes=hex(golden[index]).also { it[1]=(if(kind==2)0x31 else 0x32).toByte() }
+            val observer=Observer();NativeMutationBoundary.observer.set(observer)
+            verify(NativeMutationBoundary.profileCall(kind,kind==3,target,true) {
+                response(observer,bytes)
+                Es10cProfileResult.accepted(kind,-1)
+            })
+            verify(observer.before==1 && observer.returned==1 && observer.uncertain==0)
+            verify(observer.lastProfile==(kind==3)) // Last-profile provenance is retained.
+        }
+    }
+    var observer=Observer();NativeMutationBoundary.observer.set(observer)
+    verify(NativeMutationBoundary.profileCall(2,false,ICCID,true) { Es10cProfileResult.accepted(2,0) })
+    verify(observer.returned==1 && observer.uncertain==0) // Ordinary positive result unchanged.
+    observer=Observer();NativeMutationBoundary.observer.set(observer)
+    verify(NativeMutationBoundary.profileCall(2,false,ICCID,true) {
+        val bytes=hex(golden[1])
+        response(observer,bytes.copyOfRange(0,7),status="9000",last=false)
+        response(observer,bytes.copyOfRange(7,bytes.size),seq=1)
+        Es10cProfileResult.accepted(2,-1)
+    })
+    verify(observer.returned==1 && observer.uncertain==0)
+
+    fun refused(operation: (Observer) -> Unit, refresh: Boolean = true) {
+        val current=Observer();NativeMutationBoundary.observer.set(current)
+        rejects {
+            NativeMutationBoundary.profileCall(2,false,ICCID,refresh) {
+                operation(current)
+                Es10cProfileResult.accepted(2,-1)
+            }
+        }
+        verify(current.returned==0 && current.uncertain==1)
+    }
+    refused({}) // raw native -1 is never a refresh certificate.
+    refused({ response(it) },false)
+    refused({ response(it,hex(golden[0])) }) // Wrong ICCID.
+    refused({ response(it,status="6A82") })
+    refused({ response(it,status="6F01") })
+    refused({ response(it,commandOverride=command(hex(golden[1])).also { it[it.lastIndex]=0 }) })
+    refused({ current -> response(current);Es10cProfileResult.accepted(2,0) })
+    refused({ response(it,commandOverride=command(hex(golden[1])).also { it[1]=0xa4.toByte() }) })
+    refused({ response(it,seq=1) })
+    refused({ response(it,slot=0) })
+    refused({ response(Any()) })
+    refused({ current ->
+        val bytes=hex(golden[1])
+        response(current,bytes.copyOfRange(0,7),last=false,status="9000")
+        response(current,bytes.copyOfRange(7,bytes.size),seq=1,card=3)
+    })
+    refused({ current ->
+        val bytes=hex(golden[1])
+        response(current,bytes.copyOfRange(0,7),last=false,status="6F00")
+        response(current,bytes.copyOfRange(7,bytes.size),seq=1)
+    })
+    refused({ current -> response(current);response(current) }) // Extra response invalidates proof.
+    refused({ current -> response(current);Es10cProfileResult.accepted(4,-1) }) // Wrong native kind.
+    refused({ current -> Thread { response(current) }.apply { start();join() } }) // Wrong thread.
+    observer=Observer();NativeMutationBoundary.observer.set(observer)
+    rejects { NativeMutationBoundary.profileCall(3,true,ICCID,true) { Es10cProfileResult.accepted(3,2) } }
+    verify(observer.rejected==1 && observer.returned==0 && observer.uncertain==0)
+    observer=Observer();NativeMutationBoundary.observer.set(observer)
+    rejects { NativeMutationBoundary.profileCall(2,false,ICCID,true) { error("transport") } }
+    verify(observer.returned==0 && observer.uncertain==1)
+
+    var old: ProfileRefreshBoundary.Completion?=null
+    val owner=Any()
+    ProfileRefreshBoundary.withOperation(owner,2,ICCID,true) { scope ->
+        response(owner)
+        old=ProfileRefreshBoundary.completion(2,-1)
+        verify(old!=null && ProfileRefreshBoundary.completion(2,-1)==null)
+        verify(scope.accept(checkNotNull(old)))
+        verify(!scope.accept(checkNotNull(old)))
+    }
+    ProfileRefreshBoundary.withOperation(owner,2,ICCID,true) { scope ->
+        response(owner)
+        verify(!scope.accept(checkNotNull(old))) // Another operation's witness is not transferable.
+    }
+    ProfileRefreshBoundary.withOperation(owner,2,ICCID,true) {
+        verify(ProfileRefreshBoundary.completion(2,-1)==null)
+    }
+    NativeMutationBoundary.observer.remove()
+    verify(!NativeMutationBoundary.profileCall(2,false,ICCID,true) { Es10cProfileResult.accepted(2,-1) })
+    println("PASS $checks typed refresh request/response/boundary checks; no modem proof")
+}
