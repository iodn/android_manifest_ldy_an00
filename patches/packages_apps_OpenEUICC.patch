+package im.angry.openeuicc.core
+import net.typeblog.lpac_jni.*
+import java.util.concurrent.locks.ReentrantLock
+import kotlin.concurrent.withLock
+object ImplDownloadTest {
+    var checks=0
+    fun verify(value:Boolean){checks++;check(value){"check $checks"}}
+    class HttpRecord {
+        val old=HttpInterface.HttpResponse(503,byteArrayOf(7))
+        var response=old;var exception:Exception?=IllegalStateException("original HTTP")
+        val lastHttpResponse get()=response
+        val lastHttpException get()=exception
+    }
+    class ApduRecord {
+        val old=byteArrayOf(0x90.toByte(),0)
+        var response=old;var exception:Exception?=null
+        val lastApduResponse get()=response
+        val lastApduException get()=exception
+    }
+    class Impl {
+        val lock=ReentrantLock();val contextHandle=77L
+        val httpInterface=HttpRecord();val apduInterface=ApduRecord()
+""" + body + """
+    }
+    object FakeJni {
+        var result=-1;var proof=1;var downloads=0;var finishes=0;var errorCaptured=false
+        var nonce=0L;var address="";var closeDuring=false;var failFinish=false
+        var label="network";var cancelCallback=false;lateinit var impl:Impl
+        fun downloadProfile(handle:Long,smdp:String,matching:String?,imei:String?,confirmation:String?,
+                            callback:ProfileDownloadCallback,attemptNonce:Long):Int {
+            verify(handle==77L);downloads++;nonce=attemptNonce;address=smdp
+            if(closeDuring)DownloadFailureBoundary.currentAttempt()?.close()
+            if(cancelCallback)verify(!callback.onStatusUpdate(ProfileDownloadState.Preparing()))
+            return result
+        }
+        fun downloadErrCodeToString(code:Int):String {errorCaptured=true;return label}
+        fun finishDownloadFailure(handle:Long,attemptNonce:Long,smdp:String):Int {
+            verify(errorCaptured && handle==77L && attemptNonce==nonce && nonce>0 && smdp===address)
+            finishes++
+            impl.httpInterface.response=HttpInterface.HttpResponse(200,byteArrayOf())
+            impl.httpInterface.exception=null;impl.apduInterface.response=byteArrayOf()
+            if(failFinish)error("finish transport")
+            return proof
+        }
+        fun reset(){
+            result=-1;proof=1;downloads=0;finishes=0;errorCaptured=false
+            nonce=0;address="";closeDuring=false;failFinish=false;label="network";cancelCallback=false
+        }
+    }
+    class Observer:NativeMutationBoundary.Observer {
+        var returned=0;var rejected=0;var uncertain=0
+        override fun before(kind:Int,lastProfileBefore:Boolean,targetIccid:String?){}
+        override fun returned(kind:Int){returned++}
+        override fun rejected(kind:Int,code:Int){check(kind==1 && code==0x10000);rejected++}
+        override fun uncertain(){uncertain++}
+    }
+    fun execute(observer:Observer): Pair<Impl,Throwable?> {
+        val impl=Impl();FakeJni.impl=impl;NativeMutationBoundary.observer.set(observer)
+        val failure=runCatching {
+            NativeMutationBoundary.call<Unit>(1){
+                impl.downloadProfile(ProfileDownloadInput("smdp.example",null,null,null),
+                    ProfileDownloadCallback { !FakeJni.cancelCallback })
+            }
+        }.exceptionOrNull()
+        return impl to failure
+    }
+    fun diagnostics(impl:Impl,failure:Throwable?) {
+        verify(failure is LocalProfileAssistant.ProfileDownloadException)
+        val original=failure as LocalProfileAssistant.ProfileDownloadException
+        verify(original.lpaErrorReason==FakeJni.label && original.lastHttpResponse===impl.httpInterface.old)
+        verify(original.lastHttpException?.message=="original HTTP" &&
+            original.lastApduResponse===impl.apduInterface.old)
+    }
+    @JvmStatic fun main(args:Array<String>) {
+        for(proof in listOf(1,2))for(cancel in listOf(false,true)) {
+            FakeJni.reset();FakeJni.proof=proof;FakeJni.cancelCallback=cancel
+            if(cancel)FakeJni.label="cancelled"
+            val observer=Observer();val (impl,failure)=execute(observer)
+            diagnostics(impl,failure)
+            verify(FakeJni.downloads==1 && FakeJni.finishes==1)
+            verify(observer.rejected==1 && observer.returned==0 && observer.uncertain==0)
+            verify(DownloadFailureBoundary.currentAttempt()==null)
+        }
+        FakeJni.reset();FakeJni.proof=0
+        var observer=Observer();var pair=execute(observer);diagnostics(pair.first,pair.second)
+        verify(FakeJni.finishes==1 && observer.rejected==0 && observer.uncertain==1)
+        FakeJni.reset();FakeJni.failFinish=true
+        observer=Observer();pair=execute(observer);diagnostics(pair.first,pair.second)
+        verify(pair.second!!.suppressed.single().message=="finish transport" && observer.uncertain==1)
+        FakeJni.reset();FakeJni.closeDuring=true
+        observer=Observer();pair=execute(observer);diagnostics(pair.first,pair.second)
+        verify(FakeJni.finishes==0 && observer.rejected==0 && observer.uncertain==1)
+        FakeJni.reset();FakeJni.result=0
+        observer=Observer();pair=execute(observer)
+        verify(pair.second==null && FakeJni.finishes==0 && observer.returned==1 && observer.uncertain==0)
+        verify(DownloadFailureBoundary.currentAttempt()==null)
+        FakeJni.reset();NativeMutationBoundary.observer.remove()
+        val impl=Impl();FakeJni.impl=impl
+        val failure=runCatching {
+            impl.downloadProfile(ProfileDownloadInput("smdp.example",null,null,null),
+                ProfileDownloadCallback { true })
+        }.exceptionOrNull()
+        diagnostics(impl,failure)
+        verify(FakeJni.nonce==0L && FakeJni.finishes==0) // Unarmed error is never upgraded.
+        println("PASS $checks exact download implementation/nonce/diagnostic/finish-order checks")
+    }
+}
