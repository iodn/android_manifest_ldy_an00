+package im.angry.openeuicc.core
+
+import android.os.Build
+
+/** One shared guard for framework API, QR tasks, direct profile calls and radio remapping. */
+object SharedSlotOperationGate {
+    fun isBlocked() = SharedSlotOperationPolicy.blocked(Build.MODEL, Build.DEVICE)
+    fun areDirectRadioChangesBlocked() = HonorLpaLeaseClient.isHonorBuild()
+    fun requireRadioMappingAllowed() {
+        check(!areDirectRadioChangesBlocked()) { "Phone owns shared-slot radio changes" }
+    }
+    fun requireAllowed() {
+        check(!isBlocked()) { "eSIM changes are not available yet" }
+    }
+}
