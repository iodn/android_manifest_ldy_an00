+    fixture=r"""
+import kotlin.coroutines.*
+object R {
+ object string {const val esim_disable_before_delete=5;const val esim_access_unresolved=1;const val esim_profile_rejected=2
+ const val toast_profile_enable_cross_class=3;const val profile_switch_did_not_refresh=4}
+ object style {const val AlertDialogTheme=1}
+ object id {const val enable=1;const val disable=2;const val rename=3;const val delete=4}
+}
+object android {object R {object string {const val ok=1}}}
+class TimeoutCancellationException:Exception()
+class Rejected:Exception()
+object Dispatchers {val Main=Any()}
+suspend fun <T> withContext(context:Any,action:suspend()->T):T=action()
+class Toast {fun show(){};companion object {const val LENGTH_LONG=1
+ fun makeText(context:Any?,text:Int,duration:Int)=Toast()}}
