+    *info=nonempty?&row:0;return result;
+}
+static jboolean check_exception(JNIEnv *env) {return pending?JNI_TRUE:JNI_FALSE;}
+static jclass find_class(JNIEnv *env,const char *name) {
+    assert(!strcmp(name,"net/typeblog/lpac_jni/ProfileListReadException"));find_calls++;return (jclass)1;
+}
+static jint throw_new(JNIEnv *env,jclass cls,const char *message) {
+    assert(cls && strstr(message,"profile list"));throw_calls++;pending=1;return 0;
+}
+static void reset(void) {pending=find_calls=throw_calls=nonempty=0;}
+int main(void) {
+    struct JNINativeInterface table={0};
+    table.ExceptionCheck=check_exception;table.FindClass=find_class;table.ThrowNew=throw_new;
+    JNIEnv env=&table;
+    reset();result=-1;
+    assert(Java_net_typeblog_lpac_1jni_LpacJni_es10cGetProfilesInfo(&env,0,0)==0);
+    assert(pending && find_calls==1 && throw_calls==1);
+    reset();result=-1;pending=1;
+    assert(Java_net_typeblog_lpac_1jni_LpacJni_es10cGetProfilesInfo(&env,0,0)==0);
+    assert(pending && find_calls==0 && throw_calls==0);
+    reset();result=0;
+    assert(Java_net_typeblog_lpac_1jni_LpacJni_es10cGetProfilesInfo(&env,0,0)==0);
+    assert(!pending && !find_calls && !throw_calls);
+    reset();result=0;nonempty=1;
+    assert(Java_net_typeblog_lpac_1jni_LpacJni_es10cGetProfilesInfo(&env,0,0)==(jlong)&row);
+    assert(!pending && !find_calls && !throw_calls);
+    return 0;
+}
