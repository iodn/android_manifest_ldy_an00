+package im.angry.openeuicc.ui
+
+import android.content.ComponentName
+import android.content.Intent
+import android.service.euicc.EuiccService
+import android.telephony.UiccCardInfo
+
+/** Platform LUI actions keep adding a profile distinct from managing installed profiles. */
+internal object EuiccUiRouting {
+    fun downloadIntent(source: Intent, target: ComponentName): Intent =
+        Intent(source).setComponent(target)
+
+    fun managementIntent(source: Intent, target: ComponentName): Intent? =
+        if (source.action == EuiccService.ACTION_MANAGE_EMBEDDED_SUBSCRIPTIONS)
+            Intent(source).setComponent(target)
+        else null
+
+    fun managementPorts(source: Intent, defaultCardId: Int, cards: List<UiccCardInfo>):
+        List<Pair<Int, Int>> {
+        val cardId = if (source.hasExtra(EuiccService.EXTRA_RESOLUTION_CARD_ID))
+            source.getIntExtra(EuiccService.EXTRA_RESOLUTION_CARD_ID, -1) else defaultCardId
+        if (cardId < 0) return emptyList()
+        val card = cards.singleOrNull { it.cardId == cardId && it.isEuicc }
+            ?: return emptyList()
+        if (card.physicalSlotIndex < 0) return emptyList()
+        if (card.eid?.matches(Regex("[0-9]{32}")) != true) return emptyList()
+        val port = if (source.hasExtra(EuiccService.EXTRA_RESOLUTION_PORT_INDEX))
+            source.getIntExtra(EuiccService.EXTRA_RESOLUTION_PORT_INDEX, -1) else null
+        return card.ports.filter {
+            it.isActive && it.logicalSlotIndex >= 0 && (port == null || it.portIndex == port)
+        }.map { card.physicalSlotIndex to it.portIndex }
+    }
+}
