+package im.angry.openeuicc.core
+
+/** Process-local admission. UNKNOWN cannot be released by cancellation or a timeout. */
+internal class LpaChannelAdmission {
+    class Unavailable(val uncertain: Boolean) : IllegalStateException(
+        if (uncertain) "Previous eSIM operation is unresolved" else "eSIM channels are in use")
+    private enum class State { IDLE, RESERVED, UNKNOWN }
+    private var state = State.IDLE
+    private var owner: Any? = null
+    private var readers = 0
+    @Synchronized fun enter(token: Any?) {
+        if (!(state == State.IDLE || state == State.RESERVED && token === owner)) throw Unavailable(state == State.UNKNOWN)
+        readers++
+    }
+    @Synchronized fun leave() { check(readers > 0); readers-- }
+    @Synchronized fun reserve(token: Any) {
+        if (state != State.IDLE || readers != 0) throw Unavailable(state == State.UNKNOWN)
+        state = State.RESERVED; owner = token
+    }
+    @Synchronized fun complete(token: Any) {
+        if (state == State.UNKNOWN && token === owner && readers == 0) throw Unavailable(true)
+        check(state == State.RESERVED && token === owner && readers == 0)
+        state = State.IDLE; owner = null
+    }
+    /** A refused/cancelled read is releasable only after the original owner proves its drain. */
+    fun completeAfterDrain(token: Any, close: () -> Unit, finish: () -> Boolean, markClean: () -> Unit) {
+        close()
+        requireDrained(token)
+        check(finish()) { "Operation drain was not confirmed" }
+        markClean()
+        complete(token)
+    }
+    /** Only the Phone's separately boot-fenced recovery may enter an existing UNKNOWN. */
+    @Synchronized fun reserveRecovery(token: Any) {
+        if (state != State.UNKNOWN || readers != 0 || owner != null) throw Unavailable(true)
+        state=State.RESERVED;owner=token
+    }
+    @Synchronized fun isUnknown() = state == State.UNKNOWN
+    @Synchronized fun requireIdle() {
+        if (state != State.IDLE || owner != null || readers != 0) throw Unavailable(state == State.UNKNOWN)
+    }
+    @Synchronized fun recoveryRefused(token: Any) {
+        check(state == State.RESERVED && owner === token && readers == 0)
+        state=State.UNKNOWN;owner=null
+    }
+    /** Called only after positive Phone DONE, never on cancellation or a native timeout. */
+    fun acknowledgeRecoveryAfterDone(token: Any? = null,done: () -> Boolean,markClean: () -> Unit) {
+        synchronized(this) {
+            if (readers != 0 || !(state == State.UNKNOWN ||
+                state == State.RESERVED && owner === token)) throw Unavailable(true)
+        }
+        if (!done()) throw Unavailable(true)
+        markClean()
+        acknowledgeRecovery(token)
+    }
+    @Synchronized private fun acknowledgeRecovery(token: Any?) {
+        check(readers == 0 && (state == State.UNKNOWN ||
+            state == State.RESERVED && owner === token))
+        state=State.IDLE;owner=null
+    }
+    @Synchronized fun unknownIfOwned(token: Any): Boolean {
+        if (state == State.IDLE || owner !== token) return false
+        state=State.UNKNOWN
+        return true
+    }
+    @Synchronized fun unknown() { state = State.UNKNOWN }
+    @Synchronized fun requireDrained(token: Any) {
+        if (state == State.UNKNOWN && token === owner && readers == 0) throw Unavailable(true)
+        check(state == State.RESERVED && token === owner && readers == 0)
+    }
+}
