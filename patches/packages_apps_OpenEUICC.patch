+    val lostDuringClose=LpaChannelAdmission();val closeOwner=Any()
+    lostDuringClose.reserve(closeOwner)
+    var finishAfterLoss=0;var cleanAfterLoss=0
+    val closeFailure=runCatching {lostDuringClose.completeAfterDrain(closeOwner,
+        close={lostDuringClose.unknownIfOwned(closeOwner)},
+        finish={finishAfterLoss++;true},markClean={cleanAfterLoss++})}.exceptionOrNull()
+    verify(closeFailure is LpaChannelAdmission.Unavailable && closeFailure.uncertain)
+    verify(finishAfterLoss == 0 && cleanAfterLoss == 0 && lostDuringClose.isUnknown())
