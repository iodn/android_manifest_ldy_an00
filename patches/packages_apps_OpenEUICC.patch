index 0000000000000000000000000000000000000000..a72383c35d68c48f6c788d8b6f2c4229055f770b
--- /dev/null
+++ b/libs/lpac-jni/src/main/java/net/typeblog/lpac_jni/ProfileRefreshBoundary.kt
@@ -0,0 +1,104 @@
+package net.typeblog.lpac_jni
+
+/**
+ * Operation-local evidence for stock's final ES10 refresh acknowledgement.
+ * No timeout, missing response or raw native error can create a completion.
+ */
+object ProfileRefreshBoundary {
+    class Completion internal constructor(val kind: Int) :
+        Exception("The eUICC acknowledged a profile refresh")
+    class Scope internal constructor(
+        private val owner: Any, private val kind: Int, iccid: String,
+        private val refresh: Boolean
+    ) {
+        private val expected = request(kind, iccid)
+        private var endpoint: List<Int>? = null
+        private var received = byteArrayOf()
+        private var sequence = 0
+        private var invalid = false
+        private var finalRefresh = false
+        private var issued: Completion? = null
+        private var accepted = false
+
+        internal fun observe(caller: Any?, slot: Int, port: Int, card: Int, channel: Int,
+                             command: ByteArray, response: ByteArray) {
+            if (invalid || finalRefresh || issued != null) { invalid = true; return }
+            val context = listOf(slot, port, card, channel)
+            if (!refresh || caller !== owner || slot != 1 || port != 0 || card < 0 ||
+                channel !in 1..19 || endpoint != null && endpoint != context ||
+                command.size < 6 || command[0].toInt() and 255 != (0x80 or (channel and 15)) ||
+                command[1].toInt() and 255 != 0xe2 ||
+                command[3].toInt() and 255 != sequence ||
+                command[4].toInt() and 255 != command.size - 5 || response.size != 2) {
+                invalid = true; return
+            }
+            val next = received + command.copyOfRange(5, command.size)
+            if (next.size > expected.size || !next.contentEquals(expected.copyOf(next.size))) {
+                invalid = true; return
+            }
+            endpoint = context
+            received = next
+            val p1 = command[2].toInt() and 255
+            val sw1 = response[0].toInt() and 255
+            val sw2 = response[1].toInt() and 255
+            if (p1 == 0x11 && received.size < expected.size && sw1 and 0xf0 == 0x90) {
+                sequence++
+                return
+            }
+            if (p1 == 0x91 && received.contentEquals(expected) && sw1 == 0x6f && sw2 == 0) {
+                finalRefresh = true
+                return
+            }
+            invalid = true // Normal card-positive results continue through the ordinary parser.
+        }
+
+        internal fun completion(requestKind: Int, nativeCode: Int): Completion? {
+            if (requestKind != kind || nativeCode != -1) { invalid = true; return null }
+            if (invalid || !refresh || !finalRefresh || issued != null) return null
+            return Completion(kind).also { issued = it }
+        }
+
+        fun accept(completion: Completion): Boolean {
+            if (invalid || accepted || issued !== completion || completion.kind != kind) {
+                invalid = true; return false
+            }
+            accepted = true
+            return true
+        }
+    }
+
+    private val current = ThreadLocal<Scope?>()
+
+    fun <T> withOperation(owner: Any, kind: Int, iccid: String, refresh: Boolean,
+                          operation: (Scope) -> T): T {
+        check(current.get() == null) { "A profile refresh scope is already active" }
+        val scope = Scope(owner, kind, iccid, refresh)
+        current.set(scope)
+        try { return operation(scope) } finally { current.remove() }
+    }
+
+    /** Call only after the captured Phone channel returned its matched final response. */
+    fun observe(owner: Any?, slot: Int, port: Int, card: Int, channel: Int,
+                command: ByteArray, response: ByteArray) {
+        current.get()?.observe(owner, slot, port, card, channel, command, response)
+    }
+
+    internal fun completion(kind: Int, nativeCode: Int): Completion? =
+        current.get()?.completion(kind,nativeCode)
+
+    private fun request(kind: Int, iccid: String): ByteArray {
+        require(kind == 2 || kind == 3)
+        require(iccid.matches(Regex("[0-9]{18,22}")))
+        // Match LPAC gsmbcd2bin(..., padding_to=10), including odd-digit padding.
+        val digits = if (iccid.length % 2 == 0) iccid else iccid + "F"
+        val bcd = ByteArray(maxOf(10, digits.length / 2)) { 0xff.toByte() }
+        for (index in digits.indices step 2)
+            bcd[index / 2] = (digits[index].digitToInt(16) or
+                (digits[index + 1].digitToInt(16) shl 4)).toByte()
+        val identifier = byteArrayOf(0x5a, bcd.size.toByte()) + bcd
+        val choice = byteArrayOf(0xa0.toByte(), identifier.size.toByte()) + identifier
+        val body = choice + byteArrayOf(0x81.toByte(), 1, 0xff.toByte())
+        return byteArrayOf(0xbf.toByte(), if (kind == 2) 0x31 else 0x32,
+            body.size.toByte()) + body
+    }
+}
diff --git a/libs/lpac-jni/src/main/java/net/typeblog/lpac_jni/ReadOnlyRecovery.kt b/libs/lpac-jni/src/main/java/net/typeblog/lpac_jni/ReadOnlyRecovery.kt
new file mode 100644
index 0000000000000000000000000000000000000000..dafdcf06837d875993413ac521b130eeedf36c47
--- /dev/null
+++ b/libs/lpac-jni/src/main/java/net/typeblog/lpac_jni/ReadOnlyRecovery.kt
@@ -0,0 +1,64 @@
+package net.typeblog.lpac_jni
+
+/** Bare owned JNI context: exactly live EID then profiles. No info2, HTTP, notifications or reset. */
+object ReadOnlyRecovery {
+    class ReadFailure : IllegalStateException("Unable to confirm read-only eSIM recovery")
+    internal interface Calls {
+        fun create(apdu: ApduInterface): Long
+        fun init(context: Long): Int
+        fun eid(context: Long): String?
+        fun profiles(context: Long): Long
+        fun next(profile: Long): Long
+        fun iccid(profile: Long): String
+        fun state(profile: Long): String
+        fun free(head: Long)
+        fun finish(context: Long)
+        fun destroy(context: Long)
+    }
+    private object Jni : Calls {
+        override fun create(apdu: ApduInterface) = LpacJni.createContext(
+            byteArrayOf(0xA0.toByte(),0,0,0x05,0x59,0x10,0x10,0xFF.toByte(),
+                0xFF.toByte(),0xFF.toByte(),0xFF.toByte(),0x89.toByte(),0,0,0x01,0),
+            apdu,object : HttpInterface {
+                override fun transmit(url: String,tx: ByteArray,headers: Array<String>): HttpInterface.HttpResponse =
+                    error("HTTP is not part of read-only recovery")
+                override fun usePublicKeyIds(pkids: Array<String>) =
+                    error("Public-key discovery is not part of read-only recovery")
+            })
+        override fun init(context: Long) = LpacJni.euiccInit(context)
+        override fun eid(context: Long) = LpacJni.es10cGetEid(context)
+        override fun profiles(context: Long) = LpacJni.es10cGetProfilesInfo(context)
+        override fun next(profile: Long) = LpacJni.profilesNext(profile)
+        override fun iccid(profile: Long) = LpacJni.profileGetIccid(profile)
+        override fun state(profile: Long) = LpacJni.profileGetStateString(profile)
+        override fun free(head: Long) { LpacJni.profilesFree(head) }
+        override fun finish(context: Long) = LpacJni.euiccFini(context)
+        override fun destroy(context: Long) = LpacJni.destroyContext(context)
+    }
+    fun read(apdu: ApduInterface): Int = read(apdu,Jni)
+    internal fun read(apdu: ApduInterface,calls: Calls): Int {
+        val context=calls.create(apdu)
+        if (context == 0L) throw ReadFailure()
+        var initialized=false
+        try {
+            if (calls.init(context) != 0) throw ReadFailure()
+            initialized=true
+            if (calls.eid(context)?.matches(Regex("[0-9]{32}")) != true) throw ReadFailure()
+            val head=calls.profiles(context)
+            try {
+                val seen=mutableSetOf<String>()
+                var current=head
+                while (current != 0L) {
+                    val id=calls.iccid(current)
+                    if (id.isEmpty() || !seen.add(id) ||
+                        calls.state(current) !in listOf("enabled","disabled")) throw ReadFailure()
+                    current=calls.next(current)
+                }
+                return seen.size
+            } finally { calls.free(head) }
+        } finally {
+            try { if (initialized) calls.finish(context) }
+            finally { calls.destroy(context) }
+        }
+    }
+}
