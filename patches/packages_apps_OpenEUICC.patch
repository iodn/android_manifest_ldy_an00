@@ -0,0 +1,70 @@
+package im.angry.openeuicc.core
+
+/** One active UI session's explicit intent and exact closed-blank receipt; never durable history. */
+internal class ManagementSessionOutcome(private val nonce: String) {
+    data class Choice(val cardId: Int, val iccid: String)
+    data class Grant(val nonce: String,val sequence: Long)
+    data class Scope(val cardId: Int,val operation: Int,val token: String,
+        val generation: Long,val routeSerial: Int,val observationSerial: Int)
+    private var keep: Choice? = null
+    private var uncertain = false
+    private var completed = false
+    private var sequence = 0L
+    private var workClosing = false
+    private var workFrozen = false
+    class Work internal constructor(private val session: ManagementSessionOutcome,
+        private val allowClosing: Boolean,private val readOnly: Boolean) {
+        fun allowed(operation: Int = 0) = session.workAllowed(allowClosing,readOnly,operation)
+    }
+    @Synchronized private fun workAllowed(allowClosing: Boolean,readOnly: Boolean,operation: Int) =
+        !workFrozen && (!workClosing || allowClosing) && (!readOnly || operation == 0)
+    @Synchronized fun work(allowClosing: Boolean = false,readOnly: Boolean = false) =
+        Work(this,allowClosing,readOnly)
+    @Synchronized fun enqueueWork(): Work? = if (workClosing || workFrozen) null else Work(this,true,false)
+    @Synchronized fun beginClosing() { workClosing = true }
+    @Synchronized fun freezeWork() { workFrozen = true }
+    private var blank: Pair<Grant,Scope>? = null
+    @Synchronized fun granted(): Grant {
+        blank=null
+        return Grant(nonce,++sequence)
+    }
+    @Synchronized fun scopeCompleted(grant: Grant,scope: Scope,knownBlank: Boolean,kind: Int,iccid: String?) {
+        if (completed || uncertain || grant.nonce != nonce || grant.sequence != sequence) return
+        blank=null
+        if (knownBlank) {
+            if (!(scope.operation == 2 && kind == 3 || scope.operation == 3 && kind == 4) || scope.cardId < 0
+                || !scope.token.matches(Regex("[0-9a-f]{32}")) || scope.generation <= 0
+                || !(scope.routeSerial > 0 && scope.observationSerial == -1
+                    || scope.routeSerial == 0 && scope.observationSerial > 0)) {
+                uncertain=true
+                return
+            }
+            blank=grant to scope
+        }
+        accepted(kind,scope.cardId,iccid)
+    }
+    @Synchronized fun accepted(kind: Int,cardId: Int,iccid: String?) {
+        if (completed || uncertain) return
+        if (kind == 2) {
+            if (cardId < 0 || iccid?.matches(Regex("[0-9]{18,22}")) != true) {
+                uncertain=true
+                return
+            }
+            keep=Choice(cardId,iccid)
+        } else if ((kind == 3 || kind == 4) && keep == Choice(cardId,iccid ?: "")) keep=null
+        else if (kind == 8 && keep?.cardId == cardId) keep=null
+    }
+    @Synchronized fun interrupted(grant: Grant? = null,native: Boolean = true) {
+        if (completed || grant != null && (grant.nonce != nonce || grant.sequence != sequence)) return
+        blank=null
+        if (native) uncertain=true
+    }
+    @Synchronized fun hasClosedBlank() = !completed && !uncertain && blank?.first == Grant(nonce,sequence)
+    @Synchronized fun choice(): Choice? = keep
+    /** null is interrupted/duplicate, never authority to restore. */
+    @Synchronized fun complete(drained: Boolean): Boolean? {
+        if (completed) return null
+        completed=true
+        return if (drained && !uncertain) keep != null else null
+    }
+}
diff --git a/app-common/src/main/java/im/angry/openeuicc/core/NativeMutationBoundary.kt b/app-common/src/main/java/im/angry/openeuicc/core/NativeMutationBoundary.kt
