@@ -0,0 +1,52 @@
+package im.angry.openeuicc.core
+
+fun main() {
+    var checks = 0
+    fun verify(b: Boolean) { check(b); checks++ }
+    fun rejects(action: () -> Unit) { verify(runCatching(action).isFailure) }
+    val admission = LpaChannelAdmission();val owner = Any();val stranger = Any()
+    admission.enter(null); rejects { admission.reserve(owner) };admission.leave()
+    admission.reserve(owner);rejects { admission.enter(null) };rejects { admission.enter(stranger) }
+    admission.enter(owner);rejects { admission.requireDrained(owner) };rejects { admission.complete(owner) }
+    admission.leave();admission.requireDrained(owner);rejects { admission.complete(stranger) }
+    admission.complete(owner);admission.enter(null);admission.leave()
+    admission.reserve(owner);admission.unknown();rejects { admission.enter(owner) }
+    rejects { admission.complete(owner) };rejects { admission.reserve(stranger) }
+
+    var nativeCalls = 0;var before = 0;var uncertain = 0
+    NativeMutationBoundary.observer.set(object : NativeMutationBoundary.Observer {
+        override fun before(kind: Int,lastProfileBefore: Boolean,targetIccid: String?) { before++ }
+        override fun returned(kind: Int) { }
+        override fun uncertain() { uncertain++ }
+    })
+    verify(NativeMutationBoundary.call(1) { nativeCalls++;true })
+    verify(before == 1 && nativeCalls == 1 && uncertain == 0)
+    rejects { NativeMutationBoundary.call<Boolean>(1) { nativeCalls++;false } }
+    verify(before == 2 && nativeCalls == 2 && uncertain > 0)
+    rejects { NativeMutationBoundary.call(1) { nativeCalls++;error("native failure") } }
+    verify(nativeCalls == 3 && uncertain > 1)
+    NativeMutationBoundary.observer.set(object : NativeMutationBoundary.Observer {
+        override fun before(kind: Int,lastProfileBefore: Boolean,targetIccid: String?) { error("lease refused") }
+        override fun returned(kind: Int) { }
+        override fun uncertain() { }
+    })
+    rejects { NativeMutationBoundary.call(1) { nativeCalls++;true } }
+    verify(nativeCalls == 3)
+    NativeMutationBoundary.observer.remove()
+    verify(!NativeMutationBoundary.call(1) { false }) // Preserve behavior outside a lease observer.
+    val closed = LogicalChannelCloseReceipt()
+    closed.opened(1);verify(closed.hasOpen());rejects { closed.requireAllClosed() }
+    closed.closed(1,true);closed.requireAllClosed();verify(!closed.hasOpen())
+    rejects { closed.closed(1,true) }
+    val uncertainClose = LogicalChannelCloseReceipt()
+    uncertainClose.opened(1);uncertainClose.opened(2);uncertainClose.closed(1,false)
+    uncertainClose.closed(2,true);verify(uncertainClose.owns(1));rejects { uncertainClose.requireAllClosed() }
+    val thrownClose = LogicalChannelCloseReceipt()
+    thrownClose.opened(1);thrownClose.failed();thrownClose.closed(1,true)
+    rejects { thrownClose.requireAllClosed() }
+    val retired = LogicalChannelCloseReceipt()
+    retired.opened(1);retired.closedScoped(1,3);retired.requireAllClosed();verify(!retired.hasOpen())
+    val unqualified = LogicalChannelCloseReceipt()
+    unqualified.opened(1);rejects { unqualified.closedScoped(1,0) };rejects { unqualified.requireAllClosed() }
+    println("HONOR_OPERATION_ADMISSION_HOST_PASS checks=$checks")
+}
