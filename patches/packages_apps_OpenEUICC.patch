+package im.angry.openeuicc.ui
+
+import android.app.Activity
+import android.widget.Toast
+import im.angry.openeuicc.common.R
+
+/** A completed blank route has no further LPA reads. Physical return stays an explicit Phone action. */
+internal fun Activity.finishForKnownBlank() {
+    if (im.angry.openeuicc.core.HonorManagementSession.isActiveFor(this)) {
+        (this as? MainActivity)?.refreshAfterKnownBlank()
+        return
+    }
+    Toast.makeText(this,R.string.esim_known_blank_return_guidance,Toast.LENGTH_LONG).show()
+    finishAffinity()
+}
