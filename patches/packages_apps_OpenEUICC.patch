@@ -0,0 +1,20 @@
+package net.typeblog.lpac_jni
+
+/** Only parsed, documented card rejections are definitive; transport/unknown codes stay false. */
+class ProfileOperationRejectedException(val kind: Int, val resultCode: Int) :
+    Exception("eUICC rejected profile operation (kind=$kind, code=$resultCode)") {
+    init { require(Es10cProfileResult.isKnownRejection(kind,resultCode)) }
+}
+
+object Es10cProfileResult {
+    fun isKnownRejection(kind: Int, code: Int): Boolean = when(kind) {
+        2 -> code in 1..5
+        3, 4 -> code in 1..3
+        else -> false
+    }
+    fun accepted(kind: Int, code: Int): Boolean {
+        if (code == 0) return true
+        if (isKnownRejection(kind,code)) throw ProfileOperationRejectedException(kind,code)
+        return false
+    }
+}
