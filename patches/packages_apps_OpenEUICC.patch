+/** Permission-protected framework resolution; opening this screen never grants consent. */
+class EuiccResolutionActivity : AppCompatActivity() {
+    private var completed = false
+    private var cardId = TelephonyManager.UNINITIALIZED_CARD_ID
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        completed = savedInstanceState?.getBoolean("completed", false) == true
+        cardId = intent.getIntExtra(EuiccService.EXTRA_RESOLUTION_CARD_ID,
+            TelephonyManager.UNINITIALIZED_CARD_ID)
+        val action = intent.action
+        if (completed || cardId < 0 || action !in setOf(
+                EuiccService.ACTION_RESOLVE_DEACTIVATE_SIM,
+                EuiccService.ACTION_RESOLVE_NO_PRIVILEGES,
+                EuiccService.ACTION_RESOLVE_RESOLVABLE_ERRORS)) {
+            finish(); return
+        }
+        val errors = intent.getIntExtra(EuiccService.EXTRA_RESOLVABLE_ERRORS, 0)
+        val codeRequired = action == EuiccService.ACTION_RESOLVE_RESOLVABLE_ERRORS &&
+            (errors and EuiccService.RESOLVABLE_ERROR_CONFIRMATION_CODE) != 0
+        val policyRequired = action == EuiccService.ACTION_RESOLVE_RESOLVABLE_ERRORS &&
+            (errors and EuiccService.RESOLVABLE_ERROR_POLICY_RULES) != 0
+        if (action == EuiccService.ACTION_RESOLVE_RESOLVABLE_ERRORS &&
+            (errors == 0 || (errors and (EuiccService.RESOLVABLE_ERROR_CONFIRMATION_CODE or
+                EuiccService.RESOLVABLE_ERROR_POLICY_RULES).inv()) != 0)) {
+            finish(); return
+        }
+        val layout = LinearLayout(this).apply { orientation = LinearLayout.VERTICAL }
+        val pad = (16 * resources.displayMetrics.density).toInt()
+        ViewCompat.setOnApplyWindowInsetsListener(layout) { view, insets ->
+            val bars = insets.getInsets(WindowInsetsCompat.Type.systemBars() or
+                WindowInsetsCompat.Type.displayCutout())
+            view.setPadding(pad + bars.left, pad + bars.top, pad + bars.right, pad + bars.bottom)
+            insets
+        }
+        layout.addView(TextView(this).apply {
+            text = when (action) {
+                EuiccService.ACTION_RESOLVE_DEACTIVATE_SIM ->
+                    getString(R.string.framework_download_deactivate_consent)
+                EuiccService.ACTION_RESOLVE_NO_PRIVILEGES -> {
+                    val caller = intent.getStringExtra(EuiccService.EXTRA_RESOLUTION_CALLING_PACKAGE)
+                    val label = try { caller?.let {
+                        packageManager.getApplicationLabel(packageManager.getApplicationInfo(it, 0))
+                    } } catch (_: android.content.pm.PackageManager.NameNotFoundException) { null }
+                    if (label != null) getString(R.string.framework_download_app_consent, label)
+                    else getString(R.string.framework_download_consent)
+                }
+                else -> getString(R.string.framework_download_consent)
+            }
+        })
+        val code = EditText(this).apply {
+            setHint(R.string.framework_download_confirmation_code)
+            inputType = InputType.TYPE_CLASS_TEXT or InputType.TYPE_TEXT_VARIATION_PASSWORD
+            isSaveEnabled = false
+        }
+        if (codeRequired) layout.addView(code)
+        val policy = CheckBox(this).apply { setText(R.string.framework_download_policy_consent) }
+        if (policyRequired) layout.addView(policy)
+        val allow = Button(this).apply { setText(android.R.string.ok) }
+        fun update() {
+            allow.isEnabled = (!codeRequired || !code.text.isNullOrBlank()) &&
+                (!policyRequired || policy.isChecked)
+        }
+        code.doAfterTextChanged { update() }
+        policy.setOnCheckedChangeListener { _, _ -> update() }
+        allow.setOnClickListener {
+            val extras = Bundle().apply {
+                putBoolean(EuiccService.EXTRA_RESOLUTION_CONSENT, true)
+                if (codeRequired) putString(EuiccService.EXTRA_RESOLUTION_CONFIRMATION_CODE,
+                    code.text.toString())
+                if (policyRequired) putBoolean(EuiccService.EXTRA_RESOLUTION_ALLOW_POLICY_RULES,
+                    policy.isChecked)
+            }
+            continueOnce(extras)
+        }
+        layout.addView(allow)
+        layout.addView(Button(this).apply {
+            setText(android.R.string.cancel)
+            setOnClickListener { decline() }
+        })
+        onBackPressedDispatcher.addCallback(this, object : OnBackPressedCallback(true) {
+            override fun handleOnBackPressed() = decline()
+        })
+        setContentView(layout)
+        ViewCompat.requestApplyInsets(layout)
+        update()
+    }
+
+    private fun decline() = continueOnce(Bundle().apply {
+        putBoolean(EuiccService.EXTRA_RESOLUTION_CONSENT, false)
+    })
+
+    private fun continueOnce(extras: Bundle) {
+        if (completed) return
+        completed = true
+        try {
+            getSystemService(EuiccManager::class.java)?.createForCardId(cardId)
+                ?.continueOperation(intent, extras)
+        } catch (_: RuntimeException) {
+            Toast.makeText(this, R.string.framework_download_resolution_failed, Toast.LENGTH_LONG).show()
+        } finally { finish() } // Unknown Binder completion is not automatically retried.
+    }
+
+    override fun onSaveInstanceState(outState: Bundle) {
+        outState.putBoolean("completed", completed)
+        super.onSaveInstanceState(outState)
+    }
+}
