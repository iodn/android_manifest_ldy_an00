@@ -0,0 +1,12 @@
+package im.angry.openeuicc.core
+
+import net.typeblog.lpac_jni.LocalProfileInfo
+
+/** Historical pre-mutation proof, never a fabricated current EID/card-present assertion. */
+internal object LastProfileProof {
+    fun before(kind: Int,iccid: String,profiles: List<LocalProfileInfo>): Boolean = when(kind) {
+        3 -> profiles.filter { it.state==LocalProfileInfo.State.Enabled }.singleOrNull()?.iccid==iccid
+        4 -> profiles.singleOrNull()?.iccid==iccid
+        else -> false
+    }
+}
