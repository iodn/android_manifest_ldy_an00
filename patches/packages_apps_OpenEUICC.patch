+ checkCase(!rejected.invalid && rejected.adapter.profiles.size==1,"confirmed rejection retains known inventory")
+ checkCase(rejected.refreshes==1 && rejected.fab.isEnabled,"confirmed rejection keeps ordinary refresh")
+ checkCase(rejected.activity.checks==0 && rejected.adapter.footerViews.isEmpty(),"confirmed rejection not unknown recovery")
+ val busy=Screen();busy.click(3);busy.add()
+ checkCase(Effects.dialogs==0,"stale busy menu refused")
+ val closing=Screen().apply{swipeRefresh.isRefreshing=false;this.closing=true}
+ closing.click(4);closing.add()
+ checkCase(Effects.dialogs==0 && closing.additions==0,"closing actions refused")
+ HonorLpaChannelAccess.honor=false
+ val generic=Screen()
+ runNow{generic.failed(TimeoutCancellationException())}
+ checkCase(Effects.legacyDialogs==1 && Effects.legacyFinishHandlers==1,"generic timeout retains one legacy finish dialog")
+ checkCase(generic.activity.checks==0,"generic timeout never opens Honor recovery")
+ checkCase(generic.adapter.profiles.size==1 && generic.refreshes==1,"generic timeout existing refresh unchanged")
+ HonorLpaChannelAccess.honor=true
+ println("PASS $checks actual failure/menu/FAB body checks; controlled UI/recovery, no Android/hardware claim")
+}
+"""
+    # Only unrelated timeout-message provider is a fixture expression, not uncertainty behavior.
+    failure=failure.replace("appContainer.customizableTextProvider.profileSwitchingTimeoutMessage","0")
+    fixture=fixture.replace("FAILURE_BODY",failure).replace("MENU_BODY",menu).replace("FAB_BODY",fab)
+    with tempfile.TemporaryDirectory(prefix="profile-uncertain-") as directory:
