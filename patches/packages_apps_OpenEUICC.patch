@@ -0,0 +1,166 @@
+package im.angry.openeuicc.core
+
+import android.content.pm.PackageManager
+import android.os.RemoteException
+import kotlinx.coroutines.*
+
+private interface IBinder
+private class Binder : IBinder
+private class ComponentName(val pkg: String, val name: String)
+private class Intent { fun setComponent(component: ComponentName) = this }
+private interface ServiceConnection {
+    fun onServiceConnected(name: ComponentName, service: IBinder)
+    fun onServiceDisconnected(name: ComponentName)
+    fun onBindingDied(name: ComponentName)
+    fun onNullBinding(name: ComponentName)
+}
+private enum class Case {
+    BIND_FALSE, TIMEOUT, BAD_VERSION, VERSION_EXCEPTION, OLD_CLOSE_FAILURE, ACTIVE_WRITE_FAILURE,
+    CLEAN_WRITE_FAILURE, DISCONNECT, ACQUIRE_EXCEPTION, ACQUIRE_TIMEOUT, MALFORMED_GRANT, NO_GRANT
+}
+private data class Target(val operation: Int, val slot: Int, val port: Int, val cardId: Int)
+private class EndpointNotReady : IllegalStateException()
+private class KnownBlankRoute : IllegalStateException()
+private class ProfileRejected(cause: Throwable) : Exception(cause)
+private class EuiccChannelManager(private val case: Case) {
+    fun invalidate() { if (case == Case.OLD_CLOSE_FAILURE) error("Prior channel close failed") }
+}
+private class Journal(private val case: Case) {
+    var active = false
+    var cleanWrites = 0
+    var cleanAttempts = 0
+    fun write(active: Boolean) {
+        if (active && case == Case.ACTIVE_WRITE_FAILURE) error("Active write failed")
+        if (!active) cleanAttempts++
+        if (!active && case == Case.CLEAN_WRITE_FAILURE) error("Clean write failed")
+        if (!active) cleanWrites++
+        this.active = active
+    }
+}
+private data class Lease(
+    val physicalSlot: Int = 1, val port: Int = 0, val cardId: Int = 2,
+    val uid: Int = 1000, val user: Int = 0, val operation: Int = 1,
+    val generation: Int = 1, val routeSerial: Int = 1, val observationSerial: Int = -1,
+    val token: String = "not a valid token"
+)
+private data class Grant(val code: Int, val lease: Lease?)
+private class IHonorLpaLease(private val case: Case) : IBinder {
+    object Stub { fun asInterface(service: IBinder) = service as IHonorLpaLease }
+    var acquireCalls = 0
+    var finishCalls = 0
+    fun protocolVersion(): Int {
+        if (case == Case.VERSION_EXCEPTION) throw RemoteException()
+        return if (case == Case.BAD_VERSION) 5 else 6
+    }
+    fun acquireV2(operation: Int, slot: Int, port: Int, card: Int, client: IBinder): Grant {
+        acquireCalls++
+        return when (case) {
+            Case.ACQUIRE_EXCEPTION -> throw RemoteException()
+            Case.ACQUIRE_TIMEOUT -> throw java.io.InterruptedIOException("Acquire response timed out")
+            Case.MALFORMED_GRANT -> Grant(1, Lease())
+            else -> Grant(3, null)
+        }
+    }
+    fun finish(lease: Lease, client: IBinder, completed: Boolean): Boolean {
+        finishCalls++
+        return false
+    }
+}
+private class Context(private val case: Case) {
+    companion object { const val BIND_AUTO_CREATE = 1 }
+    val api = IHonorLpaLease(case)
+    val packageManager = PackageManager()
+    val component = ComponentName("phone", "lease")
+    var connection: ServiceConnection? = null
+    var unbinds = 0
+    fun <T> getSystemService(type: Class<T>): T? = null
+    fun bindService(intent: Intent, connection: ServiceConnection, flags: Int): Boolean {
+        this.connection = connection
+        when (case) {
+            Case.BIND_FALSE, Case.CLEAN_WRITE_FAILURE -> return false
+            Case.TIMEOUT -> Unit
+            Case.DISCONNECT -> {
+                connection.onServiceDisconnected(component)
+                connection.onNullBinding(component)
+            }
+            else -> connection.onServiceConnected(component, api)
+        }
+        return true
+    }
+    fun unbindService(connection: ServiceConnection) { unbinds++ }
+}
+private class Session(val api: IHonorLpaLease, val lease: Lease, val client: IBinder,
+                      val target: Target, owner: Any) {
+    val completedKnownBlank = false
+    val uncertain = false
+    val nativeInFlight = false
+    val resetPending = false
+    val managementStamp = Any()
+    val managementKind = 0
+    val managementTarget: String? = null
+    val lastKind = 0
+    val rejectedConfirmed = false
+}
+private object NativeMutationBoundary { val observer = ThreadLocal<Session>() }
+private object HonorManagementSession {
+    fun scopeCompleted(stamp: Any, lease: Lease, blank: Boolean, kind: Int, target: String?) {}
+    fun scopeUncertain(stamp: Any, native: Boolean) {}
+}
+private class Client(case: Case) {
+    val admission = LpaChannelAdmission()
+    val journal: Journal? = Journal(case)
+    private val identity = ThreadLocal<Any>()
+    private var knownBlankForUi = false
+    private val CLIENT_RUNTIME_QUALIFIED = true
+    private fun isHonorBuild() = true
+    private fun initialize(context: Context) {}
+    private inline fun <T> endpointReadRpc(call: () -> T) = call()
+__PRODUCTION_RUN_ON_IO__
+    suspend fun run(context: Context, manager: EuiccChannelManager): Unit =
+        runOnIo(context, manager, Target(1, 1, 0, 2), {}) { error("Unexpected operation") }
+}
+
+fun main() = runBlocking {
+    val cases = listOf(
+        Case.BIND_FALSE, Case.TIMEOUT, Case.BAD_VERSION, Case.VERSION_EXCEPTION, Case.NO_GRANT,
+        Case.OLD_CLOSE_FAILURE, Case.ACTIVE_WRITE_FAILURE, Case.CLEAN_WRITE_FAILURE, Case.DISCONNECT,
+        Case.ACQUIRE_EXCEPTION, Case.ACQUIRE_TIMEOUT, Case.MALFORMED_GRANT
+    )
+    val failures = mutableListOf<String>()
+    for ((index, scenario) in cases.withIndex()) {
+        val clean = index < 5
+        val client = Client(scenario)
+        val context = Context(scenario)
+        val error = runCatching { client.run(context, EuiccChannelManager(scenario)) }.exceptionOrNull()
+        try {
+            check(error != null) { "$scenario accepted an operation" }
+            if (scenario == Case.TIMEOUT) check(error is TimeoutCancellationException)
+            check(client.admission.isUnknown() == !clean) { "$scenario: incorrect admission state" }
+            check(client.journal!!.cleanWrites == if (clean) 1 else 0) { "$scenario: incorrect clean writes" }
+            check(client.journal.cleanAttempts == if (clean || scenario == Case.CLEAN_WRITE_FAILURE) 1 else 0)
+            check(client.journal.active == (!clean && scenario != Case.ACTIVE_WRITE_FAILURE))
+            check(context.api.acquireCalls == if (scenario in listOf(Case.NO_GRANT, Case.ACQUIRE_EXCEPTION,
+                Case.ACQUIRE_TIMEOUT, Case.MALFORMED_GRANT)) 1 else 0)
+            check(context.api.finishCalls == 0)
+            if (clean) {
+                // Stale callback from the completed binding cannot poison the next reservation.
+                val successor = Any()
+                client.admission.reserve(successor)
+                context.connection?.onBindingDied(context.component)
+                client.admission.complete(successor)
+                client.admission.requireIdle()
+            }
+        } catch (failure: IllegalStateException) {
+            failures += "$scenario: ${failure.message}"
+        }
+    }
+    check(failures.isEmpty()) { failures.joinToString("\n") }
+    val admission = LpaChannelAdmission()
+    val owner = Any()
+    admission.reserve(owner)
+    var foreignWrite = false
+    check(runCatching { admission.complete(Any()) { foreignWrite = true } }.isFailure)
+    check(!foreignWrite)
+    admission.complete(owner)
+    println("PASS: 12 actual runOnIo paths and exact-owner/late-callback checks")
+}
