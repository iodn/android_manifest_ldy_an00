+            trace.returned(prepared)
+            trace.enter(Phase.PREPARE_VALIDATION)
+            check(prepared==0 || prepared==1) { "Reset preparation was not confirmed" }
+            trace.returned()
+            trace.enter(Phase.JNI_INVALIDATION)
+            session.trace.enter(Stage.JNI_DRAIN)
+            manager.invalidate() // Synchronous JNI fini/destroy; exact old retirement/close receipt required.
+            trace.returned()
