+package im.angry.openeuicc.core
+
+import android.content.Context
+import java.io.File
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.ensureActive
+import kotlinx.coroutines.withContext
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+
+/** Not called by startup or cached viewing. Existing live routing remains separately gated. */
+internal object HonorProfileInventory {
+    private val captureLock=Mutex()
+    fun store(context: Context) =
+        ProfileInventory.Store(File(context.applicationContext.noBackupFilesDir,"profile-inventory"))
+
+    /** The caller supplies an existing channel READ, not another lease or route preparation. */
+    suspend fun captureCompletedRead(context: Context,
+        completedRead: suspend () -> ProfileInventory.Snapshot): ProfileInventory.Capture =
+        withContext(Dispatchers.IO) { captureLock.withLock {
+            ProfileInventory.captureAndPublish(store(context),
+                outerRead = {
+                    HonorLpaLeaseClient.requiresCloseProof() && NativeMutationBoundary.observer.get() == null
+                }) {
+                val snapshot=completedRead()
+                // Cooperative cancellation check after positive close/finish, before publication.
+                coroutineContext.ensureActive()
+                snapshot
+            }
+        } }
+}
