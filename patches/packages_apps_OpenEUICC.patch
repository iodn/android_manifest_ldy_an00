@@ -0,0 +1,19 @@
+package net.typeblog.lpac_jni
+
+/** A completed pending-notification read followed by an HTTP-only delivery failure. */
+class NotificationDeliveryException : IllegalStateException(
+    "Notification delivery failed; the pending notification remains on the eSIM"
+) {
+    var scopeDrained: Boolean = false
+        private set
+
+    /** Set only after the operation owner receives positive Phone completion and local drain. */
+    fun markScopeDrained() { scopeDrained = true }
+
+    companion object {
+        fun accepted(result: Int): Boolean {
+            if (result == -2) throw NotificationDeliveryException()
+            return result == 0
+        }
+    }
+}
