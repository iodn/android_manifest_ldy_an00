+        UiccCardInfo(true,id,value,slot,true,false,ports)
+    private fun manage() = Intent(EuiccService.ACTION_MANAGE_EMBEDDED_SUBSCRIPTIONS)
+
+    @Test fun managePreservesTargetExtrasFlagsAndOriginal() {
+        val source=manage().putExtra(EuiccService.EXTRA_RESOLUTION_CARD_ID,0)
+            .putExtra(EuiccService.EXTRA_RESOLUTION_PORT_INDEX,0)
+            .putExtra("android.telephony.euicc.extra.FORCE_PROVISION",false)
+            .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+        val target=ComponentName("im.angry.openeuicc","im.angry.openeuicc.ui.PrivilegedMainActivity")
+        val out=EuiccUiRouting.managementIntent(source,target)!!
+        assertEquals(target,out.component)
+        assertEquals(0,out.getIntExtra(EuiccService.EXTRA_RESOLUTION_CARD_ID,-1))
+        assertEquals(0,out.getIntExtra(EuiccService.EXTRA_RESOLUTION_PORT_INDEX,-1))
+        assertEquals(source.flags,out.flags)
+        assertFalse(out.getBooleanExtra("android.telephony.euicc.extra.FORCE_PROVISION",true))
+        assertNull(source.component)
+        assertNotSame(source,out)
+    }
+    @Test fun provisionStaysDownloadFlow() {
+        assertNull(EuiccUiRouting.managementIntent(
+            Intent(EuiccService.ACTION_PROVISION_EMBEDDED_SUBSCRIPTION),
+            ComponentName("im.angry.openeuicc","manager")))
+    }
+    @Test fun requestedCardZeroIsValidAndNeverUsesOtherCard() {
+        val source=manage().putExtra(EuiccService.EXTRA_RESOLUTION_CARD_ID,0)
+        assertEquals(listOf(1 to 0),EuiccUiRouting.managementPorts(source,5,listOf(card(5,2),card(0))))
+    }
+    @Test fun absentRequestedCardDoesNotFallBackToDefault() {
+        val source=manage().putExtra(EuiccService.EXTRA_RESOLUTION_CARD_ID,7)
+        assertTrue(EuiccUiRouting.managementPorts(source,5,listOf(card(5))).isEmpty())
+    }
+    @Test fun unknownDefaultDoesNotFallBackToAnyCard() {
+        assertTrue(EuiccUiRouting.managementPorts(manage(),-1,listOf(card(5))).isEmpty())
+    }
+    @Test fun defaultCardSelectsGenuineMappedEuicc() {
+        assertEquals(listOf(1 to 0),EuiccUiRouting.managementPorts(manage(),5,listOf(card(5))))
+    }
+    @Test fun requestedPortMustBeActiveAndMapped() {
