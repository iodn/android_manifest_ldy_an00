@@ -0,0 +1,20 @@
+package im.angry.openeuicc.core
+
+import android.content.Intent
+
+/** Validate explicit foreground discovery targets before any Phone preparation or enumeration. */
+internal object HonorLpaDiscoveryIntent {
+    // EuiccService resolution extras; kept here without a hidden framework dependency in common.
+    private const val CARD_ID = "android.service.euicc.extra.RESOLUTION_CARD_ID"
+    private const val PORT_INDEX = "android.service.euicc.extra.RESOLUTION_PORT_INDEX"
+    private const val LOGICAL_SLOT = "selectedLogicalSlot"
+
+    fun expectedCardId(intent: Intent): Int {
+        if (intent.hasExtra(PORT_INDEX)) require(intent.getIntExtra(PORT_INDEX, -1) == 0)
+        // Encoded logical slot 1 and secure element DEFAULT (0).
+        if (intent.hasExtra(LOGICAL_SLOT)) require(intent.getIntExtra(LOGICAL_SLOT, -1) == (1 shl 16))
+        return if (intent.hasExtra(CARD_ID)) {
+            intent.getIntExtra(CARD_ID, -1).also { require(it >= 0) }
+        } else -1
+    }
+}
diff --git a/app-common/src/main/java/im/angry/openeuicc/core/HonorLpaLeaseClient.kt b/app-common/src/main/java/im/angry/openeuicc/core/HonorLpaLeaseClient.kt
