+    private suspend fun <T> withRecoveryApi(context: Context,operation: suspend (IHonorLpaLease) -> T): T {
+        check(requiresCloseProof() && android.os.UserHandle.myUserId() == 0)
+        check(context.packageManager.checkSignatures("android","com.android.phone") ==
+            android.content.pm.PackageManager.SIGNATURE_MATCH)
+        val bindingContext=context.applicationContext
+        val connected=CompletableDeferred<IHonorLpaLease>()
+        val connection=object : ServiceConnection {
+            override fun onServiceConnected(name: ComponentName,service: IBinder) {
+                connected.complete(IHonorLpaLease.Stub.asInterface(service))
+            }
+            override fun onServiceDisconnected(name: ComponentName) {
+                connected.completeExceptionally(RecoveryUnavailable())
+            }
+            override fun onBindingDied(name: ComponentName) {
+                connected.completeExceptionally(RecoveryUnavailable())
+            }
+            override fun onNullBinding(name: ComponentName) {
+                connected.completeExceptionally(RecoveryUnavailable())
+            }
+        }
+        var bound=false
+        try {
+            val bindingIntent=Intent().setComponent(ComponentName("com.android.phone",
+                "com.android.internal.telephony.honor.HonorLpaLeaseService"))
+            bound=recoveryRpc { bindingContext.bindService(bindingIntent,connection,Context.BIND_AUTO_CREATE) }
