+package im.angry.openeuicc.core
+
+import java.io.File
+import java.nio.file.Files
+import java.util.concurrent.CancellationException
+import kotlin.coroutines.*
+
+private var checks=0
+private fun verify(value: Boolean) { checks++;check(value) }
+private fun rejects(block: () -> Unit) {
+    try {block();error("Expected rejection")} catch (_: IllegalArgumentException) {checks++}
+}
+private fun <T> execute(block: suspend () -> T): T {
+    var outcome: Result<T>?=null
+    block.startCoroutine(object : Continuation<T> {
+        override val context=EmptyCoroutineContext
+        override fun resumeWith(result: Result<T>) {outcome=result}
+    })
+    return checkNotNull(outcome).getOrThrow()
+}
+fun main() {
+    val directory=Files.createTempDirectory("profile-inventory-test").toFile()
+    try {
+        val store=ProfileInventory.Store(File(directory,"private"))
+        val eid="1".repeat(32);val other="2".repeat(32)
+        fun row(i: Int,kind: String="Operational") =
+            ProfileInventory.Row("890000000000000000$i",false,"Name$i","Nickname$i","Provider$i",kind)
+        val snapshot=ProfileInventory.Snapshot(eid,1234,listOf(row(1),row(2),row(3,"Testing"),row(4,"Provisioning")))
+        verify(store.load(eid) == ProfileInventory.State.Unavailable)
+        verify(store.saved() == listOf(ProfileInventory.State.Unavailable))
+        store.publish(snapshot)
+        verify((store.load(eid) as ProfileInventory.State.Verified).snapshot == snapshot)
+        verify(snapshot.profiles.all { !it.enabledWhenRead })
+        verify(snapshot.profiles.map {it.profileClass} == listOf("Operational","Operational","Testing","Provisioning"))
+        val target=File(directory,"private").listFiles()!!.single()
+        val baseline=target.readBytes()
+        var reads=0
+        try {
+            execute {ProfileInventory.captureAndPublish(store, {false}) {reads++;snapshot}}
+            error("nested read")
+        } catch (_: IllegalStateException) {checks++}
+        verify(reads == 0 && target.readBytes().contentEquals(baseline))
+        for (failClose in listOf(true,false)) {
+            val admission=LpaChannelAdmission()
+            val owner=Any()
+            admission.reserve(owner)
+            var markedClean=false
+            var finishes=0
+            try {
+                execute {ProfileInventory.captureAndPublish(store, {true}) {
+                    admission.completeAfterDrain(owner,
