+package im.angry.openeuicc.service
+
+import im.angry.openeuicc.core.EuiccChannelManager
+
+/** The foreground service supplies the complete lease+drain operation, never just native success. */
+internal object DownloadedProfilePublication {
+    class RefreshFailure(cause: Exception) : Exception(
+        "Profile downloaded; Android SIM list refresh was not confirmed", cause)
+
+    suspend fun run(
+        prepareRefresh: (() -> EuiccChannelManager.DownloadedProfileRefresh?)?,
+        completedDownload: suspend () -> Unit
+    ) {
+        val refresh = prepareRefresh?.invoke()
+        completedDownload()
+        try { refresh?.request() }
+        catch (failure: Exception) { throw RefreshFailure(failure) }
+    }
+}
