+ suspend fun failed(err:Exception?) {
+FAILURE_BODY
+ }
+MENU_BODY
+ fun click(item:Int)=onMenuItemClicked(MenuItem(item))
+ fun add() {
+FAB_BODY
+ }
+}
+fun runNow(action:suspend()->Unit){
+ var failure:Throwable?=null
+ action.startCoroutine(object:Continuation<Unit>{
+ override val context=EmptyCoroutineContext
+ override fun resumeWith(result:Result<Unit>){failure=result.exceptionOrNull()}
+ })
+ failure?.let{throw it}
+}
+var checks=0
+fun checkCase(value:Boolean,message:String){checks++;check(value){message}}
+fun main(){
