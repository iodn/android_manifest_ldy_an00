+package im.angry.openeuicc.service
+
+import kotlin.coroutines.*
+import net.typeblog.lpac_jni.ProfileDownloadInput
+import org.junit.Assert.*
+import org.junit.Test
+
+class MultipleStoredProfilesTest {
+    private fun p(id:String,on:Boolean)=FrameworkProfileDownload.Profile(id,on)
+    private fun execute(block:suspend()->Unit) {
+        var result:Result<Unit>?=null
+        block.startCoroutine(object:Continuation<Unit> {
+            override val context=EmptyCoroutineContext
+            override fun resumeWith(outcome:Result<Unit>) {result=outcome}
+        })
+        checkNotNull(result).getOrThrow()
+    }
+    private fun refuses(block:()->Unit) {
+        try {block();fail("must refuse")} catch (_:IllegalStateException) {}
+    }
+    @Test fun switchToBRetainsAllStoredProfilesAndOnlyBActive() {
+        FrameworkProfileDownload.requireSingleActiveSwitch(
+            listOf(p("A",true),p("B",false),p("C",false)),
+            listOf(p("A",false),p("B",true),p("C",false)),"B",true)
+    }
+    @Test fun enabledBWhileAStillEnabledCannotBeReportedAsSuccess() {
+        refuses {FrameworkProfileDownload.requireSingleActiveSwitch(
+            listOf(p("A",true),p("B",false),p("C",false)),
+            listOf(p("A",true),p("B",true),p("C",false)),"B",true)}
+    }
+    @Test fun disableBDoesNotEnableAnotherProfile() {
+        FrameworkProfileDownload.requireSingleActiveSwitch(
+            listOf(p("A",false),p("B",true),p("C",false)),
+            listOf(p("A",false),p("B",false),p("C",false)),"B",false)
+        refuses {FrameworkProfileDownload.requireSingleActiveSwitch(
+            listOf(p("A",false),p("B",true),p("C",false)),
+            listOf(p("A",true),p("B",false),p("C",false)),"B",false)}
+    }
+    @Test fun lostOrDuplicatedStoredProfileCannotPassSwitch() {
+        for (after in listOf(listOf(p("A",false),p("B",true)),
+            listOf(p("A",false),p("B",true),p("C",false),p("C",false)))) {
+            refuses {FrameworkProfileDownload.requireSingleActiveSwitch(
+                listOf(p("A",true),p("B",false),p("C",false)),after,"B",true)}
+        }
+    }
+    private class Download : FrameworkProfileDownload.Operations {
+        var state=listOf(FrameworkProfileDownload.Profile("A",true),FrameworkProfileDownload.Profile("C",false))
+        var changeA=false
+        var dropC=false
+        var enables=0
+        override suspend fun profiles()=state
+        override suspend fun download(input:ProfileDownloadInput,confirm:(String?)->Boolean) {
+            check(confirm("B"))
+            state=state.map {if(changeA&&it.iccid=="A") it.copy(enabled=false) else it}+
+                FrameworkProfileDownload.Profile("B",false)
+            if(dropC) state=state.filterNot {it.iccid=="C"}
+        }
+        override suspend fun enable(iccid:String):Boolean {enables++;error("not requested")}
+        override suspend fun reconnect() {error("not requested")}
+    }
+    @Test fun addBWhileAActiveKeepsAAndCAndDoesNotAutoEnableB() {
+        val op=Download()
+        execute {FrameworkProfileDownload.run(ProfileDownloadInput("smdp.example","B",null,null),
+            false,true,op,singleActiveProfile=true)}
+        assertEquals(listOf(p("A",true),p("C",false),p("B",false)),op.state)
+        assertEquals(0,op.enables)
+    }
+    @Test fun downloadOnlyMustNotLoseCOrDisableA() {
+        for (op in listOf(Download().apply{changeA=true},Download().apply{dropC=true})) {
+            refuses {execute {FrameworkProfileDownload.run(
+                ProfileDownloadInput("smdp.example","B",null,null),false,true,op,singleActiveProfile=true)}}
+            assertEquals(0,op.enables)
+        }
+    }
+}
