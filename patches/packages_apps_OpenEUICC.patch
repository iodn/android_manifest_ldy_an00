+        val reads: List<FrameworkProfileDelete.Snapshot>,
+        val disableFailure: Boolean=false,val deleteFailure: Boolean=false
+    ): FrameworkProfileDelete.Operations {
+        val calls=mutableListOf<String>();var read=0
+        override suspend fun snapshot(): FrameworkProfileDelete.Snapshot {
+            calls += "read"
+            return reads[read++]
+        }
+        override suspend fun disable(target: String,expected: FrameworkProfileDelete.Snapshot) {
+            calls += "disable:$target"
+            check(!disableFailure)
+        }
+        override suspend fun delete(target: String,expected: FrameworkProfileDelete.Snapshot) {
+            calls += "delete:$target"
+            check(!deleteFailure)
+        }
+    }
+    val off=snapshot(profile("target",false),profile("other",false))
+    val on=snapshot(profile("target",true),profile("other",false))
+    val after=snapshot(profile("other",false))
+    val inactive=Operations(listOf(off,after))
+    FrameworkProfileDelete.run("target",inactive)
+    verify(inactive.calls==listOf("read","delete:target","read"))
+    val active=Operations(listOf(on,off,after))
+    FrameworkProfileDelete.run("target",active)
+    verify(active.calls==listOf("read","disable:target","read","delete:target","read"))
+    suspend fun refuses(ops: Operations): Operations {
+        verify(runCatching { FrameworkProfileDelete.run("target",ops) }.isFailure)
+        verify(ops.calls.count { it.startsWith("delete:") }<=1)
+        verify(ops.calls.count { it.startsWith("disable:") }<=1)
+        return ops
+    }
+    for (changed in listOf(
+        on,
+        off.copy(eid="2".repeat(32)),
+        snapshot(profile("target",false),profile("other",true)),
+        after,
+        snapshot(profile("target",false),profile("target",false)),
+        off.copy(eid="invalid")
+    )) {
+        val ops=refuses(Operations(listOf(on,changed)))
+        verify(ops.calls.none { it.startsWith("delete:") })
+    }
+    val multipleActive=refuses(Operations(listOf(snapshot(profile("target",true),profile("other",true)))))
+    verify(multipleActive.calls==listOf("read"))
+    val missing=refuses(Operations(listOf(after)))
+    verify(missing.calls==listOf("read"))
+    val disableFailed=refuses(Operations(listOf(on),disableFailure=true))
+    verify(disableFailed.calls==listOf("read","disable:target"))
+    val deleteFailed=refuses(Operations(listOf(off),deleteFailure=true))
+    verify(deleteFailed.calls==listOf("read","delete:target"))
+    refuses(Operations(listOf(off,off))) // Returned success is not proof of absence.
+    refuses(Operations(listOf(off,snapshot(profile("other",true)))))
+    val reordered=off.copy(profiles=off.profiles.reversed())
+    FrameworkProfileDelete.requireSame(off,reordered);checks++
+    verify(runCatching { FrameworkProfileDelete.requireSame(off,on) }.isFailure)
+    verify(runCatching { FrameworkProfileDelete.requireSame(off,off.copy(eid="2".repeat(32))) }.isFailure)
+    println("FRAMEWORK_PROFILE_DELETE_HOST_PASS checks=$checks")
+}
diff --git a/app-common/src/test/java/im/angry/openeuicc/service/FrameworkProfileDownloadHostTest.kt b/app-common/src/test/java/im/angry/openeuicc/service/FrameworkProfileDownloadHostTest.kt
new file mode 100644
index 0000000000000000000000000000000000000000..204afd54cf4a91b50a03a5d8ed4f0bbfffaa2454
--- /dev/null
+++ b/app-common/src/test/java/im/angry/openeuicc/service/FrameworkProfileDownloadHostTest.kt
@@ -0,0 +1,128 @@
+package im.angry.openeuicc.service
+
+import kotlin.coroutines.*
+import net.typeblog.lpac_jni.ProfileDownloadInput
+
+/** Executes the exact production workflow with synthetic profiles; no Android/LPA/network. */
+object FrameworkProfileDownloadHostTest {
+    private var checks = 0
+    private fun check(value: Boolean) { checks++; if (!value) throw AssertionError("check $checks") }
+    private fun execute(block: suspend () -> Unit) {
+        var outcome: Result<Unit>? = null
+        block.startCoroutine(object : Continuation<Unit> {
+            override val context = EmptyCoroutineContext
+            override fun resumeWith(result: Result<Unit>) { outcome = result }
+        })
+        check(outcome != null)
+        outcome!!.getOrThrow()
+    }
+    private fun fails(block: suspend () -> Unit) {
+        try { execute(block) } catch (_: IllegalStateException) { checks++; return }
+        catch (_: IllegalArgumentException) { checks++; return }
+        error("expected failure")
+    }
+    private val input = ProfileDownloadInput("smdp.example", "opaque-token", null, "opaque-code")
+    private class Fake : FrameworkProfileDownload.Operations {
+        var profiles = listOf(FrameworkProfileDownload.Profile("old", false))
+        var metadata: List<String?> = listOf("new")
+        var extraProfile = false
+        var inventoryFailure: Exception? = null
+        var installedEnabled = false
+        var enableResult = true
+        var reconnectFails = false
+        var actualEnabled = true
+        var downloads = 0; var enables = 0; var reconnects = 0
+        var received: ProfileDownloadInput? = null
+        override suspend fun profiles(): List<FrameworkProfileDownload.Profile> {
+            if (downloads > 0) inventoryFailure?.let { throw it }
+            return profiles
+        }
+        override suspend fun download(input: ProfileDownloadInput, confirm: (String?) -> Boolean) {
+            downloads++; received = input
+            metadata.forEach { if (!confirm(it)) error("metadata refused") }
+            profiles = profiles + FrameworkProfileDownload.Profile("new", installedEnabled)
+            if (extraProfile) profiles = profiles + FrameworkProfileDownload.Profile("unexpected", false)
+        }
+        override suspend fun enable(iccid: String): Boolean {
+            check(iccid == "new"); enables++
+            if (enableResult && actualEnabled) profiles = profiles.map {
+                if (it.iccid == iccid) it.copy(enabled = true) else it
+            }
+            return enableResult
+        }
+        override suspend fun reconnect() { reconnects++; if (reconnectFails) error("reconnect") }
+    }
+    @JvmStatic fun main(args: Array<String>) {
+        val install = Fake()
+        execute { FrameworkProfileDownload.run(input, false, true, install) }
+        check(install.downloads == 1 && install.enables == 0 && install.reconnects == 0)
+        check(install.received == input)
+        val enable = Fake()
+        execute { FrameworkProfileDownload.run(input, true, true, enable) }
+        check(enable.downloads == 1 && enable.enables == 1 && enable.reconnects == 1)
+        val consent = Fake()
+        fails { FrameworkProfileDownload.run(input, true, false, consent) }
+        check(consent.downloads == 0 && consent.enables == 0)
+        for (bad in listOf(listOf<String?>(), listOf(null), listOf("old"), listOf("new", "other"))) {
+            val fake = Fake().apply { metadata = bad }
+            fails { FrameworkProfileDownload.run(input, true, true, fake) }
+            check(fake.downloads == 1 && fake.enables == 0)
+        }
+        val extra = Fake().apply { extraProfile = true }
+        fails { FrameworkProfileDownload.run(input, true, true, extra) }
+        check(extra.enables == 0)
+        val unexpected = Fake().apply { installedEnabled = true }
+        fails { FrameworkProfileDownload.run(input, false, true, unexpected) }
+        check(unexpected.enables == 0)
+        val alreadyEnabled = Fake().apply { installedEnabled = true }
+        execute { FrameworkProfileDownload.run(input, true, true, alreadyEnabled) }
+        check(alreadyEnabled.enables == 0 && alreadyEnabled.reconnects == 1)
+        val unknown = Fake().apply { enableResult = false }
+        fails { FrameworkProfileDownload.run(input, true, true, unknown) }
+        check(unknown.downloads == 1 && unknown.enables == 1 && unknown.reconnects == 0)
+        val refresh = Fake().apply { reconnectFails = true }
+        fails { FrameworkProfileDownload.run(input, true, true, refresh) }
+        check(refresh.downloads == 1 && refresh.enables == 1 && refresh.reconnects == 1)
+        val notEnabled = Fake().apply { actualEnabled = false }
+        fails { FrameworkProfileDownload.run(input, true, true, notEnabled) }
+        check(notEnabled.enables == 1)
+        val duplicate = Fake().apply {
+            profiles = listOf(FrameworkProfileDownload.Profile("old", false),
+                FrameworkProfileDownload.Profile("old", false))
+        }
+        fails { FrameworkProfileDownload.run(input, false, true, duplicate) }
+        check(duplicate.downloads == 0)
+        val first = FrameworkProfileDownload.Profile("old", true)
+        val second = FrameworkProfileDownload.Profile("new", false)
+        val stored = listOf(first, second)
+        check(!FrameworkProfileDownload.switchNeeded(stored, "old", true))
+        check(!FrameworkProfileDownload.switchNeeded(stored, "new", false))
+        check(FrameworkProfileDownload.switchNeeded(stored, "old", false))
+        check(FrameworkProfileDownload.switchNeeded(stored, "new", true))
+        fails { FrameworkProfileDownload.switchNeeded(stored, "missing", true) }
+        fails { FrameworkProfileDownload.switchNeeded(stored + second, "new", true) }
+        fails { FrameworkProfileDownload.switchNeeded(listOf(first, second.copy(enabled = true)),
+            "new", false) }
+        val inconsistentInstall = Fake().apply {
+            profiles = listOf(first)
+            installedEnabled = true
+        }
+        fails { FrameworkProfileDownload.run(input, true, true, inconsistentInstall,
+            singleActiveProfile = true) }
+        check(inconsistentInstall.enables == 0 && inconsistentInstall.reconnects == 0)
+        val readFailure = IllegalStateException("Post-install inventory read failed")
+        val installedButUnreadable = Fake().apply { inventoryFailure = readFailure }
+        val unconfirmed = runCatching {
+            execute { FrameworkProfileDownload.run(input, false, true, installedButUnreadable) }
+        }.exceptionOrNull()
+        check(unconfirmed is FrameworkProfileDownload.InstallationUnconfirmed &&
+            unconfirmed.cause === readFailure)
+        check(installedButUnreadable.downloads == 1 && installedButUnreadable.enables == 0)
+        val cancellation = kotlin.coroutines.cancellation.CancellationException("cancelled")
+        val cancelled = Fake().apply { inventoryFailure = cancellation }
+        check(runCatching {
+            execute { FrameworkProfileDownload.run(input, false, true, cancelled) }
+        }.exceptionOrNull() === cancellation)
+        println("FRAMEWORK_DOWNLOAD_HOST_OK checks=$checks")
+    }
+}
