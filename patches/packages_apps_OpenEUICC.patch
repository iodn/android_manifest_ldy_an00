@@ -0,0 +1,46 @@
+/* Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0 */
+package im.angry.openeuicc.core;
+import android.app.Application;
+import android.content.Intent;
+import android.os.Bundle;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.Parcel;
+import android.os.ResultReceiver;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.RobolectricTestRunner;
+import org.robolectric.annotation.Config;
+import static org.junit.Assert.*;
+@RunWith(RobolectricTestRunner.class)
+@Config(sdk=37, manifest=Config.NONE, application=Application.class)
+public class HonorManagementEnvelopeHostTest {
+    @Test public void noEnvelopeAllowsOrdinaryLauncher() {
+        assertFalse(HonorManagementSession.INSTANCE.hasEnvelope(new Intent(Intent.ACTION_MAIN)));
+    }
+    @Test public void wellFormedEnvelopeIsNeverAnOrdinaryLauncher() {
+        assertTrue(HonorManagementSession.INSTANCE.hasEnvelope(new Intent(Intent.ACTION_MAIN)
+                .putExtra(HonorManagementSession.VERSION, 1)));
+    }
+    @Test public void senderPrivateParcelableIsRefusedInsteadOfCrashingOrLaunchingFresh() {
+        Intent source = new Intent(Intent.ACTION_MAIN);
+        source.putExtra(HonorManagementSession.RECEIVER,
+                new ResultReceiver(new Handler(Looper.getMainLooper())) {});
+        ClassLoader receiverLoader = new ClassLoader(null) {
+            @Override protected Class<?> loadClass(String name, boolean resolve)
+                    throws ClassNotFoundException {
+                if (name.startsWith(HonorManagementEnvelopeHostTest.class.getName()))
+                    throw new ClassNotFoundException(name);
+                return Class.forName(name, false, Bundle.class.getClassLoader());
+            }
+        };
+        Parcel wire = Parcel.obtain();
+        try {
+            source.writeToParcel(wire, 0); wire.setDataPosition(0);
+            Intent received = Intent.CREATOR.createFromParcel(wire);
+            received.setExtrasClassLoader(receiverLoader);
+            assertTrue(HonorManagementSession.INSTANCE.hasEnvelope(received));
+        } finally { wire.recycle(); }
+    }
+}
diff --git a/app-common/src/test/java/im/angry/openeuicc/core/HonorOperationAdmissionHostTest.kt b/app-common/src/test/java/im/angry/openeuicc/core/HonorOperationAdmissionHostTest.kt
new file mode 100644
index 0000000000000000000000000000000000000000..0e475ccd983ecc57ad87fe109b2520ea630ab834
--- /dev/null
+++ b/app-common/src/test/java/im/angry/openeuicc/core/HonorOperationAdmissionHostTest.kt
@@ -0,0 +1,202 @@
+package im.angry.openeuicc.core
+
+fun main() {
+    var checks = 0
+    fun verify(b: Boolean) { check(b); checks++ }
+    fun rejects(action: () -> Unit) { verify(runCatching(action).isFailure) }
+    val admission = LpaChannelAdmission();val owner = Any();val stranger = Any()
+    admission.enter(null)
+    val busy = runCatching { admission.reserve(owner) }.exceptionOrNull()
+    verify(busy is LpaChannelAdmission.Unavailable && !busy.uncertain)
+    admission.leave()
+    admission.reserve(owner);rejects { admission.enter(null) };rejects { admission.enter(stranger) }
+    admission.enter(owner);rejects { admission.requireDrained(owner) };rejects { admission.complete(owner) }
+    admission.leave();admission.requireDrained(owner);rejects { admission.complete(stranger) }
+    admission.complete(owner);admission.enter(null);admission.leave()
+    admission.reserve(owner);admission.unknown();rejects { admission.enter(owner) }
+    rejects { admission.complete(owner) }
+    val unresolved = runCatching { admission.reserve(stranger) }.exceptionOrNull()
+    verify(unresolved is LpaChannelAdmission.Unavailable && unresolved.uncertain)
+    val unresolvedRead = runCatching { admission.enter(null) }.exceptionOrNull()
+    verify(unresolvedRead is LpaChannelAdmission.Unavailable && unresolvedRead.uncertain)
+    // Neither observing the typed error nor an unowned completion releases UNKNOWN.
+    rejects { admission.complete(stranger) }
+    verify(runCatching { admission.reserve(owner) }.exceptionOrNull() is LpaChannelAdmission.Unavailable)
+
+    val lateCallback = LpaChannelAdmission();val oldOwner = Any();val newOwner = Any()
+    lateCallback.reserve(oldOwner);lateCallback.complete(oldOwner)
+    verify(!lateCallback.unknownIfOwned(oldOwner))
+    lateCallback.reserve(newOwner)
+    verify(!lateCallback.unknownIfOwned(oldOwner))
+    lateCallback.enter(newOwner);lateCallback.leave()
+    verify(lateCallback.unknownIfOwned(newOwner))
+    verify(lateCallback.unknownIfOwned(newOwner))
+    verify(!lateCallback.unknownIfOwned(oldOwner))
+    rejects { lateCallback.enter(newOwner) }
+
+    val recovery= LpaChannelAdmission();val recoveryOwner=Any()
+    rejects { recovery.reserveRecovery(recoveryOwner) } // CLEAN is not a recovery grant.
+    recovery.unknown()
+    var doneCalls=0;var cleanWrites=0
+    rejects { recovery.acknowledgeRecoveryAfterDone(
+        done={doneCalls++;false},markClean={cleanWrites++}) }
+    verify(doneCalls == 1 && cleanWrites == 0 && recovery.isUnknown())
+    recovery.reserveRecovery(recoveryOwner)
+    recovery.enter(recoveryOwner)
+    rejects { recovery.acknowledgeRecoveryAfterDone(recoveryOwner,
+        done={doneCalls++;true},markClean={cleanWrites++}) }
+    verify(doneCalls == 1 && cleanWrites == 0)
+    recovery.leave()
+    rejects { recovery.acknowledgeRecoveryAfterDone(Any(),
+        done={doneCalls++;true},markClean={cleanWrites++}) }
+    verify(doneCalls == 1 && cleanWrites == 0)
+    rejects { recovery.acknowledgeRecoveryAfterDone(recoveryOwner,
+        done={doneCalls++;true},markClean={error("journal write failed")}) }
+    verify(cleanWrites == 0)
+    recovery.unknown() // Actual client preserves UNKNOWN after a failed atomic local write.
+    recovery.acknowledgeRecoveryAfterDone(done={doneCalls++;true},markClean={cleanWrites++})
+    verify(cleanWrites == 1)
+    recovery.enter(null);recovery.leave()
+    val afterCrash=LpaChannelAdmission()
+    afterCrash.unknown() // Phone completed, process died before local C.
+    afterCrash.acknowledgeRecoveryAfterDone(done={true},markClean={cleanWrites++})
+    verify(cleanWrites == 2)
+    afterCrash.enter(null);afterCrash.leave()
+    val refusedGrant=LpaChannelAdmission();refusedGrant.unknown();refusedGrant.reserveRecovery(recoveryOwner)
+    refusedGrant.recoveryRefused(recoveryOwner)
+    verify(refusedGrant.isUnknown())
+    rejects { refusedGrant.enter(null) } // Refusal cannot authorize normal channels.
+
