+package im.angry.openeuicc.core
+
+import java.io.File
+import java.nio.file.Files
+import java.util.concurrent.CancellationException
+import kotlin.coroutines.*
+
+private var checks=0
+private fun verify(value: Boolean) { checks++;check(value) }
+private fun rejects(block: () -> Unit) {
+    try {block();error("Expected rejection")} catch (_: IllegalArgumentException) {checks++}
+}
+private fun <T> execute(block: suspend () -> T): T {
+    var outcome: Result<T>?=null
+    block.startCoroutine(object : Continuation<T> {
+        override val context=EmptyCoroutineContext
+        override fun resumeWith(result: Result<T>) {outcome=result}
+    })
+    return checkNotNull(outcome).getOrThrow()
+}
+fun main() {
+    val directory=Files.createTempDirectory("profile-inventory-test").toFile()
+    try {
+        val store=ProfileInventory.Store(File(directory,"private"))
+        val eid="1".repeat(32);val other="2".repeat(32)
+        fun row(i: Int,kind: String="Operational") =
+            ProfileInventory.Row("890000000000000000$i",false,"Name$i","Nickname$i","Provider$i",kind)
+        val snapshot=ProfileInventory.Snapshot(eid,1234,listOf(row(1),row(2),row(3,"Testing"),row(4,"Provisioning")))
+        verify(store.load(eid) == ProfileInventory.State.Unavailable)
+        verify(store.saved() == listOf(ProfileInventory.State.Unavailable))
+        store.publish(snapshot)
+        verify((store.load(eid) as ProfileInventory.State.Verified).snapshot == snapshot)
+        verify(snapshot.profiles.all { !it.enabledWhenRead })
+        verify(snapshot.profiles.map {it.profileClass} == listOf("Operational","Operational","Testing","Provisioning"))
+        val target=File(directory,"private").listFiles()!!.single()
+        val baseline=target.readBytes()
+        var reads=0
+        try {
+            execute {ProfileInventory.captureAndPublish(store, {false}) {reads++;snapshot}}
+            error("nested read")
+        } catch (_: IllegalStateException) {checks++}
+        verify(reads == 0 && target.readBytes().contentEquals(baseline))
+        for (failClose in listOf(true,false)) {
+            val admission=LpaChannelAdmission()
+            val owner=Any()
+            admission.reserve(owner)
+            var markedClean=false
+            var finishes=0
+            try {
+                execute {ProfileInventory.captureAndPublish(store, {true}) {
+                    admission.completeAfterDrain(owner,
+                        close={if(failClose) error("close not confirmed")},
+                        finish={finishes++;false},
+                        markClean={markedClean=true})
+                    snapshot
+                }}
+                error("unconfirmed completion")
+            } catch (_: IllegalStateException) {checks++}
+            verify(!markedClean && finishes == if(failClose) 0 else 1)
+            verify(target.readBytes().contentEquals(baseline))
+        }
+        val malformed=snapshot.copy(profiles=listOf(row(1),row(1)))
+        var successfulReads=0
+        val failedSave=execute {ProfileInventory.captureAndPublish(store, {true}) {
+            successfulReads++
+            malformed
+        }}
+        verify(successfulReads == 1 && !failedSave.saved && failedSave.snapshot === malformed)
+        verify(failedSave.snapshot.profiles === malformed.profiles)
+        verify(target.readBytes().contentEquals(baseline))
+        val blockedDirectory=File(directory,"not-a-directory").apply {writeText("preserve")}
+        val blockedSave=execute {ProfileInventory.captureAndPublish(
+            ProfileInventory.Store(blockedDirectory), {true}) {snapshot}}
+        verify(!blockedSave.saved && blockedSave.snapshot === snapshot)
+        verify(blockedDirectory.readText() == "preserve")
+        verify(Files.getPosixFilePermissions(target.toPath()).toString() == "[OWNER_READ, OWNER_WRITE]" ||
+            Files.getPosixFilePermissions(target.toPath()) == java.nio.file.attribute.PosixFilePermissions.fromString("rw-------"))
+        verify(Files.getPosixFilePermissions(target.parentFile.toPath()) ==
+            java.nio.file.attribute.PosixFilePermissions.fromString("rwx------"))
+        for (failure in listOf(IllegalStateException("finish ACK missing"),CancellationException("cancelled"))) {
+            try {execute {ProfileInventory.captureAndPublish(store, {true}) {throw failure}};error("expected failure")}
+            catch (caught: Exception) {verify(caught === failure)}
+            verify(target.readBytes().contentEquals(baseline))
+        }
+        val events=mutableListOf<String>()
+        execute {ProfileInventory.captureAndPublish(store, {true}) {
+            events += "EID";events += "one profile vector";events += "close";events += "finish ACK"
+            verify(target.readBytes().contentEquals(baseline))
+            snapshot.copy(verifiedAtMillis=2345)
+        }}
+        verify(events == listOf("EID","one profile vector","close","finish ACK"))
+        verify((store.load(eid) as ProfileInventory.State.Verified).snapshot.verifiedAtMillis == 2345L)
+        store.publish(ProfileInventory.Snapshot(other,3456,emptyList()))
+        verify(store.load(other) is ProfileInventory.State.VerifiedEmpty)
+        verify(store.saved().size == 2)
+        verify(store.load(eid) is ProfileInventory.State.Verified)
+        rejects {ProfileInventory.encode(snapshot.copy(eid="1"))}
+        rejects {ProfileInventory.encode(snapshot.copy(verifiedAtMillis=0))}
+        rejects {ProfileInventory.encode(snapshot.copy(profiles=listOf(row(1),row(1))))}
+        verify(ProfileInventory.decode(ProfileInventory.encode(snapshot.copy(profiles=listOf(row(1).copy(enabledWhenRead=true),row(2).copy(enabledWhenRead=true))))).profiles.all {it.enabledWhenRead})
+        rejects {ProfileInventory.encode(snapshot.copy(profiles=listOf(row(1).copy(iccid="bad"))))}
+        rejects {ProfileInventory.encode(snapshot.copy(profiles=listOf(row(1).copy(name="x".repeat(513)))))}
+        rejects {ProfileInventory.encode(snapshot.copy(profiles=listOf(row(1,"Unknown"))))}
+        rejects {ProfileInventory.encode(snapshot.copy(profiles=List(129) {row(it)}))}
+        rejects {ProfileInventory.decode(baseline + byteArrayOf(0))}
+        rejects {ProfileInventory.decode(ByteArray(262145))}
+        val saved=target.readBytes()
+        for (bytes in listOf(byteArrayOf(),saved.copyOf(5),saved.copyOf().also {it[0]=0},
+            saved.copyOf().also {it[48]=2})) {
+            target.writeBytes(bytes)
+            verify(store.load(eid) == ProfileInventory.State.Unavailable)
+            verify(store.saved() == listOf(ProfileInventory.State.Unavailable))
+        }
+        target.writeBytes(saved.copyOf().also {it[71]=2})
+        verify(store.load(eid) == ProfileInventory.State.Unavailable)
+        target.writeBytes(ByteArray(262145))
+        verify(store.load(eid) == ProfileInventory.State.Unavailable)
+        target.writeBytes(saved)
+        try {store.publish(snapshot.copy(profiles=listOf(row(1,"Unknown"))));error("invalid publish")}
+        catch (_: IllegalArgumentException) {checks++}
+        verify(target.readBytes().contentEquals(saved))
+        val newFile=File(target.parentFile,target.name+".new")
+        newFile.writeText("partial")
+        verify(store.load(eid) is ProfileInventory.State.Verified)
+        verify(store.saved().size == 2 && store.saved().none {it is ProfileInventory.State.Unavailable})
+        store.publish(snapshot.copy(verifiedAtMillis=4567))
+        verify(!newFile.exists())
+        verify((store.load(eid) as ProfileInventory.State.Verified).snapshot.verifiedAtMillis == 4567L)
+        target.writeBytes(saved)
+        val otherFile=target.parentFile.listFiles()!!.single {it != target}
+        val otherSaved=otherFile.readBytes()
+        target.writeBytes(otherSaved)
+        verify(store.load(eid) == ProfileInventory.State.Unavailable)
+        verify(store.saved() == listOf(ProfileInventory.State.Unavailable))
+        target.writeBytes(saved)
+        // Exhaust the bounded card set without evicting an older positively verified card.
+        for(i in 3..16) store.publish(ProfileInventory.Snapshot(i.toString().padStart(32,'0'),4000,emptyList()))
+        val before=target.readBytes()
+        try {store.publish(ProfileInventory.Snapshot("9".repeat(32),5000,emptyList()));error("capacity")}
+        catch (_: IllegalStateException) {checks++}
+        verify(target.readBytes().contentEquals(before))
+        verify(store.saved().size == 16)
+        println("PROFILE_INVENTORY_HOST_PASS checks=$checks")
+    } finally {directory.deleteRecursively()}
+}
