+/** A resume requires a new passive Phone reply, not a retained pre-background route snapshot. */
+@Composable
+private fun honorConnectionSnapshot(): Bundle? {
+    val context = LocalContext.current
+    if (!HonorLdyAn00EsimEntry.isAvailable(context)) return null
+    val lifecycle = LocalLifecycleOwner.current.lifecycle
+    val model: HonorLdyAn00EsimSetupViewModel = viewModel(
+        key = "honor_shared_sim_observer",
+        factory = HonorLdyAn00EsimSetupViewModel.passiveObserverFactory(
+            context.applicationContext as android.app.Application)
+    )
+    val state by model.state().observeAsState()
+    var beforeResume by remember(model) { mutableStateOf(model.state().value) }
+    DisposableEffect(lifecycle, model) {
+        val observer = LifecycleEventObserver { _, event ->
+            if (event == Lifecycle.Event.ON_RESUME) {
+                beforeResume = model.state().value
+                model.refreshSnapshotOnce()
+            } else if (event == Lifecycle.Event.ON_PAUSE) {
+                beforeResume = model.state().value
+            }
+        }
+        lifecycle.addObserver(observer)
+        if (lifecycle.currentState.isAtLeast(Lifecycle.State.RESUMED)) {
+            beforeResume = model.state().value
+            model.refreshSnapshotOnce()
+        }
+        onDispose { lifecycle.removeObserver(observer) }
+    }
+    return if (state !== beforeResume) state else null
+}
