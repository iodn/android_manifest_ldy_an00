+            case "WORKING", "EUICC_WAITING" -> {
+                if (!model.profileRouteRequested()) { error(); return; }
+                progress();
+            }
+            case "EUICC_READY", "KNOWN_BLANK" -> {
+                if (value.equals("KNOWN_BLANK") && model.profileRouteRequested()) { error(); return; }
