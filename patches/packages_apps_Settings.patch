--- /dev/null
+++ b/src/com/android/settings/network/HonorLdyAn00EsimSetupActivity.java
@@ -0,0 +1,277 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.settings.network;
+
+import android.content.ActivityNotFoundException;
+import android.content.Intent;
+import android.os.Bundle;
+
+import androidx.lifecycle.ViewModelProvider;
+
+import com.android.settings.R;
+import com.android.settings.network.telephony.ConfirmDialogFragment;
+import com.android.settings.network.telephony.SubscriptionActionDialogActivity;
+
+/** Uses the same SIM dialogs as SwitchToEsimConfirmDialogActivity; no bespoke dashboard. */
+public final class HonorLdyAn00EsimSetupActivity extends SubscriptionActionDialogActivity
+        implements ConfirmDialogFragment.OnConfirmListener {
+    private static final int SELECT_EUICC = 1, SELECT_PHYSICAL = 2, OPEN_MANAGEMENT = 3;
+    private static final int MANAGEMENT_REQUEST = 4, CONFIRM_MANAGEMENT = 5;
+    static final String EXTRA_CONFIRM_MANAGEMENT = "confirm_management";
+    private HonorLdyAn00EsimSetupViewModel mModel;
+    private int mDialogPhaseSerial = -1;
+    private boolean mTestImage, mDialogShown, mErrorShown, mReturnPhysical, mManageEsims, mConnectionOnly;
+    private boolean mManagementDebugConsent, mManagementEntryConsent;
+
+    @Override protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        if (!HonorLdyAn00EsimEntry.INSTANCE.isAvailable(this)
+                || !HonorLdyAn00EsimEntry.INSTANCE.isSetupIntent(getIntent())) {
+            finish(); return;
+        }
+        mManageEsims = getIntent().getBooleanExtra(
+                HonorLdyAn00EsimEntry.EXTRA_MANAGE_ESIMS, false);
+        mReturnPhysical = getIntent().getBooleanExtra("return_physical_sim2", false);
+        mConnectionOnly = getIntent().getBooleanExtra("connection_only", false);
+        mDialogShown = savedInstanceState != null && savedInstanceState.getBoolean("dialog");
+        mErrorShown = savedInstanceState != null && savedInstanceState.getBoolean("error");
+        mDialogPhaseSerial = savedInstanceState == null ? -1 : savedInstanceState.getInt("phase_serial", -1);
+        mManagementDebugConsent = savedInstanceState != null
+                && savedInstanceState.getBoolean("management_debug_consent");
+        mManagementEntryConsent = savedInstanceState != null
+                && savedInstanceState.getBoolean("management_entry_consent");
+        if (mManageEsims && getIntent().getBooleanExtra(EXTRA_CONFIRM_MANAGEMENT, false)
+                && !mManagementEntryConsent) {
+            if (!mDialogShown) {
+                mDialogShown = true;
+                ConfirmDialogFragment.show(this, ConfirmDialogFragment.OnConfirmListener.class,
+                        CONFIRM_MANAGEMENT, getString(R.string.honor_esim_manage),
+                        getString(R.string.honor_esim_manage_message),
+                        getString(R.string.honor_esim_manage), getString(R.string.sim_action_cancel));
+            }
+            return; // No ViewModel, Phone bind or selection before a real visible confirmation.
+        }
+        startSetup(savedInstanceState);
+    }
+
+    private void startSetup(Bundle savedInstanceState) {
+        mModel = new ViewModelProvider(this).get(HonorLdyAn00EsimSetupViewModel.class);
+        if (mManageEsims && (savedInstanceState != null && !mModel.isManagementSession()
+                || !mModel.beginManagement())) {
+            error(R.string.honor_esim_change_unconfirmed); return;
+        }
+        showProgressDialog(getString(R.string.honor_esim_connecting));
+        mModel.state().observe(this, this::render);
+    }
+
+    @Override protected void onSaveInstanceState(Bundle out) {
+        out.putBoolean("dialog", mDialogShown);
+        out.putBoolean("error", mErrorShown);
+        out.putInt("phase_serial", mDialogPhaseSerial);
+        out.putBoolean("management_debug_consent", mManagementDebugConsent);
+        out.putBoolean("management_entry_consent", mManagementEntryConsent);
+        super.onSaveInstanceState(out);
+    }
+
+    private void render(Bundle state) {
+        if (isFinishing() || isDestroyed()) return;
+        mTestImage = state.getBoolean("test_image", false);
+        if (mManageEsims) { renderManagement(state); return; }
+        String value = state.getString("state", "UNKNOWN");
+        if (!mModel.hasPreparedRoute() && (value.equals("IDLE") || value.equals("PHYSICAL_READY")
+                || value.equals("EUICC_READY") || value.equals("KNOWN_BLANK")
+                || value.equals("CONFIRMATION_REQUIRED"))) {
+            mModel.prepareRoute(mReturnPhysical, mTestImage);
+            return;
+        }
+        switch (value) {
+            case "WORKING" ->
+                    showProgressDialog(getString(R.string.honor_esim_connecting));
+            case "EUICC_WAITING" -> {
+                if (mReturnPhysical && HonorLdyAn00EsimSetupViewModel.canReturnPhysical(state)) {
+                    confirm(true, state.getInt("phase_serial", -1));
+                } else showProgressDialog(getString(R.string.honor_esim_connecting));
+            }
+            case "IDLE" -> confirm(mReturnPhysical, state.getInt("phase_serial", -1));
+            case "CONFIRMATION_REQUIRED" -> confirm(
+                    state.getBoolean("target_physical"), state.getInt("phase_serial", -1));
+            case "EUICC_READY" -> {
+                if (mConnectionOnly) { dismissProgressDialog(); finish(); return; }
+                if (mReturnPhysical) {
+                    if (HonorLdyAn00EsimSetupViewModel.canReturnPhysical(state)) confirm(true, state.getInt("phase_serial", -1));
+                    else error(R.string.honor_esim_change_unconfirmed);
+                    return;
+                }
+                dismissProgressDialog();
+                if (mModel.takeLpaLaunch()) {
+                    try {
+                        startActivity(HonorLdyAn00EsimEntry.INSTANCE.lpaIntent(mManageEsims));
+                        finish();
+                    } catch (ActivityNotFoundException | SecurityException unavailable) {
+                        error(R.string.honor_esim_lpa_unavailable);
+                    }
+                }
+            }
+            case "KNOWN_BLANK" -> {
+                if (mConnectionOnly) { dismissProgressDialog(); finish(); return; }
+                if (mReturnPhysical) {
+                    if (state.getBoolean("can_return", false)) confirm(true, state.getInt("phase_serial", -1));
+                    else error(R.string.honor_esim_change_unconfirmed);
+                } else {
+                    // No active profile is not a reason to hide management or force physical SIM2.
+                    // The LPA must qualify any new channel before listing or adding profiles.
+                    dismissProgressDialog();
+                    if (mModel.takeLpaLaunch()) {
+                        try {
+                            startActivity(HonorLdyAn00EsimEntry.INSTANCE.lpaIntent(true));
+                            finish();
+                        } catch (ActivityNotFoundException | SecurityException unavailable) {
+                            error(R.string.honor_esim_lpa_unavailable);
+                        }
+                    }
+                }
+            }
+            case "PHYSICAL_READY" -> {
+                if (mReturnPhysical) { dismissProgressDialog(); finish(); }
+                else confirm(false, state.getInt("phase_serial", -1));
+            }
+            case "CALL_BUSY" -> error(R.string.honor_esim_call_busy);
+            case "OBSERVATION_TIMEOUT" -> error(R.string.honor_esim_still_pending);
+            default -> error(R.string.honor_esim_change_unconfirmed);
+        }
+    }
+
+    /** This activity is private; caller authentication happens in the exported LPA facade. */
+    boolean hasForwardedManagementAction() {
+        String token = getIntent().getStringExtra("honor_management_action_token");
+        String kind = getIntent().getStringExtra("honor_management_action_kind");
+        return getIntent().getBooleanExtra(HonorLdyAn00EsimEntry.EXTRA_MANAGE_ESIMS, false)
+                && token != null && token.matches("[0-9a-f]{32}")
+                && kind != null && kind.matches("ENABLE|DISABLE|DELETE|RENAME|ADD")
+                && !getIntent().getBooleanExtra(EXTRA_CONFIRM_MANAGEMENT, false);
+    }
+
+    private void renderManagement(Bundle state) {
+        switch (state.getString("management_stage", "UNAVAILABLE")) {
+            case "PREPARING" -> {
+                // The private facade already authenticated this exact in-app user action.
+                // A development image does not require another prompt for the same gesture.
+                boolean trustedAction = hasForwardedManagementAction();
+                if (mTestImage && !mManagementDebugConsent && !trustedAction) {
+                    confirm(false, state.getInt("phase_serial", -1));
+                } else {
+                    if (mTestImage && trustedAction) mManagementDebugConsent = true;
+                    showProgressDialog(getString(R.string.honor_esim_connecting));
+                    mModel.continueManagement(mManagementDebugConsent);
+                }
+            }
+            case "READY" -> {
+                Bundle session = mModel.takeManagementLaunch();
+                if (session == null) return;
+                dismissProgressDialog();
+                String actionToken = getIntent().getStringExtra("honor_management_action_token");
+                if (actionToken != null && actionToken.matches("[0-9a-f]{32}"))
+                    session.putString("honor_management_action_token", actionToken);
+                try {
+                    startActivityForResult(HonorLdyAn00EsimEntry.INSTANCE.lpaIntent(true)
+                            .putExtras(session), MANAGEMENT_REQUEST);
+                } catch (ActivityNotFoundException | SecurityException unavailable) {
+                    mModel.managementLaunchFailed();
+                }
+            }
+            case "WAITING_LPA" -> dismissProgressDialog();
+            case "RESTORING" -> {
+                showProgressDialog(getString(R.string.honor_esim_connecting));
+                mModel.continueManagement(mManagementDebugConsent);
+            }
+            case "DONE" -> {
+                dismissProgressDialog();
+                setResult(RESULT_OK);
+                finish();
+            }
+            case "LAUNCH_FAILED" -> error(R.string.honor_esim_lpa_unavailable);
+            default -> error("CALL_BUSY".equals(state.getString("state"))
+                    ? R.string.honor_esim_call_busy : R.string.honor_esim_change_unconfirmed);
+        }
+    }
+
+    @Override protected void onActivityResult(int requestCode, int resultCode, Intent data) {
+        super.onActivityResult(requestCode, resultCode, data);
+        if (requestCode == MANAGEMENT_REQUEST && mManageEsims) {
+            Bundle result = data == null ? null : data.getExtras();
+            if (!mModel.managementDispatchFailed(resultCode, result))
+                mModel.completeManagement(resultCode, result);
+        }
+    }
+
+    private void confirm(boolean physical, int phaseSerial) {
+        dismissProgressDialog();
+        if (mDialogShown) return;
+        if (phaseSerial < 0) { error(R.string.honor_esim_change_unconfirmed); return; }
+        mDialogPhaseSerial = phaseSerial;
+        mDialogShown = true;
+        String message = getString(physical ? R.string.honor_esim_return_message
+                : mManageEsims ? R.string.honor_esim_manage_message
+                        : R.string.honor_esim_sim2_message);
+        if (mTestImage) message += "\n\n" + getString(R.string.honor_esim_debug_message);
+        ConfirmDialogFragment.show(this, ConfirmDialogFragment.OnConfirmListener.class,
+                physical ? SELECT_PHYSICAL : SELECT_EUICC,
+                physical ? getString(R.string.sim_action_switch_sub_dialog_title,
+                        getString(R.string.honor_esim_physical_slot2))
+                        : getString(mManageEsims ? R.string.honor_esim_manage_title
+                                : R.string.honor_esim_sim2_title),
+                message, getString(mManageEsims ? R.string.honor_esim_manage
+                        : R.string.sim_switch_button), getString(R.string.sim_action_cancel));
+    }
+
+    @Override public void onConfirm(int tag, boolean confirmed, int ignored) {
+        mDialogShown = false;
+        if (!confirmed) { finish(); return; }
+        if (tag == CONFIRM_MANAGEMENT) {
+            if (!mManageEsims || !getIntent().getBooleanExtra(EXTRA_CONFIRM_MANAGEMENT, false)
+                    || mManagementEntryConsent || mModel != null) return;
+            mManagementEntryConsent = true;
+            startSetup(null); // A new positive gesture, never an automatic retry.
+            return;
+        }
+        if (mManageEsims) {
+            if (tag != SELECT_EUICC) { finish(); return; }
+            mManagementDebugConsent = mTestImage;
+            mModel.continueManagement(mManagementDebugConsent);
+            return;
+        }
+        if (tag == OPEN_MANAGEMENT) {
+            try {
+                startActivity(HonorLdyAn00EsimEntry.INSTANCE.lpaIntent(true));
+                finish();
+            } catch (ActivityNotFoundException | SecurityException unavailable) {
+                showErrorDialog(getString(R.string.honor_esim_error_title),
+                        getString(R.string.honor_esim_lpa_unavailable));
+            }
+            return;
+        }
+        if (tag != SELECT_EUICC && tag != SELECT_PHYSICAL) { finish(); return; }
+        mModel.choose(tag == SELECT_PHYSICAL, mTestImage, mDialogPhaseSerial);
+    }
+
+    private void error(int message) {
+        dismissProgressDialog();
+        if (mErrorShown) return;
+        mErrorShown = true;
+        for (androidx.fragment.app.Fragment fragment :
+                getSupportFragmentManager().getFragments()) {
+            if (fragment instanceof ConfirmDialogFragment dialog) dialog.dismiss();
+        }
+        mDialogShown = false;
+        if (!mManageEsims && (message == R.string.honor_esim_change_unconfirmed
+                || message == R.string.honor_esim_still_pending)) {
+            mDialogShown = true;
+            ConfirmDialogFragment.show(this, ConfirmDialogFragment.OnConfirmListener.class,
+                    OPEN_MANAGEMENT, getString(R.string.honor_esim_error_title),
+                    getString(message) + "\n\n" + getString(R.string.honor_esim_management_recovery),
+                    getString(R.string.honor_esim_manage), getString(R.string.sim_action_cancel));
+        } else showErrorDialog(getString(R.string.honor_esim_error_title), getString(message));
+    }
+}
