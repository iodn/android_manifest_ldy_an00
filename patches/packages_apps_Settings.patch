+        assertFalse(sent.get(sent.size() - 1).getData().containsKey("management_session_nonce"));
+        reply("PHYSICAL_READY", 9, false);
+        assertTrue(model.hasPreparedRoute()); assertEquals(0, selects());
+        model.choose(false, true, 9); drain();
+        assertEquals(1, selects());
+        assertEquals(9, sent.get(sent.size() - 1).getData().getInt("phase_serial"));
+    }
+    @Test public void coldManagementUsesPreparedJournalPhaseWithoutExtraChoice() throws Exception {
+        assertTrue(model.beginManagement()); reply("IDLE", 0, false);
+        model.continueManagement(true); drain(); assertEquals(8, sent.get(sent.size() - 1).what);
+        reply("PHYSICAL_READY", 9, false); model.continueManagement(true); drain();
+        assertEquals(1, selects());
+        assertEquals(9, sent.get(sent.size() - 1).getData().getInt("phase_serial"));
+        reply("EUICC_READY", 10, true); assertEquals("READY", stage());
+        assertNotNull(model.takeManagementLaunch());
+    }
+    @Test public void preparationBusyOrUnqualifiedCannotSelect() throws Exception {
+        reply("IDLE", 0, false); model.prepareRoute(false, true); drain();
+        reply("CALL_BUSY", 0, false);
+        assertFalse(model.hasPreparedRoute()); assertEquals(0, selects());
+        assertEquals("CALL_BUSY", model.state().getValue().getString("state"));
+    }
+    @Test public void canceledPreparationIgnoresLateReadyWithoutSelection() throws Exception {
+        reply("IDLE", 0, false); model.prepareRoute(false, true); drain();
+        Method clear = model.getClass().getDeclaredMethod("onCleared");
+        clear.setAccessible(true); clear.invoke(model);
+        reply("PHYSICAL_READY", 9, false); model.choose(false, true, 9); drain();
+        assertFalse(model.hasPreparedRoute()); assertEquals(0, selects());
+    }
+    @Test public void uncertainPreparationCannotBecomeConsent() throws Exception {
+        reply("IDLE", 0, false); model.prepareRoute(false, true); drain();
+        reply("UNKNOWN", 9, false); model.choose(false, true, 9); drain();
+        assertFalse(model.hasPreparedRoute()); assertEquals(0, selects());
+        assertEquals("UNAVAILABLE", model.state().getValue().getString("state"));
+    }
+    @Test public void oldUntaggedSnapshotCannotCompletePreparation() throws Exception {
+        reply("IDLE", 0, false); model.prepareRoute(false, true); drain();
+        reply("PHYSICAL_READY", 9, false, null, false);
+        assertFalse(model.hasPreparedRoute()); assertEquals(0, selects());
+        reply("PHYSICAL_READY", 9, false); assertTrue(model.hasPreparedRoute());
+        model.choose(false, true, 9); drain(); assertEquals(1, selects());
+    }
+    @Test public void crossTargetPreparationIsRefusedWithoutSelection() throws Exception {
+        reply("IDLE", 0, false); model.prepareRoute(false, true); drain();
+        reply("PHYSICAL_READY", 9, false, true, true);
+        assertFalse(model.hasPreparedRoute()); assertEquals(0, selects());
+        assertEquals("UNAVAILABLE", model.state().getValue().getString("state"));
+    }
+    @Test public void coldPhysicalChoiceUsesPreparedPhaseExactlyOnce() throws Exception {
+        reply("IDLE", 0, false); model.prepareRoute(true, true); drain();
+        reply("EUICC_READY", 9, false); model.choose(true, true, 9); drain();
+        assertEquals(1, selects()); assertEquals(3, sent.get(sent.size() - 1).what);
+        assertEquals(9, sent.get(sent.size() - 1).getData().getInt("phase_serial"));
+        model.choose(true, true, 9); drain(); assertEquals(1, selects());
+    }
+    @Test public void phaseChangedAfterPreparationCannotSilentlyChangeConsent() throws Exception {
+        reply("IDLE", 0, false); model.prepareRoute(false, true); drain();
+        reply("PHYSICAL_READY", 9, false); model.refreshSnapshotOnce(); drain();
+        reply("PHYSICAL_READY", 10, false);
+        model.choose(false, true, 9); drain(); assertEquals(0, selects());
+        assertEquals(1, sent.get(sent.size() - 1).what);
+        model.choose(false, true, 10); drain(); assertEquals(1, selects());
+        assertEquals(10, sent.get(sent.size() - 1).getData().getInt("phase_serial"));
+    }
+    private void passiveObserver() throws Exception {
+        cleanup();
+        sent.clear();
+        model = HonorLdyAn00EsimSetupViewModel.passiveObserverFactory(app)
+                .create(HonorLdyAn00EsimSetupViewModel.class);
+        Messenger remote = new Messenger(new Handler(Looper.getMainLooper(), m -> {
+            sent.add(Message.obtain(m)); return true;
+        }));
+        connection.onServiceConnected(new ComponentName("com.android.phone",
+                "com.android.phone.HonorLdyAn00EsimSetupService"), remote.getBinder());
+        drain();
+    }
+    @Test public void passiveResumeReadsFreshPhysicalStateAfterPriorBackendUnknown() throws Exception {
+        passiveObserver();
+        reply("UNKNOWN", 0, false);
+        Bundle refused = model.state().getValue();
+        int count = sent.size();
+        model.refreshSnapshotOnce(); drain();
+        assertEquals(count + 1, sent.size());
+        assertEquals(1, sent.get(sent.size() - 1).what);
+        reply("PHYSICAL_READY", 12, false);
+        assertNotSame(refused, model.state().getValue());
+        assertEquals("PHYSICAL_READY", model.state().getValue().getString("state"));
+        assertTrue(sent.stream().allMatch(m -> m.what == 1));
+    }
+    @Test public void passiveFreshUnknownRemainsUnavailableWithoutRouteGuess() throws Exception {
+        passiveObserver(); reply("UNKNOWN", 0, false);
+        model.refreshSnapshotOnce(); drain(); reply("UNKNOWN", 0, false);
+        assertEquals("UNAVAILABLE", model.state().getValue().getString("state"));
+        assertTrue(sent.stream().allMatch(m -> m.what == 1));
+    }
+    @Test public void mutationModelCannotResumeAfterBackendUnknown() throws Exception {
+        reply("UNKNOWN", 0, false); int count = sent.size();
+        model.refreshSnapshotOnce(); drain();
+        assertEquals(count, sent.size());
+    }
+    @Test public void passiveObserverCannotSendPreparationOrEitherSelection() throws Exception {
+        for (int command : new int[]{2, 3, 8}) {
+            passiveObserver(); reply("EUICC_READY", 12, false);
+            int count = sent.size();
+            Method send = model.getClass().getDeclaredMethod("send", int.class, boolean.class, boolean.class);
+            send.setAccessible(true); send.invoke(model, command, true, true); drain();
+            assertEquals(count, sent.size());
+            assertEquals("UNAVAILABLE", model.state().getValue().getString("state"));
+        }
+    }
+    @After public void cleanup() throws Exception {
+        Method clear = model.getClass().getDeclaredMethod("onCleared");
+        clear.setAccessible(true); clear.invoke(model);
+    }
+}
