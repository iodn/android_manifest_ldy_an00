+        assertNull(BatteryFirstUseDatePreferenceController(context,"first_use").summary)
+        assertThrows(IllegalStateException::class.java) {
+            ApiTester(BatteryInfoApiScreen(),context).get<String>(BatteryInfoApiScreen.FIRST_USE_DATE_KEY)
+        }
