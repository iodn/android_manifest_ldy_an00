+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.annotation.Config;
+
+@RunWith(AndroidJUnit4.class)
+@Config(sdk = 37)
+public class CpuInfoTest {
+    static class FixtureContext extends ContextWrapper {
+        boolean enabled = true;
+        final Resources resources;
+        final BlockingQueue<Runnable> main = new LinkedBlockingQueue<>();
+        FixtureContext(Locale locale) {
+            super(ApplicationProvider.getApplicationContext());
+            Resources base = super.getResources();
+            Configuration config = new Configuration(base.getConfiguration());
+            config.setLocales(new LocaleList(locale));
+            resources = new Resources(base.getAssets(), base.getDisplayMetrics(), config) {
+                @Override public boolean getBoolean(int id) {
+                    return id == R.bool.config_show_hardware_info_details
+                            ? enabled : super.getBoolean(id);
+                }
+                @Override public String getString(int id, Object... args) {
+                    if (id == R.string.hardware_info_cpu_count) {
+                        return String.format(locale, "Logical processors: %s", args);
+                    }
+                    if (id == R.string.hardware_info_cpu_limit) {
+                        return String.format(locale, "Maximum reported frequency: %s GHz", args);
+                    }
+                    return super.getString(id, args);
+                }
+            };
+        }
+        @Override public Resources getResources() { return resources; }
+        @Override public java.util.concurrent.Executor getMainExecutor() { return main::add; }
+    }
+
+    @Test public void uniqueSparseRangesCountLogicalIdsNotHighestId() {
+        assertEquals(4, CpuInfo.parsePresent("0,2,7-8"));
+        assertEquals(3, CpuInfo.parsePresent("0-2,1,2"));
+        assertEquals(1, CpuInfo.parsePresent("0"));
+        assertEquals(4096, CpuInfo.parsePresent("0-4095"));
+    }
+    @Test public void malformedEmptyOverflowAndUnboundedRangesFailClosed() {
+        for (String value : new String[]{"", "-1", "0,", "1-0", "1--2", "a", "1 2",
+                "0-4096", "2147483648", "0-99999999999999999999", "1\n2"}) {
+            assertEquals(value, 0, CpuInfo.parsePresent(value));
+        }
+        assertEquals(0, CpuInfo.parsePresent(null));
+        assertEquals(0, CpuInfo.parsePresent("0".repeat(4097)));
+    }
+    private Path root() throws Exception {
+        Path root = Files.createTempDirectory("cpu-info");
+        Files.writeString(root.resolve("present"), "0-3\n");
+        Files.createDirectory(root.resolve("cpufreq"));
+        return root;
+    }
+    private void policy(Path root, String name, String value) throws Exception {
+        Path dir = Files.createDirectory(root.resolve("cpufreq").resolve(name));
+        if (value != null) Files.writeString(dir.resolve("cpuinfo_max_freq"), value);
+    }
+    @Test public void readsFixedNumberedPoliciesAndPositiveMaximum() throws Exception {
+        Path root = root();
+        policy(root, "policy0", "2700000\n");
+        policy(root, "policy4", "3500000");
+        policy(root, "policy7", "4210000");
+        policy(root, "notpolicy", "99999999");
+        CpuInfo.Snapshot value = CpuInfo.read(root);
+        assertEquals(4, value.presentCount);
+        assertEquals(4210000, value.maxReportedKhz);
+        assertEquals(3, value.policiesRead);
+        assertEquals(3, value.policiesFound);
+    }
+    @Test public void partialOrUnreadableReportDoesNotPublishFrequency() throws Exception {
+        Path root = root();
+        policy(root, "policy0", "2700000");
+        policy(root, "policy4", null);
+        CpuInfo.Snapshot value = CpuInfo.read(root);
+        assertEquals(2700000, value.maxReportedKhz);
+        assertEquals(1, value.policiesRead);
+        assertEquals(2, value.policiesFound);
+        assertEquals("Logical processors: 4", CpuInfo.format(new FixtureContext(Locale.US), value));
+    }
+    @Test public void malformedZeroOverflowAndIoFailureAreMissingReports() throws Exception {
+        Path root = root();
+        policy(root, "policy0", "0");
+        policy(root, "policy1", "-1");
+        policy(root, "policy2", "invalid");
+        policy(root, "policy3", "999999999999999999999");
+        policy(root, "policy4", null);
+        Files.createDirectory(root.resolve("cpufreq/policy4/cpuinfo_max_freq"));
+        CpuInfo.Snapshot value = CpuInfo.read(root);
+        assertEquals(0, value.policiesRead);
+        assertEquals(0, value.maxReportedKhz);
+        assertEquals("Logical processors: 4", CpuInfo.format(new FixtureContext(Locale.US), value));
+    }
+    @Test public void deniedFrequencyFileIsNotPublished() throws Exception {
+        Path root = root();
+        policy(root, "policy0", "4210000");
+        Path file = root.resolve("cpufreq/policy0/cpuinfo_max_freq");
+        java.util.Set<java.nio.file.attribute.PosixFilePermission> original =
+                Files.getPosixFilePermissions(file);
+        try {
+            Files.setPosixFilePermissions(file, java.util.Set.of());
+            assertThrows(java.nio.file.AccessDeniedException.class, () -> Files.readString(file));
+            CpuInfo.Snapshot value = CpuInfo.read(root);
+            assertEquals(0, value.policiesRead);
+            assertEquals("Logical processors: 4",
+                    CpuInfo.format(new FixtureContext(Locale.US), value));
+        } finally {
+            Files.setPosixFilePermissions(file, original);
+        }
+    }
+    @Test public void oversizedPresentReportFailsWithoutDefaultCount() throws Exception {
+        Path root = root();
+        Files.writeString(root.resolve("present"), "0".repeat(4097));
+        assertEquals(0, CpuInfo.read(root).presentCount);
+    }
+    @Test public void doesNotFollowPolicyDirectorySymlinkOrRecurse() throws Exception {
+        Path root = root();
+        Path elsewhere = Files.createTempDirectory("not-a-policy");
+        Files.writeString(elsewhere.resolve("cpuinfo_max_freq"), "99999999");
+        Files.createSymbolicLink(root.resolve("cpufreq/policy3"), elsewhere);
+        policy(root, "other", "99999999");
+        assertEquals(0, CpuInfo.read(root).policiesFound);
+    }
+    @Test public void missingPresentNeverDefaultsToOneAndDoesNotReportFrequency() throws Exception {
+        Path root = root();
+        policy(root, "policy0", "4210000");
+        Files.delete(root.resolve("present"));
+        CpuInfo.Snapshot value = CpuInfo.read(root);
+        assertEquals(0, value.presentCount);
+        assertEquals(0, value.policiesFound);
+        assertEquals(new FixtureContext(Locale.US).getString(R.string.unknown),
+                CpuInfo.format(new FixtureContext(Locale.US), value));
+    }
+    @Test public void missingPolicyRootRetainsOnlyGenuineCount() throws Exception {
+        Path root = root();
+        Files.delete(root.resolve("cpufreq"));
+        assertEquals("Logical processors: 4", CpuInfo.format(new FixtureContext(Locale.US),
+                CpuInfo.read(root)));
+    }
+    @Test public void frequencyUsesConfigurationLocaleAndOnlyCompleteCoverage() {
+        CpuInfo.Snapshot value = new CpuInfo.Snapshot(8, 4210000, 3, 3);
+        assertEquals("Logical processors: 8\nMaximum reported frequency: 4.21 GHz",
+                CpuInfo.format(new FixtureContext(Locale.US), value));
+        assertEquals("Logical processors: 8\nMaximum reported frequency: 4,21 GHz",
+                CpuInfo.format(new FixtureContext(Locale.GERMANY), value));
+    }
+    @Test public void defaultOffDoesNotStartBackgroundRead() {
+        FixtureContext context = new FixtureContext(Locale.US);
+        context.enabled = false;
+        CpuInfoPreferenceController controller = new CpuInfoPreferenceController(context, "cpu") {
+            @Override CpuInfo.Snapshot readSnapshot() { fail("Disabled row performed IO"); return null; }
+        };
+        assertEquals(BasePreferenceController.UNSUPPORTED_ON_DEVICE,
+                controller.getAvailabilityStatus());
+        controller.onStart();
+        assertTrue(context.main.isEmpty());
+    }
+    /** The cached default Settings shadow runs background tasks inline; this case needs real races. */
+    @org.robolectric.annotation.Implements(com.android.settingslib.utils.ThreadUtils.class)
+    public static class AsyncThreadUtils {
+        @org.robolectric.annotation.Implementation
+        protected static com.google.common.util.concurrent.ListenableFuture<?> postOnBackgroundThread(
+                Runnable runnable) {
+            com.google.common.util.concurrent.ListenableFutureTask<Void> task =
+                    com.google.common.util.concurrent.ListenableFutureTask.create(runnable, null);
+            Thread worker = new Thread(task, "cpu-info-test-worker");
+            worker.setDaemon(true);
+            worker.start();
+            return task;
+        }
+    }
+    @Config(shadows = AsyncThreadUtils.class)
+    @Test public void stoppedOldWorkerCannotUpdateSummaryAndRestartAcceptsNewResult()
+            throws Exception {
+        FixtureContext context = new FixtureContext(Locale.US);
+        CountDownLatch entered = new CountDownLatch(1);
+        CountDownLatch release = new CountDownLatch(1);
+        CpuInfoPreferenceController controller = new CpuInfoPreferenceController(context, "cpu") {
+            int calls;
+            @Override CpuInfo.Snapshot readSnapshot() {
+                if (++calls == 1) {
+                    entered.countDown();
+                    boolean done = false;
+                    final long deadline = System.nanoTime() + TimeUnit.SECONDS.toNanos(10);
+                    while (!done && System.nanoTime() < deadline) {
+                        try { done = release.await(100, TimeUnit.MILLISECONDS); }
+                        catch (InterruptedException ignored) { /* emulate late IO completion */ }
+                    }
+                    if (!done) throw new AssertionError("Fixture IO was not released");
+                    return new CpuInfo.Snapshot(99, 0, 0, 0);
+                }
+                return new CpuInfo.Snapshot(8, 0, 0, 0);
+            }
+        };
+        controller.onStart();
+        assertTrue(entered.await(5, TimeUnit.SECONDS));
+        controller.onStop();
+        release.countDown();
+        Runnable late = context.main.poll(5, TimeUnit.SECONDS);
+        assertNotNull(late);
+        late.run();
+        assertEquals(context.getString(R.string.unknown), controller.getSummary());
+        controller.onStart();
+        Runnable current = context.main.poll(5, TimeUnit.SECONDS);
+        assertNotNull(current);
+        current.run();
+        assertEquals("Logical processors: 8", controller.getSummary());
+        controller.onStop();
+    }
+}
