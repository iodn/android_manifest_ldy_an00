+        mState.setValue(working);
+        mDeadline = SystemClock.elapsedRealtime() + OBSERVATION_BUDGET_MS;
+        mMain.removeCallbacks(mExpiry);
+        mMain.postDelayed(mExpiry, OBSERVATION_BUDGET_MS);
+        send(physical ? 3 : 2, true, trustedDebugConsent);
+    }
+
+    public boolean hasPreparedRoute() { return mRoutePrepared; }
+
+    /** Called only for a selected connection or authenticated management entry, never the SIM list. */
+    public void prepareRoute(boolean physical, boolean trustedDebugConsent) {
+        if (mStopped || mRoutePrepared || mRoutePreparationPending || mChoiceSubmitted
+                || mRemote == null || !mHasSnapshot) return;
+        mRoutePreparationPending = true;
+        mPreparationPhysical = physical;
+        Bundle preparing = new Bundle(mState.getValue());
+        preparing.putString("state", "WORKING");
+        mState.setValue(preparing);
+        mMain.removeCallbacks(mPoll);
+        mMain.removeCallbacks(mExpiry);
+        mMain.postDelayed(mExpiry, OBSERVATION_BUDGET_MS);
+        send(8, false, trustedDebugConsent);
+    }
+
+    public boolean takeLpaLaunch() {
+        if (mStopped || mLpaLaunched) return false;
+        mLpaLaunched = true;
+        mMain.removeCallbacks(mExpiry);
+        return true;
+    }
+
+    private void send(int command, boolean confirmed, boolean debug) {
+        if (mPassiveObserver && command != 1) { stop(); return; }
+        if (mStopped || mRemote == null) return;
+        Message request = Message.obtain(null, command);
+        request.arg1 = ++mRequestId;
+        if (command == 2 || command == 3) mSelectionRequestId = request.arg1;
+        if (command == 8) mRoutePreparationRequestId = request.arg1;
+        if (command == 1 && "RESTORING".equals(mManagementStage) && !mChoiceSubmitted)
+            mManagementReturnRequest = request.arg1;
+        request.replyTo = mReplies;
+        Bundle data = new Bundle();
+        data.putBoolean("confirmed", confirmed);
+        data.putInt("version", 1);
+        data.putInt("profile_route_protocol", 1); // Explicit opt-in to typed cold no-SELECT readiness.
+        data.putInt("route_observation_protocol",1); // Also understands genuine already-physical READ.
+        if (command == 8) {
+            data.putBoolean("explicit_user_action", true);
+            data.putBoolean("target_physical", mPreparationPhysical);
+        }
+        if (command == 2 || command == 3) data.putInt("phase_serial", mConsentPhaseSerial);
+        if ((command == 2 || command == 3) && isManagementSession() && mManagementNonce != null
+                && mManagementNonce.matches("[0-9a-f]{32}"))
+            data.putString("management_session_nonce", mManagementNonce);
+        data.putBoolean("trusted_debug_consent", debug);
+        request.setData(data);
+        try { mRemote.send(request); }
+        catch (RemoteException gone) { stop(); }
+    }
+
+    private void stop() { stop("UNAVAILABLE"); }
+
+    private void stop(String reason) {
+        mStopped = true;
+        mMain.removeCallbacks(mPoll);
+        mMain.removeCallbacks(mExpiry);
+        Bundle unknown = new Bundle();
+        unknown.putString("state", reason);
+        if (mManagementStage != null) {
+            mManagementStage = "UNAVAILABLE";
+            unknown.putString("management_stage", mManagementStage);
+        }
+        mState.setValue(unknown);
+        // Timeout/disconnect is observational only. No rollback, reset or second setter.
+    }
+
+    @Override protected void onCleared() {
+        cancelProfileHandoff();
+        mStopped = true;
+        mMain.removeCallbacksAndMessages(null);
+        if (mBound) getApplication().unbindService(mConnection);
+    }
+}
