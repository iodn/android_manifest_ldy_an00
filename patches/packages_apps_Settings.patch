diff --git a/src/com/android/settings/network/HonorEuiccProfilePreparation.java b/src/com/android/settings/network/HonorEuiccProfilePreparation.java
new file mode 100644
index 0000000000000000000000000000000000000000..af06a58a4bb5cc6c3c61cf14b8a1ee748884d2d3
--- /dev/null
+++ b/src/com/android/settings/network/HonorEuiccProfilePreparation.java
@@ -0,0 +1,127 @@
+/* Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.settings.network;
+
+import android.content.ComponentName;
+import android.content.Context;
+import android.content.Intent;
+import android.content.ServiceConnection;
+import android.content.pm.PackageManager;
+import android.content.pm.ServiceInfo;
+import android.os.Handler;
+import android.os.IBinder;
+import android.os.Looper;
+import android.os.Message;
+import android.os.Messenger;
+import android.os.Process;
+import android.os.RemoteException;
+import android.telephony.TelephonyManager;
+import android.telephony.UiccCardInfo;
+import android.telephony.UiccSlotMapping;
+import java.util.List;
+import java.util.Collection;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.function.Consumer;
+
+/** One explicit, retained-sidecar observation. Binding/snapshots never call this helper. */
+public final class HonorEuiccProfilePreparation {
+    private static final ComponentName SERVICE = new ComponentName("com.android.phone",
+            "com.android.phone.HonorLdyAn00EsimSetupService");
+    private static final AtomicInteger IDS = new AtomicInteger();
+    private final Context context;
+    private final Handler main = new Handler(Looper.getMainLooper());
+    private final int id = IDS.incrementAndGet();
+    private final Consumer<Boolean> completion;
+    private final int subId, cardId, port;
+    private boolean active = true, bound;
+    private Messenger remote;
+    private final Messenger reply = new Messenger(new Handler(Looper.getMainLooper(), msg -> {
+        if (!active || msg.sendingUid != Process.PHONE_UID || msg.arg1 != id) return true;
+        if (msg.what != 4 || msg.getData().getInt("version", 0) != 2) { finish(false); return true; }
+        finish("READY".equals(msg.getData().getString("preparation_result")));
+        return true;
+    }));
+    private final Runnable expiry = () -> cancel();
+    private final ServiceConnection connection = new ServiceConnection() {
+        @Override public void onServiceConnected(ComponentName name, IBinder binder) {
+            if (!active) return;
+            if (!SERVICE.equals(name)) { finish(false); return; }
+            remote = new Messenger(binder);
+            Message msg = Message.obtain(null, 4);
+            msg.arg1 = id; msg.replyTo = reply;
+            msg.getData().putInt("version", 2);
+            msg.getData().putBoolean("confirmed", true);
+            msg.getData().putInt("subscription_id", subId);
+            msg.getData().putInt("card_id", cardId);
+            msg.getData().putInt("port_index", port);
+            try { remote.send(msg); } catch (RemoteException unavailable) { finish(false); }
+        }
+        @Override public void onServiceDisconnected(ComponentName name) { finish(false); }
+        @Override public void onBindingDied(ComponentName name) { finish(false); }
+        @Override public void onNullBinding(ComponentName name) { finish(false); }
+    };
+
+    public HonorEuiccProfilePreparation(Context context, int subId, int cardId, int port,
+            Consumer<Boolean> completion) {
+        this.context = context.getApplicationContext(); this.subId = subId;
+        this.cardId = cardId; this.port = port; this.completion = completion;
+    }
+    public void start() {
+        try {
+            ServiceInfo info = context.getPackageManager().getServiceInfo(SERVICE, 0);
+            if (id <= 0 || !info.enabled || !info.exported || !info.applicationInfo.enabled
+                    || info.applicationInfo.uid != Process.PHONE_UID
+                    || !"android.permission.MODIFY_PHONE_STATE".equals(info.permission)
+                    || context.getPackageManager().checkSignatures("android", "com.android.phone")
+                        != PackageManager.SIGNATURE_MATCH) { finish(false); return; }
+            bound = context.bindService(new Intent().setComponent(SERVICE), connection,
+                    Context.BIND_AUTO_CREATE);
+            if (!bound) finish(false);
+            else main.postDelayed(expiry, 60000); // Binding + bounded observation, not native cancel.
+        } catch (PackageManager.NameNotFoundException | SecurityException unavailable) {
+            finish(false);
+        }
+    }
+    public void cancel() {
+        if (!active) return;
+        if (remote != null) {
+            Message msg = Message.obtain(null, 5); msg.arg1 = id; msg.replyTo = reply;
+            msg.getData().putInt("version", 2);
+            try { remote.send(msg); } catch (RemoteException gone) { }
+        }
+        finish(false); // Never releases the independent Phone Owner native-read fence.
+    }
+    /** Genuine framework identity only; returns no invented slot/card or readiness lease. */
+    public static int currentSlotForCard(TelephonyManager telephony, int cardId) {
+        if (cardId < 0 || telephony.getCardIdForDefaultEuicc() != cardId)
+            return -1;
+        UiccCardInfo target = null;
+        List<UiccCardInfo> cards = telephony.getUiccCardsInfo();
+        if (cards == null) return -1;
+        for (UiccCardInfo card : cards) {
+            if (card.getCardId() != cardId) continue;
+            if (target != null) return -1;
+            target = card;
+        }
+        if (target == null || !target.isEuicc() || target.getPhysicalSlotIndex() != 1
+                || target.getEid() == null || !target.getEid().matches("[0-9]{32}")
+                || target.isMultipleEnabledProfilesSupported()) return -1;
+        long ports = target.getPorts().stream().filter(p -> p.getPortIndex() == 0
+                && p.isActive() && p.getLogicalSlotIndex() == 1).count();
+        if (ports != 1) return -1;
+        final int physicalSlot = target.getPhysicalSlotIndex();
+        Collection<UiccSlotMapping> mappings = telephony.getSimSlotMapping();
+        if (mappings == null || mappings.stream().filter(p -> p.getPhysicalSlotIndex()
+                == physicalSlot && p.getPortIndex() == 0
+                && p.getLogicalSlotIndex() == 1).count() != 1) return -1;
+        return target.getPhysicalSlotIndex();
+    }
+
+    private void finish(boolean ready) {
+        if (!active) return;
+        active = false; main.removeCallbacks(expiry);
+        if (bound) { bound = false; context.unbindService(connection); }
+        completion.accept(ready);
+    }
+}
diff --git a/src/com/android/settings/network/HonorLdyAn00EsimEntry.kt b/src/com/android/settings/network/HonorLdyAn00EsimEntry.kt
new file mode 100644
index 0000000000000000000000000000000000000000..9cca3fe8db9b07a753da312a8307ae8bb358a5ed
--- /dev/null
+++ b/src/com/android/settings/network/HonorLdyAn00EsimEntry.kt
@@ -0,0 +1,240 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.settings.network
+
+import android.Manifest
+import android.app.AlertDialog
+import android.os.Bundle
+import android.content.ActivityNotFoundException
+import android.content.ComponentName
+import android.content.Context
+import android.content.Intent
+import android.content.pm.ApplicationInfo
+import android.content.pm.PackageManager
+import android.os.Build
+import android.os.SystemProperties
+import android.os.UserHandle
+import android.os.UserManager
+import android.text.TextUtils
+import android.telephony.SubscriptionInfo
+import android.telephony.TelephonyManager
+import android.telephony.UiccCardInfo
+import android.telephony.SubscriptionManager
+import android.telephony.euicc.EuiccManager
+import android.widget.Toast
+import com.android.settings.R
+
+/** Opens native eSIM management or explicit SIM consent without probing the hardware path. */
+internal object HonorLdyAn00EsimEntry {
+    private const val ENABLE_PROPERTY = "ro.lineage.ldy_an00.esim_bridge"
+    const val EXTRA_MANAGE_ESIMS = "manage_esims"
+    const val ACTION_MANAGEMENT = "com.android.settings.action.HONOR_LDY_AN00_MANAGE_ESIM"
+    private const val ACTION = "com.android.settings.action.HONOR_LDY_AN00_ADD_ESIM"
+    private val component =
+        ComponentName("com.android.settings", "com.android.settings.network.HonorLdyAn00EsimSetupActivity")
+
+    fun isDeviceEnabled(): Boolean =
+        Build.DEVICE == "ldy_an00" && Build.MODEL == "LDY-AN00" &&
+            SystemProperties.getBoolean(ENABLE_PROPERTY, false)
+
+    fun intent(): Intent = Intent(ACTION).setComponent(component)
+
+    fun physicalReturnIntent(): Intent = intent().putExtra("return_physical_sim2", true)
+    fun connectionIntent(): Intent = intent().putExtra("connection_only", true)
+    fun managementIntent(): Intent = intent().putExtra(EXTRA_MANAGE_ESIMS, true)
+
+    fun isSetupIntent(intent: Intent): Boolean =
+        intent.action == ACTION && !(intent.getBooleanExtra(EXTRA_MANAGE_ESIMS, false) &&
+            (intent.getBooleanExtra("return_physical_sim2", false) ||
+                intent.getBooleanExtra("connection_only", false)))
+
+    /** The coordinator alone grants a temporary management route; this Intent grants nothing. */
+    fun lpaIntent(manage: Boolean): Intent =
+        Intent(if (manage) EuiccManager.ACTION_MANAGE_EMBEDDED_SUBSCRIPTIONS
+            else EuiccManager.ACTION_PROVISION_EMBEDDED_SUBSCRIPTION)
+            .setPackage("com.android.phone").apply {
+                if (!manage) putExtra(EuiccManager.EXTRA_FORCE_PROVISION, true)
+            }
+
+    /** Identifies a real published SIM2 subscription; never creates a row or guesses an inactive ID. */
+    fun isPhysicalSim2(info: SubscriptionInfo?): Boolean =
+        info != null && !info.isEmbedded && info.simSlotIndex == 1 &&
+            SubscriptionManager.isValidSubscriptionId(info.subscriptionId)
+
+
+    /** Cached public subscription identity permits native consent, never proves hardware ready. */
+    fun canPrepareCachedEmbeddedProfile(context: Context, info: SubscriptionInfo?): Boolean {
+        if (Build.HARDWARE != "mt6993" || !isAvailable(context) || info == null || !info.isEmbedded ||
+            !SubscriptionManager.isValidSubscriptionId(info.subscriptionId) ||
+            info.cardId < 0 || info.iccId.isNullOrEmpty()) return false
+        val manager = context.getSystemService(SubscriptionManager::class.java) ?: return false
+        return manager.availableSubscriptionInfoList?.any {
+            it.isEmbedded && it.subscriptionId == info.subscriptionId &&
+                it.cardId == info.cardId && TextUtils.equals(it.iccId, info.iccId)
+        } == true
+    }
+
+    fun launchPhysicalReturn(context: Context) {
+        if (isAvailable(context)) {
+            try {
+                context.startActivity(physicalReturnIntent())
+                return
+            } catch (_: ActivityNotFoundException) {
+            } catch (_: SecurityException) {
+            }
+        }
+        Toast.makeText(context, R.string.honor_ldy_an00_esim_unavailable, Toast.LENGTH_SHORT).show()
+    }
+
+    fun isAvailable(context: Context): Boolean {
+        if (!isDeviceEnabled() || UserHandle.myUserId() != 0) return false
+        val users = context.getSystemService(UserManager::class.java) ?: return false
+        if (users.hasUserRestriction(UserManager.DISALLOW_CONFIG_MOBILE_NETWORKS)) return false
+        if (context.checkSelfPermission(Manifest.permission.MODIFY_PHONE_STATE) !=
+            PackageManager.PERMISSION_GRANTED
+        ) return false
+        val pm = context.packageManager
+        val info = try {
+            pm.getActivityInfo(component, 0)
+        } catch (_: PackageManager.NameNotFoundException) {
+            return false
+        }
+        return info.enabled && info.applicationInfo.enabled &&
+            info.permission == Manifest.permission.MODIFY_PHONE_STATE &&
+            info.applicationInfo.flags and ApplicationInfo.FLAG_SYSTEM != 0 &&
+            pm.checkSignatures("android", component.packageName) == PackageManager.SIGNATURE_MATCH
+    }
+
+    fun launchManagement(context: Context) = launch(context, lpaIntent(true))
+
+    fun launch(context: Context) = launchManagement(context)
+
+    /** Keep inserted physical cards reachable when their subscription has no logical slot. */
+    fun visiblePhysicalSubscriptionIds(context: Context): Set<Int> {
+        if (!isDeviceEnabled()) return emptySet()
+        val telephony = context.getSystemService(TelephonyManager::class.java) ?: return emptySet()
+        val subscriptions = context.getSystemService(SubscriptionManager::class.java)
+            ?: return emptySet()
+        return try {
+            val cards = telephony.uiccCardsInfo
+            val available = subscriptions.availableSubscriptionInfoList ?: return emptySet()
+            val primary = cards.singleOrNull { !it.isEuicc && it.physicalSlotIndex == 0 }
+            // A disabled subscription can have no logical slot while its physical port stays
+            // mapped. Keep SIM2's native toggle only when the shared port is mapped to SIM2.
+            val shared = cards.singleOrNull { card ->
+                card.ports.any { it.isActive && it.logicalSlotIndex == 1 }
+            }?.takeIf { !it.isEuicc && it.physicalSlotIndex == 1 }
+            listOfNotNull(primary, shared).mapNotNull { card ->
+                if (card.cardId < 0) return@mapNotNull null
+                available.singleOrNull {
+                    !it.isEmbedded && it.cardId == card.cardId &&
+                        SubscriptionManager.isValidSubscriptionId(it.subscriptionId)
+                }?.subscriptionId
+            }.toSet()
+        } catch (_: SecurityException) {
+            emptySet()
+        }
+    }
+
+    /** Inactive physical cards with a native toggle remain visible. The LPA lists stored eSIMs. */
+    fun showSubscriptionNetwork(
+        embedded: Boolean,
+        slot: Int,
+        active: Boolean,
+        visiblePhysical: Boolean,
+    ): Boolean = !isDeviceEnabled() || active || !embedded && (slot == 0 || visiblePhysical)
+
+    /** Only a qualified owner snapshot describes selection; missing subscriptions prove nothing. */
+    fun connectionMode(state: Bundle?): Int {
+        if (state?.getInt("route_observation_protocol", 0) != 1) return -1
+        return when (state.getString("state")) {
+            "PHYSICAL_READY" -> 0
+            "EUICC_READY", "KNOWN_BLANK" -> 1
+            else -> -1
+        }
+    }
+
+    /** Display-only stock card classification. It never grants route or APDU authority. */
+    fun connectionMode(context: Context, state: Bundle?): Int {
+        val qualified = connectionMode(state)
+        if (qualified >= 0) return qualified
+        // A pending/uncertain owner must never be hidden by cached card metadata.
+        if (state?.getInt("route_observation_protocol", 0) != 1 ||
+            state.getString("state") != "IDLE") return -1
+        return try {
+            val manager = context.getSystemService(TelephonyManager::class.java) ?: return -1
+            detectedConnectionMode(manager.uiccCardsInfo, manager.getSimState(1))
+        } catch (_: SecurityException) {
+            -1
+        }
+    }
+
+    fun detectedConnectionMode(cards: List<UiccCardInfo>?, physicalSimState: Int): Int {
+        val selected = cards?.filter { card ->
+            card.physicalSlotIndex == 1 && card.cardId >= 0 && card.ports.any {
+                it.isActive && it.logicalSlotIndex == 1
+            }
+        } ?: return -1
+        if (selected.size != 1) return -1
+        val card = selected.single()
+        if (card.isEuicc) return if (card.eid?.matches(Regex("[0-9]{32}")) == true) 1 else -1
+        return when (physicalSimState) {
+            TelephonyManager.SIM_STATE_READY, TelephonyManager.SIM_STATE_LOADED,
+            TelephonyManager.SIM_STATE_PIN_REQUIRED, TelephonyManager.SIM_STATE_PUK_REQUIRED,
+            TelephonyManager.SIM_STATE_NETWORK_LOCKED -> 0
+            else -> -1
+        }
+    }
+
+    fun launchConnection(context: Context, physical: Boolean) =
+        launch(context, if (physical) physicalReturnIntent() else connectionIntent())
+
+    /** Legacy Use-SIM intents select the connection, never the intent's cached eSIM profile. */
+    fun redirectProfileToggle(context: Context, info: SubscriptionInfo?, enable: Boolean): Boolean {
+        if (!isDeviceEnabled() || info?.isEmbedded != true) return false
+        launchConnection(context, !enable)
+        return true
+    }
+
+    fun showConnectionChoice(context: Context, state: Bundle?) {
+        if (!isAvailable(context)) return
+        val labels = arrayOf(context.getString(R.string.honor_esim_physical_slot2),
+            context.getString(R.string.downloaded_sim_category_title))
+        val selectedMode = connectionMode(context, state)
+        if (selectedMode < 0) {
+            AlertDialog.Builder(context)
+                .setTitle(labels.joinToString(" / "))
+                .setMessage(if (state?.getString("state") in listOf("WORKING", "EUICC_WAITING"))
+                    R.string.honor_esim_still_pending else R.string.honor_esim_change_unconfirmed)
+                .setNegativeButton(android.R.string.cancel, null)
+                .show()
+            return
+        }
+        AlertDialog.Builder(context)
+            .setTitle(labels.joinToString(" / "))
+            .setSingleChoiceItems(labels, selectedMode) { dialog, selected ->
+                dialog.dismiss()
+                if (selected in 0..1 && selected != selectedMode) {
+                    launchConnection(context, selected == 0)
+                }
+            }
+            .setNegativeButton(android.R.string.cancel, null)
+            .show()
+    }
+
+    private fun launch(context: Context, target: Intent) {
+        if (isAvailable(context)) {
+            try {
+                context.startActivity(target)
+                return
+            } catch (_: ActivityNotFoundException) {
+                // The package may have changed since the availability check.
+            } catch (_: SecurityException) {
+                // Phone retains the final permission and device checks.
+            }
+        }
+        Toast.makeText(context, R.string.honor_ldy_an00_esim_unavailable, Toast.LENGTH_SHORT).show()
+    }
+}
