+import static org.mockito.Mockito.when;
+
+import android.content.Context;
+import android.content.res.Resources;
+
+import com.android.settings.R;
+
+import org.junit.Before;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.RobolectricTestRunner;
+
+@RunWith(RobolectricTestRunner.class)
+public class BatteryInfoDateAvailabilityTest {
+    private BatterySettingsFeatureProviderImpl mProvider;
+    private Context mContext;
+    private Resources mResources;
+
+    @Before
+    public void setUp() {
+        mProvider = new BatterySettingsFeatureProviderImpl();
+        mContext = mock(Context.class);
+        mResources = mock(Resources.class);
+        when(mContext.getResources()).thenReturn(mResources);
+    }
+
+    @Test
+    public void defaultOverlay_positiveDatesRemainUnavailable() {
+        when(mResources.getBoolean(R.bool.config_show_battery_info_dates)).thenReturn(false);
+        assertThat(mProvider.isManufactureDateAvailable(mContext, 1715856000000L)).isFalse();
+        assertThat(mProvider.isFirstUseDateAvailable(mContext, 1715857000000L)).isFalse();
+    }
+
+    @Test
+    public void enabledOverlay_positiveDatesAreAvailable() {
+        when(mResources.getBoolean(R.bool.config_show_battery_info_dates)).thenReturn(true);
+        assertThat(mProvider.isManufactureDateAvailable(mContext, 1715856000000L)).isTrue();
+        assertThat(mProvider.isFirstUseDateAvailable(mContext, 1715857000000L)).isTrue();
+    }
+
+    @Test
+    public void enabledOverlay_zeroDatesRemainUnavailable() {
+        when(mResources.getBoolean(R.bool.config_show_battery_info_dates)).thenReturn(true);
+        assertThat(mProvider.isManufactureDateAvailable(mContext, 0L)).isFalse();
+        assertThat(mProvider.isFirstUseDateAvailable(mContext, 0L)).isFalse();
+    }
+
+    @Test
+    public void enabledOverlay_negativeDatesRemainUnavailable() {
+        when(mResources.getBoolean(R.bool.config_show_battery_info_dates)).thenReturn(true);
+        assertThat(mProvider.isManufactureDateAvailable(mContext, -1L)).isFalse();
+        assertThat(mProvider.isFirstUseDateAvailable(mContext, -1L)).isFalse();
+    }
+
+    @Test
+    public void enabledOverlay_unsupportedPropertiesRemainUnavailable() {
+        when(mResources.getBoolean(R.bool.config_show_battery_info_dates)).thenReturn(true);
+        assertThat(mProvider.isManufactureDateAvailable(mContext, Long.MIN_VALUE)).isFalse();
+        assertThat(mProvider.isFirstUseDateAvailable(mContext, Long.MIN_VALUE)).isFalse();
+    }
+
+    @Test
+    public void manufactureAvailable_doesNotInventFirstUse() {
+        when(mResources.getBoolean(R.bool.config_show_battery_info_dates)).thenReturn(true);
+        assertThat(mProvider.isManufactureDateAvailable(mContext, 1715856000000L)).isTrue();
+        assertThat(mProvider.isFirstUseDateAvailable(mContext, 0L)).isFalse();
+    }
+}
