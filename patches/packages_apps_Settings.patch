new file mode 100644
index 0000000000000000000000000000000000000000..d9cafbab2e1811fa7ef3a2fce2101119a3ea9ada
--- /dev/null
+++ b/src/com/android/settings/security/DeviceProtectionSettings.java
@@ -0,0 +1,109 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+package com.android.settings.security;
+
+import android.app.Activity;
+import android.app.KeyguardManager;
+import android.app.settings.SettingsEnums;
+import android.content.Intent;
+import android.os.Bundle;
+import android.os.SystemProperties;
+import android.os.UserHandle;
+import android.provider.Settings;
+
+import androidx.preference.ListPreference;
+import androidx.preference.Preference;
+
+import com.android.internal.widget.LockPatternUtils;
+import com.android.settings.R;
+import com.android.settings.SettingsPreferenceFragment;
+import com.android.settings.password.ChooseLockSettingsHelper;
+
+/** Native owner-only controls; each change uses Settings' credential confirmation. */
+public class DeviceProtectionSettings extends SettingsPreferenceFragment
+        implements Preference.OnPreferenceChangeListener {
+    private static final int CONFIRM = 481;
+    private String mPendingKey, mPendingValue;
+
+    @Override public int getMetricsCategory() { return SettingsEnums.SECURITY; }
+
+    @Override public void onCreate(Bundle state) {
+        super.onCreate(state);
+        if (UserHandle.myUserId() != UserHandle.USER_SYSTEM
+                || !SystemProperties.getBoolean("ro.lineage.ldy_an00.security_controls", false)) {
+            finish();
+            return;
+        }
+        addPreferencesFromResource(R.xml.device_protection_settings);
+        for (String key : new String[] {"settings_reboot_after_timeout", "usb_data_when_locked"}) {
+            ListPreference pref = findPreference(key);
+            pref.setSummaryProvider(ListPreference.SimpleSummaryProvider.getInstance());
+            pref.setOnPreferenceChangeListener(this);
+        }
+        if (state != null) {
+            mPendingKey = state.getString("pending_key");
+            mPendingValue = state.getString("pending_value");
+        }
+    }
+
+    @Override public void onResume() {
+        super.onResume();
+        if (getPreferenceScreen() == null) return;
+        refresh();
+    }
+
+    private void refresh() {
+        ListPreference reboot = findPreference("settings_reboot_after_timeout");
+        ListPreference usb = findPreference("usb_data_when_locked");
+        reboot.setValue(Settings.Global.getString(getContentResolver(), reboot.getKey()));
+        if (reboot.getValue() == null) reboot.setValue("0");
+        usb.setValue(Settings.Global.getString(getContentResolver(), usb.getKey()));
+        if (usb.getValue() == null) usb.setValue("0");
+        boolean secure = new LockPatternUtils(getContext()).isSecure(UserHandle.myUserId());
+        reboot.setEnabled(secure);
+        if (!secure) reboot.setSummary(R.string.device_protection_set_lock);
+    }
+
+    @Override public boolean onPreferenceChange(Preference preference, Object value) {
+        if (mPendingKey != null || !(value instanceof String)
+                || ((ListPreference) preference).findIndexOfValue((String) value) < 0) return false;
+        KeyguardManager keyguard = getContext().getSystemService(KeyguardManager.class);
+        if (keyguard == null || keyguard.isDeviceLocked()) return false;
+        mPendingKey = preference.getKey();
+        mPendingValue = (String) value;
+        boolean secure = new LockPatternUtils(getContext()).isSecure(UserHandle.myUserId());
+        if (!secure) {
+            applyPending();
+        } else if (!new ChooseLockSettingsHelper.Builder(getActivity(), this)
+                .setRequestCode(CONFIRM).setTitle(getText(R.string.device_protection_title)).show()) {
+            // Failure to launch authentication must not silently authorize a change.
+            mPendingKey = null;
+            mPendingValue = null;
+        }
+        return false;
+    }
+
+    @Override public void onActivityResult(int request, int result, Intent data) {
+        super.onActivityResult(request, result, data);
+        if (request != CONFIRM) return;
+        if (result == Activity.RESULT_OK) applyPending();
+        else { mPendingKey = null; mPendingValue = null; }
+    }
+
+    private void applyPending() {
+        ListPreference pref = mPendingKey == null ? null : findPreference(mPendingKey);
+        if (UserHandle.myUserId() == UserHandle.USER_SYSTEM && pref != null
+                && pref.findIndexOfValue(mPendingValue) >= 0) {
+            if (Settings.Global.putString(getContentResolver(), mPendingKey, mPendingValue)) {
+                pref.setValue(mPendingValue);
+            }
+        }
+        mPendingKey = null;
+        mPendingValue = null;
+    }
+
+    @Override public void onSaveInstanceState(Bundle state) {
+        super.onSaveInstanceState(state);
+        state.putString("pending_key", mPendingKey);
+        state.putString("pending_value", mPendingValue);
+    }
+}
