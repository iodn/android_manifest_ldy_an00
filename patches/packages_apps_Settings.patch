+    private val resources = spy(base.resources)
+    private val manager = mock(ActivityManager::class.java)
+    private var enabled = true
+    private var managerAvailable = true
+    private var total = 5L * 1024L * 1024L * 1024L + 123L
+    private var available = 1024L
+    private val context = object : ContextWrapper(base) {
+        override fun getResources(): Resources = this@HardwarePlatformInfoTest.resources
+        override fun getSystemService(name: String): Any? =
+            if (name == Context.ACTIVITY_SERVICE) {
+                if (managerAvailable) manager else null
+            } else super.getSystemService(name)
+    }
