+    @Before
+    fun setUp() {
+        ReflectionHelpers.setStaticField(Build::class.java, "SOC_MANUFACTURER", "Fixture vendor")
+        ReflectionHelpers.setStaticField(Build::class.java, "SOC_MODEL", "Fixture SoC")
+        doAnswer { enabled }.`when`(resources).getBoolean(R.bool.config_show_hardware_info_details)
+        doAnswer {
+            val info = it.getArgument<ActivityManager.MemoryInfo>(0)
+            info.totalMem = total
+            info.availMem = available
+            null
+        }.`when`(manager).getMemoryInfo(any(ActivityManager.MemoryInfo::class.java))
+    }
+
+    @Test fun socUsesExactPlatformNames() {
+        assertEquals("Fixture vendor Fixture SoC", SocInfoPreferenceController.getSocSummary())
+        assertEquals(BasePreferenceController.AVAILABLE,
+            SocInfoPreferenceController(context, SocInfoPreference.KEY).availabilityStatus)
+    }
