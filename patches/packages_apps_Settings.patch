+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.settings.network;
+
+import android.app.Activity;
+import android.content.ActivityNotFoundException;
+import android.content.ComponentName;
+import android.content.Intent;
+import android.content.pm.ActivityInfo;
+import android.content.pm.ApplicationInfo;
+import android.content.pm.PackageManager;
+import android.os.Build;
+import android.os.Bundle;
+import android.os.UserHandle;
+import android.os.UserManager;
+import android.service.euicc.EuiccService;
+
+import com.android.internal.telephony.euicc.EuiccConnector;
+
+/** Signature-protected entry for the selected LPA; route ownership stays in private Settings. */
+public class HonorLdyAn00EsimManagementActivity extends Activity {
+    private static final String LPA_PACKAGE = "im.angry.openeuicc";
+
+    @Override protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        if (savedInstanceState != null || !isCallerAllowed()) { finish(); return; }
+        // Construct a new private request: no caller-supplied result, origin or route extras.
+        Intent setup = privateSetupIntent();
+        try {
+            startActivity(setup);
+        } catch (ActivityNotFoundException | SecurityException unavailable) {
+            setResult(RESULT_CANCELED);
+        }
+        finish();
+    }
+
+    Intent privateSetupIntent() {
+        Intent request = HonorLdyAn00EsimEntry.INSTANCE.managementIntent();
+        String actionToken = getIntent().getStringExtra("honor_management_action_token");
+        String kind = getIntent().getStringExtra("honor_management_action_kind");
+        boolean validAction = actionToken != null && actionToken.matches("[0-9a-f]{32}")
+                && kind != null && kind.matches("ENABLE|DISABLE|DELETE|RENAME|ADD");
+        if (validAction) {
+            request.putExtra("honor_management_action_token", actionToken);
+            request.putExtra("honor_management_action_kind", kind);
+        }
+        return request
+                .putExtra(HonorLdyAn00EsimSetupActivity.EXTRA_CONFIRM_MANAGEMENT,
+                        !validAction || getIntent().getBooleanExtra(
+                                "honor_management_confirm_action", false))
+                .addFlags(Intent.FLAG_ACTIVITY_FORWARD_RESULT);
+    }
+
+    boolean isCallerAllowed() {
+        if (!HonorLdyAn00EsimEntry.ACTION_MANAGEMENT.equals(getIntent().getAction())
+                || !HonorLdyAn00EsimEntry.INSTANCE.isAvailable(this)
+                || !"mt6993".equals(Build.HARDWARE)) return false;
+        UserManager users = getSystemService(UserManager.class);
+        if (users == null || !users.isAdminUser()) return false;
+        String caller = getCallingPackage();
+        ComponentName callingActivity = getCallingActivity();
+        int uid = getLaunchedFromUid();
+        if (!LPA_PACKAGE.equals(caller) || callingActivity == null
+                || !caller.equals(callingActivity.getPackageName())
+                || uid < 0 || UserHandle.getUserId(uid) != 0) return false;
+        PackageManager pm = getPackageManager();
+        ActivityInfo selected = selectedLpa();
+        if (selected == null || !selected.enabled || !caller.equals(selected.packageName)
+                || selected.applicationInfo == null || !selected.applicationInfo.enabled
+                || selected.applicationInfo.uid != uid
+                || (selected.applicationInfo.flags & ApplicationInfo.FLAG_SYSTEM) == 0
+                || pm.checkSignatures("android", caller) != PackageManager.SIGNATURE_MATCH)
+            return false;
+        try {
+            return pm.getApplicationInfo(caller, 0).uid == uid;
+        } catch (PackageManager.NameNotFoundException unavailable) {
+            return false;
+        }
+    }
+
+    ActivityInfo selectedLpa() {
+        return EuiccConnector.findBestActivity(getPackageManager(),
+                new Intent(EuiccService.ACTION_MANAGE_EMBEDDED_SUBSCRIPTIONS));
+    }
+}
diff --git a/src/com/android/settings/network/HonorLdyAn00EsimSetupActivity.java b/src/com/android/settings/network/HonorLdyAn00EsimSetupActivity.java
