+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.settings.network;
+
+import android.content.ComponentName;
+import android.content.Context;
+import android.content.Intent;
+import android.content.ServiceConnection;
+import android.content.pm.PackageManager;
+import android.content.pm.ServiceInfo;
+import android.os.Build;
+import android.os.Handler;
+import android.os.IBinder;
+import android.os.Looper;
+import android.os.Message;
+import android.os.Messenger;
+import android.os.Process;
+import android.os.RemoteException;
+import android.widget.Toast;
+
+import com.android.settings.R;
+
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.function.Consumer;
+
+/** User-selected DDS only. Automatic subscription policy does not enter this transport. */
+public final class HonorPrimaryDataSelection {
+    private static final ComponentName SERVICE =
+            new ComponentName(
+                    "com.android.phone", "com.android.phone.HonorLdyAn00EsimSetupService");
+    private static final AtomicInteger IDS = new AtomicInteger();
+    private final Context context;
+    private final int subId, id = IDS.incrementAndGet();
+    private final Consumer<Boolean> completion;
+    private final Handler main = new Handler(Looper.getMainLooper());
+    private boolean finished, bound;
+
+    private HonorPrimaryDataSelection(Context context, int subId, Consumer<Boolean> completion) {
+        this.context = context.getApplicationContext();
+        this.subId = subId;
+        this.completion = completion;
+    }
+
+    public static void select(
+            Context context, int subId, Runnable standardSelection, Consumer<Boolean> completion) {
+        if (!"LDY-AN00".equals(Build.MODEL) || !"ldy_an00".equals(Build.DEVICE)) {
+            standardSelection.run();
+            completion.accept(true);
+            return;
+        }
+        HonorPrimaryDataSelection request =
+                new HonorPrimaryDataSelection(context, subId, completion);
+        request.main.post(request::start);
+    }
+
+    private final Messenger reply =
+            new Messenger(
+                    new Handler(
+                            Looper.getMainLooper(),
+                            message -> {
+                                if (finished
+                                        || message.sendingUid != Process.PHONE_UID
+                                        || message.arg1 != id) return true;
+                                if (message.what != 6
+                                        || message.getData().getInt("version", 0) != 1) {
+                                    finish(false, true);
+                                    return true;
+                                }
+                                String result = message.getData().getString("selection_result");
+                                finish(
+                                        "COMMITTED".equals(result),
+                                        !"COMMITTED".equals(result)
+                                                && !"BUSY".equals(result)
+                                                && !"REFUSED".equals(result));
+                                return true;
+                            }));
+    private final ServiceConnection connection =
+            new ServiceConnection() {
+                @Override
+                public void onServiceConnected(ComponentName name, IBinder binder) {
+                    if (finished) return;
+                    if (!SERVICE.equals(name)) {
+                        finish(false, false);
+                        return;
+                    }
+                    Message request = Message.obtain(null, 6);
+                    request.arg1 = id;
+                    request.replyTo = reply;
+                    request.getData().putInt("version", 1);
+                    request.getData().putBoolean("confirmed", true);
+                    request.getData().putInt("subscription_id", subId);
+                    try {
+                        new Messenger(binder).send(request);
+                    } catch (RemoteException unavailable) {
+                        finish(false, true);
+                    }
+                }
+
+                @Override
+                public void onServiceDisconnected(ComponentName name) {
+                    finish(false, true);
+                }
+
+                @Override
+                public void onBindingDied(ComponentName name) {
+                    finish(false, true);
+                }
+
+                @Override
+                public void onNullBinding(ComponentName name) {
+                    finish(false, false);
+                }
+            };
+    private final Runnable expiry = () -> finish(false, true);
+
+    private void start() {
+        try {
+            ServiceInfo service = context.getPackageManager().getServiceInfo(SERVICE, 0);
+            if (id <= 0
+                    || !service.enabled
+                    || !service.exported
+                    || !service.applicationInfo.enabled
+                    || service.applicationInfo.uid != Process.PHONE_UID
+                    || !"android.permission.MODIFY_PHONE_STATE".equals(service.permission)
+                    || context.getPackageManager().checkSignatures("android", "com.android.phone")
+                            != PackageManager.SIGNATURE_MATCH) {
+                finish(false, false);
+                return;
+            }
+            bound =
+                    context.bindService(
+                            new Intent().setComponent(SERVICE),
+                            connection,
+                            Context.BIND_AUTO_CREATE);
+            if (!bound) finish(false, false);
+            else main.postDelayed(expiry, 210000);
+        } catch (PackageManager.NameNotFoundException | SecurityException unavailable) {
+            finish(false, false);
+        }
+    }
+
+    private void finish(boolean success, boolean unknown) {
+        if (finished) return;
+        finished = true;
+        main.removeCallbacks(expiry);
+        if (bound) {
+            bound = false;
+            context.unbindService(connection);
+        }
+        if (!success)
+            Toast.makeText(
+                            context,
+                            unknown
+                                    ? R.string.honor_data_selection_unknown
+                                    : R.string.honor_data_selection_refused,
+                            Toast.LENGTH_LONG)
+                    .show();
+        completion.accept(success);
+    }
+}
