+        old.destroyed(false);
+        assertTrue(mRevoked.isEmpty());
+        FaceEnrollChallengeOwnership restored = owner();
+        restored.restore(state, 0);
+        restored.release();
+        assertEquals(List.of("1:0:17"), mRevoked);
+    }
+
+    @Test public void pendingCallbackAfterDestroyRetiresOnlyItsNewReference() {
+        FaceEnrollChallengeOwnership old = owner();
+        Bundle state = new Bundle();
+        old.save(state);
+        old.destroyed(false);
+        assertFalse(old.onGenerated(1, 0, 17));
