+package com.android.settings.network;
+import android.app.Application;
+import android.content.Intent;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.Robolectric;
+import org.robolectric.RobolectricTestRunner;
+import org.robolectric.annotation.Config;
+import static org.junit.Assert.*;
+@RunWith(RobolectricTestRunner.class)
+@Config(sdk=37, manifest=Config.NONE, application=Application.class)
+public class HonorEsimShortcutConsentTest {
+    @Test public void shortcutAddTokenStillRequiresVisibleConsent() {
+        var activity = Robolectric.buildActivity(HonorLdyAn00EsimManagementActivity.class).get();
+        activity.setIntent(new Intent(HonorLdyAn00EsimEntry.ACTION_MANAGEMENT)
+                .putExtra("honor_management_action_token", "a".repeat(32))
+                .putExtra("honor_management_action_kind", "ADD")
+                .putExtra("honor_management_confirm_action", true));
+        Intent request = activity.privateSetupIntent();
+        assertTrue(request.getBooleanExtra(HonorLdyAn00EsimSetupActivity.EXTRA_CONFIRM_MANAGEMENT, false));
+        assertEquals("a".repeat(32), request.getStringExtra("honor_management_action_token"));
+        assertTrue(request.getBooleanExtra(HonorLdyAn00EsimEntry.EXTRA_MANAGE_ESIMS, false));
+        assertFalse(request.hasExtra("return_physical_sim2"));
+    }
+    @Test public void existingExplicitListActionPreservesItsGesture() {
+        var activity = Robolectric.buildActivity(HonorLdyAn00EsimManagementActivity.class).get();
+        activity.setIntent(new Intent(HonorLdyAn00EsimEntry.ACTION_MANAGEMENT)
+                .putExtra("honor_management_action_token", "a".repeat(32))
+                .putExtra("honor_management_action_kind", "ADD"));
+        assertFalse(activity.privateSetupIntent().getBooleanExtra(
+                HonorLdyAn00EsimSetupActivity.EXTRA_CONFIRM_MANAGEMENT, true));
+    }
+    @Test public void inAppAddDoesNotRequireAnotherDevelopmentImagePrompt() {
+        var activity = Robolectric.buildActivity(HonorLdyAn00EsimSetupActivity.class).get();
+        activity.setIntent(HonorLdyAn00EsimEntry.INSTANCE.managementIntent()
+                .putExtra("honor_management_action_token", "a".repeat(32))
+                .putExtra("honor_management_action_kind", "ADD"));
+        assertTrue(activity.hasForwardedManagementAction());
+    }
+    @Test public void externalShortcutAndMalformedActionsKeepTheirConsentBoundary() {
+        var activity = Robolectric.buildActivity(HonorLdyAn00EsimSetupActivity.class).get();
+        Intent request = HonorLdyAn00EsimEntry.INSTANCE.managementIntent()
+                .putExtra("honor_management_action_token", "a".repeat(32))
+                .putExtra("honor_management_action_kind", "ADD")
+                .putExtra(HonorLdyAn00EsimSetupActivity.EXTRA_CONFIRM_MANAGEMENT, true);
+        activity.setIntent(request);
+        assertFalse(activity.hasForwardedManagementAction());
+        request.putExtra(HonorLdyAn00EsimSetupActivity.EXTRA_CONFIRM_MANAGEMENT, false)
+                .putExtra("honor_management_action_token", "bad");
+        assertFalse(activity.hasForwardedManagementAction());
+        request.putExtra("honor_management_action_token", "a".repeat(32))
+                .putExtra("honor_management_action_kind", "RESET_MODEM");
+        assertFalse(activity.hasForwardedManagementAction());
+    }
+    @Test public void malformedTokenCannotSuppressManagementConsent() {
+        var activity = Robolectric.buildActivity(HonorLdyAn00EsimManagementActivity.class).get();
+        activity.setIntent(new Intent(HonorLdyAn00EsimEntry.ACTION_MANAGEMENT)
+                .putExtra("honor_management_action_token", "bad")
+                .putExtra("honor_management_action_kind", "ADD"));
+        Intent request = activity.privateSetupIntent();
+        assertTrue(request.getBooleanExtra(HonorLdyAn00EsimSetupActivity.EXTRA_CONFIRM_MANAGEMENT, false));
+        assertFalse(request.hasExtra("honor_management_action_token"));
+    }
+}
