@@ -0,0 +1,104 @@
+package com.android.settings.network;
+import static org.junit.Assert.*;
+import static org.mockito.Mockito.*;
+import static org.mockito.ArgumentMatchers.*;
+import android.Manifest;
+import android.app.Application;
+import android.content.*;
+import android.content.pm.*;
+import android.os.*;
+import android.telephony.*;
+import android.telephony.euicc.EuiccManager;
+import java.util.*;
+import org.junit.*;
+import org.junit.runner.RunWith;
+import org.robolectric.*;
+import org.robolectric.annotation.Config;
+import org.robolectric.shadows.ShadowBuild;
+import org.robolectric.util.ReflectionHelpers;
+/** Actual production Entry decisions; platform package/user/subscription services are doubles. */
+@RunWith(RobolectricTestRunner.class)
+@Config(sdk=37,manifest=Config.NONE,application=Application.class)
+public class HonorCachedProfileNavigationTest {
+ private Context context; private PackageManager packages; private SubscriptionManager subscriptions;
+ private UserManager users; private ActivityInfo activity;
+ @Before public void setup() throws Exception {
+  ShadowBuild.setDevice("ldy_an00");ShadowBuild.setModel("LDY-AN00");
+  ReflectionHelpers.setStaticField(Build.class,"HARDWARE","mt6993");
+  SystemProperties.set("ro.lineage.ldy_an00.esim_bridge","true");
+  context=spy(RuntimeEnvironment.getApplication());packages=mock(PackageManager.class);
+  doReturn(packages).when(context).getPackageManager();
+  doReturn(PackageManager.PERMISSION_GRANTED).when(context).checkSelfPermission(anyString());
+  users=mock(UserManager.class);subscriptions=mock(SubscriptionManager.class);
+  when(context.getSystemServiceName(UserManager.class)).thenReturn(Context.USER_SERVICE);
+  when(context.getSystemService(Context.USER_SERVICE)).thenReturn(users);
+  when(context.getSystemServiceName(SubscriptionManager.class)).thenReturn(Context.TELEPHONY_SUBSCRIPTION_SERVICE);
+  when(context.getSystemService(Context.TELEPHONY_SUBSCRIPTION_SERVICE)).thenReturn(subscriptions);
+  assertSame(users,context.getSystemService(UserManager.class));
+  assertSame(subscriptions,context.getSystemService(SubscriptionManager.class));
+  activity=new ActivityInfo();activity.enabled=true;activity.permission=Manifest.permission.MODIFY_PHONE_STATE;
+  activity.applicationInfo=new ApplicationInfo();activity.applicationInfo.enabled=true;
+  activity.applicationInfo.flags=ApplicationInfo.FLAG_SYSTEM;
+  when(packages.getActivityInfo(any(ComponentName.class),eq(0))).thenReturn(activity);
+  when(packages.checkSignatures("android","com.android.settings")).thenReturn(PackageManager.SIGNATURE_MATCH);
+ }
+ private SubscriptionInfo row(int id,int card,String iccid,boolean embedded) {
+  SubscriptionInfo r=mock(SubscriptionInfo.class);when(r.getSubscriptionId()).thenReturn(id);
+  when(r.getCardId()).thenReturn(card);when(r.getIccId()).thenReturn(iccid);when(r.isEmbedded()).thenReturn(embedded);
+  when(r.getSimSlotIndex()).thenReturn(SubscriptionManager.INVALID_SIM_SLOT_INDEX);return r;
+ }
+ private SubscriptionInfo current() {
+  SubscriptionInfo r=row(42,7,"host-fixture-profile",true);
+  when(subscriptions.getAvailableSubscriptionInfoList()).thenReturn(List.of(r));return r;
+ }
+ private boolean eligible(SubscriptionInfo r) {return HonorLdyAn00EsimEntry.INSTANCE.canPrepareCachedEmbeddedProfile(context,r);}
+ @Test public void realCachedInactiveRecordAllowsNativeConsentWithoutPublicCardOrMutation() {
+  assertTrue(eligible(current()));
+  verify(context,never()).getSystemServiceName(EuiccManager.class);
+  verify(context,never()).startActivity(any(Intent.class));
+  verify(context,never()).bindService(any(Intent.class),any(ServiceConnection.class),anyInt());
+ }
+ @Test public void invalidOrPhysicalTargetCannotBecomeEmbeddedRow() {
+  current();assertFalse(eligible(null));
+  for(SubscriptionInfo r:List.of(row(-1,7,"x",true),row(42,-2,"x",true),row(42,7,"",true),row(42,7,"x",false)))
+   assertFalse(eligible(r));
+  assertFalse(eligible(row(42,7,null,true)));
+ }
+ @Test public void missingCurrentPublicRecordRefuses() {
+  SubscriptionInfo r=current();when(subscriptions.getAvailableSubscriptionInfoList()).thenReturn(null);assertFalse(eligible(r));
+  when(subscriptions.getAvailableSubscriptionInfoList()).thenReturn(List.of());assertFalse(eligible(r));
+ }
+ @Test public void staleSubCardIccidOrEmbeddedIdentityRefuses() {
+  SubscriptionInfo r=current();
+  for(SubscriptionInfo other:List.of(row(43,7,"host-fixture-profile",true),row(42,8,"host-fixture-profile",true),
+      row(42,7,"changed-host-profile",true),row(42,7,"host-fixture-profile",false))) {
+   when(subscriptions.getAvailableSubscriptionInfoList()).thenReturn(List.of(other));assertFalse(eligible(r));
+  }
+ }
+ @Test public void deviceModelHardwareAndOptinRemainQualified() {
+  SubscriptionInfo r=current();
+  ShadowBuild.setDevice("other");assertFalse(eligible(r));ShadowBuild.setDevice("ldy_an00");
+  ShadowBuild.setModel("other");assertFalse(eligible(r));ShadowBuild.setModel("LDY-AN00");
+  ReflectionHelpers.setStaticField(Build.class,"HARDWARE","other");assertFalse(eligible(r));
+  ReflectionHelpers.setStaticField(Build.class,"HARDWARE","mt6993");
+  SystemProperties.set("ro.lineage.ldy_an00.esim_bridge","false");assertFalse(eligible(r));
+ }
+ @Test public void enterpriseAndPermissionRestrictionsStillBlock() {
+  SubscriptionInfo r=current();when(users.hasUserRestriction(UserManager.DISALLOW_CONFIG_MOBILE_NETWORKS)).thenReturn(true);
+  assertFalse(eligible(r));when(users.hasUserRestriction(UserManager.DISALLOW_CONFIG_MOBILE_NETWORKS)).thenReturn(false);
+  doReturn(PackageManager.PERMISSION_DENIED).when(context).checkSelfPermission(Manifest.permission.MODIFY_PHONE_STATE);
+  assertFalse(eligible(r));
+ }
+ @Test public void disabledOrUntrustedConsentActivityStillBlocks() {
+  SubscriptionInfo r=current();activity.enabled=false;assertFalse(eligible(r));activity.enabled=true;
+  when(packages.checkSignatures("android","com.android.settings")).thenReturn(PackageManager.SIGNATURE_NO_MATCH);
+  assertFalse(eligible(r));
+ }
+ @Test public void currentMatchingRecordAmongOtherCardsDoesNotInventFallbackTarget() {
+  SubscriptionInfo r=current();
+  SubscriptionInfo other=row(41,8,"other-host-profile",true);
+  SubscriptionInfo matching=row(42,7,"host-fixture-profile",true);
+  when(subscriptions.getAvailableSubscriptionInfoList()).thenReturn(List.of(other,matching));
+  assertTrue(eligible(r));assertFalse(eligible(row(99,9,"unknown-host-profile",true)));
+ }
+}
