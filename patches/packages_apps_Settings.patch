+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.settings.deviceinfo.hardwareinfo;
+
+import android.app.ActivityManager;
+import android.content.Context;
+import android.text.format.Formatter;
+
+import com.android.settings.R;
+import com.android.settings.core.BasePreferenceController;
+
+public class UsableRamPreferenceController extends BasePreferenceController {
+    public UsableRamPreferenceController(Context context, String key) {
+        super(context, key);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return isAvailable(mContext) ? AVAILABLE : UNSUPPORTED_ON_DEVICE;
+    }
+
+    public static boolean isAvailable(Context context) {
+        return context.getResources().getBoolean(R.bool.config_show_hardware_info_details)
+                && getTotalMemoryBytes(context) > 0;
+    }
+
+    /** Physical memory usable by the OS; does not add swap or round to installed capacity. */
+    public static long getTotalMemoryBytes(Context context) {
+        ActivityManager manager = context.getSystemService(ActivityManager.class);
+        if (manager == null) return 0;
+        ActivityManager.MemoryInfo info = new ActivityManager.MemoryInfo();
+        manager.getMemoryInfo(info);
+        return info.totalMem > 0 ? info.totalMem : 0;
+    }
+
+    public static String getMemorySummary(Context context) {
+        long bytes = getTotalMemoryBytes(context);
+        return bytes > 0 ? Formatter.formatFileSize(context, bytes, Formatter.FLAG_IEC_UNITS) : null;
+    }
+
+    @Override
+    public CharSequence getSummary() {
+        String summary = getMemorySummary(mContext);
+        return summary != null ? summary : mContext.getString(R.string.unknown);
+    }
+}
