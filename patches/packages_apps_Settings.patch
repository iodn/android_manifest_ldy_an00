+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.settings
+
+import android.content.Intent
+import android.provider.Settings.ACTION_NETWORK_OPERATOR_SETTINGS
+import android.provider.Settings.EXTRA_SUB_ID
+import androidx.test.ext.junit.runners.AndroidJUnit4
+import com.android.settings.network.MobileNetworkIntentConverter
+import com.google.common.truth.Truth.assertThat
+import org.junit.Before
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.mockito.kotlin.any
+import org.mockito.kotlin.anyOrNull
+import org.mockito.kotlin.doNothing
+import org.mockito.kotlin.mock
+import org.mockito.kotlin.never
+import org.mockito.kotlin.spy
+import org.mockito.kotlin.verify
+import org.mockito.kotlin.whenever
+import org.robolectric.Robolectric
+import org.robolectric.util.ReflectionHelpers
+
+@RunWith(AndroidJUnit4::class)
+class MobileNetworkActivityTest {
+    private lateinit var activity: Settings.MobileNetworkActivity
+    private val converter = mock<MobileNetworkIntentConverter>()
+
+    @Before
+    fun setUp() {
+        activity = spy(Robolectric.buildActivity(Settings.MobileNetworkActivity::class.java).get())
+        ReflectionHelpers.setField(activity, "mIntentConverter", converter)
+        doNothing().whenever(activity).createUiFromIntent(anyOrNull(), any())
+    }
+
+    @Test
+    fun onNewIntent_publicNetworkSettings_createsConvertedUi() {
+        val incoming = Intent(ACTION_NETWORK_OPERATOR_SETTINGS).putExtra(EXTRA_SUB_ID, 7)
+        val converted = mobileIntent(7)
+        whenever(converter.apply(incoming)).thenReturn(converted)
+
+        activity.onNewIntent(incoming)
+
+        assertThat(activity.isFinishing).isFalse()
+        assertThat(activity.intent).isSameInstanceAs(converted)
+        verify(activity).createUiFromIntent(null, converted)
+    }
+
+    @Test
+    fun onNewIntent_sameSubscription_replacesCachedExtras() {
+        val previous = mobileIntent(7).putExtra("marker", "old")
+        activity.intent = previous
+        ReflectionHelpers.setField(activity, "mCachedIntent", previous)
+        val incoming = Intent(ACTION_NETWORK_OPERATOR_SETTINGS)
+            .putExtra(EXTRA_SUB_ID, 7).putExtra("marker", "new")
+        val converted = mobileIntent(7).putExtra("marker", "new")
+        whenever(converter.apply(incoming)).thenReturn(converted)
+
+        activity.onNewIntent(incoming)
+
+        assertThat(activity.intent).isSameInstanceAs(converted)
+        assertThat(activity.intent.getStringExtra("marker")).isEqualTo("new")
+        verify(activity).createUiFromIntent(null, converted)
+    }
+
+    @Test
+    fun onNewIntent_explicitOtherFragment_refusesEvenIfConverterRewritesIt() {
+        val incoming = Intent(ACTION_NETWORK_OPERATOR_SETTINGS)
+            .putExtra(EXTRA_SUB_ID, 7)
+            .putExtra(SettingsActivity.EXTRA_SHOW_FRAGMENT, "com.android.settings.OtherFragment")
+        whenever(converter.apply(incoming)).thenReturn(mobileIntent(7))
+
+        activity.onNewIntent(incoming)
+
+        assertThat(activity.isFinishing).isTrue()
+        verify(activity, never()).createUiFromIntent(anyOrNull(), any())
+    }
+
+    @Test
+    fun onNewIntent_unrecognizedActionWithoutFragment_refuses() {
+        val incoming = Intent("unsupported.action").putExtra(EXTRA_SUB_ID, 7)
+        whenever(converter.apply(incoming)).thenReturn(null)
+
+        activity.onNewIntent(incoming)
+
+        assertThat(activity.isFinishing).isTrue()
+        verify(activity, never()).createUiFromIntent(anyOrNull(), any())
+    }
+
+    private fun mobileIntent(subId: Int) =
+        Intent(ACTION_NETWORK_OPERATOR_SETTINGS)
+            .setClassName("com.android.settings", Settings.MobileNetworkActivity::class.java.name)
+            .putExtra(EXTRA_SUB_ID, subId)
+            .putExtra(
+                SettingsActivity.EXTRA_SHOW_FRAGMENT,
+                "com.android.settings.network.telephony.MobileNetworkSettings",
+            )
+}
