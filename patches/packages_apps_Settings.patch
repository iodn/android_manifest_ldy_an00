+    private var enabled = true
+    private val context = object : ContextWrapper(base) {
+        override fun getResources(): Resources = this@BatteryManufactureCalendarTest.resources
+        override fun getSystemService(name: String): Any? =
+            if (name == Context.BATTERY_SERVICE) manager else super.getSystemService(name)
+    }
+    @Before fun setUp() {
+        Locale.setDefault(Locale.US)
+        TimeZone.setDefault(TimeZone.getTimeZone("America/Los_Angeles"))
+        ReflectionHelpers.setStaticField(Build::class.java,"MODEL","LDY-AN00")
+        ReflectionHelpers.setStaticField(Build::class.java,"DEVICE","ldy_an00")
+        ReflectionHelpers.setStaticField(Build::class.java,"HARDWARE","mt6993")
+        doAnswer { enabled }.`when`(resources).getBoolean(R.bool.config_show_battery_info_dates)
+        doAnswer { values[it.getArgument<Int>(0)] ?: 0L }.`when`(manager).getLongProperty(anyInt())
+        val provider = BatterySettingsFeatureProviderImpl()
+        val factory = FakeFeatureFactory.setupForTest()
+        doReturn(true).`when`(factory.batterySettingsFeatureProvider).isBatteryInfoEnabled(any())
+        doAnswer { provider.isManufactureDateAvailable(it.getArgument(0),it.getArgument(1)) }
+            .`when`(factory.batterySettingsFeatureProvider).isManufactureDateAvailable(any(),anyLong())
+        doAnswer { provider.isFirstUseDateAvailable(it.getArgument(0),it.getArgument(1)) }
+            .`when`(factory.batterySettingsFeatureProvider).isFirstUseDateAvailable(any(),anyLong())
+    }
+    @After fun restoreDefaults() { Locale.setDefault(originalLocale);TimeZone.setDefault(originalZone) }
+    private fun epoch(date: String) = LocalDate.parse(date).atStartOfDay(ZoneOffset.UTC).toEpochSecond()
+    private fun manufacturer() = BatteryManufactureDatePreferenceController(context,"battery_info_manufacture_date")
+    @Test fun baselineNegativeZoneChangesDayWhileManufacturePolicyPreservesIt() {
+        val millis = epoch("2025-11-25")*1000
+        assertEquals("November 24, 2025",BatteryUtils.getBatteryInfoFormattedDate(millis))
+        assertEquals(LocalDate.of(2025,11,25),BatteryUtils.getBatteryManufactureDate(millis))
+        assertEquals("November 25, 2025",BatteryUtils.getBatteryManufactureFormattedDate(millis))
+    }
+    @Test fun leapYearAndYearBoundaryArePreservedAcrossTimezones() {
+        for (zone in listOf("UTC","America/Los_Angeles","Etc/GMT+12","Asia/Tokyo","Pacific/Kiritimati")) {
+            TimeZone.setDefault(TimeZone.getTimeZone(zone))
+            for (date in listOf("2025-11-25","2024-02-29","2025-01-01")) {
+                assertEquals("$zone $date",LocalDate.parse(date),
+                    BatteryUtils.getBatteryManufactureDate(epoch(date)*1000))
+            }
+        }
+    }
+    @Test fun unmatchedModelDeviceOrHardwareKeepsLegacyLocalDate() {
+        for (field in listOf("MODEL","DEVICE","HARDWARE")) {
+            val previous = ReflectionHelpers.getStaticField<String>(Build::class.java,field)
+            ReflectionHelpers.setStaticField(Build::class.java,field,"other")
+            assertEquals(LocalDate.of(2025,11,24),BatteryUtils.getBatteryManufactureDate(epoch("2025-11-25")*1000))
+            ReflectionHelpers.setStaticField(Build::class.java,field,previous)
+        }
+    }
+    @Test fun legacyControllerUsesManufactureCalendarAndLocalizedLongFormat() {
+        values[BatteryManager.BATTERY_PROPERTY_MANUFACTURING_DATE] = epoch("2025-11-25")
+        assertEquals("November 25, 2025",manufacturer().summary)
+        Locale.setDefault(Locale.FRANCE)
+        assertEquals("25 novembre 2025",manufacturer().summary)
+    }
+    @Test fun metadataApiMatchesCalendarNotUsersPreviousDay() {
+        values[BatteryManager.BATTERY_PROPERTY_MANUFACTURING_DATE] = epoch("2025-11-25")
+        assertEquals("2025-11-25",ApiTester(BatteryInfoApiScreen(),context)
+            .get<String>(BatteryInfoApiScreen.MANUFACTURE_DATE_KEY))
+    }
+    @Test fun genuinePropertyValueUsesCalendarPolicyWithoutFallbackHeuristic() {
+        // An arbitrary positive non-midnight property remains authoritative; no source-origin guess.
+        values[BatteryManager.BATTERY_PROPERTY_MANUFACTURING_DATE] = epoch("2025-11-25")+3600
+        assertEquals("2025-11-25",ApiTester(BatteryInfoApiScreen(),context)
+            .get<String>(BatteryInfoApiScreen.MANUFACTURE_DATE_KEY))
+    }
+    @Test fun nonpositiveDatesRemainUnavailableRatherThan1970() {
+        for (value in listOf(0L,-1L,Long.MIN_VALUE)) {
+            values[BatteryManager.BATTERY_PROPERTY_MANUFACTURING_DATE]=value
+            assertFalse(manufacturer().isAvailable)
