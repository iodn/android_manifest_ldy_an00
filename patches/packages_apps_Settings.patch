+package com.android.settings.deviceinfo.hardwareinfo
+
+import android.content.Context
+import com.android.settings.testutils2.ApiTester
+import com.android.settings.testutils2.CannotSetException
+import com.android.settingslib.metadata.PreferenceLifecycleContext
+import java.util.Locale
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.cancel
+import org.junit.Assert.*
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.mockito.Mockito.*
+import androidx.test.ext.junit.runners.AndroidJUnit4
+import org.robolectric.annotation.Config
+
+@RunWith(AndroidJUnit4::class)
+@Config(sdk = [37])
+class CpuInfoApiTest {
+    @Test fun metadataDefaultOffAndUnknownBeforeBackgroundRead() {
+        val context = CpuInfoTest.FixtureContext(Locale.US)
+        val preference = CpuInfoPreference()
+        assertTrue(preference.isAvailable(context))
+        assertEquals(context.getString(com.android.settings.R.string.unknown),
+            preference.getSummary(context))
+        assertFalse(preference.createWidget(context).isSelectable)
+        assertTrue(preference.createWidget(context).isCopyingEnabled)
+        context.enabled = false
+        assertFalse(preference.isAvailable(context))
+    }
+    @Test fun metadataStoppedQueuedJobCannotReadOrNotify() {
+        val base = CpuInfoTest.FixtureContext(Locale.US)
+        val lifecycle = mock(PreferenceLifecycleContext::class.java)
+        // A queued coroutine is canceled before execution: no read or UI notification is admitted.
+        val dispatcher = kotlinx.coroutines.test.StandardTestDispatcher()
+        val scope = CoroutineScope(SupervisorJob() + dispatcher)
+        `when`(lifecycle.resources).thenReturn(base.resources)
+        `when`(lifecycle.lifecycleScope).thenReturn(scope)
+        val preference = CpuInfoPreference()
+        preference.onStart(lifecycle)
+        preference.onStop(lifecycle)
+        dispatcher.scheduler.advanceUntilIdle()
+        verify(lifecycle, never()).notifyPreferenceChange(anyString())
+        assertEquals(base.getString(com.android.settings.R.string.unknown),
+            preference.getSummary(base))
+        scope.cancel()
+    }
+    @Test fun metadataBackgroundCompletionPublishesSameReadAndNotifiesOnce() =
+        kotlinx.coroutines.runBlocking {
+            val base = CpuInfoTest.FixtureContext(Locale.US)
+            val lifecycle = mock(PreferenceLifecycleContext::class.java)
+            val scope = CoroutineScope(SupervisorJob() + Dispatchers.Unconfined)
+            val notified = kotlinx.coroutines.CompletableDeferred<Unit>()
+            `when`(lifecycle.resources).thenReturn(base.resources)
+            `when`(lifecycle.lifecycleScope).thenReturn(scope)
+            doAnswer { notified.complete(Unit); null }.`when`(lifecycle)
+                .notifyPreferenceChange(CpuInfoPreference.KEY)
+            val preference = CpuInfoPreference()
+            preference.onStart(lifecycle)
+            kotlinx.coroutines.withTimeout(5000) { notified.await() }
+            assertEquals(CpuInfo.format(base, CpuInfo.read()), preference.getSummary(base))
+            verify(lifecycle, times(1)).notifyPreferenceChange(CpuInfoPreference.KEY)
+            preference.onDestroy(lifecycle)
+            scope.cancel()
+        }
+    @Test fun disabledApiRefusesAndHasNoSetter() {
+        val context = CpuInfoTest.FixtureContext(Locale.US)
+        context.enabled = false
+        val tester = ApiTester(HardwareInfoApiScreen(), context)
+        assertThrows(IllegalStateException::class.java) {
+            tester.get<String>(HardwareInfoApiScreen.CPU_KEY)
+        }
+        assertThrows(CannotSetException::class.java) {
+            tester.set(HardwareInfoApiScreen.CPU_KEY, "replacement")
+        }
+    }
+    @Test fun apiUsesSameRealReadAndFormatterWithoutPrivilegedPermission() {
+        val context = CpuInfoTest.FixtureContext(Locale.US)
+        val tester = ApiTester(HardwareInfoApiScreen(), context)
+        // This host-fixture sysfs is not phone hardware acceptance.
+        assertEquals(CpuInfo.format(context, CpuInfo.read()),
+            tester.get<String>(HardwareInfoApiScreen.CPU_KEY))
+    }
+}
