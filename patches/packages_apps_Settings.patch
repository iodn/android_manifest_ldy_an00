+    }
+
+    /** Uses platform-reported names without replacing them with a marketing model. */
+    public static String getSocSummary() {
+        String model = knownValue(Build.SOC_MODEL);
+        if (model == null) return null;
+        String manufacturer = knownValue(Build.SOC_MANUFACTURER);
+        return manufacturer == null ? model : manufacturer + " " + model;
+    }
+
+    private static String knownValue(String value) {
+        if (value == null || value.trim().isEmpty()
+                || Build.UNKNOWN.equalsIgnoreCase(value.trim())) return null;
+        return value.trim();
+    }
+
+    @Override
+    public CharSequence getSummary() {
+        String summary = getSocSummary();
+        return summary != null ? summary : mContext.getString(R.string.unknown);
+    }
+}
