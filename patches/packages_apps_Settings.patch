diff --git a/src/com/android/settings/biometrics/face/FaceEnrollChallengeOwnership.java b/src/com/android/settings/biometrics/face/FaceEnrollChallengeOwnership.java
new file mode 100644
index 0000000000000000000000000000000000000000..0a74c60b157322d952eeeee74ed0960158bb62b6
--- /dev/null
+++ b/src/com/android/settings/biometrics/face/FaceEnrollChallengeOwnership.java
@@ -0,0 +1,90 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.settings.biometrics.face;
+
+import android.os.Bundle;
+
+/** The reference generated by this introduction, never one borrowed through an Intent. */
+final class FaceEnrollChallengeOwnership {
+    private static final String OWNED = "face_intro_owned_challenge";
+    private static final String SENSOR = "face_intro_owned_sensor";
+    private static final String USER = "face_intro_owned_user";
+    private static final String CHALLENGE = "face_intro_owned_value";
+
+    interface Revoke {
+        void revoke(int sensorId, int userId, long challenge);
+    }
+
+    private final Revoke mRevoke;
+    private boolean mOwned;
+    private boolean mSaved;
+    private boolean mDestroyed;
+    private int mSensorId;
+    private int mUserId;
+    private long mChallenge;
+
+    FaceEnrollChallengeOwnership(Revoke revoke) {
+        mRevoke = revoke;
+    }
+
+    boolean onGenerated(int sensorId, int userId, long challenge) {
+        if (sensorId < 0 || userId < 0 || challenge == 0) return false;
+        if (mDestroyed || mSaved) {
+            // The saved reference belongs to the recreated activity. Retire only this new one.
+            mRevoke.revoke(sensorId, userId, challenge);
+            return false;
+        }
+        if (mOwned) release();
+        mSensorId = sensorId;
+        mUserId = userId;
+        mChallenge = challenge;
+        mOwned = true;
+        return true;
+    }
+
+    void save(Bundle out) {
+        out.putBoolean(OWNED, mOwned);
+        if (mOwned) {
+            out.putInt(SENSOR, mSensorId);
+            out.putInt(USER, mUserId);
+            out.putLong(CHALLENGE, mChallenge);
+        }
+        mSaved = mOwned;
+    }
+
+    void restore(Bundle state, int userId) {
+        if (state != null && state.getBoolean(OWNED)
+                && state.containsKey(SENSOR) && state.containsKey(USER)
+                && state.containsKey(CHALLENGE)
+                && state.getInt(SENSOR) >= 0 && state.getInt(USER) == userId
+                && state.getLong(CHALLENGE) != 0) {
+            mSensorId = state.getInt(SENSOR);
+            mUserId = userId;
+            mChallenge = state.getLong(CHALLENGE);
+            mOwned = true;
+        }
+    }
+
+    void resumed() {
+        // A background save does not transfer ownership if this instance resumes.
+        mSaved = false;
+    }
+
+    void destroyed(boolean finishing) {
+        mDestroyed = true;
+        if (!finishing && mSaved) {
+            mOwned = false; // The trusted saved state now owns this reference.
+        } else {
+            release();
+        }
+    }
+
+    void release() {
+        if (!mOwned) return;
+        mOwned = false;
+        mSaved = false;
+        mRevoke.revoke(mSensorId, mUserId, mChallenge);
+    }
+}
