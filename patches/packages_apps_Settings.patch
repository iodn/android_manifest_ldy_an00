new file mode 100644
index 0000000000000000000000000000000000000000..27bcc89f39da8dcc20df93aa05e7bc3bcdf9813f
--- /dev/null
+++ b/src/com/android/settings/deviceinfo/hardwareinfo/CpuInfo.java
@@ -0,0 +1,122 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.settings.deviceinfo.hardwareinfo;
+
+import android.content.Context;
+
+import com.android.settings.R;
+
+import java.io.BufferedReader;
+import java.io.IOException;
+import java.nio.file.DirectoryStream;
+import java.nio.file.Files;
+import java.nio.file.LinkOption;
+import java.nio.file.Path;
+import java.text.NumberFormat;
+import java.util.BitSet;
+import java.util.Locale;
+
+/** Read-only kernel reports, not installed physical core count or a guaranteed clock rate. */
+final class CpuInfo {
+    private static final Path ROOT = Path.of("/sys/devices/system/cpu");
+    private static final int MAX_CPU_ID = 4095;
+    private static final int MAX_TEXT = 4096;
+
+    static final class Snapshot {
+        final int presentCount;
+        final long maxReportedKhz;
+        final int policiesRead;
+        final int policiesFound;
+
+        Snapshot(int count, long khz, int read, int found) {
+            presentCount = count;
+            maxReportedKhz = khz;
+            policiesRead = read;
+            policiesFound = found;
+        }
+    }
+
+    static Snapshot read() {
+        return read(ROOT);
+    }
+
+    static Snapshot read(Path root) {
+        int count;
+        try {
+            count = parsePresent(readText(root.resolve("present")));
+        } catch (IOException | SecurityException e) {
+            return new Snapshot(0, 0, 0, 0);
+        }
+        if (count == 0) return new Snapshot(0, 0, 0, 0);
+        long max = 0;
+        int found = 0;
+        int read = 0;
+        try (DirectoryStream<Path> policies = Files.newDirectoryStream(root.resolve("cpufreq"))) {
+            for (Path policy : policies) {
+                if (Thread.currentThread().isInterrupted()) break;
+                if (!policy.getFileName().toString().matches("policy[0-9]{1,4}")
+                        || !Files.isDirectory(policy, LinkOption.NOFOLLOW_LINKS)) continue;
+                if (++found > MAX_CPU_ID + 1) return new Snapshot(count, 0, 0, 0);
+                try {
+                    long khz = Long.parseLong(readText(policy.resolve("cpuinfo_max_freq")));
+                    if (khz > 0) {
+                        max = Math.max(max, khz);
+                        read++;
+                    }
+                } catch (IOException | SecurityException | NumberFormatException e) {
+                    // A missing report is not a zero-frequency policy or proof of hardware maximum.
+                }
+            }
+        } catch (IOException | SecurityException e) {
+            return new Snapshot(count, 0, 0, 0);
+        }
+        return new Snapshot(count, max, read, found);
+    }
+
+    private static String readText(Path path) throws IOException {
+        try (BufferedReader reader = Files.newBufferedReader(path)) {
+            char[] buffer = new char[MAX_TEXT + 1];
+            int length = 0;
+            int n;
+            while ((n = reader.read(buffer, length, buffer.length - length)) > 0) {
+                length += n;
+                if (length > MAX_TEXT) throw new IOException("CPU report too long");
+            }
+            return new String(buffer, 0, length).trim();
+        }
+    }
+
+    static int parsePresent(String report) {
+        if (report == null || report.isEmpty() || report.length() > MAX_TEXT) return 0;
+        BitSet ids = new BitSet();
+        for (String range : report.split(",", -1)) {
+            if (!range.matches("[0-9]+(-[0-9]+)?")) return 0;
+            String[] ends = range.split("-");
+            try {
+                int first = Integer.parseInt(ends[0]);
+                int last = ends.length == 1 ? first : Integer.parseInt(ends[1]);
+                if (first > last || last > MAX_CPU_ID) return 0;
+                ids.set(first, last + 1);
+            } catch (NumberFormatException e) {
+                return 0;
+            }
+        }
+        return ids.cardinality();
+    }
+
+    static String format(Context context, Snapshot snapshot) {
+        if (snapshot.presentCount <= 0) return context.getString(R.string.unknown);
+        Locale locale = context.getResources().getConfiguration().getLocales().get(0);
+        NumberFormat integers = NumberFormat.getIntegerInstance(locale);
+        String count = context.getString(R.string.hardware_info_cpu_count,
+                integers.format(snapshot.presentCount));
+        if (snapshot.maxReportedKhz <= 0 || snapshot.policiesFound <= 0
+                || snapshot.policiesRead != snapshot.policiesFound) return count;
+        NumberFormat frequency = NumberFormat.getNumberInstance(locale);
+        frequency.setMaximumFractionDigits(3);
+        return count + "\n" + context.getString(R.string.hardware_info_cpu_limit,
+                frequency.format(snapshot.maxReportedKhz / 1_000_000.0));
+    }
+}
