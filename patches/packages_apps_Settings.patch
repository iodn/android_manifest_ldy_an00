@@ -0,0 +1,74 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.settings.deviceinfo.hardwareinfo;
+
+import android.content.Context;
+import androidx.preference.Preference;
+import androidx.preference.PreferenceScreen;
+
+import com.android.settings.R;
+import com.android.settings.core.BasePreferenceController;
+import com.android.settingslib.core.lifecycle.LifecycleObserver;
+import com.android.settingslib.core.lifecycle.events.OnStart;
+import com.android.settingslib.core.lifecycle.events.OnStop;
+import com.android.settingslib.utils.ThreadUtils;
+
+import java.util.concurrent.Future;
+
+public class CpuInfoPreferenceController extends BasePreferenceController
+        implements LifecycleObserver, OnStart, OnStop {
+    private Preference mPreference;
+    private CpuInfo.Snapshot mSnapshot;
+    private Future<?> mTask;
+    private int mGeneration;
+
+    public CpuInfoPreferenceController(Context context, String key) {
+        super(context, key);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return mContext.getResources().getBoolean(R.bool.config_show_hardware_info_details)
+                ? AVAILABLE : UNSUPPORTED_ON_DEVICE;
+    }
+
+    @Override
+    public void displayPreference(PreferenceScreen screen) {
+        super.displayPreference(screen);
+        mPreference = screen.findPreference(getPreferenceKey());
+    }
+
+    @Override
+    public void onStart() {
+        onStop();
+        if (!isAvailable()) return;
+        final int generation = mGeneration;
+        mTask = ThreadUtils.postOnBackgroundThread(() -> {
+            CpuInfo.Snapshot snapshot = readSnapshot();
+            mContext.getMainExecutor().execute(() -> {
+                if (generation != mGeneration) return;
+                mSnapshot = snapshot;
+                if (mPreference != null) updateState(mPreference);
+            });
+        });
+    }
+
+    CpuInfo.Snapshot readSnapshot() {
+        return CpuInfo.read();
+    }
+
+    @Override
+    public void onStop() {
+        mGeneration++;
+        if (mTask != null) mTask.cancel(true);
+        mTask = null;
+    }
+
+    @Override
+    public CharSequence getSummary() {
+        return mSnapshot == null ? mContext.getString(R.string.unknown)
+                : CpuInfo.format(mContext, mSnapshot);
+    }
+}
