+    }
+    @Test fun firstUsePositiveKeepsLocalTimezoneAndZeroStaysUnavailable() {
+        values[BatteryManager.BATTERY_PROPERTY_FIRST_USAGE_DATE]=epoch("2025-11-25")
+        assertEquals("November 24, 2025",BatteryFirstUseDatePreferenceController(context,"first_use").summary)
+        assertEquals("2025-11-24",ApiTester(BatteryInfoApiScreen(),context)
