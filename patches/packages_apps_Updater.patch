diff --git a/app/src/main/java/org/lineageos/updater/util/ReleaseNotes.kt b/app/src/main/java/org/lineageos/updater/util/ReleaseNotes.kt
new file mode 100644
index 0000000..f2143f6
--- /dev/null
+++ b/app/src/main/java/org/lineageos/updater/util/ReleaseNotes.kt
@@ -0,0 +1,26 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.updater.util
+
+import java.net.URI
+
+fun releaseNotesUrl(downloadUrl: String?): String? {
+    val uri = try {
+        URI(downloadUrl ?: return null)
+    } catch (_: IllegalArgumentException) {
+        return null
+    } catch (_: java.net.URISyntaxException) {
+        return null
+    }
+    if (uri.scheme != "https" || uri.host != "github.com" || uri.userInfo != null ||
+        uri.port != -1 || uri.rawQuery != null || uri.rawFragment != null) return null
+    val prefix = "/iodn/android_manifest_ldy_an00/releases/download/"
+    val path = uri.rawPath ?: return null
+    if (!path.startsWith(prefix)) return null
+    val parts = path.removePrefix(prefix).split('/')
+    if (parts.size != 2 || !Regex("lineage-[A-Za-z0-9._-]+").matches(parts[0]) ||
+        parts[1].isBlank()) return null
+    return "https://github.com/iodn/android_manifest_ldy_an00/releases/tag/${parts[0]}"
+}
