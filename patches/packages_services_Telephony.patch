index 0000000000000000000000000000000000000000..d3627b051d82178bc4b0e80d6edbafa133527ae0
--- /dev/null
+++ b/src/com/android/internal/telephony/honor/MtkSimTypeTransport.java
@@ -0,0 +1,192 @@
+/* Copyright (C) 2026 The LineageOS Project. SPDX-License-Identifier: Apache-2.0 */
+package com.android.internal.telephony.honor;
+
+import android.os.BadParcelableException;
+import android.os.Binder;
+import android.os.Handler;
+import android.os.IBinder;
+import android.os.IInterface;
+import android.os.Looper;
+import android.os.Parcel;
+import android.os.RemoteException;
+import java.util.concurrent.atomic.AtomicBoolean;
+
+/**
+ * Exact stock V2 supplemental SIM transport, not a replacement for standard RadioSim.
+ * No lookup, registration or command occurs until the owner explicitly invokes it.
+ * The owner must qualify exclusive main-pair ownership and reserve nonreused serials.
+ */
+final class MtkSimTypeTransport {
+    static final String DESCRIPTOR="vendor.mediatek.hardware.mtkradioex.sim.IMtkRadioExSim";
+    static final String HASH="dd10c80aa3478fddc0a46cab8597191943a29052";
+    private static final int VERSION=2, ACK=36, REGISTER=37, GET=40, SWITCH=41;
+    private static final int GET_HASH=16777214, GET_VERSION=16777215;
+    interface Listener {
+        void queryResult(int type,int serial,int error,int support,int mode,int reserved);
+        void switchResult(int type,int serial,int error);
+        /** Advisory invalidation only; cannot replace a fresh correlated query. */
+        void simTypeChanged(int support,int mode,int reserved);
+        void unavailable();
+    }
+    private final IBinder remote;
+    private final Handler worker;
+    private final Listener listener;
+    private final AtomicBoolean failed=new AtomicBoolean();
+    private final Endpoint response=new Endpoint(true), indication=new Endpoint(false);
+    private boolean registrationAttempted, registered, ownershipReserved;
+
+    MtkSimTypeTransport(IBinder remote,Handler worker,Listener listener) throws RemoteException {
+        this.remote=java.util.Objects.requireNonNull(remote);
+        this.worker=java.util.Objects.requireNonNull(worker);
+        this.listener=java.util.Objects.requireNonNull(listener);
+        requireWorker();
+        if(worker.getLooper()==Looper.getMainLooper())
+            throw new IllegalArgumentException("Dedicated phone worker required");
+        if(!DESCRIPTOR.equals(remote.getInterfaceDescriptor())
+                || version()!=VERSION || !HASH.equals(hash()))
+            throw new RemoteException("MTK SIM V2 identity mismatch");
+        remote.linkToDeath(this::fail,0);
+    }
+    private void requireWorker() {
+        if(Looper.myLooper()!=worker.getLooper())
+            throw new IllegalStateException("Owner worker required");
+    }
+    private int version() throws RemoteException {
+        Parcel data=Parcel.obtain(remote), reply=Parcel.obtain();
+        try {
+            data.writeInterfaceToken(DESCRIPTOR);
+            if(!remote.transact(GET_VERSION,data,reply,0)) throw new RemoteException("No version");
+            reply.readException(); return reply.readInt();
+        } finally {data.recycle();reply.recycle();}
+    }
+    private String hash() throws RemoteException {
+        Parcel data=Parcel.obtain(remote), reply=Parcel.obtain();
+        try {
+            data.writeInterfaceToken(DESCRIPTOR);
+            if(!remote.transact(GET_HASH,data,reply,0)) throw new RemoteException("No hash");
+            reply.readException(); return reply.readString();
+        } finally {data.recycle();reply.recycle();}
+    }
+    /** Reserve before any paired SEP registration; refusal here performs no remote mutation. */
+    void reserveCallbackOwnership() {
+        requireWorker();
+        if(failed.get()) throw new IllegalStateException("MTK owner unavailable");
+        if(!ownershipReserved) {
+            MtkSimCallbackOwner.PROCESS.claim(this);ownershipReserved=true;
+        }
+    }
+    /** MUTATES callback ownership and may replay native connection notifications. Once per owner. */
+    void registerCallbacks() throws RemoteException {
+        requireWorker();
+        if(registrationAttempted || failed.get()) throw new IllegalStateException("No registration retry");
+        registrationAttempted=true;
+        reserveCallbackOwnership();
+        Parcel data=Parcel.obtain(remote);
+        try {
+            data.writeInterfaceToken(DESCRIPTOR);
+            data.writeStrongBinder(response); data.writeStrongBinder(indication);
+            send(REGISTER,data); registered=true;
+        } catch(RemoteException | RuntimeException e) {fail();throw e;}
+        finally {data.recycle();}
+    }
+    void query(int serial) throws RemoteException {command(GET,serial,-1);}
+    /** Actual modem mutation; the owner must durably publish PENDING before invoking it. */
+    void select(int serial,int mode) throws RemoteException {
+        if(mode!=0 && mode!=1) throw new IllegalArgumentException("Unknown SIM mode");
+        command(SWITCH,serial,mode);
+    }
+    private void command(int code,int serial,int mode) throws RemoteException {
+        requireWorker();
+        if(serial<=0 || !registered || failed.get())
+            throw new IllegalStateException("Unavailable or unreserved request");
+        Parcel data=Parcel.obtain(remote);
+        try {
+            data.writeInterfaceToken(DESCRIPTOR); data.writeInt(serial);
+            if(code==SWITCH) data.writeInt(mode);
+            data.writeInt(0); // Only the native main client ID supports these requests.
+            send(code,data);
+        } catch(RemoteException | RuntimeException e) {fail();throw e;}
+        finally {data.recycle();}
+    }
+    private void send(int code,Parcel data) throws RemoteException {
+        if(!remote.transact(code,data,null,IBinder.FLAG_ONEWAY))
+            throw new RemoteException("MTK SIM transaction refused");
+    }
+    private void acknowledge() throws RemoteException {
+        // Still release expected notifications after local invalidation; no serial argument.
+        Parcel data=Parcel.obtain(remote);
+        try {data.writeInterfaceToken(DESCRIPTOR);send(ACK,data);}
+        finally {data.recycle();}
+    }
+    private void deliver(Runnable event) {
+        if(!worker.post(()->{
+            if(failed.get()) return;
+            try {event.run();} catch(RuntimeException e) {fail();}
+        })) fail();
+    }
+    /** Immediate cross-thread loss signal; not proof of registration or endpoint readiness. */
+    boolean isHealthy() {return !failed.get();}
+    private void fail() {
+        if(failed.compareAndSet(false,true)) worker.post(()->{
+            try {listener.unavailable();} catch(RuntimeException ignored) {}
+        });
+    }
+    /** Both inspected stable parcelables contain a size header and three required int32 fields. */
+    private static int[] tuple(Parcel data) {
+        if(data.readInt()!=1) throw new BadParcelableException("Missing required object");
+        int start=data.dataPosition(), size=data.readInt();
+        if(size<16 || size>data.dataSize()-start)
+            throw new BadParcelableException("Invalid object size");
+        int[] values={data.readInt(),data.readInt(),data.readInt()};
+        data.setDataPosition(start+size); return values;
+    }
+    private final class Endpoint extends Binder implements IInterface {
+        private final boolean responses;
+        private final String descriptor;
+        Endpoint(boolean responses) {
+            this.responses=responses;
+            descriptor=DESCRIPTOR+(responses ? "Response" : "Indication");
+            attachInterface(this,descriptor); markVintfStability();
+        }
+        @Override public IBinder asBinder() {return this;}
+        @Override protected boolean onTransact(int code,Parcel data,Parcel reply,int flags)
+                throws RemoteException {
+            if(code==INTERFACE_TRANSACTION) {if(reply!=null) reply.writeString(descriptor);return true;}
+            if(code==GET_VERSION || code==GET_HASH) {
+                data.enforceInterface(descriptor);
+                if(reply==null) return false;
+                reply.writeNoException();
+                if(code==GET_VERSION) reply.writeInt(VERSION);else reply.writeString(HASH);
+                return true;
+            }
+            if(code<1 || code>(responses ? 36 : 15))
+                return super.onTransact(code,data,reply,flags);
+            try {
+                data.enforceInterface(descriptor);
+                if(responses) {
+                    int[] info=tuple(data); // type, serial, RIL error
+                    if(info[0]<0 || info[0]>2) throw new BadParcelableException("Invalid response type");
+                    if(info[0]==2) acknowledge(); // ACK1 is intermediate and must NOT release a wake lock.
+                    if(code==35) {
+                        int[] value=tuple(data);data.enforceNoDataAvail();
+                        deliver(()->listener.queryResult(info[0],info[1],info[2],value[0],value[1],value[2]));
+                    } else if(code==36) {
+                        data.enforceNoDataAvail();
+                        deliver(()->listener.switchResult(info[0],info[1],info[2]));
+                    }
+                    // Other responses are not ours. ACK expected delivery, never publish a result.
+                } else {
+                    int type=data.readInt();
+                    if(type<0 || type>1) throw new BadParcelableException("Invalid indication type");
+                    if(type==1) acknowledge();
+                    if(code==15) {
+                        int[] value=tuple(data);data.enforceNoDataAvail();
+                        deliver(()->listener.simTypeChanged(value[0],value[1],value[2]));
+                    }
+                    // Standard RadioSim keeps owning normal SIM state; ignore other extension data.
+                }
+            } catch(RemoteException | RuntimeException e) {fail();}
+            return true;
+        }
+    }
+}
