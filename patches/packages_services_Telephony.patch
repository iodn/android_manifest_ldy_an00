+#!/usr/bin/env python3
+# Copyright (C) 2026 The LineageOS Project
+# SPDX-License-Identifier: Apache-2.0
+"""Compile and run actual pure feedback decoders/state without Android or modem access."""
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+
+root = Path(__file__).resolve().parents[2]
+sources = [
+    root / "src/com/android/internal/telephony/honor" / (name + ".java")
+    for name in (
+        "HonorMtkVoiceQualityDecoder",
+        "HonorMtkImsDefaultOpenDecoder",
+        "HonorImsDefaultOpenState",
+    )
+]
+sources.append(root / "tests/host/HonorMtkCallFeedbackDecoderTest.java")
+with tempfile.TemporaryDirectory(prefix="call-feedback-host-") as out:
+    subprocess.run(
+        [os.environ.get("CALL_QOS_JAVAC", "javac"), "-Xlint:all", "-Werror", "-d", out]
+        + [str(source) for source in sources],
+        check=True,
+    )
+    subprocess.run(
+        [os.environ.get("CALL_QOS_JAVA", "java"), "-cp", out,
+         "com.android.internal.telephony.honor.HonorMtkCallFeedbackDecoderTest"],
+        check=True,
+    )
