+package com.android.internal.telephony.honor;
+
+/** A stale bound Stub cannot acquire/check/finish after its Service was destroyed. */
+final class LpaLeaseServiceLifetime {
+    private volatile boolean destroyed;
+    void requireAlive() { if(destroyed) throw new IllegalStateException("Lease service destroyed"); }
+    void destroy() { destroyed=true; }
+}
