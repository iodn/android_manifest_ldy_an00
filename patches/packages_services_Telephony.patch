+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.internal.telephony.honor;
+
+import android.content.Context;
+import android.os.Handler;
+import android.os.IBinder;
+import android.os.Looper;
+import android.os.RemoteException;
+import android.telephony.SubscriptionInfo;
+import android.telephony.SubscriptionManager;
+import android.util.Log;
+
+import com.android.internal.telephony.Phone;
+import com.android.internal.telephony.PhoneFactory;
+import com.android.internal.telephony.subscription.DefaultDataSelectionIntent;
+import com.android.internal.telephony.subscription.SubscriptionManagerService;
+import com.android.internal.telephony.uicc.UiccController;
+import com.android.internal.telephony.uicc.IccUtils;
+
+/** Restores only a same-card data choice displaced by an owned temporary management route. */
+public final class HonorManagedDataPreference {
+    private static HonorManagedDataPreference instance;
+    private final Context context;
+    private final Handler controller;
+    private final Handler main = new Handler(Looper.getMainLooper());
+    private Pending pending;
+
+    private final class Pending {
+        final HonorSepTrialOwner owner;
+        final long generation;
+        final HonorManagedDataExcursion operation;
+        final IBinder client;
+        final IBinder.DeathRecipient death;
+        final int subId;
+        final String iccId;
+        final DefaultDataSelectionIntent.Snapshot intent;
+        final DefaultDataSelectionIntent.Preservation preservation;
+        final Runnable lifetime;
+        boolean returned, checking;
+        Runnable expiry;
+
+        Pending(HonorSepTrialOwner owner, String nonce, int phase, IBinder client,
+                SubscriptionInfo physical, DefaultDataSelectionIntent.Snapshot intent,
+                DefaultDataSelectionIntent.Preservation preservation) {
+            this.owner = owner;
+            generation = owner.generation();
+            operation = new HonorManagedDataExcursion(owner, generation, nonce, phase);
+            this.client = client;
+            subId = physical.getSubscriptionId();
+            iccId = physical.getIccId();
+            this.intent = intent;
+            this.preservation = preservation;
+            lifetime = () -> discard(this);
+            death = () -> controller.post(() -> discard(this));
+        }
+    }
+
+    private HonorManagedDataPreference(Context context) {
+        this.context = context.getApplicationContext();
+        controller = new Handler(UiccController.getInstance().getLooper());
+        HonorSubscriberAdoption.addListener(controller, this::review);
+        HonorRadioCommBroker.addStateListener(controller, this::review);
+        Handler calls = new Handler(controller.getLooper(), message -> {
+            review();
+            return true;
+        });
+        for (Phone phone : PhoneFactory.getPhones()) {
+            phone.registerForPreciseCallStateChanged(calls, 1, null);
+        }
+    }
+
+    private static HonorManagedDataPreference get(Context context) {
+        if (instance == null) instance = new HonorManagedDataPreference(context);
+        return instance;
+    }
+
+    /** Called before dispatch; async identity capture never starts or repeats a route command. */
+    public static void beforeOutbound(Context context, HonorSepTrialOwner owner, String nonce,
+            int phase, IBinder client, Runnable dispatch) {
+        UiccController.getInstance().post(() -> {
+            HonorManagedDataPreference holder = get(context);
+            holder.discard(holder.pending);
+            try {
+                if (nonce != null && nonce.matches("[0-9a-f]{32}")
+                        && phase >= 0 && phase < Integer.MAX_VALUE
+                        && owner == HonorSepTrialOwner.existingPreparedOwner()) {
+                    SubscriptionManagerService subscriptions = SubscriptionManagerService.getInstance();
+                    var intent = subscriptions.getDefaultDataSelectionIntent();
+                    PhysicalObservation observation = holder.physical();
+                    SubscriptionInfo physical = observation == null ? null : observation.info();
+                    if (physical != null && physical.getSubscriptionId()
+                            == SubscriptionManager.getDefaultDataSubscriptionId()
+                            && subscriptions.isDefaultDataSelectionIntentCurrent(intent)) {
+                        var exact = new java.util.concurrent.atomic.AtomicReference<Pending>();
+                        var preservation = subscriptions.preserveDataEnabledForSharedRoute(
+                                physical.getSubscriptionId(), physical.getIccId(), intent,
+                                () -> holder.controller.post(() -> holder.discard(exact.get())));
+                        if (preservation != null) {
+                            Pending record = holder.new Pending(owner, nonce, phase, client,
+                                    physical, intent, preservation);
+                            holder.pending = record;
+                            exact.set(record);
+                            holder.controller.postDelayed(record.lifetime, 30 * 60_000L);
+                            client.linkToDeath(record.death, 0);
+                            if (!client.isBinderAlive()) holder.discard(record);
+                        }
+                    }
+                }
+            } catch (RuntimeException | RemoteException unavailable) {
+                holder.discard(holder.pending); // Missing provenance never blocks profile management.
+            }
+            holder.main.post(dispatch);
+        });
+    }
+
+    /** Only the same temporary management request can arm a physical-return observation. */
+    public static void beforeReturn(HonorSepTrialOwner owner, String nonce, int phase) {
+        UiccController.getInstance().post(() -> {
+            HonorManagedDataPreference holder = instance;
+            if (holder == null || holder.pending == null) return;
+            Pending record = holder.pending;
+            if (!record.operation.requestReturn(owner, owner.generation(), nonce, phase)) {
+                holder.discard(record);
+            }
+        });
+    }
+
+    public static void observed(HonorSepTrialOwner owner, String state, int phase) {
+        UiccController.getInstance().post(() -> {
+            HonorManagedDataPreference holder = instance;
+            if (holder == null || holder.pending == null) return;
+            Pending record = holder.pending;
+            if (record.operation.observe(owner, owner.generation(), state, phase)) {
+                record.returned = true;
+                if (record.expiry == null) {
+                    record.expiry = () -> holder.discard(record);
+                    holder.controller.postDelayed(record.expiry, 60_000);
+                }
+                holder.review();
+            } else if (!record.operation.current(record.owner, record.owner.generation())) {
+                holder.discard(record);
+            }
+        });
+    }
+
+    public static void cancel() {
+        UiccController.getInstance().post(() -> {
+            if (instance != null) instance.discard(instance.pending);
+        });
+    }
+
+    private record PhysicalObservation(
+            SubscriptionInfo info, HonorSubscriberAdoption.Proof proof) {}
+
+    private PhysicalObservation physical() {
+        Phone[] phones = PhoneFactory.getPhones();
+        MtkAssistProfile[] tuples = MtkAssistProfile.capture(phones, 2);
+        if (tuples.length != 2 || !tuples[1].usable()) return null;
+        HonorSubscriberAdoption.Proof proof = HonorSubscriberAdoption.proof(1, tuples[1]);
+        if (proof == null || proof.euicc() || proof.physical() != 1 || proof.port() != 0
+                || !HonorSubscriberAdoption.current(proof)) return null;
+        SubscriptionManager subscriptions = context.getSystemService(SubscriptionManager.class);
+        SubscriptionInfo info = subscriptions == null ? null
+                : subscriptions.getActiveSubscriptionInfo(tuples[1].subscription);
+        if (info == null || info.isEmbedded() || info.getSimSlotIndex() != 1
+                || info.getIccId() == null || info.getIccId().isEmpty()
+                || !IccUtils.stripTrailingFs(info.getIccId()).equals(proof.currentIccid())) return null;
+        return new PhysicalObservation(info, proof);
+    }
+
+    private void review() {
+        Pending record = pending;
+        if (record == null) return;
+        try {
+            if (HonorLpaLeaseService.leases(context).state() == LpaOperationLease.State.UNKNOWN) {
+                discard(record);
+                return;
+            }
+            HonorLpaLeaseService.recoveryFence(context).requireNormal();
+        } catch (Exception unavailable) {
+            discard(record);
+            return;
+        }
+        SubscriptionManagerService subscriptions = SubscriptionManagerService.getInstance();
+        if (record.owner != HonorSepTrialOwner.existingPreparedOwner()
+                || !record.operation.current(record.owner, record.owner.generation())
+                || !record.client.isBinderAlive()
+                || !subscriptions.isDefaultDataSelectionIntentCurrent(record.intent)) {
+            discard(record);
+            return;
+        }
+        if (!record.returned || record.checking) return;
+        record.checking = true;
+        record.owner.requestUiSnapshot(state -> controller.post(() -> {
+            record.checking = false;
+            if (pending != record || !record.operation.observe(
+                    record.owner, record.owner.generation(), state.state.name(), state.phaseSerial)) {
+                if (pending == record) discard(record);
+                return;
+            }
+            restore(record);
+        }));
+    }
+
+    private void restore(Pending record) {
+        try {
+            PhysicalObservation observation = physical();
+            if (observation == null) return;
+            SubscriptionInfo physical = observation.info();
+            if (physical == null) return; // Fresh adoption listener will re-evaluate, without writing.
+            if (physical.getSubscriptionId() != record.subId
+                    || !record.iccId.equals(physical.getIccId())) {
+                discard(record);
+                return;
+            }
+            HonorSimRouteCallGuard.requireIdle();
+            Phone[] phones = PhoneFactory.getPhones();
+            if (phones.length != 2 || phones[0].getRadioCapability() == null
+                    || phones[1].getRadioCapability() == null
+                    || phones[0].getRadioCapability().getRadioAccessFamily()
+                            != phones[1].getRadioCapability().getRadioAccessFamily()) {
+                discard(record);
+                return;
+            }
+            LpaOperationLease leases = HonorLpaLeaseService.leases(context);
+            synchronized (leases) {
+                HonorLpaLeaseService.recoveryFence(context).requireNormal();
+                if (SepMuxJournal.unresolvedHistory(new AtomicSepMuxStore(context))) {
+                    discard(record);
+                    return;
+                }
+                Object token = leases.beginDefaultDataRestoration();
+                boolean known = true; // The reserved selector is unchanged until DDS entry.
+                boolean ddsEntered = false;
+                String stage = "LATEST_PHYSICAL";
+                try {
+                    PhysicalObservation latest = physical();
+                    if (latest == null || latest.info() == null
+                            || latest.info().getSubscriptionId() != record.subId
+                            || !record.iccId.equals(latest.info().getIccId())
+                            || !HonorSubscriberAdoption.current(latest.proof())) {
+                        known = true; // No DDS call was entered and the reserved selector is unchanged.
+                        return;
+                    }
+                    stage = "DDS_OBSERVATION";
+                    SubscriptionManagerService subscriptions = SubscriptionManagerService.getInstance();
+                    int expectedDefault = subscriptions.getDefaultDataSubId();
+                    // The framework atomically compares intent/current DDS and updates its store.
+                    // Fresh identity is checked here and in its DB; hardware/DB events are async.
+                    // USER data enable is never written by this restoration.
+                    stage = "DDS_RESTORE";
+                    ddsEntered = true;
+                    known = false; // Once entered, a throw may follow a committed DDS-store write.
+                    subscriptions.restoreDefaultDataSubIdAfterSharedRoute(
+                            record.preservation, expectedDefault);
+                    known = true;
+                    stage = "DDS_RETURNED";
+                } finally {
+                    Log.i("HonorLpaLifecycle", "stage=MANAGED_DDS substage=" + stage
+                            + " ddsEntered=" + ddsEntered + " settled=" + known);
+                    leases.finishPrimarySelection(token, known);
+                    discard(record); // One compare-and-apply only, including a refused comparison.
+                }
+            }
+        } catch (HonorSimRouteCallGuard.CallBusy | LpaOperationLease.PolicyReleasePending deferred) {
+            // No DDS call was entered. Real call-idle/readiness events may reconsider this token.
+        } catch (Exception unavailable) {
+            discard(record); // No replay, alternate subscriber, data toggle or modem reset.
+        }
+    }
+
+    private void discard(Pending record) {
+        if (record == null || pending != record) return;
+        pending = null;
+        record.operation.cancel();
+        controller.removeCallbacks(record.lifetime);
+        if (record.expiry != null) controller.removeCallbacks(record.expiry);
+        try {
+            SubscriptionManagerService.getInstance().releaseDataEnabledForSharedRoute(
+                    record.preservation);
+        } finally {
+            try { record.client.unlinkToDeath(record.death, 0); }
+            catch (RuntimeException alreadyGone) { }
+        }
+    }
+}
