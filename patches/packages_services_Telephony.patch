+        if (event.sequence() <= session.cycleBarrier) {
+            boolean fresh = event.sequence() > session.priorTerminalSequence
+                    && session.priorTerminalSequence > 0
+                    && (call != null
+                        ? session.cache.isFreshCycleCall(call.callId,
+                                session.priorTerminalSequence)
+                            || call.status == HonorCallQosPolicy.Status.STARTING
+                        : session.cache.isFreshCycleSip(sip.sipCallId,
+                                session.priorTerminalSequence) || sip.initialInvite);
