+package com.android.internal.telephony.honor;
+
+import android.content.Context;
+import android.content.BroadcastReceiver;
+import android.content.Intent;
+import android.content.IntentFilter;
+import android.database.ContentObserver;
+import android.os.Handler;
+import android.os.HandlerThread;
+import android.os.Looper;
+import android.os.PersistableBundle;
+import android.os.SystemClock;
+import android.os.SystemProperties;
+import android.telephony.CarrierConfigManager;
+import android.telephony.SubscriptionManager;
+import com.android.ims.ImsManager;
+import com.android.internal.telephony.subscription.SubscriptionManagerService;
+import com.android.internal.telephony.uicc.UiccController;
+import java.util.EnumMap;
+import java.util.List;
+import java.util.Objects;
+import java.util.function.Consumer;
+
+/** One handler-owned regional vote arbiter using the existing hncall hardware owner. */
+final class HonorRegionalImsControl {
+    enum Feature {
+        VONR(2004), WFC(2005);
+        final int message;
+        Feature(int message){this.message=message;}
+    }
+    enum Policy { OVERSEAS_VONR, DYNAMIC_VONR, DYNAMIC_WFC, DEFAULT_OPEN_WFC }
+    enum Outcome { NATIVE_ACCEPTED, DEFERRED, NATIVE_ERROR, UNKNOWN, UNAVAILABLE }
+    record Receipt(Outcome outcome,long requestedDeadline) {}
+    record Scope(int slot,long binding,long profile,MtkAssistProfile subscriber) {
+        Scope {
+            if(slot<0||slot>1||binding<=0||profile<=0||subscriber==null||!subscriber.usable())
+                throw new IllegalArgumentException("Unqualified policy scope");
+        }
+        @Override public String toString(){return "RegionalScope[identifiers omitted]";}
+    }
+    record Vote(Policy policy,Scope scope,Feature feature,boolean enabled,long durationMillis) {
+        Vote {
+            if(policy==null||scope==null||feature==null||durationMillis<0
+                    || (policy==Policy.OVERSEAS_VONR||policy==Policy.DYNAMIC_VONR)
+                        !=(feature==Feature.VONR))
+                throw new IllegalArgumentException("Regional policy feature");
+        }
+        @Override public String toString(){return "RegionalVote[identifiers omitted]";}
+    }
+    interface Inputs {
+        /** Independent USER/carrier intent, never the configured flag our own vote changes. */
+        Boolean unvoted(Scope scope,Feature feature);
+        /** Configured AP flag only, never evidence of CP application. */
+        Boolean configured(int slot,Feature feature);
+        void watch(Handler handler,Runnable intentChanged,Runnable configuredChanged);
+    }
+    private static HonorRegionalImsControl instance;
+    private static boolean initializing;
+    /** Explicit source attachment entry. The caller must admit the deployment/migration cohort. */
+    static void initialize(Context context) {
+        Handler handler=new Handler(UiccController.getInstance().getLooper());
+        handler.post(()->{
+            if(instance!=null||initializing)return;
+            HonorOverseasVonrPolicy.Config config;
+            HonorOverseasCallNormality normality;
+            // Boundary is the packaged configuration only; internal controller errors are not hidden.
+            try(var stream=context.getAssets().open("honor_call_policy/oversea_vonr_selfcure.xml");
+                    var codes=context.getAssets().open("honor_call_policy/ims_default_open_selfcure.xml")) {
+                config=HonorOverseasVonrPolicy.Config.read(stream);
+                normality=HonorOverseasCallNormality.read(codes);
+            }catch(Exception unavailable){return;}
+            HonorDynamicWfcPolicy parsedWfc;
+            try(var stream=context.getAssets().open("honor_call_policy/vowifi_dynamic_switch.xml")) {
+                parsedWfc=HonorDynamicWfcPolicy.read(stream);
+            }catch(Exception unavailable){parsedWfc=null;}
+            final HonorDynamicWfcPolicy wfc=parsedWfc;
+            initializing=true;
+            HonorCallQosController.requestHardwareOwner(owner->{
+                if(owner==null){initializing=false;return;}
+                HonorRegionalImsControl control=new HonorRegionalImsControl(handler,owner,
+                        HnCallPolicyCustody.get(context),sourceInputs(context));
+                HandlerThread history=new HandlerThread("HonorRegionalImsHistory");
+                history.start();
+                new HonorOverseasVonrController(handler,new Handler(history.getLooper()),control,
+                        config,normality,HonorOverseasVonrController.sourceInputs(context),
+                        HonorOverseasVonrController.sourceHistory(context));
+                if(wfc!=null)new HonorDynamicWfcController(handler,control,wfc,
+                        HonorDynamicWfcController.sourceInputs(context));
+                instance=control;initializing=false;
+            });
+        });
+    }
+    private static final class Aim {
+        final Vote vote;
+        final Consumer<Receipt> reply;
+        boolean reported,deferredReported;
+        long deadline;
+        Aim(Vote vote,Consumer<Receipt> reply){this.vote=vote;this.reply=reply;}
+    }
+    private static final class State {
+        final Scope scope;
+        final Feature feature;
+        final EnumMap<Policy,Aim> votes=new EnumMap<>(Policy.class);
+        long revision=1,pending,acceptedRevision,uncertainToken,uncertainRevision;
+        boolean proofRequested,uncertainTarget;
+        boolean suppressedForRoute;
+        Boolean unvoted,observed,acceptedTarget;
+        HnCallPolicyCustody.PolicyProof authorization;
+        State(Scope scope,Feature feature){this.scope=scope;this.feature=feature;}
+    }
+    private final Handler handler;
+    private final HnCallHardwareOwner hardware;
+    private final HnCallPolicyCustody custody;
+    private final Inputs inputs;
+    private final State[][] states=new State[2][Feature.values().length];
+    HonorRegionalImsControl(Handler handler,HnCallHardwareOwner hardware,
+            HnCallPolicyCustody custody,Inputs inputs) {
+        this.handler=Objects.requireNonNull(handler);this.hardware=Objects.requireNonNull(hardware);
+        this.custody=Objects.requireNonNull(custody);this.inputs=Objects.requireNonNull(inputs);
+        inputs.watch(handler,this::intentChanged,this::configuredChanged);
+        custody.setReleaseDemand(()->handler.post(this::releaseForRoute));
+        HonorCallQosController.addRecoveryAdmissionListener(handler,this::reviewAll);
+    }
+    Boolean unvoted(Scope scope,Feature feature) {
+        requireThread();return inputs.unvoted(scope,feature);
+    }
+    void offer(Vote vote,Consumer<Receipt> reply) {
+        requireThread();Objects.requireNonNull(reply);
+        State state=states[vote.scope().slot()][vote.feature().ordinal()];
+        if(state==null||!state.scope.equals(vote.scope())) {
+            if(state!=null)revoke(state);
+            state=new State(vote.scope(),vote.feature());
+            states[vote.scope().slot()][vote.feature().ordinal()]=state;
+        }
+        state.votes.put(vote.policy(),new Aim(vote,reply));
+        state.suppressedForRoute=false;changed(state);review(state);
+    }
+    void withdraw(Policy policy,Scope scope,Feature feature) {
+        requireThread();State state=states[scope.slot()][feature.ordinal()];
+        if(state!=null&&state.scope.equals(scope)&&state.votes.remove(policy)!=null) {
+            changed(state);review(state);
+        }
+    }
+    private void requireThread() {
+        if(Looper.myLooper()!=handler.getLooper())throw new IllegalStateException("Regional policy looper");
+    }
+    private void revoke(State state) {
+        if(state.authorization!=null)state.authorization.retire();
+        state.authorization=null;
+        custody.withdraw(state.scope.slot(),state.feature.message);
+    }
+    private void changed(State state) {
+        revoke(state);
+        if(state.revision==Long.MAX_VALUE)throw new IllegalStateException("Policy revision exhausted");
+        state.revision++;
+    }
+    private void intentChanged() {
+        requireThread();
+        for(State[] slot:states)for(State state:slot)if(state!=null){changed(state);review(state);}
+    }
+    private void configuredChanged() {
+        requireThread();
+        for(State[] slot:states)for(State state:slot)if(state!=null) {
+            Boolean current=inputs.configured(state.scope.slot(),state.feature);
+            if(!Objects.equals(current,state.observed)) {
+                state.observed=current;
+                // Expected property echo while a request is in flight is not a new user intent.
+                if(state.pending==0&&current!=null&&state.acceptedTarget!=null
+                        &&!current.equals(state.acceptedTarget))changed(state);
+                review(state);
+            }
+        }
+    }
+    private void releaseForRoute() {
+        requireThread();
+        for(State[] slot:states)for(State state:slot)if(state!=null
+                &&custody.owned(state.scope.slot(),state.feature.message)!=null) {
+            // Suspend this profile's votes for the explicit route demand. Only a genuine new
+            // policy offer may reactivate them; snapshots cannot race the user's route retry.
+            state.suppressedForRoute=true;changed(state);review(state);
+        }
+    }
+    private void reviewAll() {
+        requireThread();
+        for(State[] slot:states)for(State state:slot)if(state!=null)review(state);
+    }
+    private boolean current(State state) {
+        return states[state.scope.slot()][state.feature.ordinal()]==state;
+    }
+    private void review(State state) {
+        if(!current(state)||state.pending!=0||state.proofRequested)return;
+        if(state.uncertainToken!=0) {
+            var accepted=custody.lastAccepted(state.scope.slot(),state.feature.message);
+            if(accepted==null||accepted.token()!=state.uncertainToken
+                    ||accepted.bindingGeneration()!=state.scope.binding()
+                    ||accepted.profileGeneration()!=state.scope.profile()
+                    ||custody.uncertain(state.scope.slot()))return;
+            // Only this original late final is drained. It never acknowledges newer policy intent.
+            state.uncertainToken=0;state.acceptedRevision=state.uncertainRevision;
+            state.acceptedTarget=state.uncertainTarget;
+        }
+        if(custody.uncertain(state.scope.slot()))return;
+        long reviewRevision=state.revision;
+        state.proofRequested=true;
+        HonorCallQosController.requestRecoveryAdmission(state.scope.slot(),handler,proof->{
+            state.proofRequested=false;
+            if(!current(state)||state.pending!=0)return;
+            if(reviewRevision!=state.revision){review(state);return;}
+            if(!proof.quiescent()||proof.bindingGeneration()!=state.scope.binding()
+                    ||proof.profileGeneration()!=state.scope.profile()
+                    ||!state.scope.subscriber().equals(proof.profileTuple())){revoke(state);return;}
+            Boolean baseline=inputs.unvoted(state.scope,state.feature);
+            if(baseline==null)return;
+            if(!Objects.equals(baseline,state.unvoted)){state.unvoted=baseline;changed(state);}
+            boolean target=baseline;
+            long now=SystemClock.elapsedRealtime(),deadline=0;
+            if(!state.suppressedForRoute)for(Aim aim:state.votes.values()) {
+                if(aim.deadline!=0&&now>=aim.deadline)continue;
+                target&=aim.vote.enabled();
+            }
+            var owned=custody.owned(state.scope.slot(),state.feature.message);
+            if(state.votes.isEmpty()&&owned==null)return;
+            if(state.suppressedForRoute&&owned==null)return;
+            boolean baselineSettlement=target==baseline;
+            boolean custodyMatches=baselineSettlement?owned==null:owned!=null
+                    &&owned.enabled()==target;
+            if(state.acceptedRevision==state.revision&&Objects.equals(state.acceptedTarget,target)
+                    &&custodyMatches)return;
+            List<Aim> submitted=state.suppressedForRoute?List.of():List.copyOf(state.votes.values());
+            for(Aim aim:submitted)if(aim.vote.enabled()==target&&aim.vote.durationMillis()>0) {
+                if(aim.deadline==0) {
+                    aim.deadline=Math.addExact(now,aim.vote.durationMillis());
+                    long scheduledDeadline=aim.deadline;
+                    handler.postDelayed(()->{
+                        if(current(state)&&state.votes.get(aim.vote.policy())==aim
+                                &&aim.deadline==scheduledDeadline
+                                &&SystemClock.elapsedRealtime()>=scheduledDeadline) {
+                            state.votes.remove(aim.vote.policy());
+                            changed(state);review(state);
+                        }
+                    },aim.vote.durationMillis());
+                }
+                deadline=Math.max(deadline,aim.deadline);
+            }
+            var epoch=new HnCallHardwareOwner.Snapshot(proof.bindingGeneration(),
+                    proof.profileGeneration(),proof.processedNativeSequence(),true);
+            var authorization=new HnCallPolicyCustody.PolicyProof(target,baseline);
+            state.authorization=authorization;
+            var plan=new HnCallPolicyCustody.Plan(state.scope.slot(),state.feature.message,target,
+                    target==baseline,epoch,proof.profileTuple(),proof.adoption(),state.revision,
+                    owned==null?(baseline?1:0):owned.baseline(),deadline,authorization);
+            custody.offer(plan);state.pending=state.revision;
+            long submittedRevision=state.pending;
+            boolean submittedTarget=target;
+            Consumer<HnCallHardwareOwner.Result> reply=result->{
+                if(state.pending!=submittedRevision)return;
+                state.pending=0;
+                if(result.outcome()==HnCallHardwareOwner.Outcome.UNKNOWN
+                        ||result.outcome()==HnCallHardwareOwner.Outcome.NATIVE_ERROR)
+                {
+                    state.uncertainToken=result.token();
+                    state.uncertainRevision=submittedRevision;state.uncertainTarget=submittedTarget;
+                }
+                if(!current(state))return;
+                Outcome outcome=switch(result.outcome()){
+                    case NATIVE_ACCEPTED->Outcome.NATIVE_ACCEPTED;
+                    case DEFERRED->Outcome.DEFERRED;
+                    case NATIVE_ERROR->Outcome.NATIVE_ERROR;
+                    default->Outcome.UNKNOWN;
+                };
+                if(outcome==Outcome.NATIVE_ACCEPTED) {
+                    state.acceptedRevision=submittedRevision;state.acceptedTarget=submittedTarget;
+                    state.observed=inputs.configured(state.scope.slot(),state.feature);
+                }
+                for(Aim aim:submitted)if(!aim.reported&&aim.vote.enabled()==submittedTarget) {
+                    if(outcome==Outcome.DEFERRED) {
+                        aim.deadline=0;
+                        if(!aim.deferredReported){aim.deferredReported=true;aim.reply.accept(new Receipt(outcome,0));}
+                    } else {
+                        aim.reported=true;aim.reply.accept(new Receipt(outcome,aim.deadline));
+                    }
+                }
+                if(outcome==Outcome.NATIVE_ACCEPTED)reviewAll();
+                // DEFERRED waits a real readiness event; UNKNOWN waits exact custody drain.
+            };
+            if(state.feature==Feature.VONR)
+                hardware.setVoNr(state.scope.slot(),target,epoch,reply);
+            else hardware.setWfc(state.scope.slot(),target,epoch,reply);
+        });
+    }
+
+    /** Read-only framework intent and retained configured properties, kept as separate facts. */
+    static Inputs sourceInputs(Context context) {
+        return new Inputs() {
+            public Boolean unvoted(Scope scope,Feature feature) {
+                if(!HonorSubscriberAdoption.isReady(scope.slot(),scope.subscriber()))return null;
+                try {
+                    if(feature==Feature.WFC) {
+                        ImsManager manager=ImsManager.getInstance(context,scope.slot());
+                        return manager.isWfcEnabledByPlatform()&&manager.isWfcEnabledByUser();
+                    }
+                    CarrierConfigManager manager=context.getSystemService(CarrierConfigManager.class);
+                    SubscriptionManagerService subscriptions=SubscriptionManagerService.getInstance();
+                    if(manager==null||subscriptions==null)return null;
+                    PersistableBundle config=manager.getConfigForSubId(scope.subscriber().subscription);
+                    if(config==null||!CarrierConfigManager.isConfigForIdentifiedCarrier(config))return null;
+                    var info=subscriptions.getSubscriptionInfoInternal(scope.subscriber().subscription);
+                    if(info==null)return null;
+                    int user=info.getNrAdvancedCallingEnabled();
+                    return config.getBoolean(CarrierConfigManager.KEY_VONR_ENABLED_BOOL)
+                            &&(user==1||user==-1&&config.getBoolean(
+                                    CarrierConfigManager.KEY_VONR_ON_BY_DEFAULT_BOOL));
+                }catch(IllegalStateException|SecurityException unavailable){return null;}
+            }
+            public Boolean configured(int slot,Feature feature) {
+                String raw=SystemProperties.get(feature==Feature.VONR
+                        ?"persist.vendor.mtk.vonr.enable":"persist.vendor.mtk.wfc.enable","");
+                String multi=SystemProperties.get("persist.vendor.mims_support","");
+                try {
+                    if(raw.isEmpty()||multi.isEmpty())return null;
+                    int value=Integer.parseInt(raw),mode=Integer.parseInt(multi);
+                    return ((value>>>(mode==1?0:slot))&1)!=0;
+                }catch(NumberFormatException unknown){return null;}
+            }
+            public void watch(Handler handler,Runnable intentChanged,Runnable configuredChanged) {
+                context.getContentResolver().registerContentObserver(SubscriptionManager.CONTENT_URI,
+                        true,new ContentObserver(handler) {
+                            @Override public void onChange(boolean self){intentChanged.run();}
+                        });
+                context.registerReceiver(new BroadcastReceiver(){
+                    @Override public void onReceive(Context ignored,Intent intent){intentChanged.run();}
+                },new IntentFilter(CarrierConfigManager.ACTION_CARRIER_CONFIG_CHANGED),null,handler);
+                SystemProperties.addChangeCallback(()->handler.post(configuredChanged));
+            }
+        };
+    }
+}
