+@@KNOWN_NO_GRANT@@
+   }catch(_:Throwable){}
+   else if(r.code<0)admission.unknownIfOwned(localOwner)
+   return when(mode){
+    "first-throw","primary-selection"->r.code==3&&r.controllers==1&&r.cancelled&&markedClean&&!admission.isUnknown()
+    "blank-async-failure","blank-timeout"->r.code==3&&r.controllers==1&&r.auxiliaryPending&&r.cancelled&&r.lateCannotGrant&&markedClean&&!admission.isUnknown()
