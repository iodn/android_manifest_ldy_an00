+package com.android.internal.telephony.honor;
+import java.util.function.Consumer;
+/** Sole owner is the boundary doubled for the actual SetupService command-8 dispatch tests. */
+public final class HonorSepTrialOwner {
+ public enum UiState {IDLE,WORKING,EUICC_WAITING,EUICC_READY,PHYSICAL_READY,KNOWN_BLANK,UNKNOWN}
+ public static final class UiSnapshot {
+  public final UiState state;public final boolean canReturnPhysical;public final int phaseSerial;
+  public UiSnapshot(UiState state,boolean canReturn,int phase){this.state=state;canReturnPhysical=canReturn;phaseSerial=phase;}
+ }
+ public enum RouteRefusal {STALE_CONFIRMATION,BUSY,CALL_BUSY,UNAVAILABLE}
+ public static Consumer<RouteRefusal> refusedRoute;public static boolean deferRoute,unclaimed;
+ public static Consumer<String> failedPreparation;
+ public static boolean knownPreparationRefusal(String value){return "NO_ADMISSION".equals(value)||value!=null&&value.startsWith("DEFERRED:");}
+ public static boolean unclaimedPreparation(){return unclaimed&&current==null;}
+ public static void failPreparation(String reason){if(knownPreparationRefusal(reason))unclaimed=true;failedPreparation.accept(reason);}
+ public static HonorSepTrialOwner current;public static int preparations,actuations;public static boolean debug;
+ public static Consumer<HonorSepTrialOwner> prepared;public static Runnable beforeSnapshot;
+ public static HonorSepTrialOwner retired;public static boolean reconnectClean;public static int reconnectChecks;
+ public static boolean deferSnapshot;public static Runnable delayedSnapshot;
+ public UiState state;public int phase;
+ public HonorSepTrialOwner(UiState state,int phase){this.state=state;this.phase=phase;}
+ public static void reset(){refusedRoute=null;deferRoute=false;unclaimed=true;failedPreparation=null;current=null;retired=null;reconnectClean=false;reconnectChecks=0;prepared=null;beforeSnapshot=null;deferSnapshot=false;delayedSnapshot=null;preparations=actuations=0;debug=true;}
+ public static HonorSepTrialOwner existingPreparedOwner(){return current;}
+ public static boolean hasLostOwner(){return retired!=null && current==null;}
+ public static void requestCleanReconnect(Consumer<HonorSepTrialOwner> reply){
+  reconnectChecks++;reply.accept(reconnectClean ? retired : null);
