+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.internal.telephony.honor;
+
+public final class SepMuxAdmissionTest {
+    private static int checks;
+    private static void check(boolean ok) { checks++;if(!ok)throw new AssertionError(); }
+    private static void refuse(Runnable action) {
+        try { action.run(); } catch(IllegalStateException expected) { checks++;return; }
+        throw new AssertionError("admission unexpectedly accepted");
+    }
+    private static SepMuxTrial.Evidence evidence(SepMuxAdmission admission,boolean enforcing,
+            int uid,String sid,int version,String hash,boolean absent,boolean exclusive,boolean clean) {
+        return new SepMuxTrial.Evidence(uid,sid,enforcing,version,hash,absent,exclusive,clean,admission);
+    }
+    private static void begin(SepMuxTrial.Evidence evidence) {
+        new SepMuxTrial().begin(evidence,1,77,SepMuxTrial.Selector.EUICC,
+                new SepMuxTrial.Baseline(1,9,true,true,false),100);
+    }
+    public static void main(String[] args) {
+        var strict=SepMuxAdmission.afterConsent("userdebug",true,false,false,true);
+        check(!strict.isTrustedDebug());strict.require(true);checks++;
+        refuse(()->SepMuxAdmission.afterConsent("userdebug",true,false,false,false));
+        refuse(()->SepMuxAdmission.afterConsent("user",true,true,true,false));
+        refuse(()->SepMuxAdmission.afterConsent("eng",true,true,true,false));
+        refuse(()->SepMuxAdmission.afterConsent("userdebug",false,true,true,false));
+        refuse(()->SepMuxAdmission.afterConsent("userdebug",true,false,true,false));
+        refuse(()->SepMuxAdmission.afterConsent("userdebug",true,true,false,false));
+        var test=SepMuxAdmission.afterConsent("userdebug",true,true,true,false);
+        check(test.isTrustedDebug());test.require(false);checks++;
+        begin(evidence(test,false,1001,"u:r:radio:s0",6,SepMuxTrial.VENDOR_HASH,true,true,true));checks++;
+        // Test consent does not replace caller, ABI, exclusive-owner or durable-history proof.
+        refuse(()->begin(evidence(test,false,0,"u:r:radio:s0",6,SepMuxTrial.VENDOR_HASH,true,true,true)));
+        refuse(()->begin(evidence(test,false,1001,"u:r:kernel:s0",6,SepMuxTrial.VENDOR_HASH,true,true,true)));
+        refuse(()->begin(evidence(test,false,1001,"u:r:radio:s0",5,SepMuxTrial.VENDOR_HASH,true,true,true)));
+        refuse(()->begin(evidence(test,false,1001,"u:r:radio:s0",6,"wrong",true,true,true)));
+        refuse(()->begin(evidence(test,false,1001,"u:r:radio:s0",6,SepMuxTrial.VENDOR_HASH,false,true,true)));
+        refuse(()->begin(evidence(test,false,1001,"u:r:radio:s0",6,SepMuxTrial.VENDOR_HASH,true,false,true)));
+        refuse(()->begin(evidence(test,false,1001,"u:r:radio:s0",6,SepMuxTrial.VENDOR_HASH,true,true,false)));
+        // Existing constructor remains strict; a previously observed mode change stays refused.
+        refuse(()->begin(new SepMuxTrial.Evidence(1001,"u:r:radio:s0",false,6,
+                SepMuxTrial.VENDOR_HASH,true,true,true)));
+        refuse(()->test.require(true));refuse(()->test.require(false));
+        refuse(()->strict.require(false));refuse(()->strict.require(true));
+        var enforcingTest=SepMuxAdmission.afterConsent("userdebug",true,true,true,true);
+        enforcingTest.require(true);checks++;refuse(()->enforcingTest.require(false));
