+    }
+    private HonorLpaChannelResult awaitChannel(LpaOperationLease.Scope scope,IBinder client,Channel channel,
+            java.util.concurrent.CompletableFuture<HonorLpaChannelResult> future) {
+        try {return future.get(65,TimeUnit.SECONDS);}
+        catch(Exception failure) {
+            lifecycle(channel==null ? Stage.OPEN : channel.actionStage).failed(failure);
+            if(failure instanceof InterruptedException) Thread.currentThread().interrupt();
+            UiccController.getInstance().post(()->{abandonExact(scope,client);if(channel!=null && channel.scoped!=null)channel.scoped.unknown();});
+            HonorLpaChannelResult result=new HonorLpaChannelResult();result.code=HonorScopedApduChannel.UNKNOWN;return result;
+        }
+    }
+    private void requireBinding(LpaOperationLease.Scope requested,IBinder client) {
+        if(binding==null || !binding.scope.same(requested) || binding.client!=client) {
+            lifecycle(Stage.TARGET).returned(Outcome.REFUSED_PRE_DISPATCH);
