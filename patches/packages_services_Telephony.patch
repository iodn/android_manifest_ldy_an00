@@ -0,0 +1,62 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.honor.ldy_an00.lease;
+
+import java.util.Objects;
+import java.util.function.Consumer;
+import java.util.function.LongSupplier;
+
+/** Fixed vocabulary only: no identifiers, exception messages, stack traces or APDU payloads. */
+public final class HonorLpaResetTrace {
+    public enum Side { PHONE, LPA }
+    public enum Phase {
+        ADMISSION, ROUTE_PROOF, CAPTURE_CHANNEL, WAIT_RECLAMATION, RECLAMATION_RESULT,
+        PREPARE_RPC, PREPARE_VALIDATION, JNI_INVALIDATION, LOCAL_DRAIN,
+        RESET_RECONCILIATION, RECONCILIATION_VALIDATION
+    }
+    private final Side side;
+    private final LongSupplier elapsed;
+    private final Consumer<String> sink;
+    private final long started;
+    private Phase phase = Phase.ADMISSION;
+
+    public HonorLpaResetTrace(Side side, LongSupplier elapsed, Consumer<String> sink) {
+        this.side = Objects.requireNonNull(side);
+        this.elapsed = Objects.requireNonNull(elapsed);
+        this.sink = Objects.requireNonNull(sink);
+        started = elapsed.getAsLong();
+    }
+
+    public synchronized void enter(Phase next) {
+        phase = Objects.requireNonNull(next);
+        emit(next, "BEGIN");
+    }
+    public synchronized void returned() { emit(phase, "RETURN"); }
+    public synchronized void returned(int code) { returned(phase, code); }
+    public synchronized void returned(Phase at, int code) {
+        emit(at, "RETURN result=" + (code >= -1 && code <= 6 ? code : "OTHER"));
+    }
+    public synchronized void failed(Throwable failure) { failed(phase, failure); }
+    public synchronized void failed(Phase at, Throwable failure) {
+        String kind = "OTHER";
+        if (failure instanceof SecurityException) kind = "SECURITY";
+        else if (failure instanceof java.util.concurrent.CancellationException) kind = "CANCELLED";
+        else if (failure instanceof IllegalStateException) kind = "STATE";
+        else if (failure instanceof IllegalArgumentException) kind = "ARGUMENT";
+        else if (failure instanceof java.util.concurrent.TimeoutException) kind = "TIMEOUT";
+        else if (failure instanceof InterruptedException) kind = "INTERRUPTED";
+        else if (failure instanceof java.io.IOException) kind = "IO";
+        else if (failure != null && (failure.getClass().getName().equals("android.os.RemoteException")
+                || failure.getClass().getName().equals("android.os.DeadObjectException"))) kind = "REMOTE";
+        emit(at, "FAIL kind=" + kind);
+    }
+    private void emit(Phase at, String event) {
+        String line = "side=" + side + " phase=" + at + " event=" + event
+                + " elapsedMs=" + Math.max(0, elapsed.getAsLong() - started);
+        try { sink.accept(line); } catch (RuntimeException loggingUnavailable) {
+            // Diagnostics cannot change lease, native-operation or exception behavior.
+        }
+    }
+}
