+package com.android.internal.telephony.honor;
+/** Actual journal/endpoint/lease/query/model objects; synthetic clock/transport only. */
+public final class RepeatedCycleStateHostTest {
+ static int checks;
+ static void ok(boolean b){checks++;if(!b)throw new AssertionError("check "+checks);}
+ static void denied(Runnable r){try{r.run();throw new AssertionError();}catch(IllegalStateException expected){checks++;}}
+ static final class Store implements SepMuxJournal.Store {String record;boolean fail;public String read(){return record;}public void writeDurably(String s)throws java.io.IOException{if(fail)throw new java.io.IOException();record=s;}}
+ static SepMuxTrial.Evidence facts(){return new SepMuxTrial.Evidence(1001,"u:r:radio:s0",true,6,SepMuxTrial.VENDOR_HASH,true,true,true);}
+ public static void main(String[]args)throws Exception {
+  Store store=new Store();SepMuxJournal journal=new SepMuxJournal(store);EndpointPublication endpoints=new EndpointPublication();
+  int serial=1,query=1;
+  for(int cycle=0;cycle<3;cycle++){
+   SharedSlotRouteTrial model=new SharedSlotRouteTrial();Object adapter=new Object();
+   var ticket=endpoints.admit();ok(endpoints.hasPendingAdmission());ok(!endpoints.completedCurrent());
+   int outbound=serial++;endpoints.bind(ticket,adapter,1,outbound);
+   model.beginEuicc(facts(),outbound,new SepMuxTrial.Baseline(1,1,true,true,false),100);
+   journal.pending(1,outbound,SepMuxTrial.Selector.EUICC);model.markDispatched(101);
+   model.response(1,outbound,1005,0,0,102);model.completion(1,1002,new int[]{1,0},103);
+   var read=model.queryRoute(query++,104);ok(model.hasPendingQueries());
+   model.routeResponse(read,1,read.serial,0,0,1,1,0,105);ok(!model.hasPendingQueries());
+   journal.completedRoutePhase(1,outbound,model);
+   var epoch=endpoints.completed(ticket,adapter,1,outbound,SepMuxTrial.Selector.EUICC);ok(epoch!=null);
+   ok(endpoints.completedCurrent());ok(!endpoints.hasPendingAdmission());
+   var physical=endpoints.admit();ok(physical.retired==epoch);
+   int back=serial++;endpoints.bind(physical,adapter,1,back);
+   var baseline=model.beginPhysicalReturn(facts(),1,back,query++,200);
+   model.routeResponse(baseline,1,baseline.serial,0,0,1,1,0,201);
+   model.command(202);journal.pending(1,back,SepMuxTrial.Selector.PHYSICAL);model.markDispatched(203);
+   model.response(1,back,1005,0,0,204);model.completion(1,1002,new int[]{1,0},205);
+   var route=model.queryRoute(query++,206);var card=model.queryPhysicalCard(207);
+   if(cycle%2==0) {
+    model.physicalCardStatus(card,1,true,true,false,1,true,208);
+    denied(()->model.queryPhysicalCard(208)); // Real ICC refresh cannot create redundant STATUS2.
+    ok(model.hasPendingQueries()); // Actual mode0 GET is still pending.
+    model.routeResponse(route,1,route.serial,0,0,1,0,0,209);
+   } else {
+    model.routeResponse(route,1,route.serial,0,0,1,0,0,208);ok(model.hasPendingQueries());ok(!model.phaseComplete());
+    model.physicalCardStatus(card,1,true,true,false,1,true,209);
+   }
+   ok(!model.hasPendingQueries());
+   journal.completedRoutePhase(1,back,model);endpoints.completed(physical,adapter,1,back,SepMuxTrial.Selector.PHYSICAL);
+   ok(endpoints.completedCurrent());ok(journal.cleanRoute().target==SepMuxTrial.Selector.PHYSICAL);
+   // Defensive exact-terminal receipt bookkeeping, with an injected already-issued token.
+   var pendingField=SharedSlotRouteTrial.class.getDeclaredField("cardToken");pendingField.setAccessible(true);pendingField.set(model,card);
+   ok(model.hasPendingQueries());model.physicalCardStatus(card,1,false,false,true,0,false,210);
+   ok(!model.hasPendingQueries());ok(model.state()==SharedSlotRouteTrial.State.PHYSICAL_RESTORED);
+   ok(journal.firstUnusedSerial()==serial);ok(endpoints.completed(ticket,adapter,1,outbound,SepMuxTrial.Selector.EUICC)==null);
+   // Previous ticket cannot republish readiness after this cycle or complete the next admission.
+   var fresh=new MtkSimTypeQuery(1,query++,1000);
+   fresh.onResponse(1,fresh.mode(),0,0,1,0,0,300);ok(fresh.state()==MtkSimTypeQuery.State.WAITING);
+   fresh.onResponse(1,query-1,0,0,1,0,0,301);ok(fresh.state()==MtkSimTypeQuery.State.PHYSICAL);
+  }
+  Store leases=new Store();var lease=new LpaOperationLease(leases);lease.requireCycleQuiescent();checks++;
+  var scope=new LpaOperationLease.Scope("00000000000000000000000000000001",10055,0,1,1,0,7,2,10);Object owner=new Object(),endpoint=new Object();
+  lease.acquire(scope,owner,endpoint,0,100);denied(lease::requireCycleQuiescent);
+  ok(lease.beginNative(scope,owner,endpoint,1,true));denied(lease::requireCycleQuiescent);
+  ok(lease.nativeReturned(scope,owner,null,2,true));denied(lease::requireCycleQuiescent);
+  ok(lease.rebindKnownReset(scope,owner,new Object(),3,true,true));denied(lease::requireCycleQuiescent);
+  lease.ownerLost();denied(lease::requireCycleQuiescent);
+  Store clean=new Store();var lost=new EndpointPublication();lost.lose();denied(lost::admit);
+  Store fail=new Store();fail.fail=true;var broken=new SepMuxJournal(fail);
+  try{broken.pending(1,serial,SepMuxTrial.Selector.EUICC);throw new AssertionError();}catch(java.io.IOException expected){checks++;}
+  try{broken.requireClean();throw new AssertionError();}catch(java.io.IOException expected){checks++;}
+  System.out.println("PASS "+checks+" actual repeated-cycle state/lease/journal/endpoint checks; no Binder/modem claim");
+ }
