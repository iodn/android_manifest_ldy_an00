+  boolean allowed(Object channel,boolean close)throws Exception {return (boolean)call(binding,"channelActionAllowed",new Class<?>[]{C,boolean.class},channel,close);}
+  boolean rebind(boolean closed,long now)throws Exception {return (boolean)call(binding,"rebindKnownReset",new Class<?>[]{LpaOperationLease.class,LpaOperationLease.Scope.class,IBinder.class,EuiccReadiness.Epoch.class,long.class,boolean.class},lease,scope,client,replacement,now,closed);}
+  void oldClosed()throws Exception {field(C,"closed").setBoolean(oldChannel,true);}
+  boolean requestHeld()throws Exception{return field(B,"reclamationRequest").get(binding)!=null;}
+ }
+ public static void main(String[] args)throws Exception {
+  Fixture f=new Fixture();check(!f.allowed(f.newChannel,false));check(f.allowed(f.oldChannel,true));
+  field(B,"preparingReclamation").setBoolean(f.binding,true);check(!f.allowed(f.oldChannel,true));
+  field(B,"preparingReclamation").setBoolean(f.binding,false);
+  check(!f.rebind(true,13));check(f.requestHeld());check(!f.allowed(f.newChannel,false));
+  f.oldClosed();check(!f.rebind(false,14));check(f.requestHeld());check(!f.allowed(f.newChannel,false));
+  check(f.rebind(true,15));check(!f.requestHeld());check(field(B,"reclaimedChannel").get(f.binding)==null);check(!f.step.get());
+  check(f.lease.check(f.scope,f.client,f.replacement,16));check(f.lease.channelAccess(f.scope,f.client,16));
+  check(f.allowed(f.newChannel,false));check(!f.allowed(f.oldChannel,false));check(f.allowed(f.oldChannel,true));
+  check(!f.rebind(true,17));check(f.allowed(f.newChannel,false));
+  f=new Fixture();f.oldClosed();f.lease.abandon(f.scope,f.client);check(!f.rebind(true,14));
+  check(f.requestHeld());check(!f.allowed(f.newChannel,false));check(!f.lease.channelAccess(f.scope,f.client,15));
+  f=new Fixture();f.oldClosed();check(!f.rebind(true,2000));check(f.requestHeld());check(f.lease.state()==LpaOperationLease.State.UNKNOWN);
+  f=new Fixture();f.oldClosed();check(f.lease.completeKnownBlank(f.scope,f.client,13,true,true,true));
+  call(f.binding,"resetCompleted",new Class<?>[0]);check(!f.requestHeld());check(!f.step.get());check(f.lease.isKnownBlank());
