--- /dev/null
+++ b/src/com/android/internal/telephony/honor/HonorCallQosPolicy.java
@@ -0,0 +1,62 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.internal.telephony.honor;
+
+import java.util.Locale;
+import java.util.Objects;
+
+/** Stock Collie service-2 call policy. This class neither owns a call table nor sends requests. */
+public final class HonorCallQosPolicy {
+    public enum Status { STARTING, ALERTING, WAITING, CONNECT, HOLD, DISCONNECTING, DISCONNECTED }
+    public enum Domain { INVALID, VOWIFI, CS, VOLTE, VONR, VODATA }
+    public enum Decision { UNCHANGED, START, STOP }
+
+    // Local requested-vote dedup only. A new instance proves nothing about CP state.
+    // The owner must qualify a new epoch and explicitly reconcile a verified idle baseline.
+    private final boolean[] started = new boolean[2];
+
+    public static boolean supportsPlatform(String platform) {
+        if (platform == null) return false;
+        switch (platform.toLowerCase(Locale.ROOT)) {
+            case "sun": case "canoe": case "mt6993": case "mt6899": return true;
+            default: return false;
+        }
+    }
+
+    /**
+     * Evaluate the changed call against the complete stock-equivalent slot table count.
+     * Count includes disconnected calls pending SIP reconciliation/removal. The caller must
+     * supply framework HOLD explicitly: the reviewed MTK status map has no HOLD value.
+     * INVALID domain intentionally follows stock's exclusion of only VOWIFI and CS.
+     */
+    public Decision onCallChanged(int slot, int callCount, boolean emergency,
+            Domain domain, Status status) {
+        checkSlot(slot);
+        if (callCount < 0) throw new IllegalArgumentException("Negative call count");
+        Objects.requireNonNull(domain);
+        if (callCount != 1 || emergency || domain == Domain.VOWIFI || domain == Domain.CS
+                || status == null || status == Status.HOLD || status == Status.DISCONNECTED
+                || status == Status.DISCONNECTING) {
+            return update(slot, false);
+        }
+        return status == Status.CONNECT ? update(slot, true) : Decision.UNCHANGED;
+    }
+
+    /** Stop only this policy's service-2 vote, for owner shutdown or complete table reset. */
+    public Decision stop(int slot) {
+        checkSlot(slot);
+        return update(slot, false);
+    }
+
+    private Decision update(int slot, boolean start) {
+        if (started[slot] == start) return Decision.UNCHANGED;
+        started[slot] = start;
+        return start ? Decision.START : Decision.STOP;
+    }
+
+    private static void checkSlot(int slot) {
+        if (slot < 0 || slot >= 2) throw new IllegalArgumentException("Invalid logical slot");
+    }
+}
diff --git a/src/com/android/internal/telephony/honor/HonorCallQosSnapshot.java b/src/com/android/internal/telephony/honor/HonorCallQosSnapshot.java
new file mode 100644
index 0000000000000000000000000000000000000000..10aba20e6a92704783f4c6c9308cabf50aaae854
--- /dev/null
+++ b/src/com/android/internal/telephony/honor/HonorCallQosSnapshot.java
@@ -0,0 +1,436 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.internal.telephony.honor;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.TreeMap;
+import java.util.function.Consumer;
+import static com.android.internal.telephony.honor.HonorCallQosPolicy.Domain;
+import static com.android.internal.telephony.honor.HonorCallQosPolicy.Status;
+
+/**
+ * Event-driven projection of stock CallQoe fields used by service-2 call QoS.
+ * Single owner thread. No Binder, clock, persistence, diagnostic SIP storage or modem requests.
+ * The owner schedules nextRemovalTime() once; expire() is not a polling loop.
+ */
+public final class HonorCallQosSnapshot {
+    public static final class Change {
+        public final int slot, callCount, callId;
+        public final boolean emergency;
+        public final Domain domain;
+        public final Status status;
+
+        private Change(int slot, int count, Call call) {
+            this.slot = slot;
+            callCount = count;
+            callId = call.id;
+            emergency = call.emergency;
+            domain = call.domain == null ? Domain.INVALID : call.domain;
+            status = call.status;
+        }
+    }
+
+    private static final class Call {
+        int id, direction;
+        String sipId;
+        Domain domain;
+        Status status = Status.STARTING;
+        boolean emergency, alerted, connected, disconnected, sipDisconnected;
+        long removal = Long.MAX_VALUE;
+        long createdSequence, incarnation, disconnectedWallClock;
+        boolean epsfb, completionQualified, qosRetired;
+        HonorCompletedCallQoe qoe;
+        HonorCompletedCallQoe.Epoch evidenceEpoch;
+        HonorCompletedCallQoe.Domain switchDomain;
+
+        Call(int id, int direction, long sequence) {
+            createdSequence = sequence;
+            this.id = id;
+            this.direction = direction;
+        }
+    }
+
+    private final int slot;
+    // One authoritative collection, keyed by source incarnation rather than recyclable native ID.
+    // A terminal predecessor can keep its existing SIP wait while the same ID starts a new call.
+    private final TreeMap<Long, Call> calls = new TreeMap<>();
+    private final long binding, profile;
+    private final Consumer<HonorCompletedCallQoe.Result> completed;
+    private long nextIncarnation = 1;
+    private boolean newCallQualified = true;
+    private final List<HonorCompletedCallQoe.Domain> handoffs = new ArrayList<>();
+
+    public HonorCallQosSnapshot(int slot) {
+        this(slot, 0, 0, null);
+    }
+
+    HonorCallQosSnapshot(int slot, long binding, long profile,
+            Consumer<HonorCompletedCallQoe.Result> completed) {
+        if (slot < 0 || slot >= 2) throw new IllegalArgumentException("Invalid logical slot");
+        this.slot = slot;
+        this.binding = binding;
+        this.profile = profile;
+        this.completed = completed;
+    }
+
+    public List<Change> accept(HonorMtkCallInfoDecoder.CallUpdate update, long now) {
+        return accept(update, now, 0);
+    }
+
+    public List<Change> accept(HonorMtkCallInfoDecoder.CallUpdate update, long now, long sequence) {
+        return accept(update, now, sequence, 0);
+    }
+
+    List<Change> accept(HonorMtkCallInfoDecoder.CallUpdate update, long now, long sequence,
+            long wallClockMillis) {
+        List<Change> changes = new ArrayList<>();
+        if (update == null || update.slot != slot || update.callId < 0) return changes;
+        Call call = findById(update.callId);
+        boolean create = (update.direction == 0 || update.direction == 1)
+                && (update.status == Status.STARTING || update.status == Status.WAITING);
+        if (create) {
+            if (call != null && (call.disconnected || update.status != Status.WAITING
+                    && (call.direction != update.direction || call.connected))) {
+                if (!call.disconnected) discard(call);
+                // A terminal incarnation remains until its own existing SIP/deadline completion.
+                call = null;
+            }
+            if (call == null) {
+                Call provisional = findById(0);
+                if (provisional != null && provisional.direction == update.direction
+                        && !provisional.connected && !provisional.disconnected) {
+                    provisional.id = update.callId;
+                    call = provisional;
+                } else {
+                    if (provisional != null && provisional.direction == update.direction) {
+                        if (!provisional.disconnected) discard(provisional);
+                    }
+                    call = create(update.callId, update.direction, sequence);
+                }
+            }
+        }
+        if (call == null) return changes;
+        if (call.qoe != null) {
+            HonorCompletedCallQoe.Domain handoff = handoff(call.domain, update.domain);
+            if (handoff != null) handoffs.add(handoff);
+            call.qoe.nativeUpdate(call.evidenceEpoch, sequence, update);
+        }
+        applyDomain(call, update.domain);
+        applyStatus(call, update.status);
+        if (update.status == Status.DISCONNECTED) call.disconnectedWallClock = wallClockMillis;
+        call.emergency |= update.emergency;
+        // Stock compares newly allocated non-null Optional status wrappers by identity.
+        // Every bound update is observable, including an emergency-only change.
+        add(call, changes);
+        if (call.disconnected && call.removal == Long.MAX_VALUE) {
+            if (call.sipDisconnected) remove(call, changes);
+            else call.removal = deadline(now);
+        }
+        return changes;
+    }
+
+    public List<Change> accept(HonorMtkSipDecoder.SipUpdate update, long now) {
+        return accept(update, now, 0);
+    }
+
+    public List<Change> accept(HonorMtkSipDecoder.SipUpdate update, long now, long sequence) {
+        return acceptSip(update, null, now, sequence, 0);
+    }
+
+    List<Change> accept(HonorCompletedSipDecoder.Update update, long now, long sequence,
+            long wallClockMillis) {
+        return update == null ? new ArrayList<>()
+                : acceptSip(update.shared(), update, now, sequence, wallClockMillis);
+    }
+
+    private List<Change> acceptSip(HonorMtkSipDecoder.SipUpdate update,
+            HonorCompletedSipDecoder.Update functional, long now, long sequence,
+            long wallClockMillis) {
+        List<Change> changes = new ArrayList<>();
+        if (update == null || update.slot != slot || update.sipCallId.isEmpty()) return changes;
+        Call call = null;
+        List<Call> matched = new ArrayList<>();
+        for (Call candidate : calls.values()) {
+            if (candidate.sipId != null && candidate.sipId.contains(update.sipCallId)
+                    && (!update.initialInvite || !candidate.disconnected)) matched.add(candidate);
+        }
+        if (matched.size() > 1) {
+            for (Call candidate : matched) {
+                if (candidate.qoe != null) {
+                    candidate.qoe.ambiguousSip(candidate.evidenceEpoch, sequence);
+                }
+            }
+            return changes; // Neither arbitrary error attribution nor a false normal reset.
+        }
+        if (matched.size() == 1) call = matched.get(0);
+        if (call != null && update.initialInvite) call.sipDisconnected = false;
+        if (call == null && update.initialInvite) {
+            int direction = update.direction == 0 ? 0 : 1;
+            for (Call candidate : calls.values()) {
+                // A completed prior call awaiting its removal timer cannot consume
+                // a fresh next-call INVITE before a delayed framework IDLE.
+                if (candidate.sipId == null && !candidate.disconnected) {
+                    call = candidate;
+                    break;
+                }
+            }
+            boolean hadUnboundCall = call != null;
+            if (call != null && ((call.status != Status.STARTING && call.status != Status.ALERTING)
+                    || call.direction != direction)) {
+                discard(call);
+                call = null;
+            }
+            if (call == null && !hadUnboundCall && direction == 0) {
+                for (Call candidate : calls.values()) {
+                    if (candidate.direction == 0 && candidate.sipId != null && candidate.id != 0
+                            && !candidate.connected && !candidate.disconnected) {
+                        call = candidate;
+                        call.sipDisconnected = false;
+                        break;
+                    }
+                }
+            }
+            if (call == null) {
+                call = create(0, direction, sequence);
+            }
+            call.sipId = update.sipCallId;
+        }
+        if (call == null) return changes;
+        if (functional != null && call.qoe != null) {
+            call.qoe.sipUpdate(call.evidenceEpoch, sequence, wallClockMillis, functional);
+        }
+        applyDomain(call, update.domain);
+        if (update.type == 1 && update.code == 180 && update.direction == 0) {
+            applyStatus(call, Status.ALERTING);
+        } else if ((update.type == 1 && update.code > 299 && update.code < 700)
+                || update.type == 4) {
+            if (call.direction == 1 && !call.alerted) {
+                applyStatus(call, Status.DISCONNECTED);
+                call.disconnectedWallClock = wallClockMillis;
+            }
+        }
+        boolean end = (call.connected && update.type == 7)
+                || (!call.connected && (update.type == 4
+                || (update.type == 1 && update.code > 299 && update.code != 491)));
+        if (end) call.sipDisconnected = true;
+        // Stock compares newly allocated non-null Optional status wrappers by identity.
+        // Every bound update is observable, including an emergency-only change.
+        add(call, changes);
+        if (call.disconnected && (call.id == 0
+                || (end && call.removal != Long.MAX_VALUE))) remove(call, changes);
+        return changes;
+    }
+
+    /**
+     * Removal only, called by the owner's scheduled timer. Unlike stock's Handler
+     * what > 100 check, expire normalized ID0 too: native DISCONNECTED can schedule
+     * that ID's 1000ms deadline, and retaining it forever would poison call counts.
+     */
+    public List<Change> expire(long now) {
+        List<Change> changes = new ArrayList<>();
+        List<Call> expired = new ArrayList<>();
+        for (Call call : calls.values()) {
+            if (call.removal <= now) expired.add(call);
+        }
+        for (Call call : expired) remove(call, changes);
+        return changes;
+    }
+
+    /** Current reconciled call projection, for a newly published qualified owner. */
+    public List<Change> current() {
+        List<Change> changes = new ArrayList<>();
+        for (Call call : calls.values()) add(call, changes);
+        return changes;
+    }
+
+    /**
+     * A delayed framework IDLE can follow a fresh native/SIP setup for the next call.
+     * Preserve nonterminal next-call entries created after a proven prior terminal event,
+     * including a next call already connected before the delayed framework notification.
+     * No native session-ID uniqueness or time delay is assumed.
+     */
+    public void retireCompletedCycle(long terminalSequence) {
+        List<Call> obsolete = new ArrayList<>();
+        for (Call call : calls.values()) {
+            if (call.disconnected && call.removal != Long.MAX_VALUE) {
+                call.qosRetired = true; // Keep evidence, not the prior cycle's QoS/count view.
+                continue;
+            }
+            if (terminalSequence > 0 && call.createdSequence > terminalSequence) {
+                call.completionQualified = true; // Fresh setup after a proven prior terminal.
+            }
+            if (terminalSequence <= 0 || call.disconnected
+                    || call.createdSequence <= terminalSequence) obsolete.add(call);
+        }
+        for (Call call : obsolete) discard(call);
+    }
+
+    public boolean isFreshCycleCall(int callId, long terminalSequence) {
+        Call call = findById(callId);
+        return call != null && call.createdSequence > terminalSequence;
+    }
+
+    public boolean isFreshCycleSip(String sipId, long terminalSequence) {
+        for (Call call : calls.values()) {
+            if (call.createdSequence > terminalSequence && call.sipId != null
+                    && call.sipId.contains(sipId)) return true;
+        }
+        return false;
+    }
+
+    public long nextRemovalTime() {
+        long next = Long.MAX_VALUE;
+        for (Call call : calls.values()) next = Math.min(next, call.removal);
+        return next;
+    }
+
+    boolean hasAmbiguousSip(String sipId) {
+        int matches = 0;
+        for (Call call : calls.values()) {
+            if (call.sipId != null && call.sipId.contains(sipId) && ++matches > 1) return true;
+        }
+        return false;
+    }
+
+    /** Only a uniquely bound terminal SIP can cross a delayed logical-cycle barrier. */
+    boolean isPendingTerminalSip(String sipId) {
+        Call matched = null;
+        for (Call call : calls.values()) {
+            if (call.sipId != null && call.sipId.contains(sipId)) {
+                if (matched != null) return false;
+                matched = call;
+            }
+        }
+        return matched != null && matched.disconnected
+                && matched.removal != Long.MAX_VALUE;
+    }
+
+    /** Drain derived handoffs into the existing owner Handler, preserving stock message2000 order. */
+    List<HonorCompletedCallQoe.Domain> takeHandoffs() {
+        List<HonorCompletedCallQoe.Domain> result = new ArrayList<>(handoffs);
+        handoffs.clear();
+        return result;
+    }
+
+    void applyHandoff(HonorCompletedCallQoe.Domain domain) {
+        for (Call call : calls.values()) {
+            if (call.qosRetired || findById(call.id) != call) continue;
+            if (call.status == Status.STARTING && domain == HonorCompletedCallQoe.Domain.N2L) {
+                call.epsfb = true;
+            } else {
+                call.switchDomain = domain;
+            }
+        }
+    }
+
+    void accept(HonorMtkCallEndDecoder.Report update, long sequence) {
+        if (update == null || update.slot() != slot) return;
+        List<Call> terminals = new ArrayList<>();
+        for (Call call : calls.values()) if (call.disconnected) terminals.add(call);
+        for (Call call : terminals) {
+            if (call.qoe != null) call.qoe.supplementaryEndCause(call.evidenceEpoch, sequence,
+                    terminals.size() == 1 ? update.cause() : null,
+                    terminals.size() == 1 && update.known());
+        }
+    }
+
+    /** Applies only to new incarnations; a partial pre-registration call is never upgraded. */
+    void setNewCallQualified(boolean qualified) {
+        newCallQualified = qualified;
+    }
+
+    public void clear() {
+        for (Call call : new ArrayList<>(calls.values())) discard(call);
+        handoffs.clear();
+    }
+
+    private Call create(int id, int direction, long sequence) {
+        Call call = new Call(id, direction, sequence);
+        call.incarnation = nextIncarnation++;
+        call.completionQualified = newCallQualified;
+        if (completed != null && binding > 0 && profile > 0) {
+            call.evidenceEpoch = new HonorCompletedCallQoe.Epoch(
+                    slot, binding, profile, call.incarnation);
+            call.qoe = new HonorCompletedCallQoe(call.evidenceEpoch);
+        }
+        calls.put(call.incarnation, call);
+        return call;
+    }
+
+    private Call findById(int id) {
+        Call found = null;
+        for (Call call : calls.values()) if (call.id == id) found = call;
+        return found;
+    }
+
+    private void discard(Call call) {
+        calls.remove(call.incarnation);
+        if (call.qoe != null) call.qoe.retire();
+    }
+
+    private void remove(Call call, List<Change> changes) {
+        if (!calls.containsKey(call.incarnation)) return;
+        if (call.disconnected && call.qoe != null && completed != null) {
+            HonorCompletedCallQoe.Domain domain = call.domain == null ? null
+                    : HonorCompletedCallQoe.Domain.valueOf(call.domain.name());
+            HonorCompletedCallQoe.Result result = call.qoe.complete(
+                    new HonorCompletedCallQoe.Facts(call.evidenceEpoch,
+                            call.direction == 0 ? HonorCompletedCallQoe.Direction.MO
+                                    : HonorCompletedCallQoe.Direction.MT,
+                            domain, call.switchDomain, call.epsfb,
+                            call.connected ? HonorCompletedCallQoe.Stage.CONNECTED
+                                    : call.alerted ? HonorCompletedCallQoe.Stage.ALERTING
+                                            : HonorCompletedCallQoe.Stage.STARTING,
+                            call.emergency, call.disconnectedWallClock,
+                            call.completionQualified));
+            if (result != null) completed.accept(result);
+        }
+        discard(call);
+        for (Call remaining : calls.values()) add(remaining, changes);
+    }
+
+    private void add(Call call, List<Change> changes) {
+        // Preserve the stock ID-indexed QoS view while an overwritten terminal
+        // incarnation retains only its independently necessary completion evidence.
+        if (call.qosRetired || findById(call.id) != call) return;
+        java.util.Set<Integer> ids = new java.util.HashSet<>();
+        for (Call current : calls.values()) if (!current.qosRetired) ids.add(current.id);
+        changes.add(new Change(slot, ids.size(), call));
+    }
+
+    private static HonorCompletedCallQoe.Domain handoff(Domain old, Domain next) {
+        if (old == Domain.VONR && next == Domain.VOLTE) return HonorCompletedCallQoe.Domain.N2L;
+        if (old == Domain.VOLTE && next == Domain.VONR) return HonorCompletedCallQoe.Domain.L2N;
+        if (old == Domain.VONR && next == Domain.VOWIFI) return HonorCompletedCallQoe.Domain.N2W;
+        if (old == Domain.VOWIFI && next == Domain.VONR) return HonorCompletedCallQoe.Domain.W2N;
+        if (old == Domain.VOLTE && next == Domain.VOWIFI) return HonorCompletedCallQoe.Domain.L2W;
+        if (old == Domain.VOWIFI && next == Domain.VOLTE) return HonorCompletedCallQoe.Domain.W2L;
+        return null;
+    }
+
+    private static void applyDomain(Call call, Domain domain) {
+        if (domain != null && domain != Domain.INVALID) {
+            if (call.domain == Domain.VONR && domain == Domain.VOLTE
+                    && !call.alerted && !call.connected) call.epsfb = true;
+            call.domain = domain;
+        }
+    }
+
+    private static void applyStatus(Call call, Status status) {
+        if (status == null || status == Status.STARTING || status == Status.WAITING) return;
+        if (status == Status.ALERTING) call.alerted = true;
+        if (status == Status.CONNECT) {
+            call.alerted = true;
+            call.connected = true;
+        }
+        if (status == Status.DISCONNECTED) call.disconnected = true;
+        call.status = status;
+    }
+
+    private static long deadline(long now) {
+        return now > Long.MAX_VALUE - 1000 ? Long.MAX_VALUE : now + 1000;
+    }
+}
diff --git a/src/com/android/internal/telephony/honor/HonorCommRequests.java b/src/com/android/internal/telephony/honor/HonorCommRequests.java
new file mode 100644
index 0000000000000000000000000000000000000000..0ce1e76cf9e4f33764305ca6284d69f48660f116
--- /dev/null
+++ b/src/com/android/internal/telephony/honor/HonorCommRequests.java
@@ -0,0 +1,84 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.internal.telephony.honor;
+
+import java.util.HashMap;
+import java.util.Map;
+
+/** Shared slot serial history and exact comm/method correlation. Single broker lock. */
+final class HonorCommRequests {
+    static final int MAX_PENDING = 128;
+    static final class Pending {
+        final int serial, message;
+        final long binding;
+        final Object owner;
+        boolean sent, retired, finalSeen, acked, blocking;
+        Pending(int serial, int message, long binding, Object owner) {
+            this.serial=serial;this.message=message;this.binding=binding;this.owner=owner;
+        }
+    }
+    static final class Receipt {
+        final Pending request;
+        final boolean ack, terminal, deliver, matched;
+        Receipt(Pending p, boolean ack, boolean terminal, boolean deliver, boolean matched) {
+            request=p;this.ack=ack;this.terminal=terminal;this.deliver=deliver;this.matched=matched;
+        }
+    }
+    private int next;
+    private final java.util.concurrent.atomic.AtomicInteger blocking=new java.util.concurrent.atomic.AtomicInteger();
+    boolean quiescent(){return blocking.get()==0;}
+    private void settled(Pending p) {
+        if(p.blocking){p.blocking=false;blocking.decrementAndGet();}
+    }
+    private final Map<Integer,Pending> pending=new HashMap<>();
+    HonorCommRequests(int first) {
+        if(first<=0)throw new IllegalArgumentException("Invalid serial seed");
+        next=first;
+    }
+    synchronized int allocate(int floor) {
+        next=SepOwnerReconnect.carrySerial(floor,next);
+        if(next==Integer.MAX_VALUE)throw new IllegalStateException("Honor serial exhausted");
+        return next++;
+    }
+    synchronized Pending begin(int serial,int message,long binding,Object owner) {
+        if(serial<=0 || serial>=next || owner==null || binding<=0
+                || (message!=101 && message!=1005) || pending.size()>=MAX_PENDING
+                || pending.containsKey(serial))throw new IllegalStateException("Unowned comm request");
+        Pending p=new Pending(serial,message,binding,owner);
+        if(message==101){p.blocking=true;blocking.incrementAndGet();}
+        pending.put(serial,p);return p;
+    }
+    synchronized Receipt peek(int serial) {
+        return new Receipt(pending.get(serial),false,false,false,false);
+    }
+    synchronized void retire(Object owner) {
+        for(Pending p:pending.values())if(p.owner==owner)p.retired=true;
+    }
+    synchronized void retireBinding(long binding) {
+        for(Pending p:pending.values())if(p.binding==binding)p.retired=true;
+    }
+    synchronized void cancelBeforeSend(Pending p) {
+        if(p!=null && !p.sent && pending.get(p.serial)==p){pending.remove(p.serial);settled(p);}
+    }
+    synchronized void timeout(Pending p) {
+        if(p!=null && pending.get(p.serial)==p)p.retired=true; // Retain for one late terminal ACK.
+    }
+    synchronized Receipt response(int serial,int type,boolean comm,int message,long binding) {
+        Pending p=pending.get(serial);
+        if(p==null)return new Receipt(null,false,false,false,false);
+        if(type==1)return new Receipt(p,false,false,false,comm && message==p.message);
+        if(type!=0 && type!=2)return new Receipt(p,false,false,false,false);
+        boolean ack=type==2 && !p.acked;
+        if(ack)p.acked=true;
+        boolean matched=comm && message==p.message;
+        if(!matched || p.binding!=binding) {
+            p.retired=true;
+            boolean first=!p.finalSeen;p.finalSeen=true;
+            return new Receipt(p,ack,first,false,matched);
+        }
+        pending.remove(serial);p.finalSeen=true;settled(p);
+        return new Receipt(p,ack,true,!p.retired,matched);
+    }
+}
diff --git a/src/com/android/internal/telephony/honor/HonorCompletedCallQoe.java b/src/com/android/internal/telephony/honor/HonorCompletedCallQoe.java
new file mode 100644
index 0000000000000000000000000000000000000000..ec8cad57401b3244a4506947c9fc338142ff810e
--- /dev/null
+++ b/src/com/android/internal/telephony/honor/HonorCompletedCallQoe.java
@@ -0,0 +1,209 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.internal.telephony.honor;
+
+/**
+ * Functional completed-call fields for stock DC Function9/10. The shared call reconciler supplies
+ * matched events and immutable lifecycle facts. This class owns no matcher, timer or native client.
+ */
+final class HonorCompletedCallQoe {
+    enum Direction { MO, MT }
+    enum Domain { INVALID, CS, VOLTE, VONR, VOWIFI, EPSFB, VODATA, N2L, L2N, N2W, W2N, L2W, W2L }
+    enum Stage { STARTING, ALERTING, CONNECTED }
+    enum EndType { UNKNOWN, NORMAL, ERROR, CS }
+    enum Function {
+        NONE(0), DC_ERROR(9), DC_NORMAL(10);
+        final int id;
+        Function(int id) { this.id = id; }
+    }
+    record Epoch(int slot, long binding, long profile, long callCycle) {
+        Epoch {
+            if (slot < 0 || slot > 1 || binding <= 0 || profile <= 0 || callCycle <= 0) {
+                throw new IllegalArgumentException("Unqualified call provenance");
+            }
+        }
+    }
+
+    /**
+     * Package-private input from the reviewed shared lifecycle, never a UI/native completion flag.
+     * Stage is the connected/alerted latch projection, not merely the final DISCONNECTED status.
+     * disconnectedWallClockMillis and sipUpdate's receivedWallClockMillis MUST share one clock.
+     * Stock uses System.currentTimeMillis for both. QoS elapsedRealtime removal deadlines are
+     * a different clock and must never be supplied here.
+     */
+    record Facts(Epoch epoch, Direction direction, Domain currentDomain, Domain switchDomain,
+            boolean epsfb, Stage stage, boolean emergency, long disconnectedWallClockMillis,
+            boolean completionAuthorized) {
+        Domain reportedDomain() {
+            return switchDomain != null ? switchDomain : epsfb ? Domain.EPSFB : currentDomain;
+        }
+    }
+    /** Known parsed cause snapshot; absent fields differ from an unknown snapshot (null). */
+    record CauseFacts(Integer modemCause, Integer reasonSip, Integer reasonQ850,
+            Integer reasonRelease) {
+        @Override public String toString() { return "CauseFacts[redacted]"; }
+    }
+
+    record Result(Epoch epoch, Direction direction, Domain domain, Stage stage, EndType endType,
+            Boolean dc, Integer sipCode, Integer recvUpdateCode, boolean emergency,
+            Function function, CauseFacts causes) {
+        Result(Epoch epoch, Direction direction, Domain domain, Stage stage, EndType endType,
+                Boolean dc, Integer sipCode, Integer recvUpdateCode, boolean emergency,
+                Function function) {
+            this(epoch, direction, domain, stage, endType, dc, sipCode, recvUpdateCode,
+                    emergency, function, null);
+        }
+    }
+
+    private final Epoch epoch;
+    private long sequence;
+    private Boolean dc;
+    private Integer modemCause, sipCause, reasonSip, reasonQ850, reasonRelease;
+    private Integer recvUpdate;
+    private long recvUpdateAt;
+    private boolean cancel, reasonError, headersKnown = true, modemKnown = true, ambiguous, completed;
+
+    HonorCompletedCallQoe(Epoch epoch) {
+        this.epoch = java.util.Objects.requireNonNull(epoch);
+    }
+
+    boolean nativeUpdate(Epoch observed, long observedSequence,
+            HonorMtkCallInfoDecoder.CallUpdate update) {
+        if (update == null || update.callId < 0 || update.slot != epoch.slot()
+                || !accept(observed, observedSequence)) return false;
+        // The MTK adapter's event101 exposes only nonzero/non--1 values below100.
+        // Larger raw values are not an accepted end reason; supplementary event105 is separate.
+        if (update.endReason == -1 || update.endReason == 0 || update.endReason >= 100) return true;
+        // Stock preserves an earlier abnormal modem cause over a later normal one.
+        if (normalModem(modemCause) || !normalModem(update.endReason)) {
+            modemCause = update.endReason;
+        }
+        return true;
+    }
+
+    void ambiguousSip(Epoch observed, long observedSequence) {
+        if (accept(observed, observedSequence)) ambiguous = true;
+    }
+
+    /** Event105 overwrites only the uniquely matched terminal's end cause, exactly as stock. */
+    boolean supplementaryEndCause(Epoch observed, long observedSequence, Integer cause,
+            boolean known) {
+        if (!accept(observed, observedSequence)) return false;
+        modemKnown = known;
+        if (known) modemCause = cause;
+        return true;
+    }
+
+    boolean sipUpdate(Epoch observed, long observedSequence, long receivedWallClockMillis,
+            HonorCompletedSipDecoder.Update update) {
+        if (update == null || update.shared().slot != epoch.slot()
+                || !accept(observed, observedSequence)) return false;
+        if (update.dcMalformed()) dc = null;
+        else if (update.dc() != null) dc = update.dc();
+        HonorMtkSipDecoder.SipUpdate sip = update.shared();
+        if (sip.type == 1 && sip.code > 299 && sip.code < 700) {
+            if (sip.code != 487 || !cancel) {
+                sipCause = sip.code;
+                setHeaders(update);
+            }
+        }
+        if (sip.type == 4) cancel = true;
+        if (sip.code == 0 && (sip.type == 4 || sip.type == 7)) {
+            sipCause = null;
+            setHeaders(update);
+        }
+        // Exact wire SipType UPDATE=3 and receive direction=1; 0/200 are not errors.
+        if (sip.type == 3 && sip.direction == 1 && sip.code != 0 && sip.code != 200) {
+            recvUpdate = sip.code;
+            recvUpdateAt = receivedWallClockMillis;
+        }
+        return true;
+    }
+
+    private void setHeaders(HonorCompletedSipDecoder.Update update) {
+        reasonSip = update.reasonSip();
+        reasonQ850 = update.reasonQ850();
+        reasonRelease = update.reasonRelease();
+        reasonError = update.reasonError();
+        headersKnown = update.headersKnown();
+    }
+
+    /** Called exactly at a shared lifecycle-authorized completion, including its reviewed delay. */
+    Result complete(Facts facts) {
+        if (facts == null || !epoch.equals(facts.epoch()) || completed
+                || !facts.completionAuthorized()) return null;
+        completed = true;
+        EndType end = ambiguous ? EndType.UNKNOWN : endType(facts.currentDomain());
+        Integer nearUpdate = null;
+        if (recvUpdate != null) {
+            try {
+                long difference = Math.subtractExact(facts.disconnectedWallClockMillis(), recvUpdateAt);
+                if (difference >= -1000 && difference <= 1000) nearUpdate = recvUpdate;
+            } catch (ArithmeticException invalidInterval) {
+                // An invalid clock interval cannot qualify a received UPDATE for recovery.
+            }
+        }
+        Domain reported = facts.reportedDomain();
+        Function function = function(facts.direction(), reported, facts.stage(), end, dc,
+                sipCause, nearUpdate);
+        CauseFacts causes = ambiguous || !headersKnown || !modemKnown ? null
+                : new CauseFacts(modemCause, reasonSip, reasonQ850, reasonRelease);
+        return new Result(epoch, facts.direction(), reported, facts.stage(), end, dc, sipCause,
+                nearUpdate, facts.emergency(), function, causes);
+    }
+
+    /** Shared profile/binding/call-epoch retirement never emits a synthetic result or reset. */
+    void retire() {
+        completed = true;
+        dc = null;
+        modemCause = sipCause = reasonSip = reasonQ850 = reasonRelease = recvUpdate = null;
+    }
+
+    private boolean accept(Epoch observed, long observedSequence) {
+        if (completed || !epoch.equals(observed) || observedSequence <= sequence) return false;
+        sequence = observedSequence;
+        return true;
+    }
+
+    private EndType endType(Domain currentDomain) {
+        if (currentDomain == null || currentDomain == Domain.INVALID) return EndType.UNKNOWN;
+        if (currentDomain == Domain.CS) return EndType.CS;
+        if (reasonError || !normalModem(modemCause) || !normalSip(sipCause)
+                || !normalSip(reasonSip) || !normalQ850(reasonQ850)
+                || !normalRelease(reasonRelease)) return EndType.ERROR;
+        return headersKnown && modemKnown ? EndType.NORMAL : EndType.UNKNOWN;
+    }
+
+    private static Function function(Direction direction, Domain domain, Stage stage,
+            EndType end, Boolean dc, Integer sip, Integer update) {
+        if (direction != Direction.MO || !Boolean.TRUE.equals(dc) || stage == null
+                || domain == null || domain == Domain.INVALID) return Function.NONE;
+        boolean ims = domain == Domain.VONR || domain == Domain.EPSFB || domain == Domain.VOLTE;
+        boolean setup = stage == Stage.STARTING || stage == Stage.ALERTING;
+        boolean errorOrCs = end == EndType.ERROR || end == EndType.CS;
+        boolean configuredSip = sip != null && (sip == 488 || sip == 503);
+        if ((ims && setup && errorOrCs && configuredSip)
+                || (domain == Domain.CS && errorOrCs && configuredSip)
+                || (ims && setup && end == EndType.ERROR && Integer.valueOf(488).equals(update))) {
+            return Function.DC_ERROR;
+        }
+        return ims && end == EndType.NORMAL ? Function.DC_NORMAL : Function.NONE;
+    }
+
+    private static boolean normalModem(Integer code) {
+        return code == null || code == -1 || code == 0 || code == 6;
+    }
+    private static boolean normalSip(Integer code) {
+        return code == null || (code >= 100 && code <= 299) || code == 408 || code == 480
+                || code == 486 || code == 487 || code == 603;
+    }
+    private static boolean normalQ850(Integer code) {
+        return code == null || code == 0 || code == 1 || code == 16 || code == 17 || code == 18
+                || code == 19 || code == 21 || code == 31 || code == 603;
+    }
+    private static boolean normalRelease(Integer code) {
+        return code == null || code == 0 || code == 1 || code == 21;
+    }
+}
diff --git a/src/com/android/internal/telephony/honor/HonorCompletedSipDecoder.java b/src/com/android/internal/telephony/honor/HonorCompletedSipDecoder.java
