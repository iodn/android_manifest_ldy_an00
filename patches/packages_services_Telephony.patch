+    private void review() {
+        Phone[] current = PhoneFactory.getPhones();
+        if (current == null || current.length == 0 || current.length > 2) return;
+        installPhones(current);
+        boolean idle = allIdle();
+        for (int slot = 0; slot < 2; slot++) {
+            HonorRadioCommBroker.Snapshot broker = HonorRadioCommBroker.snapshot(slot);
+            Object card = slot < phones.length
+                    ? UiccController.getInstance().getUiccCardForPhone(slot) : null;
+            Object uiccProfile = slot < phones.length
+                    ? UiccController.getInstance().getUiccProfileForPhone(slot) : null;
+            String iccIdentity = slot < phones.length
+                    ? phones[slot].getFullIccSerialNumber() : null;
+            boolean identityUsable = slot < phones.length && usable(phones[slot]) && card != null
+                    && uiccProfile != null && iccIdentity != null && !iccIdentity.isEmpty();
+            Profile profile = profiles[slot];
+            if (identityUsable && (profile == null || !profile.identityUsable
+                    || profile.phone != phones[slot] || profile.subId != phones[slot].getSubId()
+                    || profile.card != card || profile.uiccProfile != uiccProfile
+                    || !profile.iccIdentity.equals(iccIdentity)
+                    || profile.brokerGeneration != broker.generation())) {
+                retire(slot);
+                profile = new Profile(slot, phones[slot], card, uiccProfile, iccIdentity,
+                        nextProfile++,
+                        broker.generation(), idle);
+                profiles[slot] = profile;
+            }
+            if (profile != null) {
+                profile.identityUsable = identityUsable;
+                boolean qualify = identityUsable && subscriberReady(slot)
+                        && (profile.qualified || broker.ready());
+                if (qualify && !profile.qualified) profile.idleAtAdmission = idle;
+                profile.qualified = qualify;
+                hardware.updateProfile(slot, profile.generation, qualify);
+            }
+            if (profile == null || !profile.qualified) {
+                retire(slot);
+                if (profile != null) {
+                    profile.defaultOpen.qualify(0, 0);
+                    profile.quality = null;
+                }
+                continue;
+            }
+            HnCallHardwareOwner.Snapshot source = hardware.barrier(slot);
+            bindingAdmission(profile, source);
+            profile.defaultOpen.qualify(source.ready() ? source.bindingGeneration() : 0,
+                    source.ready() ? source.profileGeneration() : 0);
+            Session session = sessions[slot];
+            if (session != null && (session.bindingGeneration != source.bindingGeneration()
+                    || session.profileGeneration != source.profileGeneration())) {
+                retire(slot);
+                session = null;
+            }
+            if (!source.ready()) continue;
+            if (session == null) {
+                session = new Session(slot, profile, nextEpoch++, source, null, this::completedCall);
+                sessions[slot] = session;
+            }
+            if (idle && !lastAllIdle) {
+                // Only the logical call cache advances. Native subscriptions and hardware
+                // configuration/pending requests live across ordinary call boundaries.
+                HonorCallQosSnapshot retained = session.cache;
+                retained.retireCompletedCycle(session.terminalSequence);
+                long terminal = session.terminalSequence;
+                long barrier = source.sequence();
+                Boolean acknowledged = session.pending == 0 ? session.acknowledged : null;
+                retire(slot, false);
+                session = new Session(slot, profile, nextEpoch++, source, retained, this::completedCall);
+                session.complete = true;
+                session.cache.setNewCallQualified(true);
+                session.cycleBarrier = barrier;
+                session.priorTerminalSequence = terminal;
+                session.lastSequence = 0;
+                session.desired = profile.ownedStart ? Boolean.FALSE : null;
+                session.acknowledged = acknowledged;
+                sessions[slot] = session;
+                apply(session, retained.current());
+                scheduleRemoval(session);
+            }
+            if (profile.ownedStart && session.complete && idle && !session.unresolvedSip
+                    && session.orphanCalls.isEmpty()
+                    && session.cache.current().isEmpty() && session.desired == null) {
+                session.desired = false;
+            }
+            sendLatest(session, broker);
+        }
+        if (dcRecovery != null) {
+            for (int slot = 0; slot < 2; slot++) {
+                Profile profile = profiles[slot];
+                HnCallHardwareOwner.Snapshot source = hardware.barrier(slot);
+                boolean qualified = profile != null && profile.qualified && source.ready()
+                        && subscriberReady(slot) && identityMatches(profile, slot);
+                dcRecovery.qualify(slot, profile == null ? 0 : profile.generation,
+                        source.bindingGeneration(), qualified, isRecoveryQuiescent());
+            }
+        }
+        lastAllIdle = idle;
+        recoveryAdmissionChanged();
+    }
