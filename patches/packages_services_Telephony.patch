+        check(reverse.state()==SepMuxTrial.State.WAITING);
+        rq=reverse.queryStatus(103);reverse.status(rq,true,true,false,1,false,104);
+        check(reverse.state()==SepMuxTrial.State.WAITING); // Controller still eUICC.
+        rq=reverse.queryStatus(105);reverse.status(rq,true,true,false,1,true,106);
