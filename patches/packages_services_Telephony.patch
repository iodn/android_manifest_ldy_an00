+/* Copyright (C) 2026 The LineageOS Project. SPDX-License-Identifier: Apache-2.0 */
+package com.android.internal.telephony.honor;
+public final class LpaCardRejectionHostTest {
+ static int checks;
+ static void ok(boolean value) {checks++;if(!value)throw new AssertionError("check "+checks);}
+ static final class Store implements SepMuxJournal.Store {
+  String record;public String read(){return record;}public void writeDurably(String value){record=value;}
+ }
+ static final class Fixture {
+  final Store store=new Store();
+  final Object owner=new Object(),endpoint=new Object();
+  final LpaOperationLease.Scope scope;
+  final LpaOperationLease lease=new LpaOperationLease(store);
+  Fixture(int kind)throws Exception {
+   scope=new LpaOperationLease.Scope("00000000000000000000000000000001",10055,0,kind==4?3:2,1,0,7,2,10);
+   lease.acquire(scope,owner,endpoint,0,100);
+   ok(lease.beginNative(scope,owner,endpoint,1,kind,true));
+  }
+  boolean reject(int kind,int code)throws Exception {return lease.nativeRejected(scope,owner,endpoint,2,kind,code);}
+ }
+ public static void main(String[] args)throws Exception {
+  // All parsed SGP rejections; no success/reset/blank proof or durable CLEAN yet.
+  for(int kind=2;kind<=4;kind++)for(int code=1;code<=(kind==2?5:3);code++) {
+   var f=new Fixture(kind);ok(f.reject(kind,code));
+   ok(f.lease.state()==LpaOperationLease.State.ACTIVE);
+   ok(f.store.record.startsWith("L1 A "));ok(!f.lease.isKnownBlank());
+   ok(!f.lease.resetReturned(f.scope,f.owner,3));
+   ok(f.lease.check(f.scope,f.owner,f.endpoint,3));
+   ok(f.lease.channelAccess(f.scope,f.owner,3));
+   try{f.lease.requireRouteAllowed();throw new AssertionError();}catch(IllegalStateException expected){checks++;}
+   ok(!f.reject(kind,code)); // Cannot consume the same mutation twice.
+   ok(f.lease.complete(f.scope,f.owner,f.endpoint,4,true));ok(f.store.record.equals("L1 C\n"));
+  }
+  for(int[] bad:new int[][]{{2,-1},{2,0},{2,6},{2,127},{3,4},{4,4},{1,1},{7,1}}) {
+   var f=new Fixture(2);ok(!f.reject(bad[0],bad[1]));ok(f.lease.state()==LpaOperationLease.State.UNKNOWN);
+  }
+  var f=new Fixture(2);ok(!f.reject(3,1));ok(f.lease.state()==LpaOperationLease.State.UNKNOWN); // Wrong last kind.
+  f=new Fixture(2);
+  var target=new LpaOperationLease.Scope(f.scope.token,10055,0,2,1,0,8,2,10);
+  try{f.lease.nativeRejected(target,f.owner,f.endpoint,2,2,1);throw new AssertionError();}catch(SecurityException expected){checks++;}
+  try{f.lease.nativeRejected(f.scope,new Object(),f.endpoint,2,2,1);throw new AssertionError();}catch(SecurityException expected){checks++;}
+  ok(f.reject(2,1)); // Wrong owner/target did not authorize a transition.
+  f=new Fixture(2);ok(!f.lease.nativeRejected(f.scope,f.owner,new Object(),2,2,1));ok(f.lease.state()==LpaOperationLease.State.UNKNOWN);
+  f=new Fixture(2);ok(!f.lease.nativeRejected(f.scope,f.owner,f.endpoint,100,2,1));ok(f.lease.state()==LpaOperationLease.State.UNKNOWN);
+  f=new Fixture(2);f.lease.abandon(f.scope,f.owner);ok(!f.reject(2,1));ok(f.lease.state()==LpaOperationLease.State.UNKNOWN);
+  f=new Fixture(2);ok(!f.lease.nativeReturned(f.scope,f.owner,f.endpoint,2,false));ok(!f.reject(2,1));
+  f=new Fixture(2);ok(f.reject(2,1));ok(!f.lease.complete(f.scope,f.owner,f.endpoint,3,false));ok(f.lease.state()==LpaOperationLease.State.UNKNOWN);
+  f=new Fixture(2);ok(f.reject(2,1));f.lease.cardEndpointRetired();ok(f.lease.state()==LpaOperationLease.State.UNKNOWN); // No reset exemption.
+  f=new Fixture(2);ok(f.lease.nativeReturned(f.scope,f.owner,f.endpoint,2,true));ok(!f.reject(2,1));ok(f.lease.resetReturned(f.scope,f.owner,3));
+  f=new Fixture(4);ok(!f.reject(2,1));ok(f.lease.state()==LpaOperationLease.State.UNKNOWN); // Outside DELETE scope.
+  System.out.println("PASS "+checks+" actual lease card-rejection checks; no Binder/native/hardware proof");
+ }
+}
