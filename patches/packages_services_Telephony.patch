+/* Copyright (C) 2026 The LineageOS Project. SPDX-License-Identifier: Apache-2.0 */
+package com.android.internal.telephony.honor;
+
+/** One registration attempt per phone process, shared by probe and controlled mux owner. */
+final class MtkSimCallbackOwner {
+    static final MtkSimCallbackOwner PROCESS = new MtkSimCallbackOwner();
+    private Object owner;
+    synchronized void claim(Object token) {
+        if(token==null || owner!=null) throw new IllegalStateException("MTK callback pair already claimed");
