+package com.android.internal.telephony.honor;
+
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.util.Arrays;
+
+public final class HonorMtkCallFeedbackDecoderTest {
+    private static int checks;
+    private static void check(boolean value) {
+        checks++;
+        if (!value) throw new AssertionError("check " + checks);
+    }
+    private static byte[] words(int... values) {
+        ByteBuffer b = ByteBuffer.allocate(values.length * 4).order(ByteOrder.LITTLE_ENDIAN);
+        for (int value : values) b.putInt(value);
+        return b.array();
+    }
+    public static void main(String[] args) {
+        for (int code : new int[] {0, 100, 101, 102}) {
+            var q = HonorMtkVoiceQualityDecoder.decode(1, 1, 2, words(1, code, 0));
+            check(q != null && q.slot() == 1 && q.code() == code && q.isKnownCode()
+                    && q.isCellular());
+        }
+        check(!HonorMtkVoiceQualityDecoder.decode(0, 1, 2, words(1, 101, 2)).isCellular());
+        var unknown = HonorMtkVoiceQualityDecoder.decode(0, 1, 2, words(1, 900, 8));
+        check(unknown != null && !unknown.isKnownCode() && unknown.rat() == 8);
+        check(HonorMtkVoiceQualityDecoder.decode(0, 1, 2, words(1, -1, 0)) == null);
+        check(HonorMtkVoiceQualityDecoder.decode(0, 1, 2, words(1, 0, -1)) == null);
+        for (int n = 0; n < 12; n++) {
+            check(HonorMtkVoiceQualityDecoder.decode(0, 1, 2, new byte[n]) == null);
+        }
+        check(HonorMtkVoiceQualityDecoder.decode(0, 1, 2, null) == null);
+        check(HonorMtkVoiceQualityDecoder.decode(-1, 1, 2, words(1, 100, 0)) == null);
+        check(HonorMtkVoiceQualityDecoder.decode(2, 1, 2, words(1, 100, 0)) == null);
+        check(HonorMtkVoiceQualityDecoder.decode(0, 2, 2, words(1, 100, 0)) == null);
+        check(HonorMtkVoiceQualityDecoder.decode(0, 1, 1, words(1, 100, 0)) == null);
+        check(HonorMtkVoiceQualityDecoder.decode(0, 1, 2, words(2, 100, 0)) == null);
+        check(HonorMtkVoiceQualityDecoder.decode(0, 1, 2,
+                Arrays.copyOf(words(1, 102, 1), 15)).code() == 102);
+        for (int type : new int[] {0, 1, 2, 3, 100, 101}) {
+            var r = HonorMtkImsDefaultOpenDecoder.decode(0, 1, 1002, words(type));
+            check(r != null && r.type() == type && r.featureBits() == (type <= 3 ? type : -1)
+                    && r.isMbnLookupFailure() == (type >= 100));
+        }
+        for (int n = 0; n < 4; n++) {
+            check(HonorMtkImsDefaultOpenDecoder.decode(0, 1, 1002, new byte[n]) == null);
+        }
+        for (int type : new int[] {-1, 4, 99, 102, Integer.MAX_VALUE}) {
+            check(HonorMtkImsDefaultOpenDecoder.decode(0, 1, 1002, words(type)) == null);
+        }
+        check(HonorMtkImsDefaultOpenDecoder.decode(0, 1, 1002, null) == null);
+        check(HonorMtkImsDefaultOpenDecoder.decode(-1, 1, 1002, words(1)) == null);
+        check(HonorMtkImsDefaultOpenDecoder.decode(2, 1, 1002, words(1)) == null);
+        check(HonorMtkImsDefaultOpenDecoder.decode(0, 2, 1002, words(1)) == null);
+        check(HonorMtkImsDefaultOpenDecoder.decode(0, 1, 2, words(1)) == null);
+        check(HonorMtkImsDefaultOpenDecoder.decode(0, 1, 1002, words(3, 900)).type() == 3);
+        var one = HonorMtkImsDefaultOpenDecoder.decode(0, 1, 1002, words(1));
+        var three = HonorMtkImsDefaultOpenDecoder.decode(0, 1, 1002, words(3));
+        var error = HonorMtkImsDefaultOpenDecoder.decode(0, 1, 1002, words(100));
+        var other = HonorMtkImsDefaultOpenDecoder.decode(1, 1, 1002, words(2));
+        var state = new HonorImsDefaultOpenState(0);
+        check(state.report() == null);
+        check(!state.accept(1, 1, 1, one)); // profile-0/boot observation is not replayed.
+        state.qualify(1, 1);
+        check(state.report() == null);
+        check(state.accept(1, 1, 3, one));
+        check(state.report().type() == 1); // raw type 1 never becomes 3 from platform WFC.
+        state.qualify(1, 1); // ordinary call boundary does not erase a qualified report.
+        check(state.report().type() == 1);
+        check(!state.accept(1, 1, 3, three));
+        check(!state.accept(1, 1, 2, three));
+        check(!state.accept(2, 1, 4, three));
+        check(!state.accept(1, 2, 4, three));
+        check(!state.accept(1, 1, 4, other));
+        check(!state.accept(1, 1, 4, null));
+        check(state.report().type() == 1);
+        check(state.accept(1, 1, 4, error));
+        check(state.report().featureBits() == -1 && state.report().isMbnLookupFailure());
+        state.qualify(1, 2);
+        check(state.report() == null);
+        check(!state.accept(1, 1, 100, three)); // queued report from previous eSIM profile.
+        check(state.accept(1, 2, 5, three));
+        state.qualify(0, 0);
+        check(state.report() == null && !state.accept(1, 2, 6, three));
+        state.qualify(2, 2);
+        check(state.report() == null && !state.accept(1, 2, 99, three));
+        check(state.accept(2, 2, 1, one));
+        check(state.report().type() == 1);
+        state.unqualified(2, 2);
+        check(state.report() == null);
+        check(!state.accept(2, 2, 1, three));
+        check(state.accept(2, 2, 3, three));
+        state.unqualified(2, 2);
+        check(state.report().type() == 3); // Older profile-0 callback cannot erase a newer report.
+        state.unqualified(1, 99);
+        check(state.report().type() == 3); // Old binding cannot erase the current value.
+        System.out.println("PASS " + checks + " call-feedback decoder/state checks");
+    }
+}
