+            throw new PreparationRefused("DEVICE_IDENTITY");
+        if(!"userdebug".equals(Build.TYPE)) throw new PreparationRefused("BUILD_TYPE");
+        if(Process.myUid()!=1001) throw new PreparationRefused("UID");
+        if(!"com.android.phone".equals(Application.getProcessName()))
