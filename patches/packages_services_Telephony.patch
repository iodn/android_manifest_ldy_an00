+    }
+    private boolean adopt(int slot,State state,MtkAssistProfile candidate) {
+        if(state.empty) {state.token=null;return true;} // EMPTY never authorizes subscriber work.
+        boolean matches=matchesReceipt(slot,state,candidate);
+        if(matches) {
+            state.token=null;state.armed=false;
