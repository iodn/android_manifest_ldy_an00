@@ -0,0 +1,264 @@
+package com.android.internal.telephony.honor;
+import android.os.*;
+import java.util.*;
+
+public final class MtkAssistTransportHostTest {
+    private static int checks;
+    private static final String CALLBACK =
+            "vendor.mediatek.hardware.mtkradioex.assist.IAssistRadioResponse";
+    private record Call(int code, List<Object> values, int flags) {}
+    private static void check(boolean value,String message) {
+        checks++;
+        if(!value)throw new AssertionError(message);
+    }
+    private static final class Native implements IBinder {
+        int version=3, refuse=-1, unlinks;
+        String descriptor=MtkAssistTransport.DATA;
+        IBinder callback;
+        final List<Call> calls=new ArrayList<>();
+        final List<DeathRecipient> deaths=new ArrayList<>();
+        @Override public String getInterfaceDescriptor(){return descriptor;}
+        @Override public void linkToDeath(DeathRecipient d,int f){deaths.add(d);}
+        @Override public boolean unlinkToDeath(DeathRecipient d,int f) {
+            unlinks++;
+            if(!deaths.remove(d))throw new NoSuchElementException();
+            return true;
+        }
+        @Override public boolean transact(int c,Parcel p,Parcel out,int flags) {
+            calls.add(new Call(c,p.snapshot(),flags));
+            if(c==refuse)return false;
+            if(c==16777215){out.writeNoException();out.writeInt(version);return true;}
+            if(c==11 || c==32)callback=(IBinder)p.snapshot().get(1);
+            return true;
+        }
+        long count(int code){return calls.stream().filter(c->c.code==code).count();}
+        Call last(){return calls.get(calls.size()-1);}
+        void die(){for(DeathRecipient d:List.copyOf(deaths))d.binderDied();}
+    }
+    private static class Results implements MtkAssistTransport.Listener {
+        final List<String> replies=new ArrayList<>();
+        int unavailable;
+        @Override public void response(int slot,long generation,MtkAssistSyncState.Kind kind,
+                int serial,int type,int error) {
+            replies.add(slot+":"+generation+":"+kind+":"+serial+":"+type+":"+error);
+        }
+        @Override public void unavailable(int slot,long generation){unavailable++;}
+    }
+    private static MtkAssistSyncState.Notification request(MtkAssistSyncState.Kind kind,int...values) {
+        return new MtkAssistSyncState.Notification(0,kind,values,1,7);
+    }
+    private static void callback(Native remote,int method,int type,int serial,int error)
+            throws Exception {
+        Parcel input=Parcel.obtain();
+        input.writeInterfaceToken(remote.descriptor.equals(MtkAssistTransport.MODEM)
+                ? "vendor.mediatek.hardware.mtkradioex.assist.IAssistModemResponse" : CALLBACK);
+        input.writeInt(1);input.writeInt(16);
+        input.writeInt(type);input.writeInt(serial);input.writeInt(error);
+        check(remote.callback.transact(method,input,null,IBinder.FLAG_ONEWAY),"Callback accepted");
+    }
+    public static void main(String[] args) throws Exception {
+        Native remote=new Native();Handler handler=new Handler();Results result=new Results();
+        MtkAssistTransport transport=new MtkAssistTransport(remote,0,7,handler,result);
+        check(!transport.healthy(),"Metadata alone is not registration");
+        transport.register();
+        check(transport.healthy(),"Data service V3 accepted with callback V4");
+        check(remote.count(11)==1 && remote.last().values.size()==2,"Dedicated response-only registration");
+        check(remote.last().flags==IBinder.FLAG_ONEWAY,"Registration one-way");
+        check(((Binder)remote.callback).stable,"VINTF stable callback");
+        Parcel input=Parcel.obtain(),output=Parcel.obtain();
+        input.writeInterfaceToken(CALLBACK);
+        remote.callback.transact(16777215,input,output,0);
+        check(output.readInt()==4,"Callback version is4, not service3");
+        input=Parcel.obtain();output=Parcel.obtain();input.writeInterfaceToken(CALLBACK);
+        remote.callback.transact(16777214,input,output,0);
+        check(MtkAssistTransport.CALLBACK_HASH.equals(output.readString()),"Exact callback hash");
+
+        transport.send(request(MtkAssistSyncState.Kind.DATA,0,1,-2,-2,-2),42);
+        Call sent=remote.last();
+        check(sent.code==8 && sent.values.size()==4 && sent.flags==1,"Exact data transaction schema");
+        check(sent.values.get(0).equals(MtkAssistTransport.DATA),"Data descriptor");
+        check(sent.values.get(1).equals(42) && sent.values.get(3).equals(4),"Serial and client4");
+        check(Arrays.equals((int[])sent.values.get(2),new int[]{0,1,-2,-2,-2}),"Exact user/roaming tuple");
+        check(result.replies.isEmpty(),"Successful transact is not an ACK");
+        callback(remote,2,1,42,0);handler.drain();
+        check(remote.count(9)==0,"Intermediate ACK1 never sends acknowledgement");
+        check(result.replies.get(0).equals("0:7:DATA:42:1:0"),"Forward ACK1 with identity");
+        callback(remote,2,2,42,0);handler.drain();
+        check(remote.count(9)==1 && remote.last().values.size()==1,"ACK_EXP sends no-argument tx9");
+        check(result.replies.get(1).equals("0:7:DATA:42:2:0"),"Final response identity");
+
+        transport.send(request(MtkAssistSyncState.Kind.DEFAULT_DATA,-2,-2,1,-2,-2),43);
+        check(remote.last().code==8,"DDS notification shares data method");
+        check(Arrays.equals((int[])remote.last().values.get(2),new int[]{-2,-2,1,-2,-2}),"Exact DDS tuple");
+        callback(remote,2,0,43,6);handler.drain();
+        check(result.replies.get(2).endsWith(":43:0:6"),"Native error preserved");
+        check(remote.count(9)==1,"SOLICITED0 does not ACK");
+
+        transport.send(request(MtkAssistSyncState.Kind.SCREEN,1),44);
+        check(remote.last().code==7,"Exact screen transaction");
+        check(remote.last().values.equals(List.of(MtkAssistTransport.DATA,44,3,1,-1,4)),
+                "FD mode3 screen notification/client4");
+        callback(remote,1,0,44,0);handler.drain();
+        check(result.replies.get(3).equals("0:7:SCREEN:44:0:0"),"Screen callback method");
+        int before=remote.calls.size();
+        try {transport.send(new MtkAssistSyncState.Notification(1,MtkAssistSyncState.Kind.SCREEN,
+                new int[]{1},1,7),45);throw new AssertionError("Wrong slot sent");}
+        catch(RemoteException expected){}
+        check(remote.calls.size()==before,"Wrong-slot notification sends nothing");
+        try {transport.register();throw new AssertionError("Duplicate registration");}
+        catch(RemoteException expected){}
+        check(remote.count(11)==1,"Registration never repeated for one owner");
+
+        callback(remote,1,0,46,0); // queued local delivery
+        transport.close();handler.drain();
+        check(result.replies.size()==4,"Close rejects queued callbacks");
+        check(remote.deaths.isEmpty(),"Close unlinks death recipient");
+        before=remote.calls.size();
+        callback(remote,1,2,47,0);handler.drain();
+        check(remote.calls.size()==before+1 && remote.last().code==9
+                && remote.last().values.size()==1,"Closed endpoint releases late ACK_EXP wake lock");
+        check(result.replies.size()==4,"Closed endpoint never dispatches late ACK_EXP");
+        before=remote.calls.size();
+        callback(remote,1,0,48,0);handler.drain();
+        check(remote.calls.size()==before && result.replies.size()==4,
+                "Closed SOLICITED response has neither ACK nor dispatch");
+        remote.refuse=9;
+        callback(remote,1,2,49,0);handler.drain();
+        check(result.unavailable==0 && !transport.incompatible(),
+                "Retired ACK failure neither revives owner nor marks ABI incompatible");
+        check(result.unavailable==0,"Intentional close is not a new unavailable event");
+
+        remote=new Native();handler=new Handler();result=new Results();
+        transport=new MtkAssistTransport(remote,0,7,handler,result);transport.register();
+        remote.die();handler.drain();
+        check(!transport.healthy() && result.unavailable==1,"Binder death invalidates once");
+        check(remote.deaths.isEmpty(),"Death retirement removes recipient");
+        transport.close();handler.drain();
+        check(result.unavailable==1,"Close does not duplicate failure");
+
+        remote=new Native();remote.refuse=11;handler=new Handler();result=new Results();
+        transport=new MtkAssistTransport(remote,0,7,handler,result);
+        try {transport.register();throw new AssertionError("Refused registration accepted");}
+        catch(RemoteException expected){}
+        handler.drain();
+        check(!transport.healthy() && result.unavailable==1,"Registration failure is never healthy");
+        check(remote.deaths.isEmpty(),"Failed registration unlinks recipient");
+
+        remote=new Native();remote.version=2;
+        try {new MtkAssistTransport(remote,0,7,new Handler(),new Results());throw new AssertionError("V2 accepted");}
+        catch(MtkAssistTransport.IncompatibleServiceException expected){}
+        check(remote.count(11)==0 && remote.deaths.isEmpty(),"Unsupported service has no callback mutation");
+
+        remote=new Native();remote.refuse=16777215;
+        try {new MtkAssistTransport(remote,0,7,new Handler(),new Results());
+            throw new AssertionError("Missing version accepted");}
+        catch(MtkAssistTransport.IncompatibleServiceException expected){}
+        check(remote.deaths.isEmpty(),"Missing version is structural, not a live binding");
+        remote=new Native();remote.descriptor="wrong.service";
+        try {new MtkAssistTransport(remote,0,7,new Handler(),new Results());
+            throw new AssertionError("Wrong descriptor accepted");}
+        catch(MtkAssistTransport.IncompatibleServiceException expected){}
+        check(remote.calls.isEmpty(),"Wrong descriptor has no service transactions");
+
+        remote=new Native();handler=new Handler();result=new Results();
+        transport=new MtkAssistTransport(remote,0,7,handler,result);transport.register();remote.refuse=8;
+        try {transport.send(request(MtkAssistSyncState.Kind.DATA,1,0,-2,-2,-2),48);
+            throw new AssertionError("Refused send accepted");}
+        catch(RemoteException expected){}
+        handler.drain();
+        check(!transport.healthy() && result.replies.isEmpty() && result.unavailable==1,
+                "Refused Binder transaction cannot acknowledge");
+        check(!transport.incompatible(),"Transient send failure does not blacklist service ABI");
+
+        remote=new Native();handler=new Handler();result=new Results();
