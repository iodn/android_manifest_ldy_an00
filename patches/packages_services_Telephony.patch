+package com.honor.ldy_an00.lease;
+import java.util.ArrayList;
+import java.util.List;
+import com.honor.ldy_an00.lease.HonorLpaLifecycleTrace.*;
+
+public final class HonorLpaLifecycleTraceHostTest {
+    private static int checks;
+    private static void check(boolean result) {checks++;if(!result)throw new AssertionError("check "+checks);}
+    public static void main(String[] args) {
+        List<String> events=new ArrayList<>();long[] now={10};
+        var trace=new HonorLpaLifecycleTrace(Side.PHONE,Stage.ROUTE_ADMISSION,()->now[0],events::add);
+        trace.failed(new SecurityException("ACTIVATION_SECRET"));
+        check(events.getLast().contains("outcome=TERMINAL_UNKNOWN"));
+        trace.facts(Proof.NO,Proof.NO,Proof.NO);
+        trace.failed(new SecurityException("ACTIVATION_SECRET"));
+        check(events.getLast().contains("outcome=REFUSED_PRE_DISPATCH"));
+        check(events.getLast().contains("nativeDispatch=NO durablePending=NO exactTerminal=NO"));
+        trace.facts(Proof.YES,Proof.YES,Proof.UNKNOWN);
+        trace.failed(new SecurityException("ACTIVATION_SECRET"));
+        check(events.getLast().contains("outcome=TERMINAL_UNKNOWN"));
+        check(!events.getLast().contains("REFUSED_PRE_DISPATCH"));
+        trace.facts(Proof.UNKNOWN,Proof.UNKNOWN,Proof.UNKNOWN);
+        trace.failed(new SecurityException("ACTIVATION_SECRET"));
+        check(events.getLast().contains("outcome=TERMINAL_UNKNOWN"));
+        trace.enter(Stage.LOCAL_JOURNAL);trace.failed(new java.io.IOException("ACTIVATION_SECRET"));
+        check(events.getLast().contains("outcome=STORAGE_FAILURE"));
+        trace.enter(Stage.APDU);trace.failed(new java.io.IOException("ACTIVATION_SECRET"));
+        check(events.getLast().contains("outcome=TRANSPORT_LOST"));
+        now[0]=0;trace.enter(Stage.CLOSE);check(events.getLast().contains("elapsedMs=0"));
+        trace.facts(Proof.NO,Proof.YES,Proof.NO);trace.returned(Outcome.OK);
+        check(events.getLast().contains("nativeDispatch=NO durablePending=YES exactTerminal=NO"));
+        trace.classifiedFailure(Outcome.CANCELLED_DRAINED);
+        int count=events.size();trace.failed(new java.util.concurrent.CancellationException("ACTIVATION_SECRET"));
+        check(events.size()==count);check(events.getLast().contains("outcome=CANCELLED_DRAINED"));
+        for(String event:events) {check(!event.contains("ACTIVATION_SECRET"));check(!event.contains("Exception"));}
+        var unavailable=new HonorLpaLifecycleTrace(Side.LPA,Stage.STATUS,()->0,line->{throw new IllegalStateException();});
+        unavailable.enter(Stage.GRANT);unavailable.failed(new IllegalStateException());
+        System.out.println("LIFECYCLE_TRACE_PASS "+checks);
+    }
+}
