@@ -0,0 +1,338 @@
+/* Copyright (C) 2026 The LineageOS Project. SPDX-License-Identifier: Apache-2.0 */
+package com.android.internal.telephony.honor;
+
+import java.io.IOException;
+
+/** One Phone-owned operation. Death, expiry and restart never imply native work drained. */
+final class LpaOperationLease {
+    enum State { CLEAN, ACTIVE, UNKNOWN }
+    enum NativePhase { IDLE, MUTATING, RESET_RETURNED }
+    static final class Scope {
+        final String token;
+        final int uid, user, operation, slot, port, card, serial, observationSerial;
+        final long generation;
+        Scope(String token, int uid, int user, int operation, int slot, int port, int card,
+                long generation, int serial) {
+            this(token,uid,user,operation,slot,port,card,generation,serial,-1);
+        }
+        Scope(String token,int uid,int user,int operation,int slot,int port,int card,
+                long generation,int serial,int observationSerial) {
+            if (token==null || !token.matches("[0-9a-f]{32}") || uid<0 || user!=0
+                    || operation<0 || operation>7 || slot!=1 || port<0 || card<0
+                    || generation<=0 || !(serial>0 && observationSerial==-1
+                        || serial==0 && observationSerial>0))
+                throw new IllegalArgumentException("Invalid lease scope");
+            this.token=token; this.uid=uid; this.user=user; this.operation=operation;
+            this.slot=slot; this.port=port; this.card=card; this.generation=generation;
+            this.serial=serial;this.observationSerial=observationSerial;
+        }
+        boolean allowsNativeKind(int kind) {
+            return switch(operation) {
+                case 1 -> kind==1 || kind==2 || kind==7;
+                case 2 -> kind==2 || kind==3 || kind==7;
+                case 3 -> kind==4 || kind==7;
+                case 4 -> kind==5;
+                case 5 -> kind==6 || kind==7;
+                case 6 -> kind==8 || kind==7;
+                default -> false;
+            };
+        }
+        String fields() { return token+" "+uid+" "+user+" "+operation+" "+slot+" "+port+" "+card
+                +" "+generation+" "+serial+" "+observationSerial; }
+        boolean same(Scope other) { return other!=null && fields().equals(other.fields()); }
+        @Override public String toString() { return "LpaLease[identifiers omitted]"; }
+    }
+    /** Lock-free admission fence for internal callback chains; never authorizes lease completion. */
+    static final class LiveFence {
+        private final long deadline;
+        private volatile boolean live=true;
+        LiveFence(long deadline) {this.deadline=deadline;}
+        boolean current(long now) {return live && now>=0 && now<deadline;}
+        void retire() {live=false;}
+    }
+    private LiveFence liveFence;
+    private void retireFence() {if(liveFence!=null) liveFence.retire();}
+    synchronized LiveFence liveFence(Scope request,Object owner) {
+        requireExact(request,owner);
+        if(state!=State.ACTIVE || liveFence==null) throw new IllegalStateException("No active operation fence");
+        return liveFence;
+    }
+    private final SepMuxJournal.Store store;
+    private State state;
+    private LpaRecoveryFence recovery,startupFence;
+    private Scope scope;
+    private Object client, endpoint;
+    private long deadline;
+    private NativePhase phase=NativePhase.IDLE;
+    private boolean resetExpected,knownBlank;
+    private int lastNativeKind;
+    // Created only at a successful live reset/drain boundary; never reconstructed from B.
+    private Scope blankCompletion;
+    static final class BlankRestoration {
+        final Scope completion;
+        final EuiccReadiness.Snapshot baseline;
+        final EuiccReadiness.Epoch replacement;
+        final MtkSimTypeQuery query;
+        final long deadline;
+        private boolean freshCardPresent;
+        private Object pendingRead;
+        private BlankRestoration(Scope completion,EuiccReadiness.Snapshot baseline,int querySerial,
+                long deadline) {
+            this.completion=completion;this.baseline=baseline;this.deadline=deadline;
+            replacement=new EuiccReadiness.Epoch(completion.generation,completion.serial,completion.observationSerial);
+            query=new MtkSimTypeQuery(completion.generation,querySerial,deadline);
+        }
+    }
+    private BlankRestoration restoration;
+    synchronized boolean restoringBlank() {return restoration!=null;}
+    synchronized BlankRestoration beginBlankRestoration(int uid,long generation,int querySerial,
+            int slot,int port,int card,EuiccReadiness.Snapshot baseline,long now,long duration) {
+        if(state!=State.CLEAN || !knownBlank || restoration!=null || blankCompletion==null
+                || scope!=null || client!=null || endpoint!=null || phase!=NativePhase.IDLE
+                || blankCompletion.uid!=uid || blankCompletion.user!=0 || blankCompletion.generation!=generation || blankCompletion.slot!=slot
+                || blankCompletion.port!=port || blankCompletion.card!=card
+                || baseline==null || !baseline.valid(baseline.epoch)
+                || baseline.epoch.generation!=generation
+                || baseline.epoch.routeSerial!=blankCompletion.serial
+                || baseline.epoch.observationSerial!=blankCompletion.observationSerial
+                || baseline.physicalSlot!=slot || baseline.portIndex!=port
+                || baseline.publicCardId!=card || now<0 || duration<=0 || now>Long.MAX_VALUE-duration)
+            return null;
+        restoration=new BlankRestoration(blankCompletion,baseline,querySerial,now+duration);
+        return restoration;
+    }
+    synchronized boolean blankRestorationCurrent(BlankRestoration token,long generation,long now) {
+        return token!=null && token==restoration && state==State.CLEAN && knownBlank
+                && blankCompletion==token.completion && token.completion.generation==generation
+                && now>=0 && now<token.deadline;
+    }
+    synchronized boolean observeBlankRestorationCard(BlankRestoration token,long generation,long now,
+            boolean present,boolean euicc,int physicalSlot,int port,String eid) {
+        if(!blankRestorationCurrent(token,generation,now)
+                || token.query.state()!=MtkSimTypeQuery.State.EUICC
+                || !present || !euicc || physicalSlot!=token.completion.slot || port!=token.completion.port
+                || !EuiccReadiness.validEid(eid) || !token.baseline.matchesProvidedEid(eid)) return false;
+        token.freshCardPresent=true;return true;
+    }
+    synchronized Scope knownBlankTarget(int uid,int slot,int port,int expectedCardId) {
+        return state==State.CLEAN && knownBlank && blankCompletion!=null
+                && blankCompletion.uid==uid && blankCompletion.user==0
+                && blankCompletion.slot==slot && blankCompletion.port==port
+                && (expectedCardId==-1 || expectedCardId==blankCompletion.card) ? blankCompletion : null;
+    }
+    synchronized boolean beginBlankRead(BlankRestoration token,Object request,long generation,long now) {
+        if(request==null || !blankRestorationCurrent(token,generation,now) || token.pendingRead!=null)
+            return false;
+        token.pendingRead=request;return true;
+    }
+    /** Exact completed callback may drain a read after the caller deadline; never restores readiness. */
+    synchronized boolean completeBlankRead(BlankRestoration token,Object request,long generation) {
+        if(token==null || token!=restoration || token.completion.generation!=generation
+                || request==null || token.pendingRead!=request) return false;
+        token.pendingRead=null;return true;
+    }
+    synchronized boolean cancelBlankRestoration(BlankRestoration token) {
+        if(token!=restoration) return true;
+        if(token!=null && token.pendingRead!=null) return false; // Unknown read completion stays fenced.
+        restoration=null;return true; // Read-only refusal never erases B or UNKNOWN.
+    }
+    synchronized boolean completeBlankRestoration(BlankRestoration token,long generation,long now,
+            EuiccReadiness.Snapshot first,EuiccReadiness.Snapshot second,
+            java.util.function.BooleanSupplier publishEndpoint) throws IOException {
+        if(!blankRestorationCurrent(token,generation,now)
+                || token.pendingRead!=null || token.query.state()!=MtkSimTypeQuery.State.EUICC || !token.freshCardPresent
+                || first==null || second==null || !first.valid(token.replacement)
+                || !second.valid(token.replacement) || !first.same(second)
+                || !first.sameCardIdentity(token.baseline)) return false;
+        // The coordinator lock excludes route/grant admission through durable C AND publication.
+        state=State.UNKNOWN;
+        try {
+            store.writeDurably("L1 C\n");
+            if(!publishEndpoint.getAsBoolean()) throw new IOException("Real endpoint publication refused");
+        } catch(IOException|RuntimeException failure) {
+            restoration=null;
+            try {store.writeDurably("L1 U "+token.completion.fields()+"\n");}
+            catch(IOException suppressed) {failure.addSuppressed(suppressed);}
+            throw failure;
+        }
+        knownBlank=false;blankCompletion=null;restoration=null;state=State.CLEAN;return true;
+    }
+    LpaOperationLease(SepMuxJournal.Store store) throws IOException {
+        this.store=java.util.Objects.requireNonNull(store);
+        String record=store.read();
+        if (record==null || record.equals("L1 C\n")) { state=State.CLEAN; return; }
+        // A previous process cannot prove its native operation or channels were drained.
+        state=State.UNKNOWN;
+        // Protocol4 appends READ provenance. Both schemas remain UNKNOWN after restart.
+        if (!unresolvedRecord(record))
+            throw new IOException("Invalid operation lease journal");
+    }
+    private static boolean unresolvedRecord(String record) {
+        return record!=null && record.matches("L1 [AUB] [0-9a-f]{32}( [0-9]+){8}( (-1|[1-9][0-9]*))?\n");
+    }
+    static boolean validRecoveryHistory(String record) {
+        return record==null || record.equals("L1 C\n") || unresolvedRecord(record);
+    }
+    synchronized boolean recoveryIdle() {
+        return state!=State.ACTIVE && scope==null && client==null && endpoint==null
+                && phase==NativePhase.IDLE && restoration==null;
+    }
+    synchronized boolean requiresPersistedRecovery() throws IOException {
+        return state==State.UNKNOWN && unresolvedRecord(store.read());
+    }
+    synchronized boolean recoveryQuiescent() {
+        return state==State.UNKNOWN && scope==null && client==null && endpoint==null;
+    }
+    synchronized void blockForRecovery(LpaRecoveryFence fence) {
+        startupFence=fence;
+        if(fence.blocksNormal()) {retireFence();state=State.UNKNOWN;}
+    }
+    synchronized void acquireRecovery(Scope request,Object owner,Object currentEndpoint,long now,
+            long duration,LpaRecoveryFence fence) {
+        fence.requireRunning();
+        if(state!=State.UNKNOWN || scope!=null || client!=null || endpoint!=null
+                || request.operation!=7 || owner==null || currentEndpoint==null)
+            throw new IllegalStateException("Recovery is not quiescent");
+        recovery=fence;scope=request;client=owner;endpoint=currentEndpoint;
+        deadline=now+duration;phase=NativePhase.IDLE;state=State.ACTIVE;liveFence=new LiveFence(deadline);
+    }
+    synchronized boolean finishRecovery(Scope request,Object owner,Object currentEndpoint,long now,
+            boolean closed) throws IOException {
+        requireExact(request,owner);
+        if(recovery==null || request.operation!=7 || !closed
+                || !check(request,owner,currentEndpoint,now)) {unknown();return false;}
+        retireFence();state=State.UNKNOWN;
+        recovery.commit(store);state=State.CLEAN;
+        scope=null;client=null;endpoint=null;recovery=null;knownBlank=false;blankCompletion=null;return true;
+    }
+    synchronized void requireCycleQuiescent() {
+        requireRouteAllowed();
+        if(knownBlank || phase!=NativePhase.IDLE || scope!=null || client!=null || endpoint!=null)
+            throw new IllegalStateException("Prior LPA operation not quiescent");
+    }
+    synchronized boolean isKnownBlank() {return state==State.CLEAN && knownBlank;}
+    synchronized State state() { return state; }
+    synchronized void requireRouteAllowed() {
+        if(startupFence!=null) startupFence.requireNormal();
+        if (state!=State.CLEAN || restoration!=null) throw new IllegalStateException("LPA operation active, unknown or restoring");
+    }
+    synchronized void acquire(Scope request,Object owner,Object currentEndpoint,long now,long duration)
+            throws IOException {
+        requireRouteAllowed();
+        if(knownBlank) throw new IllegalStateException("Known blank route is not a new APDU endpoint");
+        if (owner==null || currentEndpoint==null || now<0 || duration<=0 || now>Long.MAX_VALUE-duration)
+            throw new IllegalArgumentException("Invalid lease lifetime");
+        // Set UNKNOWN first: even a storage exception cannot reopen route admission in this VM.
+        retireFence();state=State.UNKNOWN; scope=request; client=owner; endpoint=currentEndpoint;
+        store.writeDurably("L1 A "+request.fields()+"\n");
+        deadline=now+duration; phase=NativePhase.IDLE; state=State.ACTIVE;liveFence=new LiveFence(deadline);
+    }
+    private void requireExact(Scope request,Object owner) {
+        if (scope==null || !scope.same(request) || client!=owner)
+            throw new SecurityException("Wrong operation lease");
+    }
+    synchronized boolean check(Scope request,Object owner,Object currentEndpoint,long now)
+            throws IOException {
+        requireExact(request,owner);
+        if (state!=State.ACTIVE || phase!=NativePhase.IDLE) return false;
+        if (now<0 || now>=deadline || endpoint!=currentEndpoint) { unknown(); return false; }
+        return true;
+    }
+    synchronized boolean channelAccess(Scope request,Object owner,long now) throws IOException {
+        requireExact(request,owner);
+        if(state!=State.ACTIVE) return false;
+        if(now<0 || now>=deadline) {unknown();return false;}
+        return true;
+    }
+    synchronized boolean beginNative(Scope request,Object owner,Object currentEndpoint,long now,
+            boolean expectedCardReset) throws IOException {
+        if(!check(request,owner,currentEndpoint,now)) return false;
+        phase=NativePhase.MUTATING;resetExpected=expectedCardReset;lastNativeKind=0;return true;
+    }
+    synchronized boolean beginNative(Scope request,Object owner,Object currentEndpoint,long now,
+            int kind,boolean expectedCardReset) throws IOException {
+        if(!request.allowsNativeKind(kind)) throw new IllegalArgumentException("Native kind outside lease scope");
+        if(!beginNative(request,owner,currentEndpoint,now,expectedCardReset)) return false;
+        lastNativeKind=kind;return true;
+    }
+    /** Parsed card rejection proves no reset, not a successful mutation or channel drain. */
+    synchronized boolean nativeRejected(Scope request,Object owner,Object currentEndpoint,long now,
+            int kind,int code) throws IOException {
+        requireExact(request,owner);
+        if(state!=State.ACTIVE || phase!=NativePhase.MUTATING) return false;
+        boolean known=kind==2 && code>=1 && code<=5
+                || (kind==3 || kind==4) && code>=1 && code<=3;
+        if(!known || kind!=lastNativeKind || !request.allowsNativeKind(kind)
+                || now<0 || now>=deadline || endpoint!=currentEndpoint) {
+            unknown();return false;
+        }
+        phase=NativePhase.IDLE;resetExpected=false;lastNativeKind=0;return true;
+    }
+    synchronized boolean nativeReturned(Scope request,Object owner,Object currentEndpoint,long now,
+            boolean positive) throws IOException {
+        requireExact(request,owner);
+        if(state!=State.ACTIVE || phase!=NativePhase.MUTATING) return false;
+        if(!positive || now<0 || now>=deadline) { unknown();return false; }
+        if(resetExpected) { phase=NativePhase.RESET_RETURNED;return true; }
+        if(endpoint!=currentEndpoint) { unknown();return false; }
+        phase=NativePhase.IDLE;return true;
+    }
+    synchronized boolean resetReturned(Scope request,Object owner,long now) throws IOException {
+        requireExact(request,owner);
+        if(state!=State.ACTIVE || phase!=NativePhase.RESET_RETURNED) return false;
+        if(now<0 || now>=deadline) { unknown();return false; }
+        return true;
+    }
+    synchronized boolean rebindKnownReset(Scope request,Object owner,Object replacement,long now,
+            boolean sameIdentityFreshMode1,boolean channelsPositivelyClosed) throws IOException {
+        if(!resetReturned(request,owner,now)) return false;
+        if(replacement==null || !sameIdentityFreshMode1 || !channelsPositivelyClosed) return false;
+        endpoint=replacement;phase=NativePhase.IDLE;return true; // Remains ACTIVE, never CLEAN.
+    }
+    synchronized void cardEndpointRetired() throws IOException {
+        if(state==State.ACTIVE && !(resetExpected &&
+                (phase==NativePhase.MUTATING || phase==NativePhase.RESET_RETURNED))) unknown();
+    }
+    synchronized boolean complete(Scope request,Object owner,Object currentEndpoint,long now,
+            boolean nativeCompletedReconciledAndChannelsClosed) throws IOException {
+        requireExact(request,owner);
+        if(request.operation==7) throw new IllegalStateException("Recovery requires its own completion");
+        if(state==State.ACTIVE && phase!=NativePhase.IDLE) { unknown();return false; }
+        if (!check(request,owner,currentEndpoint,now)) return false;
+        if (!nativeCompletedReconciledAndChannelsClosed) { unknown(); return false; }
+        retireFence();
+        try { store.writeDurably("L1 C\n"); }
+        catch(IOException e) { state=State.UNKNOWN; throw e; }
+        state=State.CLEAN; scope=null; client=null; endpoint=null; return true;
+    }
+    synchronized void abandon(Scope request,Object owner) throws IOException {
+        requireExact(request,owner); unknown();
+    }
+    synchronized boolean completeKnownBlank(Scope request,Object owner,long now,
+            boolean lastProfilePositive,boolean channelsClosed,boolean freshMode1AndBlankMapping) throws IOException {
+        if(!resetReturned(request,owner,now)) return false;
+        if((request.operation!=2 && request.operation!=3) || !lastProfilePositive || !channelsClosed
+                || !freshMode1AndBlankMapping) return false;
+        retireFence();
+        try {store.writeDurably("L1 B "+request.fields()+"\n");}
+        catch(IOException failure) {state=State.UNKNOWN;throw failure;}
+        blankCompletion=request;knownBlank=true;state=State.CLEAN;scope=null;client=null;endpoint=null;phase=NativePhase.IDLE;return true;
+    }
+    synchronized void physicalRestored() throws IOException {
+        requireRouteAllowed();
+        if(knownBlank) {
+            try {store.writeDurably("L1 C\n");knownBlank=false;blankCompletion=null;}
+            catch(IOException failure) {state=State.UNKNOWN;throw failure;}
+        }
+    }
+    synchronized boolean abandonIfOwned(Scope request,Object owner) throws IOException {
+        if (scope==null || !scope.same(request) || client!=owner) return false;
+        unknown(); return true;
+    }
+    synchronized void serviceDestroyed() throws IOException {if(state==State.ACTIVE) unknown();}
+    synchronized void ownerLost() throws IOException { if (state==State.ACTIVE || knownBlank) unknown(); }
+    private void unknown() throws IOException {
+        retireFence();restoration=null;blankCompletion=null;state=State.UNKNOWN; // Never reopen, including if publication fails.
+        if (scope!=null && recovery==null) store.writeDurably("L1 U "+scope.fields()+"\n");
+    }
+}
diff --git a/src/com/android/internal/telephony/honor/LpaRecoveryFence.java b/src/com/android/internal/telephony/honor/LpaRecoveryFence.java
new file mode 100644
index 0000000000000000000000000000000000000000..e5a00d5b5c7b26b6e1aa4a7fc10997fa1ce09091
--- /dev/null
+++ b/src/com/android/internal/telephony/honor/LpaRecoveryFence.java
@@ -0,0 +1,78 @@
+/* Copyright (C) 2026 The LineageOS Project. SPDX-License-Identifier: Apache-2.0 */
+package com.android.internal.telephony.honor;
+
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+
+/** Durable kernel-restart fence; a separate positive CLEAN authority may acknowledge a lost reply. */
+final class LpaRecoveryFence {
+    private final SepMuxJournal.Store store;
+    private String record;
+    private boolean failed;
+    LpaRecoveryFence(SepMuxJournal.Store store) throws IOException {
+        this.store=store;record=store.read();
+        if(record!=null && !record.matches("R1 (ARMED|RUNNING|COMMITTING|DONE) [0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12} [0-9a-f]{64} [0-9a-f]{64} [0-9]+\n"))
+            throw new IOException("Invalid recovery fence");
+    }
+    static String hash(String value) {
+        try {return java.util.HexFormat.of().formatHex(MessageDigest.getInstance("SHA-256")
+                .digest(value.getBytes(StandardCharsets.US_ASCII)));}
+        catch(java.security.NoSuchAlgorithmException impossible) {throw new AssertionError(impossible);}
+    }
+    static String bootId() throws IOException {
+        try(java.io.InputStream in=new java.io.FileInputStream("/proc/sys/kernel/random/boot_id")) {
+            byte[] bytes=in.readNBytes(38);
+            String id=new String(bytes,StandardCharsets.US_ASCII);
+            if(!id.matches("[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}\n"))
+                throw new IOException("Invalid Linux boot identity");
+            return id.trim();
+        }
+    }
+    synchronized boolean blocksNormal() {return failed || record!=null && !record.startsWith("R1 DONE ");}
+    synchronized void requireNormal() {
+        if(blocksNormal()) throw new IllegalStateException("Recovery is unresolved");
+    }
+    private String[] fields() {return record==null ? null : record.trim().split(" ");}
+    private boolean matches(String app,int uid) {
+        String[] f=fields();return f!=null && f[3].equals(app) && f[5].equals(Integer.toString(uid));
+    }
+    synchronized int status(String boot,String app,int uid,boolean durablyClean) {
+        if(failed) return 0;
+        // Positive Phone CLEAN authority also acknowledges a lost normal-finish reply.
+        if(durablyClean && !blocksNormal() && hash("A\n").equals(app)) return 4;
+        if(!matches(app,uid)) return 0;
+        String[] f=fields();
+        return switch(f[1]) {
+            case "ARMED" -> f[2].equals(boot) ? 1 : 2;
+            case "DONE" -> 0;
+            default -> f[2].equals(boot) ? 3 : 5;
+        };
+    }
+    synchronized void arm(String boot,String app,int uid,String journals) throws IOException {
+        String[] prior=fields();
+        if(failed || prior!=null && (prior[1].equals("RUNNING") || prior[1].equals("COMMITTING"))
+                && prior[2].equals(boot)) throw new IOException("Recovery attempt is unresolved in this boot");
+        if(!app.equals(hash("A\n")) || !boot.matches("[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}") || uid<0)
+            throw new IOException("Invalid recovery identity");
+        write("R1 ARMED "+boot+" "+app+" "+hash(journals)+" "+uid+"\n");
+    }
+    synchronized void begin(String boot,String app,int uid,String journals) throws IOException {
+        if(status(boot,app,uid,false)!=2 || !fields()[4].equals(hash(journals)))
+            throw new IOException("A marked kernel restart and unchanged journals are required");
+        write("R1 RUNNING "+boot+" "+app+" "+fields()[4]+" "+uid+"\n");
+    }
+    synchronized void requireRunning() {
+        if(failed || record==null || !record.startsWith("R1 RUNNING "))
+            throw new IllegalStateException("No recovery ticket");
+    }
+    synchronized void commit(SepMuxJournal.Store operation) throws IOException {
+        requireRunning();write(record.replace("RUNNING","COMMITTING"));
+        operation.writeDurably("L1 C\n");
+        write(record.replace("COMMITTING","DONE"));
+    }
+    private void write(String next) throws IOException {
+        // Poison memory before publication; failed I/O may never restore normal admission.
+        failed=true;record=next;store.writeDurably(next);failed=false;
+    }
+}
diff --git a/src/com/android/internal/telephony/honor/LpaRecoveryRead.java b/src/com/android/internal/telephony/honor/LpaRecoveryRead.java
new file mode 100644
index 0000000000000000000000000000000000000000..20eee9ca95c1a63fd547dff4dffe6d362cef119b
--- /dev/null
+++ b/src/com/android/internal/telephony/honor/LpaRecoveryRead.java
@@ -0,0 +1,53 @@
+/* Copyright (C) 2026 The LineageOS Project. SPDX-License-Identifier: Apache-2.0 */
+package com.android.internal.telephony.honor;
+
+/** Two fixed reads on one new channel. GET RESPONSE is authorized only by the preceding SW1=61. */
+final class LpaRecoveryRead {
+    private int stage,more=-1;
+    private boolean pending;
+    private final java.io.ByteArrayOutputStream bytes=new java.io.ByteArrayOutputStream();
+    private final String eid;
+    LpaRecoveryRead(String eid) {this.eid=eid;}
+    void request(byte[] command,int channel) {
+        if(pending || stage>=2 || command==null || channel<=0 || channel>19)
+            throw new IllegalStateException("No recovery read");
+        int cla=0x80|(channel&15);
+        byte[] expected=more>=0 ? new byte[]{(byte)cla,(byte)0xc0,0,0,(byte)more}
+                : stage==0 ? new byte[]{(byte)cla,(byte)0xe2,(byte)0x91,0,6,(byte)0xbf,0x3e,3,0x5c,1,0x5a}
+                : new byte[]{(byte)cla,(byte)0xe2,(byte)0x91,0,3,(byte)0xbf,0x2d,0};
+        if(!java.util.Arrays.equals(command,expected)) throw new IllegalArgumentException("Recovery permits only EID/profile reads");
+        pending=true;more=-1;
+    }
+    void response(byte[] data) {
+        if(!pending || data==null || data.length<2 || bytes.size()+data.length>65536)
+            throw new IllegalStateException("Unknown recovery response");
+        pending=false;bytes.write(data,0,data.length-2);
+        int sw1=data[data.length-2]&255,sw2=data[data.length-1]&255;
+        if(sw1==0x61) {more=sw2;return;}
+        if(sw1!=0x90 || sw2!=0) throw new IllegalStateException("Card read rejected");
+        byte[] body=bytes.toByteArray();
+        int[] outer=tlv(body,0,stage==0 ? 0xbf3e : 0xbf2d);
+        if(outer[1]!=body.length) throw new IllegalArgumentException("Trailing read data");
+        int[] inner=tlv(body,outer[0],stage==0 ? 0x5a : 0xa0);
+        if(inner[1]!=outer[1]) throw new IllegalArgumentException("Unexpected read response");
+        if(stage==0 && (inner[1]-inner[0]!=16
+                || !java.util.HexFormat.of().formatHex(java.util.Arrays.copyOfRange(body,inner[0],inner[1])).equals(eid)))
+            throw new IllegalArgumentException("Live card identity mismatch");
+        bytes.reset();stage++;
+    }
+    private static int[] tlv(byte[] data,int offset,int tag) {
+        int count=tag>255 ? 2 : 1;
+        if(offset+count>=data.length) throw new IllegalArgumentException("Short DER");
+        for(int i=count-1;i>=0;i--) if((data[offset++]&255)!=((tag>>(8*i))&255))
+            throw new IllegalArgumentException("Wrong DER tag");
+        int length=data[offset++]&255;
+        if((length&128)!=0) {
+            int n=length&127;
+            if(n<1 || n>2 || offset+n>data.length) throw new IllegalArgumentException("Invalid DER length");
+            length=0;while(n-->0) length=(length<<8)|(data[offset++]&255);
+        }
+        if(length>data.length-offset) throw new IllegalArgumentException("Truncated DER");
+        return new int[]{offset,offset+length};
+    }
+    boolean complete() {return stage==2 && !pending && more<0;}
+}
