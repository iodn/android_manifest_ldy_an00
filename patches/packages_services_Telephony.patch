index 0000000000000000000000000000000000000000..689dd2e6a0d0de8b9ffff241fc3be46f7bb2cc98
--- /dev/null
+++ b/src/com/android/internal/telephony/honor/MtkSimSerials.java
@@ -0,0 +1,43 @@
+/* Copyright (C) 2026 The LineageOS Project. SPDX-License-Identifier: Apache-2.0 */
+package com.android.internal.telephony.honor;
+
+import java.io.IOException;
+
+/**
+ * One live owner per store. Reserves positive serials durably before any radio dispatch, so a new
+ * phone process cannot reuse an identity still pending in the radio. Never reset on process death,
+ * elapsed time, a query timeout or an absent file unless initial history is independently qualified.
+ */
+public final class MtkSimSerials {
+    private final SepMuxJournal.Store store;
+    private int last;
+    private boolean failed;
+
+    public MtkSimSerials(SepMuxJournal.Store store, boolean qualifiedInitialHistory)
+            throws IOException {
+        this.store = store;
+        String record = store.read();
+        if (record == null) {
+            if (!qualifiedInitialHistory) throw new IOException("Missing MTK serial history");
+            last = 0;
+        } else {
+            // Only allocated serials are persisted; the initial zero is never a stored record.
+            if (!record.matches("MTKSEQ1 [1-9][0-9]*\n")) {
+                throw new IOException("Corrupt MTK serial history");
+            }
+            try { last = Integer.parseInt(record.substring(8, record.length() - 1)); }
+            catch (NumberFormatException e) { throw new IOException("MTK serial range invalid", e); }
+        }
+    }
+
+    public synchronized int allocate() throws IOException {
+        if (failed) throw new IOException("MTK serial allocator failed");
+        if (last == Integer.MAX_VALUE) throw new IOException("MTK serial identities exhausted");
+        int next = last + 1;
+        failed = true; // Any uncertain publication poisons this instance, before I/O begins.
+        store.writeDurably("MTKSEQ1 " + next + "\n");
+        last = next;
+        failed = false;
+        return next; // The caller may dispatch only after this return.
+    }
+}
diff --git a/src/com/android/internal/telephony/honor/MtkSimTypeQuery.java b/src/com/android/internal/telephony/honor/MtkSimTypeQuery.java
new file mode 100644
index 0000000000000000000000000000000000000000..5c1689724c8a31e80cdf9c37ded205ccdfe71a7b
--- /dev/null
+++ b/src/com/android/internal/telephony/honor/MtkSimTypeQuery.java
@@ -0,0 +1,68 @@
+/* Copyright (C) 2026 The LineageOS Project. SPDX-License-Identifier: Apache-2.0 */
+package com.android.internal.telephony.honor;
+
+/**
+ * One owner-thread, read-only query. Before dispatch, the caller durably allocates a serial that
+ * is not reused across phone-process restarts while the radio may retain an older request. The
+ * local generation is not sent on the wire and cannot replace that requirement. The owner permits
+ * only one in-flight query and uses the monotonic elapsed-realtime clock. A known result is a
+ * point-in-time observation, not authorization to switch a card or proof that an earlier unknown operation has completed.
+ */
+public final class MtkSimTypeQuery {
+    public enum State { WAITING, PHYSICAL, EUICC, UNQUALIFIED, UNKNOWN }
+
+    private final long generation;
+    private final int serial;
+    private final long deadlineMillis;
+    private State state = State.WAITING;
+
+    public MtkSimTypeQuery(long generation, int serial, long deadlineMillis) {
+        if (generation <= 0 || serial <= 0 || deadlineMillis <= 0) {
+            throw new IllegalArgumentException("Positive query identity and deadline required");
+        }
+        this.generation = generation;
+        this.serial = serial;
+        this.deadlineMillis = deadlineMillis;
+    }
+
+    public State state() { return state; }
+    int serial() {return serial;}
+    boolean current(long epoch,long now) {return generation==epoch && now>=0 && now<deadlineMillis
+            && (state==State.PHYSICAL || state==State.EUICC);}
+    /** Caller owns the newly allocated query and its admission deadline; no raw TLV provenance. */
+    boolean physicalFor(long epoch) {return generation==epoch && state==State.PHYSICAL;}
+
+    /** Raw selector value, or -1 when this query has no qualified result. */
+    public int mode() {
+        return state == State.PHYSICAL ? 0 : state == State.EUICC ? 1 : -1;
+    }
+
+    /** Transport ACK delivery/acknowledgement belongs to the owner, independently of this model. */
+    public void onResponse(long generation, int serial, int responseType, int rilError,
+            int support, int mode, int reserved, long nowMillis) {
+        if (state != State.WAITING || generation != this.generation || serial != this.serial) return;
+        if (nowMillis >= deadlineMillis) {
+            state = State.UNKNOWN;
+            return;
+        }
+        if (responseType == 1) return; // SOLICITED_ACK is not a final result.
+        if ((responseType != 0 && responseType != 2) || rilError != 0) {
+            state = State.UNKNOWN;
+            return;
+        }
+        // Stock MIPC failures/missing fields can return [0,0,0] with outer RIL success.
+        // support == 1 is a conservative acceptance policy, not an invented support bitmask.
+        if (support != 1 || (mode != 0 && mode != 1) || reserved != 0) {
+            state = State.UNQUALIFIED;
+            return;
+        }
+        state = mode == 0 ? State.PHYSICAL : State.EUICC;
+    }
+
+    public void expire(long nowMillis) {
+        if (state == State.WAITING && nowMillis >= deadlineMillis) state = State.UNKNOWN;
+    }
+
+    /** Owner death, transport failure or explicit retirement invalidates even a completed result. */
+    public void unavailable() { state = State.UNKNOWN; }
+}
diff --git a/src/com/android/internal/telephony/honor/MtkSimTypeTransport.java b/src/com/android/internal/telephony/honor/MtkSimTypeTransport.java
