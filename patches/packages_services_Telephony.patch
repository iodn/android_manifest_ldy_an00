--- /dev/null
+++ b/src/com/android/internal/telephony/honor/HonorMtkCallEndDecoder.java
@@ -0,0 +1,36 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.internal.telephony.honor;
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+
+/** Inner event105 on the existing outer hncall1/1001 subscription; never a new native client. */
+final class HonorMtkCallEndDecoder {
+    record Report(int slot, Integer cause, boolean known) {}
+    private HonorMtkCallEndDecoder() {}
+    static Report decode(int slot, int outerVersion, int messageId, byte[] payload) {
+        if (slot < 0 || slot > 1 || (messageId != 1 && messageId != 1001)
+                || payload == null || payload.length < 4) return null;
+        ByteBuffer b=ByteBuffer.wrap(payload).order(ByteOrder.LITTLE_ENDIAN);
+        if (b.getInt()!=105) return null;
+        if (outerVersion!=1 || payload.length<24 || b.getInt()!=1) {
+            return new Report(slot,null,false);
+        }
+        int sip=b.getInt(),emm=b.getInt(),rrc=b.getInt(),vdm=b.getInt();
+        if (!normalSip(sip)) return new Report(slot,sip,true);
+        try {
+            Integer cause=emm!=0 ? Math.addExact(100000,emm)
+                    : rrc!=0 ? Math.addExact(200000,rrc)
+                    : vdm!=0 ? Math.addExact(300000,vdm) : null;
+            return new Report(slot,cause,true);
+        } catch (ArithmeticException overflow) {
+            return new Report(slot,null,false);
+        }
+    }
+    private static boolean normalSip(int code) {
+        return code==0 || code==-1 || code==31 || code==1001 || code==16 || code==65535
+                || code==18 || code>=180&&code<=200 || code==1 || code==17 || code==19;
+    }
+}
diff --git a/src/com/android/internal/telephony/honor/HonorMtkCallInfoDecoder.java b/src/com/android/internal/telephony/honor/HonorMtkCallInfoDecoder.java
new file mode 100644
index 0000000000000000000000000000000000000000..750adb6e8c805502f9210b0f69336991b8603ef6
--- /dev/null
+++ b/src/com/android/internal/telephony/honor/HonorMtkCallInfoDecoder.java
@@ -0,0 +1,79 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.internal.telephony.honor;
+
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+
+/** Strict decoder for reviewed hncall message 1/1001, event 101, version 1.
+ * Does not interpret SIP, construct a complete call table, or infer HOLD from status 1009.
+ */
+public final class HonorMtkCallInfoDecoder {
+    private HonorMtkCallInfoDecoder() {}
+
+    public static final class CallUpdate {
+        public final int slot, rawCallId, direction, rawDomain, rawStatus;
+        public final int callType, endReason, sessionId, callId;
+        public final HonorCallQosPolicy.Domain domain;
+        public final HonorCallQosPolicy.Status status;
+        public final boolean emergency, srvcc;
+
+        private CallUpdate(int slot, int[] words) {
+            this.slot = slot;
+            rawCallId = words[2];
+            direction = words[3];
+            rawDomain = words[4];
+            rawStatus = words[5];
+            callType = words[6];
+            endReason = words[7];
+            sessionId = words[8];
+            boolean initial = rawStatus == 1000 && sessionId == 0;
+            callId = initial ? rawCallId : rawCallId - 1;
+            int effectiveStatus = initial ? (direction == 0 ? 1001 : 1004) : rawStatus;
+            status = status(effectiveStatus);
+            domain = domain(rawDomain);
+            emergency = (callType >= 81 && callType <= 92) || callType == 99
+                    || (callType >= 201 && callType <= 205);
+            srvcc = endReason == 5;
+        }
+    }
+
+    /** Return null for an unreviewed envelope, payload version, or payload size. */
+    public static CallUpdate decode(int slot, int outerVersion, int messageId, byte[] payload) {
+        if (slot < 0 || slot >= 2 || outerVersion != 1
+                || (messageId != 1 && messageId != 1001)
+                || payload == null || payload.length != 36) return null;
+        ByteBuffer buffer = ByteBuffer.wrap(payload).order(ByteOrder.LITTLE_ENDIAN);
+        int[] words = new int[9];
+        for (int i = 0; i < words.length; i++) words[i] = buffer.getInt();
+        if (words[0] != 101 || words[1] != 1) return null;
+        return new CallUpdate(slot, words);
+    }
+
+    private static HonorCallQosPolicy.Status status(int value) {
+        switch (value) {
+            case 1001: case 1002: return HonorCallQosPolicy.Status.STARTING;
+            case 1003: case 1004: case 1005: case 1006: case 1007:
+                return HonorCallQosPolicy.Status.ALERTING;
+            case 1008: case 1009: return HonorCallQosPolicy.Status.CONNECT;
+            case 1000: case 1010: case 1011: case 1012:
+                return HonorCallQosPolicy.Status.DISCONNECTED;
+            default: return null;
+        }
+    }
+
+    private static HonorCallQosPolicy.Domain domain(int value) {
+        switch (value) {
+            case 2: case 3: case 4: case 5: case 6: case 7:
+                return HonorCallQosPolicy.Domain.VOWIFI;
+            case 8: case 9: case 10: case 11: case 18: case 19: case 20:
+                return HonorCallQosPolicy.Domain.CS;
+            case 12: case 13: return HonorCallQosPolicy.Domain.VOLTE;
+            case 14: case 15: case 16: case 17: return HonorCallQosPolicy.Domain.VONR;
+            case 21: case 22: case 23: case 24: return HonorCallQosPolicy.Domain.VODATA;
+            default: return HonorCallQosPolicy.Domain.INVALID;
+        }
+    }
+}
diff --git a/src/com/android/internal/telephony/honor/HonorMtkImsDefaultOpenDecoder.java b/src/com/android/internal/telephony/honor/HonorMtkImsDefaultOpenDecoder.java
new file mode 100644
index 0000000000000000000000000000000000000000..ceb18f77e4ed3f17ab820f71e7fe6ea0a6ee0120
--- /dev/null
+++ b/src/com/android/internal/telephony/honor/HonorMtkImsDefaultOpenDecoder.java
@@ -0,0 +1,37 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.internal.telephony.honor;
+
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+
+/** Raw modem default-open report; platform/carrier policy is deliberately separate. */
+public final class HonorMtkImsDefaultOpenDecoder {
+    private HonorMtkImsDefaultOpenDecoder() {}
+
+    public record Report(int slot, int type) {
+        /** 0..3 are modem feature bits. Error reports 100/101 never become disabled bits. */
+        public int featureBits() {
+            return type >= 0 && type <= 3 ? type : -1;
+        }
+
+        public boolean isMbnLookupFailure() {
+            return type == 100 || type == 101;
+        }
+    }
+
+    /** Stock reads the first word; no additional payload version word exists here. */
+    public static Report decode(int slot, int outerVersion, int messageId, byte[] payload) {
+        if (slot < 0 || slot >= 2 || outerVersion != 1 || messageId != 1002
+                || payload == null || payload.length < 4) {
+            return null;
+        }
+        int type = ByteBuffer.wrap(payload).order(ByteOrder.LITTLE_ENDIAN).getInt();
+        if ((type < 0 || type > 3) && type != 100 && type != 101) {
+            return null;
+        }
+        return new Report(slot, type);
+    }
+}
diff --git a/src/com/android/internal/telephony/honor/HonorMtkSimTypeProbeOwner.java b/src/com/android/internal/telephony/honor/HonorMtkSimTypeProbeOwner.java
new file mode 100644
index 0000000000000000000000000000000000000000..f5d365c0dcbc58fc95f93ba854969a1ad6742433
--- /dev/null
+++ b/src/com/android/internal/telephony/honor/HonorMtkSimTypeProbeOwner.java
@@ -0,0 +1,237 @@
+/* Copyright (C) 2026 The LineageOS Project. SPDX-License-Identifier: Apache-2.0 */
+package com.android.internal.telephony.honor;
+
+import android.app.Application;
+import android.os.Build;
+import android.os.Handler;
+import android.os.HandlerThread;
+import android.os.IBinder;
+import android.os.Looper;
+import android.os.Process;
+import android.os.SELinux;
+import android.os.ServiceManager;
+import android.os.SystemClock;
+import com.android.internal.telephony.PhoneFactory;
+import com.android.phone.PhoneGlobals;
+import java.util.Objects;
+import java.util.concurrent.atomic.AtomicBoolean;
+import java.util.function.Consumer;
+
+/** Explicit, one-query Phone-process compatibility probe. Never selects a SIM or opens an APDU. */
+public final class HonorMtkSimTypeProbeOwner extends Handler
+        implements MtkSimTypeTransport.Listener {
+    // Explicit compatibility GET only. Final image audit and approved fresh-boot trial remain
+    // external installation gates; this switch does not attest ownership of an arbitrary image.
+    private static final boolean CONTROLLED_COMPATIBILITY_PROBE_ENABLED=true;
+    private static final long QUERY_TIMEOUT_MS=10_000, REPLY_TIMEOUT_MS=2_000;
+    public enum Preparation { NOT_ATTEMPTED, PREPARING, PREPARED, FAILED }
+    public enum Phase { PREPARED, WAITING, PHYSICAL, EUICC, UNQUALIFIED, UNKNOWN, UNAVAILABLE }
+    /** Diagnostic observation only; never authorizes a setter, profile operation or LPA handoff. */
+    public record Snapshot(long generation,int serial,Phase phase,int mode) {}
+    private static final class PreparationRefused extends IllegalStateException {
+        final String reason;
+        PreparationRefused(String reason) {super(reason);this.reason=reason;}
+    }
+    private static volatile HonorMtkSimTypeProbeOwner instance;
+    private static volatile Preparation preparation=Preparation.NOT_ATTEMPTED;
+    private static boolean prepareAttempted;
+    private final MtkSimSerials serials;
+    private final MtkSimTypeTransport transport;
+    private final AtomicBoolean failed=new AtomicBoolean(), queryRequested=new AtomicBoolean();
+    private volatile long generation=1;
+    private MtkSimTypeQuery query;
+    private int querySerial, diagnosticWrites;
+
+    public static HonorMtkSimTypeProbeOwner existingOwner() {return instance;}
+    public static Preparation preparation() {return preparation;}
+
+    /** Initial-history qualification must come from the controlled trial, never an Intent extra. */
+    public static synchronized void prepareAsync(boolean initialHistoryQualified,
+            Consumer<HonorMtkSimTypeProbeOwner> ready,Consumer<String> rejected) {
+        Objects.requireNonNull(ready);Objects.requireNonNull(rejected);
+        if(prepareAttempted) throw new IllegalStateException("Probe preparation already attempted");
+        prepareAttempted=true;preparation=Preparation.PREPARING;
+        Handler main=new Handler(Looper.getMainLooper());
+        HandlerThread thread=new HandlerThread("LdyAn00SimTypeProbe");thread.start();
+        Handler worker=new Handler(thread.getLooper());
+        if(!worker.post(()->{
+            // 1 build, 2 Phone identity, 3 journal, 4 serial history, 5 service lookup,
+            // 6 transport identity/worker, 7 callback registration, 8 owner publication.
+            int stage=1;
+            try {
+                requireControlledProbeBuild(); // BEFORE storage, remote metadata or callback registration.
+                stage=2;requirePhoneProcess();
+                stage=3;
+                new SepMuxJournal(new AtomicSepMuxStore(PhoneGlobals.getInstance())).requireClean();
+                stage=4;
+                MtkSimSerials serials=new MtkSimSerials(
+                        AtomicSepMuxStore.forMtkSerials(PhoneGlobals.getInstance()),
+                        initialHistoryQualified);
+                stage=5;
+                IBinder remote=ServiceManager.checkService(
+                        MtkSimTypeTransport.DESCRIPTOR+"/slot2");
+                if(remote==null) throw new PreparationRefused("SERVICE_UNAVAILABLE");
+                stage=6;
+                HonorMtkSimTypeProbeOwner owner=new HonorMtkSimTypeProbeOwner(
+                        thread.getLooper(),serials,remote);
+                stage=7;
+                owner.transport.registerCallbacks(); // Mutates callback ownership; once per process.
+                stage=8;
+                instance=owner;preparation=Preparation.PREPARED;
+                main.post(()->{
+                    if(owner.healthy()) ready.accept(owner);
+                    else rejected.accept("Probe owner unavailable; no retry");
+                });
+            } catch(Exception e) {
+                preparation=Preparation.FAILED;
+                int failedStage=stage;
+                String reason=e instanceof PreparationRefused
+                        ? ((PreparationRefused)e).reason : "OTHER";
+                // At most once per attempt; fixed local reason, no exception message or stack.
+                android.util.Log.w("LdyMtkSimProbe","prepare_stage="+failedStage+" reason="+reason
+                        +" exception="+e.getClass().getSimpleName());
+                main.post(()->rejected.accept("Probe preparation refused at stage "+failedStage
+                        +" ("+reason+"): "+e.getClass().getSimpleName()));
+            }
+            // Keep the worker alive even after uncertain registration; never rebind or unregister.
+        })) {
+            preparation=Preparation.FAILED;
+            main.post(()->rejected.accept("Probe worker unavailable; no retry"));
+        }
+    }
+    private HonorMtkSimTypeProbeOwner(Looper looper,MtkSimSerials serials,IBinder remote)
+            throws android.os.RemoteException {
+        super(looper);this.serials=serials;
+        transport=new MtkSimTypeTransport(remote,this,this);
+    }
+    private static void requireControlledProbeBuild() {
+        if(!CONTROLLED_COMPATIBILITY_PROBE_ENABLED)
+            throw new PreparationRefused("BUILD_DISABLED");
+    }
+    private static void requirePhoneProcess() {
+        if(!"LDY-AN00".equals(Build.MODEL) || !"ldy_an00".equals(Build.DEVICE))
+            throw new PreparationRefused("DEVICE_IDENTITY");
+        if(!"userdebug".equals(Build.TYPE)) throw new PreparationRefused("BUILD_TYPE");
+        if(Process.myUid()!=1001) throw new PreparationRefused("UID");
+        if(!"com.android.phone".equals(Application.getProcessName()))
+            throw new PreparationRefused("PROCESS_NAME");
+        if(!"u:r:radio:s0".equals(SELinux.getContext()))
+            throw new PreparationRefused("SELINUX_DOMAIN");
+        if(!SELinux.isSELinuxEnforced()) throw new PreparationRefused("SELINUX_ENFORCING");
+        if(PhoneFactory.getPhones()==null || PhoneFactory.getPhones().length!=2)
+            throw new PreparationRefused("PHONE_COUNT");
+        if(PhoneFactory.getPhone(0)==null || PhoneFactory.getPhone(0).mCi==null)
+            throw new PreparationRefused("PHONE_0");
+        if(PhoneFactory.getPhone(1)==null || PhoneFactory.getPhone(1).mCi==null)
+            throw new PreparationRefused("PHONE_1");
+    }
+    private void requireWorker() {
+        if(Looper.myLooper()!=getLooper()) throw new IllegalStateException("Owner worker required");
+    }
+    private boolean healthy() {
+        return !failed.get() && transport.isHealthy() && getLooper().getThread().isAlive()
+                && SELinux.isSELinuxEnforced();
+    }
+    private void invalidate() {
+        requireWorker();
+        if(query!=null) query.unavailable();
+        if(generation==Long.MAX_VALUE) failed.set(true);else generation++;
+    }
+    private void stop() {
+        failed.set(true); // Immediate fence is observable without queued worker cleanup.
+        if(Looper.myLooper()==getLooper()) invalidate();
+    }
+
+    /** One explicit GET only. A refused/failed attempt cannot be retried in this owner. */
+    public void queryOnce() {
+        if(!healthy()) throw new IllegalStateException("Probe owner unavailable");
+        if(!queryRequested.compareAndSet(false,true))
+            throw new IllegalStateException("Probe query already attempted");
+        if(!post(()->{
+            try {
+                requireWorker();requireControlledProbeBuild();requirePhoneProcess();
+                if(instance!=this || !healthy()) throw new IllegalStateException("Probe owner lost");
+                querySerial=serials.allocate(); // Durable reservation BEFORE any remote request.
+                if(!healthy()) {stop();return;} // Recheck after potentially blocking durable I/O.
+                long now=SystemClock.elapsedRealtime();
+                query=new MtkSimTypeQuery(generation,querySerial,now+QUERY_TIMEOUT_MS);
+                MtkSimTypeQuery pending=query;
+                if(!postDelayed(()->pending.expire(SystemClock.elapsedRealtime()),QUERY_TIMEOUT_MS)) {
+                    stop();return;
+                }
+                transport.query(querySerial); // No select(), profile API or APDU path.
+            } catch(Exception e) {stop();}
+        })) stop();
+    }
+    @Override public void queryResult(int type,int serial,int error,int support,int mode,int reserved) {
+        requireWorker();
+        if(!healthy()) {stop();return;}
+        if(query!=null && serial==querySerial && diagnosticWrites<4) {
+            diagnosticWrites++; // Numeric fields only, bounded to this one explicitly requested query.
+            android.util.Log.i("LdyMtkSimProbe","type="+type+" serial="+serial+" error="+error
+                    +" support="+support+" mode="+mode+" value2="+reserved);
+        }
+        if(query!=null) query.onResponse(generation,serial,type,error,support,mode,reserved,
+                SystemClock.elapsedRealtime()); // Fresh execution time, never Binder receipt time.
+    }
+    @Override public void switchResult(int type,int serial,int error) {
+        requireWorker();stop(); // This probe never sends a setter; such a reply is not ours.
+    }
+    @Override public void simTypeChanged(int support,int mode,int reserved) {
+        requireWorker();invalidate(); // Advisory only; never manufacture a known result.
+    }
+    @Override public void unavailable() {requireWorker();stop();}
+
+    /** Bounded worker roundtrip for display; a snapshot is not authorization for any handoff. */
+    public void requestSnapshot(Consumer<Snapshot> ready,Consumer<String> rejected) {
+        Objects.requireNonNull(ready);Objects.requireNonNull(rejected);
+        Handler main=new Handler(Looper.getMainLooper());
+        AtomicBoolean delivered=new AtomicBoolean();
+        long deadline=SystemClock.elapsedRealtime()+REPLY_TIMEOUT_MS;
+        Runnable timeout=()->{
+            if(delivered.compareAndSet(false,true)) {
+                stop();rejected.accept("Probe worker reply timed out; no retry");
+            }
+        };
+        main.postDelayed(timeout,REPLY_TIMEOUT_MS);
+        if(!post(()->{
+            Snapshot value;
+            try {
+                requireWorker();requirePhoneProcess();
+                value=snapshot();
+            } catch(RuntimeException e) {
+                stop();value=new Snapshot(generation,querySerial,Phase.UNAVAILABLE,-1);
+            }
+            Snapshot captured=value;
+            if(!main.post(()->{
+                if(!delivered.compareAndSet(false,true)) return;
+                main.removeCallbacks(timeout);
+                if(SystemClock.elapsedRealtime()>=deadline || !healthy()
+                        || generation!=captured.generation()) {
+                    rejected.accept("Probe snapshot unavailable or obsolete");
+                } else ready.accept(captured);
+            })) stop();
+        })) {
+            stop();
+            main.post(()->{
+                if(delivered.compareAndSet(false,true)) {
+                    main.removeCallbacks(timeout);rejected.accept("Probe worker unavailable");
+                }
+            });
+        }
+    }
+    private Snapshot snapshot() {
+        requireWorker();
+        if(!healthy()) return new Snapshot(generation,querySerial,Phase.UNAVAILABLE,-1);
+        if(query==null) return new Snapshot(generation,0,Phase.PREPARED,-1);
+        query.expire(SystemClock.elapsedRealtime());
+        Phase phase=switch(query.state()) {
+            case WAITING -> Phase.WAITING;
+            case PHYSICAL -> Phase.PHYSICAL;
+            case EUICC -> Phase.EUICC;
+            case UNQUALIFIED -> Phase.UNQUALIFIED;
+            case UNKNOWN -> Phase.UNKNOWN;
+        };
+        return new Snapshot(generation,querySerial,phase,query.mode());
+    }
+}
diff --git a/src/com/android/internal/telephony/honor/HonorMtkSipDecoder.java b/src/com/android/internal/telephony/honor/HonorMtkSipDecoder.java
new file mode 100644
index 0000000000000000000000000000000000000000..8b09629ffd293955dd04aa0cc27b32e8471408ab
--- /dev/null
+++ b/src/com/android/internal/telephony/honor/HonorMtkSipDecoder.java
@@ -0,0 +1,67 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.internal.telephony.honor;
+
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.nio.charset.StandardCharsets;
+import java.util.Locale;
+
+/** Only SIP event fields that affect stock call-table reconciliation. No SIP message is retained. */
+public final class HonorMtkSipDecoder {
+    private HonorMtkSipDecoder() {}
+
+    public static final class SipUpdate {
+        public final int slot, type, direction, code;
+        public final String sipCallId;
+        public final boolean initialInvite;
+        public final HonorCallQosPolicy.Domain domain;
+
+        private SipUpdate(int slot, int type, int direction, int code, String id, String message) {
+            this.slot = slot;
+            this.type = type;
+            this.direction = direction;
+            this.code = code;
+            sipCallId = id;
+            boolean initial = false;
+            HonorCallQosPolicy.Domain pani = null;
+            String headers = message.split("\\r\\n\\r\\n", 2)[0];
+            for (String line : headers.split("\\r?\\n")) {
+                String[] parts = line.split(": ");
+                if (parts.length == 0) continue;
+                String name = parts[0].toLowerCase(Locale.ROOT);
+                if ((name.equals("to") || name.equals("t"))
+                        && !line.toLowerCase(Locale.ROOT).contains("tag")) initial = true;
+                if (name.equals("p-access-network-info")) {
+                    pani = null;
+                    String lower = line.toLowerCase(Locale.ROOT);
+                    if (lower.contains("nr")) pani = HonorCallQosPolicy.Domain.VONR;
+                    else if (lower.contains("3gpp")) pani = HonorCallQosPolicy.Domain.VOLTE;
+                    else if (lower.contains("ieee")) pani = HonorCallQosPolicy.Domain.VOWIFI;
+                }
+            }
+            initialInvite = initial && type == 1 && code == 0;
+            domain = pani;
+        }
+    }
+
+    /** Strict version-1 format, with checked lengths before either string allocation. */
+    public static SipUpdate decode(int slot, int outerVersion, int messageId, byte[] payload) {
+        if (slot < 0 || slot >= 2 || outerVersion != 1
+                || (messageId != 1 && messageId != 1001)
+                || payload == null || payload.length < 28) return null;
+        ByteBuffer b = ByteBuffer.wrap(payload).order(ByteOrder.LITTLE_ENDIAN);
+        if (b.getInt() != 100 || b.getInt() != 1) return null;
+        int type = b.getInt(), direction = b.getInt(), code = b.getInt();
+        int idLength = b.getInt(), messageLength = b.getInt();
+        if (type < 0 || type > 13 || direction < 0 || direction > 1
+                || idLength < 0 || messageLength < 0
+                || (long) idLength + messageLength != b.remaining()) return null;
+        String id = new String(payload, 28, idLength, StandardCharsets.US_ASCII).trim();
+        String message = new String(payload, 28 + idLength, messageLength,
+                StandardCharsets.US_ASCII).trim();
+        return new SipUpdate(slot, type, direction, code, id, message);
+    }
+}
diff --git a/src/com/android/internal/telephony/honor/HonorMtkStateSync.java b/src/com/android/internal/telephony/honor/HonorMtkStateSync.java
new file mode 100644
index 0000000000000000000000000000000000000000..c780489a437c5a4933af83c6e399710043476052
--- /dev/null
+++ b/src/com/android/internal/telephony/honor/HonorMtkStateSync.java
@@ -0,0 +1,402 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.internal.telephony.honor;
+
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+import android.content.IntentFilter;
+import android.hardware.display.DisplayManager;
+import android.os.Build;
+import android.os.AsyncResult;
+import android.os.Handler;
+import android.os.HandlerThread;
+import android.os.IBinder;
+import android.os.IServiceCallback;
+import android.os.ServiceManager;
+import android.telephony.SubscriptionManager;
+import android.telephony.TelephonyManager;
+import android.util.Log;
+import android.view.Display;
+
+import com.android.internal.telephony.Phone;
+import com.android.internal.telephony.PhoneConfigurationManager;
+import com.android.internal.telephony.PhoneFactory;
+import com.android.internal.telephony.TelephonyIntents;
+import com.android.internal.telephony.data.DataSettingsManager;
+import com.android.internal.telephony.uicc.IccRecords;
+import com.android.internal.telephony.uicc.UiccController;
+
+import java.util.Arrays;
+import java.util.Random;
+
+/** Stock MTK state notifications only; never selects a SIM or changes Android data settings. */
+public final class HonorMtkStateSync implements MtkAssistTransport.Listener {
+    private static final String TAG = "LdyAn00Assist";
+    private static final long RESPONSE_TIMEOUT_MS = 15_000;
+    private static volatile HonorMtkStateSync instance;
+    private final Context context;
+    private final Handler handler;
+    private final Handler connections;
+    private final MtkAssistSyncState state = new MtkAssistSyncState();
+    private final MtkAssistVoipController voip;
+    private final MtkAssistTransport[] transports = new MtkAssistTransport[2];
+    private final IBinder[] rejected = new IBinder[2], endpoints = new IBinder[2];
+    private final IBinder[] announced = new IBinder[2];
+    private final long[] generations = new long[2];
+    private final boolean[] connecting = new boolean[2], radioAvailable = new boolean[2];
+    private final boolean[] retryBlocked = new boolean[2];
+    private final DataSettingsManager.DataSettingsManagerCallback[] dataCallbacks =
+            new DataSettingsManager.DataSettingsManagerCallback[2];
+    private Phone[] phones = new Phone[0];
+    private int nextSerial = new Random().nextInt(0x3fffffff) + 1;
+    private boolean queued;
+    private boolean stopped;
+
+    private static final int ICC_CHANGED=3, RECORDS_LOADED=20;
+    private final IccRecords[] watchedRecords=new IccRecords[2];
+    private MtkAssistProfile[] observedProfiles=new MtkAssistProfile[0];
+    private void watchRecords(MtkAssistProfile[] profiles) {
+        for(int i=0;i<watchedRecords.length;i++) {
+            IccRecords records=i<profiles.length ? profiles[i].profileRecords : null;
+            if(records==watchedRecords[i])continue;
+            if(watchedRecords[i]!=null)watchedRecords[i].unregisterForRecordsLoaded(handler);
+            watchedRecords[i]=records;
+            if(records!=null)records.registerForRecordsLoaded(handler,RECORDS_LOADED+i,records);
+        }
+    }
+    public static void initialize(Context context) {
+        if (!"LDY-AN00".equals(Build.MODEL) || !"ldy_an00".equals(Build.DEVICE)) {
+            return;
+        }
+        // A stock owner must never compete for the dedicated Assist response slot.
+        try {
+            context.getPackageManager().getApplicationInfo("com.mediatek.telephony", 0);
+            return;
+        } catch (android.content.pm.PackageManager.NameNotFoundException expected) {
+            // This source-owned controller replaces the absent stock Assist package.
+        }
+        UiccController.getInstance().post(() -> {
+            if (instance == null) {
+                try {
+                    HonorRadioCommBroker.initialize(context.getApplicationContext());
+                } catch (IllegalStateException unavailable) {
+                    Log.w(TAG, "Radio owner unavailable; SCREEN remains independent");
+                }
+                boolean adoptionInitialized = false;
+                try {
+                    HonorSubscriberAdoption.initialize(context.getApplicationContext());
+                    adoptionInitialized = true;
+                } catch (IllegalStateException unavailable) {
+                    Log.w(TAG, "Subscriber admission unavailable; SCREEN remains independent");
+                }
+                instance = new HonorMtkStateSync(context);
+                if (adoptionInitialized)
+                    HonorSubscriberAdoption.addListener(instance.handler, instance::enqueue);
+            }
+        });
+    }
+    private HonorMtkStateSync(Context context) {
+        this.context = context.getApplicationContext();
+        handler = new Handler(UiccController.getInstance().getLooper(), message -> {
+            if(message.what==ICC_CHANGED) {enqueue();return true;}
+            if(message.what>=RECORDS_LOADED && message.what<RECORDS_LOADED+2) {
+                int slot=message.what-RECORDS_LOADED;
+                if(message.obj instanceof AsyncResult event && event.userObj==watchedRecords[slot])enqueue();
+                return true; // Sticky/old events request review; never prove profile adoption.
+            }
+            if (message.what >= 10 && message.what < 12) {
+                int phone = message.what - 10;
+                if (phone < phones.length) {
+                    boolean available = phones[phone].isRadioAvailable();
+                    if (available && !radioAvailable[phone]) {
+                        onRadioAvailable(phone);
+                    }
+                    radioAvailable[phone] = available;
+                }
+            }
+            externalEvent();
+            return true;
+        });
+        HandlerThread thread = new HandlerThread("LdyAn00AssistConnect");
+        thread.start();
+        connections = new Handler(thread.getLooper());
+        voip = new MtkAssistVoipController(this.context, handler, connections,
+                this::enqueue, this::externalEvent);
+        for (int slot = 0; slot < transports.length; slot++) {
+            final int phone = slot;
+            connections.post(() -> {
+                try {
+                    ServiceManager.registerForNotifications(
+                            MtkAssistTransport.DATA + "/slot" + (phone + 1),
+                            new IServiceCallback.Stub() {
+                                @Override public void onRegistration(String name, IBinder binder) {
+                                    handler.post(() -> {
+                                        announced[phone] = binder;
+                                        voip.dataServiceChanged(phone, binder);
+                                        if (transports[phone] != null
+                                                && endpoints[phone] != binder) {
+                                            generations[phone]++;
+                                            transports[phone].close();
+                                            transports[phone] = null;
+                                            connecting[phone] = false;
+                                            state.binding(phone, 0);
+                                        }
+                                        externalEvent();
+                                    });
+                                }
+                            });
+                } catch (android.os.RemoteException | RuntimeException unavailable) {
+                    Log.w(TAG, "Assist service notification unavailable for slot " + phone);
+                }
+            });
+        }
+        context.getSystemService(SubscriptionManager.class).addOnSubscriptionsChangedListener(
+                command -> handler.post(command),
+                new SubscriptionManager.OnSubscriptionsChangedListener() {
+                    @Override public void onSubscriptionsChanged() { externalEvent(); }
+                });
+        PhoneConfigurationManager.registerForMultiSimConfigChange(handler, 1, null);
+        context.getSystemService(DisplayManager.class).registerDisplayListener(
+                new DisplayManager.DisplayListener() {
+                    @Override public void onDisplayAdded(int id) { externalEvent(); }
+                    @Override public void onDisplayRemoved(int id) { externalEvent(); }
+                    @Override public void onDisplayChanged(int id) { externalEvent(); }
+                }, handler);
+        IntentFilter filter = new IntentFilter(TelephonyIntents.ACTION_DEFAULT_DATA_SUBSCRIPTION_CHANGED);
+        context.registerReceiver(new BroadcastReceiver() {
+            @Override public void onReceive(Context ignored, Intent intent) { externalEvent(); }
+        }, filter, null, handler);
+        UiccController.getInstance().registerForIccChanged(handler,ICC_CHANGED,null);
+        enqueue();
+    }
+    /** Route owners already publish this event after their operation settles. */
+    static void settled() {
+        HonorMtkStateSync owner = instance;
+        if (owner != null) owner.handler.post(() -> {
+            owner.state.invalidate();
+            owner.voip.invalidate();
+            owner.externalEvent();
+        });
+    }
+    /** Admission reopened; preserve acknowledged values and all transport/VoIP retry fences. */
+    static void admissionReady() {
+        HonorMtkStateSync owner=instance;
+        if(owner!=null)owner.handler.post(owner::enqueue);
+    }
+    // Retry transient failures only after an external state or service event.
+    private void externalEvent() {
+        Arrays.fill(retryBlocked, false);
+        voip.externalEvent();
+        enqueue();
+    }
+    private void enqueue() {
+        if (queued || stopped) return;
+        queued = true;
+        handler.post(() -> {
+            queued = false;
+            review();
+        });
+    }
+    private void onRadioAvailable(int phone) {
+        state.radioAvailable(phone);
+        voip.invalidate();
+    }
+    private void installPhones(Phone[] current) {
+        if (Arrays.equals(phones, current)) return;
+        for (int i = 0; i < phones.length; i++) {
+            phones[i].mCi.unregisterForRadioStateChanged(handler);
+            phones[i].getDataSettingsManager().unregisterCallback(dataCallbacks[i]);
+        }
+        phones = current.clone();
+        for (int i = 0; i < phones.length; i++) {
+            dataCallbacks[i] = new DataSettingsManager.DataSettingsManagerCallback(
+                    command -> handler.post(command)) {
+                @Override public void onUserDataEnabledChanged(boolean enabled, String caller) {
+                    externalEvent();
+                }
+                @Override public void onDataRoamingEnabledChanged(boolean enabled) { externalEvent(); }
+            };
+            phones[i].getDataSettingsManager().registerCallback(dataCallbacks[i]);
+            phones[i].mCi.registerForRadioStateChanged(handler, 10 + i, null);
+            radioAvailable[i] = false;
+        }
+        state.invalidate();
+        voip.invalidate();
+    }
+    private void review() {
+        Phone[] current = PhoneFactory.getPhones();
+        if (current == null || current.length == 0 || current.length > 2) return;
+        installPhones(current);
+        LpaOperationLease lease;
+        try {
+            lease = HonorLpaLeaseService.leases(context);
+            lease.setReadinessObserver(HonorRadioCommBroker::readinessChanged);
+        } catch (java.io.IOException | RuntimeException unavailable) {
+            return;
+        }
+        synchronized (lease) {
+            try {
+                lease.requirePolicyCycleQuiescent();
+            } catch (RuntimeException pendingRoute) {
+                return;
+            }
+            int active = context.getSystemService(TelephonyManager.class).getActiveModemCount();
+            if (active < 1 || active > phones.length) return;
+            int[] subscriptions = new int[active];
+            MtkAssistProfile[] profiles=MtkAssistProfile.capture(phones,active);
+            for (int i = 0; i < active; i++) {
+                subscriptions[i] = phones[i].getSubId();
+            }
+            observedProfiles=profiles;watchRecords(profiles);
+            state.topology(subscriptions, profiles);
+            boolean screen = false;
+            for (Display display : context.getSystemService(DisplayManager.class).getDisplays()) {
+                if (display.getState() == Display.STATE_ON) {
+                    screen = true;
+                }
+            }
+            int defaultSub = SubscriptionManager.getDefaultDataSubscriptionId();
+            int defaultPhone = -1;
+            for (int i = 0; i < active; i++) {
+                if (subscriptions[i] == defaultSub
+                        && SubscriptionManager.isValidSubscriptionId(defaultSub) && profiles[i].usable()
+                        && HonorSubscriberAdoption.isReady(i, profiles[i])) defaultPhone = i;
+                if (!phones[i].isRadioAvailable()) continue;
+                if (profiles[i].usable() && HonorSubscriberAdoption.isReady(i, profiles[i])) {
+                    DataSettingsManager settings = phones[i].getDataSettingsManager();
+                    state.data(i, settings.isDataEnabledForReason(
+                            TelephonyManager.DATA_ENABLED_REASON_USER), settings.isDataRoamingEnabled());
+                }
+                state.screen(i, screen);
+                if (transports[i] == null) connect(i);
+            }
+            if (defaultPhone >= 0) {
+                state.defaultData(defaultPhone);
+            } else {
+                state.clearDefaultData();
+            }
+            voip.review(subscriptions, profiles, defaultPhone, phones);
+            for (int i = 0; i < active; i++) {
+                if (!phones[i].isRadioAvailable()) continue;
+                MtkAssistTransport transport = transports[i];
+                if (transport == null || !transport.healthy()) continue;
+                boolean dataReady = HonorSubscriberAdoption.isReady(i, profiles[i]);
+                boolean defaultReady = defaultPhone >= 0
+                        && HonorSubscriberAdoption.isReady(defaultPhone, profiles[defaultPhone]);
+                MtkAssistSyncState.Notification request = state.next(i, true, dataReady, defaultReady);
+                if (request == null) continue;
+                // No asynchronous snapshot is used to dispatch on a changed subscription.
+                if (phones[i].getSubId() != subscriptions[i]
+                        || !MtkAssistProfile.current(profiles,phones,active)) continue;
+                if (request.kind() == MtkAssistSyncState.Kind.DATA
+                        && !HonorSubscriberAdoption.isReady(i, profiles[i])) continue;
+                if (request.kind() == MtkAssistSyncState.Kind.DEFAULT_DATA
+                        && (defaultPhone < 0
+                            || SubscriptionManager.getDefaultDataSubscriptionId()
+                                    != subscriptions[defaultPhone]
+                            || !HonorSubscriberAdoption.isReady(defaultPhone,
+                                    profiles[defaultPhone]))) continue;
+                if (nextSerial == Integer.MAX_VALUE) {
+                    stopped = true;
+                    Log.w(TAG, "Assist serial range exhausted");
+                    return;
+                }
+                int serial = nextSerial++;
+                if (!state.begin(request, serial)) continue;
+                try {
+                    transport.send(request, serial); // One-way, while route admission is held.
+                    handler.postDelayed(() -> {
+                        if (state.timeout(request.slot(), request.binding(), serial)) {
+                            Log.w(TAG, "Notification response timeout: " + request.kind());
+                            enqueue();
+                        }
+                    }, RESPONSE_TIMEOUT_MS);
+                } catch (android.os.RemoteException | RuntimeException unavailable) {
+                    state.timeout(i, request.binding(), serial);
+                }
+            }
+        }
+    }
+    private void connect(int phone) {
+        if (connecting[phone] || retryBlocked[phone] || stopped) return;
+        connecting[phone] = true;
+        long generation = ++generations[phone];
+        IBinder rejectedEndpoint = rejected[phone];
+        connections.post(() -> {
+            IBinder data = ServiceManager.checkService(MtkAssistTransport.DATA + "/slot" + (phone + 1));
+            if (data == null || !data.isBinderAlive() || data == rejectedEndpoint) {
+                handler.post(() -> { if (generation == generations[phone]) connecting[phone] = false; });
+                return;
+            }
+            MtkAssistTransport transport = null;
+            boolean incompatible = false;
+            try {
+                transport = new MtkAssistTransport(data, phone, generation, handler, this);
+                transport.register();
+            } catch (android.os.RemoteException | RuntimeException unavailable) {
+                incompatible = unavailable instanceof MtkAssistTransport.IncompatibleServiceException
+                        || (transport != null && transport.incompatible());
+                if (transport != null) transport.close();
+                transport = null;
+            }
+            MtkAssistTransport result = transport;
+            boolean incompatibleService = incompatible;
+            handler.post(() -> {
+                if (generation != generations[phone]) {
+                    if (result != null) result.close();
+                    return;
+                }
+                connecting[phone] = false;
+                if (announced[phone] != null && announced[phone] != data) {
+                    if (result != null) result.close();
+                    enqueue();
+                    return;
+                }
+                endpoints[phone] = data;
+                if (result == null || !result.healthy()) {
+                    retryBlocked[phone] = true;
+                    if (incompatibleService || (result != null && result.incompatible())) {
+                        rejected[phone] = data;
+                    }
+                    if (result != null) {
+                        result.close();
+                    }
+                    Log.w(TAG, "Assist service unavailable for slot " + phone);
+                    return;
+                }
+                transports[phone] = result;
+                state.binding(phone, generation);
+                enqueue();
+            });
+        });
+    }
+    @Override public void response(int phone, long generation, MtkAssistSyncState.Kind method,
+            int serial, int type, int error) {
+        Phone[] current=PhoneFactory.getPhones();
+        int active=context.getSystemService(TelephonyManager.class).getActiveModemCount();
+        if(!MtkAssistProfile.current(observedProfiles,current,active)) {enqueue();return;}
+        int defaultPhone = state.pendingDefaultDataPhone(phone, generation, serial);
+        boolean dataReady = phone >= 0 && phone < observedProfiles.length
+                && HonorSubscriberAdoption.isReady(phone, observedProfiles[phone]);
+        boolean defaultReady = defaultPhone >= 0 && defaultPhone < observedProfiles.length
+                && HonorSubscriberAdoption.isReady(defaultPhone, observedProfiles[defaultPhone]);
+        if (state.response(phone, generation, method, serial, type, error, dataReady, defaultReady)) {
+            Log.d(TAG, "Acknowledged slot " + phone + " " + method + " error=" + error);
+            enqueue();
+        }
+    }
+    @Override public void unavailable(int phone, long generation) {
+        if (generation != generations[phone]) return;
+        retryBlocked[phone] = true;
+        if (transports[phone] != null) {
+            if (transports[phone].incompatible()) rejected[phone] = endpoints[phone];
+            transports[phone].close();
+        }
+        transports[phone] = null;
+        state.binding(phone, 0);
+        enqueue();
+    }
+}
diff --git a/src/com/android/internal/telephony/honor/HonorMtkVoiceQualityDecoder.java b/src/com/android/internal/telephony/honor/HonorMtkVoiceQualityDecoder.java
new file mode 100644
index 0000000000000000000000000000000000000000..5f7c1bcd4a22ccbd227993217fad109e8453df3d
--- /dev/null
+++ b/src/com/android/internal/telephony/honor/HonorMtkVoiceQualityDecoder.java
@@ -0,0 +1,39 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.internal.telephony.honor;
+
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+
+/** Reviewed hncall message 2 prefix. Parsing does not authorize a recovery action. */
+public final class HonorMtkVoiceQualityDecoder {
+    private HonorMtkVoiceQualityDecoder() {}
+
+    public record Quality(int slot, int code, int rat) {
+        /** Stock drops WLAN reports before both feedback paths. */
+        public boolean isCellular() {
+            return rat != 2;
+        }
+
+        public boolean isKnownCode() {
+            return code == 0 || code == 100 || code == 101 || code == 102;
+        }
+    }
+
+    /** Unknown non-sentinel values remain raw; trailing vendor extension bytes are ignored. */
+    public static Quality decode(int slot, int outerVersion, int messageId, byte[] payload) {
+        if (slot < 0 || slot >= 2 || outerVersion != 1 || messageId != 2
+                || payload == null || payload.length < 12) {
+            return null;
+        }
+        ByteBuffer buffer = ByteBuffer.wrap(payload).order(ByteOrder.LITTLE_ENDIAN);
+        if (buffer.getInt() != 1) {
+            return null;
+        }
+        int code = buffer.getInt();
+        int rat = buffer.getInt();
+        return code == -1 || rat == -1 ? null : new Quality(slot, code, rat);
+    }
+}
diff --git a/src/com/android/internal/telephony/honor/HonorOverseasCallNormality.java b/src/com/android/internal/telephony/honor/HonorOverseasCallNormality.java
new file mode 100644
index 0000000000000000000000000000000000000000..1c30b30f3229e510a86886f265e42313bae17ec7
--- /dev/null
+++ b/src/com/android/internal/telephony/honor/HonorOverseasCallNormality.java
@@ -0,0 +1,51 @@
+/* Copyright (C) 2026 The LineageOS Project. SPDX-License-Identifier: Apache-2.0 */
+package com.android.internal.telephony.honor;
+
+import java.io.InputStream;
+import java.util.HashSet;
+import java.util.Set;
+import javax.xml.parsers.DocumentBuilderFactory;
+import org.w3c.dom.Element;
+
+/** Stock normality precedence for regional selfcure, distinct from the history success metric. */
+final class HonorOverseasCallNormality {
+    private final HonorImsDefaultOpenPolicy.NormalCodes codes;
+    private HonorOverseasCallNormality(Set<Integer> reasonSip,Set<Integer> reasonQ850,
+            Set<Integer> reasonRelease,Set<Integer> sip,Set<Integer> modem) {
+        codes=new HonorImsDefaultOpenPolicy.NormalCodes(reasonSip,reasonQ850,reasonRelease,sip,modem);
+    }
+    static HonorOverseasCallNormality read(InputStream input)throws Exception {
+        Element root=DocumentBuilderFactory.newInstance().newDocumentBuilder()
+                .parse(input).getDocumentElement();
+        if(!root.getTagName().equals("xml"))throw new IllegalArgumentException("Normality root");
+        return new HonorOverseasCallNormality(codes(root,"ImsCallNormalReasonSipCode"),
+                codes(root,"ImsCallNormalReasonQ850Code"),codes(root,"ImsCallNormalReasonRelCode"),
+                codes(root,"ImsCallNormalSipCode"),codes(root,"ImsCallNormalModemCode"));
+    }
+    private static Set<Integer> codes(Element root,String tag) {
+        var found=root.getElementsByTagName(tag);
+        if(found.getLength()!=1)throw new IllegalArgumentException("Normality code configuration");
+        String text=((Element)found.item(0)).getAttribute("code");
+        Set<Integer> values=new HashSet<>();
+        for(String word:text.split(",")) {
+            try{values.add(Integer.parseInt(word));}
+            catch(NumberFormatException ignored){ /* Stock skips malformed list members, no trimming. */ }
+        }
+        return values;
+    }
+    /** Null means attribution is unknown and cannot request a regional control. */
+    Boolean isNormal(HonorCompletedCallQoe.Result result) {
+        return result==null?null:HonorImsDefaultOpenPolicy.normalCall(result,codes);
+    }
+    /** CallRateQuery uses endType plus its separate CS normal set, not the above whitelists. */
+    static Boolean historySuccess(HonorCompletedCallQoe.Result result) {
+        if(result==null)return null;
+        return switch(result.endType()) {
+            case NORMAL -> true;
+            case ERROR -> false;
+            case CS -> result.causes()==null || result.causes().modemCause()==null ? null
+                    : Set.of(25,29,102,145,146,148,149,360).contains(result.causes().modemCause());
+            case UNKNOWN -> null;
+        };
+    }
+}
diff --git a/src/com/android/internal/telephony/honor/HonorOverseasVonrController.java b/src/com/android/internal/telephony/honor/HonorOverseasVonrController.java
new file mode 100644
index 0000000000000000000000000000000000000000..eca95d58acef24d27893609c42190f36e445aed9
--- /dev/null
+++ b/src/com/android/internal/telephony/honor/HonorOverseasVonrController.java
@@ -0,0 +1,192 @@
+/* Copyright (C) 2026 The LineageOS Project. SPDX-License-Identifier: Apache-2.0 */
+package com.android.internal.telephony.honor;
+
+import android.content.Context;
+import android.content.BroadcastReceiver;
+import android.content.Intent;
+import android.content.IntentFilter;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.Message;
+import android.os.SystemClock;
+import android.provider.Settings;
+import android.telephony.TelephonyManager;
+import com.android.internal.telephony.Phone;
+import com.android.internal.telephony.PhoneFactory;
+import java.io.IOException;
+import java.util.HashMap;
+import java.util.Map;
+import java.util.Objects;
+
+/** Qualified shared-call consumer; source votes never imply CP application. */
+final class HonorOverseasVonrController {
+    interface Inputs {
+        String plmn(int slot); boolean airplane();
+        default boolean simAbsent(int slot){return false;}
+        default void watch(Handler handler,Runnable changed) {}
+    }
+    interface History {
+        HonorOverseasVonrPolicy.Rates record(String plmn,long when,
+                HonorOverseasVonrHistory.Domain domain,Boolean success)throws IOException;
+    }
+    private static final class Slot {
+        final HonorRegionalImsControl.Scope scope;
+        final String plmn;
+        long revision;
+        boolean voted;
+        Slot(HonorRegionalImsControl.Scope scope,String plmn){this.scope=scope;this.plmn=plmn;}
+    }
+    private final Handler handler,worker;
+    private final HonorRegionalImsControl control;
+    private final HonorOverseasVonrPolicy.Config config;
+    private final HonorOverseasVonrPolicy policy;
+    private final HonorOverseasCallNormality normality;
+    private final Inputs inputs;
+    private final History history;
+    private final Slot[] slots=new Slot[2];
+    HonorOverseasVonrController(Handler handler,Handler worker,HonorRegionalImsControl control,
+            HonorOverseasVonrPolicy.Config config,HonorOverseasCallNormality normality,
+            Inputs inputs,History history) {
+        this.handler=Objects.requireNonNull(handler);this.worker=Objects.requireNonNull(worker);
+        this.control=Objects.requireNonNull(control);this.config=Objects.requireNonNull(config);
+        this.policy=new HonorOverseasVonrPolicy(config);this.normality=Objects.requireNonNull(normality);
+        this.inputs=Objects.requireNonNull(inputs);this.history=Objects.requireNonNull(history);
+        inputs.watch(handler,this::review);
+        HonorCallQosController.addCompletedCallListener(this::completed);
+        HonorCallQosController.addRecoveryAdmissionListener(handler,this::review);
+    }
+    private void requireThread(){
+        if(Looper.myLooper()!=handler.getLooper())throw new IllegalStateException("Overseas policy looper");
+    }
+    private void withdraw(Slot state) {
+        state.revision++;
+        if(state.voted)control.withdraw(HonorRegionalImsControl.Policy.OVERSEAS_VONR,state.scope,
+                HonorRegionalImsControl.Feature.VONR);
+        state.voted=false;
+    }
+    private void review() {
+        requireThread();
+        for(int slot=0;slot<slots.length;slot++) {
+            final int id=slot;
+            HonorCallQosController.requestRecoveryAdmission(id,handler,proof->{
+                Slot state=slots[id];if(state==null)return;
+                if(state.voted&&inputs.simAbsent(id)) {
+                    policy.ownedSimAbsent();withdraw(state);slots[id]=null;return;
+                }
+                if(proof.bindingGeneration()!=state.scope.binding()
+                        ||proof.profileGeneration()!=state.scope.profile()
+                        ||!state.scope.subscriber().equals(proof.profileTuple())
+                        ||!Objects.equals(state.plmn,inputs.plmn(id))
+                        ||inputs.airplane()||!config.permits(state.plmn)) {
+                    withdraw(state);slots[id]=null;
+                }
+            });
+        }
+    }
+    private void completed(HonorCompletedCallQoe.Result result) {
+        requireThread();
+        var domain=historyDomain(result.domain());if(domain==null)return;
+        int id=result.epoch().slot();
+        HonorCallQosController.requestRecoveryAdmission(id,handler,proof->{
+            if(proof.bindingGeneration()!=result.epoch().binding()
+                    ||proof.profileGeneration()!=result.epoch().profile()
+                    ||proof.profileTuple()==null||!proof.profileTuple().usable()
+                    ||proof.adoption()==null)return;
+            String plmn=inputs.plmn(id);
+            if(plmn==null||!plmn.matches("[0-9]{5,6}"))return;
+            var scope=new HonorRegionalImsControl.Scope(id,proof.bindingGeneration(),
+                    proof.profileGeneration(),proof.profileTuple());
+            Slot state=slots[id];
+            if(state==null||!state.scope.equals(scope)||!state.plmn.equals(plmn)) {
+                if(state!=null)withdraw(state);
+                state=new Slot(scope,plmn);slots[id]=state;
+            }
+            Slot observed=state;
+            Boolean success=HonorOverseasCallNormality.historySuccess(result);
+            boolean candidate=domain==HonorOverseasVonrHistory.Domain.VONR
+                    &&Boolean.FALSE.equals(normality.isNormal(result))
+                    &&!inputs.airplane()&&config.permits(plmn);
+            long when=System.currentTimeMillis();
+            worker.post(()->{
+                HonorOverseasVonrPolicy.Rates rates;
+                try{rates=history.record(plmn,when,domain,success);}
+                catch(IOException unavailable){return;} // Unavailable I/O is not insufficient samples.
+                handler.post(()->{
+                    if(!candidate||slots[id]!=observed
+                            ||!Objects.equals(plmn,inputs.plmn(id))||inputs.airplane())return;
+                    if(!Boolean.TRUE.equals(control.unvoted(scope,HonorRegionalImsControl.Feature.VONR)))
+                        return; // Independent USER/carrier OFF dominates temporary policy.
+                    var decision=policy.abnormal(rates);
+                    if(decision.kind()==HonorOverseasVonrPolicy.Kind.NONE)return;
+                    long voteRevision=++observed.revision;
+                    observed.voted=true;
+                    control.offer(new HonorRegionalImsControl.Vote(
+                            HonorRegionalImsControl.Policy.OVERSEAS_VONR,scope,
+                            HonorRegionalImsControl.Feature.VONR,false,decision.durationMillis()),
+                            receipt->{
+                        if(slots[id]!=observed||observed.revision!=voteRevision)return;
+                        if(receipt.requestedDeadline()>0
+                                &&receipt.outcome()!=HonorRegionalImsControl.Outcome.DEFERRED) {
+                            long deadline=receipt.requestedDeadline();
+                            handler.postDelayed(()->{
+                                if(slots[id]==observed&&observed.revision==voteRevision
+                                        &&SystemClock.elapsedRealtime()>=deadline)withdraw(observed);
+                            },Math.max(0,deadline-SystemClock.elapsedRealtime()));
+                        }
+                    });
+                });
+            });
+        });
+    }
+    private static HonorOverseasVonrHistory.Domain historyDomain(HonorCompletedCallQoe.Domain domain) {
+        return switch(domain) {
+            case VONR->HonorOverseasVonrHistory.Domain.VONR;
+            case EPSFB->HonorOverseasVonrHistory.Domain.EPSFB;
+            case VOLTE->HonorOverseasVonrHistory.Domain.VOLTE;
+            default->null;
+        };
+    }
+    static Inputs sourceInputs(Context context) {
+        return new Inputs() {
+            public String plmn(int slot){
+                Phone phone=PhoneFactory.getPhone(slot);
+                return phone==null||phone.getServiceState()==null?null
+                        :phone.getServiceState().getOperatorNumeric();
+            }
+            public boolean simAbsent(int slot){
+                TelephonyManager manager=context.getSystemService(TelephonyManager.class);
+                return manager!=null&&manager.getSimState(slot)==TelephonyManager.SIM_STATE_ABSENT;
+            }
+            public void watch(Handler handler,Runnable changed) {
+                Handler serviceState=new Handler(handler.getLooper()){
+                    @Override public void handleMessage(Message message){changed.run();}
+                };
+                for(Phone phone:PhoneFactory.getPhones())if(phone!=null)
+                    phone.registerForServiceStateChanged(serviceState,1,null);
+                IntentFilter filter=new IntentFilter(Intent.ACTION_AIRPLANE_MODE_CHANGED);
+                filter.addAction(TelephonyManager.ACTION_SIM_CARD_STATE_CHANGED);
+                context.registerReceiver(new BroadcastReceiver(){
+                    @Override public void onReceive(Context ignored,Intent intent){changed.run();}
+                },filter,null,handler);
+            }
+            public boolean airplane(){
+                return Settings.Global.getInt(context.getContentResolver(),
+                        Settings.Global.AIRPLANE_MODE_ON,0)!=0;
+            }
+        };
+    }
+    /** The caller must confine this instance to its dedicated history worker. */
+    static History sourceHistory(Context context) {
+        Map<String,HonorOverseasVonrHistory> histories=new HashMap<>();
+        return (plmn,when,domain,success)->{
+            HonorOverseasVonrHistory history=histories.get(plmn);
+            if(history==null) {
+                history=new HonorOverseasVonrHistory(
+                        AtomicSepMuxStore.forOverseasVonrHistory(context,plmn),plmn);
+                histories.put(plmn,history);
+            }
+            if(success!=null)history.add(when,domain,success);
+            return history.rates(when);
+        };
+    }
+}
diff --git a/src/com/android/internal/telephony/honor/HonorOverseasVonrHistory.java b/src/com/android/internal/telephony/honor/HonorOverseasVonrHistory.java
new file mode 100644
index 0000000000000000000000000000000000000000..26b3a3aa2a2c78ee3b021bca9cb0576af24e8f57
--- /dev/null
+++ b/src/com/android/internal/telephony/honor/HonorOverseasVonrHistory.java
@@ -0,0 +1,82 @@
+/* Copyright (C) 2026 The LineageOS Project. SPDX-License-Identifier: Apache-2.0 */
+package com.android.internal.telephony.honor;
+
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.List;
+
+/** Private aggregate input history. It stores no subscriber, call, SIP or session identifier. */
+final class HonorOverseasVonrHistory {
+    enum Domain { VOLTE, EPSFB, VONR }
+    private record Call(long when,Domain domain,boolean normal) {}
+    private static final long WEEK=7L*24*60*60*1000, MONTH=30L*24*60*60*1000;
+    private final SepMuxJournal.Store store;
+    private final String header;
+    private final List<Call> calls=new ArrayList<>();
+    private boolean failed;
+    HonorOverseasVonrHistory(SepMuxJournal.Store store,String plmn)throws IOException {
+        if(plmn==null || !plmn.matches("[0-9]{5,6}"))
+            throw new IllegalArgumentException("History scope");
+        this.store=store;header="OVNRH1 "+plmn+"\n";
+        String text=store.read();
+        if(text==null)return; // Successfully observed absent history means insufficient samples.
+        if(!text.startsWith(header)||!text.endsWith("\n"))throw new IOException("Call history header");
+        String body=text.substring(header.length());
+        if(body.isEmpty())return;
+        for(String line:body.split("\n")) {
+            String[] parts=line.split(" ",-1);
+            try {
+                if(parts.length!=3 || !parts[0].matches("0|[1-9][0-9]*")
+                        || !parts[2].matches("[01]"))throw new IllegalArgumentException();
+                calls.add(new Call(Long.parseLong(parts[0]),Domain.valueOf(parts[1]),
+                        parts[2].equals("1")));
+            }catch(IllegalArgumentException bad){throw new IOException("Call history fields",bad);}
+        }
+    }
+    void add(long when,Domain domain,boolean normal)throws IOException {
+        if(failed)throw new IOException("Call history publication unknown");
+        if(when<0 || domain==null)throw new IllegalArgumentException("Call history value");
+        when=second(when); // Stock exceptionTime uses yyyyMMddHHmmss, not subsecond precision.
+        calls.add(new Call(when,domain,normal));
+        long cutoff=when-MONTH;
+        calls.removeIf(call->call.when()<=cutoff);
+        StringBuilder text=new StringBuilder(header);
+        for(Call call:calls)text.append(call.when()).append(' ').append(call.domain())
+                .append(' ').append(call.normal()?1:0).append('\n');
+        failed=true;
+        store.writeDurably(text.toString());
+        if(!text.toString().equals(store.read()))throw new IOException("Call history readback");
+        failed=false;
+    }
+    HonorOverseasVonrPolicy.Rates rates(long now)throws IOException {
+        if(failed)throw new IOException("Call history unavailable");
+        if(now<0)throw new IllegalArgumentException("Call history clock");
+        List<Call> recent=window(Domain.VONR,now,MONTH);
+        return new HonorOverseasVonrPolicy.Rates(
+                rate(recent.subList(0,Math.min(10,recent.size()))),
+                days(Domain.VONR,now),days(Domain.EPSFB,now),days(Domain.VOLTE,now));
+    }
+    private List<Call> ordered(Domain domain) {
+        List<Call> result=new ArrayList<>();
+        for(Call call:calls)if(call.domain()==domain)result.add(call);
+        result.sort(Comparator.comparingLong(Call::when).reversed());
+        return result;
+    }
+    private Double days(Domain domain,long now) {
+        return rate(window(domain,now,WEEK));
+    }
+    private static long second(long value) { return Math.floorDiv(value,1000)*1000; }
+    private List<Call> window(Domain domain,long now,long duration) {
+        long start=second(now-duration),end=second(now);
+        List<Call> selected=new ArrayList<>();
+        for(Call call:ordered(domain))
+            if(call.when()>start&&call.when()<end)selected.add(call);
+        return selected;
+    }
+    private static Double rate(List<Call> selected) {
+        if(selected.size()<10)return null;
+        int normal=0;for(Call call:selected)if(call.normal())normal++;
+        return (double)((float)normal/selected.size()*100.0f);
+    }
+}
diff --git a/src/com/android/internal/telephony/honor/HonorOverseasVonrPolicy.java b/src/com/android/internal/telephony/honor/HonorOverseasVonrPolicy.java
new file mode 100644
index 0000000000000000000000000000000000000000..bdbaf6a61d3fea95138051b6ac878aa37208550c
--- /dev/null
+++ b/src/com/android/internal/telephony/honor/HonorOverseasVonrPolicy.java
@@ -0,0 +1,94 @@
+/* Copyright (C) 2026 The LineageOS Project. SPDX-License-Identifier: Apache-2.0 */
+package com.android.internal.telephony.honor;
+
+import java.io.InputStream;
+import java.util.HashMap;
+import java.util.Map;
+import java.util.Set;
+import javax.xml.parsers.DocumentBuilderFactory;
+import org.w3c.dom.Element;
+
+/** Stock113 OverseasVonrSelfCureEvaluation decision, independent of submission/application state. */
+final class HonorOverseasVonrPolicy {
+    record Config(boolean enabled,Set<String> excluded,long timerMillis,
+            int good,int average,int poor,int level1,int level2,int level3) {
+        Config {
+            excluded=Set.copyOf(excluded);
+            if(timerMillis<=0 || good>100 || good<average || average<poor || poor<0
+                    || level1<=0 || level2<level1 || level3<level2)
+                throw new IllegalArgumentException("Invalid overseas VoNR configuration");
+            Math.multiplyExact(timerMillis,level3);
+        }
+        boolean permits(String operator) {
+            return enabled && operator!=null && operator.matches("[0-9]{5,6}")
+                    && !excluded.contains(operator);
+        }
+        static Config read(InputStream stream)throws Exception {
+            Element root=DocumentBuilderFactory.newInstance().newDocumentBuilder()
+                    .parse(stream).getDocumentElement();
+            if(!root.getTagName().equals("xml"))throw new IllegalArgumentException("Config root");
+            Map<String,Element> values=new HashMap<>();
+            for(var node=root.getFirstChild();node!=null;node=node.getNextSibling()) {
+                if(node instanceof Element element
+                        && values.put(element.getTagName(),element)!=null)
+                    throw new IllegalArgumentException("Duplicate config field");
+            }
+            Set<String> expected=Set.of("FeatureSwitch","PlmnList","SelfCureTimer",
+                    "CallRateIsGood","CallRateIsAverage","CallRateIsPoor",
+                    "SelfCureLevel1","SelfCureLevel2","SelfCureLevel3");
+            if(!values.keySet().equals(expected))throw new IllegalArgumentException("Config fields");
+            Set<String> excluded=Set.of(values.get("PlmnList").getAttribute("list").split(","));
+            if(excluded.stream().anyMatch(p->!p.matches("[0-9]{5,6}")))
+                throw new IllegalArgumentException("PLMN configuration");
+            int feature=integer(values,"FeatureSwitch","featureSwitch");
+            if(feature!=0 && feature!=1)throw new IllegalArgumentException("Feature configuration");
+            return new Config(feature==1,excluded,
+                    Math.multiplyExact((long)integer(values,"SelfCureTimer","t1"),1000),
+                    integer(values,"CallRateIsGood","value1"),
+                    integer(values,"CallRateIsAverage","value2"),
+                    integer(values,"CallRateIsPoor","value3"),
+                    integer(values,"SelfCureLevel1","value4"),
+                    integer(values,"SelfCureLevel2","value5"),
+                    integer(values,"SelfCureLevel3","value6"));
+        }
+        private static int integer(Map<String,Element> values,String tag,String attribute) {
+            String value=values.get(tag).getAttribute(attribute);
+            if(!value.matches("0|[1-9][0-9]*"))throw new IllegalArgumentException("Config integer");
+            return Integer.parseInt(value);
+        }
+    }
+    /** Null means stock -100 unavailable; a known rate is 0..100, never an inferred zero. */
+    record Rates(Double recentVonr,Double daysVonr,Double daysEpsfb,Double daysVolte) {
+        Rates {
+            for(Double value:new Double[]{recentVonr,daysVonr,daysEpsfb,daysVolte})
+                if(value!=null && (!Double.isFinite(value)||value<0||value>100))
+                    throw new IllegalArgumentException("Call success rate");
+        }
+    }
+    enum Kind { NONE, TIMED, SUSTAINED }
+    record Decision(Kind kind,long durationMillis) {}
+    private final Config config;
+    // Stock's vonrCallCureFlag is one manager counter, not a per-slot counter.
+    private int attempts;
+    HonorOverseasVonrPolicy(Config config) {this.config=config;}
+    Decision abnormal(Rates rates) {
+        if(!config.enabled())return new Decision(Kind.NONE,0);
+        if(rates.recentVonr()==null || rates.daysEpsfb()==null && rates.daysVolte()==null)
+            return timed(config.level1());
+        double alternative=Math.max(rates.daysEpsfb()==null?-100:rates.daysEpsfb(),
+                rates.daysVolte()==null?-100:rates.daysVolte());
+        double recent=rates.recentVonr();
+        if(recent>alternative)return new Decision(Kind.NONE,0);
+        if(recent>=config.good())return timed(config.level1());
+        if(recent>=config.average())return timed(config.level2());
+        if(recent>=config.poor())return timed(config.level3());
+        if(attempts<5 || rates.daysVonr()!=null && rates.daysVonr()>config.average()
+                || alternative<=config.good())return timed(config.level3());
+        return new Decision(Kind.SUSTAINED,0);
+    }
+    private Decision timed(int level) {
+        if(attempts<Integer.MAX_VALUE)attempts++;
+        return new Decision(Kind.TIMED,Math.multiplyExact(config.timerMillis(),level));
+    }
+    void ownedSimAbsent() {attempts=0;}
+}
diff --git a/src/com/android/internal/telephony/honor/HonorPrimaryDataPreference.java b/src/com/android/internal/telephony/honor/HonorPrimaryDataPreference.java
