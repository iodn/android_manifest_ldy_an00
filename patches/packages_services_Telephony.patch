index 0000000000000000000000000000000000000000..c4a8ee4a25f7631ac3b98d8f69157e9fbb7efdbc
--- /dev/null
+++ b/tests/host/com/android/internal/telephony/honor/PhysicalControllerReconciliationHostTest.java
@@ -0,0 +1,71 @@
+package com.android.internal.telephony.honor;
+import android.os.*;import com.android.internal.telephony.uicc.*;
+import java.util.*;
+/** Actual Adapter/model/evidence with deterministic CI/controller/Looper boundaries. */
+public final class PhysicalControllerReconciliationHostTest {
+ static int checks;static void check(boolean v){checks++;if(!v)throw new AssertionError("check "+checks);}
+ static EmptyPhysicalAdapterHostTest.Owner returning()throws Exception{
+  var o=new EmptyPhysicalAdapterHostTest.Owner();o.outbound(true);
+  o.start(SepMuxTrial.Selector.PHYSICAL);o.mode(1);o.accepted();o.mode(0);return o;
+ }
+ static void noExtraSelect(EmptyPhysicalAdapterHostTest.Owner o){check(o.selectors.equals(List.of(1,0)));}
+ static IccCardStatus raw(boolean present){return EmptyPhysicalAdapterHostTest.card(present);}
+ public static void main(String[]args)throws Exception{
+  // Three early controller failures consume no additional CI budget; parsed card survives pooling.
+  var o=returning();o.controller.slot.unknown=true;int queries=o.ci.requests;
+  o.ci.respond(raw(true));o.ci.lastDelivered.obj=null;
+  for(int i=0;i<3;i++){o.adapter.onIccChanged(1);Handler.advance(100);check(o.ci.requests==queries&&o.completed==1);}
+  o.controller.slot.unknown=false;Handler.advance(100);
+  check(o.completed==2&&o.adapter.completedPhysicalCycle());noExtraSelect(o);
+  // Intrinsically old eUICC raw status needs one qualified fresh CI read after controller changes.
+  o=returning();o.controller.slot.euicc=true;IccCardStatus stale=raw(true);stale.atr="3B802F822D";
+  o.ci.respond(stale);queries=o.ci.requests;
+  for(int i=0;i<3;i++){o.adapter.onIccChanged(1);Handler.advance(100);check(o.ci.requests==queries&&o.completed==1);}
+  o.state(true);o.controller.port.profile.state=UiccProfile.State.LOADED;Handler.advance(100);
+  check(o.ci.requests==queries+1&&o.ci.pending.size()==1&&o.completed==1);
+  o.ci.respond(raw(true));check(o.completed==2);noExtraSelect(o);
+  // More than three real revisions can finish; no hard total cap or same-revision polling.
+  o=returning();o.ci.respond(stale);
+  for(int i=0;i<3;i++){
+   queries=o.ci.requests;o.controller.publicCardId++;Handler.advance(100);
+   check(o.ci.requests==queries+1&&o.ci.pending.size()==1);o.ci.respond(stale);
+   for(int event=0;event<3;event++)o.adapter.onIccChanged(1);
+   Handler.advance(100);check(o.ci.requests==queries+1);
+  }
+  o.controller.publicCardId++;Handler.advance(100);o.ci.respond(raw(true));
+  check(o.completed==2);noExtraSelect(o);
+  // Same object, different actual cached identity must get fresh CI before old proof is consumed.
+  o=returning();Object same=o.controller.slot.card;queries=o.ci.requests;
+  o.controller.port.iccid="8999999999999999999";((UiccCard)same).id=o.controller.port.iccid;
+  o.ci.respond(raw(true));check(o.controller.slot.card==same&&o.completed==1&&o.ci.requests==queries+1);
+  o.ci.respond(raw(true));check(o.completed==2);noExtraSelect(o);
+  // A stale old CI callback cannot replace the newly outstanding fresh-read token.
+  o=returning();o.ci.respond(stale);Message old=o.ci.lastDelivered;Object oldResult=old.obj;
+  o.controller.publicCardId++;Handler.advance(100);queries=o.ci.requests;
+  old.getTarget().obtainMessage(old.what,oldResult).sendToTarget();Handler.runReady();
+  check(o.ci.requests==queries&&o.ci.pending.size()==1&&o.completed==1);
+  o.ci.respond(raw(true));check(o.completed==2);noExtraSelect(o);
+  // Mismatched two controller snapshots do not authorize completion.
+  o=returning();o.controller.second=new UiccSlot();o.controller.second.euicc=true;
+  o.ci.respond(raw(true));queries=o.ci.requests;Handler.advance(100);
+  check(o.completed==1&&o.ci.requests==queries);o.controller.second=null;Handler.advance(100);
+  if(!o.ci.pending.isEmpty())o.ci.respond(raw(true));check(o.completed==2);noExtraSelect(o);
+  // Existing generation/deadline gates retire passive callbacks, without selectors or queries.
+  for(boolean deadline:new boolean[]{false,true}){
+   o=returning();o.controller.slot.unknown=true;o.ci.respond(raw(true));queries=o.ci.requests;
+   if(deadline)Handler.advance(360001);else{o.generation++;Handler.advance(100);}
+   check(o.last==SepMuxTrial.State.UNKNOWN&&o.completed==1);o.controller.slot.unknown=false;
+   Handler.advance(1000);check(o.ci.requests==queries&&o.completed==1);noExtraSelect(o);
+  }
+  for(int malformed=0;malformed<4;malformed++){
+   o=returning();IccCardStatus invalid=raw(true);
+   if(malformed==0)invalid=null;
+   else if(malformed==1)invalid.mSlotPortMapping=null;
+   else if(malformed==2)invalid.mSlotPortMapping.mPortIndex=1;
+   else invalid.mCardState=null;
+   o.ci.respond(invalid);queries=o.ci.requests;check(o.last==SepMuxTrial.State.UNKNOWN&&o.completed==1);
+   o.adapter.onIccChanged(1);Handler.advance(100);check(o.ci.requests==queries);noExtraSelect(o);
+  }
+  System.out.println("PASS "+checks+" actual passive physical/controller reconciliation checks; no modem proof");
+ }
+}
