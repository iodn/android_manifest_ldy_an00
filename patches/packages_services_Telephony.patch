+package android.os;
+import java.util.*;
+public final class Looper {
+ static Looper current; static long now;
+ static final ArrayDeque<Task> queue=new ArrayDeque<>();static final List<Task> timers=new ArrayList<>();
+ record Task(Looper looper,Runnable action,long time){}
+ public static Looper myLooper(){return current;}
+ static void post(Looper l,Runnable r,long delay){Task t=new Task(l,r,now+delay);if(delay==0)queue.add(t);else timers.add(t);}
+ public static void drain(){int n=0;while(!queue.isEmpty()){if(++n>10000)throw new AssertionError("infinite tasks");Task t=queue.remove();Looper old=current;current=t.looper;t.action.run();current=old;}}
+ public static void advance(long ms){now+=ms;Iterator<Task> i=timers.iterator();while(i.hasNext()){Task t=i.next();if(t.time<=now){queue.add(t);i.remove();}}drain();}
+}
