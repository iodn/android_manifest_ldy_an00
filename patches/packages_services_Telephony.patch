+    private void bindingAdmission(Profile profile, HnCallHardwareOwner.Snapshot source) {
+        if (source.bindingGeneration() != profile.observedBinding) {
+            profile.observedBinding = source.bindingGeneration();
+            profile.quality = null;
+            profile.qualitySequence = 0;
+            profile.processedSequence = 0;
+            profile.idleAtAdmission = allIdle();
+        }
+    }
+
+    private boolean identityMatches(Profile profile, int slot) {
+        Phone[] current = PhoneFactory.getPhones();
+        return current != null && slot < current.length && current[slot] == profile.phone
+                && profile.phone.getSubId() == profile.subId
+                && UiccController.getInstance().getUiccCardForPhone(slot) == profile.card
+                && UiccController.getInstance().getUiccProfileForPhone(slot) == profile.uiccProfile
+                && profile.iccIdentity.equals(profile.phone.getFullIccSerialNumber());
+    }
+
+    private boolean subscriberReady(int slot) {
+        Phone[] current = PhoneFactory.getPhones();
+        if (current == null || slot < 0 || slot >= current.length) return false;
+        MtkAssistProfile[] candidates = MtkAssistProfile.capture(current, current.length);
+        return slot < candidates.length
+                && HonorSubscriberAdoption.isReady(slot, candidates[slot]);
+    }
+
+    private boolean usable(Phone phone) {
+        return Settings.Global.getInt(context.getContentResolver(),
+                Settings.Global.AIRPLANE_MODE_ON, 0) == 0
+                && phone.isRadioAvailable() && phone.isRadioOn()
+                && SubscriptionManager.isValidSubscriptionId(phone.getSubId());
+    }
+
+    private boolean allIdle() {
+        if (phones.length == 0) return false;
+        for (Phone phone : phones) if (!idle(phone)) return false;
+        return true;
+    }
+
+    /** Local observed native-call evidence, not an independently queried complete CP call list. */
+    private boolean nativeQuiescent() {
+        for (int slot = 0; slot < 2; slot++) {
+            Profile profile = profiles[slot];
+            Session session = sessions[slot];
+            HnCallHardwareOwner.Snapshot source = hardware.barrier(slot);
+            if (profile != null && profile.identityUsable
+                    && (!profile.qualified || !source.ready())) return false;
+            if (profile != null && source.ready()
+                    && source.sequence() > profile.processedSequence) return false;
+            if (session == null) continue;
+            if (session.unresolvedSip || !session.orphanCalls.isEmpty()) return false;
+            for (var call : session.cache.current()) {
+                if (call.status != HonorCallQosPolicy.Status.DISCONNECTED) return false;
+            }
+        }
+        return true;
+    }
