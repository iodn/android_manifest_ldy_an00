new file mode 100644
index 0000000000000000000000000000000000000000..05023746643dbfbc3196261a5e0c3a270d0f8363
--- /dev/null
+++ b/src/com/android/internal/telephony/honor/HonorImsDefaultOpenController.java
@@ -0,0 +1,224 @@
+/* Copyright (C) 2026 The LineageOS Project. SPDX-License-Identifier: Apache-2.0 */
+package com.android.internal.telephony.honor;
+
+import android.os.Handler;
+import java.util.EnumMap;
+import java.util.EnumSet;
+import java.util.Objects;
+import java.util.function.Consumer;
+
+/** Uicc-looper runtime consumer; writing and baseline arbitration belong to shared custody. */
+final class HonorImsDefaultOpenController {
+    record Eligibility(boolean current, boolean featureEnabled, boolean voltePlatformAndUser,
+            boolean wfcPlatformAndUser, Integer wifiRssi) { }
+    record Registration(HonorImsDefaultOpenPolicy.Feature feature, boolean registered,
+            Integer nativeError) { }
+    interface Inputs {
+        // Must compare current binding/profile/adoption as well as current USER/carrier permission.
+        Eligibility inspect(HonorCallQosController.QualifiedConfiguration configuration);
+        HonorImsDefaultOpenPolicy.Memory memory(
+                HonorCallQosController.QualifiedConfiguration configuration);
+        // Implemented by per-sub MmTel registration callbacks, not a vendor callback replacement.
+        AutoCloseable registrations(int subscription, Consumer<Registration> listener);
+        AutoCloseable watch(Runnable changed);
+        Boolean cellularInService(int slot);
+        long wallClockMillis();
+        boolean temporaryFailure(HonorCompletedCallQoe.Result result);
+    }
+    interface Backend {
+        // Offer must take an immutable current admission proof before leaving the Uicc handler.
+        // Unavailable2009 is an explicit rejected offer, never a direct setter fallback.
+        void offer(Vote vote);
+        void withdraw(int slot, HonorImsDefaultOpenPolicy.Feature feature);
+    }
+    record Vote(HonorCallQosController.QualifiedConfiguration configuration,
+            HonorImsDefaultOpenPolicy.Decision decision) {
+        @Override public String toString() { return "DefaultOpenVote[identifiers omitted]"; }
+    }
+    private final Handler handler;
+    private final Inputs inputs;
+    private final Backend backend;
+    private final HonorImsDefaultOpenPolicy.Config config;
+    private final Round[] rounds = new Round[2];
+    private boolean closed;
+    private final AutoCloseable observations;
+    private final class Round implements HonorImsDefaultOpenPolicy.Timers {
+        HonorCallQosController.QualifiedConfiguration configuration;
+        final HonorImsDefaultOpenPolicy policy;
+        final EnumMap<HonorImsDefaultOpenPolicy.Timer, Runnable> timers =
+                new EnumMap<>(HonorImsDefaultOpenPolicy.Timer.class);
+        AutoCloseable registration;
+        long lastCallCycle;
+        final EnumSet<HonorImsDefaultOpenPolicy.Feature> registered =
+                EnumSet.noneOf(HonorImsDefaultOpenPolicy.Feature.class);
+        Round(HonorCallQosController.QualifiedConfiguration observation) {
+            configuration = observation;
+            policy = new HonorImsDefaultOpenPolicy(config, this, inputs.memory(observation),
+                    decision -> decide(this, decision));
+        }
+        public void arm(HonorImsDefaultOpenPolicy.Timer timer, long delay) {
+            cancel(timer);
+            Runnable callback = new Runnable() {
+                public void run() {
+                    if (timers.get(timer) != this) return;
+                    timers.remove(timer);
+                    if (current(Round.this)) policy.timer(timer);
+                }
+            };
+            timers.put(timer, callback);
+            handler.postDelayed(callback, delay);
+        }
+        public void cancel(HonorImsDefaultOpenPolicy.Timer timer) {
+            Runnable old = timers.remove(timer);
+            if (old != null) handler.removeCallbacks(old);
+        }
+    }
+    HonorImsDefaultOpenController(Handler handler, Inputs inputs, Backend backend,
+            HonorImsDefaultOpenPolicy.Config config) {
+        this.handler = Objects.requireNonNull(handler);
+        this.inputs = Objects.requireNonNull(inputs);
+        this.backend = Objects.requireNonNull(backend);
+        this.config = Objects.requireNonNull(config);
+        HonorCallQosController.addConfigurationListener(this::configuration);
+        HonorCallQosController.addCompletedCallListener(this::completed);
+        observations = inputs.watch(() -> handler.post(this::environmentChanged));
+    }
+    void configuration(HonorCallQosController.QualifiedConfiguration observation) {
+        if (closed || observation == null || observation.slot() < 0 || observation.slot() > 1)
+            return;
+        int slot = observation.slot();
+        Round previous = rounds[slot];
+        if (previous != null && observation.bindingGeneration()
+                == previous.configuration.bindingGeneration()
+                && observation.profileGeneration() == previous.configuration.profileGeneration()
+                && observation.sequence() <= previous.configuration.sequence()) return;
+        Eligibility eligibility = inputs.inspect(observation);
+        if (!eligibility.current() || !eligibility.featureEnabled()) {
+            retire(slot);
+            return;
+        }
+        // Failed MBN lookup does not turn old feature bits into OFF or refresh their provenance.
+        if (observation.report().isMbnLookupFailure()) {
+            if (previous != null && !sameProfile(previous.configuration, observation)) retire(slot);
+            return;
+        }
+        if (previous == null || !sameProfile(previous.configuration, observation)) {
+            retire(slot);
+            previous = new Round(observation);
+            rounds[slot] = previous;
+        }
+        previous.configuration = observation;
+        ensureRegistration(previous);
+        for (HonorImsDefaultOpenPolicy.Feature feature : HonorImsDefaultOpenPolicy.Feature.values())
+            backend.withdraw(slot, feature);
+        previous.policy.configuration(observation.report().type(), eligibility.wfcPlatformAndUser());
+        // Stock triggerNewRound evaluates the current registration before starting cure timers.
+        for (HonorImsDefaultOpenPolicy.Feature feature : previous.registered)
+            previous.policy.registered(feature);
+    }
+    /** Genuine radio/sub/profile/adoption/user/carrier events only; never synthesize new1002. */
+    void environmentChanged() {
+        if (closed) return;
+        for (Round round : rounds) {
+            if (round == null || !current(round)) continue;
+            ensureRegistration(round);
+            Boolean cellular = inputs.cellularInService(round.configuration.slot());
+            if (cellular != null) round.policy.cellularService(cellular);
+            Eligibility eligibility = inputs.inspect(round.configuration);
+            if (!eligibility.voltePlatformAndUser())
+                backend.withdraw(round.configuration.slot(), HonorImsDefaultOpenPolicy.Feature.VOLTE);
+            if (!eligibility.wfcPlatformAndUser())
+                backend.withdraw(round.configuration.slot(), HonorImsDefaultOpenPolicy.Feature.WFC);
+        }
+    }
+    void cellularService(int slot, boolean inService) {
+        if (slot < 0 || slot > 1) return;
+        Round round = rounds[slot];
+        if (round != null && current(round)) round.policy.cellularService(inService);
+    }
+    private void ensureRegistration(Round round) {
+        if (round.registration == null) round.registration = inputs.registrations(
+                round.configuration.profileTuple().subscription,
+                event -> handler.post(() -> registration(round, event)));
+    }
+    private void registration(Round round, Registration event) {
+        if (event == null || !current(round)) return;
+        if (event.registered()) {
+            round.registered.add(event.feature());
+            round.policy.registered(event.feature());
+        } else {
+            round.registered.remove(event.feature());
+            if (event.nativeError() != null)
+                round.policy.registrationFailed(event.feature(), event.nativeError());
+        }
+    }
+    void completed(HonorCompletedCallQoe.Result result) {
+        if (closed || result == null || result.emergency()
+                || result.endType() == HonorCompletedCallQoe.EndType.UNKNOWN) return;
+        int slot = result.epoch().slot();
+        Round round = rounds[slot];
+        if (round == null || !current(round)) return;
+        var observed = round.configuration;
+        if (result.epoch().binding() != observed.bindingGeneration()
+                || result.epoch().profile() != observed.profileGeneration()
+                || result.epoch().callCycle() <= round.lastCallCycle) return;
+        HonorImsDefaultOpenPolicy.Domain domain = switch (result.domain()) {
+            case VOLTE -> HonorImsDefaultOpenPolicy.Domain.VOLTE;
+            case VOWIFI -> HonorImsDefaultOpenPolicy.Domain.WFC;
+            case CS -> HonorImsDefaultOpenPolicy.Domain.CS;
+            default -> null;
+        };
+        if (domain == null) return;
+        round.lastCallCycle = result.epoch().callCycle();
+        Eligibility eligibility = inputs.inspect(observed);
+        round.policy.completed(inputs.wallClockMillis(), domain,
+                result.endType() == HonorCompletedCallQoe.EndType.NORMAL
+                        || result.endType() == HonorCompletedCallQoe.EndType.CS,
+                inputs.temporaryFailure(result), eligibility.wifiRssi());
+    }
+    private void decide(Round round, HonorImsDefaultOpenPolicy.Decision decision) {
+        if (!current(round)) return;
+        Eligibility eligibility = inputs.inspect(round.configuration);
+        boolean allowed = decision.feature() == HonorImsDefaultOpenPolicy.Feature.VOLTE
+                ? eligibility.voltePlatformAndUser() : eligibility.wfcPlatformAndUser();
+        if (decision.reason() == HonorImsDefaultOpenPolicy.Reason.NO_CELLULAR
+                && !Boolean.FALSE.equals(inputs.cellularInService(round.configuration.slot())))
+            return;
+        if (allowed) backend.offer(new Vote(round.configuration, decision));
+        else backend.withdraw(round.configuration.slot(), decision.feature());
+    }
+    private boolean current(Round round) {
+        int slot = round.configuration.slot();
+        if (closed || rounds[slot] != round) return false;
+        Eligibility eligibility = inputs.inspect(round.configuration);
+        if (eligibility.current() && eligibility.featureEnabled()) return true;
+        retire(slot);
+        return false;
+    }
+    private static boolean sameProfile(HonorCallQosController.QualifiedConfiguration a,
+            HonorCallQosController.QualifiedConfiguration b) {
+        return a.bindingGeneration() == b.bindingGeneration()
+                && a.profileGeneration() == b.profileGeneration()
+                && a.profileTuple().equals(b.profileTuple());
+    }
+    private void retire(int slot) {
+        Round round = rounds[slot];
+        rounds[slot] = null;
+        if (round == null) return;
+        round.policy.retire();
+        if (round.registration != null) {
+            try { round.registration.close(); }
+            catch (Exception ignored) { /* No vendor state or success is inferred from unregister. */ }
+        }
+        for (HonorImsDefaultOpenPolicy.Feature feature : HonorImsDefaultOpenPolicy.Feature.values())
+            backend.withdraw(slot, feature);
+    }
+    void close() {
+        closed = true;
+        for (int slot = 0; slot < rounds.length; slot++) retire(slot);
+        if (observations != null) {
+            try { observations.close(); }
+            catch (Exception ignored) { }
+        }
+    }
+}
diff --git a/src/com/android/internal/telephony/honor/HonorImsDefaultOpenInputs.java b/src/com/android/internal/telephony/honor/HonorImsDefaultOpenInputs.java
new file mode 100644
index 0000000000000000000000000000000000000000..bacea09a96103eb26477972636158690e4ebb614
--- /dev/null
+++ b/src/com/android/internal/telephony/honor/HonorImsDefaultOpenInputs.java
@@ -0,0 +1,180 @@
+/* Copyright (C) 2026 The LineageOS Project. SPDX-License-Identifier: Apache-2.0 */
+package com.android.internal.telephony.honor;
+
+import android.content.Context;
+import android.content.BroadcastReceiver;
+import android.content.Intent;
+import android.content.IntentFilter;
+import android.database.ContentObserver;
+import android.telephony.CarrierConfigManager;
+import android.telephony.SubscriptionManager;
+import android.telephony.ServiceState;
+import com.android.internal.telephony.uicc.UiccController;
+import android.os.Handler;
+import android.telephony.AccessNetworkConstants;
+import android.telephony.ims.ImsMmTelManager;
+import android.telephony.ims.ImsReasonInfo;
+import com.android.ims.ImsManager;
+import com.android.internal.telephony.Phone;
+import com.android.internal.telephony.PhoneFactory;
+import java.util.Objects;
+import java.util.function.Consumer;
+import java.util.function.Predicate;
+
+/** Standard registration/settings input adapter. It does not register any Honor/vendor callback. */
+final class HonorImsDefaultOpenInputs implements HonorImsDefaultOpenController.Inputs {
+    interface Configuration {
+        // Resolved source-owned feature/operator config, not a forced property default.
+        boolean enabled();
+        boolean operatorAllowed(int slot, HonorImsDefaultOpenPolicy.Feature feature);
+        HonorImsDefaultOpenPolicy.Memory memory(
+                HonorCallQosController.QualifiedConfiguration configuration);
+        // Shared completed-call cause projection plus this leaf's configured whitelist precedence.
+        // null means the projection/config is unavailable; it is never generic ERROR=>failure.
+        HonorImsDefaultOpenPolicy.NormalCodes normalCodes();
+        boolean temporaryFailure(HonorCompletedCallQoe.Result result);
+        Integer wifiRssi();
+    }
+    private final Context context;
+    private final Handler handler;
+    private final Configuration config;
+    private final Predicate<HonorCallQosController.QualifiedConfiguration> nativeCurrent;
+    HonorImsDefaultOpenInputs(Context context, Handler handler, Configuration config,
+            Predicate<HonorCallQosController.QualifiedConfiguration> nativeCurrent) {
+        this.context = Objects.requireNonNull(context);
+        this.handler = Objects.requireNonNull(handler);
+        this.config = Objects.requireNonNull(config);
+        this.nativeCurrent = Objects.requireNonNull(nativeCurrent);
+    }
+    public HonorImsDefaultOpenController.Eligibility inspect(
+            HonorCallQosController.QualifiedConfiguration configuration) {
+        int slot = configuration.slot();
+        Phone[] phones = PhoneFactory.getPhones();
+        MtkAssistProfile[] profiles = MtkAssistProfile.capture(phones, phones.length);
+        boolean current = slot < profiles.length && phones[slot].isRadioAvailable()
+                && phones[slot].isRadioOn() && profiles[slot].equals(configuration.profileTuple())
+                && HonorSubscriberAdoption.isReady(slot, profiles[slot])
+                && nativeCurrent.test(configuration);
+        if (!current) return new HonorImsDefaultOpenController.Eligibility(
+                false, config.enabled(), false, false, null);
+        ImsManager manager = ImsManager.getInstance(context, slot);
+        boolean lte = manager.isVolteEnabledByPlatform()
+                && manager.isEnhanced4gLteModeSettingEnabledByUser()
+                && config.operatorAllowed(slot, HonorImsDefaultOpenPolicy.Feature.VOLTE);
+        boolean wifi = manager.isWfcEnabledByPlatform() && manager.isWfcEnabledByUser()
+                && config.operatorAllowed(slot, HonorImsDefaultOpenPolicy.Feature.WFC);
+        return new HonorImsDefaultOpenController.Eligibility(true, config.enabled(), lte, wifi,
+                config.wifiRssi());
+    }
+    /** Underlying platform+USER intent only: selfcure exclusions and voted modem properties omitted. */
+    Boolean unvotedIntent(int slot, MtkAssistProfile expected,
+            HonorImsDefaultOpenPolicy.Feature feature) {
+        Phone[] phones = PhoneFactory.getPhones();
+        MtkAssistProfile[] profiles = MtkAssistProfile.capture(phones, phones.length);
+        if (slot < 0 || slot >= profiles.length || !profiles[slot].equals(expected)
+                || !HonorSubscriberAdoption.isReady(slot, profiles[slot])) return null;
+        ImsManager manager = ImsManager.getInstance(context, slot);
+        return feature == HonorImsDefaultOpenPolicy.Feature.VOLTE
+                ? manager.isVolteEnabledByPlatform()
+                        && manager.isEnhanced4gLteModeSettingEnabledByUser()
+                : manager.isWfcEnabledByPlatform() && manager.isWfcEnabledByUser();
+    }
+    public HonorImsDefaultOpenPolicy.Memory memory(
+            HonorCallQosController.QualifiedConfiguration configuration) {
+        return config.memory(configuration);
+    }
+    public AutoCloseable registrations(int subscription,
+            Consumer<HonorImsDefaultOpenController.Registration> listener) {
+        ImsMmTelManager manager = ImsMmTelManager.createForSubscriptionId(subscription);
+        ImsMmTelManager.RegistrationCallback callback = new ImsMmTelManager.RegistrationCallback() {
+            private HonorImsDefaultOpenPolicy.Feature registering;
+            private HonorImsDefaultOpenPolicy.Feature feature(int transport) {
+                return switch (transport) {
+                    case AccessNetworkConstants.TRANSPORT_TYPE_WWAN ->
+                        HonorImsDefaultOpenPolicy.Feature.VOLTE;
+                    case AccessNetworkConstants.TRANSPORT_TYPE_WLAN ->
+                        HonorImsDefaultOpenPolicy.Feature.WFC;
+                    default -> null;
+                };
+            }
+            @Override public void onRegistering(int transport) { registering = feature(transport); }
+            @Override public void onRegistered(int transport) {
+                registering = feature(transport);
+                if (registering != null) listener.accept(
+                        new HonorImsDefaultOpenController.Registration(registering, true, null));
+            }
+            @Override public void onUnregistered(ImsReasonInfo reason) {
+                failure(registering, reason);
+            }
+            @Override public void onTechnologyChangeFailed(int transport, ImsReasonInfo reason) {
+                failure(feature(transport), reason);
+            }
+            private void failure(HonorImsDefaultOpenPolicy.Feature feature, ImsReasonInfo reason) {
+                if (feature == null || reason == null) return;
+                // Retained MTK createImsReasonInfo uses CODE_REGISTRATION_ERROR plus
+                // the native mRegErrorCode as extraCode. Other framework codes are not that API.
+                Integer nativeError = reason.getCode() == ImsReasonInfo.CODE_REGISTRATION_ERROR
+                        && reason.getExtraCode() > 0 ? reason.getExtraCode() : null;
+                listener.accept(new HonorImsDefaultOpenController.Registration(
+                        feature, false, nativeError));
+            }
+        };
+        try {
+            manager.registerImsRegistrationCallback(command -> handler.post(command), callback);
+        } catch (android.telephony.ims.ImsException unavailable) {
+            // No registration result is invented. Qualified evaluator deadlines remain cancellable.
+            return null;
+        }
+        return () -> manager.unregisterImsRegistrationCallback(callback);
+    }
+    public AutoCloseable watch(Runnable changed) {
+        // All external events enqueue a fresh review; none acts as new1002 or writer completion.
+        Handler events = new Handler(handler.getLooper(), message -> {
+            changed.run();
+            return true;
+        });
+        UiccController.getInstance().registerForIccChanged(events, 1, null);
+        Phone[] phones = PhoneFactory.getPhones();
+        for (Phone phone : phones) {
+            phone.mCi.registerForAvailable(events, 1, null);
+            phone.mCi.registerForNotAvailable(events, 1, null);
+            phone.registerForServiceStateChanged(events, 1, null);
+        }
+        HonorSubscriberAdoption.addListener(handler, changed);
+        HonorRadioCommBroker.addStateListener(handler, changed);
+        ContentObserver settings = new ContentObserver(handler) {
+            @Override public void onChange(boolean selfChange) { changed.run(); }
+        };
+        context.getContentResolver().registerContentObserver(
+                SubscriptionManager.CONTENT_URI, true, settings);
+        BroadcastReceiver receiver = new BroadcastReceiver() {
+            @Override public void onReceive(Context ignored, Intent intent) { changed.run(); }
+        };
+        IntentFilter filter = new IntentFilter(CarrierConfigManager.ACTION_CARRIER_CONFIG_CHANGED);
+        filter.addAction(Intent.ACTION_AIRPLANE_MODE_CHANGED);
+        context.registerReceiver(receiver, filter, null, handler);
+        return () -> {
+            UiccController.getInstance().unregisterForIccChanged(events);
+            for (Phone phone : phones) {
+                phone.mCi.unregisterForAvailable(events);
+                phone.mCi.unregisterForNotAvailable(events);
+                phone.unregisterForServiceStateChanged(events);
+            }
+            context.getContentResolver().unregisterContentObserver(settings);
+            context.unregisterReceiver(receiver);
+        };
+    }
+    public Boolean cellularInService(int slot) {
+        Phone[] phones = PhoneFactory.getPhones();
+        if (slot < 0 || slot >= phones.length || phones[slot] == null) return null;
+        ServiceState state = phones[slot].getServiceState();
+        return state == null ? null : state.getState() == ServiceState.STATE_IN_SERVICE;
+    }
+    public long wallClockMillis() { return System.currentTimeMillis(); }
+    public Boolean normalCall(HonorCompletedCallQoe.Result result) {
+        return HonorImsDefaultOpenPolicy.normalCall(result, config.normalCodes());
+    }
+    public boolean temporaryFailure(HonorCompletedCallQoe.Result result) {
+        return config.temporaryFailure(result);
+    }
+}
diff --git a/src/com/android/internal/telephony/honor/HonorImsDefaultOpenPolicy.java b/src/com/android/internal/telephony/honor/HonorImsDefaultOpenPolicy.java
