@@ -0,0 +1,114 @@
+package com.android.internal.telephony.honor;
+
+/** Pure production-predicate cases; no Android/Binder/phone execution. */
+public final class EuiccReadinessTest {
+    private static int checks;
+    private static void check(boolean result) {
+        checks++;
+        if (!result) throw new AssertionError("readiness case "+checks);
+    }
+    private static final class Facts {
+        EuiccReadiness.Epoch epoch;
+        long revision;
+        Object slot=new Object(), card=new Object(), port=new Object();
+        int physicalSlot=1, phone=1, portIndex=0, publicId=7, defaultId=7;
+        boolean embedded=true, active=true, mapped=true, associated=true;
+        String eid="89012345678901234567890123456789"; // Synthetic fixture, never device data.
+        Facts(EuiccReadiness.Epoch epoch) { this.epoch=epoch; }
+        EuiccReadiness.Snapshot snapshot() {
+            return new EuiccReadiness.Snapshot(epoch,revision,slot,card,port,physicalSlot,phone,portIndex,
+                    publicId,defaultId,embedded,active,mapped,associated,eid);
+        }
+    }
+    public static void main(String[] args) {
+        var epoch=new EuiccReadiness.Epoch(1);
+        var state=new EuiccReadiness(epoch);
+        var f=new Facts(epoch);
+        var valid=f.snapshot();
+        check(state.observe(valid,valid)); // No active profile/application/subscription predicate.
+        check(state.recheck(valid,valid));
+        check(!valid.toString().contains(f.eid));
+        for (String bad:new String[]{null,"","1".repeat(31),"1".repeat(33),
+                "1".repeat(31)+"a","1".repeat(31)+"１"}) {
+            f.eid=bad;
+            check(!state.observe(f.snapshot(),f.snapshot())); // Even EID-ready event is insufficient.
+        }
+        f.eid="89012345678901234567890123456789";
+        check(state.observe(f.snapshot(),f.snapshot())); // Delayed genuine EID becomes usable.
+        f.defaultId=8; check(!state.recheck(f.snapshot(),f.snapshot()));
+        f.defaultId=7; f.publicId=-2; check(!state.observe(f.snapshot(),f.snapshot()));
+        f.publicId=7; f.associated=false; check(!state.observe(f.snapshot(),f.snapshot()));
+        f.associated=true; f.physicalSlot=0; check(!state.observe(f.snapshot(),f.snapshot()));
+        f.physicalSlot=1; f.phone=0; check(!state.observe(f.snapshot(),f.snapshot()));
+        f.phone=1; f.portIndex=-1; check(!state.observe(f.snapshot(),f.snapshot()));
+        f.portIndex=0; f.mapped=false; check(!state.observe(f.snapshot(),f.snapshot()));
+        f.mapped=true; f.active=false; check(!state.observe(f.snapshot(),f.snapshot()));
+        f.active=true; f.embedded=false; check(!state.observe(f.snapshot(),f.snapshot()));
+        f.embedded=true;
+        check(state.observe(f.snapshot(),f.snapshot()));
+        var old=f.snapshot(); f.card=new Object();
+        check(!state.recheck(old,f.snapshot())); // Old-card event cannot authorize replacement.
+        check(state.observe(f.snapshot(),f.snapshot()));
+        old=f.snapshot(); f.port=new Object(); check(!state.recheck(old,f.snapshot()));
+        check(state.observe(f.snapshot(),f.snapshot()));
+        old=f.snapshot(); f.portIndex=1; check(!state.recheck(old,f.snapshot()));
+        f.portIndex=0; check(state.observe(f.snapshot(),f.snapshot()));
+        old=f.snapshot(); f.slot=new Object(); check(!state.recheck(old,f.snapshot()));
+        check(state.observe(f.snapshot(),f.snapshot()));
+        f.epoch=new EuiccReadiness.Epoch(1); // Even equal generation value is a new owner token.
+        check(!state.recheck(f.snapshot(),f.snapshot()));
+        f.epoch=epoch; check(state.observe(f.snapshot(),f.snapshot()));
+        old=f.snapshot(); f.revision++; check(!state.recheck(old,f.snapshot()));
+        check(state.observe(f.snapshot(),f.snapshot()));
+        old=f.snapshot(); f.eid="89012345678901234567890123456788";
+        check(!state.recheck(old,f.snapshot()));
+        state.invalidate(); check(!state.recheck(f.snapshot(),f.snapshot()));
+
+        // New mux admission retires endpoint eligibility BEFORE dispatch, even for same owner.
+        check(state.observe(f.snapshot(),f.snapshot()));
+        check(!state.recheck(null,null)); // Null endpoint fence makes observer reads unavailable.
+        check(!state.recheck(f.snapshot(),f.snapshot())); // No stale cached-ready resurrection.
+        f.epoch=new EuiccReadiness.Epoch(epoch.generation);
+        check(!state.observe(f.snapshot(),f.snapshot())); // Retired model cannot accept new token.
+        var nextEndpoint=new EuiccReadiness(f.epoch);
+        check(!nextEndpoint.observe(null,null)); // Pending/unresolved mux cannot publish eligibility.
+        check(nextEndpoint.observe(f.snapshot(),f.snapshot())); // Only future confirmed endpoint input.
+        f.epoch=epoch;
+        check(!nextEndpoint.recheck(f.snapshot(),f.snapshot())); // Same generation, old token refused.
+
+        var fence=new java.util.concurrent.atomic.AtomicReference<EuiccReadiness.Epoch>(epoch);
+        var currentCard=f.card;
+        check(!state.retireIfCardChanged(fence,null,currentCard)); // Initial delayed appearance.
+        check(fence.get()==epoch);
+        check(!state.retireIfCardChanged(fence,currentCard,currentCard)); // Same-card late EID.
+        check(state.observe(f.snapshot(),f.snapshot()));
+        check(state.retireIfCardChanged(fence,currentCard,new Object()));
+        check(fence.get()==null);
+        check(!state.recheck(f.snapshot(),f.snapshot()));
+        var newer=new EuiccReadiness.Epoch(epoch.generation);
+        fence.set(newer);
+        check(state.retireIfCardChanged(fence,currentCard,null)); // Detect old-card loss.
+        check(fence.get()==newer); // Old observer cannot clear a newer coordinator token.
+
+        var mux=new SepMuxTrial();
+        var evidence=new SepMuxTrial.Evidence(1001,"u:r:radio:s0",true,6,
+                SepMuxTrial.VENDOR_HASH,true,true,true); // Protocol-model fixture, not owner proof.
+        mux.begin(evidence,1,77,SepMuxTrial.Selector.EUICC,
+                new SepMuxTrial.Baseline(1,9,true,true,false),100);
+        mux.markDispatched(100);
+        var before=mux.queryStatus(101);
+        mux.response(1,77,1005,0,0,102);
+        mux.status(before,true,true,true,1,true,103);
+        check(!mux.canRequestPhysicalReturn());
+        mux.indication(1,1002,new int[]{1,0},104);
+        var after=mux.queryStatus(105);
+        mux.status(after,true,true,true,1,true,106);
+        check(mux.canRequestPhysicalReturn());
+        f.eid="";
+        check(!state.observe(f.snapshot(),f.snapshot()));
+        check(mux.canRequestPhysicalReturn()); // EID failure must not strand known mux outcome.
+        check(state.retireIfCardChanged(fence,currentCard,null));
+        check(mux.canRequestPhysicalReturn()); // Card-retirement UI fence cannot rewrite mux outcome.
+        System.out.println("PASS "+checks+" checks; pure state/production mux model only");
+    }
+}
