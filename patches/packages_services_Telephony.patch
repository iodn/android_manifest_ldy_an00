@@ -0,0 +1,194 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.internal.telephony.honor;
+
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.nio.charset.StandardCharsets;
+import static com.android.internal.telephony.honor.HonorCompletedCallQoe.*;
+import static com.android.internal.telephony.honor.HonorImsDcRecoveryPolicy.*;
+
+public final class HonorImsDcPolicyTest {
+    private static int checks;
+    private static long nextCall = 1;
+    private static void check(boolean value) {
+        checks++;
+        if (!value) throw new AssertionError("check " + checks);
+    }
+    private static Result call(Profile profile, long binding, Integer error,
+            boolean dc, Direction direction, Domain domain) {
+        Epoch epoch = new Epoch(profile.slot(),binding,profile.identityEpoch(),nextCall++);
+        HonorCompletedCallQoe projection = new HonorCompletedCallQoe(epoch);
+        String message = "INVITE\r\nTo: local\r\n\r\nv=0\r\nm=application "
+                + (dc ? 9 : 0) + " UDP/DTLS/SCTP data";
+        projection.sipUpdate(epoch,1,100,sip(profile.slot(),1,0,0,message));
+        if (error != null) {
+            projection.sipUpdate(epoch,2,500,sip(profile.slot(),1,1,error,
+                    "SIP/2.0 "+error+"\r\nTo: local;tag=x"));
+        }
+        return projection.complete(new Facts(epoch,direction,domain,null,false,
+                error == null ? Stage.CONNECTED : Stage.STARTING,false,1000,true));
+    }
+    private static HonorCompletedSipDecoder.Update sip(int slot,int type,int dir,int code,String message) {
+        byte[] id="dc-test".getBytes(StandardCharsets.US_ASCII);
+        byte[] text=message.getBytes(StandardCharsets.US_ASCII);
+        ByteBuffer b=ByteBuffer.allocate(28+id.length+text.length).order(ByteOrder.LITTLE_ENDIAN);
+        for(int n:new int[]{100,1,type,dir,code,id.length,text.length})b.putInt(n);
+        return HonorCompletedSipDecoder.decode(slot,1,1,b.put(id).put(text).array());
+    }
+    private static Result error(Profile profile,int code) {
+        return call(profile,3,code,true,Direction.MO,Domain.VOLTE);
+    }
+    public static void main(String[] args) {
+        Profile a=new Profile(0,7),b=new Profile(1,8);
+        var policy=new HonorImsDcRecoveryPolicy(a);
+        check(policy.onCall(a,3,error(a,488),0,0)==null);
+        check(policy.errorCount(488)==1&&!policy.recoveryDisabled());
+        Change shortVote=policy.onCall(a,3,error(a,488),0,100);
+        check(shortVote.disabled()&&shortVote.evaluationId()==501
+                &&shortVote.expiresElapsedMillis()==100+SHORT_MS);
+        Change longVote=policy.onCall(a,3,error(a,488),0,200);
+        check(longVote.disabled()&&longVote.evaluationId()==502
+                &&longVote.expiresElapsedMillis()==200+LONG_MS);
+        check(longVote.token()!=shortVote.token());
+        check(policy.onDeadline(a,shortVote.token(),shortVote.expiresElapsedMillis())==null);
+        check(policy.recoveryDisabled());
+        check(policy.onDeadline(a,longVote.token(),longVote.expiresElapsedMillis()-1)==null);
+        Change release=policy.onDeadline(a,longVote.token(),longVote.expiresElapsedMillis());
+        check(release!=null&&!release.disabled()&&release.token()==longVote.token());
+        check(!policy.recoveryDisabled()&&policy.errorCount(488)==3);
+        check(policy.onDeadline(a,longVote.token(),longVote.expiresElapsedMillis()+1)==null);
+
+        // Positive optional session count promotes at four, not three.
+        policy=new HonorImsDcRecoveryPolicy(a);
+        check(policy.onCall(a,3,error(a,503),1,0)==null);
+        shortVote=policy.onCall(a,3,error(a,503),1,1);
+        check(shortVote.evaluationId()==503&&shortVote.expiresElapsedMillis()==1+SHORT_MS);
+        Change third=policy.onCall(a,3,error(a,503),1,2);
+        check(third.evaluationId()==503&&third.expiresElapsedMillis()==2+SHORT_MS);
+        longVote=policy.onCall(a,3,error(a,503),1,3);
+        check(longVote.evaluationId()==504&&longVote.expiresElapsedMillis()==3+LONG_MS);
+        check(policy.onEvaluation(a,shortVote.token(),EvaluationResult.FAIL,10)==null);
+        check(policy.errorCount(503)==4&&policy.recoveryDisabled());
+        check(policy.onEvaluation(a,longVote.token(),EvaluationResult.SUCCESS,10)==null);
+        check(policy.onEvaluation(a,longVote.token(),EvaluationResult.UNKNOWN,10)==null);
+        release=policy.onEvaluation(a,longVote.token(),EvaluationResult.FAIL,10);
+        check(release!=null&&!release.disabled()&&policy.errorCount(503)==0);
+        check(policy.onCall(a,3,error(a,503),0,11)==null);
+        check(policy.onCall(a,3,error(a,503),0,12)==null);
+        check(policy.errorCount(503)==2);
+        check(policy.onCall(a,3,error(a,503),0,10+FAILED_CURE_PROTECTION_MS-1)==null);
+        check(!policy.recoveryDisabled()&&policy.errorCount(503)==3);
+        Change protectedExpired=policy.onCall(a,3,error(a,503),0,10+FAILED_CURE_PROTECTION_MS);
+        check(protectedExpired!=null&&protectedExpired.evaluationId()==504);
+
+        // Independent slots/error identity; no shared mutable evaluation error field.
+        var first=new HonorImsDcRecoveryPolicy(a);
+        var second=new HonorImsDcRecoveryPolicy(b);
+        first.onCall(a,3,error(a,488),0,0);
+        second.onCall(b,3,error(b,503),0,0);
+        Change evalA=first.onCall(a,3,error(a,488),0,1);
+        Change evalB=second.onCall(b,3,error(b,503),0,1);
+        check(evalA.evaluationId()==501&&evalB.evaluationId()==503);
+        check(first.onEvaluation(b,evalB.token(),EvaluationResult.FAIL,2)==null);
+        check(first.errorCount(488)==2&&second.errorCount(503)==2);
+        check(first.onEvaluation(a,evalA.token(),EvaluationResult.FAIL,3)!=null);
+        check(first.errorCount(488)==0&&second.errorCount(503)==2&&second.recoveryDisabled());
+
+        // Superseding the error on the same profile also retires the old evaluation token.
+        policy=new HonorImsDcRecoveryPolicy(a);
+        policy.onCall(a,3,error(a,488),0,0);
+        Change oldError=policy.onCall(a,3,error(a,488),0,1);
+        policy.onCall(a,3,error(a,503),0,2);
+        Change newError=policy.onCall(a,3,error(a,503),0,3);
+        check(policy.onEvaluation(a,oldError.token(),EvaluationResult.FAIL,4)==null);
+        check(policy.errorCount(488)==2&&policy.errorCount(503)==2);
+        check(policy.onEvaluation(a,newError.token(),EvaluationResult.FAIL,5)!=null);
+        check(policy.errorCount(488)==2&&policy.errorCount(503)==0);
+
+        // Unknown is not the stock's proven optional-service-absent zero.
+        policy=new HonorImsDcRecoveryPolicy(a);
+        policy.onCall(a,3,error(a,488),null,0);
+        check(policy.onCall(a,3,error(a,488),null,1)==null);
+        check(policy.errorCount(488)==2&&!policy.recoveryDisabled());
+        check(policy.onCall(a,3,error(a,488),-1,2)==null);
+        check(!policy.recoveryDisabled());
+        check(policy.onCall(a,3,error(a,488),0,3).evaluationId()==502);
+
+        // Missing optional counter never replaces an already owned deadline/evaluation.
+        policy=new HonorImsDcRecoveryPolicy(a);
+        policy.onCall(a,3,error(a,488),0,0);
+        Change knownVote=policy.onCall(a,3,error(a,488),0,1);
+        check(policy.onCall(a,3,error(a,488),null,2)==null);
+        check(policy.onCall(a,3,error(a,488),-1,3)==null);
+        check(policy.errorCount(488)==4&&policy.recoveryDisabled());
+        check(policy.onDeadline(a,knownVote.token(),knownVote.expiresElapsedMillis()-1)==null);
+        check(policy.onDeadline(a,knownVote.token(),knownVote.expiresElapsedMillis())!=null);
+
+        // Normal completed DC calls clear only the recovery vote and all error counts.
+        policy.onCall(a,3,error(a,503),0,4);
+        policy.onCall(a,3,error(a,503),0,4);
+        release=policy.onCall(a,3,call(a,3,null,true,Direction.MO,Domain.VOLTE),null,5);
+        check(release!=null&&!release.disabled());
+        check(policy.errorCount(488)==0&&policy.errorCount(503)==0&&!policy.recoveryDisabled());
+        check(policy.onCall(a,3,call(a,3,null,true,Direction.MO,Domain.VOLTE),0,6)==null);
+        check(policy.onEvaluation(a,release.token(),EvaluationResult.FAIL,7)==null);
+
+        // Mandatory identity/binding/projection facts are never guessed.
+        policy=new HonorImsDcRecoveryPolicy(a);
+        check(policy.onCall(b,3,error(a,488),0,0)==null);
+        check(policy.onCall(a,4,error(a,488),0,0)==null);
+        check(policy.onCall(a,3,error(new Profile(0,9),488),0,0)==null);
+        check(policy.onCall(a,3,error(a,488),0,-1)==null);
+        check(policy.onCall(a,3,null,0,0)==null);
+        check(policy.onCall(a,3,call(a,3,488,true,Direction.MT,Domain.VOLTE),0,0)==null);
+        check(policy.onCall(a,3,call(a,3,488,false,Direction.MO,Domain.VOLTE),0,0)==null);
+        check(policy.onCall(a,3,call(a,3,488,true,Direction.MO,Domain.VOWIFI),0,0)==null);
+        check(policy.errorCount(488)==0);
+
+        policy.onCall(a,3,error(a,488),0,0);
+        shortVote=policy.onCall(a,3,error(a,488),0,1);
+        check(policy.onScreenOn(a,shortVote.expiresElapsedMillis()-1)==null);
+        check(policy.onScreenOn(a,shortVote.expiresElapsedMillis())!=null);
+        policy.onCall(a,3,error(a,503),0,2);
+        shortVote=policy.onCall(a,3,error(a,503),0,3);
+        policy.retire();
+        check(!policy.recoveryDisabled()&&policy.errorCount(503)==0);
+        check(policy.onDeadline(a,shortVote.token(),shortVote.expiresElapsedMillis())==null);
+        check(policy.onEvaluation(a,shortVote.token(),EvaluationResult.FAIL,9)==null);
+        check(policy.onCall(a,3,error(a,488),0,10)==null);
+
+        // User/city eligibility and a recovery vote are independent facts.
+        for(boolean user:new boolean[]{false,true})
+            for(boolean city:new boolean[]{false,true})
+                for(boolean recovery:new boolean[]{false,true})
+                    for(int current:new int[]{0,1}) {
+                        var input=new HonorImsDcModePolicy.Inputs(true,true,user,city,current,recovery);
+                        boolean target=user&&city&&!recovery;
+                        var expected=target==(current==1)?HonorImsDcModePolicy.Decision.UNCHANGED
+                                :target?HonorImsDcModePolicy.Decision.ON:HonorImsDcModePolicy.Decision.OFF;
+                        check(HonorImsDcModePolicy.decide(input)==expected);
+                    }
+        var none=HonorImsDcModePolicy.Decision.UNCHANGED;
+        check(HonorImsDcModePolicy.decide(null)==none);
+        check(HonorImsDcModePolicy.decide(new HonorImsDcModePolicy.Inputs(null,true,true,true,0,false))==none);
+        check(HonorImsDcModePolicy.decide(new HonorImsDcModePolicy.Inputs(true,null,true,true,0,false))==none);
+        check(HonorImsDcModePolicy.decide(new HonorImsDcModePolicy.Inputs(true,true,null,true,0,false))==none);
+        check(HonorImsDcModePolicy.decide(new HonorImsDcModePolicy.Inputs(true,true,true,null,0,false))==none);
+        check(HonorImsDcModePolicy.decide(new HonorImsDcModePolicy.Inputs(true,true,true,true,null,false))==none);
+        check(HonorImsDcModePolicy.decide(new HonorImsDcModePolicy.Inputs(false,true,true,true,0,false))==none);
+        check(HonorImsDcModePolicy.decide(new HonorImsDcModePolicy.Inputs(true,false,true,true,0,false))==none);
+        check(HonorImsDcModePolicy.decide(new HonorImsDcModePolicy.Inputs(true,true,true,true,2,false))==none);
+        check(HonorImsDcModePolicy.decide(new HonorImsDcModePolicy.Inputs(true,true,true,false,0,false))==none);
+        var off=HonorImsDcModePolicy.Decision.OFF;
+        check(HonorImsDcModePolicy.decide(new HonorImsDcModePolicy.Inputs(true,true,false,null,1,false))==off);
+        check(HonorImsDcModePolicy.decide(new HonorImsDcModePolicy.Inputs(true,true,null,null,1,true))==off);
+        check(HonorImsDcModePolicy.decide(new HonorImsDcModePolicy.Inputs(true,true,null,false,1,false))==off);
+        check(HonorImsDcModePolicy.decide(new HonorImsDcModePolicy.Inputs(true,true,false,null,0,false))==none);
+        check(HonorImsDcModePolicy.decide(new HonorImsDcModePolicy.Inputs(true,true,null,null,0,true))==none);
+        check(HonorImsDcModePolicy.decide(new HonorImsDcModePolicy.Inputs(true,null,false,null,1,true))==none);
+        System.out.println("PASS "+checks+" DC recovery/mode policy checks");
+    }
+}
