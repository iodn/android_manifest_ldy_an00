index 0000000000000000000000000000000000000000..8b18c9f612b06a7126aa97a31fd664cb33b19924
--- /dev/null
+++ b/src/com/android/internal/telephony/honor/PhysicalSimEvidence.java
@@ -0,0 +1,50 @@
+/* Copyright (C) 2026 The LineageOS Project. SPDX-License-Identifier: Apache-2.0 */
+package com.android.internal.telephony.honor;
+
+/** Actual physical-path observation. EMPTY never supplies fabricated PRESENT, ATR or EID. */
+final class PhysicalSimEvidence {
+    enum Card { ABSENT, PRESENT, RESTRICTED, ERROR, UNKNOWN }
+    enum Presence { PRESENT_PHYSICAL, EMPTY_PHYSICAL }
+    static final class Controller {
+        final Object slot,card;
+        final int mappedSlot,phoneAtPort,portAtPhone,radioState;
+        final Card state;
+        final boolean unknown,active,portActive,euicc,radioAvailable;
+        Controller(Object slot,Object card,int mappedSlot,int phoneAtPort,int portAtPhone,
+                int radioState,Card state,boolean unknown,boolean active,boolean portActive,
+                boolean euicc,boolean radioAvailable) {
+            this.slot=slot;this.card=card;this.mappedSlot=mappedSlot;this.phoneAtPort=phoneAtPort;
+            this.portAtPhone=portAtPhone;this.radioState=radioState;this.state=state;
+            this.unknown=unknown;this.active=active;this.portActive=portActive;this.euicc=euicc;
+            this.radioAvailable=radioAvailable;
+        }
+        private boolean valid() {
+            return slot!=null && mappedSlot==1 && phoneAtPort==1 && portAtPhone==0
+                    && !unknown && active && portActive && radioAvailable && state!=null;
+        }
+        private boolean same(Controller other) {
+            return other!=null && valid() && other.valid() && slot==other.slot && card==other.card
+                    && mappedSlot==other.mappedSlot && phoneAtPort==other.phoneAtPort
+                    && portAtPhone==other.portAtPhone && radioState==other.radioState && state==other.state
+                    && unknown==other.unknown && active==other.active && portActive==other.portActive
+                    && euicc==other.euicc && radioAvailable==other.radioAvailable;
+        }
+    }
+    final long generation;
+    final int slot,port;
+    final Presence presence;
+    private PhysicalSimEvidence(long generation,int slot,int port,Presence presence) {
+        this.generation=generation;this.slot=slot;this.port=port;this.presence=presence;
+    }
+    static PhysicalSimEvidence observe(long generation,Card ci,int slot,int port,boolean validAtr,
+            boolean euiccAtr,Controller first,Controller second) {
+        if(generation<=0 || slot!=1 || port!=0 || ci==null || first==null || !first.same(second)) return null;
+        if(ci==Card.ABSENT && first.state==Card.ABSENT && first.card==null)
+            return new PhysicalSimEvidence(generation,slot,port,Presence.EMPTY_PHYSICAL);
+        if((ci==Card.PRESENT || ci==Card.RESTRICTED) && first.state==ci && first.card!=null
+                && !first.euicc && validAtr && !euiccAtr)
+            return new PhysicalSimEvidence(generation,slot,port,Presence.PRESENT_PHYSICAL);
+        return null;
+    }
+    @Override public String toString(){return "PhysicalSimEvidence["+presence+"]";}
+}
diff --git a/src/com/android/internal/telephony/honor/SepMuxAdmission.java b/src/com/android/internal/telephony/honor/SepMuxAdmission.java
new file mode 100644
index 0000000000000000000000000000000000000000..6c27edc241116adf5a9e22e1342f6be41a4c38c3
--- /dev/null
+++ b/src/com/android/internal/telephony/honor/SepMuxAdmission.java
@@ -0,0 +1,32 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.internal.telephony.honor;
+
+/** Captured mode for one owner. Test consent never substitutes for ownership evidence. */
+final class SepMuxAdmission {
+    private final boolean trustedDebug, enforcingAtConsent;
+    private boolean invalidated;
+    private SepMuxAdmission(boolean trustedDebug, boolean enforcing) {
+        this.trustedDebug=trustedDebug;this.enforcingAtConsent=enforcing;
+    }
+    static SepMuxAdmission strict() { return new SepMuxAdmission(false,true); }
+    static SepMuxAdmission afterConsent(String buildType,boolean debuggable,boolean imageOptIn,
+            boolean trustedDebugConsent,boolean enforcing) {
+        if(!"userdebug".equals(buildType))
+            throw new IllegalStateException("Requires userdebug image");
+        if(trustedDebugConsent) {
+            if(!debuggable || !imageOptIn)
+                throw new IllegalStateException("Trusted-debug test image not enabled");
+            return new SepMuxAdmission(true,enforcing);
+        }
+        SepMuxAdmission strict=strict();strict.require(enforcing);return strict;
+    }
+    boolean isTrustedDebug() { return trustedDebug; }
+    synchronized void require(boolean enforcing) {
+        if(enforcing!=enforcingAtConsent) invalidated=true;
+        if(invalidated)
+            throw new IllegalStateException("SELinux mode changed; owner no longer qualified");
+    }
+}
diff --git a/src/com/android/internal/telephony/honor/SepMuxJournal.java b/src/com/android/internal/telephony/honor/SepMuxJournal.java
new file mode 100644
index 0000000000000000000000000000000000000000..fb0c8fea3df99b77b9318d9f75fde825e97a6160
--- /dev/null
+++ b/src/com/android/internal/telephony/honor/SepMuxJournal.java
@@ -0,0 +1,126 @@
+/* Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0 */
+package com.android.internal.telephony.honor;
+
+import java.io.IOException;
+
+/** One owner-thread journal. Missing means never used, not proof of global modem cleanliness. */
+public final class SepMuxJournal {
+    public interface Store {
+        String read() throws IOException; // null ONLY for definitely absent storage.
+        void writeDurably(String record) throws IOException;
+    }
+    private final Store store;
+    private String record;
+    private boolean failed;
+    private long generation;
+    private int serial;
+    private LpaRecoveryFence recovery;
+    private boolean recoveryPending;
+    public SepMuxJournal(Store store) throws IOException {
+        this(store,null,false);
+    }
+    private SepMuxJournal(Store store,LpaRecoveryFence recovery,boolean inspection) throws IOException {
+        this.recovery=recovery;this.store=store; record=store.read();
+        if(record!=null && !record.matches("SEP1 (CLEAN|PENDING|UNKNOWN) [1-9][0-9]* [1-9][0-9]* [01]\\n"))
+            throw new IOException("Corrupt SEP journal");
+        if(record!=null) {
+            String[] fields=record.trim().split(" ");
+            try {
+                if(Long.parseLong(fields[2])<=0 || Integer.parseInt(fields[3])<=0)
+                    throw new NumberFormatException();
+            } catch(NumberFormatException e) {throw new IOException("Corrupt SEP epoch identity",e);}
+        }
+        if(!inspection) requireClean();
+    }
+    public void requireClean() throws IOException {
+        if(failed || (record!=null && !record.startsWith("SEP1 CLEAN ")))
+            throw new IOException("Unresolved SEP epoch; registration/dispatch refused");
+    }
+    static String recoveryState(Store store) throws IOException {
+        SepMuxJournal history=new SepMuxJournal(store,null,true);
+        return history.record==null ? "ABSENT" : history.record.trim().split(" ")[1];
+    }
+    static boolean unresolvedHistory(Store store) throws IOException {
+        String state=recoveryState(store);
+        return state.equals("PENDING") || state.equals("UNKNOWN");
+    }
+    static SepMuxJournal forRecovery(Store store,LpaRecoveryFence ticket) throws IOException {
+        ticket.requireRunning();
+        return new SepMuxJournal(store,ticket,true);
+    }
+    void requireRecoveryStart(LpaRecoveryFence ticket) throws IOException {
+        ticket.requireRunning();
+        if(recovery!=ticket) requireClean();
+        else if(failed || recoveryPending) throw new IOException("Recovery route already attempted");
+    }
+    static final class CleanRoute {
+        final long generation;
+        final int serial;
+        final SepMuxTrial.Selector target;
+        private CleanRoute(long generation,int serial,SepMuxTrial.Selector target) {
+            this.generation=generation;this.serial=serial;this.target=target;
+        }
+    }
+    /** Historical completed route only; absence is not a route adoption certificate. */
+    CleanRoute cleanRoute() throws IOException {
+        requireClean();
+        if(record==null) return null;
+        String[] fields=record.trim().split(" ");
+        return new CleanRoute(Long.parseLong(fields[2]),Integer.parseInt(fields[3]),
+                "1".equals(fields[4]) ? SepMuxTrial.Selector.EUICC : SepMuxTrial.Selector.PHYSICAL);
+    }
+    /** A setter serial is journaled before dispatch; clean history fences late older finals. */
+    public int firstUnusedSerial() throws IOException {
+        if(recovery==null) requireClean();
+        else {recovery.requireRunning();if(failed) throw new IOException("Recovery journal failed");}
+        if(record==null) return 1;
+        int previous=Integer.parseInt(record.trim().split(" ")[3]);
+        if(previous==Integer.MAX_VALUE) throw new IOException("SEP serial identities exhausted");
+        return previous+1;
+    }
+    /** Must return successfully before ANY setter dispatch can occur. */
+    public void pending(long generation,int serial,SepMuxTrial.Selector target) throws IOException {
+        if(recovery==null) requireClean();
+        else {
+            recovery.requireRunning();
+            if(failed || recoveryPending || serial<firstUnusedSerial() || target!=SepMuxTrial.Selector.EUICC)
+                throw new IOException("Recovery requires one new persisted serial");
+            recoveryPending=true;
+        }
+        if(generation<=0 || serial<=0 || target==null) throw new IOException("Invalid SEP epoch");
+        this.generation=generation;this.serial=serial;
+        write("SEP1 PENDING "+generation+" "+serial+" "+target.wire+"\n");
+    }
+    /** No EID/LPA requirement: known physical return remains a separate operation. */
+    public void completed(long generation,int serial,SepMuxTrial outcome) throws IOException {
+        if(recovery!=null) throw new IOException("Recovery requires fresh route readback");
+        if(failed || record==null || !record.startsWith("SEP1 PENDING ")
+                || this.generation!=generation || this.serial!=serial
+                || outcome==null || !outcome.completionMatches(generation,serial))
+            throw new IOException("Unqualified SEP completion");
+        write(record.replace("PENDING","CLEAN"));
+    }
+    /** Bounded shared-slot route proof; eUICC mode1 alone never publishes LPA/EID readiness. */
+    public void completedRoutePhase(long generation,int serial,SharedSlotRouteTrial outcome) throws IOException {
+        if(failed || record==null || !record.startsWith("SEP1 PENDING ")
+                || this.generation!=generation || this.serial!=serial
+                || outcome==null || !outcome.completionMatches(generation,serial,
+                        Integer.parseInt(record.trim().split(" ")[4])))
+            throw new IOException("Unqualified SEP route completion");
+        write(record.replace("PENDING","CLEAN"));
+        recovery=null;
+    }
+    public void unknown(long generation,int serial) throws IOException {
+        if(failed) throw new IOException("SEP journal failed");
+        if(record!=null && record.startsWith("SEP1 PENDING ")
+                && this.generation==generation && this.serial==serial)
+            write(record.replace("PENDING","UNKNOWN"));
+    }
+    private void write(String value) throws IOException {
+        // Poison memory BEFORE I/O. Any failure must forbid further dispatch in this process.
+        failed=true;
+        store.writeDurably(value);
+        record=value;failed=false;
+    }
+}
diff --git a/src/com/android/internal/telephony/honor/SepMuxRouteAdoption.java b/src/com/android/internal/telephony/honor/SepMuxRouteAdoption.java
new file mode 100644
index 0000000000000000000000000000000000000000..eb97f2ff1b5198a548709afd1d6db96f0592ab31
--- /dev/null
+++ b/src/com/android/internal/telephony/honor/SepMuxRouteAdoption.java
@@ -0,0 +1,69 @@
+/* Copyright (C) 2026 The LineageOS Project. SPDX-License-Identifier: Apache-2.0 */
+package com.android.internal.telephony.honor;
+
+/** Fresh owned route/card readback. A READ never becomes historical selector completion. */
+final class SepMuxRouteAdoption {
+    enum State { ROUTE, CARD, PHYSICAL, READY, UNKNOWN }
+    static final class Proof {
+        final long generation;
+        final int lastSetterSerial, observationSerial;
+        final EuiccReadiness.Epoch endpoint;
+        private Proof(long generation,int setter,int observed,EuiccReadiness.Epoch endpoint) {
+            this.generation=generation;lastSetterSerial=setter;observationSerial=observed;this.endpoint=endpoint;
+        }
+    }
+    final long generation;
+    long deadline;
+    private final long startedAt;
+    final int querySerial;
+    final EuiccReadiness.Epoch endpoint;
+    private final SepMuxJournal.CleanRoute history;
+    final MtkSimTypeQuery query;
+    private State state=State.ROUTE;
+    SepMuxRouteAdoption(SepMuxJournal.CleanRoute history,long generation,int querySerial,long now) {
+        if(history!=null && history.target!=SepMuxTrial.Selector.EUICC || generation<=0
+                || querySerial<=0 || now<0 || now>Long.MAX_VALUE-SharedSlotRouteTrial.ROUTE_TIMEOUT_MS)
+            throw new IllegalStateException("Invalid owned route observation");
+        this.history=history;this.generation=generation;this.querySerial=querySerial;startedAt=now;
+        deadline=now+SharedSlotRouteTrial.ROUTE_TIMEOUT_MS;
+        endpoint=history==null ? new EuiccReadiness.Epoch(generation,0,querySerial)
+                : new EuiccReadiness.Epoch(generation,history.serial);
+        query=new MtkSimTypeQuery(generation,querySerial,deadline);
+    }
+    State state() { return state; }
+    void response(long epoch,int serial,int type,int error,int support,int mode,int reserved,long now) {
+        if(state!=State.ROUTE) return;
+        if(epoch==generation && serial==querySerial && now<startedAt) {state=State.UNKNOWN;return;}
+        query.onResponse(epoch,serial,type,error,support,mode,reserved,now);
+        if(query.state()==MtkSimTypeQuery.State.EUICC) {
+            state=State.CARD;
+            if(now>Long.MAX_VALUE-SepMuxTrial.COMPLETION_TIMEOUT_MS) {state=State.UNKNOWN;return;}
+            // The GET completed within its own ten-second deadline. Its accepted provenance does
+            // not expire while genuine controller/card readiness is still being observed.
+            deadline=now+SepMuxTrial.COMPLETION_TIMEOUT_MS;
+        }
+        else if(history==null && query.state()==MtkSimTypeQuery.State.PHYSICAL) state=State.PHYSICAL;
+        else if(query.state()!=MtkSimTypeQuery.State.WAITING) state=State.UNKNOWN;
+    }
+    PhysicalSimEvidence physical(long epoch,PhysicalSimEvidence sample,long now) {
+        if(state!=State.PHYSICAL || now<startedAt || now>=deadline || epoch!=generation
+                || !query.current(epoch,now) || sample==null || sample.generation!=generation) {
+            state=State.UNKNOWN;throw new IllegalStateException("Unqualified physical readback");
+        }
+        state=State.READY;return sample;
+    }
+    Proof card(long epoch,boolean present,boolean euiccAtr,int slot,int port,String eid,
+            EuiccReadiness.Snapshot first,EuiccReadiness.Snapshot second,long now) {
+        if(state!=State.CARD) throw new IllegalStateException("Fresh mode1 receipt required");
+        if(now<startedAt || now>=deadline || epoch!=generation || !present || !euiccAtr || slot!=1
+                || port!=0 || !EuiccReadiness.validEid(eid) || first==null || second==null
+                || !first.valid(endpoint) || !second.valid(endpoint) || !first.same(second)
+                || first.portIndex!=port || !first.matchesProvidedEid(eid)) {
+            state=State.UNKNOWN;throw new IllegalStateException("Unqualified adoption card readback");
+        }
+        state=State.READY;return new Proof(generation,history==null ? 0 : history.serial,
+                history==null ? querySerial : -1,endpoint);
+    }
+    void expire(long now) { if(now>=deadline && state!=State.READY) state=State.UNKNOWN; }
+    void unavailable() {state=State.UNKNOWN;query.unavailable();}
+}
