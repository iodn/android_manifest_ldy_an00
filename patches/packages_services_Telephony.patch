@@ -0,0 +1,23 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.internal.telephony.honor;
+
+/** Protobuf comm101 service-2 payload only. No reset of other Booster service categories. */
+public final class HonorCallQosCodec {
+    private HonorCallQosCodec() {}
+
+    /**
+     * Exactly two nested records, UL then DL. Nested fields are bandwidth=1, RTT=2,
+     * loss=3. Explicit zeros on STOP are wire-valid protobuf; byte identity with the
+     * stock generated writer's default-value omission has not been asserted.
+     */
+    public static byte[] encode(boolean start) {
+        int bandwidth = start ? 1 : 0;
+        int rtt = start ? 4 : 0;
+        int loss = start ? 2 : 0;
+        return new byte[] {8, 2, 18, 6, 8, (byte) bandwidth, 16, (byte) rtt, 24, (byte) loss,
+                18, 6, 8, (byte) bandwidth, 16, (byte) rtt, 24, (byte) loss};
+    }
+}
