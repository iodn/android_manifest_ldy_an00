+  denied(()->{try{initial.check(a,new Object(),endpoint,1);}catch(IOException e){throw new RuntimeException(e);}});
+  ok(lease.check(a,owner,endpoint,1));ok(lease.complete(a,owner,endpoint,2,true));lease.requireRouteAllowed();ok(store.value.equals("L1 C\n"));
+  for(int loss=0;loss<4;loss++) { store=new Store();lease=new LpaOperationLease(store);lease.acquire(a,owner,endpoint,0,10);
+   if(loss==0)lease.ownerLost();if(loss==1)ok(!lease.check(a,owner,new Object(),1));if(loss==2)ok(!lease.check(a,owner,endpoint,10));if(loss==3)ok(!lease.complete(a,owner,endpoint,1,false));
+   ok(lease.state()==LpaOperationLease.State.UNKNOWN);denied(lease::requireRouteAllowed);ok(new LpaOperationLease(store).state()==LpaOperationLease.State.UNKNOWN);
