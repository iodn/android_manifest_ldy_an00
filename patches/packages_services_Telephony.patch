index 0000000000000000000000000000000000000000..6e77788348ca1d58c4f7091a88c02a3a25db4951
--- /dev/null
+++ b/src/com/android/internal/telephony/honor/MtkAssistTransport.java
@@ -0,0 +1,230 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.internal.telephony.honor;
+
+import android.os.BadParcelableException;
+import android.os.Binder;
+import android.os.Handler;
+import android.os.IBinder;
+import android.os.IInterface;
+import android.os.Parcel;
+import android.os.RemoteException;
+import java.util.NoSuchElementException;
+import java.util.concurrent.atomic.AtomicBoolean;
+
+/** Dedicated stock Assist response slots, independent of normal radio and IMS owners. */
+final class MtkAssistTransport {
+    static final String DATA = "vendor.mediatek.hardware.mtkradioex.data.IMtkRadioExData";
+    static final String MODEM = "vendor.mediatek.hardware.mtkradioex.modem.IMtkRadioExModem";
+    static final String CALLBACK_HASH = "c6cd0b5b3ab776749a516a4b485a5fc00dbc165c";
+    private static final int GET_VERSION = 16777215, GET_HASH = 16777214, CLIENT = 4;
+    static final class IncompatibleServiceException extends RemoteException {
+        IncompatibleServiceException(String message) { super(message); }
+    }
+    interface Listener {
+        void response(int slot, long generation, MtkAssistSyncState.Kind method,
+                int serial, int type, int error);
+        void unavailable(int slot, long generation);
+    }
+    private final IBinder data;
+    private final IBinder acknowledgement;
+    private final boolean modem;
+    private final int slot;
+    private final long generation;
+    private final Handler handler;
+    private final Listener listener;
+    private final AtomicBoolean failed = new AtomicBoolean(), closed = new AtomicBoolean();
+    private final IBinder.DeathRecipient death = this::fail;
+    private final Endpoint response;
+    private boolean registrationAttempted;
+    private volatile boolean registered, incompatible;
+
+    /** Metadata RPCs run on the connection worker, never the Phone looper. */
+    MtkAssistTransport(IBinder data, int slot, long generation, Handler handler, Listener listener)
+            throws RemoteException {
+        this(data, data, false, slot, generation, handler, listener);
+    }
+    MtkAssistTransport(IBinder modem, IBinder acknowledgement, int slot, long generation,
+            Handler handler, Listener listener) throws RemoteException {
+        this(modem, acknowledgement, true, slot, generation, handler, listener);
+    }
+    private MtkAssistTransport(IBinder data, IBinder acknowledgement, boolean modem, int slot,
+            long generation, Handler handler, Listener listener) throws RemoteException {
+        if (slot < 0 || slot > 1 || generation <= 0) throw new IllegalArgumentException();
+        this.data = java.util.Objects.requireNonNull(data);
+        this.acknowledgement = java.util.Objects.requireNonNull(acknowledgement);
+        this.modem = modem;
+        this.response = new Endpoint();
+        this.slot = slot;
+        this.generation = generation;
+        this.handler = handler;
+        this.listener = listener;
+        if (!(modem ? MODEM : DATA).equals(data.getInterfaceDescriptor()) || version() < 3
+                || !DATA.equals(acknowledgement.getInterfaceDescriptor()))
+            throw new IncompatibleServiceException("Unsupported Assist service");
+        data.linkToDeath(death, 0);
+        if (acknowledgement != data) {
+            try { acknowledgement.linkToDeath(death, 0); }
+            catch (RemoteException | RuntimeException error) {
+                data.unlinkToDeath(death, 0);
+                throw error;
+            }
+        }
+    }
+    private int version() throws RemoteException {
+        Parcel input = Parcel.obtain(data), output = Parcel.obtain();
+        try {
+            input.writeInterfaceToken(modem ? MODEM : DATA);
+            if (!data.transact(GET_VERSION, input, output, 0))
+                throw new IncompatibleServiceException("Assist service has no version");
+            output.readException();
+            return output.readInt();
+        } finally { input.recycle(); output.recycle(); }
+    }
+    /** Claims only the dedicated Assist response. No indication or normal callback is changed. */
+    void register() throws RemoteException {
+        if (registrationAttempted || failed.get() || closed.get())
+            throw new RemoteException("Assist registration unavailable");
+        registrationAttempted = true;
+        Parcel input = Parcel.obtain(data);
+        try {
+            input.writeInterfaceToken(modem ? MODEM : DATA);
+            input.writeStrongBinder(response);
+            transact(modem ? 32 : 11, input);
+            registered = true;
+        } catch (RemoteException | RuntimeException error) {
+            fail();
+            throw error;
+        } finally { input.recycle(); }
+    }
+    boolean incompatible() { return incompatible; }
+    boolean healthy() { return registered && !failed.get() && !closed.get(); }
+
+    void send(MtkAssistSyncState.Notification request, int serial) throws RemoteException {
+        if (serial <= 0 || request.slot() != slot || request.binding() != generation || !healthy())
+            throw new RemoteException("Stale Assist notification");
+        Parcel input = Parcel.obtain(data);
+        try {
+            input.writeInterfaceToken(modem ? MODEM : DATA);
+            input.writeInt(serial);
+            int code;
+            int[] values = request.values();
+            if (modem != (request.kind() == MtkAssistSyncState.Kind.VOIP))
+                throw new IllegalArgumentException("Wrong Assist service");
+            switch (request.kind()) {
+                case DATA, DEFAULT_DATA -> {
+                    if (values.length != 5) throw new IllegalArgumentException("Invalid data tuple");
+                    input.writeIntArray(values);
+                    code = 8;
+                }
+                case SCREEN -> {
+                    input.writeInt(3);
+                    input.writeInt(values[0]);
+                    input.writeInt(-1);
+                    code = 7;
+                }
+                case VOIP -> {
+                    if (values.length != 1 || (values[0] != 0 && values[0] != 1))
+                        throw new IllegalArgumentException("Invalid audio mode");
+                    input.writeInt(1);
+                    input.writeInt(values[0]);
+                    code = 33;
+                }
+                default -> throw new IllegalArgumentException("Unknown notification");
+            }
+            input.writeInt(CLIENT);
+            transact(code, input);
+            // A successful Binder transaction is not a modem response.
+        } catch (RemoteException | RuntimeException error) {
+            fail();
+            throw error;
+        } finally { input.recycle(); }
+    }
+    private void transact(int code, Parcel input) throws RemoteException {
+        if (!data.transact(code, input, null, IBinder.FLAG_ONEWAY))
+            throw new RemoteException("Assist transaction refused");
+    }
+    private void acknowledge() throws RemoteException {
+        Parcel input = Parcel.obtain(acknowledgement);
+        try {
+            input.writeInterfaceToken(DATA);
+            if (!acknowledgement.transact(9, input, null, IBinder.FLAG_ONEWAY))
+                throw new RemoteException("Assist acknowledgement refused");
+        } finally { input.recycle(); }
+    }
+    private void unlink() {
+        try { data.unlinkToDeath(death, 0); }
+        catch (NoSuchElementException alreadyDead) { }
+        if (acknowledgement != data) {
+            try { acknowledgement.unlinkToDeath(death, 0); }
+            catch (NoSuchElementException alreadyDead) { }
+        }
+    }
+    /** Retires local callbacks only. Never unregister a newer native callback owner. */
+    void close() {
+        if (closed.compareAndSet(false, true)) unlink();
+    }
+    private void fail() {
+        if (!closed.get() && failed.compareAndSet(false, true)) {
+            unlink();
+            handler.post(() -> {
+                if (!closed.get()) listener.unavailable(slot, generation);
+            });
+        }
+    }
+    private static int[] responseInfo(Parcel input) {
+        if (input.readInt() != 1) throw new BadParcelableException("Missing radio response");
+        int start = input.dataPosition(), size = input.readInt();
+        if (size < 16 || size > input.dataSize() - start)
+            throw new BadParcelableException("Malformed radio response");
+        int[] value = {input.readInt(), input.readInt(), input.readInt()};
+        input.setDataPosition(start + size);
+        if (value[0] < 0 || value[0] > 2) throw new BadParcelableException("Unknown response type");
+        return value;
+    }
+    private final class Endpoint extends Binder implements IInterface {
+        private final String descriptor = modem
+                ? "vendor.mediatek.hardware.mtkradioex.assist.IAssistModemResponse"
+                : "vendor.mediatek.hardware.mtkradioex.assist.IAssistRadioResponse";
+        Endpoint() {
+            attachInterface(this, descriptor);
+            markVintfStability();
+        }
+        @Override public IBinder asBinder() { return this; }
+        @Override protected boolean onTransact(int code, Parcel input, Parcel output, int flags)
+                throws RemoteException {
+            if (code == INTERFACE_TRANSACTION) {
+                if (output != null) output.writeString(descriptor);
+                return true;
+            }
+            if (code == GET_VERSION || code == GET_HASH) {
+                input.enforceInterface(descriptor);
+                if (output == null) return false;
+                output.writeNoException();
+                if (code == GET_VERSION) output.writeInt(4);
+                else output.writeString(CALLBACK_HASH);
+                return true;
+            }
+            if (code < 1 || code > (modem ? 1 : 2)) return super.onTransact(code, input, output, flags);
+            try {
+                input.enforceInterface(descriptor);
+                int[] info = responseInfo(input);
+                input.enforceNoDataAvail();
+                if (info[0] == 2) acknowledge();
+                MtkAssistSyncState.Kind method = modem ? MtkAssistSyncState.Kind.VOIP
+                        : code == 1 ? MtkAssistSyncState.Kind.SCREEN : MtkAssistSyncState.Kind.DATA;
+                if (!failed.get() && !closed.get())
+                    handler.post(() -> {
+                        if (!failed.get() && !closed.get())
+                            listener.response(slot, generation, method, info[1], info[0], info[2]);
+                    });
+            } catch (BadParcelableException | SecurityException error) {
+                if (!closed.get()) incompatible = true;
+                fail();
+            } catch (RemoteException | RuntimeException error) { fail(); }
+            return true;
+        }
+    }
+}
diff --git a/src/com/android/internal/telephony/honor/MtkAssistVoipController.java b/src/com/android/internal/telephony/honor/MtkAssistVoipController.java
new file mode 100644
index 0000000000000000000000000000000000000000..33b07005be6bb3529e251e29ad9130930b4dd771
--- /dev/null
+++ b/src/com/android/internal/telephony/honor/MtkAssistVoipController.java
@@ -0,0 +1,238 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.internal.telephony.honor;
+
+import android.content.Context;
+import android.media.AudioManager;
+import android.os.Handler;
+import android.os.IBinder;
+import android.os.IServiceCallback;
+import android.os.ServiceManager;
+import android.telephony.SubscriptionManager;
+import android.util.Log;
+
+import com.android.internal.telephony.Phone;
+import com.android.internal.telephony.PhoneFactory;
+
+import java.util.Arrays;
+
+/** Dedicated Modem Assist audio notification; neither a call-state nor a DDS setter. */
+final class MtkAssistVoipController implements MtkAssistTransport.Listener {
+    private static final String TAG = "LdyAn00Assist";
+    private final Handler handler, connections;
+    private final Runnable changed, external;
+    private final AudioManager audio;
+    private final MtkAssistVoipState state = new MtkAssistVoipState();
+    private final MtkAssistTransport[] transports = new MtkAssistTransport[2];
+    private final IBinder[] endpoints = new IBinder[2], announced = new IBinder[2],
+            rejected = new IBinder[2], acknowledgements = new IBinder[2];
+    private final long[] generations = new long[2];
+    private final boolean[] connecting = new boolean[2], retryBlocked = new boolean[2];
+    private int serial = 1;
+    private IBinder uncertainOrigin;
+
+    MtkAssistVoipController(Context context, Handler handler, Handler connections, Runnable changed, Runnable external) {
+        this.handler = handler;
+        this.connections = connections;
+        this.changed = changed;
+        this.external = external;
+        audio = context.getSystemService(AudioManager.class);
+        if (audio != null) audio.addOnModeChangedListener(command -> handler.post(command),
+                mode -> external.run());
+        for (int i = 0; i < 2; i++) {
+            final int phone = i;
+            connections.post(() -> {
+                try {
+                    ServiceManager.registerForNotifications(
+                            MtkAssistTransport.MODEM + "/slot" + (phone + 1),
+                            new IServiceCallback.Stub() {
+                                @Override public void onRegistration(String name, IBinder binder) {
+                                    handler.post(() -> {
+                                        announced[phone] = binder;
+                                        if (transports[phone] != null && endpoints[phone] != binder) {
+                                            generations[phone]++;
+                                            transports[phone].close();
+                                            transports[phone] = null;
+                                            connecting[phone] = false;
+                                            state.binding(phone, 0);
+                                            rememberUncertainty(phone);
+                                        }
+                                        external.run();
+                                    });
+                                }
+                            });
+                } catch (android.os.RemoteException | RuntimeException unavailable) {
+                    Log.w(TAG, "Assist modem notification unavailable for slot " + phone);
+                }
+            });
+        }
+    }
+    void externalEvent() { Arrays.fill(retryBlocked, false); }
+    private MtkAssistProfile[] observedProfiles=new MtkAssistProfile[0];
+    void invalidate() { state.invalidate(); }
+    void dataServiceChanged(int phone, IBinder binder) {
+        if (transports[phone] != null && acknowledgements[phone] != binder) {
+            generations[phone]++;
+            transports[phone].close();
+            transports[phone] = null;
+            connecting[phone] = false;
+            state.binding(phone, 0);
+            rememberUncertainty(phone);
+        }
+    }
+
+    /** Called only while the shared eSIM route lease is quiescent. */
+    void review(int[] subscriptions, MtkAssistProfile[] profiles, int defaultPhone, Phone[] phones) {
+        observedProfiles=profiles.clone();
+        state.topology(subscriptions, profiles);
+        int recovery = state.recoveryPhone();
+        if (recovery >= 0) {
+            recoverIfDead(recovery);
+            if (state.recoveryPhone() >= 0 && recovery < subscriptions.length
+                    && uncertainOrigin != null && !uncertainOrigin.isBinderAlive()
+                    && phones[recovery].isRadioAvailable() && transports[recovery] == null)
+                connect(recovery);
+        }
+        if (audio == null || defaultPhone < 0 || defaultPhone >= subscriptions.length
+                || !SubscriptionManager.isValidSubscriptionId(subscriptions[defaultPhone])
+                || !profiles[defaultPhone].usable()
+                || !HonorSubscriberAdoption.isReady(defaultPhone, profiles[defaultPhone])) {
+            state.offer(-1, 0);
+            return;
+        }
+        // Query fresh mode and DDS on startup, DDS changes and reconnect, not a saved audio event.
+        state.offer(defaultPhone, audio.getMode());
+        if (!phones[defaultPhone].isRadioAvailable()) return;
+        if (transports[defaultPhone] == null) connect(defaultPhone);
+        MtkAssistTransport transport = transports[defaultPhone];
+        if (transport == null || !transport.healthy()) return;
+        IBinder currentData = ServiceManager.checkService(
+                MtkAssistTransport.DATA + "/slot" + (defaultPhone + 1));
+        if (currentData == null || currentData != acknowledgements[defaultPhone]
+                || !currentData.isBinderAlive()) {
+            dataServiceChanged(defaultPhone, currentData);
+            changed.run();
+            return;
+        }
+        MtkAssistSyncState.Notification request = state.next();
+        if (request == null || phones[defaultPhone].getSubId() != subscriptions[defaultPhone]
+                || SubscriptionManager.getDefaultDataSubscriptionId() != subscriptions[defaultPhone]
+                || !MtkAssistProfile.current(profiles,phones,subscriptions.length)
+                || !HonorSubscriberAdoption.isReady(defaultPhone, profiles[defaultPhone]))
+            return;
+        if (serial == Integer.MAX_VALUE) return;
+        int token = serial++;
+        if (!state.begin(request, token)) return;
+        try {
+            transport.send(request, token);
+            handler.postDelayed(() -> {
+                if (state.timeout(request.slot(), request.binding(), token)) {
+                    rememberUncertainty(request.slot());
+                    Log.w(TAG, "VoIP notification response timeout");
+                    changed.run();
+                }
+            }, 15_000);
+        } catch (android.os.RemoteException | RuntimeException unavailable) {
+            state.timeout(request.slot(), request.binding(), token);
+            rememberUncertainty(request.slot());
+        }
+    }
+    private void rememberUncertainty(int phone) {
+        if (state.recoveryPhone() == phone && uncertainOrigin == null)
+            uncertainOrigin = endpoints[phone];
+    }
+    private void recoverIfDead(int phone) {
+        if (state.recoveryPhone() == phone && uncertainOrigin != null
+                && !uncertainOrigin.isBinderAlive() && endpoints[phone] != uncertainOrigin
+                && transports[phone] != null && transports[phone].healthy()) {
+            state.recovered(phone, generations[phone]);
+            if (state.recoveryPhone() < 0) uncertainOrigin = null;
+        }
+    }
+    private void connect(int phone) {
+        if (connecting[phone] || retryBlocked[phone]) return;
+        connecting[phone] = true;
+        long generation = ++generations[phone];
+        IBinder rejectedEndpoint = rejected[phone];
+
+        connections.post(() -> {
+            IBinder modem = ServiceManager.checkService(
+                    MtkAssistTransport.MODEM + "/slot" + (phone + 1));
+            IBinder data = ServiceManager.checkService(
+                    MtkAssistTransport.DATA + "/slot" + (phone + 1));
+            if (modem == null || !modem.isBinderAlive() || modem == rejectedEndpoint
+                    || data == null || !data.isBinderAlive()) {
+                handler.post(() -> {
+                    if (generation == generations[phone]) connecting[phone] = false;
+                });
+                return;
+            }
+            MtkAssistTransport transport = null;
+            boolean incompatible = false;
+            try {
+                transport = new MtkAssistTransport(modem, data, phone, generation, handler, this);
+                transport.register();
+            } catch (android.os.RemoteException | RuntimeException unavailable) {
+                incompatible = unavailable instanceof MtkAssistTransport.IncompatibleServiceException
+                        || (transport != null && transport.incompatible());
+                if (transport != null) transport.close();
+                transport = null;
+            }
+            MtkAssistTransport result = transport;
+            boolean incompatibleService = incompatible;
+            handler.post(() -> {
+                if (generation != generations[phone]) {
+                    if (result != null) result.close();
+                    return;
+                }
+                connecting[phone] = false;
+                if ((announced[phone] != null && announced[phone] != modem)
+                        || ServiceManager.checkService(MtkAssistTransport.DATA + "/slot" + (phone + 1)) != data
+                        || !data.isBinderAlive()) {
+                    if (result != null) result.close();
+                    changed.run();
+                    return;
+                }
+                endpoints[phone] = modem;
+                if (result == null || !result.healthy()) {
+                    retryBlocked[phone] = true;
+                    if (incompatibleService || (result != null && result.incompatible()))
+                        rejected[phone] = modem;
+                    if (result != null) result.close();
+                    Log.w(TAG, "Assist modem unavailable for slot " + phone);
+                    return;
+                }
+                transports[phone] = result;
+                acknowledgements[phone] = data;
+                state.binding(phone, generation);
+                recoverIfDead(phone);
+                changed.run();
+            });
+        });
+    }
+    @Override public void response(int phone, long generation, MtkAssistSyncState.Kind method,
+            int serial, int type, int error) {
+        if (method == MtkAssistSyncState.Kind.VOIP
+                && state.response(phone, generation, serial, type, error,
+                        MtkAssistProfile.current(observedProfiles,PhoneFactory.getPhones(),observedProfiles.length)
+                                && phone >= 0 && phone < observedProfiles.length
+                                && HonorSubscriberAdoption.isReady(phone, observedProfiles[phone]))) {
+            Log.d(TAG, "Acknowledged audio notification slot " + phone + " error=" + error);
+            changed.run();
+        }
+    }
+    @Override public void unavailable(int phone, long generation) {
+        if (generation != generations[phone]) return;
+        retryBlocked[phone] = true;
+        if (transports[phone] != null) {
+            if (transports[phone].incompatible()) rejected[phone] = endpoints[phone];
+            transports[phone].close();
+        }
+        transports[phone] = null;
+        state.binding(phone, 0);
+        rememberUncertainty(phone);
+        changed.run();
+    }
+}
