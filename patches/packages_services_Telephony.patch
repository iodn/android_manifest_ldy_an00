+++ b/tests/host/com/android/internal/telephony/honor/MtkAssistSyncStateTest.java
@@ -0,0 +1,119 @@
+package com.android.internal.telephony.honor;
+
+import java.util.Arrays;
+
+public final class MtkAssistSyncStateTest {
+    private static int checks;
+    private static void check(boolean value, String message) {
+        checks++;
+        if (!value) throw new AssertionError(message);
+    }
+    private static MtkAssistSyncState fresh() {
+        MtkAssistSyncState state = new MtkAssistSyncState();
+        state.topology(new int[]{10, 20}, new Object[]{"physical", "euicc"});
+        state.binding(0, 1);
+        state.binding(1, 2);
+        return state;
+    }
+    private static void ack(MtkAssistSyncState state, MtkAssistSyncState.Notification request,
+            int serial, int error) {
+        check(state.begin(request, serial), "Begin correlated request");
+        MtkAssistSyncState.Kind method = request.kind() == MtkAssistSyncState.Kind.DEFAULT_DATA
+                ? MtkAssistSyncState.Kind.DATA : request.kind();
+        check(state.response(request.slot(), request.binding(), method, serial, 0, error),
+                "Matching final response");
+    }
+    public static void main(String[] args) {
+        MtkAssistSyncState state = fresh();
+        state.data(0, false, true);
+        state.defaultData(1);
+        state.screen(0, true);
+        check(Arrays.equals(state.next(0, true).values(), new int[]{0,1,-2,-2,-2}),
+                "Respect user-disabled data and typed roaming");
+        int serial = 1;
+        for (MtkAssistSyncState.Kind kind : new MtkAssistSyncState.Kind[]{MtkAssistSyncState.Kind.DATA,
+                MtkAssistSyncState.Kind.DEFAULT_DATA, MtkAssistSyncState.Kind.SCREEN}) {
+            MtkAssistSyncState.Notification request = state.next(0, true);
+            check(request != null && request.kind() == kind, "Initial queue order");
+            ack(state, request, serial++, 0);
+        }
+        check(state.next(0, true) == null, "DATA and DEFAULT_DATA share callback without resend loop");
+        state.data(0, false, true);
+        state.defaultData(1);
+        state.screen(0, true);
+        check(state.next(0, true) == null, "Duplicate snapshots coalesce");
+
+        state = fresh();
+        state.screen(0, false);
+        check(state.next(0, false) == null, "LPA or primary-route fence defers dispatch");
+        MtkAssistSyncState.Notification request = state.next(0, true);
+        check(state.begin(request, 50), "Screen pending");
+        check(state.next(0, true) == null, "One pending request per slot");
+        check(!state.response(0, 1, request.kind(), 50, 1, 0), "ACK1 is not final");
+        check(state.next(0, true) == null, "ACK1 retains pending");
+        check(!state.response(0, 1, MtkAssistSyncState.Kind.DATA, 50, 0, 0),
+                "Wrong response method cannot acknowledge");
+        check(!state.response(0, 1, request.kind(), 51, 0, 0), "Wrong serial ignored");
+        check(!state.response(0, 2, request.kind(), 50, 0, 0), "Wrong binding ignored");
+        check(!state.response(0, 1, request.kind(), 50, 3, 0), "Unknown response type ignored");
+        state.screen(0, true);
+        check(state.response(0, 1, request.kind(), 50, 2, 0), "Final ACK_EXP accepted");
+        check(Arrays.equals(state.next(0, true).values(), new int[]{1}), "Send latest after old ACK");
+
+        state = fresh();
+        state.data(0, true, false);
+        request = state.next(0, true);
+        ack(state, request, 60, 6);
+        check(state.next(0, true) == null, "Native error does not spin retries");
+        state.data(0, false, false);
+        check(state.next(0, true) != null, "Real preference change may retry");
+
+        state = fresh();
+        state.defaultData(1);
+        request = state.next(0, true);
+        ack(state, request, 70, 1);
+        check(state.next(0, true) == null, "DDS error blocks DDS key, not DATA key");
+        state.data(0, true, true);
+        check(state.next(0, true).kind() == MtkAssistSyncState.Kind.DATA,
+                "DDS error cannot poison data notification");
+        state.clearDefaultData();
+        ack(state, state.next(0, true), 71, 0);
+        check(state.next(0, true) == null, "Invalid DDS removes obsolete desired notification");
+
+        state = fresh();
+        state.screen(1, true);
+        request = state.next(1, true);
+        check(state.begin(request, 80), "Slot1 pending");
+        check(!state.timeout(1, 1, 80), "Wrong binding deadline ignored");
+        check(state.timeout(1, 2, 80), "Matching deadline retires request");
+        check(!state.response(1, 2, request.kind(), 80, 0, 0), "Late ACK after timeout ignored");
+        check(state.next(1, true) == null, "Timeout does not become acknowledged or retry loop");
+        state.radioAvailable(1);
+        check(state.next(1, true) != null, "Radio reconnect resends latest");
+
+        state = fresh();
+        state.screen(1, true);
+        request = state.next(1, true);
+        check(state.begin(request, 90), "Old subscription request pending");
+        state.topology(new int[]{10, 30}, new Object[]{"physical", "new-profile"});
+        check(!state.response(1, 2, request.kind(), 90, 0, 0), "Old SIM callback ignored");
+        state.data(1, false, false);
+        check(Arrays.equals(state.next(1, true).values(), new int[]{0,0,-2,-2,-2}),
+                "New SIM gets fresh preference values");
+        request = state.next(1, true);
+        state.binding(1, 3);
+        check(!state.begin(request, 91), "Old binding snapshot cannot dispatch");
+        request = state.next(1, true);
+        ack(state, request, 92, 0);
+        check(state.next(1, true) == null, "New binding acknowledged");
+        state.binding(1, 0);
+        check(state.next(1, true) == null, "No dispatch without registered transport");
+        state.binding(1, 4);
+        check(state.next(1, true) != null, "Binder reconnect resends latest state");
+        state.invalidate();
+        check(state.next(1, true) != null, "Settled eSIM route forces fresh notification");
+        state.topology(new int[]{10}, new Object[]{"physical"});
+        check(state.next(1, true) == null, "Inactive slot never dispatches");
+        System.out.println("MtkAssistSyncState: " + checks + " checks PASS");
+    }
+}
