+  SystemProperties.enabled=true;android.os.Process.uid=1001;PackageManager.signature=0;PackageManager.selectedUid=10055;
+ }
+ static void install(HonorSepTrialOwner owner)throws Exception {
+  try {
+   MethodHandles.privateLookupIn(HonorSepTrialOwner.class,MethodHandles.lookup())
+       .findVirtual(HonorSepTrialOwner.class,"installConnectorPreparationHook",MethodType.methodType(void.class))
+       .invoke(owner);
