+package com.honor.ldy_an00.lease;
+import com.honor.ldy_an00.lease.HonorLpaLease;
+import com.honor.ldy_an00.lease.HonorLpaLeaseGrant;
+import com.honor.ldy_an00.lease.HonorLpaChannelResult;
+interface IHonorLpaLease {
+    HonorLpaLeaseGrant acquire(int operation, int physicalSlot, int port, int cardId, IBinder client);
+    boolean check(in HonorLpaLease lease, IBinder client);
+    HonorLpaChannelResult openChannel(in HonorLpaLease lease, IBinder client, String aid, int p2);
+    HonorLpaChannelResult transmitChannel(in HonorLpaLease lease, IBinder client, long handle, in byte[] command);
+    HonorLpaChannelResult closeChannel(in HonorLpaLease lease, IBinder client, long handle);
+    boolean beginNative(in HonorLpaLease lease, IBinder client, int nativeKind, boolean lastProfileBefore);
+    boolean nativeReturned(in HonorLpaLease lease, IBinder client, boolean positive);
+    int reconcileResetStep(in HonorLpaLease lease, IBinder client, boolean channelsPositivelyClosed, boolean allowKnownBlank);
+    boolean finish(in HonorLpaLease lease, IBinder client, boolean nativeCompletedReconciledAndChannelsClosed);
+    // Protocol version is checked before operations; original transaction IDs stay fixed.
+    // Version 2 was required before any lease/native command; original transaction IDs stay fixed.
+    int protocolVersion();
+    HonorLpaLeaseGrant acquireV2(int operation, int physicalSlot, int port, int cardId, IBinder client);
+    boolean beginNativeTarget(in HonorLpaLease lease, IBinder client, int nativeKind,
+            boolean lastProfileBefore, String expectedIccid);
+    int prepareResetReclamation(in HonorLpaLease lease, IBinder client);
+    const int PREPARE_NOT_NEEDED = 0;
+    const int PREPARE_READY = 1;
+    const int PREPARE_NOT_READY = 2;
+    const int PREPARE_REFUSED = 3;
+    // Version 3: read-only, process-live historical identity only. Never returns a lease or card ID.
+    int prepareKnownBlankEndpoint(int physicalSlot, int port, int expectedCardId, IBinder client);
+    // Version 5: parsed, operation-specific card rejection; no reset or channel-drain proof.
+    boolean nativeRejected(in HonorLpaLease lease, IBinder client, int kind, int code);
+    // Protocol 6: explicit nondestructive recovery after a marked kernel restart.
+    const int RECOVERY_REFUSED = 0;
+    const int RECOVERY_NEED_RESTART = 1;
+    const int RECOVERY_READY = 2;
+    const int RECOVERY_IN_PROGRESS = 3;
+    const int RECOVERY_DONE = 4;
+    const int RECOVERY_REQUIRED = 5;
+    int armRecovery(String appJournalHash, IBinder client);
+    HonorLpaLeaseGrant acquireRecovery(String appJournalHash, IBinder client);
+    boolean finishRecovery(in HonorLpaLease lease, IBinder client, boolean completedAndDrained);
+    int recoveryStatus(String appJournalHash);
+}
