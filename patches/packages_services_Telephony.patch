index 0000000000000000000000000000000000000000..b0cd50ff6110dea9b2495c571d811aa3602e6aef
--- /dev/null
+++ b/tests/host/com/android/internal/telephony/honor/LpaRecoveryReadHostTest.java
@@ -0,0 +1,89 @@
+/* Copyright (C) 2026 The LineageOS Project. SPDX-License-Identifier: Apache-2.0 */
+package com.android.internal.telephony.honor;
+
+import java.util.Arrays;
+import java.util.HexFormat;
+
+/** Exercises the actual fixed recovery transcript, with synthetic card identifiers. */
+public final class LpaRecoveryReadHostTest {
+    private static final String EID="12345678901234567890123456789012";
+    private static final byte[] EID_REQUEST=hex("83E2910006BF3E035C015A");
+    private static final byte[] PROFILES_REQUEST=hex("83E2910003BF2D00");
+    private static final byte[] EID_BODY=hex("BF3E125A10"+EID);
+    private static final byte[] EMPTY_PROFILES=hex("BF2D02A000");
+    private static int checks;
+
+    private static byte[] hex(String value) {return HexFormat.of().parseHex(value);}
+    private static void check(boolean value) {
+        checks++;
+        if(!value) throw new AssertionError("check "+checks);
+    }
+    private static void rejects(Runnable action) {
+        try {action.run();}
+        catch(IllegalArgumentException|IllegalStateException expected) {checks++;return;}
+        throw new AssertionError("invalid recovery transcript accepted");
+    }
+    private static byte[] result(int status,byte[] body) {
+        byte[] reply=Arrays.copyOf(body,body.length+2);
+        reply[body.length]=(byte)(status>>>8);reply[body.length+1]=(byte)status;
+        return reply;
+    }
+    private static LpaRecoveryRead readEid() {
+        var read=new LpaRecoveryRead(EID);
+        read.request(EID_REQUEST,3);
+        return read;
+    }
+    public static void main(String[] args) {
+        for(int status:new int[]{0x9000,0x9100,0x91ff,0x9200,0x92ff}) {
+            var read=readEid();
+            read.response(result(status,EID_BODY));
+            check(!read.complete());
+            read.request(PROFILES_REQUEST,3);
+            read.response(result(status,EMPTY_PROFILES));
+            check(read.complete());
+            rejects(()->read.response(result(status,EMPTY_PROFILES)));
+
+            var chained=readEid();
+            chained.response(result(0x6100,Arrays.copyOf(EID_BODY,5)));
+            rejects(()->chained.request(hex("83C0000001"),3));
+            chained.request(hex("83C0000000"),3);
+            chained.response(result(0x61ff,Arrays.copyOfRange(EID_BODY,5,8)));
+            chained.request(hex("83C00000FF"),3);
+            chained.response(result(status,Arrays.copyOfRange(EID_BODY,8,EID_BODY.length)));
+            chained.request(PROFILES_REQUEST,3);
+            chained.response(result(status,EMPTY_PROFILES));
+            check(chained.complete());
+        }
+
+        for(int status:new int[]{0x9001,0x6f00,0x6881,0x6a82,0x6985}) {
+            var read=readEid();
+            rejects(()->read.response(result(status,EID_BODY)));
+            check(!read.complete());
+        }
+        for(int status:new int[]{0x9100,0x9200}) {
+            for(byte[] invalid:new byte[][]{new byte[0],hex("BF3E025A00"),
+                    hex("BF3E125A1022345678901234567890123456789012"),
+                    hex("BF3E125A10"+EID+"00")}) {
+                var read=readEid();
+                rejects(()->read.response(result(status,invalid)));
+                check(!read.complete());
+            }
+            for(byte[] invalid:new byte[][]{hex("BF2D03810101"),hex("BF2D03A001"),
+                    hex("BF2D02A00000")}) {
+                var read=readEid();
+                read.response(result(status,EID_BODY));
+                read.request(PROFILES_REQUEST,3);
+                rejects(()->read.response(result(status,invalid)));
+                check(!read.complete());
+            }
+        }
+
+        var unsolicited=new LpaRecoveryRead(EID);
+        rejects(()->unsolicited.response(result(0x9200,EID_BODY)));
+        rejects(()->unsolicited.request(hex("83C0000000"),3));
+        rejects(()->readEid().response(null));
+        rejects(()->readEid().response(new byte[]{(byte)0x91}));
+        rejects(()->readEid().response(result(0x9200,new byte[65536])));
+        System.out.println("PASS "+checks+" actual fixed recovery transcript checks");
+    }
+}
