+"""Execute the actual permission/pre-dispatch method bodies with controlled Android boundaries."""
+import argparse
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[2]
+parser = argparse.ArgumentParser()
+parser.add_argument("--framework-source", type=Path, required=True)
+args = parser.parse_args()
+source = (ROOT / "src/com/android/phone/PhoneInterfaceManager.java").read_text()
+methods = []
+for signature in ["    public boolean enableDataConnectivity(", "    public boolean disableDataConnectivity(",
+                  "    public void setDataEnabledForReason("]:
+    start = source.index(signature)
+    opening = source.index("{", start)
+    depth, ending = 1, opening + 1
+    while depth:
+        if source[ending] == "{": depth += 1
+        elif source[ending] == "}": depth -= 1
+        ending += 1
+    methods.append(source[start:ending])
+assert source.count("SubscriptionManagerService.getInstance().noteExplicitUserDataRequest();") == 3
+sources = list((ROOT / "tests/host/managed-data-fixtures").rglob("*.java"))
+sources += [args.framework_source,
