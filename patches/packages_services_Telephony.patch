+/* Copyright (C) 2026 The LineageOS Project. SPDX-License-Identifier: Apache-2.0 */
+package com.android.internal.telephony.honor;
+
+import java.io.IOException;
+
+/** One Phone-owned operation. Death, expiry and restart never imply native work drained. */
+final class LpaOperationLease {
+    private Runnable mutationObserver=()->{};
+    private Runnable readinessObserver=()->{};
+    /** Observer only enqueues work; it must not enter Binder, slot locks or review under this monitor. */
+    synchronized void setReadinessObserver(Runnable observer) {
+        if(observer==null)throw new IllegalArgumentException("Missing readiness observer");
+        readinessObserver=observer;
+    }
+    private java.util.function.BooleanSupplier callPolicyQuiescent=()->true;
+    synchronized void setCallPolicyGate(java.util.function.BooleanSupplier gate) {
+        if(gate==null)throw new IllegalArgumentException("Missing call policy gate");
+        callPolicyQuiescent=gate;
+    }
+    private void requireCallPolicySettled() {
+        if(!callPolicyQuiescent.getAsBoolean())
+            throw new IllegalStateException("Call policy completion unknown");
+    }
+    // Separate from the comm101 gate. Suppliers are lock-free; demands only enqueue work.
+    enum ImsPolicyOwner { HNCALL_REGIONAL, IMS_DC }
+    private record ImsPolicyGate(Object custody,java.util.function.BooleanSupplier routeSettled,
+            java.util.function.BooleanSupplier dispatchSafe,Runnable releaseDemand) {}
+    private final java.util.EnumMap<ImsPolicyOwner,ImsPolicyGate> imsPolicyGates=
+            new java.util.EnumMap<>(ImsPolicyOwner.class);
+    private Object imsPolicyMutation;
+    synchronized void setImsPolicyGate(ImsPolicyOwner owner,Object custody,
+            java.util.function.BooleanSupplier routeSettled,
+            java.util.function.BooleanSupplier dispatchSafe,Runnable releaseDemand) {
+        if(owner==null || custody==null || routeSettled==null || dispatchSafe==null || releaseDemand==null)
+            throw new IllegalArgumentException("Missing IMS policy gate");
+        ImsPolicyGate existing=imsPolicyGates.get(owner);
+        if(existing!=null) {
+            if(existing.custody()!=custody)throw new IllegalStateException("IMS policy custody replaced");
+            return; // Same custody publishes changing facts through its existing volatile suppliers.
+        }
+        imsPolicyGates.put(owner,new ImsPolicyGate(custody,routeSettled,dispatchSafe,releaseDemand));
+    }
+    private boolean imsPoliciesSettled() {
+        if(imsPolicyMutation!=null)return false;
+        for(ImsPolicyGate gate:imsPolicyGates.values())
+            if(!gate.routeSettled().getAsBoolean())return false;
+        return true;
+    }
+    /** Known completed policy votes need release; never represents a pending/UNKNOWN write. */
+    static final class PolicyReleasePending extends IllegalStateException {
+        private PolicyReleasePending(){super("Accepted IMS policy vote requires baseline release");}
+    }
+    private void requireImsPolicySettled(boolean requestRelease) {
