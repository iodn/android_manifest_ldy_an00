+            out.clear();s=new HonorCallQosSnapshot(0,4,5,out::add);
+            s.accept(call(1,12,1001),0,1,10000);s.accept(invite("cause"),1,2,10001);
+            s.accept(end(1,reason),10,3,10010);s.expire(1010);
+            boolean abnormal=reason==-2||reason==99;
+            check(out.get(0).endType()==(abnormal?HonorCompletedCallQoe.EndType.ERROR:
+                    HonorCompletedCallQoe.EndType.NORMAL));
+        }
+        out.clear();s=new HonorCallQosSnapshot(0,4,5,out::add);
+        s.accept(call(1,12,1001),0,1,10000);s.accept(invite("raw-sip"),1,2,10001);
+        s.accept(sip(1,488,"raw-sip","SIP/2.0 488"),2,3,10002);
+        s.accept(end(1,1000),3,4,10003);
+        check(out.get(0).function()==HonorCompletedCallQoe.Function.DC_ERROR);
+
+        byte[] cause=endBytes(1,0,34,0,0);
+        var parsed=HonorMtkCallEndDecoder.decode(0,1,1001,cause);
+        check(parsed.known()&&parsed.cause()==100034);
+        check(HonorMtkCallEndDecoder.decode(0,1,105,cause)==null); // Inner event, not outer ID.
+        check(HonorMtkCallEndDecoder.decode(0,1,1,endBytes(1,65535,0,7,9)).cause()==200007);
+        check(HonorMtkCallEndDecoder.decode(0,1,1,endBytes(1,503,1,2,3)).cause()==503);
+        check(!HonorMtkCallEndDecoder.decode(0,1,1,endBytes(1,0,Integer.MAX_VALUE,0,0)).known());
+        check(!HonorMtkCallEndDecoder.decode(0,1,1,java.util.Arrays.copyOf(cause,20)).known());
+        check(!HonorMtkCallEndDecoder.decode(0,1,1,endBytes(2,0,0,0,0)).known());
+        out.clear();s=new HonorCallQosSnapshot(0,4,5,out::add);
+        s.accept(call(1,12,1001),0,1,10000);s.accept(invite("supplement"),1,2,10001);
+        s.accept(end(1,0),10,3,10010);s.accept(parsed,4);s.expire(1010);
+        check(out.get(0).endType()==HonorCompletedCallQoe.EndType.ERROR);
+        check(out.get(0).function()!=HonorCompletedCallQoe.Function.DC_NORMAL);
+        // Two terminal source incarnations make unaddressed105 ambiguous, including reused ID.
+        out.clear();s=new HonorCallQosSnapshot(0,4,5,out::add);
+        s.accept(call(1,12,1001),0,1,10000);s.accept(invite("amb-old"),1,2,10001);
+        s.accept(end(1,0),10,3,10010);
+        s.accept(call(1,12,1001),11,4,10011);s.accept(invite("amb-new"),12,5,10012);
+        s.accept(end(1,0),13,6,10013);s.accept(parsed,7);s.expire(1013);
+        check(out.size()==2);
+        check(out.stream().allMatch(r->r.endType()==HonorCompletedCallQoe.EndType.UNKNOWN));
+        check(out.stream().noneMatch(r->r.function()==HonorCompletedCallQoe.Function.DC_NORMAL));
+
+        // Ambiguous SIP itself must not become a false NORMAL reset when native causes are0.
+        out.clear();s=new HonorCallQosSnapshot(0,4,5,out::add);
+        s.accept(call(1,12,1001),0,1,10000);s.accept(invite("reused-sip"),1,2,10001);
+        s.accept(end(1,0),10,3,10010);
+        s.accept(call(1,12,1001),11,4,10011);s.accept(invite("reused-sip"),12,5,10012);
+        s.accept(sip(1,488,"reused-sip","SIP/2.0 488"),13,6,10013);
+        s.accept(end(1,0),14,7,10014);s.expire(1014);
+        check(out.size()==2);
+        check(out.stream().allMatch(r->r.endType()==HonorCompletedCallQoe.EndType.UNKNOWN));
+        check(out.stream().noneMatch(r->r.function()==HonorCompletedCallQoe.Function.DC_NORMAL));
+
+        // Derived handoff is queued after this event's domain/status update, and applies
+        // to the then-current shared table (stock Handler2000), not to a second matcher.
+        out.clear();s=new HonorCallQosSnapshot(0,4,5,out::add);
+        s.accept(call(1,14,1001),0,1,10000);s.accept(invite("switch-one"),1,2,10001);
+        s.accept(call(2,12,1001),2,3,10002);s.accept(invite("switch-two"),3,4,10003);
+        s.accept(call(1,12,1003),4,5,10004);
+        var handoffs=s.takeHandoffs();
+        check(handoffs.size()==1&&handoffs.get(0)==HonorCompletedCallQoe.Domain.N2L);
+        s.applyHandoff(handoffs.get(0));
+        s.accept(sip(1,488,"switch-one","SIP/2.0 488"),5,6,10005);
+        s.accept(end(1,0),6,7,10006);
+        check(out.get(0).domain()==HonorCompletedCallQoe.Domain.N2L);
+        check(out.get(0).function()==HonorCompletedCallQoe.Function.NONE);
+        s.accept(end(2,0),7,8,10007);s.expire(1007);
+        check(out.get(1).domain()==HonorCompletedCallQoe.Domain.EPSFB);
+        System.out.println("PASS "+checks+" actual shared completed-call runtime checks");
+    }
+}
diff --git a/tests/host/HonorImsDcControllerHostTest.java b/tests/host/HonorImsDcControllerHostTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..bd8cf3b99f304ed8c3736b7e121a332a4165d8c9
--- /dev/null
+++ b/tests/host/HonorImsDcControllerHostTest.java
@@ -0,0 +1,153 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.internal.telephony.honor;
+import android.os.Handler;
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.nio.charset.StandardCharsets;
+import java.util.*;
+import java.util.function.Consumer;
+
+/** The real shared matcher feeds the real runtime coordinator and tokenized Handler deadlines. */
+public final class HonorImsDcControllerHostTest {
+    static int checks;
+    static long sequence, wall=10000;
+    static void check(boolean v) { checks++; if(!v)throw new AssertionError("check "+checks); }
+    static class Inputs implements HonorImsDcController.InputsProvider {
+        Boolean city=true,user=true,carrier=true; Integer mode=1,count=0;
+        boolean ready=true; String provenance="stock113:pinned-test-config"; Runnable changed;
+        public HonorImsDcController.Inputs read(int slot,long profile) {
+            return new HonorImsDcController.Inputs(true,carrier,user,city,mode,count,ready,provenance);
+        }
+        public void addListener(Handler h,Runnable r) { changed=()->h.post(r); }
+        void notifyChanged(){changed.run();Handler.drain();}
+    }
+    static class Backend implements HonorImsDcController.Backend {
+        List<HonorImsDcController.Request> sent=new ArrayList<>();
+        List<Consumer<HonorImsDcController.Submission>> replies=new ArrayList<>();
+        public void submit(HonorImsDcController.Request r,
+                Consumer<HonorImsDcController.Submission> reply){sent.add(r);replies.add(reply);}
+        void reply(HonorImsDcController.Submission s){replies.get(replies.size()-1).accept(s);Handler.drain();}
+    }
+    static HonorMtkCallInfoDecoder.CallUpdate nativeCall(int status,int end) {
+        ByteBuffer b=ByteBuffer.allocate(36).order(ByteOrder.LITTLE_ENDIAN);
+        for(int n:new int[]{101,1,2,0,12,status,0,end,1})b.putInt(n);
+        return HonorMtkCallInfoDecoder.decode(0,1,1,b.array());
+    }
+    static HonorCompletedSipDecoder.Update sip(int code,boolean dc,String id) {
+        String text=code==0?"INVITE\r\nTo: remote\r\n\r\nv=0\r\nm=application "
+                +(dc?9:0)+" UDP/DTLS/SCTP data":"SIP/2.0 "+code+"\r\nTo: remote;tag=x";
+        byte[] a=id.getBytes(StandardCharsets.US_ASCII),c=text.getBytes(StandardCharsets.US_ASCII);
+        ByteBuffer b=ByteBuffer.allocate(28+a.length+c.length).order(ByteOrder.LITTLE_ENDIAN);
+        for(int n:new int[]{100,1,1,code==0?0:1,code,a.length,c.length})b.putInt(n);
+        return HonorCompletedSipDecoder.decode(0,1,1,b.put(a).put(c).array());
+    }
+    static void complete(HonorCallQosSnapshot source,boolean dc,int code) {
+        String id="call-"+sequence;
+        source.accept(nativeCall(1001,0),Handler.now,++sequence,++wall);
+        source.accept(sip(0,dc,id),Handler.now,++sequence,++wall);
+        if(code!=0)source.accept(sip(code,dc,id),Handler.now,++sequence,++wall);
+        source.accept(nativeCall(1010,code==0?0:34),Handler.now,++sequence,++wall);
+        source.expire(Handler.now+1000);
+    }
+    public static void main(String[] args) {
+        Handler.reset(); Inputs inputs=new Inputs();Backend backend=new Backend();
+        var policy=new HonorImsDcController(new Handler(),()->Handler.now,inputs,backend);
+        policy.qualify(0,5,4,true,true);
+        var source=new HonorCallQosSnapshot(0,4,5,policy::completed);
+        check(backend.sent.isEmpty());
+        complete(source,true,488);check(backend.sent.isEmpty());
+        policy.qualify(0,5,4,true,false);
+        complete(source,true,488);check(backend.sent.isEmpty()); // All calls idle is mandatory.
+        policy.qualify(0,5,4,true,true);
+        check(backend.sent.size()==1&&backend.sent.get(0).normalizedMode()==0);
+        backend.reply(HonorImsDcController.Submission.SUBMITTED);
+        inputs.mode=0;inputs.notifyChanged();
+        complete(source,false,0); // Evaluation white latches, does not restore early.
+        check(backend.sent.size()==1);
+        Handler.advance(HonorImsDcRecoveryPolicy.SHORT_MS-1);
+        check(backend.sent.size()==1);
+        Handler.advance(1);
+        check(backend.sent.size()==2&&backend.sent.get(1).normalizedMode()==1);
+        backend.reply(HonorImsDcController.Submission.REFUSED);
+        inputs.notifyChanged();policy.qualify(0,5,4,true,true);
+        check(backend.sent.size()==2); // Completion/readiness is not an infinite refusal retry.
+        inputs.user=false;inputs.notifyChanged();inputs.user=true;inputs.notifyChanged();
+        check(backend.sent.size()==3);
+        check(backend.sent.get(2).token()>backend.sent.get(1).token());
+
+        // Immediate black ends only its current evaluation, restores logical eligibility,
+        // and protects against new failure controls for 24h; unknown counter is never zero.
+        Handler.reset();inputs=new Inputs();backend=new Backend();
+        policy=new HonorImsDcController(new Handler(),()->Handler.now,inputs,backend);
+        policy.qualify(0,6,4,true,true);
+        source=new HonorCallQosSnapshot(0,4,6,policy::completed);
+        complete(source,true,503);complete(source,true,503);
+        check(backend.sent.size()==1);
+        backend.reply(HonorImsDcController.Submission.SUBMITTED);
+        inputs.mode=0;inputs.notifyChanged();
+        complete(source,false,503);
+        check(backend.sent.size()==2&&backend.sent.get(1).normalizedMode()==1);
+        backend.reply(HonorImsDcController.Submission.SUBMITTED);
+        inputs.mode=1;inputs.notifyChanged();
+        complete(source,true,503);complete(source,true,503);
+        check(backend.sent.size()==2);
+        Handler.advance(HonorImsDcRecoveryPolicy.FAILED_CURE_PROTECTION_MS);
+        complete(source,true,503);
+        check(backend.sent.size()==3&&backend.sent.get(2).normalizedMode()==0);
+
+        Handler.reset();inputs=new Inputs();inputs.count=null;backend=new Backend();
+        policy=new HonorImsDcController(new Handler(),()->Handler.now,inputs,backend);
+        policy.qualify(0,7,4,true,true);
+        source=new HonorCallQosSnapshot(0,4,7,policy::completed);
+        complete(source,true,488);complete(source,true,488);
+        check(backend.sent.isEmpty());
+        inputs.count=0;inputs.notifyChanged();
+        check(backend.sent.isEmpty()); // No synthetic new failure from input change.
+        complete(source,true,488);
+        check(backend.sent.size()==1);
+        backend.reply(HonorImsDcController.Submission.UNKNOWN);
+        inputs.mode=0;inputs.notifyChanged();
+        Handler.advance(HonorImsDcRecoveryPolicy.LONG_MS);
+        policy.qualify(0,7,4,true,true);inputs.notifyChanged();
+        check(backend.sent.size()==1); // No ordinary-event waiver of uncertain ordering.
+
+        // Same profile transient admission busy preserves latest intent and current timers.
+        Handler.reset();inputs=new Inputs();inputs.ready=false;backend=new Backend();
+        policy=new HonorImsDcController(new Handler(),()->Handler.now,inputs,backend);
+        policy.qualify(0,8,4,true,true);
+        source=new HonorCallQosSnapshot(0,4,8,policy::completed);
+        complete(source,true,488);complete(source,true,488);
+        check(backend.sent.isEmpty());
+        inputs.ready=true;inputs.notifyChanged();
+        check(backend.sent.size()==1);
+        backend.reply(HonorImsDcController.Submission.DEFERRED);
+        check(backend.sent.size()==1);
+        inputs.notifyChanged();check(backend.sent.size()==2);
+        backend.reply(HonorImsDcController.Submission.SUBMITTED);
+        policy.retire(0);
+        Handler.advance(HonorImsDcRecoveryPolicy.LONG_MS);
+        check(backend.sent.size()==2); // No timer/native restore after profile retirement.
+        policy.qualify(0,9,5,true,true);
+        source=new HonorCallQosSnapshot(0,4,8,policy::completed);
+        complete(source,true,488);complete(source,true,488);
+        check(backend.sent.size()==2); // Wrong profile/binding cannot seed successor.
+        Handler.reset();inputs=new Inputs();backend=new Backend();
+        policy=new HonorImsDcController(new Handler(),()->Handler.now,inputs,backend);
+        policy.qualify(0,10,4,true,true);
+        source=new HonorCallQosSnapshot(0,4,10,policy::completed);
+        complete(source,true,488);complete(source,true,488);
+        check(backend.sent.size()==1);
+        complete(source,true,0); // New desired normal state while OFF is awaiting backend receipt.
+        inputs.mode=0;inputs.notifyChanged();
+        check(backend.sent.size()==1);
+        backend.reply(HonorImsDcController.Submission.SUBMITTED);
+        check(backend.sent.size()==2&&backend.sent.get(1).normalizedMode()==1);
+        backend.reply(HonorImsDcController.Submission.SUBMITTED);
+        inputs.mode=1;inputs.notifyChanged();inputs.notifyChanged();
+        check(backend.sent.size()==2); // Stable configured convergence cannot loop.
+        System.out.println("PASS "+checks+" actual shared-producer/DC-runtime checks");
+    }
+}
diff --git a/tests/host/HonorImsDcPolicyTest.java b/tests/host/HonorImsDcPolicyTest.java
