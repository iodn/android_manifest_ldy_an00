+    /** Diagnostic observation only; never authorizes a setter, profile operation or LPA handoff. */
+    public record Snapshot(long generation,int serial,Phase phase,int mode) {}
+    private static final class PreparationRefused extends IllegalStateException {
+        final String reason;
