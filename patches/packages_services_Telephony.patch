index 0000000000000000000000000000000000000000..cdb3a8e9d7bdda0358026a82980a8275edffc24a
--- /dev/null
+++ b/src/com/android/internal/telephony/honor/HonorSepTrialAdapter.java
@@ -0,0 +1,332 @@
+/* Copyright (C) 2026 The LineageOS Project. SPDX-License-Identifier: Apache-2.0 */
+package com.android.internal.telephony.honor;
+
+import android.os.AsyncResult;
+import android.os.Build;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.Message;
+import android.os.Process;
+import android.os.RemoteException;
+import android.os.SELinux;
+import android.os.SystemClock;
+import com.android.internal.telephony.Phone;
+import com.android.internal.telephony.uicc.AnswerToReset;
+import com.android.internal.telephony.uicc.IccCardStatus;
+import com.android.internal.telephony.uicc.UiccController;
+import com.android.internal.telephony.uicc.UiccSlot;
+import vendor.honor.hardware.hnradio.IRadio;
+import vendor.honor.hardware.hnradio.MsgPayload;
+
+/** Explicit bounded shared-slot trial. No startup trigger; owner qualification remains required. */
+public final class HonorSepTrialAdapter extends Handler {
+    private static final int BASELINE=1, STATUS=2, DEADLINE=3;
+    private static final int SLOT=1;
+    public interface Owner {
+        default SepMuxAdmission admission() { return SepMuxAdmission.strict(); }
+        default void assertQualifiedExclusiveOwner() {
+            throw new IllegalStateException("Owner wiring/callback ABI not qualified");
+        }
+        void persistPending(long generation,int serial,SepMuxTrial.Selector target)
+                throws java.io.IOException;
+        void persistCompleted(long generation,int serial,SharedSlotRouteTrial outcome)
+                throws java.io.IOException;
+        void persistUnknown(long generation,int serial) throws java.io.IOException;
+        IRadio radio();
+        long generation();
+        int allocateSerial();
+        int allocateRouteSerial() throws java.io.IOException;
+        void queryRoute(int serial,HonorSepTrialAdapter source) throws RemoteException;
+    }
+    public interface ResultSink {
+        void record(SepMuxTrial.State state,String reason);
+        void recordTransportFailure(int error);
+        /** Route completion is not card/EID readiness; the separate controller observer checks it. */
+        default void knownEndpoint(HonorSepTrialAdapter source,long generation,int serial,
+                SepMuxTrial.Selector target) {}
+    }
+    private final Phone phone;
+    private final Owner owner;
+    private final ResultSink sink;
+    private final SharedSlotRouteTrial model=new SharedSlotRouteTrial();
+    private long generation;
+    private int commandSerial;
+    private SepMuxTrial.Selector target;
+    private boolean used,physicalUsed,stopped,commandSent,completionDurable,routeRequested;
+    private SharedSlotRouteTrial.RouteQuery routeToken;
+    private MtkSimTypeQuery freshPhysicalBaseline;
+    private MtkSimTypeQuery physicalBaselineProof;
+    void initialPhysicalBaseline(MtkSimTypeQuery query) {
+        requireThread();
+        if(used || physicalUsed || stopped || query==null
+                || !query.physicalFor(owner.generation()) || !query.current(owner.generation(),now()))
+            throw new IllegalStateException("Invalid current physical baseline");
+        physicalBaselineProof=query;
+    }
+    private record Token(long generation,SharedSlotRouteTrial.CardQuery query) {}
+    public HonorSepTrialAdapter(Looper looper,Phone phone,Owner owner,ResultSink sink) {
+        super(looper);this.phone=phone;this.owner=owner;this.sink=sink;
+    }
+    SharedSlotRouteTrial.State uiRouteState() {
+        if(Looper.myLooper()!=getLooper()) throw new IllegalStateException("Owner thread required");
+        if(stopped || model.phaseComplete() && !completionDurable) return SharedSlotRouteTrial.State.UNKNOWN;
+        // NEW is retained while the real baseline ICC query is pending, before model reservation.
+        if(model.state()==SharedSlotRouteTrial.State.NEW && used && admission!=null && !admission.stopped())
+            return SharedSlotRouteTrial.State.RESERVED;
+        return model.state();
+    }
+    boolean completedPhysicalCycle() {
+        requireThread();
+        return !stopped && completionDurable && model.state()==SharedSlotRouteTrial.State.PHYSICAL_RESTORED
+                && !model.hasPendingQueries() && freshPhysicalBaseline==null;
+    }
+    public boolean canRequestPhysicalReturn() {
+        return !stopped && completionDurable && model.canRequestPhysicalReturn();
+    }
+    private long now() {return SystemClock.elapsedRealtime();}
+    private void requireThread() {
+        if(Looper.myLooper()!=getLooper()) throw new IllegalStateException("Wrong owner thread");
+    }
+    private SepMuxTrial.State displayState() {
+        return switch(model.state()) {
+            case NEW -> SepMuxTrial.State.NEW;
+            case RESERVED,RETURN_BASELINE,WAITING -> SepMuxTrial.State.WAITING;
+            case RECONCILING -> SepMuxTrial.State.RECONCILING;
+            case EUICC_ROUTE_OBSERVED,PHYSICAL_RESTORED -> SepMuxTrial.State.TARGET_OBSERVED;
+            case UNKNOWN -> SepMuxTrial.State.UNKNOWN;
+        };
+    }
+    private SepMuxTrial.Evidence qualify() throws RemoteException {
+        owner.assertQualifiedExclusiveOwner();
+        if(!"userdebug".equals(Build.TYPE) || Process.myUid()!=1001
+                || !"u:r:radio:s0".equals(SELinux.getContext())
+                || phone.getPhoneId()!=SLOT || phone.mCi==null || owner.generation()<=0)
+            throw new IllegalStateException("Wrong development phone identity");
+        IRadio radio=owner.radio();
+        if(radio==null) throw new IllegalStateException("No Honor radio owner");
+        return new SepMuxTrial.Evidence(Process.myUid(),SELinux.getContext(),SELinux.isSELinuxEnforced(),
+                radio.getInterfaceVersion(),radio.getInterfaceHash(),true,true,true,owner.admission());
+    }
+    void adoptEuicc(SepMuxRouteAdoption.Proof proof) throws RemoteException {
+        requireThread();
+        if(used || physicalUsed || stopped) throw new IllegalStateException("Adapter already used");
+        model.adoptEuicc(qualify(),proof);
+        generation=proof.generation;commandSerial=proof.lastSetterSerial;target=SepMuxTrial.Selector.EUICC;
+        used=true;completionDurable=true; // Completed qualified readback phase, never a new modem transaction.
+    }
+    /** Both directions require explicit owner calls; no automatic reversal or retry. */
+    void requestRecovery(LpaRecoveryFence fence) throws RemoteException,java.io.IOException {
+        requireThread();fence.requireRunning();
+        HonorSimRouteCallGuard.requireIdle();
+        if(used || physicalUsed || stopped) throw new IllegalStateException("Recovery already dispatched");
+        used=true;target=SepMuxTrial.Selector.EUICC;generation=owner.generation();
+        admission=new TrialDispatchGate();admission.start(now());
+        commandSerial=owner.allocateSerial();
+        SepMuxTrial.Command command=model.beginRecovery(qualify(),commandSerial,generation,now());
+        dispatch(command);
+    }
+    public void requestOneVisibilityTrial(SepMuxTrial.Selector next) throws RemoteException {
+        requireThread();
+        HonorSimRouteCallGuard.requireIdle();
+        if(next==null || (next==SepMuxTrial.Selector.EUICC && used)
+                || (next==SepMuxTrial.Selector.PHYSICAL && (!canRequestPhysicalReturn() || physicalUsed)))
+            throw new IllegalStateException("No repeated/unqualified trial");
+        if(next==SepMuxTrial.Selector.EUICC) used=true;else physicalUsed=true;
+        target=next;commandSent=false;completionDurable=false;routeRequested=false;routeToken=null;
+        // A new admission gate is needed for the independently authorized physical return.
+        TrialDispatchGate gate=new TrialDispatchGate();gate.start(now());
+        admission=gate;
+        if(!sendEmptyMessageDelayed(DEADLINE,SepMuxTrial.ADMISSION_TIMEOUT_MS))
+            throw new IllegalStateException("Admission watchdog unavailable");
+        try {
+            SepMuxTrial.Evidence evidence=qualify();admission.check(now());
+            generation=owner.generation();
+            if(next==SepMuxTrial.Selector.EUICC) {
+                if(physicalBaselineProof!=null && physicalBaselineProof.current(generation,now())) {
+                    phone.mCi.getIccCardStatus(obtainMessage(BASELINE,new Token(generation,null)));
+                } else {
+                    physicalBaselineProof=null;
+                    int id=owner.allocateRouteSerial();
+                    freshPhysicalBaseline=new MtkSimTypeQuery(generation,id,now()+SepMuxTrial.ADMISSION_TIMEOUT_MS);
+                    owner.queryRoute(id,this);
+                }
+            } else {
+                commandSerial=owner.allocateSerial();
+                routeToken=model.beginPhysicalReturn(evidence,generation,commandSerial,
+                        owner.allocateRouteSerial(),now());
+                scheduleDeadline();owner.queryRoute(routeToken.serial,this);
+            }
+        } catch(RemoteException | java.io.IOException | RuntimeException failure) {stop("Admission failed; no retry");}
+    }
+    private TrialDispatchGate admission;
+    private void stop(String reason) {
+        stopped=true;
+        if(admission!=null) admission.stop();
+        model.transportLost();removeMessages(DEADLINE);
+        if(commandSerial>0) {
+            try {owner.persistUnknown(generation,commandSerial);}
+            catch(java.io.IOException failure) {reason+="; journal unavailable";}
+        }
+        sink.record(SepMuxTrial.State.UNKNOWN,reason+"; no retry");
+    }
+    private void dispatch(SepMuxTrial.Command command) throws RemoteException,java.io.IOException {
+        owner.assertQualifiedExclusiveOwner();
+        if(owner.generation()!=generation) throw new IllegalStateException("Owner changed");
+        admission.check(now());
+        MsgPayload payload=new MsgPayload();
+        payload.nData=command.payload().nData();payload.nDatas=command.payload().nDatas();
+        payload.strData=command.payload().strData();payload.strDatas=command.payload().strDatas();
+        payload.bytes=command.payload().bytes();
+        commandSerial=command.serial();
+        owner.persistPending(generation,commandSerial,target);
+        long time=now();admission.commitDispatch(time);model.markDispatched(time);
+        removeMessages(DEADLINE);
+        if(!sendEmptyMessageDelayed(DEADLINE,SepMuxTrial.COMPLETION_TIMEOUT_MS))
+            throw new IllegalStateException("Completion watchdog unavailable");
+        owner.assertQualifiedExclusiveOwner();
+        if(owner.generation()!=generation) throw new IllegalStateException("Owner changed");
+        HonorSimRouteCallGuard.requireIdle();
+        commandSent=true;
+        owner.radio().sendCommRequest(commandSerial,1005,payload);
+    }
+    private void scheduleDeadline() {
+        removeMessages(DEADLINE);
+        long delay=model.deadlineMillis()-now();
+        if(delay<=0 || !sendEmptyMessageDelayed(DEADLINE,delay))
+            throw new IllegalStateException("Model watchdog unavailable/expired");
+    }
+    private void reconcile() throws RemoteException,java.io.IOException {
+        if(model.state()==SharedSlotRouteTrial.State.UNKNOWN) {stop(model.reason());return;}
+        if(model.phaseComplete()) {
+            if(!completionDurable) {
+                owner.persistCompleted(generation,commandSerial,model);completionDurable=true;
+                removeMessages(DEADLINE);
+                EndpointPublication.notifyKnown(()->sink.knownEndpoint(this,generation,commandSerial,target));
+            }
+            return;
+        }
+        if(model.state()==SharedSlotRouteTrial.State.RECONCILING && !routeRequested) {
+            routeRequested=true;
+            routeToken=model.queryRoute(owner.allocateRouteSerial(),now());
+            scheduleDeadline();owner.queryRoute(routeToken.serial,this);
+            // Normal framework initialization can issue EID/APDUs and retained vendor pairing.
+            UiccController.getInstance().requestIccCardStatusRefresh(SLOT);
+            if(target==SepMuxTrial.Selector.PHYSICAL) freshPhysicalStatus();
+        }
+    }
+    private void freshPhysicalStatus() {
+        try {
+            var token=model.queryPhysicalCard(now());
+            phone.mCi.getIccCardStatus(obtainMessage(STATUS,new Token(generation,token)));
+        } catch(IllegalStateException unavailable) { /* One outstanding, max3 real ICC events. */ }
+    }
+    @Override public void handleMessage(Message message) {
+        if(message.what==DEADLINE) {
+            if(!completionDurable) {model.tick(now());stop("Bounded trial deadline; outcome unknown");}
+            return;
+        }
+        if(stopped || (message.what!=BASELINE && message.what!=STATUS)) return;
+        if(!(message.obj instanceof AsyncResult ar) || !(ar.userObj instanceof Token token)
+                || token.generation()!=generation || owner.generation()!=generation
+                || ar.exception!=null || !(ar.result instanceof IccCardStatus card)) {
+            stop("Stale/failed status receipt");return;
+        }
+        if(card.mCardState==null || card.mSlotPortMapping==null) {
+            stop("Malformed card status identity");return;
+        }
+        AnswerToReset atr=card.mCardState==IccCardStatus.CardState.CARDSTATE_ABSENT
+                ? null : AnswerToReset.parseAtr(card.atr);
+        int mapped=card.mSlotPortMapping==null ? -1 : card.mSlotPortMapping.mPhysicalSlotIndex;
+        try {
+            if(message.what==BASELINE) {
+                var evidence=qualify();admission.check(now());
+                if(owner.generation()!=generation) throw new IllegalStateException("Owner changed");
+                PhysicalSimEvidence physical=physicalEvidence(card,atr,generation);
+                if(freshPhysicalBaseline!=null || physical==null || physicalBaselineProof==null
+                        || !physicalBaselineProof.physicalFor(generation))
+                    throw new IllegalStateException("Fresh physical mode0/controller baseline required");
+                commandSerial=owner.allocateSerial();
+                dispatch(model.beginEuicc(evidence,commandSerial,physical,physicalBaselineProof,now()));
+            } else {
+                model.physicalCardStatus(token.query(),generation,mapped,physicalEvidence(card,atr,generation),now());
+                reconcile();sink.record(displayState(),model.reason());
+            }
+        } catch(RemoteException | java.io.IOException | RuntimeException failure) {
+            stop("Submission/status outcome unknown");
+        }
+    }
+    private static PhysicalSimEvidence.Card cardState(IccCardStatus.CardState state) {
+        if(state==null) return PhysicalSimEvidence.Card.UNKNOWN;
+        return switch(state) {
+            case CARDSTATE_ABSENT -> PhysicalSimEvidence.Card.ABSENT;
+            case CARDSTATE_PRESENT -> PhysicalSimEvidence.Card.PRESENT;
+            case CARDSTATE_RESTRICTED -> PhysicalSimEvidence.Card.RESTRICTED;
+            case CARDSTATE_ERROR -> PhysicalSimEvidence.Card.ERROR;
+        };
+    }
+    private PhysicalSimEvidence.Controller physicalController() {
+        UiccController controller=UiccController.getInstance();
+        UiccSlot slot=controller.getUiccSlotForPhone(SLOT);
+        int radioState=phone.mCi.getRadioState();
+        if(slot==null) return null;
+        // getCardState/default port alone can mean uninitialized; require explicit known mapping.
+        var state=slot.getCardState();
+        return new PhysicalSimEvidence.Controller(slot,slot.getUiccCard(),controller.getSlotIdFromPhoneId(SLOT),
+                slot.getPhoneIdFromPortIndex(0),slot.getPortIndexFromPhoneId(SLOT),radioState,cardState(state),
+                slot.isStateUnknown(),slot.isActive(),slot.isPortActive(0),slot.isEuicc(),
+                radioState==android.telephony.TelephonyManager.RADIO_POWER_ON
+                    || radioState==android.telephony.TelephonyManager.RADIO_POWER_OFF);
+    }
+    PhysicalSimEvidence physicalEvidence(IccCardStatus card,AnswerToReset atr,long epoch) {
+        if(card.mSlotPortMapping==null) return null;
+        PhysicalSimEvidence.Controller first=physicalController(),second=physicalController();
+        return PhysicalSimEvidence.observe(epoch,cardState(card.mCardState),
+                card.mSlotPortMapping.mPhysicalSlotIndex,card.mSlotPortMapping.mPortIndex,
+                atr!=null,atr!=null && atr.isEuiccSupported(),first,second);
+    }
+    public void onHonorResponse(int slot,int serial,int requestId,int type,int error) {
+        requireThread();
+        if(stopped || !commandSent || slot!=SLOT || serial!=commandSerial || requestId!=1005) return;
+        if(owner.generation()!=generation) {stop("Owner changed");return;}
+        model.response(slot,serial,requestId,type,error,now());
+        try {reconcile();sink.record(displayState(),model.reason());}
+        catch(RemoteException | java.io.IOException | RuntimeException failure) {stop("Readback failed");}
+    }
+    public void onHonorIndication(int slot,int messageId,int[] pair) {
+        requireThread();if(stopped || !commandSent) return;
+        if(owner.generation()!=generation) {stop("Owner changed");return;}
+        model.completion(slot,messageId,pair,now());
+        try {reconcile();sink.record(displayState(),model.reason());}
+        catch(RemoteException | java.io.IOException | RuntimeException failure) {stop("Readback failed");}
+    }
+    public void onRouteResult(int type,int serial,int error,int support,int mode,int reserved) {
+        requireThread();
+        if(stopped) return;
+        if(freshPhysicalBaseline!=null) {
+            freshPhysicalBaseline.onResponse(owner.generation(),serial,type,error,support,mode,reserved,now());
+            if(freshPhysicalBaseline.state()==MtkSimTypeQuery.State.WAITING) return;
+            if(freshPhysicalBaseline.state()!=MtkSimTypeQuery.State.PHYSICAL) {stop("Fresh mode0 baseline refused");return;}
+            physicalBaselineProof=freshPhysicalBaseline;freshPhysicalBaseline=null;
+            phone.mCi.getIccCardStatus(obtainMessage(BASELINE,new Token(generation,null)));
+            return;
+        }
+        if(routeToken==null || routeToken.serial!=serial) return;
+        if(owner.generation()!=generation) {stop("Owner changed");return;}
+        try {
+            model.routeResponse(routeToken,generation,serial,type,error,support,mode,reserved,now());
+            if(model.state()==SharedSlotRouteTrial.State.RESERVED && target==SepMuxTrial.Selector.PHYSICAL
+                    && !commandSent) dispatch(model.command(now()));
+            reconcile();
+            if(!stopped && !completionDurable) scheduleDeadline();
+            sink.record(displayState(),model.reason());
+        } catch(RemoteException | java.io.IOException | RuntimeException failure) {stop("Route outcome unknown");}
+    }
+    public void onIccChanged(int phoneId) {
+        requireThread();
+        if(!stopped && commandSent && target==SepMuxTrial.Selector.PHYSICAL && phoneId==SLOT) {
+            if(owner.generation()!=generation) {stop("Owner changed");return;}
+            freshPhysicalStatus();
+        }
+    }
+    public void onOwnerUnavailable() {requireThread();sink.recordTransportFailure(-1);stop("Owner unavailable");}
+}
diff --git a/src/com/android/internal/telephony/honor/HonorSepTrialOwner.java b/src/com/android/internal/telephony/honor/HonorSepTrialOwner.java
