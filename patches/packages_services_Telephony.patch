--- /dev/null
+++ b/tests/host/run-esim-settings-phone-integration-tests.py
@@ -0,0 +1,110 @@
+#!/usr/bin/env python3
+"""Run full Phone/Settings reply integration on a supplied SDK37 Robolectric runtime.
+
+Run in the existing test namespace with its real framework-resource APK mounted read-only.
+This compiles Java test components only. No APK, image, Binder device, or native modem runs.
+"""
+import argparse, hashlib, json, os, pathlib, shlex, subprocess
+
+def method(text, signature):
+    start = text.index(signature)
+    end = text.index("{", start) + 1
+    depth = 1
+    while depth:
+        depth += (text[end] == "{") - (text[end] == "}")
+        end += 1
+    return text[start:end]
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument("--phone-source", type=pathlib.Path, default=pathlib.Path(__file__).resolve().parents[2])
+    ap.add_argument("--settings-source", required=True, type=pathlib.Path)
+    ap.add_argument("--old-settings-source", type=pathlib.Path)
+    ap.add_argument("--runtime-args", required=True, type=pathlib.Path)
+    ap.add_argument("--jdk", required=True, type=pathlib.Path)
+    ap.add_argument("--output", required=True, type=pathlib.Path)
+    a = ap.parse_args()
+    out = a.output.resolve(); out.mkdir(parents=True, exist_ok=False)
+    src = out / "src"; src.mkdir()
+    classes = out / "classes"; classes.mkdir()
+    for name in ["tmp", "home"]:
+        (out / "runtime" / name).mkdir(parents=True, exist_ok=True)
+    phone = a.phone_source
+    prod = phone / "src/com/android/internal/telephony/honor"
+    fixtures = phone / "tests/host/route-prepare-service-fixtures"
+    local = pathlib.Path(__file__).resolve().with_name("esim-cross-layer-fixtures") / "settings-phone"
+    pins = []
+    def read(p):
+        raw = p.read_bytes(); pins.append({"path": str(p.resolve()), "sha256": hashlib.sha256(raw).hexdigest()})
+        return raw.decode()
+    owner = read(prod / "HonorSepTrialOwner.java")
+    stub = read(fixtures / "com/android/internal/telephony/honor/HonorSepTrialOwner.java")
+    stub = stub.replace("import java.util.function.Consumer;", local.joinpath("OwnerImports.java.in").read_text(), 1)
+    constructor = "public HonorSepTrialOwner(UiState state,int phase){this.state=state;this.phase=phase;}"
+    assert stub.count(constructor) == 1
+    stub = stub.replace(constructor, constructor[:-1] + "initRoute(phase);}", 1)
+    for physical, name in [("true", "requestPhysicalSim2Once"), ("false", "requestEuiccVisibilityOnce")]:
+        old = "public void " + name + "(int phase,Consumer<RouteRefusal> refused){refusedRoute=refused;if(!deferRoute)actuations++;}"
+        assert stub.count(old) == 1
+        stub = stub.replace(old, "public void " + name + "(int phase,Consumer<RouteRefusal> refused){refusedRoute=refused;requestRoute(" + physical + ",phase,refused);}", 1)
+    assert stub.rstrip().endswith("}")
+    glue = local.joinpath("OwnerGlue.java.in").read_text()
+    parts = "\n".join(method(owner, sig) for sig in ["    private void requestRoute(", "    private void closeReadiness(", "    private static void lifecycle("])
+    (src / "HonorSepTrialOwner.java").write_text(stub.rstrip()[:-1] + glue + parts + "\n}\n" + local.joinpath("Adapter.java.in").read_text())
+    for p in fixtures.rglob("*.java"):
+        if p.name != "HonorSepTrialOwner.java":
+            (src / p.name).write_text(read(p))
+    for name in ["EuiccReadiness", "LpaOperationLease", "LpaRecoveryFence", "SepMuxJournal",
+                 "SepMuxTrial", "SepMuxAdmission", "MtkSimTypeQuery", "SharedSlotRouteTrial",
+                 "RecoverySimPower", "SepMuxRouteAdoption", "PhysicalSimEvidence", "EndpointPublication"]:
+        p = prod / (name + ".java"); (src / p.name).write_text(read(p))
+    trace = phone / "honor-lpa-lease/src/com/honor/ldy_an00/lease/HonorLpaLifecycleTrace.java"
+    (src / trace.name).write_text(read(trace))
+    test = phone / "tests/host/com/android/phone/SettingsPhoneNoAdmissionIntegrationTest.java"
+    (src / test.name).write_text(read(test))
+    service = phone / "src/com/android/phone/HonorLdyAn00EsimSetupService.java"
+    vmrel = "src/com/android/settings/network/HonorLdyAn00EsimSetupViewModel.java"
+    for p in [service, a.settings_source / vmrel]:
+        (src / p.name).write_text(read(p))
+    args = shlex.split(a.runtime_args.read_text())
+    cp = args[args.index("-cp") + 1]
+    def run(argv, name):
+        p = subprocess.run(list(map(str, argv)), capture_output=True, text=True)
+        (out / (name + ".log")).write_text(p.stdout + p.stderr)
+        (out / (name + ".argv.json")).write_text(json.dumps(list(map(str, argv)), indent=2) + "\n")
+        return p
+    compile_result = run([a.jdk / "bin/javac", "-proc:none", "-cp", cp, "-d", classes,
+                          *sorted(src.glob("*.java"))], "compile")
+    assert compile_result.returncode == 0, "Component compile failed; retained log"
+    results = []
+    for mode in (["old", "new"] if a.old_settings_source else ["new"]):
+        prefix = str(classes)
+        if mode == "old":
+            oldsrc = a.old_settings_source / vmrel
+            read(oldsrc)
+            oldclasses = out / "old-vm"; oldclasses.mkdir()
+            compiled = run([a.jdk / "bin/javac", "-proc:none", "-cp", prefix + os.pathsep + cp,
+                            "-d", oldclasses, oldsrc], "old-compile")
+            assert compiled.returncode == 0
+            prefix = str(oldclasses) + os.pathsep + prefix
+        options = args.copy()
+        options[options.index("-cp") + 1] = prefix + os.pathsep + cp
+        options[-1] = "com.android.phone.SettingsPhoneNoAdmissionIntegrationTest"
+        options = [("-Djava.io.tmpdir=" + str(out / "runtime/tmp")) if x.startswith("-Djava.io.tmpdir=")
+                   else ("-Duser.home=" + str(out / "runtime/home")) if x.startswith("-Duser.home=") else x for x in options]
+        argfile = out / (mode + ".args")
+        argfile.write_text("\n".join(json.dumps(x) for x in options) + "\n")
+        executed = run([a.jdk / "bin/java", "@" + str(argfile)], mode + "-runtime")
+        text = executed.stdout + executed.stderr
+        passed = executed.returncode == 0 if mode == "new" else (executed.returncode != 0
+                 and "Tests run:" in text and "qualified original SELECT must clear its own pending choice" in text)
+        results.append({"mode": mode, "returncode": executed.returncode, "expected_outcome_pass": passed})
+    for p in pins:
+        assert hashlib.sha256(pathlib.Path(p["path"]).read_bytes()).hexdigest() == p["sha256"], "Source changed during test"
+    result = {"acceptance_pass": all(r["expected_outcome_pass"] for r in results), "results": results,
+              "source_pins": pins, "no_device_or_APK_build": True}
+    (out / "RESULT.json").write_text(json.dumps(result, indent=2) + "\n")
+    print(json.dumps(result))
+    return 0 if result["acceptance_pass"] else 2
+if __name__ == "__main__":
+    raise SystemExit(main())
