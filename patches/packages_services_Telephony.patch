@@ -0,0 +1,31 @@
+/* Copyright (C) 2026 The LineageOS Project. SPDX-License-Identifier: Apache-2.0 */
+package com.android.internal.telephony.honor;
+
+/** Passive owner projection; it does not query hardware, alter journals or authorize selectors. */
+final class SepMuxUiProjection {
+    enum Phase { UNKNOWN, WORKING, PHYSICAL_READY, KNOWN_BLANK, IDLE, EUICC_WAITING }
+    static Phase project(boolean ownerAvailable,boolean requestFailed,LpaOperationLease.State lease,
+            SharedSlotRouteTrial.State route,boolean pendingWork,boolean knownBlank,
+            boolean blankBaselinePresent) {
+        if(!ownerAvailable || requestFailed || lease==LpaOperationLease.State.UNKNOWN
+                || route==SharedSlotRouteTrial.State.UNKNOWN) return Phase.UNKNOWN;
+        if(lease==LpaOperationLease.State.ACTIVE || pendingWork) return Phase.WORKING;
+        // Blank history remains CLEAN during a physical return, until durable completion clears it.
+        switch(route) {
+            case RESERVED,RETURN_BASELINE,WAITING,RECONCILING: return Phase.WORKING;
+            case PHYSICAL_RESTORED: return Phase.PHYSICAL_READY;
+            default: break;
+        }
+        if(knownBlank) return blankBaselinePresent ? Phase.KNOWN_BLANK : Phase.UNKNOWN;
+        return switch(route) {
+            case NEW -> Phase.IDLE;
+            case EUICC_ROUTE_OBSERVED -> Phase.EUICC_WAITING;
+            default -> Phase.WORKING;
+        };
+    }
+    static boolean canReturnPhysical(Phase phase,LpaOperationLease.State lease,boolean adapterAllows) {
+        return (phase==Phase.EUICC_WAITING || phase==Phase.KNOWN_BLANK)
+                && lease==LpaOperationLease.State.CLEAN && adapterAllows;
+    }
+
+}
diff --git a/src/com/android/internal/telephony/honor/SharedSlotRouteTrial.java b/src/com/android/internal/telephony/honor/SharedSlotRouteTrial.java
new file mode 100644
index 0000000000000000000000000000000000000000..a43925d415197c93a7582c1821825f8afe8cea11
--- /dev/null
+++ b/src/com/android/internal/telephony/honor/SharedSlotRouteTrial.java
@@ -0,0 +1,238 @@
+/* Copyright (C) 2026 The LineageOS Project. SPDX-License-Identifier: Apache-2.0 */
+package com.android.internal.telephony.honor;
+
+/**
+ * Bounded shared-SIM2 route experiment. A modem-reported eUICC route is independent of an active
+ * profile/card. It is not EID, LPA readiness or electrical-state proof. The owner must establish
+ * the reviewed exclusive clean callback epoch and durably reserve every serial before dispatch.
+ * No constructor/method performs I/O, automatically switches, retries or reverses a selector.
+ */
+public final class SharedSlotRouteTrial {
+    public enum State { NEW, RESERVED, RETURN_BASELINE, WAITING, RECONCILING,
+        EUICC_ROUTE_OBSERVED, PHYSICAL_RESTORED, UNKNOWN }
+    private enum Purpose { COMPLETION, RETURN_BASELINE }
+    public static final long ROUTE_TIMEOUT_MS = 10_000;
+    private static final int SLOT = 1;
+    public static final class RouteQuery {
+        public final long generation;
+        public final int serial;
+        public final long deadlineMillis;
+        private final Purpose purpose;
+        private RouteQuery(long generation, int serial, Purpose purpose, long deadline) {
+            this.generation=generation; this.serial=serial; this.purpose=purpose;
+            this.deadlineMillis=deadline;
+        }
+    }
+    public static final class CardQuery {
+        private CardQuery() {}
+    }
+    private State state=State.NEW;
+    private SepMuxTrial.Selector target;
+    private long generation, deadline, lastTime;
+    private int serial, lastRouteSerial, cardQueries;
+    private boolean commandIssued, dispatched, responseConsumed, finalAccepted, completed;
+    private boolean routeMatches, physicalPathMatches, returnUsed, adopted;
+    private PhysicalSimEvidence.Presence physicalPresence;
+    private RouteQuery routeToken;
+    private MtkSimTypeQuery route;
+    private CardQuery cardToken;
+    private String reason="";
+
+    public State state() { return state; }
+    public String reason() { return reason; }
+    public long deadlineMillis() {
+        return route!=null && route.state()==MtkSimTypeQuery.State.WAITING
+                ? Math.min(deadline,routeToken.deadlineMillis) : deadline;
+    }
+    public boolean phaseComplete() {
+        return state==State.EUICC_ROUTE_OBSERVED || state==State.PHYSICAL_RESTORED;
+    }
+    boolean hasPendingQueries() {
+        return cardToken!=null || route!=null && route.state()==MtkSimTypeQuery.State.WAITING;
+    }
+    public boolean canRequestPhysicalReturn() {
+        return state==State.EUICC_ROUTE_OBSERVED && !returnUsed;
+    }
+    boolean completionMatches(long epoch,int commandSerial,int selector) {
+        return !adopted && phaseComplete() && generation==epoch && serial==commandSerial
+                && target.wire==selector;
+    }
+    /** A prior CLEAN transaction plus fresh owned readback; not a synthetic SEP1002/final. */
+    void adoptEuicc(SepMuxTrial.Evidence evidence,SepMuxRouteAdoption.Proof proof) {
+        evidence.require();
+        if(state!=State.NEW || proof==null) throw new IllegalStateException("No fresh adoption proof");
+        generation=proof.generation;serial=proof.lastSetterSerial;target=SepMuxTrial.Selector.EUICC;
+        adopted=true;state=State.EUICC_ROUTE_OBSERVED;
+        reason=proof.lastSetterSerial>0 ? "Historical CLEAN route adopted from fresh owned GET/card proof"
+                : "Current mode1 adopted from genuine owned GET/card proof; no selector completion";
+    }
+    private void unknown(String why) { state=State.UNKNOWN; reason=why; }
+    private boolean at(long now) {
+        if(state==State.NEW || state==State.UNKNOWN || phaseComplete()) return false;
+        if(now<lastTime || now>=deadline) { unknown("deadline/clock; no retry");return false; }
+        lastTime=now;return true;
+    }
+    private void reserve(int commandSerial,SepMuxTrial.Selector selector,long now) {
+        if(commandSerial<=0 || now<0 || now>Long.MAX_VALUE-SepMuxTrial.ADMISSION_TIMEOUT_MS)
+            throw new IllegalStateException("Invalid admission identity/clock");
+        serial=commandSerial;target=selector;lastTime=now;
+        deadline=now+SepMuxTrial.ADMISSION_TIMEOUT_MS;
+        commandIssued=false;dispatched=false;responseConsumed=false;finalAccepted=false;adopted=false;
+        completed=false;routeMatches=false;physicalPathMatches=false;physicalPresence=null;
+        routeToken=null;route=null;cardToken=null;cardQueries=0;state=State.RESERVED;
+    }
+    /** Only the Phone owner can invoke this after its marked-kernel-restart ticket. */
+    SepMuxTrial.Command beginRecovery(SepMuxTrial.Evidence evidence,int commandSerial,
+            long epoch,long now) {
+        evidence.require();
+        if(state!=State.NEW || epoch<=0) throw new IllegalStateException("Recovery already used");
+        generation=epoch;reserve(commandSerial,SepMuxTrial.Selector.EUICC,now);
+        return command(now);
+    }
+    public SepMuxTrial.Command beginEuicc(SepMuxTrial.Evidence evidence,int commandSerial,
+            SepMuxTrial.Baseline physical,long now) {
+        evidence.require();
+        if(state!=State.NEW || physical==null || physical.slot()!=SLOT
+                || physical.generation()<=0 || !physical.present() || !physical.validAtr()
+                || physical.euicc()) throw new IllegalStateException("Physical SIM2 baseline required");
+        generation=physical.generation();reserve(commandSerial,SepMuxTrial.Selector.EUICC,now);
+        return command(now);
+    }
+    /** Production present/empty path: fresh owned mode0 precedes the typed CI/controller proof. */
+    SepMuxTrial.Command beginEuicc(SepMuxTrial.Evidence evidence,int commandSerial,
+            PhysicalSimEvidence physical,MtkSimTypeQuery mode0,long now) {
+        evidence.require();
+        if(state!=State.NEW || physical==null || physical.slot!=SLOT || physical.port!=0
+                || mode0==null || !mode0.physicalFor(physical.generation))
+            throw new IllegalStateException("Qualified physical mode0 baseline required");
+        generation=physical.generation;reserve(commandSerial,SepMuxTrial.Selector.EUICC,now);
+        return command(now);
+    }
+    /** Explicit return admission first obtains a NEW GET; an old mode1 snapshot is insufficient. */
+    public RouteQuery beginPhysicalReturn(SepMuxTrial.Evidence evidence,long epoch,
+            int commandSerial,int routeSerial,long now) {
+        evidence.require();
+        if(!canRequestPhysicalReturn() || epoch!=generation || commandSerial<=serial
+                || routeSerial<=lastRouteSerial)
+            throw new IllegalStateException("Known same-owner eUICC route required");
+        returnUsed=true;reserve(commandSerial,SepMuxTrial.Selector.PHYSICAL,now);
+        state=State.RETURN_BASELINE;
+        return newRoute(routeSerial,Purpose.RETURN_BASELINE,now);
+    }
+    /** Only after a fresh positive mode1 return baseline; durable PENDING is the owner's next gate. */
+    public SepMuxTrial.Command command(long now) {
+        if(!at(now) || state!=State.RESERVED || commandIssued)
+            throw new IllegalStateException("No admitted command");
+        commandIssued=true;
+        return new SepMuxTrial.Command(SLOT,serial,1005,new SepMuxTrial.Payload(target.wire,
+                new int[0],"",new String[0],new byte[0]));
+    }
+    /** Call only after durable PENDING and immediately before the single remote setter. */
+    public void markDispatched(long now) {
+        if(!at(now) || state!=State.RESERVED || !commandIssued || dispatched
+                || now>Long.MAX_VALUE-SepMuxTrial.COMPLETION_TIMEOUT_MS)
+            throw new IllegalStateException("Dispatch not admitted");
+        dispatched=true;state=State.WAITING;deadline=now+SepMuxTrial.COMPLETION_TIMEOUT_MS;
+    }
+    public void response(int slot,int commandSerial,int requestId,int type,int error,long now) {
+        if(slot!=SLOT || commandSerial!=serial || requestId!=1005 || responseConsumed) return;
+        if(!at(now)) return;
+        if(!dispatched || (type!=0 && type!=2)) {unknown("Unqualified final");return;}
+        responseConsumed=true;
+        if(error!=0) {unknown("Failed final; no automatic reversal");return;}
+        finalAccepted=true;reconcile();
+    }
+    public void completion(int slot,int requestId,int[] pair,long now) {
+        if(slot!=SLOT || requestId!=1002 || !at(now)) return;
+        if(!dispatched || pair==null || pair.length!=2 || pair[0]!=1 || pair[1]!=0) {
+            unknown("Unqualified native completion");return;
+        }
+        if(completed) return;
+        completed=true;reconcile();
+    }
+    private void reconcile() {
+        if(finalAccepted && completed) state=State.RECONCILING;
+    }
+    /** Exactly one fresh owned GET after both final and native completion. ACK2 handling is external. */
+    public RouteQuery queryRoute(int routeSerial,long now) {
+        if(!at(now) || !finalAccepted || !completed || route!=null)
+            throw new IllegalStateException("No post-completion route query");
+        return newRoute(routeSerial,Purpose.COMPLETION,now);
+    }
+    private RouteQuery newRoute(int routeSerial,Purpose purpose,long now) {
+        if(routeSerial<=lastRouteSerial || now>Long.MAX_VALUE-ROUTE_TIMEOUT_MS)
+            throw new IllegalStateException("Durably unique query serial required");
+        lastRouteSerial=routeSerial;
+        long end=Math.min(deadline,now+ROUTE_TIMEOUT_MS);
+        routeToken=new RouteQuery(generation,routeSerial,purpose,end);
+        route=new MtkSimTypeQuery(generation,routeSerial,end);
+        return routeToken;
+    }
+    public void routeResponse(RouteQuery token,long epoch,int routeSerial,int type,int error,
+            int support,int mode,int reserved,long now) {
+        if(token==null || token!=routeToken || !at(now)) return;
+        route.onResponse(epoch,routeSerial,type,error,support,mode,reserved,now);
+        switch(route.state()) {
+            case WAITING: return;
+            case UNKNOWN: case UNQUALIFIED: unknown("Unqualified route readback");return;
+            default: break;
+        }
+        if(token.purpose==Purpose.RETURN_BASELINE) {
+            if(route.state()!=MtkSimTypeQuery.State.EUICC) {
+                unknown("Return baseline is not positive mode1");return;
+            }
+            state=State.RESERVED;routeToken=null;route=null;return;
+        }
+        if(route.mode()!=target.wire) {unknown("Modem-reported route mismatch");return;}
+        routeMatches=true;completeIfReady();
+    }
+    /** Fresh normal CI status; absence on the eUICC side is not a protocol failure. */
+    public CardQuery queryPhysicalCard(long now) {
+        if(!at(now) || target!=SepMuxTrial.Selector.PHYSICAL || !completed || !finalAccepted
+                || cardToken!=null || physicalPathMatches || cardQueries>=3)
+            throw new IllegalStateException("No bounded physical status query");
+        cardQueries++;cardToken=new CardQuery();return cardToken;
+    }
+    public void physicalCardStatus(CardQuery token,long epoch,boolean present,boolean validAtr,
+            boolean euicc,int mappedSlot,boolean controllerMatches,long now) {
+        acceptPhysicalStatus(token,epoch,mappedSlot,present && validAtr && !euicc && controllerMatches,
+                PhysicalSimEvidence.Presence.PRESENT_PHYSICAL,now);
+    }
+    void physicalCardStatus(CardQuery token,long epoch,int mappedSlot,PhysicalSimEvidence physical,long now) {
+        acceptPhysicalStatus(token,epoch,mappedSlot,physical!=null && physical.generation==epoch,
+                physical==null ? null : physical.presence,now);
+    }
+    private void acceptPhysicalStatus(CardQuery token,long epoch,int mappedSlot,boolean qualified,
+            PhysicalSimEvidence.Presence presence,long now) {
+        if(token==null || token!=cardToken) return;
+        cardToken=null; // Exact receipt bookkeeping, even after terminal completion.
+        if(!at(now)) return;
+        if(epoch!=generation) {unknown("Physical query generation changed");return;}
+        if(mappedSlot!=SLOT) {unknown("Physical SIM2 mapping changed");return;}
+        if(!qualified) {
+            reason="Awaiting fresh present-or-empty physical path/controller proof; not complete";
+            return;
+        }
+        physicalPathMatches=true;physicalPresence=presence;completeIfReady();
+    }
+    private void completeIfReady() {
+        if(!finalAccepted || !completed || !routeMatches) return;
+        if(target==SepMuxTrial.Selector.EUICC) {
+            state=State.EUICC_ROUTE_OBSERVED;
+            reason="Known modem mode1; no card/EID/profile claim";
+        } else if(physicalPathMatches) {
+            state=State.PHYSICAL_RESTORED;
+            reason=physicalPresence==PhysicalSimEvidence.Presence.EMPTY_PHYSICAL
+                    ? "Known completion plus mode0 and fresh empty physical path/controller proof"
+                    : "Known completion plus mode0 and fresh physical SIM2/controller readback";
+        }
+    }
+    public void tick(long now) {
+        if(!at(now)) return;
+        if(route!=null) {
+            route.expire(now);
+            if(route.state()==MtkSimTypeQuery.State.UNKNOWN) unknown("Route query deadline");
+        }
+    }
+    public void transportLost() { if(state!=State.NEW) unknown("Owner/transport lost; no retry"); }
+}
