index 0000000000000000000000000000000000000000..295f2daa96dd3629a6118711c8a94da3bad5e4e5
--- /dev/null
+++ b/src/com/android/internal/telephony/honor/HonorCompletedSipDecoder.java
@@ -0,0 +1,117 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.internal.telephony.honor;
+
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.nio.charset.StandardCharsets;
+import java.util.Locale;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+/** Functional completed-call SIP fields only. No full SIP or Reason text is retained. */
+final class HonorCompletedSipDecoder {
+    private static final Pattern STARS = Pattern.compile("\\*+");
+    private static final Pattern DIGITS = Pattern.compile("^[0-9]+");
+    private static final String[] ERROR_REASONS = {
+        "sdp", "offerrefused", "negotiation", "drblost", "dedicatedbearerlost",
+        "qosnotestablished", "nomedia", "hifistartfail"
+    };
+
+    record Update(HonorMtkSipDecoder.SipUpdate shared, Boolean dc, boolean dcMalformed,
+            Integer reasonSip, Integer reasonQ850, Integer reasonRelease,
+            boolean reasonError, boolean headersKnown) {}
+
+    private HonorCompletedSipDecoder() {}
+
+    static Update decode(int slot, int outerVersion, int messageId, byte[] payload) {
+        HonorMtkSipDecoder.SipUpdate shared =
+                HonorMtkSipDecoder.decode(slot, outerVersion, messageId, payload);
+        if (shared == null) return null;
+        // The shared strict decoder has checked both byte counts and the complete envelope.
+        ByteBuffer buffer = ByteBuffer.wrap(payload).order(ByteOrder.LITTLE_ENDIAN);
+        int idLength = buffer.getInt(20), messageLength = buffer.getInt(24);
+        String message = new String(payload, 28 + idLength, messageLength,
+                StandardCharsets.US_ASCII).trim();
+        int split = message.indexOf("\r\n\r\n");
+        String headers = split < 0 ? message : message.substring(0, split);
+        String body = split < 0 ? "" : message.substring(split);
+        Integer sip = null, q850 = null, release = null;
+        boolean known = true, error = false;
+        for (String line : headers.split("\\r?\\n")) {
+            String[] parts = line.split(": ");
+            if (parts.length == 0 || !parts[0].equalsIgnoreCase("reason")) {
+                // Stock ignores the non-": " spelling. A recognizable malformed Reason
+                // must not become evidence of a normal call for functional reset.
+                if (line.toLowerCase(Locale.ROOT).startsWith("reason:")) known = false;
+                continue;
+            }
+            String raw = line.toLowerCase(Locale.ROOT);
+            String normalized = raw.replace(" ", "");
+            error = false;
+            for (String token : ERROR_REASONS) error |= normalized.contains(token);
+            if (canReplaceMaskedReason(raw)) {
+                raw = raw.replace("*************", "release_cause")
+                        .replace("*****", "q.850").replace("***", "sip");
+            }
+            for (String section : raw.split("(?=sip|q\\.850|release_cause)")) {
+                int causeAt = section.indexOf("cause=");
+                if (causeAt < 0) continue;
+                boolean relevant = section.startsWith("sip") || section.startsWith("q.850")
+                        || section.startsWith("release_cause");
+                if (!relevant) {
+                    known = false; // Unrecognized cause protocol is not a fabricated normal code.
+                    continue;
+                }
+                Integer value = numberPrefix(section.substring(causeAt + 6));
+                if (value == null) known = false;
+                if (section.startsWith("sip")) sip = value;
+                else if (section.startsWith("q.850")) q850 = value;
+                else release = value;
+            }
+        }
+
+        Boolean dc = null;
+        boolean malformedDc = false;
+        if (!body.isEmpty() && shared.type == 1 && (shared.initialInvite || shared.code == 183)) {
+            int applicationPort = 0;
+            for (String line : body.split("\\r?\\n")) {
+                String[] pair = line.split("=");
+                if (pair.length < 2 || !pair[0].equals("m")) continue;
+                String[] media = pair[1].split(" ");
+                if (media.length < 4) continue; // Stock ignores a short media line.
+                try {
+                    int port = Integer.parseInt(media[1]);
+                    if (media[0].equals("application")) applicationPort = port;
+                } catch (NumberFormatException invalidPort) {
+                    malformedDc = true; // Do not turn a malformed candidate into NOT_DC.
+                }
+            }
+            if (!malformedDc) dc = applicationPort > 0;
+        }
+        return new Update(shared, dc, malformedDc, sip, q850, release, error, known);
+    }
+
+    private static Integer numberPrefix(String text) {
+        Matcher matcher = DIGITS.matcher(text);
+        if (!matcher.find()) return null;
+        try {
+            return Integer.valueOf(matcher.group());
+        } catch (NumberFormatException overflow) {
+            return null;
+        }
+    }
+
+    private static boolean canReplaceMaskedReason(String value) {
+        Matcher matcher = STARS.matcher(value);
+        boolean replace = false;
+        while (matcher.find()) {
+            int length = matcher.group().length();
+            if (length == 3 || length == 5 || length == 13) replace = true;
+            else if (length >= 4) return false;
+        }
+        return replace;
+    }
+}
diff --git a/src/com/android/internal/telephony/honor/HonorDynamicWfcController.java b/src/com/android/internal/telephony/honor/HonorDynamicWfcController.java
new file mode 100644
index 0000000000000000000000000000000000000000..e823943d8efc0e08a639acc593b49d2ee7a0fd94
--- /dev/null
+++ b/src/com/android/internal/telephony/honor/HonorDynamicWfcController.java
@@ -0,0 +1,108 @@
+/* Copyright (C) 2026 The LineageOS Project. SPDX-License-Identifier: Apache-2.0 */
+package com.android.internal.telephony.honor;
+
+import android.content.Context;
+import android.content.BroadcastReceiver;
+import android.content.Intent;
+import android.content.IntentFilter;
+import android.database.ContentObserver;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.Message;
+import android.telephony.CarrierConfigManager;
+import android.telephony.SubscriptionManager;
+import com.android.internal.telephony.Phone;
+import com.android.internal.telephony.PhoneFactory;
+import java.util.Objects;
+
+/** Regional WFC producer using the same qualified native owner and vote coordinator. */
+final class HonorDynamicWfcController {
+    interface Inputs {
+        String simOperator(int slot);
+        Integer voiceReg(int slot);
+        String city();
+        void watch(Handler handler,Runnable changed);
+    }
+    private record Offered(HonorRegionalImsControl.Scope scope,boolean target) {}
+    private final Handler handler;
+    private final HonorRegionalImsControl control;
+    private final HonorDynamicWfcPolicy policy;
+    private final Inputs inputs;
+    private final Offered[] offered=new Offered[2];
+    private final boolean[] capturing=new boolean[2];
+    private long revision;
+    HonorDynamicWfcController(Handler handler,HonorRegionalImsControl control,
+            HonorDynamicWfcPolicy policy,Inputs inputs) {
+        this.handler=Objects.requireNonNull(handler);this.control=Objects.requireNonNull(control);
+        this.policy=Objects.requireNonNull(policy);this.inputs=Objects.requireNonNull(inputs);
+        inputs.watch(handler,this::changed);
+        HonorCallQosController.addRecoveryAdmissionListener(handler,this::changed);
+        changed();
+    }
+    private void changed() {
+        if(Looper.myLooper()!=handler.getLooper())throw new IllegalStateException("WFC policy looper");
+        revision++;
+        for(int slot=0;slot<offered.length;slot++)review(slot);
+    }
+    private void withdraw(int slot) {
+        Offered old=offered[slot];if(old==null)return;
+        control.withdraw(HonorRegionalImsControl.Policy.DYNAMIC_WFC,old.scope(),
+                HonorRegionalImsControl.Feature.WFC);
+        offered[slot]=null;
+    }
+    private void review(int slot) {
+        if(capturing[slot])return;
+        capturing[slot]=true;long requested=revision;
+        HonorCallQosController.requestRecoveryAdmission(slot,handler,proof->{
+            capturing[slot]=false;
+            if(requested!=revision){review(slot);return;}
+            if(proof.bindingGeneration()<=0||proof.profileGeneration()<=0
+                    ||proof.profileTuple()==null||!proof.profileTuple().usable()
+                    ||proof.adoption()==null)return;
+            var scope=new HonorRegionalImsControl.Scope(slot,proof.bindingGeneration(),
+                    proof.profileGeneration(),proof.profileTuple());
+            if(offered[slot]!=null&&!scope.equals(offered[slot].scope()))withdraw(slot);
+            String operator=inputs.simOperator(slot);
+            if(operator==null||!operator.matches("[0-9]{5,6}"))return; // Unknown is not a known unlisted operator.
+            var rule=policy.rule(operator);
+            if(rule==null){withdraw(slot);return;}
+            Boolean target=rule.desired(
+                    control.unvoted(scope,HonorRegionalImsControl.Feature.WFC),
+                    inputs.voiceReg(slot),inputs.city());
+            if(target==null)return; // Preserve this profile's vote until required inputs are known.
+            Offered next=new Offered(scope,target);
+            if(next.equals(offered[slot]))return;
+            withdraw(slot);offered[slot]=next;
+            control.offer(new HonorRegionalImsControl.Vote(HonorRegionalImsControl.Policy.DYNAMIC_WFC,
+                    scope,HonorRegionalImsControl.Feature.WFC,target,0),receipt->{});
+        });
+    }
+    static Inputs sourceInputs(Context context) {
+        return new Inputs() {
+            public String simOperator(int slot) {
+                Phone phone=PhoneFactory.getPhone(slot);
+                return phone==null||phone.getIccRecords()==null?null
+                        :phone.getIccRecords().getOperatorNumeric();
+            }
+            public Integer voiceReg(int slot) {
+                Phone phone=PhoneFactory.getPhone(slot);
+                return phone==null||phone.getServiceState()==null?null:phone.getServiceState().getState();
+            }
+            public String city(){return null;} // Exact stock113 city lists are empty.
+            public void watch(Handler handler,Runnable changed) {
+                Handler serviceState=new Handler(handler.getLooper()){
+                    @Override public void handleMessage(Message message){changed.run();}
+                };
+                for(Phone phone:PhoneFactory.getPhones())if(phone!=null)
+                    phone.registerForServiceStateChanged(serviceState,1,null);
+                context.getContentResolver().registerContentObserver(SubscriptionManager.CONTENT_URI,
+                        true,new ContentObserver(handler){
+                            @Override public void onChange(boolean self){changed.run();}
+                        });
+                context.registerReceiver(new BroadcastReceiver(){
+                    @Override public void onReceive(Context ignored,Intent intent){changed.run();}
+                },new IntentFilter(CarrierConfigManager.ACTION_CARRIER_CONFIG_CHANGED),null,handler);
+            }
+        };
+    }
+}
diff --git a/src/com/android/internal/telephony/honor/HonorDynamicWfcPolicy.java b/src/com/android/internal/telephony/honor/HonorDynamicWfcPolicy.java
new file mode 100644
index 0000000000000000000000000000000000000000..1331c7b9515e1c2632f6cb2b1d5e8c87ab00b8f0
--- /dev/null
+++ b/src/com/android/internal/telephony/honor/HonorDynamicWfcPolicy.java
@@ -0,0 +1,64 @@
+/* Copyright (C) 2026 The LineageOS Project. SPDX-License-Identifier: Apache-2.0 */
+package com.android.internal.telephony.honor;
+
+import java.io.InputStream;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.Map;
+import java.util.Set;
+import javax.xml.parsers.DocumentBuilderFactory;
+import org.w3c.dom.Element;
+
+/** Exact configured SIM-operator rules, not a global WFC feature switch. */
+final class HonorDynamicWfcPolicy {
+    record Rule(boolean area,boolean followCell,Set<String> cities) {
+        Rule{cities=Set.copyOf(cities);}
+        Boolean desired(Boolean user,Integer voiceReg,String city) {
+            if(area) {
+                if(cities.isEmpty())return false;
+                if(city==null)return null;
+                return cities.contains(city);
+            }
+            if(user==null)return null;
+            if(followCell&&user) {
+                if(voiceReg==null)return null;
+                return voiceReg==0;
+            }
+            return user;
+        }
+    }
+    private final boolean enabled;
+    private final Map<String,Rule> rules;
+    private HonorDynamicWfcPolicy(boolean enabled,Map<String,Rule> rules) {
+        this.enabled=enabled;this.rules=Map.copyOf(rules);
+    }
+    Rule rule(String simOperator){return enabled&&simOperator!=null?rules.get(simOperator):null;}
+    static HonorDynamicWfcPolicy read(InputStream input)throws Exception {
+        Element root=DocumentBuilderFactory.newInstance().newDocumentBuilder()
+                .parse(input).getDocumentElement();
+        if(!root.getTagName().equals("Config"))throw new IllegalArgumentException("WFC config root");
+        var flags=root.getElementsByTagName("FeatureSwitch");
+        if(flags.getLength()!=1)throw new IllegalArgumentException("WFC feature configuration");
+        String flag=((Element)flags.item(0)).getAttribute("featureSwitch");
+        if(!flag.matches("[01]"))throw new IllegalArgumentException("WFC feature value");
+        Map<String,Rule> rules=new HashMap<>();
+        var groups=root.getElementsByTagName("PLMN");
+        for(int i=0;i<groups.getLength();i++) {
+            Element group=(Element)groups.item(i);
+            boolean area=bool(group,"AreaSwitch"),follow=bool(group,"FollowCellSeviceSwitch");
+            Set<String> cities=new HashSet<>();var names=group.getElementsByTagName("City");
+            for(int j=0;j<names.getLength();j++)cities.add(names.item(j).getTextContent());
+            Rule rule=new Rule(area,follow,cities);
+            for(String operator:group.getAttribute("group").split(",")) {
+                if(!operator.matches("[0-9]{5,6}")||rules.put(operator,rule)!=null)
+                    throw new IllegalArgumentException("WFC operator configuration");
+            }
+        }
+        return new HonorDynamicWfcPolicy(flag.equals("1"),rules);
+    }
+    private static boolean bool(Element group,String tag) {
+        var values=group.getElementsByTagName(tag);
+        if(values.getLength()>1)throw new IllegalArgumentException("Duplicate WFC rule");
+        return values.getLength()==1&&Boolean.parseBoolean(values.item(0).getTextContent());
+    }
+}
diff --git a/src/com/android/internal/telephony/honor/HonorEuiccReadinessObserver.java b/src/com/android/internal/telephony/honor/HonorEuiccReadinessObserver.java
new file mode 100644
index 0000000000000000000000000000000000000000..3769bc78d0840ff3b9a2ec1c435c3bdc45b8a4d9
--- /dev/null
+++ b/src/com/android/internal/telephony/honor/HonorEuiccReadinessObserver.java
@@ -0,0 +1,154 @@
+/* Copyright (C) 2026 The LineageOS Project. SPDX-License-Identifier: Apache-2.0 */
+package com.android.internal.telephony.honor;
+
+import android.os.AsyncResult;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.Message;
+import android.telephony.UiccCardInfo;
+import android.telephony.UiccPortInfo;
+import com.android.internal.telephony.uicc.UiccCard;
+import com.android.internal.telephony.uicc.UiccController;
+import com.android.internal.telephony.uicc.UiccPort;
+import com.android.internal.telephony.uicc.UiccSlot;
+import com.android.internal.telephony.uicc.euicc.EuiccCard;
+import com.android.internal.telephony.uicc.euicc.EuiccPort;
+import java.util.concurrent.atomic.AtomicReference;
+
+/** Unwired draft. Reads current framework objects; never requests EID/APDU or changes a card. */
+final class HonorEuiccReadinessObserver extends Handler {
+    private static final int ICC_CHANGED=1, EID_READY=2;
+    private static final int PHONE=1, SLOT=1;
+    private final UiccController controller;
+    // Future qualified owner clears BEFORE EVERY mux dispatch (before dispatch admission/journal),
+    // and immediately on owner/card loss. Publish a new token ONLY after known EUICC completion
+    // plus post-completion fresh status, with no unresolved operation; never reuse a token.
+    // This is endpoint eligibility, not EID readiness. Raw owner generation() is not this fence.
+    private final AtomicReference<EuiccReadiness.Epoch> endpointFence;
+    private EuiccReadiness.Epoch epoch;
+    private EuiccReadiness state;
+    private EuiccCard watchedCard;
+    private boolean running;
+    private long revision;
+
+    HonorEuiccReadinessObserver(UiccController controller,
+            AtomicReference<EuiccReadiness.Epoch> endpointFence) {
+        super(controller.getLooper());
+        this.controller=controller;
+        this.endpointFence=java.util.Objects.requireNonNull(endpointFence);
+    }
+    private void requireThread() {
+        if (Looper.myLooper()!=getLooper()) throw new IllegalStateException("Controller thread required");
+    }
+    void start() {
+        requireThread();
+        if (running) throw new IllegalStateException("Already observing");
+        epoch=java.util.Objects.requireNonNull(endpointFence.get());
+        state=new EuiccReadiness(epoch);
+        running=true;
+        controller.registerForIccChanged(this,ICC_CHANGED,null);
+        observe();
+    }
+    void close() {
+        requireThread();
+        running=false;
+        if (state!=null) state.invalidate();
+        controller.unregisterForIccChanged(this);
+        if (watchedCard!=null) watchedCard.unregisterForEidReady(this);
+        watchedCard=null;
+        removeCallbacksAndMessages(null);
+    }
+    // Coordinator also posts close() when retiring the endpoint token; every read checks the fence.
+    private void observe() {
+        if (!running) return;
+        if (endpointFence.get()!=epoch) { close(); return; }
+        UiccCard current=controller.getUiccCardForPhone(PHONE);
+        EuiccCard card=current instanceof EuiccCard ? (EuiccCard)current : null;
+        if (state.retireIfCardChanged(endpointFence,watchedCard,card)) { close(); return; }
+        if (card!=watchedCard) {
+            state.invalidate();
+            if (watchedCard!=null) watchedCard.unregisterForEidReady(this);
+            watchedCard=card;
+            if (card!=null) card.registerForEidReady(this,EID_READY,card);
+        }
+        state.observe(read(),read());
+        if (endpointFence.get()!=epoch) close();
+    }
+    @Override public void handleMessage(Message message) {
+        requireThread();
+        if (!running) return;
+        if (message.what==EID_READY && (!(message.obj instanceof AsyncResult ar)
+                || ar.userObj!=watchedCard)) return; // Old card notification is not evidence.
+        if (message.what==ICC_CHANGED || message.what==EID_READY) {
+            EuiccReadiness.eventBoundary(()->{
+                if (revision==Long.MAX_VALUE) { close(); return; }
+                revision++; // Local observation generation, not a modem/card hardware counter.
+                state.invalidate();
+                observe();
+            },()->{
+                endpointFence.compareAndSet(epoch,null);
+                state.invalidate();
+                try { close(); } catch(RuntimeException ignored) {
+                    // close() already clears running/readiness before local unregistration.
+                }
+            });
+        }
+    }
+    /** Immediate pre-handoff recheck only; this is NOT a lasting authorization or hardware lock. */
+    boolean recheckReady() {
+        requireThread();
+        if (!running || endpointFence.get()!=epoch) { close(); return false; }
+        boolean ready=state.recheck(read(),read());
+        if (endpointFence.get()!=epoch) { close(); return false; }
+        return ready;
+    }
+    boolean matchesLeaseTarget(int slot,int port,int cardId) {
+        if (!recheckReady()) return false;
+        EuiccReadiness.Snapshot snapshot=read();
+        return snapshot!=null && snapshot.valid(epoch) && snapshot.physicalSlot==slot
+                && snapshot.portIndex==port && snapshot.publicCardId==cardId;
+    }
+    EuiccReadiness.Snapshot leaseSnapshot() {
+        return recheckReady() ? read() : null;
+    }
+    private EuiccReadiness.Snapshot read() {
+        if (endpointFence.get()!=epoch || controller.getUiccCardForPhone(PHONE)!=watchedCard) return null;
+        EuiccReadiness.Snapshot snapshot=readCurrent(controller,epoch,revision);
+        return endpointFence.get()==epoch ? snapshot : null;
+    }
+    static EuiccReadiness.Snapshot readCurrent(UiccController controller,EuiccReadiness.Epoch epoch,long revision) {
+
+        int slotIndex=controller.getSlotIdFromPhoneId(PHONE);
+        UiccSlot slot=controller.getUiccSlotForPhone(PHONE);
+        UiccCard card=controller.getUiccCardForPhone(PHONE);
+        UiccPort port=controller.getUiccPortForPhone(PHONE);
+        if (slot==null || !(card instanceof EuiccCard euicc)
+                || !(port instanceof EuiccPort))
+            return null;
+        int portIndex=port.getPortIdx();
+        String eid=euicc.getEid(); // Pure current-value getter. NO EuiccPort.getEid request.
+        int cardId=controller.convertToPublicCardId(eid); // Existing association only, no addCardId.
+        boolean associated=false;
+        for (UiccCardInfo info:controller.getAllUiccCardInfos()) {
+            if (!info.isEuicc() || info.getPhysicalSlotIndex()!=SLOT
+                    || info.getCardId()!=cardId || !java.util.Objects.equals(eid,info.getEid())) continue;
+            for (UiccPortInfo pi:info.getPorts()) {
+                if (pi.getPortIndex()==portIndex && pi.getLogicalSlotIndex()==PHONE && pi.isActive())
+                    associated=true;
+            }
+        }
+        boolean mapped=slotIndex==SLOT && slot.getUiccCard()==card
+                && controller.getUiccCardForSlot(SLOT)==card
+                && port.getPhoneId()==PHONE && slot.getPhoneIdFromPortIndex(portIndex)==PHONE
+                && controller.getPhoneIdFromSlotPortIndex(SLOT,portIndex)==PHONE
+                && card.getUiccPort(portIndex)==port && card.getUiccPortForPhone(PHONE)==port
+                && controller.getUiccPortForSlot(SLOT,portIndex)==port;
+        // isEuicc is current ATR-derived classification (UiccSlot.parseAtr/checkIsEuiccSupported).
+        boolean embedded=slot.isEuicc();
+        boolean active=slot.isActive() && slot.isPortActive(portIndex);
+        associated=associated && java.util.Objects.equals(eid,card.getCardId());
+        int defaultId=controller.getCardIdForDefaultEuicc();
+        return new EuiccReadiness.Snapshot(epoch,revision,slot,card,port,slotIndex,PHONE,portIndex,
+                cardId,defaultId,embedded,active,mapped,associated,eid);
+        }
+}
diff --git a/src/com/android/internal/telephony/honor/HonorImsDcBroadcastTransport.java b/src/com/android/internal/telephony/honor/HonorImsDcBroadcastTransport.java
