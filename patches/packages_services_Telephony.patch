+package com.android.internal.telephony.honor;
+public class TrialDispatchGateTest {
+ static int n;static void denied(Runnable r){try{r.run();}catch(IllegalStateException e){n++;return;}throw new AssertionError();}
+ public static void main(String[] args){
+  // Real production guard: queued baseline receipt after explicit timeout is denied.
+  var timeout=new TrialDispatchGate();timeout.start(100);timeout.stop();denied(()->timeout.check(101));denied(()->timeout.commitDispatch(102));
+  // Baseline queued BEFORE deadline, synchronous metadata returns AFTER it: no send.
+  var delayed=new TrialDispatchGate();delayed.start(100);delayed.check(101);denied(()->delayed.commitDispatch(10100));
+  // Deadline message not yet delivered; absolute time alone still prohibits dispatch.
+  var queue=new TrialDispatchGate();queue.start(100);denied(()->queue.commitDispatch(10101));
+  // One valid dispatch cannot be duplicated by second BASELINE callback.
+  var once=new TrialDispatchGate();once.start(100);once.check(101);once.commitDispatch(102);denied(()->once.commitDispatch(103));denied(()->once.start(104));
+  System.out.println("PASS production-dispatch-guard checks="+n+"; Android Handler/IPC execution not covered");
+ }
+}
