+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.List;
+
+/** Exercises the actual one shared matcher/removal lifecycle, not a second completion model. */
+public final class HonorCompletedCallRuntimeTest {
+    private static int checks;
+    private static void check(boolean value) {
+        checks++;
+        if (!value) throw new AssertionError("check " + checks);
+    }
+    private static HonorMtkCallInfoDecoder.CallUpdate call(int id, int domain, int status) {
+        ByteBuffer b = ByteBuffer.allocate(36).order(ByteOrder.LITTLE_ENDIAN);
+        for (int n : new int[] {101,1,id+1,0,domain,status,0,status==1010?34:0,1}) b.putInt(n);
+        return HonorMtkCallInfoDecoder.decode(0,1,1,b.array());
+    }
+    private static HonorCompletedSipDecoder.Update sip(int type, int code, String id,
+            String text) {
+        byte[] a=id.getBytes(StandardCharsets.UTF_8), c=text.getBytes(StandardCharsets.UTF_8);
+        ByteBuffer b=ByteBuffer.allocate(28+a.length+c.length).order(ByteOrder.LITTLE_ENDIAN);
+        for(int n:new int[]{100,1,type,code==0?0:1,code,a.length,c.length}) b.putInt(n);
+        return HonorCompletedSipDecoder.decode(0,1,1,b.put(a).put(c).array());
+    }
+    private static HonorCompletedSipDecoder.Update invite(String id) {
+        return sip(1,0,id,"INVITE\r\nTo: remote\r\n\r\nv=0\r\nm=application 9 UDP/DTLS/SCTP data");
+    }
+    private static HonorMtkCallInfoDecoder.CallUpdate end(int id,int reason) {
+        ByteBuffer b=ByteBuffer.allocate(36).order(ByteOrder.LITTLE_ENDIAN);
+        for(int n:new int[]{101,1,id+1,0,12,1010,0,reason,1})b.putInt(n);
+        return HonorMtkCallInfoDecoder.decode(0,1,1,b.array());
+    }
+    private static byte[] endBytes(int version,int sip,int emm,int rrc,int vdm) {
+        ByteBuffer b=ByteBuffer.allocate(24).order(ByteOrder.LITTLE_ENDIAN);
+        for(int n:new int[]{105,version,sip,emm,rrc,vdm})b.putInt(n);
+        return b.array();
+    }
+    public static void main(String[] args) throws Exception {
+        List<HonorCompletedCallQoe.Result> out=new ArrayList<>();
+        var s=new HonorCallQosSnapshot(0,4,5,out::add);
+        s.accept(call(1,12,1001),0,1,10000);
+        s.accept(invite("old"),1,2,10001);
+        s.accept(call(1,12,1010),10,3,10010);
+        check(out.isEmpty()&&s.nextRemovalTime()==1010);
+        s.retireCompletedCycle(3);
+        check(s.isPendingTerminalSip("old")&&s.current().isEmpty());
+        s.accept(sip(3,488,"old","UPDATE\r\nTo: remote"),11,4,10011);
+        check(out.isEmpty());
+        s.expire(1009);
+        check(out.isEmpty());
+        s.expire(1010);
+        check(out.size()==1&&out.get(0).function()==HonorCompletedCallQoe.Function.DC_ERROR);
+        check(out.get(0).recvUpdateCode()==488&&out.get(0).epoch().profile()==5);
