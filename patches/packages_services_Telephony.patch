+                if(cancelled.get() || channel==null || channel.scoped==null
+                        || !binding.channelActionAllowed(channel,close)
+                        || !state.channelAccess(scope,client,SystemClock.elapsedRealtime())) throw new IllegalStateException("Unowned channel");
+                java.util.concurrent.CompletableFuture<HonorLpaChannelResult> result=new java.util.concurrent.CompletableFuture<>();
+                if(close && channel.closed) {
+                    HonorLpaChannelResult reply=new HonorLpaChannelResult();reply.handle=id;reply.code=channel.closedCode;result.complete(reply);return result;
+                }
+                channel.actionStage=close ? Stage.CLOSE : Stage.APDU;
+                android.os.Message callback=channelCallback(scope,client,channel,result);
