+++ b/tests/host/com/android/internal/telephony/honor/HnCallPolicyJournalTest.java
@@ -0,0 +1,55 @@
+package com.android.internal.telephony.honor;
+import java.io.*;import java.util.*;
+public final class HnCallPolicyJournalTest {
+ static int checks;
+ static void check(boolean value,String name){checks++;if(!value)throw new AssertionError(name);}
+ interface Operation{void run()throws Exception;}
+ static void refused(Operation op,String name)throws Exception{try{op.run();throw new AssertionError(name);}catch(IOException expected){checks++;}}
+ static final class Store implements SepMuxJournal.Store {String value;boolean fail;int writes;Store(){}Store(String v){value=v;}public String read(){return value;}public void writeDurably(String v)throws IOException{writes++;if(fail)throw new IOException();value=v;}}
+ static Store[] stores(){return new Store[]{new Store(),new Store(),new Store()};}
+ static String grant(int slot){return "HNCALLMIG1 "+HnCallEventTransport.HASH+" "+HnCallPolicyMigration.ROLE+" "+slot+" "+"a".repeat(32)+" 100 OPEN\n";}
+ static HnCallPolicyJournal.Entry entry(int token,boolean release){return new HnCallPolicyJournal.Entry(token,!release,release,1,2,3,"a".repeat(64),1,1000,HnCallPolicyJournal.Stage.ENTERED);}
+ public static void main(String[] args)throws Exception{
+  Store g=new Store(),tokens=new Store();Store[] fs=stores();
+  refused(()->HnCallPolicyMigration.qualify(0,g,tokens,fs),"absence never bootstraps");
+  check(tokens.writes==0&&Arrays.stream(fs).allMatch(s->s.writes==0),"missing grant no writes");
+  g.value=grant(0);HnCallPolicyMigration.qualify(0,g,tokens,fs);
+  check(g.value.endsWith("USED\n"),"explicit grant consumed");
+  HnCallTokens serials=new HnCallTokens(tokens,0,false);
+  check(serials.allocate()==101,"explicit floor precedes first token");
+  HnCallPolicyMigration.qualify(0,g,tokens,fs);
+  check(new HnCallTokens(tokens,0,false).allocate()==102,"used grant never resets high-water");
+  Store wrong=new Store(grant(1));
+  refused(()->HnCallPolicyMigration.qualify(0,wrong,new Store(),stores()),"wrong slot");
+  Store reopened=new Store(grant(0));
+  refused(()->HnCallPolicyMigration.qualify(0,reopened,tokens,fs),"grant cannot replace policy history");
+  Store broken=new Store(grant(0)),freshTokens=new Store();Store[] partial=stores();partial[1].fail=true;
+  refused(()->HnCallPolicyMigration.qualify(0,broken,freshTokens,partial),"partial migration fails");
+  check(broken.value.endsWith("USED\n"),"partial migration cannot leave reusable grant");
+  partial[1].fail=false;
+  refused(()->HnCallPolicyMigration.qualify(0,broken,freshTokens,partial),"missing history after consumption never repaired automatically");
+  Store record=new Store(HnCallPolicyJournal.cleanRecord(0,2004));
+  HnCallPolicyJournal journal=new HnCallPolicyJournal(record,0,2004);
+  check(!journal.owned()&&!journal.uncertain(),"explicit clean policy history");
+  journal.enter(entry(103,false));
+  check(journal.uncertain(),"entered request fences");
+  HnCallPolicyJournal afterCrash=new HnCallPolicyJournal(record,0,2004);
+  check(afterCrash.uncertain(),"restart ENTERED remains uncertain");
+  refused(()->afterCrash.enter(entry(104,false)),"unknown cannot be overwritten");
+  journal.accepted(103);
+  check(journal.owned()&&!journal.uncertain(),"accepted logical intent is owned, not CP proof");
+  journal.enter(entry(104,true));journal.notSent(104);
+  check(journal.entry().token()==103,"proven unsent release preserves original owned intent");
+  journal.enter(entry(105,true));journal.unknown(105);
+  check(journal.uncertain(),"transport ambiguity retained");
+  refused(()->journal.accepted(999),"wrong token cannot clear ambiguity");
+  journal.accepted(105);
+  check(!journal.owned(),"exact late accepted release clears own intent only");
+  journal.enter(entry(106,false));record.fail=true;
+  refused(()->journal.accepted(106),"failed terminal persistence");
+  check(journal.uncertain(),"failed publication fail closed in VM");
+  refused(()->new HnCallPolicyJournal(new Store(record.value.replace("106 ","-1 ")),0,2004),"malformed range");
+  refused(()->new HnCallPolicyJournal(new Store(record.value),1,2004),"wrong slot provenance");
+  System.out.println("PASS "+checks+" actual policy journal/migration checks");
+ }
+}
