--- /dev/null
+++ b/src/com/android/internal/telephony/honor/MtkAssistVoipState.java
@@ -0,0 +1,100 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.internal.telephony.honor;
+
+import java.util.Arrays;
+
+/** The modem audio flag is global. Never reset the former DDS peer. */
+final class MtkAssistVoipState {
+    private final long[] bindings = new long[2];
+    private int[] subscriptions = new int[0];
+    private Object[] cards = new Object[0];
+    private int phone = -1, enabled, acknowledged = -1, failed = -1, serial;
+    private long topology, uncertainBinding;
+    private int uncertainSlot = -1;
+    private MtkAssistSyncState.Notification pending;
+
+    void topology(int[] subscriptions, Object[] cards) {
+        if (subscriptions.length != cards.length || subscriptions.length > 2)
+            throw new IllegalArgumentException("Invalid phone topology");
+        if (Arrays.equals(this.subscriptions, subscriptions) && Arrays.equals(this.cards, cards))
+            return;
+        this.subscriptions = subscriptions.clone();
+        this.cards = cards.clone();
+        invalidate();
+    }
+    void offer(int phone, int audioMode) {
+        int value = audioMode == 3 ? 1 : 0;
+        if (phone != this.phone || value != enabled) {
+            this.phone = phone;
+            enabled = value;
+            invalidate();
+        }
+    }
+    void invalidate() {
+        topology++;
+        acknowledged = failed = -1;
+        // Keep an already sent request serialized until its response or timeout.
+    }
+    void binding(int phone, long generation) {
+        if (phone < 0 || phone > 1) throw new IllegalArgumentException("Invalid phone");
+        if (bindings[phone] == generation) return;
+        bindings[phone] = generation;
+        if (pending != null && pending.slot() == phone) uncertain();
+        if (this.phone == phone) invalidate();
+    }
+    /** Only a new endpoint after confirmed originating Modem binder death can release the fence. */
+    void recovered(int phone, long generation) {
+        if (uncertainSlot == phone && bindings[phone] == generation
+                && generation > uncertainBinding) uncertainSlot = -1;
+    }
+    int recoveryPhone() { return uncertainSlot; }
+    MtkAssistSyncState.Notification next() {
+        if (uncertainSlot >= 0 || phone < 0 || phone >= subscriptions.length || bindings[phone] == 0
+                || pending != null || enabled == acknowledged || enabled == failed) return null;
+        return new MtkAssistSyncState.Notification(phone, MtkAssistSyncState.Kind.VOIP,
+                new int[]{enabled}, topology, bindings[phone]);
+    }
+    boolean begin(MtkAssistSyncState.Notification request, int serial) {
+        MtkAssistSyncState.Notification current = next();
+        if (serial <= 0 || current == null || request.kind() != current.kind()
+                || request.slot() != current.slot() || request.topology() != current.topology()
+                || request.binding() != current.binding()
+                || !Arrays.equals(request.values(), current.values())) return false;
+        pending = request;
+        this.serial = serial;
+        return true;
+    }
+    boolean response(int phone, long binding, int serial, int type, int error) {
+        return response(phone,binding,serial,type,error,true);
+    }
+    boolean response(int phone, long binding, int serial, int type, int error,boolean currentIdentity) {
+        if (pending == null || pending.slot() != phone || pending.binding() != binding
+                || this.serial != serial || (type != 0 && type != 1 && type != 2)) return false;
+        if (type == 1) return false;
+        if(!currentIdentity)invalidate(); // Drain the sent request without acknowledging the new profile.
+        complete(error == 0);
+        return true;
+    }
+    boolean timeout(int phone, long binding, int serial) {
+        if (pending == null || pending.slot() != phone || pending.binding() != binding
+                || this.serial != serial) return false;
+        uncertain();
+        return true;
+    }
+    private void uncertain() {
+        uncertainSlot = pending.slot();
+        uncertainBinding = pending.binding();
+        pending = null;
+    }
+    private void complete(boolean success) {
+        if (pending.topology() == topology && pending.slot() == phone
+                && pending.values()[0] == enabled) {
+            if (success) acknowledged = enabled;
+            else failed = enabled;
+        }
+        pending = null;
+    }
+}
