+    private boolean current(Session session) {
+        Phone[] current = PhoneFactory.getPhones();
+        if (current == null || session.slot >= current.length
+                || current[session.slot] != session.phone
+                || sessions[session.slot] != session || !usable(session.phone)
+                || session.phone.getSubId() != session.subId
+                || UiccController.getInstance().getUiccCardForPhone(session.slot) != session.card) {
+            return false;
+        }
+        Profile profile = profiles[session.slot];
+        if (profile == null || profile.generation != session.profileGeneration
+                || !identityMatches(profile, session.slot)) return false;
+        HnCallHardwareOwner.Snapshot source = hardware.barrier(session.slot);
+        return subscriberReady(session.slot) && source.ready()
+                && source.bindingGeneration() == session.bindingGeneration
+                && source.profileGeneration() == session.profileGeneration
+                && HonorRadioCommBroker.snapshot(session.slot).generation()
+                        == session.brokerGeneration;
+    }
+
+    private void apply(Session session, java.util.List<HonorCallQosSnapshot.Change> changes) {
+        if (!session.complete) return;
+        for (HonorCallQosSnapshot.Change change : changes) {
+            HonorCallQosPolicy.Decision decision = session.policy.onCallChanged(change.slot,
+                    change.callCount, change.emergency, change.domain, change.status);
+            if (decision != HonorCallQosPolicy.Decision.UNCHANGED) {
+                session.desired = decision == HonorCallQosPolicy.Decision.START;
+            }
+        }
+    }
+
+    private void scheduleRemoval(Session session) {
+        if (session.removal != null) handler.removeCallbacks(session.removal);
+        long deadline = session.cache.nextRemovalTime();
+        if (deadline == Long.MAX_VALUE) return;
+        session.removal = () -> {
+            if (!current(session)) return;
+            apply(session, session.cache.expire(SystemClock.elapsedRealtime()));
+            scheduleRemoval(session);
+            enqueue();
+        };
+        handler.postDelayed(session.removal,
+                Math.max(0, deadline - SystemClock.elapsedRealtime()));
+    }
+
+    private void sendLatest(Session session, HonorRadioCommBroker.Snapshot broker) {
+        if (!broker.ready() || !current(session) || unknownRequests[session.slot] != 0
+                || session.desired == null
+                || session.pending != 0 || session.deferred
+                || session.desired.equals(session.refusedVote)
+                || session.desired.equals(session.acknowledged)) return;
+        Profile profile = profiles[session.slot];
+        if (!session.desired && (profile == null || !profile.ownedStart)) return;
+        if (session.desired && (idle(session.phone) || session.unresolvedSip
+                || !session.orphanCalls.isEmpty())) return;
+        if (nextRequest == Long.MAX_VALUE) return; // Never wrap or reuse proof identities.
+        long token = nextRequest++;
+        boolean start = session.desired;
+        session.pending = token;
+        HonorRadioCommBroker.sendCallQos(session.slot, start, token, handler, result -> {
+            if (result.slot() != session.slot || result.requestToken() != token
+                    || session.pending != token) return;
+            session.pending = 0;
+            Profile originalProfile = profiles[session.slot];
+            boolean sameOwner = originalProfile != null
+                    && originalProfile.generation == session.profileGeneration
+                    && originalProfile.brokerGeneration == session.brokerGeneration
+                    && HonorRadioCommBroker.snapshot(session.slot).generation()
+                            == session.brokerGeneration;
+            if (sameOwner && result.outcome() == HonorRadioCommBroker.Outcome.ACKNOWLEDGED) {
+                originalProfile.ownedStart = start;
+            } else if (sameOwner && start
+                    && result.outcome() == HonorRadioCommBroker.Outcome.UNKNOWN) {
+                originalProfile.ownedStart = true; // Entered send may apply; ordering stays fenced.
+            }
+            if (result.outcome() == HonorRadioCommBroker.Outcome.UNKNOWN) {
+                unknownRequests[session.slot] = token;
+                session.acknowledged = null;
+                return;
+            }
+            if (unknownRequests[session.slot] == token
+                    && HonorRadioCommBroker.isCallQosDrained(session.slot, token)) {
+                unknownRequests[session.slot] = 0;
+            }
+            if (!current(session)) {
+                enqueue(); // Exact old final may drain ordering, never acknowledge successor state.
+                return;
+            }
+            if (result.outcome() == HonorRadioCommBroker.Outcome.ACKNOWLEDGED) {
+                session.acknowledged = start; // AP acknowledgement only; CP application is unknown.
+                session.refusedVote = null;
+                enqueue();
+            } else if (result.outcome() == HonorRadioCommBroker.Outcome.DEFERRED) {
+                session.deferred = true; // Proven not sent; wait for the broker readiness event.
+            } else {
+                session.refusedVote = start; // Terminal native/structural refusal of this intent.
+            }
+        });
+    }
