@@ -0,0 +1,70 @@
+package com.android.internal.telephony.honor;
+
+import java.io.IOException;
+
+/** Primary capability exclusion does not mutate the persistent LPA journal. */
+public final class PrimarySelectionLeaseHostTest {
+    private static final class Store implements SepMuxJournal.Store {
+        String value;
+        int writes;
+
+        public String read() {
+            return value;
+        }
+
+        public void writeDurably(String next) {
+            value = next;
+            writes++;
+        }
+    }
+
+    private static void require(boolean condition) {
+        if (!condition) throw new AssertionError();
+    }
+
+    private static void refused(Runnable action) {
+        try {
+            action.run();
+            throw new AssertionError("Expected refusal");
+        } catch (IllegalStateException expected) {
+        }
+    }
+
+    public static void main(String[] args) throws Exception {
+        Store store = new Store();
+        LpaOperationLease lease = new LpaOperationLease(store);
+        Object token = lease.beginPrimarySelection();
+        require(!lease.recoveryIdle());
+        require(lease.primarySelectionActive() && !lease.primarySelectionUnresolved());
+        refused(lease::requireRouteAllowed);
+        refused(lease::beginPrimarySelection);
+        refused(() -> lease.finishPrimarySelection(new Object(), true));
+        LpaOperationLease.Scope scope =
+                new LpaOperationLease.Scope(
+                        "00000000000000000000000000000001", 10055, 0, 1, 1, 0, 7, 2, 10);
+        refused(
+                () -> {
+                    try {
+                        lease.acquire(scope, new Object(), new Object(), 0, 100);
+                    } catch (IOException unexpected) {
+                        throw new AssertionError(unexpected);
+                    }
+                });
+        require(store.writes == 0 && store.value == null);
+        lease.finishPrimarySelection(token, false);
+        require(lease.primarySelectionActive() && lease.primarySelectionUnresolved());
+        refused(lease::requireRouteAllowed); // UNKNOWN is not cancellation or rollback proof.
+        require(store.writes == 0);
+        lease.finishPrimarySelection(token, true);
+        lease.requireRouteAllowed();
+        require(!lease.primarySelectionActive() && !lease.primarySelectionUnresolved());
+        require(lease.recoveryIdle());
+        Object next = lease.beginPrimarySelection();
+        refused(() -> lease.finishPrimarySelection(token, true));
+        lease.finishPrimarySelection(next, true);
+        lease.acquire(scope, new Object(), new Object(), 0, 100);
+        refused(lease::beginPrimarySelection);
+        require(store.writes == 1);
+        System.out.println("PrimarySelectionLeaseHostTest PASS");
+    }
+}
