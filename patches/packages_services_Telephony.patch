--- /dev/null
+++ b/tests/host/ldy_an00_esim/MtkSimSerialsTest.java
@@ -0,0 +1,80 @@
+package com.android.internal.telephony.honor;
+
+import java.io.IOException;
+import java.nio.file.Files;
+import java.util.HashSet;
+import java.util.concurrent.Executors;
+import java.util.concurrent.Future;
+import java.util.ArrayList;
+
+/** Production allocator with the existing real-file durable-store fixture, not Android storage. */
+public final class MtkSimSerialsTest {
+    private static int checks;
+    private interface Action { void run() throws Exception; }
+    private static void check(boolean value, String name) {
+        checks++;
+        if (!value) throw new AssertionError(name);
+    }
+    private static void refuses(Action action, String name) throws Exception {
+        checks++;
+        try { action.run(); } catch (IOException expected) { return; }
+        throw new AssertionError(name);
+    }
+    public static void main(String[] args) throws Exception {
+        var dir = Files.createTempDirectory("mtk-serials-");
+        var disk = new SepMuxJournalTest.Disk(dir.resolve("serials"));
+        refuses(() -> new MtkSimSerials(disk, false), "missing history needs caller qualification");
+        check(!Files.exists(disk.p) && disk.writes == 0, "refusal writes nothing");
+        var first = new MtkSimSerials(disk, true);
+        check(first.allocate() == 1 && disk.read().equals("MTKSEQ1 1\n"),
+                "first serial is published before return");
+        var reopened = new MtkSimSerials(disk, false); // Prior owner is retired; no counter reset.
+        check(reopened.allocate() == 2, "restart reserves a new wire identity");
+
+        var pool = Executors.newFixedThreadPool(2);
+        var futures = new ArrayList<Future<Integer>>();
+        try {
+            for (int i = 0; i < 40; i++) futures.add(pool.submit(reopened::allocate));
+            var serials = new HashSet<Integer>();
+            for (var future : futures) serials.add(future.get());
+            check(serials.size() == 40 && serials.contains(3) && serials.contains(42),
+                    "one-owner concurrent reservations are unique");
+        } finally { pool.shutdownNow(); }
+        check(new MtkSimSerials(disk, false).allocate() == 43,
+                "restart continues after all durable concurrent reservations");
+
+        for (int fault : new int[] {1, 3}) { // Before write and after durable publication.
+            Files.writeString(disk.p, "MTKSEQ1 7\n"); disk.fail = 0;
+            var failed = new MtkSimSerials(disk, false); disk.fail = fault;
+            int[] dispatches = {0};
+            refuses(() -> { failed.allocate(); dispatches[0]++; }, "failed reserve never dispatches");
+            check(dispatches[0] == 0, "no serial returned across failed publication");
+            disk.fail = 0;
+            refuses(failed::allocate, "uncertain allocator instance stays poisoned");
+            int next = new MtkSimSerials(disk, false).allocate();
+            check(next == (fault == 1 ? 8 : 9),
+                    "restart respects whichever durable record survived, skipping an uncertain reserve");
+        }
+        for (String record : new String[] {"", "MTKSEQ1 1", "MTKSEQ1 -1\n", "MTKSEQ1 0\n",
+                "MTKSEQ1 01\n", "MTKSEQ1 2147483648\n", "MTKSEQ1 99999999999999999999\n",
+                "MTKSEQ1 1\nextra", "MTKSEQ1 1\n\n", "MTKSEQ1  1\n", "OTHER 1\n"}) {
+            Files.writeString(disk.p, record);
+            refuses(() -> new MtkSimSerials(disk, true), "qualification never overrides corruption");
+        }
+        Files.writeString(disk.p, "MTKSEQ1 7\n"); disk.unreadable = true;
+        refuses(() -> new MtkSimSerials(disk, true), "unreadable history is not absent");
+        disk.unreadable = false;
+        Files.writeString(disk.p, "MTKSEQ1 2147483646\n");
+        var end = new MtkSimSerials(disk, false);
+        check(end.allocate() == Integer.MAX_VALUE, "last positive identity may be reserved");
+        int writes = disk.writes;
+        refuses(end::allocate, "exhausted allocator refuses instead of wrapping");
+        refuses(new MtkSimSerials(disk, false)::allocate, "restart cannot reset exhaustion");
+        check(disk.writes == writes && disk.read().equals("MTKSEQ1 2147483647\n"),
+                "exhaustion does not rewrite the record");
+        Files.delete(disk.p);
+        refuses(() -> new MtkSimSerials(disk, false), "lost history cannot reset without qualification");
+        System.out.println("PASS " + checks
+                + " serial checks; production allocator/real-file fixture, not Android durability proof");
+    }
+}
