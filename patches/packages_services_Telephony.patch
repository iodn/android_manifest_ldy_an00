+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.internal.telephony.honor;
+
+import android.content.Context;
+import android.content.pm.PackageManager;
+import android.os.BadParcelableException;
+import android.os.Binder;
+import android.os.Handler;
+import android.os.IBinder;
+import android.os.IInterface;
+import android.os.Parcel;
+import android.os.RemoteException;
+
+import java.util.NoSuchElementException;
+import java.util.Objects;
+import java.util.concurrent.atomic.AtomicBoolean;
+import java.util.concurrent.atomic.AtomicLong;
+import java.util.function.LongSupplier;
+
+/** Restricted hncall V1 transport. Never claims an hnradio callback. */
+final class HnCallEventTransport {
+    static final String SERVICE = "vendor.honor.hardware.hncall.IHnCall";
+    static final String CALLBACK = "vendor.honor.hardware.hncall.IHnCallCallback";
+    static final String HASH = "6fe3fc18096961a15d83a25140868467e2928dce";
+    private static final int GET_VERSION = 16777215, GET_HASH = 16777214;
+    private static final int MAX_REGISTRATION_EVENTS = 16;
+    private static final HnCallEventTransport[] OWNERS = new HnCallEventTransport[2];
+
+    record Event(int slot, long generation, long profileGeneration, long sequence,
+            int messageId, int version, byte[] payload) {
+        Event(int slot, long generation, int messageId, int version, byte[] payload) {
+            this(slot, generation, 0, 0, messageId, version, payload);
+        }
+        Event { payload = Objects.requireNonNull(payload).clone(); }
+        @Override public byte[] payload() { return payload.clone(); }
+    }
+    interface Listener {
+        void event(Event event);
+        void unavailable(int slot, long generation);
+        default void response(int slot, long generation, int token, int error, Event envelope) { }
+    }
+    static final class IncompatibleServiceException extends RemoteException {
+        IncompatibleServiceException(String message) { super(message); }
+    }
+    private final IBinder service;
+    private final int slot;
+    private final long generation;
+    private final Handler handler;
+    private final Listener listener;
+    private final LongSupplier profileGeneration;
+    private final AtomicLong observedSequence = new AtomicLong();
+    private final AtomicBoolean closed = new AtomicBoolean(), failed = new AtomicBoolean();
+    private final IBinder.DeathRecipient death = this::fail;
+    private final Endpoint callback = new Endpoint();
+    private volatile boolean attempted, registered, incompatible;
+    private boolean registering;
+    private final java.util.ArrayList<Event> registrationEvents = new java.util.ArrayList<>();
+
+    /** Metadata reads and register run on an owner connection worker, not the Phone looper. */
+    HnCallEventTransport(IBinder service, int slot, long generation, Handler handler,
+            Listener listener) throws RemoteException {
+        this(service, slot, generation, handler, listener, () -> 0);
+    }
+    HnCallEventTransport(IBinder service, int slot, long generation, Handler handler,
+            Listener listener, LongSupplier profileGeneration) throws RemoteException {
+        if (slot < 0 || slot > 1 || generation <= 0) throw new IllegalArgumentException();
+        this.service = Objects.requireNonNull(service);
+        this.slot = slot;
+        this.generation = generation;
+        this.handler = Objects.requireNonNull(handler);
+        this.listener = Objects.requireNonNull(listener);
+        this.profileGeneration = Objects.requireNonNull(profileGeneration);
+        if (!SERVICE.equals(service.getInterfaceDescriptor()) || version() != 1
+                || !HASH.equals(hash()))
+            throw new IncompatibleServiceException("Unsupported hncall interface");
+        service.linkToDeath(death, 0);
+    }
+    private int version() throws RemoteException {
+        Parcel input = Parcel.obtain(service), output = Parcel.obtain();
+        try {
+            input.writeInterfaceToken(SERVICE);
+            if (!service.transact(GET_VERSION, input, output, 0))
+                throw new IncompatibleServiceException("Missing hncall version");
+            output.readException();
+            return output.readInt();
+        } finally { input.recycle(); output.recycle(); }
+    }
+    private String hash() throws RemoteException {
+        Parcel input = Parcel.obtain(service), output = Parcel.obtain();
+        try {
+            input.writeInterfaceToken(SERVICE);
+            if (!service.transact(GET_HASH, input, output, 0))
+                throw new IncompatibleServiceException("Missing hncall hash");
+            output.readException();
+            return output.readString();
+        } finally { input.recycle(); output.recycle(); }
+    }
+    /**
+     * The caller must qualify source packaging: stock HnSystemServer/HnCollie and any other
+     * hncall owner are excluded. The package check and process slot claim supplement that proof;
+     * they do not provide a native compare-and-set against another process.
+     */
+    void register(Context context, boolean stockHostExcluded) throws RemoteException {
+        if (!stockHostExcluded) throw new IllegalStateException("Stock hncall owner not excluded");
+        try {
+            context.getPackageManager().getApplicationInfo("com.hihonor.systemserver", 0);
+            throw new IllegalStateException("Stock hncall host is installed");
+        } catch (PackageManager.NameNotFoundException expected) {
+            // Build ownership is also required because Collie may be a host-loaded plugin.
+        }
+        synchronized (OWNERS) {
+            if (attempted || failed.get() || closed.get() || OWNERS[slot] != null)
+                throw new IllegalStateException("hncall callback owner unavailable");
+            attempted = true;
+            registering = true;
+            OWNERS[slot] = this;
+        }
+        Parcel input = Parcel.obtain(service), output = Parcel.obtain();
+        try {
+            input.writeInterfaceToken(SERVICE);
+            input.writeStrongBinder(callback);
+            if (!service.transact(2, input, output, 0))
+                throw new RemoteException("hncall callback registration refused");
+            output.readException();
+            synchronized (OWNERS) {
+                if (closed.get() || failed.get()) throw new RemoteException("hncall owner retired");
+                registered = true;
+                for (Event event : registrationEvents) postEvent(event);
+                registrationEvents.clear();
+            }
+        } catch (RemoteException | RuntimeException error) {
+            fail();
+            throw error;
+        } finally {
+            input.recycle();
+            output.recycle();
+            synchronized (OWNERS) {
+                registering = false;
+                if (closed.get() || failed.get()) releaseClaim();
+            }
+        }
+    }
+    boolean healthy() { return registered && !closed.get() && !failed.get(); }
+    boolean incompatible() { return incompatible; }
+    long observedSequence() { return observedSequence.get(); }
+    /** Only reviewed native messages, explicit token, and stock LE32 setter shape. */
+    void request(int token, int messageId, boolean enabled) throws RemoteException {
+        if (token <= 0 || (messageId != 2003 && messageId != 2004
+                && messageId != 2005 && messageId != 2009))
+            throw new IllegalArgumentException("Unsupported hncall request");
+        synchronized (OWNERS) {
+            if (!healthy() || OWNERS[slot] != this)
+                throw new RemoteException("hncall owner unavailable");
+        }
+        Parcel input = Parcel.obtain(service);
+        try {
+            input.writeInterfaceToken(SERVICE);
+            input.writeInt(token);
+            input.writeInt(1); // Non-null stable HnCallInfo.
+            int start = input.dataPosition();
+            input.writeInt(0);
+            input.writeInt(messageId);
+            input.writeInt(1);
+            input.writeByteArray(messageId == 2003 ? new byte[0]
+                    : new byte[]{(byte) (enabled ? 1 : 0), 0, 0, 0});
+            int end = input.dataPosition();
+            input.setDataPosition(start);
+            input.writeInt(end - start);
+            input.setDataPosition(end);
+            if (!service.transact(1, input, null, IBinder.FLAG_ONEWAY))
+                throw new RemoteException("hncall request not accepted by Binder");
+        } finally { input.recycle(); }
+    }
+    private void releaseClaim() {
+        if (OWNERS[slot] == this) OWNERS[slot] = null;
+    }
+    void close() {
+        if (closed.compareAndSet(false, true)) {
+            unlink();
+            synchronized (OWNERS) {
+                registrationEvents.clear();
+                // Retain the reservation until a racing old registration RPC has returned.
+                if (!registering) releaseClaim();
+            }
+        }
+    }
+    private void unlink() {
+        try { service.unlinkToDeath(death, 0); }
+        catch (NoSuchElementException alreadyDead) { }
+    }
+    private void fail() {
+        if (!closed.get() && failed.compareAndSet(false, true)) {
+            unlink();
+            synchronized (OWNERS) {
+                registrationEvents.clear();
+                if (!registering) releaseClaim();
+            }
+            handler.post(() -> {
+                if (!closed.get()) listener.unavailable(slot, generation);
+            });
+        }
+    }
+    private void postEvent(Event event) {
+        handler.post(() -> {
+            if (healthy()) listener.event(event);
+        });
+    }
+    private void accept(Event event) {
+        synchronized (OWNERS) {
+            if (!attempted || closed.get() || failed.get()) return;
+            if (registered) {
+                postEvent(event);
+                return;
+            }
+            if (!registering) return;
+            if (registrationEvents.size() < MAX_REGISTRATION_EVENTS) {
+                registrationEvents.add(event);
+                return;
+            }
+        }
+        // Local registration buffering is finite. Fail the epoch rather than drop initial events.
+        fail();
+    }
+    private Event readEvent(Parcel input, boolean nullable, long profile, long sequence) {
+        int present = input.readInt();
+        if (present == 0 && nullable) return null;
+        if (present != 1) throw new BadParcelableException("Missing hncall event");
+        int start = input.dataPosition(), size = input.readInt();
+        if (size < 16 || size > input.dataSize() - start)
+            throw new BadParcelableException("Malformed hncall parcelable");
+        int end = start + size;
+        int messageId = input.readInt(), version = input.readInt();
+        int arrayStart = input.dataPosition(), length = input.readInt();
+        if (length == -1) {
+            input.setDataPosition(end);
+            return null;
+        }
+        if (length < 0 || length > end - input.dataPosition())
+            throw new BadParcelableException("Invalid hncall payload length");
+        input.setDataPosition(arrayStart);
+        byte[] payload = input.createByteArray();
+        if (payload == null || payload.length != length || input.dataPosition() > end)
+            throw new BadParcelableException("Truncated hncall payload");
+        input.setDataPosition(end);
+        return new Event(slot, generation, profile, sequence, messageId, version, payload);
+    }
+    private final class Endpoint extends Binder implements IInterface {
+        Endpoint() {
+            attachInterface(this, CALLBACK);
+            markVintfStability();
+        }
+        @Override public IBinder asBinder() { return this; }
+        @Override protected boolean onTransact(int code, Parcel input, Parcel output, int flags)
+                throws RemoteException {
+            if (code == INTERFACE_TRANSACTION) {
+                if (output != null) output.writeString(CALLBACK);
+                return true;
+            }
+            if (code == GET_VERSION || code == GET_HASH) {
+                input.enforceInterface(CALLBACK);
+                if (output == null) return false;
+                output.writeNoException();
+                if (code == GET_VERSION) output.writeInt(1);
+                else output.writeString(HASH);
+                return true;
+            }
+            if (code != 1 && code != 2) return super.onTransact(code, input, output, flags);
+            try {
+                input.enforceInterface(CALLBACK);
+                if ((flags & IBinder.FLAG_ONEWAY) == 0)
+                    throw new BadParcelableException("hncall callback must be one-way");
+                long receiptProfile = profileGeneration.getAsLong();
+                // Token replies are not call observations consumed by Core. Counting them here
+                // would strand its event-consumption quiescence fence after a read-only query.
+                long receiptSequence = code == 2 ? observedSequence.incrementAndGet() : 0;
+                int token = 0, error = 0;
+                if (code == 1) { token = input.readInt(); error = input.readInt(); }
+                Event event = readEvent(input, code == 1, receiptProfile, receiptSequence);
+                input.enforceNoDataAvail();
+                // Native token replies can drain their original command after logical retirement.
+                if (code == 1 && attempted) {
+                    final int requestToken = token, nativeError = error;
+                    handler.post(() -> listener.response(slot, generation,
+                            requestToken, nativeError, event));
+                }
+                // No response ACK exists in hncall V1. Never call an unrelated radio ACK.
+                if (code == 2 && event != null && event.version() == 1
+                        && (event.messageId() == 1 || event.messageId() == 2
+                                || event.messageId() == 1001
+                                || event.messageId() == 1002)) {
+                    accept(event);
+                }
+            } catch (BadParcelableException | SecurityException error) {
+                incompatible = true;
+                fail();
+            } catch (RuntimeException error) { fail(); }
+            return true;
+        }
+    }
+}
