@@ -0,0 +1,229 @@
+/* Copyright (C) 2026 The LineageOS Project. SPDX-License-Identifier: Apache-2.0 */
+package com.android.internal.telephony.honor;
+
+import java.util.ArrayDeque;
+import java.util.Set;
+import java.util.function.Consumer;
+
+/** Stock default-open evaluator. A decision is a vote, never evidence of modem application. */
+final class HonorImsDefaultOpenPolicy {
+    enum Feature { VOLTE, WFC }
+    enum Timer { REGISTER_MAX, REGISTER_RETRY, VOLTE_REOPEN, NO_CELLULAR }
+    enum Domain { VOLTE, WFC, CS }
+    enum Reason { REGISTER_TIMEOUT, REGISTER_PERMANENT, FIRST_CALL_ERROR,
+        CALL_RATE, NO_CELLULAR, RELEASE }
+    record Decision(Feature feature, boolean enabled, boolean release, Reason reason) { }
+    interface Timers { void arm(Timer timer, long delayMillis); void cancel(Timer timer); }
+    interface Memory {
+        boolean permanentlyClosedWfc();
+        void permanentlyCloseWfc();
+    }
+    /** Values are milliseconds after the stock XML parser's seconds-to-ms conversion. */
+    record Config(long registerMax, long registerRetry, long volteBlock, long noCellular,
+            Set<Integer> permanentRegistrationErrors) {
+        Config {
+            if (registerMax <= 0 || registerRetry <= 0 || volteBlock <= 0 || noCellular <= 0)
+                throw new IllegalArgumentException("Invalid evaluator timer");
+            permanentRegistrationErrors = Set.copyOf(permanentRegistrationErrors);
+        }
+        static Config stockBase() {
+            return new Config(600_000, 400_000, 180_000, 300_000,
+                    Set.of(403, 201000, 202000, 208027, 208028, 208032));
+        }
+    }
+    record NormalCodes(Set<Integer> reasonSip, Set<Integer> reasonQ850,
+            Set<Integer> reasonRelease, Set<Integer> sip, Set<Integer> modem) {
+        NormalCodes {
+            reasonSip = Set.copyOf(reasonSip); reasonQ850 = Set.copyOf(reasonQ850);
+            reasonRelease = Set.copyOf(reasonRelease); sip = Set.copyOf(sip);
+            modem = Set.copyOf(modem);
+        }
+        static NormalCodes stockBase() {
+            return new NormalCodes(Set.of(487, 1), Set.of(4, 27, 17, 127, 47, 18, 21, 1),
+                    Set.of(21), Set.of(487), Set.of(32));
+        }
+    }
+    /** Exact ConfigInfo.isNormalCall(Result) priority; absent snapshot differs from absent fields. */
+    static Boolean normalCall(HonorCompletedCallQoe.Result result, NormalCodes codes) {
+        if (result.endType() == HonorCompletedCallQoe.EndType.UNKNOWN) return null;
+        if (result.endType() == HonorCompletedCallQoe.EndType.NORMAL) return true;
+        var facts = result.causes();
+        if (facts == null || codes == null) return null;
+        Integer[] values = {facts.reasonSip(), facts.reasonQ850(), facts.reasonRelease(),
+                result.sipCode(), facts.modemCause()};
+        var lists = java.util.List.of(codes.reasonSip(), codes.reasonQ850(),
+                codes.reasonRelease(), codes.sip(), codes.modem());
+        for (int i = 0; i < values.length; i++)
+            if (values[i] != null && !lists.get(i).isEmpty()) return lists.get(i).contains(values[i]);
+        return true;
+    }
+    private record Sample(long at, Domain domain, boolean success) { }
+    private static final long DAY = 86_400_000L;
+    private final Config config;
+    private final Timers timers;
+    private final Memory memory;
+    private final Consumer<Decision> output;
+    private final ArrayDeque<Sample> history = new ArrayDeque<>();
+    private boolean volte, wfc, registeredVolte, registeredWfc, noCellularArmed, firstVolteCall = true;
+    private boolean permanentVolte, retryArmed, temporaryVolte;
+    private int cureCount;
+
+    HonorImsDefaultOpenPolicy(Config config, Timers timers, Memory memory,
+            Consumer<Decision> output) {
+        this.config = java.util.Objects.requireNonNull(config);
+        this.timers = java.util.Objects.requireNonNull(timers);
+        this.memory = java.util.Objects.requireNonNull(memory);
+        this.output = java.util.Objects.requireNonNull(output);
+    }
+    /** 100/101 are MBN lookup failures: they must not replace an existing round with OFF. */
+    void configuration(int type, boolean wfcPlatform) {
+        if (type == 100 || type == 101) return;
+        if (type < 0 || type > 3) throw new IllegalArgumentException("Invalid native report");
+        resetRound();
+        int effective = type == 1 && wfcPlatform ? 3 : type;
+        volte = (effective & 1) != 0;
+        wfc = (effective & 2) != 0 && !memory.permanentlyClosedWfc();
+        if (volte) timers.arm(Timer.REGISTER_MAX, config.registerMax());
+    }
+    void retire() {
+        resetRound();
+        history.clear();
+    }
+    private void resetRound() {
+        for (Timer timer : Timer.values()) timers.cancel(timer);
+        volte = wfc = registeredVolte = registeredWfc = noCellularArmed = permanentVolte
+                = retryArmed = temporaryVolte = false;
+        firstVolteCall = true;
+        cureCount = 0;
+    }
+    void registered(Feature feature) {
+        if (feature == Feature.WFC) {
+            if (wfc) registeredWfc = true;
+            return;
+        }
+        if (!volte) return;
+        registeredVolte = true;
+        retryArmed = false;
+        timers.cancel(Timer.REGISTER_MAX);
+        timers.cancel(Timer.REGISTER_RETRY);
+    }
+    void registrationFailed(Feature feature, int nativeError) {
+        if (nativeError < 0) return;
+        if (feature == Feature.WFC) {
+            if (wfc && !registeredWfc && config.permanentRegistrationErrors().contains(nativeError)) {
+                memory.permanentlyCloseWfc();
+                wfc = false;
+                output.accept(new Decision(Feature.WFC, false, false,
+                        Reason.REGISTER_PERMANENT));
+            }
+            return;
+        }
+        if (!volte || registeredVolte) return;
+        if (config.permanentRegistrationErrors().contains(nativeError)) {
+            closeVolte(Reason.REGISTER_PERMANENT);
+        } else if (!retryArmed && !permanentVolte) {
+            retryArmed = true;
+            timers.arm(Timer.REGISTER_RETRY, config.registerRetry());
+        }
+    }
+    void cellularService(boolean inService) {
+        if (!wfc) return;
+        if (inService) {
+            noCellularArmed = false;
+            timers.cancel(Timer.NO_CELLULAR);
+        } else if (!noCellularArmed) {
+            noCellularArmed = true;
+            timers.arm(Timer.NO_CELLULAR, config.noCellular());
+        }
+    }
+    void timer(Timer timer) {
+        switch (timer) {
+            case REGISTER_MAX, REGISTER_RETRY -> {
+                if (volte && !registeredVolte && !permanentVolte)
+                    closeVolte(Reason.REGISTER_TIMEOUT);
+            }
+            case VOLTE_REOPEN -> {
+                if (volte && temporaryVolte && !permanentVolte) {
+                    temporaryVolte = false;
+                    output.accept(new Decision(Feature.VOLTE, true, true, Reason.RELEASE));
+                }
+            }
+            case NO_CELLULAR -> {
+                if (wfc && noCellularArmed) output.accept(new Decision(Feature.WFC, true, false, Reason.NO_CELLULAR));
+            }
+        }
+    }
+    /** Unknown end reasons, emergency calls and other RAT-transition domains are excluded upstream. */
+    void completed(long now, Domain domain, boolean success, boolean temporaryFailure,
+            Integer wifiRssi) {
+        if (now < 0) throw new IllegalArgumentException("Invalid observation clock");
+        history.removeIf(sample -> sample.at() > now || now - sample.at() > 30 * DAY);
+        history.addLast(new Sample(now, domain, success));
+        if (domain == Domain.VOLTE && volte && firstVolteCall) {
+            firstVolteCall = false;
+            if (!success) closeVolte(Reason.FIRST_CALL_ERROR);
+        } else if (domain == Domain.VOLTE && volte && !success && temporaryFailure
+                && !permanentVolte && !temporaryVolte) {
+            evaluateVolte(now);
+        }
+        if (wfc && (domain != Domain.WFC || (!success && wifiRssi != null && wifiRssi >= -75)))
+            evaluateWfc(now);
+    }
+    private void evaluateVolte(long now) {
+        Double recent = rate(Domain.VOLTE, now, 30 * DAY, 10);
+        Double cs = rate(Domain.CS, now, 30 * DAY, Integer.MAX_VALUE);
+        if (recent == null) return;
+        int multiplier;
+        if (cs == null) {
+            Double historical = rate(Domain.VOLTE, now, 30 * DAY, Integer.MAX_VALUE);
+            if (cureCount != 0 && (historical == null || historical >= 80)) return;
+            multiplier = 1;
+        } else {
+            if (recent >= cs) return;
+            if (recent >= 90) multiplier = 1;
+            else if (recent >= 80) multiplier = 10;
+            else if (recent > 70) multiplier = 40;
+            else {
+                Double historical = rate(Domain.VOLTE, now, 30 * DAY, Integer.MAX_VALUE);
+                if (cureCount >= 5 && historical != null && historical <= 90) {
+                    closeVolte(Reason.CALL_RATE);
+                    return;
+                }
+                multiplier = 40;
+            }
+        }
+        cureCount++;
+        temporaryVolte = true;
+        output.accept(new Decision(Feature.VOLTE, false, false, Reason.CALL_RATE));
+        timers.arm(Timer.VOLTE_REOPEN, Math.multiplyExact(config.volteBlock(), multiplier));
+    }
+    private void evaluateWfc(long now) {
+        Double wifi = rate(Domain.WFC, now, 7 * DAY, Integer.MAX_VALUE);
+        Double lte = rate(Domain.VOLTE, now, 7 * DAY, Integer.MAX_VALUE);
+        Double cs = rate(Domain.CS, now, 7 * DAY, Integer.MAX_VALUE);
+        // A missing history is not a zero-percent success rate.
+        if (wifi == null || lte == null || cs == null) return;
+        if (wifi < 80 && (lte > 50 || cs > 50))
+            output.accept(new Decision(Feature.WFC, false, false, Reason.CALL_RATE));
+        if (wifi > 60 && lte < 30 && cs < 30)
+            output.accept(new Decision(Feature.WFC, true, false, Reason.CALL_RATE));
+    }
+    private Double rate(Domain domain, long now, long age, int limit) {
+        int total = 0, good = 0;
+        for (var iterator = history.descendingIterator(); iterator.hasNext() && total < limit;) {
+            Sample sample = iterator.next();
+            if (sample.domain() != domain || now - sample.at() > age) continue;
+            total++;
+            if (sample.success()) good++;
+        }
+        return total < 3 ? null : 100.0 * good / total;
+    }
+    private void closeVolte(Reason reason) {
+        if (permanentVolte) return;
+        permanentVolte = true;
+        timers.cancel(Timer.REGISTER_MAX);
+        timers.cancel(Timer.REGISTER_RETRY);
+        timers.cancel(Timer.VOLTE_REOPEN);
+        output.accept(new Decision(Feature.VOLTE, false, false, reason));
+    }
+}
