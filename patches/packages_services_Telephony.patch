+                        }
+                        if(scope.operation==7) {
+                            if(reply.code==HonorScopedApduChannel.OPENED) channel.logical=reply.channel;
+                            else if(reply.code==HonorScopedApduChannel.RESPONSE) binding.recoveryRead.response(reply.data);
+                        }
+                        if(reply.code==HonorScopedApduChannel.RETIRED && !state.resetReturned(scope,client,SystemClock.elapsedRealtime()))
