+/* Copyright (C) 2026 The LineageOS Project. SPDX-License-Identifier: Apache-2.0 */
+package com.android.internal.telephony.honor;
+
+import android.content.Context;
+import android.os.Handler;
+import android.os.HandlerThread;
+import android.os.IBinder;
+import android.os.IServiceCallback;
+import android.os.RemoteException;
+import android.os.ServiceManager;
+
+import java.io.IOException;
+import java.util.HashMap;
+import java.util.Map;
+import java.util.Objects;
+import java.util.concurrent.atomic.AtomicLong;
+import java.util.function.Consumer;
+
+/** One persistent hncall callback per slot; a logical call ending never closes this owner. */
+final class HnCallHardwareOwner {
+    private static final long REQUEST_TIMEOUT = 10_000;
+    record Snapshot(long bindingGeneration, long profileGeneration, long sequence, boolean ready) { }
+    record ObservedEvent(int slot, long bindingGeneration, long profileGeneration, long sequence,
+            int messageId, int version, byte[] payload) {
+        ObservedEvent { payload = payload.clone(); }
+        @Override public byte[] payload() { return payload.clone(); }
+    }
+    enum Outcome { QUERY_VALUE, QUERY_UNKNOWN_VALUE, NATIVE_ACCEPTED, SUBMITTED, NATIVE_ERROR, DEFERRED, UNKNOWN }
+    record Result(int slot, int token, int messageId, long bindingGeneration,
+            long profileGeneration, Outcome outcome, int nativeError, Integer value) { }
+    interface Listener {
+        void event(ObservedEvent event);
+        void unavailable(int slot, long bindingGeneration);
+        void changed(int slot);
+    }
+    @FunctionalInterface interface Wire { void run() throws RemoteException; }
+    /** Dispatch custody is required at the worker callsite, not only on the delivery looper. */
+    interface MutationAdmission {
+        boolean allows(int slot, int messageId, boolean enabled, Snapshot current);
+        boolean reserve(int slot, int token, int messageId, boolean enabled,
+                Snapshot current) throws IOException;
+        default boolean dispatch(int slot, int token, java.util.function.BooleanSupplier receiptCurrent, Wire wire)
+                throws IOException, RemoteException { return false; }
+        /** Atomically retires only a reservation whose native callsite was never entered. */
+        default boolean notEntered(int slot, int token) { return false; }
+        default void profileChanged(int slot, long generation, boolean qualified) {}
+        void terminal(Result result);
+        void unknown(Result result);
+        boolean uncertain(int slot);
+    }
+    interface Lookup {
+        IBinder find(int slot);
+        void watch(int slot, Consumer<IBinder> callback) throws RemoteException;
+    }
+    interface TokenFactory { HnCallTokens open(int slot) throws IOException; }
+    private static final class Connection {
+        final int slot;
+        final long generation;
+        final IBinder binder;
+        volatile HnCallEventTransport transport;
+        volatile boolean retired;
+        boolean connecting = true;
+        Connection(int slot, long generation, IBinder binder) {
+            this.slot = slot; this.generation = generation; this.binder = binder;
+        }
+    }
+    private static final class Pending {
+        final Connection connection;
+        final int token, messageId;
+        final boolean enabled;
+        final long profile;
+        final Consumer<Result> callback;
+        boolean notified;
+        volatile boolean entered;
+        Pending(Connection connection, int token, int messageId, boolean enabled, long profile,
+                Consumer<Result> callback) {
+            this.connection = connection; this.token = token; this.messageId = messageId;
+            this.enabled = enabled; this.profile = profile; this.callback = callback;
+        }
+    }
+    private static final class Slot {
+        final AtomicLong receiptProfile = new AtomicLong();
+        final Map<Integer, Pending> pending = new HashMap<>();
+        long generation, profile;
+        boolean qualified;
+        volatile Connection connection;
+        ObservedEvent configuration;
+        HnCallTokens tokens; // Only accessed on the connection worker.
+        boolean tokensFailed;
+    }
+    private final Context context;
+    private final Handler delivery, worker;
+    private final Listener listener;
+    private final Lookup lookup;
+    private final TokenFactory tokenFactory;
+    private final MutationAdmission mutations;
+    private final Slot[] slots = {new Slot(), new Slot()};
+    private boolean started, closed;
+
+    HnCallHardwareOwner(Context context, Handler delivery, Listener listener) {
+        this(context, delivery, listener, HnCallPolicyCustody.get(context));
+    }
+    private HnCallHardwareOwner(Context context, Handler delivery, Listener listener,
+            HnCallPolicyCustody custody) {
+        this(context, delivery, connectionWorker(), listener, new Lookup() {
+            @Override public IBinder find(int slot) {
+                return ServiceManager.checkService(HnCallEventTransport.SERVICE + "/slot" + (slot + 1));
+            }
+            @Override public void watch(int slot, Consumer<IBinder> callback) throws RemoteException {
+                ServiceManager.registerForNotifications(
+                        HnCallEventTransport.SERVICE + "/slot" + (slot + 1),
+                        new IServiceCallback.Stub() {
+                            @Override public void onRegistration(String name, IBinder binder) {
+                                callback.accept(binder);
+                            }
+                        });
+            }
+        }, custody::openTokens, custody);
+    }
+    HnCallHardwareOwner(Context context, Handler delivery, Handler worker, Listener listener,
+            Lookup lookup, TokenFactory tokenFactory, MutationAdmission mutations) {
+        this.context = Objects.requireNonNull(context);
+        this.delivery = Objects.requireNonNull(delivery);
+        this.worker = Objects.requireNonNull(worker);
+        this.listener = Objects.requireNonNull(listener);
+        this.lookup = Objects.requireNonNull(lookup);
+        this.tokenFactory = Objects.requireNonNull(tokenFactory);
+        this.mutations = mutations;
+    }
+    private static Handler connectionWorker() {
