+    }
+    static HonorCallQosController.QualifiedConfiguration config(long profile,long sequence,int type){return new HonorCallQosController.QualifiedConfiguration(0,1,profile,sequence,new HonorMtkImsDefaultOpenDecoder.Report(0,type),new MtkAssistProfile((int)profile));}
+    static HonorCompletedCallQoe.Result call(long profile,long cycle,HonorCompletedCallQoe.Domain d,HonorCompletedCallQoe.EndType e,boolean emergency){return new HonorCompletedCallQoe.Result(new HonorCompletedCallQoe.Epoch(0,1,profile,cycle),HonorCompletedCallQoe.Direction.MO,d,HonorCompletedCallQoe.Stage.CONNECTED,e,null,null,null,emergency,HonorCompletedCallQoe.Function.NONE);}
+    static void controller() {
+        Handler h=new Handler();Inputs i=new Inputs();Backend b=new Backend();
+        var c=new HonorImsDefaultOpenController(h,i,b,HonorImsDefaultOpenPolicy.Config.stockBase());
