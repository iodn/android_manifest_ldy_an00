+/* Copyright (C) 2026 The LineageOS Project. SPDX-License-Identifier: Apache-2.0 */
+package com.android.internal.telephony.honor;
+
+/** Exact production protocol and journal, synthetic clock/transport only. */
+public final class SharedSlotRouteTrialTest {
+    private static int checks;
+    private static void check(boolean value) {checks++;if(!value)throw new AssertionError("check "+checks);}
+    private static void refuses(Runnable action) {
+        try {action.run();}catch(IllegalStateException expected){checks++;return;}
+        throw new AssertionError("expected refusal");
+    }
+    private static SepMuxTrial.Evidence evidence() {
+        return new SepMuxTrial.Evidence(1001,"u:r:radio:s0",true,6,SepMuxTrial.VENDOR_HASH,true,true,true);
+    }
+    private static SepMuxTrial.Baseline physical() {return new SepMuxTrial.Baseline(1,9,true,true,false);}
+    private static SharedSlotRouteTrial started() {
+        var trial=new SharedSlotRouteTrial();
+        var command=trial.beginEuicc(evidence(),7,physical(),100);
+        check(command.slotIndex()==1 && command.serial()==7 && command.requestId()==1005
+                && command.payload().nData()==1 && command.payload().nDatas().length==0
+                && command.payload().strDatas().length==0 && command.payload().bytes().length==0
+                && command.payload().strData().isEmpty());
+        trial.markDispatched(101);return trial;
+    }
+    private static void completeNative(SharedSlotRouteTrial trial) {
+        trial.response(1,7,1005,0,0,102);trial.completion(1,1002,new int[]{1,0},103);
+    }
+    private static SharedSlotRouteTrial euicc() {
+        var trial=started();completeNative(trial);
+        var query=trial.queryRoute(1,104);
+        trial.routeResponse(query,9,1,0,0,1,1,0,105);
+        check(trial.state()==SharedSlotRouteTrial.State.EUICC_ROUTE_OBSERVED);
+        check(trial.canRequestPhysicalReturn()); // No card PRESENT/ATR/profile required here.
+        return trial;
+    }
+    private static void beginReturn(SharedSlotRouteTrial trial) {
+        var query=trial.beginPhysicalReturn(evidence(),9,8,2,500_000);
+        trial.routeResponse(query,9,2,0,0,1,1,0,500_001);
+        var command=trial.command(500_002);check(command.payload().nData()==0 && command.serial()==8);
+        trial.markDispatched(500_003);
+        trial.response(1,8,1005,0,0,500_004);
+        trial.completion(1,1002,new int[]{1,0},500_005);
+    }
+    private static final class Memory implements SepMuxJournal.Store {
+        String value;boolean fail;
+        public String read(){return value;}
+        public void writeDurably(String value)throws java.io.IOException {
+            if(fail)throw new java.io.IOException("disk");this.value=value;
+        }
+    }
+    public static void main(String[] args)throws Exception {
+        // Outbound needs a real physical SIM2 baseline, preserving this trial's bounded scope.
+        for(var baseline:new SepMuxTrial.Baseline[]{null,new SepMuxTrial.Baseline(0,9,true,true,false),
+                new SepMuxTrial.Baseline(1,0,true,true,false),new SepMuxTrial.Baseline(1,9,false,true,false),
+                new SepMuxTrial.Baseline(1,9,true,false,false),new SepMuxTrial.Baseline(1,9,true,true,true)}) {
+            refuses(()->new SharedSlotRouteTrial().beginEuicc(evidence(),7,baseline,100));
+        }
+        var early=started();refuses(()->early.queryRoute(1,102));
+        early.response(1,7,1005,0,0,103);refuses(()->early.queryRoute(1,104));
+        early.completion(1,1002,new int[]{1,0},105);
+        var token=early.queryRoute(1,106);refuses(()->early.queryRoute(2,107));
+        early.routeResponse(token,8,1,0,0,1,1,0,108);check(!early.phaseComplete());
+        early.routeResponse(token,9,2,0,0,1,1,0,109);check(!early.phaseComplete());
+        early.routeResponse(token,9,1,1,0,1,1,0,110);check(!early.phaseComplete());
+        early.routeResponse(token,9,1,2,0,1,1,0,111);check(early.phaseComplete());
+        // Final/completion order can differ. Neither one is sufficient on its own.
+        var order=started();order.completion(1,1002,new int[]{1,0},102);
+        refuses(()->order.queryRoute(1,103));order.response(1,7,1005,2,0,104);
+        var oq=order.queryRoute(1,105);order.routeResponse(oq,9,1,0,0,1,1,0,106);
+        check(order.canRequestPhysicalReturn());
+        // Unqualified fields or negative completion never become a clean journal.
+        for(int[] fields:new int[][]{{0,1,0},{1,0,0},{1,2,0},{1,1,1}}) {
+            var t=started();completeNative(t);var q=t.queryRoute(1,104);
+            t.routeResponse(q,9,1,0,0,fields[0],fields[1],fields[2],105);
+            check(t.state()==SharedSlotRouteTrial.State.UNKNOWN && !t.canRequestPhysicalReturn());
+        }
+        var bad=started();bad.completion(1,1002,new int[]{3,2},102);
+        check(bad.state()==SharedSlotRouteTrial.State.UNKNOWN);
+        var duplicate=started();completeNative(duplicate);duplicate.response(1,7,1005,0,6,104);
+        var dq=duplicate.queryRoute(1,105);duplicate.routeResponse(dq,9,1,0,0,1,1,0,106);
+        check(duplicate.phaseComplete()); // Known native early0/trailing6 first-final policy.
+        var timeout=started();completeNative(timeout);timeout.queryRoute(1,104);
+        check(timeout.deadlineMillis()==10_104);timeout.tick(10_104);
+        check(timeout.state()==SharedSlotRouteTrial.State.UNKNOWN);
+        // Return admission obtains NEW positive mode1; mode0/default0 cannot authorize SET.
+        var stale=euicc();refuses(()->stale.beginPhysicalReturn(evidence(),8,8,2,500_000));
+        var baseline=stale.beginPhysicalReturn(evidence(),9,8,2,500_000);
+        refuses(()->stale.command(500_001));
+        stale.routeResponse(baseline,9,2,0,0,1,0,0,500_002);
+        check(stale.state()==SharedSlotRouteTrial.State.UNKNOWN);
+        refuses(()->stale.command(500_003));
+        var lost=euicc();lost.transportLost();check(!lost.canRequestPhysicalReturn());
+        refuses(()->lost.beginPhysicalReturn(evidence(),9,8,2,500_000));
+        // Mode0 alone is insufficient; require a fresh physical card/controller receipt too.
+        for(boolean statusFirst:new boolean[]{false,true}) {
+            var trial=euicc();beginReturn(trial);
+            var rq=trial.queryRoute(3,500_006);var cq=trial.queryPhysicalCard(500_007);
+            if(statusFirst) trial.physicalCardStatus(cq,9,true,true,false,1,true,500_008);
+            trial.routeResponse(rq,9,3,0,0,1,0,0,500_009);
+            if(!statusFirst) {
+                check(!trial.phaseComplete());
+                trial.physicalCardStatus(cq,9,true,true,false,1,true,500_010);
+            }
+            check(trial.state()==SharedSlotRouteTrial.State.PHYSICAL_RESTORED);
+            check(!trial.canRequestPhysicalReturn());
+            refuses(()->trial.beginPhysicalReturn(evidence(),9,9,4,600_000));
+        }
+        for(int field=0;field<4;field++) {
+            var trial=euicc();beginReturn(trial);var rq=trial.queryRoute(3,500_006);
+            trial.routeResponse(rq,9,3,0,0,1,0,0,500_007);
+            var cq=trial.queryPhysicalCard(500_008);
+            trial.physicalCardStatus(cq,9,field!=0,field!=1,field==2,field==3?0:1,true,500_009);
+            if(field==3) {
+                check(trial.state()==SharedSlotRouteTrial.State.UNKNOWN);
+            } else {
+                check(trial.state()==SharedSlotRouteTrial.State.RECONCILING && !trial.phaseComplete());
+                var fresh=trial.queryPhysicalCard(500_010);
+                trial.physicalCardStatus(fresh,9,true,true,false,1,true,500_011);
+                check(trial.state()==SharedSlotRouteTrial.State.PHYSICAL_RESTORED);
+            }
+        }
+        var wrongEpoch=euicc();beginReturn(wrongEpoch);
+        var epochCard=wrongEpoch.queryPhysicalCard(500_006);
+        wrongEpoch.physicalCardStatus(epochCard,10,true,true,false,1,true,500_007);
+        check(wrongEpoch.state()==SharedSlotRouteTrial.State.UNKNOWN);
+        var absent=euicc();beginReturn(absent);var absentRoute=absent.queryRoute(3,500_006);
+        absent.routeResponse(absentRoute,9,3,0,0,1,0,0,500_007);
+        var absentCard=absent.queryPhysicalCard(500_008);
+        absent.physicalCardStatus(absentCard,9,false,false,false,1,false,500_009);
+        check(!absent.phaseComplete());absent.tick(860_003);
+        check(absent.state()==SharedSlotRouteTrial.State.UNKNOWN); // No late/automatic cleanup claim.
+        var wait=euicc();beginReturn(wait);var rq=wait.queryRoute(3,500_006);
+        wait.routeResponse(rq,9,3,0,0,1,0,0,500_007);
+        for(int i=0;i<3;i++) {
+            var cq=wait.queryPhysicalCard(500_008+i*2);
+            wait.physicalCardStatus(cq,9,true,true,false,1,false,500_009+i*2);
+        }
+        refuses(()->wait.queryPhysicalCard(500_015));check(!wait.phaseComplete());
+        // Durable PENDING precedes each SET; route proof can clean outbound without fake card.
+        var disk=new Memory();var journal=new SepMuxJournal(disk);var trial=euicc();
+        var wrongDisk=new Memory();var wrongJournal=new SepMuxJournal(wrongDisk);
+        wrongJournal.pending(9,7,SepMuxTrial.Selector.PHYSICAL);
+        try {wrongJournal.completedRoutePhase(9,7,trial);throw new AssertionError("wrong selector clean");}
+        catch(java.io.IOException expected){checks++;}
+        check(wrongDisk.value.startsWith("SEP1 PENDING "));
+        journal.pending(9,7,SepMuxTrial.Selector.EUICC);journal.completedRoutePhase(9,7,trial);
+        check(disk.value.equals("SEP1 CLEAN 9 7 1\n"));
+        beginReturn(trial);journal.pending(9,8,SepMuxTrial.Selector.PHYSICAL);
+        try {journal.completedRoutePhase(9,8,trial);throw new AssertionError("early clean");}
+        catch(java.io.IOException expected){checks++;}
+        var qr=trial.queryRoute(3,500_006);trial.routeResponse(qr,9,3,0,0,1,0,0,500_007);
+        var qc=trial.queryPhysicalCard(500_008);
+        trial.physicalCardStatus(qc,9,true,true,false,1,true,500_009);
+        journal.completedRoutePhase(9,8,trial);check(disk.value.equals("SEP1 CLEAN 9 8 0\n"));
+        check(new SepMuxJournal(disk).firstUnusedSerial()==9);
+        check(new SepMuxJournal(new Memory()).firstUnusedSerial()==1);
+        var exhausted=new Memory();exhausted.value="SEP1 CLEAN 9 2147483647 0\n";
+        try {new SepMuxJournal(exhausted).firstUnusedSerial();throw new AssertionError("exhausted serial");}
+        catch(java.io.IOException expected){checks++;}
+        var claim=new MtkSimCallbackOwner();Object probe=new Object();claim.claim(probe);
+        refuses(()->claim.claim(probe));refuses(()->claim.claim(new Object()));
+        refuses(()->new MtkSimCallbackOwner().claim(null));
+        System.out.println("SHARED_SLOT_ROUTE_HOST_OK checks="+checks);
+    }
+}
