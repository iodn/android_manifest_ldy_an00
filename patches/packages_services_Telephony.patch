@@ -0,0 +1,60 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.internal.telephony.honor;
+
+/** Exact management operation, not a slot-based persistent data preference. */
+final class HonorManagedDataExcursion {
+    private final Object owner;
+    private final long generation;
+    private final String nonce;
+    private final int outboundPhase;
+    private int returnPhase = -1;
+    private int observedPhase;
+    private boolean outboundKnown;
+    private boolean finished;
+
+    HonorManagedDataExcursion(Object owner, long generation, String nonce, int outboundPhase) {
+        if (owner == null || generation <= 0 || nonce == null
+                || !nonce.matches("[0-9a-f]{32}") || outboundPhase < 0
+                || outboundPhase == Integer.MAX_VALUE) {
+            throw new IllegalArgumentException("Invalid management scope");
+        }
+        this.owner = owner;
+        this.generation = generation;
+        this.nonce = nonce;
+        this.outboundPhase = outboundPhase;
+        observedPhase = outboundPhase;
+    }
+
+    boolean current(Object candidate, long epoch) {
+        return !finished && owner == candidate && generation == epoch;
+    }
+
+    boolean requestReturn(Object candidate, long epoch, String requestNonce, int phase) {
+        if (!current(candidate, epoch) || !nonce.equals(requestNonce) || !outboundKnown
+                || returnPhase != -1 || phase < outboundPhase + 1 || phase < observedPhase
+                || phase == Integer.MAX_VALUE) return false;
+        returnPhase = phase;
+        return true;
+    }
+
+    boolean observe(Object candidate, long epoch, String state, int phase) {
+        if (!current(candidate, epoch) || phase < observedPhase) return false;
+        observedPhase = phase;
+        if ("UNKNOWN".equals(state)
+                || !outboundKnown && phase > outboundPhase + 1
+                || returnPhase >= 0 && phase > returnPhase + 1) {
+            cancel();
+            return false;
+        }
+        if (("EUICC_READY".equals(state) || "KNOWN_BLANK".equals(state))
+                && phase == outboundPhase + 1) outboundKnown = true;
+        return returnPhase >= 0 && "PHYSICAL_READY".equals(state) && phase == returnPhase + 1;
+    }
+
+    void cancel() { finished = true; }
+
+    @Override public String toString() { return "HonorManagedDataExcursion"; }
+}
