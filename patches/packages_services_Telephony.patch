+package com.android.internal.telephony.honor;
+import com.android.internal.telephony.Phone;
+import com.android.internal.telephony.PhoneConstants;
+import com.android.internal.telephony.PhoneFactory;
+public final class HonorSimRouteCallGuardHostTest {
+ static int checks;
+ static void allow(){HonorSimRouteCallGuard.requireIdle();checks++;}
+ static void deny(){try{HonorSimRouteCallGuard.requireIdle();throw new AssertionError();}catch(IllegalStateException expected){checks++;}}
+ static void fresh(){PhoneFactory.unavailable=false;PhoneFactory.phones=new Phone[]{new Phone(),new Phone()};}
+ public static void main(String[] args) {
+  fresh();allow();
+  PhoneFactory.phones[0].state=PhoneConstants.State.OFFHOOK;
+  try{HonorSimRouteCallGuard.requireIdle();throw new AssertionError();}catch(HonorSimRouteCallGuard.CallBusy expected){checks++;}
+  fresh();PhoneFactory.phones[0].state=null;
+  try{HonorSimRouteCallGuard.requireIdle();throw new AssertionError();}
+  catch(HonorSimRouteCallGuard.CallBusy wrong){throw new AssertionError("Unknown is not confirmed busy");}
+  catch(IllegalStateException expected){checks++;}
+  for(int slot=0;slot<2;slot++)for(boolean ims:new boolean[]{false,true}) {
+   fresh();Phone target=PhoneFactory.phones[slot];
+   if(ims){target.ims=new Phone();target=target.ims;}allow();
+   for(PhoneConstants.State state:new PhoneConstants.State[]{PhoneConstants.State.RINGING,PhoneConstants.State.OFFHOOK}) {
+    target.state=state;deny();target.state=PhoneConstants.State.IDLE;allow();
+   } // OFFHOOK represents dialing/active/holding according to actual Phone API.
+   target.emergency=true;deny();target.emergency=false;
+   target.ecm=true;deny();target.ecm=false;
+   target.sms=true;deny();target.sms=false;
+   target.state=null;deny();target.state=PhoneConstants.State.IDLE;
+   target.unavailable=true;deny();target.unavailable=false;allow();
+  }
+  PhoneFactory.phones=null;deny();PhoneFactory.phones=new Phone[0];deny();
+  PhoneFactory.phones=new Phone[]{new Phone()};deny();
+  fresh();PhoneFactory.phones[0]=null;deny();fresh();PhoneFactory.phones[1]=null;deny();
+  fresh();PhoneFactory.unavailable=true;deny();PhoneFactory.unavailable=false;
+  fresh();PhoneFactory.phones=new Phone[]{new Phone(),new Phone(),new Phone()};
+  PhoneFactory.phones[2].state=PhoneConstants.State.OFFHOOK;deny();PhoneFactory.phones[2].state=PhoneConstants.State.IDLE;allow();
+  System.out.println("PASS "+checks+" actual production route call-guard host checks; no radio/call execution");
+ }
+}
