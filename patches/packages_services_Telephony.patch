+  reset();results=new ArrayList<>();prepare(7,0,10055,()->true,results);
+  check(results.equals(List.of(HonorEuiccEndpointPreparation.Result.NO_HISTORY)));
+  System.out.println("PASS "+checks+" actual registered-hook/Owner async checks; connector/platform boundaries doubled, no Android/modem proof");
+ }
