+ static int n;static void check(boolean b){n++;if(!b)throw new AssertionError("check"+n);}
+ public static void main(String[]a){var t=new AckTracker();
+  check(t.response(9,2)==AckTracker.Action.IGNORE); // Unknown2 must not ACK.
+  t.own(10);check(t.response(10,1)==AckTracker.Action.ACK_ONLY);
+  check(t.response(10,2)==AckTracker.Action.FINAL_AND_ACK); // ACK1 did not consume.
+  check(t.response(10,2)==AckTracker.Action.IGNORE); // Duplicate2 does not ACK twice.
+  t.own(11);check(t.response(11,0)==AckTracker.Action.FINAL);
+  check(t.response(11,2)==AckTracker.Action.IGNORE); // Early0/trailing6type2 no ACK.
+  t.own(12);check(t.response(12,9)==AckTracker.Action.INVALID);
+  check(t.response(12,2)==AckTracker.Action.FINAL_AND_ACK);
+  check(AckTracker.indicationNeedsAck(1));check(!AckTracker.indicationNeedsAck(0));
+  check(!AckTracker.indicationNeedsAck(2));
+  check(!AckTracker.forwardLateFinal(1));check(AckTracker.forwardLateFinal(0));
+  check(AckTracker.forwardLateFinal(2));check(!AckTracker.forwardLateFinal(9));
+  System.out.println("PASS ACK policy checks="+n+"; no Binder execution");
+ }
+}
