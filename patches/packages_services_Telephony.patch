+        } catch(IllegalArgumentException transitional) {return false;}
+    }
+    /** Previous cache values are hints, never a reason to discard validated fresh CI evidence. */
+    private static String previousHint(String value,boolean eid) {
+        try {return eid ? validEid(value) : canonical(value);}
+        catch(IllegalArgumentException transitional) {return null;}
+    }
+    private static String validEid(String value) {
+        if(!EuiccReadiness.validEid(value))throw new IllegalArgumentException("Unqualified eUICC identity");
+        return value;
+    }
+    private static String canonical(String value) {
+        if(value==null || value.isEmpty())return null;
+        String result=IccUtils.stripTrailingFs(value);HonorReconciliationCodec.requireIccid(result);return result;
+    }
+}
