+    /** Handler-confined completed events from the existing matched-call/removal lifecycle. */
+    static void addCompletedCallListener(
+            java.util.function.Consumer<HonorCompletedCallQoe.Result> listener) {
+        UiccController.getInstance().post(() -> completedListeners.add(
+                java.util.Objects.requireNonNull(listener)));
+    }
+
+    private void completedCall(HonorCompletedCallQoe.Result result) {
+        // Finish the cache mutation before consumers observe a completion or assess quiescence.
+        handler.post(() -> deliverCompletedCall(result));
+    }
+
+    private void deliverCompletedCall(HonorCompletedCallQoe.Result result) {
+        int slot = result.epoch().slot();
+        Profile profile = profiles[slot];
+        HnCallHardwareOwner.Snapshot source = hardware.barrier(slot);
+        if (profile == null || !profile.qualified || !identityMatches(profile, slot)
+                || !subscriberReady(slot) || !source.ready()
+                || profile.generation != result.epoch().profile()
+                || source.profileGeneration() != result.epoch().profile()
+                || source.bindingGeneration() != result.epoch().binding()) return;
+        for (var listener : java.util.List.copyOf(completedListeners)) listener.accept(result);
+    }
