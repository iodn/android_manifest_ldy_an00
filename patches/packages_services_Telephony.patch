index 0000000000000000000000000000000000000000..ebe148169232e7e8b37e02cfc9cf8cb46157d112
--- /dev/null
+++ b/src/com/android/internal/telephony/honor/HonorSepTrialOwner.java
@@ -0,0 +1,1200 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.internal.telephony.honor;
+import android.app.Application;
+import android.os.*;
+import android.os.Process;
+import com.android.internal.telephony.Phone;
+import com.android.internal.telephony.PhoneFactory;
+import com.android.internal.telephony.uicc.UiccController;
+import com.android.internal.telephony.euicc.HonorEuiccEndpointPreparation;
+import vendor.honor.hardware.hnradio.*;
+
+/** Single process-lifetime owner; invoked only by explicit debug Activity button. */
+public final class HonorSepTrialOwner extends Handler implements HonorSepTrialAdapter.Owner,
+        HonorSepTrialAdapter.ResultSink, MtkSimTypeTransport.Listener {
+    private static final String TAG="HonorSepTrial";
+    private static final int ICC=1, UNAVAILABLE=2, LEASE_BLANK=3, ADOPTION_CARD=4, RESTORE_CARD=5;
+    private static volatile HonorSepTrialOwner instance;
+    private static boolean prepareAttempted;
+    private static volatile String preparationStatus="not attempted";
+    public static HonorSepTrialOwner existingPreparedOwner() {
+        HonorSepTrialOwner o=instance;return o!=null && o.registered ? o : null;
+    }
+    public static String existingOwnerState() {return preparationStatus;}
+    public enum UiState { IDLE, WORKING, EUICC_WAITING, EUICC_READY, PHYSICAL_READY, KNOWN_BLANK, UNKNOWN }
+    public static final class UiSnapshot {
+        public final UiState state;
+        public final boolean canReturnPhysical;
+        public final int phaseSerial;
+        private UiSnapshot(UiState state,boolean canReturnPhysical,int phaseSerial) {
+            this.state=state;this.canReturnPhysical=canReturnPhysical;this.phaseSerial=phaseSerial;
+        }
+    }
+    /** Passive projection only. Never prepares an owner, allocates serials or queries a radio. */
+    public void requestUiSnapshot(java.util.function.Consumer<UiSnapshot> reply) {
+        Handler main=new Handler(Looper.getMainLooper());
+        post(()->{
+            LpaOperationLease.State lease=operationLeases.state();
+            SharedSlotRouteTrial.State route=adapter.uiRouteState();
+            SepMuxUiProjection.Phase phase=SepMuxUiProjection.project(alive && registered,uiRequestFailed,
