+root=Path(__file__).resolve().parents[2];prod=root/"src/com/android/internal/telephony/honor"
+text=(prod/"HonorSepTrialOwner.java").read_text()
+def body(signature):
+ start=text.index(signature);opening=text.index("{",start);end=opening+1;depth=1
+ while depth:
+  if text[end]=="{":depth+=1
+  elif text[end]=="}":depth-=1
+  end+=1
+ return text[start:end]
+parts=[body("    private enum RecoverySetupStage"),body("    private record RecoverySetupDiagnostic(")]
+start=text.index("    private static volatile RecoverySetupDiagnostic recoverySetupDiagnostic")
+parts.append(text[start:text.index(";",start)+1])
+parts += [body(sig)for sig in["    private static void recoverySetupStage(","    private static void recoverySetupFailure(","    public static String cachedRecoverySetup("]]
