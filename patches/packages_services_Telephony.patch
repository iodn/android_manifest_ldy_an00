new file mode 100644
index 0000000000000000000000000000000000000000..777812cbb0ee4b4bb7a6f6cdbdd9f3fb6d21b9d5
--- /dev/null
+++ b/src/com/android/internal/telephony/honor/PhysicalSimEvidence.java
@@ -0,0 +1,57 @@
+/* Copyright (C) 2026 The LineageOS Project. SPDX-License-Identifier: Apache-2.0 */
+package com.android.internal.telephony.honor;
+
+/** Actual physical-path observation. EMPTY never supplies fabricated PRESENT, ATR or EID. */
+final class PhysicalSimEvidence {
+    enum Card { ABSENT, PRESENT, RESTRICTED, ERROR, UNKNOWN }
+    enum Presence { PRESENT_PHYSICAL, EMPTY_PHYSICAL }
+    static final class Controller {
+        final Object slot,card;
+        final int mappedSlot,phoneAtPort,portAtPhone,radioState;
+        final Card state;
+        final boolean unknown,active,portActive,euicc,radioAvailable;
+        Controller(Object slot,Object card,int mappedSlot,int phoneAtPort,int portAtPhone,
+                int radioState,Card state,boolean unknown,boolean active,boolean portActive,
+                boolean euicc,boolean radioAvailable) {
+            this.slot=slot;this.card=card;this.mappedSlot=mappedSlot;this.phoneAtPort=phoneAtPort;
+            this.portAtPhone=portAtPhone;this.radioState=radioState;this.state=state;
+            this.unknown=unknown;this.active=active;this.portActive=portActive;this.euicc=euicc;
+            this.radioAvailable=radioAvailable;
+        }
+        private boolean valid() {
+            return slot!=null && mappedSlot==1 && phoneAtPort==1 && portAtPhone==0
+                    && !unknown && active && portActive && radioAvailable && state!=null;
+        }
+        boolean sameObservation(Controller other) {
+            return other!=null && slot==other.slot && card==other.card
+                    && mappedSlot==other.mappedSlot && phoneAtPort==other.phoneAtPort
+                    && portAtPhone==other.portAtPhone && radioState==other.radioState && state==other.state
+                    && unknown==other.unknown && active==other.active && portActive==other.portActive
+                    && euicc==other.euicc && radioAvailable==other.radioAvailable;
+        }
+        private boolean same(Controller other) {
+            return other!=null && valid() && other.valid() && sameObservation(other);
+        }
+        boolean knownPhysical() {
+            return valid() && (state==Card.ABSENT && card==null
+                    || (state==Card.PRESENT || state==Card.RESTRICTED) && card!=null && !euicc);
+        }
+    }
+    final long generation;
+    final int slot,port;
+    final Presence presence;
+    private PhysicalSimEvidence(long generation,int slot,int port,Presence presence) {
+        this.generation=generation;this.slot=slot;this.port=port;this.presence=presence;
+    }
+    static PhysicalSimEvidence observe(long generation,Card ci,int slot,int port,boolean validAtr,
+            boolean euiccAtr,Controller first,Controller second) {
+        if(generation<=0 || slot!=1 || port!=0 || ci==null || first==null || !first.same(second)) return null;
+        if(ci==Card.ABSENT && first.state==Card.ABSENT && first.card==null)
+            return new PhysicalSimEvidence(generation,slot,port,Presence.EMPTY_PHYSICAL);
+        if((ci==Card.PRESENT || ci==Card.RESTRICTED) && first.state==ci && first.card!=null
+                && !first.euicc && validAtr && !euiccAtr)
+            return new PhysicalSimEvidence(generation,slot,port,Presence.PRESENT_PHYSICAL);
+        return null;
+    }
+    @Override public String toString(){return "PhysicalSimEvidence["+presence+"]";}
+}
diff --git a/src/com/android/internal/telephony/honor/RecoverySimPower.java b/src/com/android/internal/telephony/honor/RecoverySimPower.java
new file mode 100644
index 0000000000000000000000000000000000000000..eca05f8ebba5a1c8a2cab9fa2a8791ce9dbe4d74
--- /dev/null
+++ b/src/com/android/internal/telephony/honor/RecoverySimPower.java
@@ -0,0 +1,58 @@
+/* Copyright (C) 2026 The LineageOS Project. SPDX-License-Identifier: Apache-2.0 */
+package com.android.internal.telephony.honor;
+
+/** Recovery-only standard SIM power barrier. No selector completion is manufactured. */
+final class RecoverySimPower {
+    enum Phase { BASELINE, DOWN, EMPTY, UP, ROUTE, CARD, READY, UNKNOWN }
+    static final class Proof {
+        final long generation;
+        final int serial;
+        private Proof(long generation,int serial) {this.generation=generation;this.serial=serial;}
+    }
+    final long generation, deadline;
+    final int serial;
+    private Phase phase=Phase.BASELINE;
+    private String baselineEid;
+    RecoverySimPower(long generation,int serial,long now) {
+        if(generation<=0 || serial<=0 || now<0 || now>Long.MAX_VALUE-30_000)
+            throw new IllegalArgumentException("Invalid recovery power identity");
+        this.generation=generation;this.serial=serial;deadline=now+30_000;
+    }
+    Phase phase() {return phase;}
+    private void require(Phase expected,long epoch,long now) {
+        if(phase!=expected || epoch!=generation || now<deadline-30_000 || now>=deadline) {
+            phase=Phase.UNKNOWN;throw new IllegalStateException("Stale recovery power phase");
+        }
+    }
+    void baseline(long epoch,int slot,int port,boolean genuineEuicc,String eid,long now) {
+        require(Phase.BASELINE,epoch,now);
+        if(slot!=1 || port!=0 || !genuineEuicc || !EuiccReadiness.validEid(eid)) {fail();throw new IllegalStateException("Wrong power target");}
+        baselineEid=eid;phase=Phase.DOWN;
+    }
+    void powerCompleted(long epoch,Phase expected,boolean accepted,long now) {
+        require(expected,epoch,now);
+        if(!accepted || (expected!=Phase.DOWN && expected!=Phase.UP)) {
+            fail();throw new IllegalStateException("Power completion unqualified");
+        }
+        phase=expected==Phase.DOWN ? Phase.EMPTY : Phase.ROUTE;
+    }
+    void poweredDown(long epoch,int slot,int port,int applications,long now) {
+        require(Phase.EMPTY,epoch,now);
+        // Android specifies empty applications, not CARDSTATE_ABSENT, after POWER_DOWN.
+        if(slot!=1 || port!=0 || applications!=0) {fail();throw new IllegalStateException("Card not powered down");}
+        phase=Phase.UP;
+    }
+    void route(long epoch,boolean freshModeOne,long now) {
+        require(Phase.ROUTE,epoch,now);
+        if(!freshModeOne) {fail();throw new IllegalStateException("Recovery route not observed");}
+        phase=Phase.CARD;
+    }
+    Proof finish(SepMuxRouteAdoption.Proof card,String eid,long now) {
+        require(Phase.CARD,card==null ? -1 : card.generation,now);
+        if(card.lastSetterSerial!=0 || card.observationSerial<=0 || !baselineEid.equals(eid)) {
+            fail();throw new IllegalStateException("Fresh observed card required");
+        }
+        phase=Phase.READY;return new Proof(generation,serial);
+    }
+    void fail() {phase=Phase.UNKNOWN;}
+}
diff --git a/src/com/android/internal/telephony/honor/SepMuxAdmission.java b/src/com/android/internal/telephony/honor/SepMuxAdmission.java
new file mode 100644
index 0000000000000000000000000000000000000000..6c27edc241116adf5a9e22e1342f6be41a4c38c3
--- /dev/null
+++ b/src/com/android/internal/telephony/honor/SepMuxAdmission.java
@@ -0,0 +1,32 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.internal.telephony.honor;
+
+/** Captured mode for one owner. Test consent never substitutes for ownership evidence. */
+final class SepMuxAdmission {
+    private final boolean trustedDebug, enforcingAtConsent;
+    private boolean invalidated;
+    private SepMuxAdmission(boolean trustedDebug, boolean enforcing) {
+        this.trustedDebug=trustedDebug;this.enforcingAtConsent=enforcing;
+    }
+    static SepMuxAdmission strict() { return new SepMuxAdmission(false,true); }
+    static SepMuxAdmission afterConsent(String buildType,boolean debuggable,boolean imageOptIn,
+            boolean trustedDebugConsent,boolean enforcing) {
+        if(!"userdebug".equals(buildType))
+            throw new IllegalStateException("Requires userdebug image");
+        if(trustedDebugConsent) {
+            if(!debuggable || !imageOptIn)
+                throw new IllegalStateException("Trusted-debug test image not enabled");
+            return new SepMuxAdmission(true,enforcing);
+        }
+        SepMuxAdmission strict=strict();strict.require(enforcing);return strict;
+    }
+    boolean isTrustedDebug() { return trustedDebug; }
+    synchronized void require(boolean enforcing) {
+        if(enforcing!=enforcingAtConsent) invalidated=true;
+        if(invalidated)
+            throw new IllegalStateException("SELinux mode changed; owner no longer qualified");
+    }
+}
diff --git a/src/com/android/internal/telephony/honor/SepMuxJournal.java b/src/com/android/internal/telephony/honor/SepMuxJournal.java
new file mode 100644
index 0000000000000000000000000000000000000000..7ea7fa7aca205b10566ecc06499ed0de2c6cc08a
--- /dev/null
+++ b/src/com/android/internal/telephony/honor/SepMuxJournal.java
@@ -0,0 +1,145 @@
+/* Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0 */
+package com.android.internal.telephony.honor;
+
+import java.io.IOException;
+
+/** One owner-thread journal. Missing means never used, not proof of global modem cleanliness. */
+public final class SepMuxJournal {
+    public interface Store {
+        String read() throws IOException; // null ONLY for definitely absent storage.
+        void writeDurably(String record) throws IOException;
+    }
+    private final Store store;
+    private String record;
+    private boolean failed;
+    private long generation;
+    private int serial;
+    private LpaRecoveryFence recovery;
+    private boolean recoveryPending;
+    public SepMuxJournal(Store store) throws IOException {
+        this(store,null,false);
+    }
+    private SepMuxJournal(Store store,LpaRecoveryFence recovery,boolean inspection) throws IOException {
+        this.recovery=recovery;this.store=store; record=store.read();
+        if(record!=null && !record.matches("SEP1 (CLEAN|PENDING|UNKNOWN) [1-9][0-9]* [1-9][0-9]* [01]\\n"))
+            throw new IOException("Corrupt SEP journal");
+        if(record!=null) {
+            String[] fields=record.trim().split(" ");
+            try {
+                if(Long.parseLong(fields[2])<=0 || Integer.parseInt(fields[3])<=0)
+                    throw new NumberFormatException();
+            } catch(NumberFormatException e) {throw new IOException("Corrupt SEP epoch identity",e);}
+        }
+        if(!inspection) requireClean();
+    }
+    public void requireClean() throws IOException {
+        if(failed || (record!=null && !record.startsWith("SEP1 CLEAN ")))
+            throw new IOException("Unresolved SEP epoch; registration/dispatch refused");
+    }
+    static String recoveryState(Store store) throws IOException {
+        SepMuxJournal history=new SepMuxJournal(store,null,true);
+        return history.record==null ? "ABSENT" : history.record.trim().split(" ")[1];
+    }
+    static boolean unresolvedHistory(Store store) throws IOException {
+        String state=recoveryState(store);
+        return state.equals("PENDING") || state.equals("UNKNOWN");
+    }
+    static SepMuxJournal forRecovery(Store store,LpaRecoveryFence ticket) throws IOException {
+        ticket.requireRunning();
+        return new SepMuxJournal(store,ticket,true);
+    }
+    void requireRecoveryStart(LpaRecoveryFence ticket) throws IOException {
+        ticket.requireRunning();
+        if(recovery!=ticket) requireClean();
+        else if(failed || recoveryPending) throw new IOException("Recovery route already attempted");
+    }
+    static final class CleanRoute {
+        final long generation;
+        final int serial;
+        final SepMuxTrial.Selector target;
+        private CleanRoute(long generation,int serial,SepMuxTrial.Selector target) {
+            this.generation=generation;this.serial=serial;this.target=target;
+        }
+    }
+    /** Historical completed route only; absence is not a route adoption certificate. */
+    CleanRoute cleanRoute() throws IOException {
+        requireClean();
+        if(record==null) return null;
+        String[] fields=record.trim().split(" ");
+        return new CleanRoute(Long.parseLong(fields[2]),Integer.parseInt(fields[3]),
+                "1".equals(fields[4]) ? SepMuxTrial.Selector.EUICC : SepMuxTrial.Selector.PHYSICAL);
+    }
+    /** A setter serial is journaled before dispatch; clean history fences late older finals. */
+    public int firstUnusedSerial() throws IOException {
+        if(recovery==null) requireClean();
+        else {recovery.requireRunning();if(failed) throw new IOException("Recovery journal failed");}
+        if(record==null) return 1;
+        int previous=Integer.parseInt(record.trim().split(" ")[3]);
+        if(previous==Integer.MAX_VALUE) throw new IOException("SEP serial identities exhausted");
+        return previous+1;
+    }
+    /** Must return successfully before ANY setter dispatch can occur. */
+    public void pending(long generation,int serial,SepMuxTrial.Selector target) throws IOException {
+        if(recovery==null) requireClean();
+        else {
+            recovery.requireRunning();
+            if(failed || recoveryPending || serial<firstUnusedSerial() || target!=SepMuxTrial.Selector.EUICC)
+                throw new IOException("Recovery requires one new persisted serial");
+            recoveryPending=true;
+        }
+        if(generation<=0 || serial<=0 || target==null) throw new IOException("Invalid SEP epoch");
+        this.generation=generation;this.serial=serial;
+        write("SEP1 PENDING "+generation+" "+serial+" "+target.wire+"\n");
+    }
+    /** No EID/LPA requirement: known physical return remains a separate operation. */
+    public void completed(long generation,int serial,SepMuxTrial outcome) throws IOException {
+        if(recovery!=null) throw new IOException("Recovery requires fresh route readback");
+        if(failed || record==null || !record.startsWith("SEP1 PENDING ")
+                || this.generation!=generation || this.serial!=serial
+                || outcome==null || !outcome.completionMatches(generation,serial))
+            throw new IOException("Unqualified SEP completion");
+        write(record.replace("PENDING","CLEAN"));
+    }
+    /** Bounded shared-slot route proof; eUICC mode1 alone never publishes LPA/EID readiness. */
+    public void completedRoutePhase(long generation,int serial,SharedSlotRouteTrial outcome) throws IOException {
+        if(failed || record==null || !record.startsWith("SEP1 PENDING ")
+                || this.generation!=generation || this.serial!=serial
+                || outcome==null || !outcome.completionMatches(generation,serial,
+                        Integer.parseInt(record.trim().split(" ")[4])))
+            throw new IOException("Unqualified SEP route completion");
+        write(record.replace("PENDING","CLEAN"));
+        recovery=null;
+    }
+    /** A real standard power cycle plus fresh card proof, distinct from OEM setter completion. */
+    void completedRecoveryPower(LpaRecoveryFence ticket,RecoverySimPower.Proof proof) throws IOException {
+        ticket.requireRunning();
+        if(recovery!=ticket || !recoveryPending || failed || proof==null
+                || record==null || !record.startsWith("SEP1 PENDING ")
+                || generation!=proof.generation || serial!=proof.serial
+                || !record.trim().endsWith(" 1"))
+            throw new IOException("Unqualified recovery power completion");
+        write(record.replace("PENDING","CLEAN"));
+        recovery=null;
+    }
+    /** Retain the serial floor and the positively observed PREVIOUS selector, never requested success. */
+    void neverSent(SharedSlotRouteTrial.NeverSent proof) throws IOException {
+        if(recovery!=null || failed || proof==null || record==null || !record.startsWith("SEP1 PENDING ")
+                || generation!=proof.generation || serial!=proof.serial
+                || !record.trim().endsWith(" "+proof.requested.wire) || proof.previous==proof.requested)
+            throw new IOException("Unqualified never-sent reservation");
+        write("SEP1 CLEAN "+generation+" "+serial+" "+proof.previous.wire+"\n");
+    }
+    public void unknown(long generation,int serial) throws IOException {
+        if(failed) throw new IOException("SEP journal failed");
+        if(record!=null && record.startsWith("SEP1 PENDING ")
+                && this.generation==generation && this.serial==serial)
+            write(record.replace("PENDING","UNKNOWN"));
+    }
+    private void write(String value) throws IOException {
+        // Poison memory BEFORE I/O. Any failure must forbid further dispatch in this process.
+        failed=true;
+        store.writeDurably(value);
+        record=value;failed=false;
+    }
+}
diff --git a/src/com/android/internal/telephony/honor/SepMuxRouteAdoption.java b/src/com/android/internal/telephony/honor/SepMuxRouteAdoption.java
new file mode 100644
index 0000000000000000000000000000000000000000..eb97f2ff1b5198a548709afd1d6db96f0592ab31
--- /dev/null
+++ b/src/com/android/internal/telephony/honor/SepMuxRouteAdoption.java
@@ -0,0 +1,69 @@
+/* Copyright (C) 2026 The LineageOS Project. SPDX-License-Identifier: Apache-2.0 */
+package com.android.internal.telephony.honor;
+
+/** Fresh owned route/card readback. A READ never becomes historical selector completion. */
+final class SepMuxRouteAdoption {
+    enum State { ROUTE, CARD, PHYSICAL, READY, UNKNOWN }
+    static final class Proof {
+        final long generation;
+        final int lastSetterSerial, observationSerial;
+        final EuiccReadiness.Epoch endpoint;
+        private Proof(long generation,int setter,int observed,EuiccReadiness.Epoch endpoint) {
+            this.generation=generation;lastSetterSerial=setter;observationSerial=observed;this.endpoint=endpoint;
+        }
+    }
+    final long generation;
+    long deadline;
+    private final long startedAt;
+    final int querySerial;
+    final EuiccReadiness.Epoch endpoint;
+    private final SepMuxJournal.CleanRoute history;
+    final MtkSimTypeQuery query;
+    private State state=State.ROUTE;
+    SepMuxRouteAdoption(SepMuxJournal.CleanRoute history,long generation,int querySerial,long now) {
+        if(history!=null && history.target!=SepMuxTrial.Selector.EUICC || generation<=0
+                || querySerial<=0 || now<0 || now>Long.MAX_VALUE-SharedSlotRouteTrial.ROUTE_TIMEOUT_MS)
+            throw new IllegalStateException("Invalid owned route observation");
+        this.history=history;this.generation=generation;this.querySerial=querySerial;startedAt=now;
+        deadline=now+SharedSlotRouteTrial.ROUTE_TIMEOUT_MS;
+        endpoint=history==null ? new EuiccReadiness.Epoch(generation,0,querySerial)
+                : new EuiccReadiness.Epoch(generation,history.serial);
+        query=new MtkSimTypeQuery(generation,querySerial,deadline);
+    }
+    State state() { return state; }
+    void response(long epoch,int serial,int type,int error,int support,int mode,int reserved,long now) {
+        if(state!=State.ROUTE) return;
+        if(epoch==generation && serial==querySerial && now<startedAt) {state=State.UNKNOWN;return;}
+        query.onResponse(epoch,serial,type,error,support,mode,reserved,now);
+        if(query.state()==MtkSimTypeQuery.State.EUICC) {
+            state=State.CARD;
+            if(now>Long.MAX_VALUE-SepMuxTrial.COMPLETION_TIMEOUT_MS) {state=State.UNKNOWN;return;}
+            // The GET completed within its own ten-second deadline. Its accepted provenance does
+            // not expire while genuine controller/card readiness is still being observed.
+            deadline=now+SepMuxTrial.COMPLETION_TIMEOUT_MS;
+        }
+        else if(history==null && query.state()==MtkSimTypeQuery.State.PHYSICAL) state=State.PHYSICAL;
+        else if(query.state()!=MtkSimTypeQuery.State.WAITING) state=State.UNKNOWN;
+    }
+    PhysicalSimEvidence physical(long epoch,PhysicalSimEvidence sample,long now) {
+        if(state!=State.PHYSICAL || now<startedAt || now>=deadline || epoch!=generation
+                || !query.current(epoch,now) || sample==null || sample.generation!=generation) {
+            state=State.UNKNOWN;throw new IllegalStateException("Unqualified physical readback");
+        }
+        state=State.READY;return sample;
+    }
+    Proof card(long epoch,boolean present,boolean euiccAtr,int slot,int port,String eid,
+            EuiccReadiness.Snapshot first,EuiccReadiness.Snapshot second,long now) {
+        if(state!=State.CARD) throw new IllegalStateException("Fresh mode1 receipt required");
+        if(now<startedAt || now>=deadline || epoch!=generation || !present || !euiccAtr || slot!=1
+                || port!=0 || !EuiccReadiness.validEid(eid) || first==null || second==null
+                || !first.valid(endpoint) || !second.valid(endpoint) || !first.same(second)
+                || first.portIndex!=port || !first.matchesProvidedEid(eid)) {
+            state=State.UNKNOWN;throw new IllegalStateException("Unqualified adoption card readback");
+        }
+        state=State.READY;return new Proof(generation,history==null ? 0 : history.serial,
+                history==null ? querySerial : -1,endpoint);
+    }
+    void expire(long now) { if(now>=deadline && state!=State.READY) state=State.UNKNOWN; }
+    void unavailable() {state=State.UNKNOWN;query.unavailable();}
+}
diff --git a/src/com/android/internal/telephony/honor/SepMuxTrial.java b/src/com/android/internal/telephony/honor/SepMuxTrial.java
new file mode 100644
index 0000000000000000000000000000000000000000..2ccc9647cb2c363db8fa45f29e0e29d4c39ac71a
--- /dev/null
+++ b/src/com/android/internal/telephony/honor/SepMuxTrial.java
@@ -0,0 +1,182 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.internal.telephony.honor;
+
+import java.util.Objects;
+
+/** Host-only single-shot protocol foundation. No Binder, callback, or modem I/O. */
+public final class SepMuxTrial {
+    public static void requireLdyAn00Identity(String model,String device) {
+        if(!"LDY-AN00".equals(model) || !"ldy_an00".equals(device))
+            throw new IllegalStateException("Requires exact LDY-AN00/ldy_an00 identity");
+    }
+    public static final String VENDOR_HASH = "f24772aa00ec3638e3af9d138924cc829a663602";
+    public static final long ADMISSION_TIMEOUT_MS = 10_000;
+    // Observation policy: native syncMIPC may wait300s. This is NOT cancellation/drain proof.
+    public static final long COMPLETION_TIMEOUT_MS = 360_000;
+    public enum Selector { PHYSICAL(0), EUICC(1);
+        final int wire; Selector(int wire) { this.wire = wire; }
+    }
+    public enum State { NEW, WAITING, ACCEPTED_WAITING, RECONCILING, TARGET_OBSERVED, UNKNOWN }
+    // Snapshot facts must eventually come from trusted phone-process inspection,
+    // NOT caller-supplied booleans or package-name-only ownership guesses.
+    public record Evidence(int uid, String processDomain, boolean enforcing,
+            int version, String hash, boolean originalHonorOwnerAbsent,
+            boolean exclusiveOwnerVerified, boolean cleanCompletionEpoch, SepMuxAdmission admission) {
+        public Evidence(int uid,String processDomain,boolean enforcing,int version,String hash,
+                boolean originalHonorOwnerAbsent,boolean exclusiveOwnerVerified,
+                boolean cleanCompletionEpoch) {
+            this(uid,processDomain,enforcing,version,hash,originalHonorOwnerAbsent,
+                    exclusiveOwnerVerified,cleanCompletionEpoch,SepMuxAdmission.strict());
+        }
+        void require() {
+            Objects.requireNonNull(admission).require(enforcing);
+            if (uid != 1001 || !"u:r:radio:s0".equals(processDomain)
+                    || version != 6 || !VENDOR_HASH.equals(hash)
+                    || !originalHonorOwnerAbsent || !exclusiveOwnerVerified || !cleanCompletionEpoch
+                   )
+                throw new IllegalStateException("Unqualified phone-owner evidence");
+        }
+    }
+    /** Full non-null MsgPayload shape; only nData carries this command. */
+    public record Payload(int nData, int[] nDatas, String strData, String[] strDatas, byte[] bytes) {
+        public Payload {
+            nDatas=nDatas.clone(); bytes=bytes.clone(); strDatas=strDatas.clone();
+            Objects.requireNonNull(strData);
+            for (String s : strDatas) Objects.requireNonNull(s);
+        }
+        @Override public int[] nDatas() { return nDatas.clone(); }
+        @Override public String[] strDatas() { return strDatas.clone(); }
+        @Override public byte[] bytes() { return bytes.clone(); }
+    }
+    public record Command(int slotIndex, int serial, int requestId, Payload payload) {}
+    private State state = State.NEW;
+    private int slot, serial;
+    private long deadline, lastTime;
+    private boolean serialConsumed, dispatched;
+    private boolean firstFinalAccepted, transportUncertain;
+    private boolean completionAccepted, postCompletionTargetObserved;
+    private long completionQueryFloor;
+    private long generation, queryId;
+    private int queryCount;
+    private boolean queryPending;
+    private Selector target;
+    public record Baseline(int slot, long generation, boolean present, boolean validAtr, boolean euicc) {}
+    public record StatusQuery(int slot, long generation, long id) {}
+    private Integer completionFirst;
+    private String reason = "";
+    public State state() { return state; }
+    public String reason() { return reason; }
+    public Integer completionFirst() { return completionFirst; }
+    public boolean finalResponseConsumed() { return serialConsumed; }
+    public boolean canRequestPhysicalReturn() {
+        return state == State.TARGET_OBSERVED && firstFinalAccepted && completionAccepted
+                && postCompletionTargetObserved && !transportUncertain;
+    }
+
+    boolean completionMatches(long generation,int serial) {
+        return this.generation==generation && this.serial==serial && canRequestPhysicalReturn();
+    }
+
+    /** Emits data only; not a dispatch. Instance is deliberately never reusable. */
+    public Command begin(Evidence evidence, int slotIndex, int serial, Selector selector, Baseline baseline, long now) {
+        Objects.requireNonNull(evidence).require(); Objects.requireNonNull(selector);
+        if (baseline == null || baseline.slot()!=slotIndex || baseline.generation()<=0
+                || !baseline.present() || !baseline.validAtr()
+                || baseline.euicc()==(selector==Selector.EUICC)
+                || state != State.NEW || slotIndex < 0 || slotIndex > 1 || serial <= 0
+                || now < 0 || now > Long.MAX_VALUE - ADMISSION_TIMEOUT_MS)
+            throw new IllegalStateException("Invalid or repeated trial");
+        this.slot=slotIndex; this.serial=serial; this.target=selector; this.generation=baseline.generation(); lastTime=now; deadline=now+ADMISSION_TIMEOUT_MS;
+        state=State.WAITING;
+        return new Command(slotIndex, serial, 1005,
+                new Payload(selector.wire,new int[0],"",new String[0],new byte[0]));
+    }
+    /** Owner calls once after durable PENDING and dispatch admission, BEFORE any remote setter. */
+    public void markDispatched(long now) {
+        if(state!=State.WAITING || dispatched || now<lastTime || now>=deadline
+                || now>Long.MAX_VALUE-COMPLETION_TIMEOUT_MS)
+            throw new IllegalStateException("Invalid/expired/repeated dispatch commitment");
+        dispatched=true; lastTime=now; deadline=now+COMPLETION_TIMEOUT_MS;
+    }
+    private boolean pending(long now) {
+        if (state != State.WAITING && state != State.ACCEPTED_WAITING
+                && state != State.RECONCILING && state != State.TARGET_OBSERVED) return false;
+        if (canRequestPhysicalReturn()) return false;
+        if (!dispatched) { unknown("callback before dispatch commitment"); return false; }
+        if (now < lastTime || now >= deadline) { unknown("deadline/clock; no retry"); return false; }
+        lastTime=now; return true;
+    }
+    private void unknown(String why) {
+        transportUncertain=true; state=State.UNKNOWN; reason=why;
+    }
+    /** A matching first final response consumes the local serial, like original RIL. */
+    public void response(int callbackSlot, int responseSerial, int requestId,
+            int responseType, int error, long now) {
+        if (callbackSlot!=slot || responseSerial!=serial || requestId!=1005) return;
+        if (serialConsumed) return; // Includes known early0/trailing6 native duplicate.
+        // Endpoint observation cannot hide pending modem completion or its deadline.
+        if (!pending(now)) return;
+        // Stock final SOLICITED=0 or SOLICITED_ACK_EXP=2; owner must ACK2 before delivery.
+        if (responseType!=0 && responseType!=2) { unknown("unqualified response type"); return; }
+        serialConsumed=true;
+        if (error!=0) { unknown("solicited failure; hardware state unverified"); return; }
+        firstFinalAccepted=true;
+        if (state!=State.RECONCILING && state!=State.TARGET_OBSERVED)
+            state=State.ACCEPTED_WAITING; // NOT mux success.
+    }
+    public void indication(int callbackSlot, int messageId, int[] pair, long now) {
+        if (callbackSlot!=slot || messageId!=1002 || !pending(now)) return;
+        if (pair==null || pair.length!=2) { unknown("malformed completion"); return; }
+        completionFirst=pair[0];
+        // Exact modern MIPC handler emits [1,0] after its synchronous modem request.
+        // This serial-less event is usable only inside a qualified clean exclusive epoch.
+        if (pair[0]!=1 || pair[1]!=0) {
+            unknown("native completion failure/unqualified result; no automatic physical rollback");
+            return;
+        }
+        if (completionAccepted) return; // Duplicate cannot invalidate a fresh pending query.
+        completionAccepted=true;
+        completionQueryFloor=queryId;
+        queryPending=false; // Earlier query responses cannot prove post-completion state.
+        postCompletionTargetObserved=false;
+        state=State.RECONCILING;
+        reason="modem completion received; new card status query required";
+    }
+    /** Requested by initial dispatch or real URC/ICC event, not unbounded polling. */
+    public StatusQuery queryStatus(long now) {
+        if (!pending(now) || queryPending || queryCount>=3)
+            throw new IllegalStateException("No new bounded status query");
+        queryPending=true; queryCount++; queryId++;
+        return new StatusQuery(slot,generation,queryId);
+    }
+    /** Callback token must be retained through existing CI Message/AsyncResult. */
+    public void status(StatusQuery token, boolean present, boolean validAtr,
+            boolean euicc, int mappedSlot, boolean controllerMatches, long now) {
+        if (!pending(now) || !queryPending || token==null || token.slot()!=slot
+                || token.generation()!=generation || token.id()!=queryId) return;
+        queryPending=false;
+        if (!present || !validAtr || mappedSlot!=slot) {
+            unknown("invalid fresh card status/mapping"); return;
+        }
+        if(!controllerMatches) return; // Await actual normal-controller update, no invented state.
+        if(euicc==(target==Selector.EUICC)) {
+            postCompletionTargetObserved=completionAccepted && token.id()>completionQueryFloor;
+            state=State.TARGET_OBSERVED;
+            reason=postCompletionTargetObserved
+                    ? "fresh target after modem completion; no EID/profile claim"
+                    : "target endpoint observed; modem completion and new readback still required";
+        } // Still physical: wait for bounded URC/ICC event and another fresh query.
+    }
+    public void generationChanged() { transportLost(); }
+    public void tick(long now) {
+        pending(now);
+    }
+    public void transportLost() {
+        if (state==State.WAITING || state==State.ACCEPTED_WAITING || state==State.RECONCILING
+                || state==State.TARGET_OBSERVED)
+            unknown("Binder/submission outcome unknown; no resend");
+    }
+}
diff --git a/src/com/android/internal/telephony/honor/SepMuxUiProjection.java b/src/com/android/internal/telephony/honor/SepMuxUiProjection.java
