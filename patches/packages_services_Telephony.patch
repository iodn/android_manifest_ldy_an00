@@ -0,0 +1,58 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.honor.ldy_an00.lease;
+
+import java.util.ArrayList;
+import java.util.concurrent.atomic.AtomicLong;
+
+/** Real shared diagnostic formatter: no Android runtime or native operation. */
+public final class HonorLpaResetTraceHostTest {
+    private static int checks;
+    private static void check(boolean value) {
+        checks++;
+        if (!value) throw new AssertionError("check " + checks);
+    }
+    public static void main(String[] args) {
+        AtomicLong elapsed = new AtomicLong(100);
+        ArrayList<String> lines = new ArrayList<>();
+        var trace = new HonorLpaResetTrace(HonorLpaResetTrace.Side.LPA, elapsed::get, lines::add);
+        trace.enter(HonorLpaResetTrace.Phase.PREPARE_RPC);
+        elapsed.set(1900);
+        trace.failed(new IllegalStateException("EID=12345678901234567890123456789012 APDU=80E29100"));
+        check(lines.get(0).equals("side=LPA phase=PREPARE_RPC event=BEGIN elapsedMs=0"));
+        check(lines.get(1).equals("side=LPA phase=PREPARE_RPC event=FAIL kind=STATE elapsedMs=1800"));
+        check(!String.join("", lines).contains("123456") && !String.join("", lines).contains("80E291"));
+        trace.enter(HonorLpaResetTrace.Phase.PREPARE_VALIDATION);
+        trace.returned(2);
+        check(lines.get(lines.size()-1).contains("PREPARE_VALIDATION event=RETURN result=2"));
+        trace.enter(HonorLpaResetTrace.Phase.WAIT_RECLAMATION);
+        trace.returned(HonorLpaResetTrace.Phase.RECLAMATION_RESULT, 0);
+        trace.returned(-1);
+        check(lines.get(lines.size()-2).contains("RECLAMATION_RESULT event=RETURN result=0"));
+        check(lines.get(lines.size()-1).contains("WAIT_RECLAMATION event=RETURN result=-1"));
+        trace.returned(123456789);
+        check(lines.get(lines.size()-1).contains("result=OTHER"));
+        check(!lines.get(lines.size()-1).contains("123456789"));
+        trace.failed(new java.util.concurrent.TimeoutException("secret"));
+        check(lines.get(lines.size()-1).contains("kind=TIMEOUT"));
+        trace.failed(new java.util.concurrent.CancellationException("secret"));
+        check(lines.get(lines.size()-1).contains("kind=CANCELLED"));
+        trace.failed(new SecurityException("secret"));
+        check(lines.get(lines.size()-1).contains("kind=SECURITY"));
+        trace.failed(new RuntimeException("secret"));
+        check(lines.get(lines.size()-1).contains("kind=OTHER"));
+        check(!String.join("", lines).contains("secret"));
+        for (var phase : HonorLpaResetTrace.Phase.values()) {
+            trace.enter(phase); trace.returned();
+            check(lines.get(lines.size()-1).contains("phase=" + phase + " event=RETURN"));
+        }
+        var silent = new HonorLpaResetTrace(HonorLpaResetTrace.Side.PHONE,
+                elapsed::get, ignored -> { throw new IllegalStateException("logging failed"); });
+        silent.enter(HonorLpaResetTrace.Phase.ADMISSION);
+        silent.failed(new IllegalStateException("original operation failure"));
+        check(true); // Diagnostic sink failure cannot replace the operation's existing control flow.
+        System.out.println("PASS " + checks + " shared reset-boundary diagnostic checks");
+    }
+}
