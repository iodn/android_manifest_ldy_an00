+#!/usr/bin/env python3
+"""Exercise the actual restricted sender; no APK, radio or device operation."""
+from pathlib import Path
+import os
+import subprocess
+import tempfile
+import xml.etree.ElementTree as ET
+
+ROOT = Path(__file__).resolve().parents[2]
+SOURCE = ROOT / "src/com/android/internal/telephony/honor/HonorImsDcBroadcastTransport.java"
+NS = "{http://schemas.android.com/apk/res/android}"
+manifest = ET.parse(ROOT / "AndroidManifest.xml").getroot()
+assert manifest.attrib[NS + "sharedUserId"] == "android.uid.phone"
+assert sum(node.attrib.get(NS + "name") ==
+    "com.hihonor.intent.action.UPDATE_IMSDC_CAP"
+    for node in manifest.findall("protected-broadcast")) == 1
+FIXTURES = {
+    "android/os/IBinder.java": """
+package android.os;
+public interface IBinder { boolean isBinderAlive(); }
+""",
+    "android/os/RemoteException.java": """
+package android.os;
+public class RemoteException extends Exception {}
+""",
+    "android/app/AppGlobals.java": """
+package android.app;
+public final class AppGlobals {
+    public static boolean protectedAction=true, unavailable, missing, alive=true;
+    public static int queries;
+    public static final android.os.IBinder binder=() -> alive;
+    public static Manager getPackageManager() { return missing ? null : new Manager(); }
+    public static final class Manager {
+        public android.os.IBinder asBinder() { return binder; }
+        public boolean isProtectedBroadcast(String action) throws android.os.RemoteException {
+            queries++;
+            if (unavailable) throw new android.os.RemoteException();
+            return protectedAction
+                && "com.hihonor.intent.action.UPDATE_IMSDC_CAP".equals(action);
+        }
+    }
+}
+""",
+    "android/content/Context.java": """
+package android.content;
+public abstract class Context { public abstract void sendBroadcast(Intent intent); }
+""",
+    "android/content/Intent.java": """
+package android.content;
+import java.util.HashMap;
+import java.util.Map;
+public final class Intent {
+    public final String action;
+    public String target;
+    public final Map<String,Integer> extras = new HashMap<>();
+    public Intent(String action) { this.action = action; }
+    public Intent setPackage(String target) { this.target = target; return this; }
+    public Intent putExtra(String key,int value) { extras.put(key,value); return this; }
+}
+""",
+    "com/android/internal/telephony/honor/ImsDcBroadcastHostTest.java": """
+package com.android.internal.telephony.honor;
+import android.app.AppGlobals;
+import android.content.Context;
+import android.content.Intent;
+import java.util.ArrayList;
+import java.util.List;
+public final class ImsDcBroadcastHostTest {
+    private static int checks;
+    private static void check(boolean value) {
+        checks++; if (!value) throw new AssertionError("check"+checks);
+    }
+    private static final class Sender extends Context {
+        final List<Intent> sent = new ArrayList<>();
+        boolean failAfterEnqueue;
+        public void sendBroadcast(Intent intent) {
+            sent.add(intent);
+            if (failAfterEnqueue) throw new IllegalStateException("completion uncertain");
+        }
+    }
+    public static void main(String[] args) {
+        Sender sender = new Sender();
+        var transport = new HonorImsDcBroadcastTransport(sender);
+        for (int phone=0;phone<2;phone++) for (int mode=0;mode<2;mode++) {
+            transport.dispatch(phone,mode);
+            Intent sent=sender.sent.get(sender.sent.size()-1);
+            check("com.mediatek.ims".equals(sent.target));
+            check("com.hihonor.intent.action.UPDATE_IMSDC_CAP".equals(sent.action));
+            check(sent.extras.size()==2 && sent.extras.get("phoneId")==phone
+                    && sent.extras.get("persist.vendor.imsdc_support")==mode);
+        }
+        for (int[] invalid : new int[][]{{-1,0},{2,0},{0,-1},{0,2},{0,Integer.MAX_VALUE}}) {
+            int before=sender.sent.size();
+            boolean refused=false;
+            try { transport.dispatch(invalid[0],invalid[1]); }
+            catch (IllegalArgumentException expected) { refused=true; }
+            check(refused && sender.sent.size()==before);
+        }
+        for (int unavailable=0;unavailable<3;unavailable++) {
+            AppGlobals.protectedAction=unavailable!=0;
+            AppGlobals.unavailable=unavailable==1;
+            AppGlobals.missing=unavailable==2;
+            boolean refused=false;
+            try { new HonorImsDcBroadcastTransport(sender); }
+            catch (IllegalStateException expected) { refused=true; }
+            check(refused && sender.sent.size()==4);
+        }
+        AppGlobals.protectedAction=true;
+        AppGlobals.unavailable=false;
+        AppGlobals.missing=false;
+        AppGlobals.alive=false;
+        boolean retired=false;
+        try { transport.dispatch(0,0); }
+        catch (IllegalStateException expected) { retired=true; }
+        check(retired && sender.sent.size()==4);
+        AppGlobals.alive=true;
+        int preparedQueries=AppGlobals.queries;
+        check(sender.sent.get(0)!=sender.sent.get(1)); // Later sends cannot mutate queued intent.
+        sender.failAfterEnqueue=true;
+        boolean uncertain=false;
+        try { transport.dispatch(1,0); }
