+        check(e.timers.timers.get(HonorImsDefaultOpenPolicy.Timer.VOLTE_REOPEN)==180000L,"first no-CS block multiplier1");
+        e.policy.timer(HonorImsDefaultOpenPolicy.Timer.VOLTE_REOPEN);
