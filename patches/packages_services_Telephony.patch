@@ -0,0 +1,182 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.internal.telephony.honor;
+
+import java.util.Objects;
+
+/** Host-only single-shot protocol foundation. No Binder, callback, or modem I/O. */
+public final class SepMuxTrial {
+    public static void requireLdyAn00Identity(String model,String device) {
+        if(!"LDY-AN00".equals(model) || !"ldy_an00".equals(device))
+            throw new IllegalStateException("Requires exact LDY-AN00/ldy_an00 identity");
+    }
+    public static final String VENDOR_HASH = "f24772aa00ec3638e3af9d138924cc829a663602";
+    public static final long ADMISSION_TIMEOUT_MS = 10_000;
+    // Observation policy: native syncMIPC may wait300s. This is NOT cancellation/drain proof.
+    public static final long COMPLETION_TIMEOUT_MS = 360_000;
+    public enum Selector { PHYSICAL(0), EUICC(1);
+        final int wire; Selector(int wire) { this.wire = wire; }
+    }
+    public enum State { NEW, WAITING, ACCEPTED_WAITING, RECONCILING, TARGET_OBSERVED, UNKNOWN }
+    // Snapshot facts must eventually come from trusted phone-process inspection,
+    // NOT caller-supplied booleans or package-name-only ownership guesses.
+    public record Evidence(int uid, String processDomain, boolean enforcing,
+            int version, String hash, boolean originalHonorOwnerAbsent,
+            boolean exclusiveOwnerVerified, boolean cleanCompletionEpoch, SepMuxAdmission admission) {
+        public Evidence(int uid,String processDomain,boolean enforcing,int version,String hash,
+                boolean originalHonorOwnerAbsent,boolean exclusiveOwnerVerified,
+                boolean cleanCompletionEpoch) {
+            this(uid,processDomain,enforcing,version,hash,originalHonorOwnerAbsent,
+                    exclusiveOwnerVerified,cleanCompletionEpoch,SepMuxAdmission.strict());
+        }
+        void require() {
+            Objects.requireNonNull(admission).require(enforcing);
+            if (uid != 1001 || !"u:r:radio:s0".equals(processDomain)
+                    || version != 6 || !VENDOR_HASH.equals(hash)
+                    || !originalHonorOwnerAbsent || !exclusiveOwnerVerified || !cleanCompletionEpoch
+                   )
+                throw new IllegalStateException("Unqualified phone-owner evidence");
+        }
+    }
+    /** Full non-null MsgPayload shape; only nData carries this command. */
+    public record Payload(int nData, int[] nDatas, String strData, String[] strDatas, byte[] bytes) {
+        public Payload {
+            nDatas=nDatas.clone(); bytes=bytes.clone(); strDatas=strDatas.clone();
+            Objects.requireNonNull(strData);
+            for (String s : strDatas) Objects.requireNonNull(s);
+        }
+        @Override public int[] nDatas() { return nDatas.clone(); }
+        @Override public String[] strDatas() { return strDatas.clone(); }
+        @Override public byte[] bytes() { return bytes.clone(); }
+    }
+    public record Command(int slotIndex, int serial, int requestId, Payload payload) {}
+    private State state = State.NEW;
+    private int slot, serial;
+    private long deadline, lastTime;
+    private boolean serialConsumed, dispatched;
+    private boolean firstFinalAccepted, transportUncertain;
+    private boolean completionAccepted, postCompletionTargetObserved;
+    private long completionQueryFloor;
+    private long generation, queryId;
+    private int queryCount;
+    private boolean queryPending;
+    private Selector target;
+    public record Baseline(int slot, long generation, boolean present, boolean validAtr, boolean euicc) {}
+    public record StatusQuery(int slot, long generation, long id) {}
+    private Integer completionFirst;
+    private String reason = "";
+    public State state() { return state; }
+    public String reason() { return reason; }
+    public Integer completionFirst() { return completionFirst; }
+    public boolean finalResponseConsumed() { return serialConsumed; }
+    public boolean canRequestPhysicalReturn() {
+        return state == State.TARGET_OBSERVED && firstFinalAccepted && completionAccepted
+                && postCompletionTargetObserved && !transportUncertain;
+    }
+
+    boolean completionMatches(long generation,int serial) {
+        return this.generation==generation && this.serial==serial && canRequestPhysicalReturn();
+    }
+
+    /** Emits data only; not a dispatch. Instance is deliberately never reusable. */
+    public Command begin(Evidence evidence, int slotIndex, int serial, Selector selector, Baseline baseline, long now) {
+        Objects.requireNonNull(evidence).require(); Objects.requireNonNull(selector);
+        if (baseline == null || baseline.slot()!=slotIndex || baseline.generation()<=0
+                || !baseline.present() || !baseline.validAtr()
+                || baseline.euicc()==(selector==Selector.EUICC)
+                || state != State.NEW || slotIndex < 0 || slotIndex > 1 || serial <= 0
+                || now < 0 || now > Long.MAX_VALUE - ADMISSION_TIMEOUT_MS)
+            throw new IllegalStateException("Invalid or repeated trial");
+        this.slot=slotIndex; this.serial=serial; this.target=selector; this.generation=baseline.generation(); lastTime=now; deadline=now+ADMISSION_TIMEOUT_MS;
+        state=State.WAITING;
+        return new Command(slotIndex, serial, 1005,
+                new Payload(selector.wire,new int[0],"",new String[0],new byte[0]));
+    }
+    /** Owner calls once after durable PENDING and dispatch admission, BEFORE any remote setter. */
+    public void markDispatched(long now) {
+        if(state!=State.WAITING || dispatched || now<lastTime || now>=deadline
+                || now>Long.MAX_VALUE-COMPLETION_TIMEOUT_MS)
+            throw new IllegalStateException("Invalid/expired/repeated dispatch commitment");
+        dispatched=true; lastTime=now; deadline=now+COMPLETION_TIMEOUT_MS;
+    }
+    private boolean pending(long now) {
+        if (state != State.WAITING && state != State.ACCEPTED_WAITING
+                && state != State.RECONCILING && state != State.TARGET_OBSERVED) return false;
+        if (canRequestPhysicalReturn()) return false;
+        if (!dispatched) { unknown("callback before dispatch commitment"); return false; }
+        if (now < lastTime || now >= deadline) { unknown("deadline/clock; no retry"); return false; }
+        lastTime=now; return true;
+    }
+    private void unknown(String why) {
+        transportUncertain=true; state=State.UNKNOWN; reason=why;
+    }
+    /** A matching first final response consumes the local serial, like original RIL. */
+    public void response(int callbackSlot, int responseSerial, int requestId,
+            int responseType, int error, long now) {
+        if (callbackSlot!=slot || responseSerial!=serial || requestId!=1005) return;
+        if (serialConsumed) return; // Includes known early0/trailing6 native duplicate.
+        // Endpoint observation cannot hide pending modem completion or its deadline.
+        if (!pending(now)) return;
+        // Stock final SOLICITED=0 or SOLICITED_ACK_EXP=2; owner must ACK2 before delivery.
+        if (responseType!=0 && responseType!=2) { unknown("unqualified response type"); return; }
+        serialConsumed=true;
+        if (error!=0) { unknown("solicited failure; hardware state unverified"); return; }
+        firstFinalAccepted=true;
+        if (state!=State.RECONCILING && state!=State.TARGET_OBSERVED)
+            state=State.ACCEPTED_WAITING; // NOT mux success.
+    }
+    public void indication(int callbackSlot, int messageId, int[] pair, long now) {
+        if (callbackSlot!=slot || messageId!=1002 || !pending(now)) return;
+        if (pair==null || pair.length!=2) { unknown("malformed completion"); return; }
+        completionFirst=pair[0];
+        // Exact modern MIPC handler emits [1,0] after its synchronous modem request.
+        // This serial-less event is usable only inside a qualified clean exclusive epoch.
+        if (pair[0]!=1 || pair[1]!=0) {
+            unknown("native completion failure/unqualified result; no automatic physical rollback");
+            return;
+        }
+        if (completionAccepted) return; // Duplicate cannot invalidate a fresh pending query.
+        completionAccepted=true;
+        completionQueryFloor=queryId;
+        queryPending=false; // Earlier query responses cannot prove post-completion state.
+        postCompletionTargetObserved=false;
+        state=State.RECONCILING;
+        reason="modem completion received; new card status query required";
+    }
+    /** Requested by initial dispatch or real URC/ICC event, not unbounded polling. */
+    public StatusQuery queryStatus(long now) {
+        if (!pending(now) || queryPending || queryCount>=3)
+            throw new IllegalStateException("No new bounded status query");
+        queryPending=true; queryCount++; queryId++;
+        return new StatusQuery(slot,generation,queryId);
+    }
+    /** Callback token must be retained through existing CI Message/AsyncResult. */
+    public void status(StatusQuery token, boolean present, boolean validAtr,
+            boolean euicc, int mappedSlot, boolean controllerMatches, long now) {
+        if (!pending(now) || !queryPending || token==null || token.slot()!=slot
+                || token.generation()!=generation || token.id()!=queryId) return;
+        queryPending=false;
+        if (!present || !validAtr || mappedSlot!=slot) {
+            unknown("invalid fresh card status/mapping"); return;
+        }
+        if(!controllerMatches) return; // Await actual normal-controller update, no invented state.
+        if(euicc==(target==Selector.EUICC)) {
+            postCompletionTargetObserved=completionAccepted && token.id()>completionQueryFloor;
+            state=State.TARGET_OBSERVED;
+            reason=postCompletionTargetObserved
+                    ? "fresh target after modem completion; no EID/profile claim"
+                    : "target endpoint observed; modem completion and new readback still required";
+        } // Still physical: wait for bounded URC/ICC event and another fresh query.
+    }
+    public void generationChanged() { transportLost(); }
+    public void tick(long now) {
+        pending(now);
+    }
+    public void transportLost() {
+        if (state==State.WAITING || state==State.ACCEPTED_WAITING || state==State.RECONCILING
+                || state==State.TARGET_OBSERVED)
+            unknown("Binder/submission outcome unknown; no resend");
+    }
+}
diff --git a/src/com/android/internal/telephony/honor/SepMuxUiProjection.java b/src/com/android/internal/telephony/honor/SepMuxUiProjection.java
