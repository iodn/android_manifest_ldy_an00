+package com.android.internal.telephony.honor;
+
+public final class SepMuxTrialTest {
+    static int checks;
+    static void check(boolean b) { checks++; if (!b) throw new AssertionError("check "+checks); }
+    static SepMuxTrial.Evidence good() { return new SepMuxTrial.Evidence(1001,"u:r:radio:s0",true,6,
+        SepMuxTrial.VENDOR_HASH,true,true,true); }
+    static SepMuxTrial.Baseline baseline() { return new SepMuxTrial.Baseline(1,9,true,true,false); }
+    static SepMuxTrial start() { var t=new SepMuxTrial(); t.begin(good(),1,77,SepMuxTrial.Selector.EUICC,baseline(),100); t.markDispatched(100); return t; }
+    static void refuse(Runnable r) { try { r.run(); } catch(IllegalStateException e) { checks++; return; } throw new AssertionError("not refused"); }
+    public static void main(String[] args) {
+        SepMuxTrial.requireLdyAn00Identity("LDY-AN00","ldy_an00"); checks++;
+        refuse(()->SepMuxTrial.requireLdyAn00Identity("LDY-AN00","ldy"));
+        refuse(()->SepMuxTrial.requireLdyAn00Identity("HNLDY-M","ldy_an00"));
+        refuse(()->SepMuxTrial.requireLdyAn00Identity("LDY-AN00","other_honor"));
+        refuse(()->SepMuxTrial.requireLdyAn00Identity("ldy-an00","ldy_an00"));
+        refuse(()->SepMuxTrial.requireLdyAn00Identity(null,"ldy_an00"));
+        refuse(()->SepMuxTrial.requireLdyAn00Identity("LDY-AN00",null));
+        var t=new SepMuxTrial(); var c=t.begin(good(),1,77,SepMuxTrial.Selector.EUICC,baseline(),100); t.markDispatched(100);
+        check(c.requestId()==1005 && c.payload().nData()==1 && c.slotIndex()==1);
+        check(c.payload().nDatas().length==0 && c.payload().strData().equals("")
+            && c.payload().strDatas().length==0 && c.payload().bytes().length==0);
+        t.response(1,77,1005,0,0,101); check(t.state()==SepMuxTrial.State.ACCEPTED_WAITING);
+        t.response(1,77,1005,0,6,102); check(t.state()==SepMuxTrial.State.ACCEPTED_WAITING);
+        t.indication(1,1002,new int[]{1,0},103);
+        check(t.state()==SepMuxTrial.State.RECONCILING && t.completionFirst()==1);
+        final var used=t; refuse(()->used.begin(good(),1,78,SepMuxTrial.Selector.PHYSICAL,baseline(),104));
+        // Advisory completion cannot override a first solicited error arriving afterwards.
+        t=start();t.indication(1,1002,new int[]{1,0},101);t.response(1,77,1005,0,6,102);
+        check(t.state()==SepMuxTrial.State.UNKNOWN);
+        // Wrong slot, stale serial, unrelated message cannot consume this request.
+        t=start();t.response(0,77,1005,0,6,101);t.response(1,76,1005,0,6,102);
+        t.indication(0,1002,new int[]{1,0},103);t.indication(1,1003,new int[]{1,0},104);
+        check(t.state()==SepMuxTrial.State.WAITING);
+        t.tick(360100);check(t.state()==SepMuxTrial.State.UNKNOWN);
+        t.indication(1,1002,new int[]{1,0},360101);check(t.state()==SepMuxTrial.State.UNKNOWN);
+        t=start();t.indication(1,1002,new int[]{0},101);check(t.state()==SepMuxTrial.State.UNKNOWN);
+        t=start();t.indication(1,1002,new int[]{0,1},101);check(t.state()==SepMuxTrial.State.UNKNOWN);
+        t=start();t.response(1,77,1005,0,6,101);t.response(1,77,1005,0,0,102);
+        check(t.state()==SepMuxTrial.State.UNKNOWN); // reversed duplicate cannot invent success
+        t=start();t.response(1,77,1005,1,0,101);check(t.state()==SepMuxTrial.State.UNKNOWN);
+        t=start();t.transportLost();check(t.state()==SepMuxTrial.State.UNKNOWN);
+        t=start();t.tick(99);check(t.state()==SepMuxTrial.State.UNKNOWN);
+        var g=good();
+        var bad=new SepMuxTrial.Evidence[]{
+          new SepMuxTrial.Evidence(0,g.processDomain(),true,6,g.hash(),true,true,true),
+          new SepMuxTrial.Evidence(1001,"u:r:shell:s0",true,6,g.hash(),true,true,true),
+          new SepMuxTrial.Evidence(1001,g.processDomain(),false,6,g.hash(),true,true,true),
+          new SepMuxTrial.Evidence(1001,g.processDomain(),true,5,g.hash(),true,true,true),
+          new SepMuxTrial.Evidence(1001,g.processDomain(),true,6,"UNQUALIFIED-HOST-ONLY",true,true,true),
+          new SepMuxTrial.Evidence(1001,g.processDomain(),true,6,g.hash(),false,true,true),
+          new SepMuxTrial.Evidence(1001,g.processDomain(),true,6,g.hash(),true,false,true),
+          new SepMuxTrial.Evidence(1001,g.processDomain(),true,6,g.hash(),true,true,false)};
+        for(var b:bad) refuse(()->new SepMuxTrial().begin(b,1,77,SepMuxTrial.Selector.EUICC,baseline(),100));
+        refuse(()->new SepMuxTrial().begin(good(),2,77,SepMuxTrial.Selector.EUICC,baseline(),100));
+        refuse(()->new SepMuxTrial().begin(good(),1,0,SepMuxTrial.Selector.EUICC,baseline(),100));
+        refuse(()->new SepMuxTrial().begin(good(),1,77,SepMuxTrial.Selector.EUICC,baseline(),Long.MAX_VALUE));
+        // A stale completion is advisory: physical fresh status cannot falsely finish.
+        t=start(); t.indication(1,1002,new int[]{1,0},101);
+        var q=t.queryStatus(102);t.status(q,true,true,false,1,true,103);
+        check(t.state()==SepMuxTrial.State.RECONCILING);
+        // Late/wrong token and replaced service generation cannot establish endpoint.
+        var q2=t.queryStatus(104);t.status(q,true,true,true,1,true,105);
+        t.status(new SepMuxTrial.StatusQuery(1,10,q2.id()),true,true,true,1,true,106);
+        t.status(new SepMuxTrial.StatusQuery(0,9,q2.id()),true,true,true,1,true,107);
+        check(t.state()==SepMuxTrial.State.RECONCILING);
+        t.status(q2,true,true,true,1,true,108);check(t.state()==SepMuxTrial.State.TARGET_OBSERVED);
+        t=start();q=t.queryStatus(101);t.status(q,true,true,true,0,true,102);
+        check(t.state()==SepMuxTrial.State.UNKNOWN);
+        t=start();q=t.queryStatus(101);t.status(q,true,false,true,1,true,102);
+        check(t.state()==SepMuxTrial.State.UNKNOWN);
+        t=start();q=t.queryStatus(101);t.generationChanged();t.status(q,true,true,true,1,true,102);
+        check(t.state()==SepMuxTrial.State.UNKNOWN);
+        t=start();q=t.queryStatus(101);t.tick(360100);t.status(q,true,true,true,1,true,360101);
+        check(t.state()==SepMuxTrial.State.UNKNOWN);
+        t=start();
