+    private void responseEvent(RadioResponseInfo info,int messageId,boolean comm) {
+        if(info==null){closeReadiness(endpoints.lose());handler.post(()->{recordTransportFailure(-2);lost();});return;}
+        final int serial=info.serial,type=info.type,error=info.error;
