index 0000000000000000000000000000000000000000..44451e8deb832f91a83b62550439c1ce9ba8e05f
--- /dev/null
+++ b/src/com/android/internal/telephony/honor/HonorPrimaryDataPreference.java
@@ -0,0 +1,259 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.internal.telephony.honor;
+
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+import android.content.IntentFilter;
+import android.os.Build;
+import android.os.Handler;
+import android.os.SystemProperties;
+import android.os.UserManager;
+import android.provider.Settings;
+import android.telephony.SubscriptionManager;
+import android.telephony.TelephonyManager;
+
+import com.android.internal.telephony.Phone;
+import com.android.internal.telephony.PhoneFactory;
+import com.android.internal.telephony.TelephonyIntents;
+import com.android.internal.telephony.uicc.UiccController;
+
+/** Restores recorded user primary intent; never changes the default data subscription. */
+public final class HonorPrimaryDataPreference {
+    private static final String SLOT = "switch_dual_card_slots";
+    private static final String SUB = "last_main_card_subid";
+    private static volatile HonorPrimaryDataPreference instance;
+    private final Context context;
+    private final Handler handler;
+    private final SubscriptionManager subscriptions;
+    private boolean queued, changing, unknown;
+    private String failedRequest;
+    private boolean callBusy;
+    private long callEpoch, idleEpoch, retryAfterCallEpoch;
+
+    private HonorPrimaryDataPreference(Context context) {
+        this.context = context.getApplicationContext();
+        handler = new Handler(UiccController.getInstance().getLooper());
+        subscriptions = context.getSystemService(SubscriptionManager.class);
+        subscriptions.addOnSubscriptionsChangedListener(
+                context.getMainExecutor(),
+                new SubscriptionManager.OnSubscriptionsChangedListener() {
+                    @Override
+                    public void onSubscriptionsChanged() {
+                        settled();
+                    }
+                });
+        Handler events =
+                new Handler(
+                        handler.getLooper(),
+                        message -> {
+                            // Transaction-generated capability events must not schedule their own
+                            // retry.
+                            if (message.what == 1) callStateChanged();
+                            else if (!changing) enqueue();
+                            return true;
+                        });
+        for (Phone phone : PhoneFactory.getPhones()) {
+            phone.registerForPreciseCallStateChanged(events, 1, null);
+            phone.registerForRadioCapabilityChanged(events, 2, null);
+            phone.mCi.registerForAvailable(events, 3, null);
+            phone.mCi.registerForOn(events, 4, null);
+        }
+        IntentFilter filter = new IntentFilter(Intent.ACTION_USER_UNLOCKED);
+        filter.addAction(TelephonyManager.ACTION_PHONE_STATE_CHANGED);
+        filter.addAction(TelephonyIntents.ACTION_DEFAULT_DATA_SUBSCRIPTION_CHANGED);
+        context.registerReceiver(
+                new BroadcastReceiver() {
+                    @Override
+                    public void onReceive(Context ignored, Intent intent) {
+                        if (TelephonyManager.ACTION_PHONE_STATE_CHANGED.equals(intent.getAction()))
+                            handler.post(HonorPrimaryDataPreference.this::callStateChanged);
+                        else settled();
+                    }
+                },
+                filter);
+        enqueue();
+    }
+
+    public static void initialize(Context context) {
+        if (!"LDY-AN00".equals(Build.MODEL)
+                || !"ldy_an00".equals(Build.DEVICE)
+                || !SystemProperties.getBoolean("ro.lineage.ldy_an00.esim_bridge", false)) return;
+        UiccController.getInstance()
+                .post(
+                        () -> {
+                            if (instance == null)
+                                instance = new HonorPrimaryDataPreference(context);
+                        });
+    }
+
+    static void admissionReady() {
+        HonorPrimaryDataPreference owner=instance;
+        if(owner!=null)owner.handler.post(owner::enqueue);
+    }
+    static void settled() {
+        HonorMtkStateSync.settled();
+        HonorRadioCommBroker.readinessChanged();
+        HonorPrimaryDataPreference owner = instance;
+        if (owner != null) owner.handler.post(owner::enqueue);
+    }
+
+    static boolean remember(Context context, int phoneId, int subId) {
+        // Never leave a new subscription paired with an old valid fallback slot.
+        if (!Settings.System.putInt(context.getContentResolver(), SLOT, -1)) return false;
+        if (!Settings.System.putInt(context.getContentResolver(), SUB, subId)) return false;
+        return Settings.System.putInt(context.getContentResolver(), SLOT, phoneId);
+    }
+
+    private void observeCallState() {
+        boolean busy;
+        try {
+            HonorSimRouteCallGuard.requireIdle();
+            busy = false;
+        } catch (HonorSimRouteCallGuard.CallBusy active) {
+            busy = true;
+        } catch (RuntimeException unavailable) {
+            return;
+        }
+        if (busy && !callBusy) {
+            callBusy = true;
+            callEpoch++;
+        } else if (!busy && callBusy) {
+            callBusy = false;
+            idleEpoch = callEpoch;
+            if (retryAfterCallEpoch > 0 && idleEpoch >= retryAfterCallEpoch) {
+                failedRequest = null;
+                retryAfterCallEpoch = 0;
+            }
+        }
+    }
+
+    private void callStateChanged() {
+        observeCallState();
+        if (!changing) enqueue();
+    }
+
+    private void enqueue() {
+        if (queued || changing || unknown) return;
+        queued = true;
+        handler.post(
+                () -> {
+                    queued = false;
+                    review();
+                });
+    }
+
+    private void review() {
+        if (changing || unknown) return;
+        UserManager users = context.getSystemService(UserManager.class);
+        if (users == null
+                || !users.isUserUnlocked()
+                || users.hasUserRestriction(UserManager.DISALLOW_CONFIG_MOBILE_NETWORKS)) return;
+        try {
+            if (Settings.Global.getInt(
+                            context.getContentResolver(), Settings.Global.AIRPLANE_MODE_ON, 0)
+                    != 0) return;
+            HonorSimRouteCallGuard.requireIdle();
+            LpaOperationLease leases = HonorLpaLeaseService.leases(context);
+            synchronized (leases) {
+                if (leases.primarySelectionUnresolved()) {
+                    unknown = true;
+                    return;
+                }
+                leases.requirePolicyCycleQuiescent();
+                if (SepMuxJournal.unresolvedHistory(new AtomicSepMuxStore(context))) return;
+            }
+            Phone[] phones = PhoneFactory.getPhones();
+            if (phones == null || phones.length != 2) return;
+            int[] active = new int[2];
+            for (int i = 0; i < 2; i++) {
+                int subId = phones[i].getSubId();
+                active[i] = subscriptions.getActiveSubscriptionInfo(subId) == null ? -1 : subId;
+            }
+            int savedSlot = Settings.System.getInt(context.getContentResolver(), SLOT, -1);
+            int savedSub = Settings.System.getInt(context.getContentResolver(), SUB, -1);
+            int target =
+                    choose(
+                            savedSlot,
+                            savedSub,
+                            SubscriptionManager.getDefaultDataSubscriptionId(),
+                            active);
+            boolean noChange =
+                    HonorPrimaryDataSelection.settledNoChange(
+                            context, target, target < 0 ? -1 : active[target]);
+            if (target < 0 || !phones[target].isRadioOn()) return;
+            for (Phone phone : phones) {
+                if (!phone.isRadioAvailable() || phone.getRadioCapability() == null) return;
+            }
+            if (noChange) return;
+            String uuid = phones[target].getRadioCapability().getLogicalModemUuid();
+            boolean bootstrap = savedSlot < 0 && savedSub < 0;
+            if (uuid != null && uuid.contains("ps0")) {
+                if (bootstrap
+                        && SubscriptionManager.getDefaultDataSubscriptionId() == active[target])
+                    remember(context, target, active[target]);
+                return; // Existing native assignment already preserves the intent.
+            }
+            String requestKey =
+                    savedSlot
+                            + ":"
+                            + savedSub
+                            + ":"
+                            + target
+                            + ":"
+                            + java.util.Arrays.toString(active);
+            if (requestKey.equals(failedRequest)) return;
+            changing = true;
+            final long attemptCallEpoch = callEpoch;
+            retryAfterCallEpoch = 0;
+            final int targetSub = active[target];
+            HonorPrimaryDataSelection.restore(
+                    context,
+                    targetSub,
+                    result -> {
+                        changing = false;
+                        observeCallState();
+                        if (result == HonorPrimaryDataSelection.Result.UNKNOWN) unknown = true;
+                        if (result == HonorPrimaryDataSelection.Result.REFUSED) {
+                            failedRequest = requestKey;
+                            if (callEpoch > attemptCallEpoch) {
+                                retryAfterCallEpoch = callEpoch;
+                                if (!callBusy && idleEpoch >= retryAfterCallEpoch) {
+                                    failedRequest = null;
+                                    retryAfterCallEpoch = 0;
+                                    enqueue();
+                                }
+                            }
+                        }
+                        if (result == HonorPrimaryDataSelection.Result.COMMITTED
+                                && bootstrap
+                                && SubscriptionManager.getDefaultDataSubscriptionId()
+                                        == targetSub) {
+                            remember(context, target, targetSub);
+                        }
+                        // No timer or automatic retry. A later real lifecycle event may review
+                        // again.
+                    });
+        } catch (Exception notReady) {
+            // Call, subscription and settled SIM-operation events provide the next opportunity.
+        }
+    }
+
+    static int choose(int savedSlot, int savedSub, int defaultDataSub, int[] activeSubs) {
+        if (activeSubs.length != 2) return -1;
+        if (savedSlot < 0 && savedSub < 0) {
+            for (int i = 0; i < 2; i++)
+                if (activeSubs[i] >= 0 && activeSubs[i] == defaultDataSub) return i;
+            return -1;
+        }
+        if (savedSub >= 0) {
+            for (int i = 0; i < 2; i++) if (activeSubs[i] == savedSub) return i;
+        }
+        if (savedSlot >= 0 && savedSlot < 2 && activeSubs[savedSlot] >= 0) return savedSlot;
+        if ((activeSubs[0] >= 0) != (activeSubs[1] >= 0)) return activeSubs[0] >= 0 ? 0 : 1;
+        return -1;
+    }
+}
diff --git a/src/com/android/internal/telephony/honor/HonorPrimaryDataSelection.java b/src/com/android/internal/telephony/honor/HonorPrimaryDataSelection.java
new file mode 100644
index 0000000000000000000000000000000000000000..5d21c51cc123522c3da8290823d3da218f543ca7
--- /dev/null
+++ b/src/com/android/internal/telephony/honor/HonorPrimaryDataSelection.java
@@ -0,0 +1,369 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.internal.telephony.honor;
+
+import android.content.Context;
+import android.os.AsyncResult;
+import android.os.Build;
+import android.os.Handler;
+import android.provider.Settings;
+import android.telephony.SubscriptionManager;
+
+import com.android.internal.telephony.Phone;
+import com.android.internal.telephony.PhoneFactory;
+import com.android.internal.telephony.ProxyController;
+import com.android.internal.telephony.ProxyController.PrimaryCapabilityResult;
+import com.android.internal.telephony.RadioCapability;
+import com.android.internal.telephony.uicc.UiccController;
+
+import java.util.function.Consumer;
+
+/** Explicit Settings data-SIM selection, never an automatic DDS policy hook. */
+public final class HonorPrimaryDataSelection {
+    public enum Result {
+        COMMITTED,
+        BUSY,
+        REFUSED,
+        UNKNOWN
+    }
+
+    // Process-local observation only; explicit selections always run the stock protocol.
+    private static NoChange settledNoChange;
+
+    private HonorPrimaryDataSelection() {}
+
+    static boolean settledNoChange(Context context, int phoneId, int subId) {
+        NoChange previous = settledNoChange;
+        if (previous == null) return false;
+        try {
+            if (previous.same(NoChange.capture(context, phoneId, subId))) return true;
+        } catch (RuntimeException unavailable) {
+            // An unavailable identity cannot prove that a prior observation still applies.
+        }
+        settledNoChange = null;
+        return false;
+    }
+
+    private static final class NoChange {
+        final Snapshot assignment;
+        final int target, subId, dds, savedSlot, savedSub;
+        final int[] active;
+
+        NoChange(Context context, int target, int subId, Phone[] phones) {
+            assignment = Snapshot.capture(phones);
+            this.target = target;
+            this.subId = subId;
+            dds = SubscriptionManager.getDefaultDataSubscriptionId();
+            savedSlot =
+                    Settings.System.getInt(
+                            context.getContentResolver(), "switch_dual_card_slots", -1);
+            savedSub =
+                    Settings.System.getInt(
+                            context.getContentResolver(), "last_main_card_subid", -1);
+            active = new int[2];
+            SubscriptionManager subscriptions = context.getSystemService(SubscriptionManager.class);
+            for (int i = 0; i < 2; i++) {
+                active[i] =
+                        subscriptions.getActiveSubscriptionInfo(assignment.subIds[i]) == null
+                                ? -1
+                                : assignment.subIds[i];
+                if (active[i] >= 0
+                        && (assignment.cards[i] == null
+                                || assignment.profiles[i] == null
+                                || assignment.profiles[i].isEmpty()))
+                    throw new IllegalStateException("Card identity unavailable");
+            }
+        }
+
+        static NoChange capture(Context context, int target, int subId) {
+            return new NoChange(context, target, subId, PhoneFactory.getPhones());
+        }
+
+        boolean same(NoChange other) {
+            return target == other.target
+                    && subId == other.subId
+                    && dds == other.dds
+                    && savedSlot == other.savedSlot
+                    && savedSub == other.savedSub
+                    && java.util.Arrays.equals(active, other.active)
+                    && assignment.sameAssignment(other.assignment);
+        }
+    }
+
+    public static void select(Context context, int subId, Consumer<Result> completion) {
+        UiccController.getInstance().post(() -> begin(context, subId, completion, true));
+    }
+
+    static void restore(Context context, int subId, Consumer<Result> completion) {
+        UiccController.getInstance().post(() -> begin(context, subId, completion, false));
+    }
+
+    private static void begin(
+            Context context, int subId, Consumer<Result> completion, boolean commitData) {
+        LpaOperationLease leases = null;
+        Object token = null;
+        String progress = "PRECHECK";
+        try {
+            SepMuxTrial.requireLdyAn00Identity(Build.MODEL, Build.DEVICE);
+            HonorSimRouteCallGuard.requireIdle();
+            SubscriptionManager subscriptions = context.getSystemService(SubscriptionManager.class);
+            if (subscriptions == null || subscriptions.getActiveSubscriptionInfo(subId) == null)
+                throw new IllegalStateException("Inactive subscription");
+            int phoneId = SubscriptionManager.getPhoneId(subId);
+            Phone[] phones = PhoneFactory.getPhones();
+            if (phones == null || phones.length != 2 || phoneId < 0 || phoneId >= phones.length)
+                throw new IllegalStateException("Target phone unavailable");
+            if (Settings.Global.getInt(
+                                    context.getContentResolver(),
+                                    Settings.Global.AIRPLANE_MODE_ON,
+                                    0)
+                            != 0
+                    || !phones[phoneId].isRadioOn())
+                throw new IllegalStateException("Target radio is off");
+            for (Phone phone : phones) {
+                if (phone == null || !phone.isRadioAvailable())
+                    throw new IllegalStateException("Radio unavailable");
+            }
+            Snapshot before = Snapshot.capture(phones);
+            if (before.rafs[0] != before.rafs[1])
+                throw new IllegalStateException("Equal RAF cohort required");
+            if (phoneId < 0 || phoneId >= phones.length || before.subIds[phoneId] != subId)
+                throw new IllegalStateException("Subscription changed");
+            int oldDds = SubscriptionManager.getDefaultDataSubscriptionId();
+            int oldSlot =
+                    Settings.System.getInt(
+                            context.getContentResolver(), "switch_dual_card_slots", -1);
+            int oldSub =
+                    Settings.System.getInt(
+                            context.getContentResolver(), "last_main_card_subid", -1);
+            leases = HonorLpaLeaseService.leases(context);
+            synchronized (leases) {
+                HonorLpaLeaseService.recoveryFence(context).requireNormal();
+                if (SepMuxJournal.unresolvedHistory(new AtomicSepMuxStore(context)))
+                    throw new IllegalStateException("Unresolved SIM route");
+                if (leases.primarySelectionUnresolved()) {
+                    completion.accept(Result.UNKNOWN);
+                    return;
+                }
+                if (leases.primarySelectionActive()) {
+                    completion.accept(Result.BUSY);
+                    return;
+                }
+                token = leases.beginPrimarySelection();
+                progress = "RESERVED";
+                settledNoChange = null;
+            }
+            LpaOperationLease reserved = leases;
+            Object exactToken = token;
+            java.util.concurrent.atomic.AtomicBoolean completed =
+                    new java.util.concurrent.atomic.AtomicBoolean();
+            Handler resultHandler =
+                    new Handler(
+                            UiccController.getInstance().getLooper(),
+                            message -> {
+                                AsyncResult response =
+                                        message.obj instanceof AsyncResult
+                                                ? (AsyncResult) message.obj
+                                                : null;
+                                if (response == null || response.userObj != exactToken) return true;
+                                if (!completed.compareAndSet(false, true)) return true;
+                                PrimaryCapabilityResult outcome =
+                                        response.exception == null
+                                                        && response.result
+                                                                instanceof PrimaryCapabilityResult
+                                                ? (PrimaryCapabilityResult) response.result
+                                                : PrimaryCapabilityResult.UNKNOWN;
+                                // The exact ProxyController terminal settles only this RAF request.
+                                // Current subscriber/preference checks below still gate every DDS write.
+                                boolean settled = outcome == PrimaryCapabilityResult.VERIFIED_COMMIT
+                                        || outcome == PrimaryCapabilityResult.VERIFIED_NO_CHANGE
+                                        || outcome == PrimaryCapabilityResult.VERIFIED_ROLLBACK;
+                                Result result = settled ? Result.REFUSED : Result.UNKNOWN;
+                                try {
+                                    Snapshot after = Snapshot.capture(PhoneFactory.getPhones());
+                                    if (outcome == PrimaryCapabilityResult.VERIFIED_ROLLBACK
+                                            && before.sameAssignment(after)) {
+                                        settled = true;
+                                        result = Result.REFUSED;
+                                    } else if ((outcome == PrimaryCapabilityResult.VERIFIED_COMMIT
+                                                    && before.sameSubscriptionsAndRafs(after)
+                                                    && after.primary == phoneId
+                                                    && before.uuids[before.primary].equals(after.uuids[phoneId])
+                                                    && before.uuids[1-before.primary].equals(after.uuids[1-phoneId]))
+                                            || (outcome
+                                                            == PrimaryCapabilityResult
+                                                                    .VERIFIED_NO_CHANGE
+                                                    && before.sameAssignment(after))) {
+                                        // Successful capability completion is not permission to
+                                        // override a newer choice.
+                                        settled = true;
+                                        HonorSimRouteCallGuard.requireIdle();
+                                        if ((!commitData
+                                                        && (Settings.System.getInt(
+                                                                                context
+                                                                                        .getContentResolver(),
+                                                                                "switch_dual_card_slots",
+                                                                                -1)
+                                                                        != oldSlot
+                                                                || Settings.System.getInt(
+                                                                                context
+                                                                                        .getContentResolver(),
+                                                                                "last_main_card_subid",
+                                                                                -1)
+                                                                        != oldSub
+                                                                || SubscriptionManager
+                                                                                .getDefaultDataSubscriptionId()
+                                                                        != oldDds))
+                                                || subscriptions.getActiveSubscriptionInfo(subId)
+                                                        == null
+                                                || (commitData
+                                                        && SubscriptionManager
+                                                                        .getDefaultDataSubscriptionId()
+                                                                != oldDds))
+                                            throw new IllegalStateException("Data choice changed");
+                                        if (commitData
+                                                && !HonorPrimaryDataPreference.remember(
+                                                        context, phoneId, subId)) {
+                                            // The primary transaction is verified, but DDS has not
+                                            // changed.
+                                            throw new IllegalStateException(
+                                                    "Primary preference not saved");
+                                        }
+                                        if (commitData) subscriptions.setDefaultDataSubId(subId);
+                                        result =
+                                                !commitData
+                                                                || SubscriptionManager
+                                                                                .getDefaultDataSubscriptionId()
+                                                                        == subId
+                                                        ? Result.COMMITTED
+                                                        : Result.REFUSED;
+                                    }
+                                    if (!settled) android.util.Log.w("HonorPrimaryData",
+                                            "Unsettled outcome=" + outcome + " subscriptionsAndRafs=" + before.sameSubscriptionsAndRafs(after)
+                                                    + " assignment=" + before.sameAssignment(after) + " targetPrimary=" + (after.primary == phoneId));
+                                } catch (RuntimeException unavailable) {
+                                    if (settled) result = Result.REFUSED;
+                                    else android.util.Log.w("HonorPrimaryData", "Unsettled failure=" + unavailable.getClass().getSimpleName());
+                                } finally {
+                                    android.util.Log.i("HonorPrimaryData", "event=TERMINAL outcome=" + outcome
+                                            + " settled=" + settled + " commitData=" + commitData + " result=" + result);
+                                    reserved.finishPrimarySelection(exactToken, settled);
+                                    completion.accept(result);
+                                    if (result == Result.COMMITTED
+                                            && outcome
+                                                    == PrimaryCapabilityResult.VERIFIED_NO_CHANGE) {
+                                        // Capture after the owner records bootstrap USER intent.
+                                        // Missing identity disables suppression, never the
+                                        // selection.
+                                        try {
+                                            NoChange observation =
+                                                    NoChange.capture(context, phoneId, subId);
+                                            settledNoChange =
+                                                    before.sameAssignment(observation.assignment)
+                                                            ? observation
+                                                            : null;
+                                        } catch (RuntimeException unavailable) {
+                                            settledNoChange = null;
+                                        }
+                                    }
+                                }
+                                return true;
+                            });
+            progress = "PROXY_DISPATCH";
+            boolean accepted =
+                    ProxyController.getInstance()
+                            .setPrimaryRadioCapability(
+                                    phoneId, resultHandler.obtainMessage(1, exactToken));
+            android.util.Log.i("HonorPrimaryData", "event=ADMISSION accepted=" + accepted
+                    + " commitData=" + commitData);
+            if (!accepted) {
+                // ProxyController rejected before registering a callback or sending native work.
+                boolean unchanged = false;
+                try {
+                    unchanged = before.sameAssignment(Snapshot.capture(PhoneFactory.getPhones()));
+                } catch (RuntimeException unavailable) {
+                    android.util.Log.w("HonorPrimaryData", "event=NO_ADMISSION_SNAPSHOT failure="
+                            + unavailable.getClass().getSimpleName());
+                }
+                reserved.finishPrimarySelection(exactToken, true);
+                token = null; // A later consumer exception cannot poison an already released token.
+                android.util.Log.i("HonorPrimaryData", "event=NO_ADMISSION_RELEASE assignment="
+                        + unchanged + " nativeDispatch=NO");
+                completion.accept(unchanged ? Result.BUSY : Result.REFUSED);
+            }
+        } catch (HonorSimRouteCallGuard.CallBusy busy) {
+            android.util.Log.i("HonorPrimaryData", "event=REFUSAL progress=" + progress + " reason=CALL_BUSY");
+            completion.accept(Result.BUSY);
+        } catch (Exception unavailable) {
+            android.util.Log.w("HonorPrimaryData", "event=FAIL progress=" + progress
+                    + " reserved=" + (token != null) + " failure=" + unavailable.getClass().getSimpleName());
+            // A throwing dispatch may have entered native work. No replay or DDS write.
+            if (leases != null && token != null) leases.finishPrimarySelection(token, false);
+            completion.accept(token == null ? Result.REFUSED : Result.UNKNOWN);
+        }
+    }
+
+    private static final class Snapshot {
+        final int[] subIds, rafs;
+        final String[] uuids, profiles;
+        final Object[] cards;
+        final int primary;
+
+        private Snapshot(
+                int[] subIds,
+                int[] rafs,
+                String[] uuids,
+                String[] profiles,
+                Object[] cards,
+                int primary) {
+            this.subIds = subIds;
+            this.rafs = rafs;
+            this.uuids = uuids;
+            this.profiles = profiles;
+            this.cards = cards;
+            this.primary = primary;
+        }
+
+        static Snapshot capture(Phone[] phones) {
+            if (phones == null || phones.length != 2)
+                throw new IllegalStateException("Two phones required");
+            int[] subIds = new int[2], rafs = new int[2];
+            String[] uuids = new String[2], profiles = new String[2];
+            Object[] cards = new Object[2];
+            int primary = -1;
+            for (int i = 0; i < 2; i++) {
+                Phone phone = phones[i];
+                RadioCapability capability = phone == null ? null : phone.getRadioCapability();
+                if (capability == null) throw new IllegalStateException("Capability unavailable");
+                subIds[i] = phone.getSubId();
+                profiles[i] = phone.getFullIccSerialNumber();
+                cards[i] = UiccController.getInstance().getUiccCardForPhone(i);
+                rafs[i] = capability.getRadioAccessFamily();
+                uuids[i] = capability.getLogicalModemUuid();
+                if (uuids[i] == null || uuids[i].isEmpty())
+                    throw new IllegalStateException("UUID unavailable");
+                if (uuids[i].contains("ps0")) {
+                    if (primary != -1) throw new IllegalStateException("Ambiguous primary");
+                    primary = i;
+                }
+            }
+            if (primary < 0 || uuids[0].equals(uuids[1]))
+                throw new IllegalStateException("Ambiguous mapping");
+            return new Snapshot(subIds, rafs, uuids, profiles, cards, primary);
+        }
+
+        boolean sameSubscriptionsAndRafs(Snapshot other) {
+            return java.util.Arrays.equals(subIds, other.subIds)
+                    && java.util.Arrays.equals(rafs, other.rafs)
+                    && java.util.Arrays.equals(profiles, other.profiles)
+                    && cards[0] == other.cards[0]
+                    && cards[1] == other.cards[1];
+        }
+
+        boolean sameAssignment(Snapshot other) {
+            return sameSubscriptionsAndRafs(other) && java.util.Arrays.equals(uuids, other.uuids);
+        }
+    }
+}
