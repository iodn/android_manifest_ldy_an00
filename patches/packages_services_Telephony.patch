+package android.os;
+import java.util.ArrayList;
+public class Handler {
+ public static long now=1;private static final ArrayList<Event> queue=new ArrayList<>();
+ private record Event(long when,Runnable task,Looper looper){}private final Looper looper;
+ public Handler(){this(Looper.MAIN);}public Handler(Looper looper){this.looper=looper;}public Looper getLooper(){return looper;}
+ public Message obtainMessage(int what,Object obj){Message m=new Message();m.what=what;m.obj=obj;m.target=this;return m;}
+ public boolean post(Runnable task){return postDelayed(task,0);}
+ public boolean postDelayed(Runnable task,long delay){synchronized(queue){queue.add(new Event(now+delay,task,looper));}return true;}
+ public void removeCallbacks(Runnable task){synchronized(queue){queue.removeIf(e->e.task==task);}}
+ public void handleMessage(Message message){}
+ public static void runReady(){int count=0;while(true){Event event;synchronized(queue){int i=-1;for(int j=0;j<queue.size();j++)if(queue.get(j).when<=now){i=j;break;}if(i<0)return;if(++count>1000)throw new AssertionError("unbounded callback chain");event=queue.remove(i);}Looper old=Looper.myLooper();Looper.setForTest(event.looper);try{event.task.run();}finally{Looper.setForTest(old);}}}
+ public static void reset(){queue.clear();now=1;Looper.setForTest(Looper.MAIN);}
+ public static void advance(long time){now+=time;runReady();}
+}
