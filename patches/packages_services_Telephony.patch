+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.phone;
+
+import android.Manifest;
+import android.app.Service;
+import android.content.Intent;
+import android.content.pm.PackageManager;
+import android.os.Build;
+import android.os.Bundle;
+import android.os.Handler;
+import android.os.IBinder;
+import android.os.Looper;
+import android.os.Message;
+import android.os.Messenger;
+import android.os.Process;
+import android.os.RemoteException;
+import android.os.SystemProperties;
+import android.os.UserHandle;
+import android.os.UserManager;
+
+import com.android.internal.telephony.honor.HonorSepTrialOwner;
+import com.android.internal.telephony.honor.HonorSimRouteCallGuard;
+import com.android.internal.telephony.euicc.EuiccController;
+import com.android.internal.telephony.euicc.HonorEuiccEndpointPreparation;
+import com.android.internal.telephony.honor.HonorSepTrialOwner.UiSnapshot;
+import com.android.internal.telephony.honor.HonorSepTrialOwner.UiState;
+
+/** Privileged route owner for native Settings. Binding and snapshots are passive.
+ * Settings shares the system UID: authentication admits that trusted UID principal,
+ * not an independently isolated package identity within the shared UID.
+ */
+public final class HonorLdyAn00EsimSetupService extends Service {
+    // Protocol v1: snapshot=1, select eUICC=2, return physical SIM2=3; reply=1.
+    private static final int SNAPSHOT = 1, SELECT_EUICC = 2, SELECT_PHYSICAL = 3;
+    // Phone-process lifetime, intentionally not reset when the UI disconnects or rotates.
+    private static boolean sPreparationRequested, sOutboundRequested, sReturnRequested, sStopped;
+    private static int sSelectedPhaseSerial = -1;
+    private static Selection sPendingSelection;
+    private static final class Selection {
+        final Object owner,request;
+        final int phase,previousPhase;
+        final boolean previousOutbound,previousReturn;
+        int managementOriginMode = -1, managementOriginRequest = -1;
+        long managementOriginGeneration;
+        Object managementOriginClient;
+        Selection(Object owner,Object request,int phase,int previousPhase,
+                boolean previousOutbound,boolean previousReturn) {
+            this.owner=owner;this.request=request;this.phase=phase;this.previousPhase=previousPhase;
+            this.previousOutbound=previousOutbound;this.previousReturn=previousReturn;
+        }
+    }
+    /** Only an exact early Owner NO_ADMISSION callback can release a consumed choice. */
+    private static boolean releaseNoAdmission(Selection selection,Object owner,Object request,int phase) {
+        if(selection==null || sPendingSelection!=selection || selection.owner!=owner
+                || selection.request!=request || selection.phase!=phase || sSelectedPhaseSerial!=phase)
+            return false;
+        sSelectedPhaseSerial=selection.previousPhase;
+        sOutboundRequested=selection.previousOutbound;sReturnRequested=selection.previousReturn;
+        sPendingSelection=null;return true;
+    }
+    private volatile boolean mDestroyed;
+    // v2 is profile readiness only. v1 route/snapshot messages keep their original contract.
+    private static final int PREPARE_PROFILE_ENDPOINT = 4, CANCEL_PROFILE_PREPARATION = 5;
+    private final Handler mProfileHandler = new Handler(Looper.getMainLooper());
+    private ProfilePreparation mProfilePreparation;
+    private static final class ProfilePreparation {
+        final Messenger reply;
+        final int id, uid;
+        volatile boolean active = true;
+        IBinder.DeathRecipient death;
+        boolean linked;
+        ProfilePreparation(Messenger reply, int id, int uid) {
+            this.reply = reply; this.id = id; this.uid = uid;
+        }
+    }
+
+    private static final class Reply {
+        final Messenger messenger;
+        final int requestId, phaseSerial;
+        final boolean noSelectionSupported, physicalObservationSupported;
+        Reply(Messenger messenger,int requestId,int phaseSerial,boolean noSelectionSupported) {
+            this(messenger,requestId,phaseSerial,noSelectionSupported,false);
+        }
+        Reply(Messenger messenger,int requestId,int phaseSerial,boolean noSelectionSupported,
+                boolean physicalObservationSupported) {
+            this.physicalObservationSupported=physicalObservationSupported;
+            this.messenger = messenger;
+            this.requestId = requestId;
+            this.phaseSerial = phaseSerial;
+            this.noSelectionSupported = noSelectionSupported;
+        }
+    }
+    private final Messenger mIncoming = new Messenger(new Handler(Looper.getMainLooper(), msg -> {
+        handle(msg);
+        return true;
+    }));
+
+    @Override public IBinder onBind(Intent intent) { return mIncoming.getBinder(); }
+
+    @Override public void onDestroy() {
+        mDestroyed = true;
+        finishProfile(mProfilePreparation, HonorEuiccEndpointPreparation.Result.REFUSED);
+        // Fence stale Binder clients only. The Phone-process owner and journal remain intact.
+        super.onDestroy();
+    }
+
+    private boolean admitted(int uid) {
+        if (Process.myUid() != Process.PHONE_UID || UserHandle.myUserId() != 0
+                || !"ldy_an00".equals(Build.DEVICE) || !"LDY-AN00".equals(Build.MODEL)
+                || !SystemProperties.getBoolean("ro.lineage.ldy_an00.esim_bridge", false)) {
+            return false;
+        }
+        UserManager users = getSystemService(UserManager.class);
+        if (users == null || !users.isUserUnlocked()
+                || users.hasUserRestriction(UserManager.DISALLOW_CONFIG_MOBILE_NETWORKS)) {
+            return false;
+        }
+        PackageManager pm = getPackageManager();
+        try {
+            return uid == pm.getApplicationInfo("com.android.settings", 0).uid
+                    && pm.checkSignatures("android", "com.android.settings")
+                        == PackageManager.SIGNATURE_MATCH
+                    && checkPermission(Manifest.permission.MODIFY_PHONE_STATE, -1, uid)
+                        == PackageManager.PERMISSION_GRANTED;
+        } catch (PackageManager.NameNotFoundException missing) { return false; }
+    }
+
+    private void handle(Message msg) {
+        if (mDestroyed) return;
+        if (!admitted(msg.sendingUid)) return;
+        if (msg.replyTo == null || msg.arg1 <= 0) return;
+        if (msg.what == PREPARE_PROFILE_ENDPOINT || msg.what == CANCEL_PROFILE_PREPARATION) {
+            handleProfile(msg);
+            return;
+        }
+        Reply reply = new Reply(msg.replyTo, msg.arg1, msg.getData().getInt("phase_serial", -1),
+                msg.getData().getInt("profile_route_protocol", 0) == 1,
+                msg.getData().getInt("route_observation_protocol", 0) == 1);
+        if (msg.getData().getInt("version", 0) != 1) {
+            reply(reply, "UNAVAILABLE", false); return;
+        }
+        int caller = msg.sendingUid;
+        if (msg.what == SNAPSHOT) { snapshot(reply); return; }
+        if (msg.what != SELECT_EUICC && msg.what != SELECT_PHYSICAL) return;
+        if (sStopped) { reply(reply, "UNKNOWN", false); return; }
+        if (!msg.getData().getBoolean("confirmed", false) || reply.phaseSerial < 0) {
+            reply(reply, "UNAVAILABLE", false); return;
+        }
+        boolean physical = msg.what == SELECT_PHYSICAL;
+        try { HonorSimRouteCallGuard.requireIdle(); }
+        catch (HonorSimRouteCallGuard.CallBusy busy) {
+            reply(reply,"CALL_BUSY",false,reply.phaseSerial,physical); return; // No choice or command.
+        } catch (RuntimeException unavailable) {
+            reply(reply, "UNAVAILABLE", false); return;
+        }
+        HonorSepTrialOwner owner = HonorSepTrialOwner.existingPreparedOwner();
+        if (owner != null) { select(owner, physical, caller, reply, false); return; }
+        if (sPreparationRequested || sOutboundRequested || sReturnRequested) {
+            snapshot(reply); return;
+        }
+        boolean debug = msg.getData().getBoolean("trusted_debug_consent", false);
+        // A trusted test image requires its separate, explicit warning confirmation.
+        if (HonorSepTrialOwner.isTrustedDebugTestImage() && !debug) {
+            reply(reply, "UNAVAILABLE", false); return;
+        }
+        sPreparationRequested = true;
+        try {
+            HonorSepTrialOwner.prepareAsync(debug, prepared -> {
+                if (mDestroyed) return;
+                if (!admitted(caller)) { stop(reply); return; }
+                select(prepared, physical, caller, reply, true);
+            }, ignored -> stop(reply));
+        } catch (RuntimeException refused) { stop(reply); }
+    }
+
+    private void handleProfile(Message msg) {
+        Bundle args = msg.getData();
+        if (args.getInt("version", 0) != 2) {
+            sendProfile(new ProfilePreparation(msg.replyTo, msg.arg1, msg.sendingUid),
+                    HonorEuiccEndpointPreparation.Result.REFUSED);
+            return;
+        }
+        ProfilePreparation old = mProfilePreparation;
+        if (msg.what == CANCEL_PROFILE_PREPARATION) {
+            if (old != null && old.id == msg.arg1 && old.uid == msg.sendingUid
+                    && old.reply.getBinder().equals(msg.replyTo.getBinder()))
+                finishProfile(old, HonorEuiccEndpointPreparation.Result.REFUSED);
+            return;
+        }
+        if (old != null && old.id == msg.arg1 && old.uid == msg.sendingUid
+                && old.reply.getBinder().equals(msg.replyTo.getBinder())) return;
+        ProfilePreparation request = new ProfilePreparation(msg.replyTo, msg.arg1, msg.sendingUid);
+        if (old != null || !args.getBoolean("confirmed", false)
+                || !args.containsKey("subscription_id") || !args.containsKey("card_id")
+                || !args.containsKey("port_index")) {
+            sendProfile(request, HonorEuiccEndpointPreparation.Result.REFUSED);
+            return;
+        }
+        int subId = args.getInt("subscription_id", -1), cardId = args.getInt("card_id", -1);
+        int port = args.getInt("port_index", -2);
+        if (port == -1) port = 0; // Qualified backend has only historical default port0.
+        if (subId < 0 || cardId < 0 || port != 0
+                || checkPermission(Manifest.permission.WRITE_EMBEDDED_SUBSCRIPTIONS,
+                        -1, request.uid) != PackageManager.PERMISSION_GRANTED) {
+            sendProfile(request, HonorEuiccEndpointPreparation.Result.REFUSED);
+            return;
+        }
+        mProfilePreparation = request;
+        request.death = () -> mProfileHandler.post(() -> finishProfile(request,
+                HonorEuiccEndpointPreparation.Result.REFUSED));
+        try {
+            request.reply.getBinder().linkToDeath(request.death, 0);
+            request.linked = true;
+            EuiccController.get().prepareHonorProfileEndpoint(request.uid, "com.android.settings",
+                    subId, cardId, port, () -> request.active && !mDestroyed,
+                    result -> mProfileHandler.post(() -> finishProfile(request, result)));
+        } catch (RemoteException | RuntimeException refused) {
+            finishProfile(request, HonorEuiccEndpointPreparation.Result.REFUSED);
+        }
+    }
+
+    private void finishProfile(ProfilePreparation request,
+            HonorEuiccEndpointPreparation.Result result) {
+        if (request == null || !request.active || mProfilePreparation != request) return;
+        request.active = false; // Observation cancellation does not release an Owner native read.
+        mProfilePreparation = null;
+        if (request.linked) {
+            try { request.reply.getBinder().unlinkToDeath(request.death, 0); }
+            catch (java.util.NoSuchElementException alreadyDead) { }
+        }
+        if (mDestroyed || !admitted(request.uid))
+            result = HonorEuiccEndpointPreparation.Result.REFUSED;
+        sendProfile(request, result);
+    }
+
+    private void sendProfile(ProfilePreparation request, HonorEuiccEndpointPreparation.Result result) {
+        Bundle data = new Bundle();
+        data.putInt("version", 2);
+        data.putString("preparation_result", result.name());
+        Message response = Message.obtain(null, PREPARE_PROFILE_ENDPOINT);
+        response.arg1 = request.id;
+        response.setData(data);
+        try { request.reply.send(response); }
+        catch (RemoteException gone) { /* The Owner read fence is independent of the observer. */ }
+    }
+
+    private void select(HonorSepTrialOwner owner, boolean physical, int caller, Reply reply,
+            boolean coldPreparedHere) {
+        if (mDestroyed) return;
+        try {
+            owner.requestUiSnapshot(state -> {
+                if (mDestroyed) return;
+                if (!admitted(caller) || sStopped
+                        || HonorSepTrialOwner.existingPreparedOwner() != owner) {
+                    stop(reply); return;
+                }
+                if (coldPreparedHere && !physical && reply.noSelectionSupported
+                        && reply.phaseSerial == 0 && state.state == UiState.EUICC_READY) {
+                    // This exact cold request completed read-only CLEAN mode1 adoption. No SELECT
+                    // was submitted, no route serial allocated and no process choice latch set.
+                    reply(reply, "EUICC_READY", state.canReturnPhysical, state.phaseSerial, false, true);
+                    return;
+                }
+                if(coldPreparedHere && physical && reply.noSelectionSupported
+                        && reply.physicalObservationSupported && reply.phaseSerial==0
+                        && state.state==UiState.PHYSICAL_READY) {
+                    // Genuine current mode0+CI/controller proof. No setter or +1 phase exists.
+                    reply(reply,"PHYSICAL_READY",false,state.phaseSerial,true,true);
+                    return;
+                }
+                boolean eligible = physical
+                        ? state.canReturnPhysical
+                            && (state.state == UiState.EUICC_READY
+                                || state.state == UiState.EUICC_WAITING
+                                || state.state == UiState.KNOWN_BLANK)
+                        : state.state == UiState.IDLE || state.state == UiState.PHYSICAL_READY;
+                if (!eligible || reply.phaseSerial == sSelectedPhaseSerial) {
+                    reply(reply, "UNAVAILABLE", false);
+                    return;
+                }
+                if (reply.phaseSerial != state.phaseSerial) {
+                    // No Owner request was dispatched for this SELECT. A different, fresh
+                    // confirmation is required; never silently substitute the new token.
+                    reply(reply, "CONFIRMATION_REQUIRED", state.canReturnPhysical,
+                            state.phaseSerial, physical);
+                    return;
+                }
+                try {
+                    HonorSimRouteCallGuard.requireIdle();
+                } catch (HonorSimRouteCallGuard.CallBusy busy) {
+                    reply(reply,"CALL_BUSY",state.canReturnPhysical,state.phaseSerial,physical); return;
+                } catch (RuntimeException unavailable) {
+                    reply(reply, "UNAVAILABLE", false); return;
+                }
+                try {
+                    Selection selection = new Selection(owner,reply,reply.phaseSerial,
+                            sSelectedPhaseSerial,sOutboundRequested,sReturnRequested);
+                    if (!physical && state.state == UiState.PHYSICAL_READY) {
+                        // This exact pre-SET snapshot includes correlated mode0/card proof.
+                        selection.managementOriginMode = 0;
+                        selection.managementOriginRequest = reply.requestId;
+                        selection.managementOriginGeneration = owner.generation();
+                        selection.managementOriginClient = reply.messenger.getBinder();
+                    }
+                    sPendingSelection=selection;
+                    sSelectedPhaseSerial = reply.phaseSerial;
+                    Runnable callBusyBeforeAdmission = () -> owner.requestUiSnapshot(observed ->
+                            mProfileHandler.post(() -> {
+                                if(sStopped || HonorSepTrialOwner.existingPreparedOwner()!=owner
+                                        || observed.state==UiState.UNKNOWN
+                                        || !releaseNoAdmission(selection,owner,reply,observed.phaseSerial))
+                                    return;
+                                // Native work was never admitted; never clear a journal or retry.
+                                if(!mDestroyed && admitted(caller))
+                                    reply(reply,"CALL_BUSY",observed.canReturnPhysical,observed.phaseSerial,physical);
+                            }));
+                    if (physical) {
+                        sReturnRequested = true;
+                        owner.requestPhysicalSim2Once(reply.phaseSerial,callBusyBeforeAdmission);
+                    } else {
+                        sOutboundRequested = true;
+                        owner.requestEuiccVisibilityOnce(reply.phaseSerial,callBusyBeforeAdmission);
+                    }
+                    // UI disconnection never cancels, repeats, or reverses this operation.
+                    snapshot(reply);
+                } catch (RuntimeException refused) { stop(reply); }
+            });
+        } catch (RuntimeException unavailable) { stop(reply); }
+    }
+
+    private void snapshot(Reply reply) {
+        if (mDestroyed) return;
+        if (sStopped) { reply(reply, "UNKNOWN", false); return; }
+        HonorSepTrialOwner owner = HonorSepTrialOwner.existingPreparedOwner();
+        if (owner == null) {
+            if (sOutboundRequested || sReturnRequested) { stop(reply); return; }
+            reply(reply, sPreparationRequested ? "WORKING" : "IDLE", false);
+            return;
+        }
+        try { owner.requestUiSnapshot(state -> sendSnapshot(reply, state)); }
+        catch (RuntimeException unavailable) { stop(reply); }
+    }
+
+    private void sendSnapshot(Reply reply, UiSnapshot state) {
+        if (state.state == UiState.UNKNOWN) sStopped = true;
+        reply(reply, sStopped ? "UNKNOWN" : state.state.name(), state.canReturnPhysical, state.phaseSerial);
+    }
+
+    @Override protected void dump(java.io.FileDescriptor fd,java.io.PrintWriter writer,String[] args) {
+        writer.println("cached_owner="+HonorSepTrialOwner.existingOwnerState());
+        HonorSepTrialOwner owner=HonorSepTrialOwner.existingPreparedOwner();
+        if(owner!=null) {
+            writer.println("cached_read_stage="+owner.cachedReadStage());
+            writer.println(owner.snapshot()); // Existing bounded non-secret event ring; never queries.
+        }
+        writer.println("stopped="+sStopped+" preparation="+sPreparationRequested
+                +" outbound="+sOutboundRequested+" physical="+sReturnRequested);
+    }
+    private void stop(Reply reply) { sStopped = true; reply(reply, "UNKNOWN", false); }
+
+    private void reply(Reply target, String state, boolean canReturn) {
+        reply(target,state,canReturn,0);
+    }
+
+    private void reply(Reply target, String state, boolean canReturn, int phaseSerial) {
+        reply(target,state,canReturn,phaseSerial,false);
+    }
+
+    private void reply(Reply target, String state, boolean canReturn, int phaseSerial, boolean physical) {
+        reply(target, state, canReturn, phaseSerial, physical, false);
+    }
+
+    private void reply(Reply target, String state, boolean canReturn, int phaseSerial,
+            boolean physical, boolean readyWithoutSelection) {
+        Bundle data = new Bundle();
+        data.putInt("version", 1);
+        data.putInt("profile_route_protocol", 1);
+        data.putInt("route_observation_protocol", 1);
+        if (readyWithoutSelection) {
+            data.putBoolean("ready_without_selection", true);
+            data.putBoolean("ready_target_physical", physical);
+            data.putInt("consent_phase_serial", target.phaseSerial);
+        }
+        data.putInt("phase_serial", phaseSerial);
+        if ("CONFIRMATION_REQUIRED".equals(state) || "CALL_BUSY".equals(state))
+            data.putBoolean("target_physical", physical);
+        data.putString("state", state);
+        HonorSepTrialOwner cachedOwner=HonorSepTrialOwner.existingPreparedOwner();
+        Selection origin = sPendingSelection;
+        if (!sStopped && cachedOwner != null && origin != null && origin.owner == cachedOwner
+                && origin.managementOriginMode == 0
+                && origin.managementOriginGeneration == cachedOwner.generation()
+                && origin.managementOriginClient == target.messenger.getBinder()
+                && origin.phase < Integer.MAX_VALUE && phaseSerial == origin.phase + 1
+                && ("EUICC_READY".equals(state) || "KNOWN_BLANK".equals(state))) {
+            data.putInt("management_origin_protocol", 1);
+            data.putInt("management_origin_mode", 0);
+            data.putInt("management_origin_phase", origin.phase);
+            data.putInt("management_origin_request", origin.managementOriginRequest);
+            data.putLong("management_origin_generation", origin.managementOriginGeneration);
+        }
+        data.putString("backend_stage",cachedOwner==null ? "OWNER_UNAVAILABLE" : cachedOwner.cachedReadStage());
+        data.putBoolean("can_return", !sStopped && canReturn);
+        data.putBoolean("test_image", HonorSepTrialOwner.isTrustedDebugTestImage());
+        Message response = Message.obtain(null, SNAPSHOT);
+        response.arg1 = target.requestId;
+        response.setData(data);
+        try { target.messenger.send(response); }
+        catch (RemoteException gone) { /* Observing UI died; the owner must continue unchanged. */ }
+    }
+}
