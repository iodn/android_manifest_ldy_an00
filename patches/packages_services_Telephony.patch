+    static void installDcRecovery(HonorImsDcController.InputsProvider inputs,
+            HonorImsDcController.Backend backend) {
+        UiccController.getInstance().post(() -> {
+            if (dcInputs != null) return;
+            dcInputs = java.util.Objects.requireNonNull(inputs);
+            dcBackend = java.util.Objects.requireNonNull(backend);
+            if (instance != null) {
+                instance.attachDcRecovery();
+                instance.enqueue();
+            }
+        });
+    }
