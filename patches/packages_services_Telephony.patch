+                    }
+                } catch(Exception unavailable) {reply.code=HonorScopedApduChannel.UNKNOWN;abandonExact(scope,client);}
+                var trace=lifecycle(channel.actionStage);
+                boolean positiveTerminal=reply.code==HonorScopedApduChannel.OPENED
+                        || reply.code==HonorScopedApduChannel.CLOSED || reply.code==HonorScopedApduChannel.RESPONSE;
+                trace.facts(positiveTerminal ? Proof.YES : Proof.UNKNOWN,Proof.YES,
+                        positiveTerminal ? Proof.YES : Proof.UNKNOWN);
+                trace.returned(returnedOutcome(reply,channel.actionStage));
+                future.complete(reply);
+            }
+        };
+        return receiver.obtainMessage(0,future);
+    }
+    private HonorLpaChannelResult channelAction(LpaOperationLease.Scope scope,IBinder client,long id,boolean close,byte[] command) {
+        AtomicBoolean cancelled=new AtomicBoolean();
+        java.util.concurrent.atomic.AtomicReference<Channel> captured=new java.util.concurrent.atomic.AtomicReference<>();
+        java.util.concurrent.CompletableFuture<HonorLpaChannelResult> future=onController(()->{
+            LpaOperationLease state=leases(this);
+            synchronized(state) {
+                requireBinding(scope,client);
