+package com.android.internal.telephony.honor;
+
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.atomic.AtomicReference;
+
+/** Real production publication helper: deterministic ordering/interleavings, no Android/phone. */
+public final class EndpointPublicationTest {
+    private static int checks;
+    private static void check(boolean ok) { checks++; if(!ok) throw new AssertionError("case "+checks); }
+    public static void main(String[] args) throws Exception {
+        EndpointPublication p=new EndpointPublication(); Object a=new Object(), b=new Object();
+        var first=p.admit(); p.bind(first,a,1,11);
+        check(p.completed(first,b,1,11,SepMuxTrial.Selector.EUICC)==null);
+        check(p.completed(first,a,2,11,SepMuxTrial.Selector.EUICC)==null);
+        check(p.completed(first,a,1,12,SepMuxTrial.Selector.EUICC)==null);
+        var token=p.completed(first,a,1,11,SepMuxTrial.Selector.EUICC);
+        check(token!=null && p.fence.get()==token);
+        check(p.completed(first,a,1,11,SepMuxTrial.Selector.EUICC)==null);
+        var second=p.admit();
+        check(second.retired==token && p.fence.get()==null); // Synchronous before any worker runs.
+        check(p.completed(first,a,1,11,SepMuxTrial.Selector.EUICC)==null);
+        p.bind(second,b,1,12);
+        check(p.completed(second,b,1,12,SepMuxTrial.Selector.PHYSICAL)==null);
+        check(p.fence.get()==null);
+        check(p.completed(second,b,1,12,SepMuxTrial.Selector.EUICC)==null); // Cannot reinterpret target.
+
+        EndpointPublication race=new EndpointPublication();
+        var old=race.admit(); race.bind(old,a,7,11);
+        CountDownLatch admitted=new CountDownLatch(1), completed=new CountDownLatch(1);
+        AtomicReference<Throwable> failure=new AtomicReference<>();
+        Thread callback=new Thread(()->{try {
+            admitted.await();
+            if(race.completed(old,a,7,11,SepMuxTrial.Selector.EUICC)!=null)
+                throw new AssertionError("old callback republished after newer admission");
+        } catch(Throwable t) {failure.set(t);} finally {completed.countDown();}});
+        callback.start();
+        var current=race.admit(); admitted.countDown(); completed.await(); callback.join();
+        check(failure.get()==null && race.fence.get()==null);
+        race.bind(current,b,7,12);
+        var currentToken=race.completed(current,b,7,12,SepMuxTrial.Selector.EUICC);
+        check(currentToken!=null && currentToken!=token);
+        // Queued cleanup carries the retired token, never "close whatever observer is current".
+        check(!race.fence.compareAndSet(token,null) && race.fence.get()==currentToken);
+        check(race.fence.compareAndSet(currentToken,null)); // Actual card-retirement fence operation.
+        check(race.completed(current,b,7,12,SepMuxTrial.Selector.EUICC)==null); // No republish.
+        race.lose();
+        check(race.completed(current,b,7,12,SepMuxTrial.Selector.EUICC)==null);
+        boolean refused=false;try {race.admit();}catch(IllegalStateException expected){refused=true;}
+        check(refused);
+
+        // Production journal/model plus the SAME callback exception boundary used by Adapter.
+        var disk=new SepMuxJournalTest.Disk(java.nio.file.Files.createTempDirectory("sep-pub-").resolve("state"));
+        var journal=new SepMuxJournal(disk);journal.pending(7,11,SepMuxTrial.Selector.EUICC);
+        var model=SepMuxJournalTest.model(7,11);SepMuxJournalTest.complete(model);
+        journal.completed(7,11,model); // Must finish BEFORE knownEndpoint delivery.
+        EndpointPublication ui=new EndpointPublication();var ticket=ui.admit();ui.bind(ticket,a,7,11);
+        boolean delivered=EndpointPublication.notifyKnown(()->{
+            var published=ui.completed(ticket,a,7,11,SepMuxTrial.Selector.EUICC);
+            try {throw new IllegalStateException("observer scheduling failed");}
+            catch(RuntimeException e) {ui.fence.compareAndSet(published,null);throw e;}
+        });
+        check(!delivered && ui.fence.get()==null);
+        journal.requireClean();check(disk.read().startsWith("SEP1 CLEAN "));
+        check(model.canRequestPhysicalReturn()); // No outer stop/persistUnknown from callback error.
+        check(ui.completed(ticket,a,7,11,SepMuxTrial.Selector.EUICC)==null);
+        check(EndpointPublication.notifyKnown(()->{}));
+        // SAME production event boundary used by Observer.handleMessage, not an Android simulation.
+        var eventEpoch=new EuiccReadiness.Epoch(7);
+        var eventFence=new AtomicReference<EuiccReadiness.Epoch>(eventEpoch);
+        int[] revoked={0};
+        var eventReadiness=new EuiccReadiness(eventEpoch);
+        var snapshot=new EuiccReadiness.Snapshot(eventEpoch,0,new Object(),new Object(),new Object(),
+                1,1,0,7,7,true,true,true,true,"1".repeat(32));
+        check(eventReadiness.observe(snapshot,snapshot));
+        check(!EuiccReadiness.eventBoundary(()->{
+            throw new ClassCastException("injected mixed-card mapping failure");
+        },()->{eventFence.compareAndSet(eventEpoch,null);eventReadiness.invalidate();revoked[0]++;}));
+        check(eventFence.get()==null && revoked[0]==1);
+        check(!eventReadiness.recheck(snapshot,snapshot));
+        journal.requireClean();check(disk.read().startsWith("SEP1 CLEAN "));
+        check(model.canRequestPhysicalReturn());
+        var newerEventEpoch=new EuiccReadiness.Epoch(7);eventFence.set(newerEventEpoch);
+        check(!EuiccReadiness.eventBoundary(()->{throw new IllegalStateException("mapping changed");},
+                ()->eventFence.compareAndSet(eventEpoch,null)));
+        check(eventFence.get()==newerEventEpoch); // Old failed observer cannot revoke newer token.
+        check(EuiccReadiness.eventBoundary(()->{},()->{throw new AssertionError("not a failure");}));
+        System.out.println("PASS "+checks+" publication checks; real helper/journal/model, not Android Handler/Binder");
+    }
+}
