+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.internal.telephony.honor;
+
+import android.app.AppOpsManager;
+import android.content.pm.PackageManager;
+import android.os.*;
+import android.telephony.*;
+import com.android.internal.telephony.*;
+import com.android.internal.telephony.subscription.SubscriptionManagerService;
+
+public final class UserDataRequestHostTest {
+    static int checks;
+    static void check(boolean value, String text) {
+        checks++;
+        if (!value) throw new AssertionError(text);
+    }
+    static SubscriptionManagerService service() { return SubscriptionManagerService.getInstance(); }
+    static final class Controller {
+        final Object mApp = new Object();
+        final AppOpsManager mAppOps = new AppOpsManager();
+        boolean modify = true, feature = true;
+        void enforceModifyPermission() { if (!modify) throw new SecurityException(); }
+        void enforceTelephonyFeatureWithException(String pkg, String feature, String action) {
+            if (!this.feature) throw new UnsupportedOperationException();
+        }
+        boolean opEnableMobileDataByUser() { return false; }
+        Phone getPhone(int sub) {
+            if (sub == 1) return PhoneFactory.getPhones()[0];
+            return SubscriptionManager.active != null && SubscriptionManager.active.id == sub
+                    ? PhoneFactory.getPhones()[1] : null;
+        }
+__ACTUAL_METHODS__
+    }
+    static Controller reset() throws Exception {
+        HonorManagedDataPreferenceHostTest.reset();
+        PhoneFactory.reset();
+        TelephonyPermissions.carrier = false;
+        Binder.clears = Binder.restores = 0;
+        return new Controller();
+    }
+    static long version() { return service().getDefaultDataSelectionIntent().generation(); }
+    public static void main(String[] args) throws Exception {
+        for (boolean enabled : new boolean[]{false, true}) {
+            Controller control = reset();
+            long before = version();
+            control.setDataEnabledForReason(2, TelephonyManager.DATA_ENABLED_REASON_USER,
+                    enabled, "settings");
+            check(version() == before + 1, "legitimate USER false/true recorded synchronously");
+            check(PhoneFactory.getPhones()[1].data.versions.get(0) == version(),
+                    "intent recorded before asynchronous data dispatch");
+            check(PhoneFactory.getPhones()[1].data.enabled,
+                    "queued data setting has not run at boundary return");
+            Handler.drain();
+            check(PhoneFactory.getPhones()[1].data.enabled == enabled,
+                    "the original requested USER value still applies normally");
+            before = version();
+            control.setDataEnabledForReason(2, TelephonyManager.DATA_ENABLED_REASON_USER,
+                    enabled, "settings");
+            check(version() == before + 1, "same-value USER request still advances intent");
+            Handler.drain();
+            check(Binder.clears == Binder.restores, "Binder identity restored on permitted calls");
+        }
+
+        Controller control = reset();
+        control.modify = false;
+        long before = version();
+        try {
+            control.setDataEnabledForReason(2, TelephonyManager.DATA_ENABLED_REASON_USER,
+                    false, "denied");
+            throw new AssertionError("permission should deny");
+        } catch (SecurityException expected) {
+            check(version() == before && PhoneFactory.getPhones()[1].data.dispatched == 0,
+                    "denied USER request neither retires custody nor queues data work");
+        }
+        TelephonyPermissions.carrier = true;
+        control.setDataEnabledForReason(2, TelephonyManager.DATA_ENABLED_REASON_USER,
+                false, "carrier-privileged");
+        check(version() == before + 1, "existing carrier privilege USER permission is preserved");
+        control = reset();
+        control.feature = false;
+        before = version();
+        try {
+            control.setDataEnabledForReason(2, TelephonyManager.DATA_ENABLED_REASON_USER,
+                    false, "unsupported");
+            throw new AssertionError("feature should deny");
+        } catch (UnsupportedOperationException expected) {
+            check(version() == before, "feature denial precedes intent invalidation");
+        }
+
+        control = reset();
+        before = version();
+        control.setDataEnabledForReason(999, TelephonyManager.DATA_ENABLED_REASON_USER,
+                false, "settings");
+        PhoneFactory.getPhones()[1].managerAvailable = false;
+        control.setDataEnabledForReason(2, TelephonyManager.DATA_ENABLED_REASON_USER,
+                false, "settings");
+        check(version() == before, "unavailable Phone or manager does not invent a USER request");
+
+        control = reset();
+        before = version();
+        control.setDataEnabledForReason(2, TelephonyManager.DATA_ENABLED_REASON_POLICY,
+                false, "policy");
+        control.setDataEnabledForReason(2, TelephonyManager.DATA_ENABLED_REASON_CARRIER,
+                false, "carrier");
+        check(version() == before && PhoneFactory.getPhones()[1].carrierActions == 1,
+                "policy and carrier controls are not reclassified as USER");
+        PhoneFactory.getPhones()[1].data.setDataEnabled(
+                TelephonyManager.DATA_ENABLED_REASON_USER, false, "phone-policy");
+        check(version() == before, "internal direct automatic USER-false path does not masquerade as a public USER request");
+
+        for (boolean enabled : new boolean[]{false, true}) {
+            control = reset();
+            service().dds = 1;
+            before = version();
+            boolean result = enabled ? control.enableDataConnectivity("legacy")
+                    : control.disableDataConnectivity("legacy");
+            check(result && version() == before + 1,
+                    "legacy global enable/disable records current default-plan intent");
+            check(PhoneFactory.getPhones()[0].data.versions.get(0) == version(),
+                    "legacy stamp also precedes async dispatch");
+        }
+
+        control = reset();
+        HonorManagedDataPreferenceHostTest.begin("a".repeat(32), 10);
+        control.disableDataConnectivity("settings");
+        Handler.drain();
+        check(service().releases == 1, "global OFF retires exact management owner immediately");
+        HonorManagedDataPreferenceHostTest.returned("a".repeat(32), 11);
+        check(service().dds == 1 && service().restores == 0
+                        && !PhoneFactory.getPhones()[0].data.enabled,
+                "fallback global OFF is not undone by restoring the original enabled data plan");
+
+        control = reset();
+        HonorManagedDataPreferenceHostTest.begin("a".repeat(32), 10);
+        HonorManagedDataPreferenceHostTest.owner.delay = true;
+        HonorManagedDataPreferenceHostTest.returned("a".repeat(32), 11);
+        control.setDataEnabledForReason(2, TelephonyManager.DATA_ENABLED_REASON_USER,
+                false, "settings");
+        Handler.drain();
+        HonorManagedDataPreferenceHostTest.owner.flush();
+        Handler.drain();
+        check(service().restores == 0 && !PhoneFactory.getPhones()[1].data.enabled,
+                "explicit original-plan OFF defeats an already queued physical-return verification");
+        System.out.println("PASS actual pre-dispatch USER data methods: " + checks + " checks");
+    }
+}
