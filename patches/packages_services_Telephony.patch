+    }
+    private void requireWorker() {
+        if(Looper.myLooper()!=getLooper()) throw new IllegalStateException("Owner worker required");
+    }
+    private boolean healthy() {
+        return !failed.get() && transport.isHealthy() && getLooper().getThread().isAlive()
+                && SELinux.isSELinuxEnforced();
+    }
+    private void invalidate() {
+        requireWorker();
+        if(query!=null) query.unavailable();
+        if(generation==Long.MAX_VALUE) failed.set(true);else generation++;
+    }
+    private void stop() {
+        failed.set(true); // Immediate fence is observable without queued worker cleanup.
+        if(Looper.myLooper()==getLooper()) invalidate();
+    }
+
+    /** One explicit GET only. A refused/failed attempt cannot be retried in this owner. */
+    public void queryOnce() {
+        if(!healthy()) throw new IllegalStateException("Probe owner unavailable");
+        if(!queryRequested.compareAndSet(false,true))
+            throw new IllegalStateException("Probe query already attempted");
+        if(!post(()->{
+            try {
+                requireWorker();requireControlledProbeBuild();requirePhoneProcess();
+                if(instance!=this || !healthy()) throw new IllegalStateException("Probe owner lost");
+                querySerial=serials.allocate(); // Durable reservation BEFORE any remote request.
+                if(!healthy()) {stop();return;} // Recheck after potentially blocking durable I/O.
+                long now=SystemClock.elapsedRealtime();
+                query=new MtkSimTypeQuery(generation,querySerial,now+QUERY_TIMEOUT_MS);
+                MtkSimTypeQuery pending=query;
+                if(!postDelayed(()->pending.expire(SystemClock.elapsedRealtime()),QUERY_TIMEOUT_MS)) {
+                    stop();return;
+                }
+                transport.query(querySerial); // No select(), profile API or APDU path.
+            } catch(Exception e) {stop();}
+        })) stop();
+    }
+    @Override public void queryResult(int type,int serial,int error,int support,int mode,int reserved) {
+        requireWorker();
+        if(!healthy()) {stop();return;}
+        if(query!=null && serial==querySerial && diagnosticWrites<4) {
+            diagnosticWrites++; // Numeric fields only, bounded to this one explicitly requested query.
+            android.util.Log.i("LdyMtkSimProbe","type="+type+" serial="+serial+" error="+error
+                    +" support="+support+" mode="+mode+" value2="+reserved);
+        }
+        if(query!=null) query.onResponse(generation,serial,type,error,support,mode,reserved,
+                SystemClock.elapsedRealtime()); // Fresh execution time, never Binder receipt time.
+    }
+    @Override public void switchResult(int type,int serial,int error) {
+        requireWorker();stop(); // This probe never sends a setter; such a reply is not ours.
+    }
+    @Override public void simTypeChanged(int support,int mode,int reserved) {
+        requireWorker();invalidate(); // Advisory only; never manufacture a known result.
+    }
+    @Override public void unavailable() {requireWorker();stop();}
+
+    /** Bounded worker roundtrip for display; a snapshot is not authorization for any handoff. */
+    public void requestSnapshot(Consumer<Snapshot> ready,Consumer<String> rejected) {
+        Objects.requireNonNull(ready);Objects.requireNonNull(rejected);
+        Handler main=new Handler(Looper.getMainLooper());
+        AtomicBoolean delivered=new AtomicBoolean();
+        long deadline=SystemClock.elapsedRealtime()+REPLY_TIMEOUT_MS;
+        Runnable timeout=()->{
+            if(delivered.compareAndSet(false,true)) {
+                stop();rejected.accept("Probe worker reply timed out; no retry");
+            }
+        };
+        main.postDelayed(timeout,REPLY_TIMEOUT_MS);
+        if(!post(()->{
+            Snapshot value;
+            try {
+                requireWorker();requirePhoneProcess();
+                value=snapshot();
+            } catch(RuntimeException e) {
+                stop();value=new Snapshot(generation,querySerial,Phase.UNAVAILABLE,-1);
+            }
+            Snapshot captured=value;
+            if(!main.post(()->{
+                if(!delivered.compareAndSet(false,true)) return;
+                main.removeCallbacks(timeout);
+                if(SystemClock.elapsedRealtime()>=deadline || !healthy()
+                        || generation!=captured.generation()) {
+                    rejected.accept("Probe snapshot unavailable or obsolete");
+                } else ready.accept(captured);
+            })) stop();
+        })) {
+            stop();
+            main.post(()->{
+                if(delivered.compareAndSet(false,true)) {
+                    main.removeCallbacks(timeout);rejected.accept("Probe worker unavailable");
+                }
+            });
+        }
+    }
+    private Snapshot snapshot() {
+        requireWorker();
+        if(!healthy()) return new Snapshot(generation,querySerial,Phase.UNAVAILABLE,-1);
+        if(query==null) return new Snapshot(generation,0,Phase.PREPARED,-1);
+        query.expire(SystemClock.elapsedRealtime());
+        Phase phase=switch(query.state()) {
+            case WAITING -> Phase.WAITING;
+            case PHYSICAL -> Phase.PHYSICAL;
+            case EUICC -> Phase.EUICC;
+            case UNQUALIFIED -> Phase.UNQUALIFIED;
+            case UNKNOWN -> Phase.UNKNOWN;
+        };
+        return new Snapshot(generation,querySerial,phase,query.mode());
+    }
+}
diff --git a/src/com/android/internal/telephony/honor/HonorSepTrialAdapter.java b/src/com/android/internal/telephony/honor/HonorSepTrialAdapter.java
