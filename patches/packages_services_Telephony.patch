+    src = out / "recovery/src"
+    for name in kotlin_names:
+        source = app / "libs/lpac-jni/src/main/java/net/typeblog/lpac_jni" / (name + ".kt")
+        copy(source, src / source.name)
+    for name in ["LpaChannelAdmission", "LogicalChannelCloseReceipt"]:
+        source = app / "app-common/src/main/java/im/angry/openeuicc/core" / (name + ".kt")
+        copy(source, src / source.name)
+    wrapper_source = app / "app-common/src/main/java/im/angry/openeuicc/core/LocalProfileAssistantWrapper.kt"
+    source_pins.append({"path": str(wrapper_source.resolve()), "sha256": digest(wrapper_source)})
+    source_pins.extend({"path": str(p.resolve()), "sha256": digest(p)}
+                       for p in [phone / "HonorSepTrialOwner.java", phone / "HonorLpaLeaseService.java", client_path])
+    (out / "SOURCE-PINS.json").write_text(json.dumps(source_pins, indent=2) + "\n")
+    env = os.environ.copy()
+    env["JAVA_HOME"] = str(a.jdk.resolve())
+    env["PATH"] = str(a.jdk.resolve() / "bin") + os.pathsep + env.get("PATH", "")
+    results = []
+    def run(argv, name, expected_compile=False):
+        p = subprocess.run(list(map(str, argv)), capture_output=True, text=True, env=env)
+        (out / (name + ".log")).write_text(p.stdout + p.stderr)
+        (out / (name + ".argv.json")).write_text(json.dumps(list(map(str, argv)), indent=2) + "\n")
+        if expected_compile and p.returncode:
+            raise RuntimeError(name + " failed; see retained log")
+        return p
+    for group in ["recovery", "route"]:
+        directory = out / group
+        classes = directory / "classes"
+        classes.mkdir()
+        run([a.jdk / "bin/javac", "-d", classes, *sorted((directory / "src").glob("*.java"))],
+            group + "-javac", True)
+        if group == "recovery":
+            jar = directory / "integration.jar"
+            run([a.kotlinc, "-J-Xmx1024M", "-classpath", classes, "-jvm-target", "21",
+                 "-include-runtime", "-d", jar, *sorted((directory / "src").glob("*.kt"))],
+                "recovery-kotlinc", True)
+            cp = str(jar) + os.pathsep + str(classes)
+            entry = "im.angry.openeuicc.core.RecoveryCrossLayerTest"
+        else:
+            cp = str(classes)
+            entry = "com.android.internal.telephony.honor.HonorSepTrialOwner"
+        p = run([a.jdk / "bin/java", "-Xmx512m", "-cp", cp, entry], group + "-execution")
+        rows = [line.split("|") for line in p.stdout.splitlines() if line.startswith("CASE|")]
+        assert rows and p.returncode in [0, 2], "Unexpected fixture failure: " + group
+        results.append({"group": group, "returncode": p.returncode, "cases": rows,
+                        "acceptance_pass": p.returncode == 0})
+        if group == "recovery":
+            no_grant = run([a.jdk / "bin/java", "-Xmx512m", "-cp", cp,
+                            "im.angry.openeuicc.core.NoGrantCrossLayerTest"], "no-grant-execution")
+            no_grant_rows = [line.split("|") for line in no_grant.stdout.splitlines() if line.startswith("CASE|")]
+            assert no_grant_rows and no_grant.returncode in [0, 2]
+            results.append({"group": "typed-no-grant", "returncode": no_grant.returncode,
+                            "cases": no_grant_rows, "acceptance_pass": no_grant.returncode == 0})
+            bulk = run([a.jdk / "bin/java", "-Xmx512m", "-cp", cp,
+                        "im.angry.openeuicc.core.BulkResetCapabilityHostTest"], "bulk-reset-execution")
+            bulk_rows = [line.split("|") for line in bulk.stdout.splitlines() if line.startswith("CASE|")]
+            assert bulk_rows and bulk.returncode in [0, 2]
+            results.append({"group": "bulk-reset", "returncode": bulk.returncode, "cases": bulk_rows,
+                            "acceptance_pass": bulk.returncode == 0})
+    for row in source_pins:
+        assert digest(pathlib.Path(row["path"])) == row["sha256"], "Source changed during run: " + row["path"]
+    result = {"acceptance_pass": all(r["acceptance_pass"] for r in results), "results": results,
+              "phone_actions": False, "native_or_JNI_executed": False,
+              "scope": "Actual-source deterministic workflow seams; no Binder transport, vendor runtime, full UI or hardware claim."}
+    (out / "RESULT.json").write_text(json.dumps(result, indent=2) + "\n")
+    print(json.dumps(result, indent=2))
+    return 0 if result["acceptance_pass"] else 2
+
+if __name__ == "__main__":
+    raise SystemExit(main())
