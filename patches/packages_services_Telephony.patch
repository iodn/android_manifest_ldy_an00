+ public static void main(String[]args){
+  check(cachedRecoverySetup().equals("stage=NOT_REQUESTED failure_class=NONE"));
+  recoverySetupStage(false,RecoverySetupStage.HN_FIND);
+  check(android.util.Log.lines.isEmpty());
+  check(cachedRecoverySetup().contains("NOT_REQUESTED"));
+  recoverySetupStage(true,RecoverySetupStage.ADMISSION);
+  try{SepMuxAdmission.afterConsent("userdebug",true,false,true,true);throw new AssertionError();}
+  catch(IllegalStateException expected){recoverySetupFailure(expected);}
+  check(cachedRecoverySetup().equals("stage=ADMISSION failure_class=java.lang.IllegalStateException"));
+  check(android.util.Log.lines.size()==2);
+  check(android.util.Log.lines.get(1).equals("HonorLpaRecovery SETUP_FAIL stage=ADMISSION class=java.lang.IllegalStateException"));
+  recoverySetupStage(true,RecoverySetupStage.MTK_SERIAL_HISTORY);
+  check(cachedRecoverySetup().equals("stage=MTK_SERIAL_HISTORY failure_class=NONE"));
+  recoverySetupFailure(new java.io.IOException("SYNTHETIC_PRIVATE_VALUE"));
+  check(cachedRecoverySetup().endsWith("java.io.IOException"));
+  check(android.util.Log.lines.stream().noneMatch(s->s.contains("SYNTHETIC_PRIVATE_VALUE")));
+  recoverySetupStage(false,RecoverySetupStage.OWNER_READY);
+  check(cachedRecoverySetup().startsWith("stage=MTK_SERIAL_HISTORY"));
+  recoverySetupStage(true,RecoverySetupStage.OWNER_READY);
+  check(cachedRecoverySetup().endsWith("failure_class=NONE"));
+  check(android.util.Log.lines.stream().noneMatch(s->s.contains("Trusted-debug test image")));
+  SepMuxAdmission.afterConsent("userdebug",true,true,true,true).require(true);
+  check(cachedRecoverySetup().startsWith("stage=OWNER_READY"));
+  System.out.println("PASS "+checks+" actual recovery setup diagnostic/admission checks; no owner or native dispatch");
+ }
+}
+"""
+with tempfile.TemporaryDirectory(prefix="recovery-setup-trace-")as tmp:
+ directory=Path(tmp);java=directory/"RecoverySetupTraceHostTest.java";java.write_text(test)
+ log=directory/"android/util/Log.java";log.parent.mkdir(parents=True)
+ log.write_text("package android.util;public final class Log {public static final java.util.List<String> lines=new java.util.ArrayList<>();public static int i(String tag,String value){lines.add(tag+\" \"+value);return 0;}}")
+ subprocess.run([str(args.jdk/"bin/javac"),"--release","17","-d",str(directory),str(log),str(java),str(prod/"SepMuxAdmission.java")],check=True)
+ subprocess.run([str(args.jdk/"bin/java"),"-cp",str(directory),"com.android.internal.telephony.honor.RecoverySetupTraceHostTest"],check=True)
+prepare=text[text.index("    private static HonorSepTrialOwner prepareOnWorker(Looper looper,SepMuxAdmission environment,"+chr(10)+"            LpaRecoveryFence recovery,HonorSepTrialOwner previous)"):text.index("    static java.util.concurrent.CompletableFuture<EuiccReadiness.Snapshot> recover(")]
+pairs=[("PHONE_IDENTITY","requirePhoneProcess(environment)"),("BROKER_INITIALIZE","HonorRadioCommBroker.initialize("),
+ ("HN_FIND","IBinder b=ServiceManager.checkService("),("HN_METADATA","if(r.getInterfaceVersion()"),
+ ("SEP_HISTORY","AtomicSepMuxStore routeStore="),("MTK_FIND","IBinder routeBinder="),
+ ("MTK_SERIAL_HISTORY","MtkSimSerials routeSerials="),("OWNER_CONSTRUCT","HonorSepTrialOwner prepared=new"),
+ ("CALLBACK_OWNERSHIP","prepared.routeTransport.reserveCallbackOwnership()")]
+source_checks=0
+for stage,guard in pairs:
+ source_checks+=1
+ assert prepare.index("RecoverySetupStage."+stage)<prepare.index(guard),(stage,guard)
+recover=text[text.index("    static java.util.concurrent.CompletableFuture<EuiccReadiness.Snapshot> recover("):text.index("    private void requireRecoveryCurrent()")]
+source_checks+=1
+assert recover.index("RecoverySetupStage.ADMISSION")<recover.index("SepMuxAdmission.afterConsent(")
