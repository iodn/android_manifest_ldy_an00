@@ -0,0 +1,56 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.internal.telephony.honor;
+
+public final class HonorCommRequestsTest {
+ static int checks;
+ static void ok(boolean v){checks++;if(!v)throw new AssertionError("check "+checks);}
+ static void reject(Runnable action){checks++;try{action.run();}catch(IllegalArgumentException|IllegalStateException expected){return;}throw new AssertionError("accepted invalid request");}
+ public static void main(String[] args) throws Exception {
+  reject(()->new HonorCommRequests(0));reject(()->new HonorCommRequests(-1));
+  HonorCommRequests ids=new HonorCommRequests(10);Object a=new Object(),b=new Object();
+  int first=ids.allocate(1),second=ids.allocate(1),floor=ids.allocate(100);
+  ok(first==10 && second==11 && floor==100);
+  reject(()->ids.allocate(0));reject(()->new HonorCommRequests(Integer.MAX_VALUE).allocate(1));
+  reject(()->ids.begin(101,101,1,a));reject(()->ids.begin(first,99,1,a));
+  reject(()->ids.begin(first,101,0,a));reject(()->ids.begin(first,101,1,null));
+  var p=ids.begin(first,101,1,a);p.sent=true;
+  ids.begin(second,1005,1,b).sent=true;reject(()->ids.begin(second,1005,1,b));
+  var ack=ids.response(first,1,true,101,1);ok(!ack.terminal && !ack.ack && !ack.deliver);
+  var wrong=ids.response(first,2,false,-1,1);ok(wrong.terminal && wrong.ack && !wrong.deliver && !wrong.matched);
+  var duplicated=ids.response(first,2,false,-1,1);ok(!duplicated.terminal && !duplicated.ack);
+  var drain=ids.response(first,2,true,101,1);ok(drain.terminal && !drain.ack && !drain.deliver && drain.matched);
+  ok(ids.response(first,2,true,101,1).request==null);
+  var mux=ids.response(second,2,true,1005,1);ok(mux.deliver && mux.ack && mux.matched);
+  var old=ids.begin(floor,101,1,a);old.sent=true;ids.timeout(old);
+  var redirected=ids.response(floor,2,true,101,2);ok(redirected.terminal && redirected.ack && !redirected.deliver);
+  var exact=ids.response(floor,2,true,101,1);ok(exact.terminal && !exact.ack && !exact.deliver && exact.matched);
+  int retired=ids.allocate(1);ids.begin(retired,1005,2,b).sent=true;ids.retire(b);
+  var retiredFinal=ids.response(retired,2,true,1005,2);ok(retiredFinal.ack && !retiredFinal.deliver);
+  int cancelled=ids.allocate(1);var neverSent=ids.begin(cancelled,101,2,a);ids.cancelBeforeSend(neverSent);
+  ok(ids.response(cancelled,2,true,101,2).request==null);
+  HonorCommRequests full=new HonorCommRequests(1);
+  for(int i=0;i<HonorCommRequests.MAX_PENDING;i++){int n=full.allocate(1);full.begin(n,101,1,a).sent=true;}
+  int over=full.allocate(1);reject(()->full.begin(over,101,1,a));
+  // Deterministic reader/timeout conversion interleaving while route admission holds its monitor.
+  HonorCommRequests atomic=new HonorCommRequests(1);Object caller=new Object();
+  int guarded=atomic.allocate(1);var inFlight=atomic.begin(guarded,101,7,caller);inFlight.sent=true;
+  var store=new HonorLpaLeaseService.Store();var lease=new LpaOperationLease(store);
+  lease.setCallPolicyGate(atomic::quiescent);
+  java.util.concurrent.CountDownLatch convert=new java.util.concurrent.CountDownLatch(1),converted=new java.util.concurrent.CountDownLatch(1);
+  Thread timeout=new Thread(()->{try{convert.await();atomic.timeout(inFlight);converted.countDown();}catch(InterruptedException e){throw new AssertionError(e);}});
+  timeout.start();
+  synchronized(lease) {
+   ok(!atomic.quiescent());convert.countDown();converted.await();
+   ok(inFlight.retired && !atomic.quiescent());reject(lease::beginPrimarySelection);
+  }
+  timeout.join();
+  atomic.retireBinding(7);ok(!atomic.quiescent());
+  atomic.response(guarded,2,true,101,8);ok(!atomic.quiescent());reject(lease::beginPrimarySelection);
+  atomic.response(guarded,2,true,101,7);ok(atomic.quiescent());
+  Object primary=lease.beginPrimarySelection();checks++;lease.finishPrimarySelection(primary,true);
+  System.out.println("PASS "+checks+" production shared comm serial/correlation boundary checks");
+ }
+}
