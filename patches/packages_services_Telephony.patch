@@ -0,0 +1,19 @@
+/* Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0 */
+package com.android.internal.telephony.honor;
+/** Absolute one-shot dispatch guard, independent of queued Handler watchdog ordering. */
+public final class TrialDispatchGate {
+    private boolean started, stopped, sent;
+    private long deadline;
+    public void start(long now) {
+        if(started || now<0 || now>Long.MAX_VALUE-SepMuxTrial.ADMISSION_TIMEOUT_MS)throw new IllegalStateException("Trial already used/clock invalid");
+        started=true;deadline=now+SepMuxTrial.ADMISSION_TIMEOUT_MS;
+    }
+    public void check(long now) {
+        if(!started || stopped || sent || now<0 || now>=deadline)
+            throw new IllegalStateException("Stopped/expired/repeated trial dispatch");
+    }
+    public void commitDispatch(long now) {check(now);sent=true;}
+    public void stop() {stopped=true;}
+    public boolean stopped() {return stopped;}
+}
