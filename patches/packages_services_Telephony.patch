+source_checks+=1
+assert dump.count("ServiceManager.checkService(")==2
+source_checks+=1
+assert all(v not in dump for v in["registerCallbacks(","getInterfaceVersion(","sendMuxRequest(","prepareAsync(",".query("])
+descriptor=(prod/"MtkSimTypeTransport.java").read_text().split('static final String DESCRIPTOR="',1)[1].split('"',1)[0]
+source_checks+=1
