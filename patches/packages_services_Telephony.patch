+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.internal.telephony.honor;
+
+import android.content.Context;
+import android.os.*;
+import android.telephony.*;
+import com.android.internal.telephony.subscription.SubscriptionManagerService;
+import java.util.*;
+
+public final class HonorManagedDataPreferenceHostTest {
+    static int checks, dispatched;
+    static final String NONCE = "a".repeat(32), NEXT = "b".repeat(32);
+    static Context context;
+    static HonorSepTrialOwner owner;
+    static Client client;
+    static class Client implements IBinder {
+        boolean alive = true;
+        final List<DeathRecipient> recipients = new ArrayList<>();
+        public void linkToDeath(DeathRecipient r, int f) throws RemoteException {
+            if (!alive) throw new RemoteException();
+            recipients.add(r);
+        }
+        public boolean unlinkToDeath(DeathRecipient r, int f) { return recipients.remove(r); }
+        public boolean isBinderAlive() { return alive; }
+        void die() { alive = false; for (var r : List.copyOf(recipients)) r.binderDied(); }
+    }
+    static void check(boolean value, String text) {
+        checks++;
+        if (!value) throw new AssertionError(text);
+    }
+    static SubscriptionManagerService service() { return SubscriptionManagerService.getInstance(); }
+    static void reset() throws Exception {
+        Handler.reset();
+        var singleton = HonorManagedDataPreference.class.getDeclaredField("instance");
+        singleton.setAccessible(true);
+        singleton.set(null, null);
+        SubscriptionManagerService.reset();
+        SubscriptionManager.physical = new SubscriptionInfo(2, "card-a", false);
+        SubscriptionManager.active = SubscriptionManager.physical;
+        HonorSubscriberAdoption.listeners.clear();
+        HonorRadioCommBroker.listeners.clear();
+        HonorSubscriberAdoption.ready = true;
+        HonorSubscriberAdoption.revision = 1;
+        HonorLpaLeaseService.lease = new LpaOperationLease();
+        HonorLpaLeaseService.fence = new HonorLpaLeaseService.Fence();
+        HonorSimRouteCallGuard.busy = false;
+        SepMuxJournal.unknown = false;
+        context = new Context();
+        owner = new HonorSepTrialOwner();
+        HonorSepTrialOwner.current = owner;
+        client = new Client();
+        dispatched = 0;
+    }
+    static void begin(String nonce, int phase) {
+        HonorManagedDataPreference.beforeOutbound(context, owner, nonce, phase, client, () -> {
+            dispatched++;
+            SubscriptionManager.active = new SubscriptionInfo(3, "esim-profile", true);
+            service().dds = 1; // Normal automatic fallback as the physical subscriber disappears.
+        });
+        Handler.drain();
+        owner.state = HonorSepTrialOwner.UiState.EUICC_READY;
+        owner.phase = phase + 1;
+        HonorManagedDataPreference.observed(owner, "EUICC_READY", phase + 1);
+        Handler.drain();
+    }
+    static void returned(String nonce, int returnPhase) {
+        HonorManagedDataPreference.beforeReturn(owner, nonce, returnPhase);
+        SubscriptionManager.active = SubscriptionManager.physical;
+        HonorSubscriberAdoption.revision++;
+        owner.state = HonorSepTrialOwner.UiState.PHYSICAL_READY;
+        owner.phase = returnPhase + 1;
+        HonorManagedDataPreference.observed(owner, "PHYSICAL_READY", returnPhase + 1);
+        Handler.drain();
+    }
+    public static void main(String[] args) throws Exception {
+        reset();
+        begin(NONCE, 10);
+        check(dispatched == 1 && service().restores == 0,
+                "capture precedes exactly one outbound dispatch and never selects a data plan");
+        returned(NONCE, 11);
+        check(service().dds == 2 && service().restores == 1,
+                "same owned physical return restores original selected subscriber once");
+        check(service().userData, "prior enabled data is never written false by the helper");
+        check(service().releases == 1, "successful return releases its exact preservation");
+        HonorManagedDataPreference.observed(owner, "PHYSICAL_READY", 12);
+        Handler.drain();
+        check(service().restores == 1, "repeated observation cannot repeat DDS compare-and-apply");
+
+        reset();
+        service().userData = false;
+        begin(NONCE, 10);
+        returned(NONCE, 11);
+        check(service().dds == 2 && !service().userData,
+                "prior USER data false remains false after restoration");
+
+        reset();
+        begin(NONCE, 10);
+        service().explicit(1); // Same as the automatic fallback value.
+        returned(NONCE, 11);
+        check(service().restores == 0 && service().dds == 1,
+                "later same-value explicit choice wins over saved physical preference");
+        check(service().releases == 1, "later choice releases obsolete preservation");
+
+        reset();
+        begin(NONCE, 10);
+        service().noteExplicitUserDataRequest();
+        Handler.drain();
+        check(service().releases == 1,
+                "USER request retires owned helper immediately without awaiting a return");
+        returned(NONCE, 11);
+        check(service().restores == 0 && service().dds == 1,
+                "fallback plan USER request prevents restoring an older original data plan");
+
+        reset();
+        begin(NONCE, 10);
+        service().userData = false;
+        service().noteExplicitUserDataRequest();
+        Handler.drain();
+        returned(NONCE, 11);
+        check(service().restores == 0 && !service().userData,
+                "explicit original-plan USER false overrides automatic DDS restoration");
+
+        reset();
+        begin(NONCE, 10);
+        SubscriptionManager.physical = new SubscriptionInfo(4, "card-b", false);
+        returned(NONCE, 11);
+        check(service().restores == 0 && service().dds == 1,
+                "replacement card never inherits earlier data-plan selection");
+        check(service().releases == 1, "replacement identity retires the old hold");
+
+        reset();
+        begin(NONCE, 10);
+        client.die();
+        Handler.drain();
+        returned(NONCE, 11);
+        check(service().restores == 0 && service().releases == 1,
+                "management process death retires custody before return");
+
+        reset();
+        begin(NONCE, 10);
+        HonorLpaLeaseService.lease.state = LpaOperationLease.State.UNKNOWN;
+        HonorRadioCommBroker.fire();
+        Handler.drain();
+        check(service().releases == 1, "real current lease UNKNOWN retires preservation");
+        HonorLpaLeaseService.lease.state = LpaOperationLease.State.CLEAN;
+        returned(NONCE, 11);
+        check(service().restores == 0, "later clean endpoint cannot revive an uncertain operation");
+
+        reset();
+        begin(NONCE, 10);
+        returned(null, 11);
+        check(service().restores == 0 && service().releases == 1,
+                "permanent Settings connection change cannot borrow management intent");
+
+        reset();
+        begin(NONCE, 10);
+        HonorManagedDataPreference.cancel(); // Exact source NO_ADMISSION or unresolved route.
+        Handler.drain();
+        returned(NONCE, 11);
+        check(service().restores == 0 && service().releases == 1,
+                "never-entered or unknown operation cannot keep a preservation token");
+
+        reset();
+        begin(NONCE, 10);
+        owner.delay = true;
+        returned(NONCE, 11);
+        check(owner.snapshots.size() == 1, "first excursion is awaiting its exact owner snapshot");
+        HonorManagedDataPreference.cancel();
+        Handler.drain();
+        // Same Phone process and owner, a later legitimate management excursion.
+        service().dds = 2;
+        SubscriptionManager.active = SubscriptionManager.physical;
+        begin(NEXT, 12);
+        returned(NEXT, 13);
+        check(owner.snapshots.size() == 2,
+                "old pending snapshot does not suppress a successor verification");
+        var old = owner.snapshots.remove(0);
+        new Handler(Looper.MAIN).post(old);
+        Handler.drain();
+        check(service().restores == 0, "late old callback cannot apply or clear successor custody");
+        owner.flush();
+        Handler.drain();
+        check(service().restores == 1 && service().dds == 2,
+                "successor restores normally after delayed stale callback");
+        System.out.println("PASS actual managed-data helper: " + checks + " checks");
+    }
+}
