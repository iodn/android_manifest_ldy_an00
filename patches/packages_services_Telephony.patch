+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.internal.telephony.honor;
+
+public final class HonorManagedDataExcursionHostTest {
+    private static int checks;
+    private static void check(boolean value, String text) {
+        checks++;
+        if (!value) throw new AssertionError(text);
+    }
+    private static HonorManagedDataExcursion start(Object owner) {
+        return new HonorManagedDataExcursion(owner, 3, "a".repeat(32), 10);
+    }
+    public static void main(String[] args) {
+        Object owner = new Object();
+        var scope = start(owner);
+        check(!scope.requestReturn(owner, 3, "a".repeat(32), 11),
+                "return cannot be armed from unconfirmed outbound selection");
+        check(!scope.observe(owner, 3, "PHYSICAL_READY", 11),
+                "current physical endpoint is not evidence of management return");
+        check(!scope.observe(owner, 3, "EUICC_READY", 12),
+                "unrelated outbound cycle does not authorize return");
+        check(!scope.requestReturn(owner, 3, "a".repeat(32), 12),
+                "unrelated source phase cannot fabricate outbound completion");
+        check(!scope.current(owner, 3), "superseded outbound authority is retired");
+        scope = start(owner);
+        check(!scope.observe(owner, 3, "EUICC_READY", 11),
+                "known outbound does not itself restore data");
+        check(!scope.requestReturn(new Object(), 3, "a".repeat(32), 11),
+                "other owner cannot use management intent");
+        check(!scope.requestReturn(owner, 4, "a".repeat(32), 11),
+                "reconnected or restarted generation cannot inherit intent");
+        check(!scope.requestReturn(owner, 3, "b".repeat(32), 11),
+                "another management session cannot borrow custody");
+        check(!scope.requestReturn(owner, 3, null, 11),
+                "permanent Settings connection selection is not temporary management return");
+        check(scope.requestReturn(owner, 3, "a".repeat(32), 11),
+                "matched management nonce owns exact return phase");
+        check(!scope.requestReturn(owner, 3, "a".repeat(32), 11),
+                "duplicate return cannot rearm an operation");
+        check(!scope.observe(owner, 3, "WORKING", 12),
+                "busy result is not positive completion");
+        check(!scope.observe(owner, 3, "PHYSICAL_READY", 11),
+                "old same-route readback cannot complete a newly submitted return");
+        check(scope.observe(owner, 3, "PHYSICAL_READY", 12),
+                "exact known physical-return phase qualifies identity recheck");
+        check(!scope.observe(owner, 3, "PHYSICAL_READY", 13),
+                "later unrelated cycle retires prior return authority");
+        check(!scope.observe(owner, 3, "PHYSICAL_READY", 12),
+                "queued old completion cannot revive a superseded return");
+        scope.cancel();
+        check(!scope.observe(owner, 3, "PHYSICAL_READY", 12),
+                "completed or cancelled authority cannot be replayed");
+
+        scope = start(owner);
+        scope.observe(owner, 3, "KNOWN_BLANK", 11);
+        check(scope.requestReturn(owner, 3, "a".repeat(32), 14),
+                "known blank and intervening owned profile work can precede fresh return consent");
+        check(scope.observe(owner, 3, "PHYSICAL_READY", 15),
+                "fresh return phase still needs its exact completion");
+        scope = start(owner);
+        scope.observe(owner, 3, "EUICC_READY", 11);
+        scope.requestReturn(owner, 3, "a".repeat(32), 11);
+        check(!scope.observe(owner, 3, "UNKNOWN", 12), "unknown does not restore");
+        check(!scope.observe(owner, 3, "PHYSICAL_READY", 12),
+                "later observation cannot clear unknown history");
+        check(!scope.current(owner, 3), "unknown has permanently retired this scope");
+        check(!scope.toString().contains("aaaa"), "diagnostic omits private management nonce");
+        System.out.println("PASS managed data excursion: " + checks + " checks");
+    }
+}
