+        h=new Handler();i=new Inputs();b=new Backend();
+        c=new HonorImsDefaultOpenController(h,i,b,HonorImsDefaultOpenPolicy.Config.stockBase());
+        c.configuration(config(1,1,2));i.cellular=false;i.changed.run();h.runOne();
+        check(h.queue.size()==1,"genuine service event arms no-cellular deadline");
