+        e.policy.registered(lte);
+        check(e.timers.timers.isEmpty(),"registered cancels both deadlines");
+        e.policy.timer(max);check(e.votes.isEmpty(),"retired deadline cannot disable registered LTE");
+        e.config(100);check(e.timers.timers.isEmpty(),"100 MBN failure not OFF/new round");
+        e.config(101);check(e.votes.isEmpty(),"101 MBN failure not command");
