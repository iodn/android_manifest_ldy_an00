+package com.honor.ldy_an00.lease;
+import com.honor.ldy_an00.lease.HonorLpaLease;
+import com.honor.ldy_an00.lease.HonorLpaLeaseGrant;
+import com.honor.ldy_an00.lease.HonorLpaChannelResult;
+interface IHonorLpaLease {
+    HonorLpaLeaseGrant acquire(int operation, int physicalSlot, int port, int cardId, IBinder client);
+    boolean check(in HonorLpaLease lease, IBinder client);
+    HonorLpaChannelResult openChannel(in HonorLpaLease lease, IBinder client, String aid, int p2);
+    HonorLpaChannelResult transmitChannel(in HonorLpaLease lease, IBinder client, long handle, in byte[] command);
+    HonorLpaChannelResult closeChannel(in HonorLpaLease lease, IBinder client, long handle);
+    boolean beginNative(in HonorLpaLease lease, IBinder client, int nativeKind, boolean lastProfileBefore);
+    boolean nativeReturned(in HonorLpaLease lease, IBinder client, boolean positive);
+    int reconcileResetStep(in HonorLpaLease lease, IBinder client, boolean channelsPositivelyClosed, boolean allowKnownBlank);
+    boolean finish(in HonorLpaLease lease, IBinder client, boolean nativeCompletedReconciledAndChannelsClosed);
+    // Protocol version is checked before operations; original transaction IDs stay fixed.
+    // Version 2 was required before any lease/native command; original transaction IDs stay fixed.
+    int protocolVersion();
+    HonorLpaLeaseGrant acquireV2(int operation, int physicalSlot, int port, int cardId, IBinder client);
+    boolean beginNativeTarget(in HonorLpaLease lease, IBinder client, int nativeKind,
+            boolean lastProfileBefore, String expectedIccid);
+    int prepareResetReclamation(in HonorLpaLease lease, IBinder client);
+    const int PREPARE_NOT_NEEDED = 0;
+    const int PREPARE_READY = 1;
+    const int PREPARE_NOT_READY = 2;
+    const int PREPARE_REFUSED = 3;
+    // Version 3: read-only, process-live historical identity only. Never returns a lease or card ID.
+    int prepareKnownBlankEndpoint(int physicalSlot, int port, int expectedCardId, IBinder client);
+    // Version 5: parsed, operation-specific card rejection; no reset or channel-drain proof.
+    boolean nativeRejected(in HonorLpaLease lease, IBinder client, int kind, int code);
+    // Protocol 6: explicit nondestructive recovery after a marked kernel restart.
+    const int RECOVERY_REFUSED = 0;
+    const int RECOVERY_NEED_RESTART = 1;
+    const int RECOVERY_READY = 2;
+    const int RECOVERY_IN_PROGRESS = 3;
+    const int RECOVERY_DONE = 4;
+    const int RECOVERY_REQUIRED = 5;
+    int armRecovery(String appJournalHash, IBinder client);
+    HonorLpaLeaseGrant acquireRecovery(String appJournalHash, IBinder client);
+    boolean finishRecovery(in HonorLpaLease lease, IBinder client, boolean completedAndDrained);
+    int recoveryStatus(String appJournalHash);
+}
diff --git a/honor-lpa-lease/src/com/honor/ldy_an00/lease/HonorLpaLifecycleTrace.java b/honor-lpa-lease/src/com/honor/ldy_an00/lease/HonorLpaLifecycleTrace.java
new file mode 100644
index 0000000000000000000000000000000000000000..eb2708951a2ca847a9053bbd23b95fbd6b96c37f
--- /dev/null
+++ b/honor-lpa-lease/src/com/honor/ldy_an00/lease/HonorLpaLifecycleTrace.java
@@ -0,0 +1,71 @@
+/* Copyright (C) 2026 The LineageOS Project. SPDX-License-Identifier: Apache-2.0 */
+package com.honor.ldy_an00.lease;
+
+import java.util.Objects;
+import java.util.function.Consumer;
+import java.util.function.LongSupplier;
+
+/** Fixed lifecycle vocabulary. Never accepts identities, payloads or exception messages. */
+public final class HonorLpaLifecycleTrace {
+    public enum Side { PHONE, LPA }
+    public enum Stage {
+        STATUS, LOCAL_ADMISSION, LOCAL_JOURNAL, BIND, PROTOCOL, TARGET, GRANT,
+        OPEN, APDU, CLOSE, NATIVE_BEGIN, NATIVE_RESULT, NATIVE_REJECTED,
+        RESET_PREPARE, JNI_DRAIN, RESET_REBIND, POSTCONDITION, LEASE_FINISH,
+        JOURNAL_COMMIT, CLEANUP, RECOVERY_ARM, RECOVERY_BEGIN, RECOVERY_GRANT,
+        RECOVERY_TRANSCRIPT, RECOVERY_FINISH, RECOVERY_ACK, MANAGEMENT_RETURN,
+        ROUTE_PREPARE, ROUTE_ADMISSION, ROUTE_DISPATCH, ROUTE_PROOF, RECONNECT
+    }
+    public enum Outcome {
+        OK, WAITING, REFUSED_PRE_DISPATCH, REQUEST_REJECTED, CARD_REJECTED, CANCELLED_DRAINED,
+        DISPATCH_UNCERTAIN, TERMINAL_UNKNOWN, IDENTITY_CHANGED, PASSIVE_REVISION_CHANGED,
+        TRANSPORT_LOST, STORAGE_FAILURE, INVALID_CALLBACK, DEADLINE, INTERNAL_ERROR
+    }
+    public enum Proof { NO, YES, UNKNOWN }
+    private final Side side;
+    private final LongSupplier clock;
+    private final Consumer<String> sink;
+    private final long started;
+    private Stage stage;
+    private boolean classifiedFailure;
+    private Proof dispatched=Proof.UNKNOWN,pending=Proof.UNKNOWN,terminal=Proof.UNKNOWN;
+
+    public HonorLpaLifecycleTrace(Side side,Stage stage,LongSupplier clock,Consumer<String> sink) {
+        this.side=Objects.requireNonNull(side);this.stage=Objects.requireNonNull(stage);
+        this.clock=Objects.requireNonNull(clock);this.sink=Objects.requireNonNull(sink);
+        started=clock.getAsLong();
+    }
+    public synchronized void enter(Stage next) {stage=Objects.requireNonNull(next);emit("BEGIN",null);}
+    public synchronized void facts(Proof nativeDispatch,Proof durablePending,Proof exactTerminal) {
+        dispatched=Objects.requireNonNull(nativeDispatch);pending=Objects.requireNonNull(durablePending);
+        terminal=Objects.requireNonNull(exactTerminal);
+    }
+    public synchronized void returned(Outcome outcome) {emit("RETURN",Objects.requireNonNull(outcome));}
+    public synchronized void classifiedFailure(Outcome outcome) {
+        classifiedFailure=true;emit("FAIL",Objects.requireNonNull(outcome));
+    }
+    public synchronized void failed(Throwable failure) {
+        if(classifiedFailure) return;
+        Outcome outcome=failure instanceof SecurityException
+                ? dispatched==Proof.NO && pending==Proof.NO ? Outcome.REFUSED_PRE_DISPATCH : Outcome.TERMINAL_UNKNOWN
+                : failure instanceof java.util.concurrent.CancellationException ? Outcome.DISPATCH_UNCERTAIN
+                : failure instanceof java.util.concurrent.TimeoutException || failure instanceof InterruptedException
+                    ? Outcome.DEADLINE
+                : failure instanceof java.io.IOException ? switch(stage) {
+                    case LOCAL_JOURNAL,JOURNAL_COMMIT,RECOVERY_ARM,GRANT,LEASE_FINISH,RECOVERY_FINISH
+                        -> Outcome.STORAGE_FAILURE;
+                    default -> Outcome.TRANSPORT_LOST;
+                }
+                : failure!=null && (failure.getClass().getName().equals("android.os.RemoteException")
+                    || failure.getClass().getName().equals("android.os.DeadObjectException"))
+                    ? Outcome.TRANSPORT_LOST : Outcome.INTERNAL_ERROR;
+        emit("FAIL",outcome);
+    }
+    private void emit(String event,Outcome outcome) {
+        String line="side="+side+" stage="+stage+" event="+event
+                +(outcome==null ? "" : " outcome="+outcome)
+                +" nativeDispatch="+dispatched+" durablePending="+pending+" exactTerminal="+terminal
+                +" elapsedMs="+Math.max(0,clock.getAsLong()-started);
+        try {sink.accept(line);} catch(RuntimeException loggingUnavailable) { /* Observation only. */ }
+    }
+}
