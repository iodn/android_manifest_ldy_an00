+    @Override public void unavailable(int slot, long bindingGeneration) {
+        if (slot < 0 || slot >= 2) return;
+        Session session = sessions[slot];
+        if (session != null && session.bindingGeneration == bindingGeneration) retire(slot);
+        Profile profile = profiles[slot];
+        if (profile != null) profile.defaultOpen.qualify(0, 0);
+        enqueue();
+    }
+
+    @Override public void changed(int slot) {
+        enqueue();
+    }
+
+    private void retire(int slot) {
+        retire(slot, true);
+    }
+
+    private void retire(int slot, boolean clearCache) {
+        Session session = sessions[slot];
+        sessions[slot] = null;
+        if (session == null) return;
+        if (session.pending != 0) unknownRequests[slot] = session.pending;
+        if (session.removal != null) handler.removeCallbacks(session.removal);
+        if (clearCache) session.cache.clear();
+        // No native close and no wire STOP: the hardware owner outlives this call cycle.
+    }
+}
diff --git a/src/com/android/internal/telephony/honor/HonorCallQosPolicy.java b/src/com/android/internal/telephony/honor/HonorCallQosPolicy.java
