+package com.android.internal.telephony.honor;
+public final class MtkAssistVoipStateTest {
+    private static int checks;
+    private static void check(boolean b, String text) {
+        checks++; if (!b) throw new AssertionError(text);
+    }
+    public static void main(String[] args) {
+        MtkAssistVoipState s = new MtkAssistVoipState();
+        Object a = new Object(), b = new Object();
+        s.topology(new int[]{1,2}, new Object[]{a,b});
+        s.binding(0,7); s.binding(1,8);
+        s.offer(1,3);
+        var first=s.next();
+        check(first.slot()==1 && first.values()[0]==1,"MODE3 on current DDS only");
+        check(s.begin(first,11),"Begin");
+        check(s.next()==null,"Global single in-flight");
+        check(!s.response(0,8,11,0,0),"Wrong slot rejected");
+        check(!s.response(1,7,11,0,0),"Wrong generation rejected");
+        check(!s.response(1,8,12,0,0),"Wrong serial rejected");
+        check(!s.response(1,8,11,1,0),"Intermediate ACK not completion");
+        check(s.next()==null,"Intermediate ACK keeps pending");
+        check(s.response(1,8,11,2,0),"Final ACK_EXP accepted");
+        check(s.next()==null,"Identical mode deduplicated globally");
+        s.offer(0,3);
+        var moved=s.next();
+        check(moved.slot()==0 && moved.values()[0]==1,"DDS change sends current true, no old-peer false");
+        check(s.begin(moved,12),"New DDS begin");
+        s.offer(1,2);
+        check(s.next()==null,"DDS change waits for old in-flight completion");
+        check(s.response(0,7,12,0,0),"Old in-flight can retire");
+        var latest=s.next();
+        check(latest.slot()==1 && latest.values()[0]==0,"Fresh MODE2 false after DDS change");
+        check(s.begin(latest,13),"False begin");
+        s.topology(new int[]{1,3},new Object[]{a,new Object()});
+        check(s.next()==null,"Topology change serializes old in-flight");
+        check(s.response(1,8,13,0,0),"Old topology retires without acknowledging new one");
+        check(s.next()!=null,"New topology still dirty");
+        s.binding(1,9);
+        check(!s.response(1,8,13,0,0),"Retired generation cannot acknowledge reconnect");
+        var reconnected=s.next();
+        check(reconnected.binding()==9,"Reconnect uses new binding");
+        check(s.begin(reconnected,14),"Reconnect begin");
+        check(s.response(1,9,14,0,6),"Native error retires request");
+        check(s.next()==null,"Native error does not busy retry");
+        s.invalidate();
+        var replay=s.next();
+        check(s.begin(replay,15),"External refresh permits fresh replay");
+        check(s.timeout(1,9,15),"Bounded timeout");
+        check(s.next()==null,"Timeout no retry loop");
+        s.offer(0,3);
+        s.invalidate();
+        check(s.next()==null,"Unknown timeout fences opposite peer across topology/events");
+        s.binding(0,10);s.recovered(0,10);
+        check(s.next()==null,"Peer reconnect cannot release originating request fence");
+        s.binding(1,11);s.recovered(1,11);
+        check(s.next()!=null,"Qualified originating new epoch releases fence");
+        s.offer(-1,3);
+        check(s.next()==null,"Invalid DDS cannot dispatch");
+        s.offer(1,0);
+        check(s.next().values()[0]==0,"Normal mode false");
+        check(!s.begin(first,16),"Stale event snapshot rejected");
+        System.out.println("MtkAssistVoipState: "+checks+" checks PASS");
+    }
+}
diff --git a/tests/host/com/android/internal/telephony/honor/PhysicalControllerReconciliationHostTest.java b/tests/host/com/android/internal/telephony/honor/PhysicalControllerReconciliationHostTest.java
