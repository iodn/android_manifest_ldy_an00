+    record RecoveryAdmission(int slot, long bindingGeneration, long profileGeneration,
+            long processedNativeSequence, MtkAssistProfile profileTuple,
+            HonorSubscriberAdoption.Proof adoption, boolean quiescent) {
+        @Override public String toString() {
+            return "RecoveryAdmission[identifiers omitted]";
+        }
+    }
