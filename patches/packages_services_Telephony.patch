+    }
+    private static volatile HonorMtkSimTypeProbeOwner instance;
+    private static volatile Preparation preparation=Preparation.NOT_ATTEMPTED;
+    private static boolean prepareAttempted;
+    private final MtkSimSerials serials;
+    private final MtkSimTypeTransport transport;
+    private final AtomicBoolean failed=new AtomicBoolean(), queryRequested=new AtomicBoolean();
+    private volatile long generation=1;
+    private MtkSimTypeQuery query;
+    private int querySerial, diagnosticWrites;
+
+    public static HonorMtkSimTypeProbeOwner existingOwner() {return instance;}
+    public static Preparation preparation() {return preparation;}
+
+    /** Initial-history qualification must come from the controlled trial, never an Intent extra. */
+    public static synchronized void prepareAsync(boolean initialHistoryQualified,
+            Consumer<HonorMtkSimTypeProbeOwner> ready,Consumer<String> rejected) {
+        Objects.requireNonNull(ready);Objects.requireNonNull(rejected);
+        if(prepareAttempted) throw new IllegalStateException("Probe preparation already attempted");
+        prepareAttempted=true;preparation=Preparation.PREPARING;
+        Handler main=new Handler(Looper.getMainLooper());
+        HandlerThread thread=new HandlerThread("LdyAn00SimTypeProbe");thread.start();
+        Handler worker=new Handler(thread.getLooper());
+        if(!worker.post(()->{
+            // 1 build, 2 Phone identity, 3 journal, 4 serial history, 5 service lookup,
+            // 6 transport identity/worker, 7 callback registration, 8 owner publication.
+            int stage=1;
+            try {
+                requireControlledProbeBuild(); // BEFORE storage, remote metadata or callback registration.
+                stage=2;requirePhoneProcess();
+                stage=3;
+                new SepMuxJournal(new AtomicSepMuxStore(PhoneGlobals.getInstance())).requireClean();
+                stage=4;
+                MtkSimSerials serials=new MtkSimSerials(
+                        AtomicSepMuxStore.forMtkSerials(PhoneGlobals.getInstance()),
+                        initialHistoryQualified);
