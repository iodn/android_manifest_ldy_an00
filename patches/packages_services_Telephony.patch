+package com.android.internal.telephony.honor;
+import android.os.*;
+import com.android.phone.PhoneGlobals;
+import vendor.honor.hardware.hnradio.*;
+import java.util.*;
+
+/** Executes production broker against deterministic typed Binder/service/looper fixtures. */
+public final class HonorRadioCommBrokerHostTest {
+ static int checks;
+ static void ok(boolean b){checks++;if(!b)throw new AssertionError("check "+checks);}
+ static final Handler reply=new Handler(new Looper());
+ static final List<HonorRadioCommBroker.CallResult> results=new ArrayList<>();
+ static final class Radio extends Binder implements IRadio {
+  record Sent(int serial,int message,MsgPayload payload){}
+  final List<Sent> sent=new ArrayList<>();
+  final List<DeathRecipient> deaths=new ArrayList<>();
+  IRadioResponse response;IRadioIndication indication;int registrations,acks;boolean alive=true,failAck;
+  public int getInterfaceVersion(){return 6;}
+  public String getInterfaceHash(){return SepMuxTrial.VENDOR_HASH;}
+  public void setResponseFunctionsHn(IRadioResponse r,IRadioIndication i){response=r;indication=i;registrations++;}
+  public void sendCommRequest(int s,int m,MsgPayload p){sent.add(new Sent(s,m,p));}
+  public void responseAcknowledgement() throws RemoteException {acks++;if(failAck)throw new RemoteException("synthetic ACK failure");}
+  @Override public void linkToDeath(DeathRecipient d,int flags){deaths.add(d);}
+  @Override public boolean unlinkToDeath(DeathRecipient d,int flags){return deaths.remove(d);}
+  @Override public boolean isBinderAlive(){return alive;}
+  void die(){alive=false;for(DeathRecipient d:List.copyOf(deaths))d.binderDied();}
+  void respond(int serial,int type,int error,int message){
+   RadioResponseInfo info=new RadioResponseInfo();info.serial=serial;info.type=type;info.error=error;
+   response.sendCommRequestResponse(info,message,new MsgPayload());
+  }
+ }
+ static final class Sink implements HonorRadioCommBroker.MuxSink {
+  int finals,indications,lost,type=-1;boolean comm;
+  public void response(RadioResponseInfo i,int m,boolean c){finals++;type=i.type;comm=c;}
+  public void indication(int m,int[] values){indications++;}
+  public void unavailable(){lost++;}
+ }
+ static Radio.Sent last(Radio r){return r.sent.get(r.sent.size()-1);}
+ static void submit(int slot,boolean start,long token){HonorRadioCommBroker.sendCallQos(slot,start,token,reply,results::add);Looper.drain();}
+ static void result(long token,HonorRadioCommBroker.Outcome expected){
+  long count=results.stream().filter(r->r.requestToken()==token && r.outcome()==expected).count();
+  ok(count==1);ok(results.stream().filter(r->r.requestToken()==token).count()==1);
+ }
+ public static void main(String[] args)throws Exception {
+  Radio a=new Radio(),b=new Radio();
+  ServiceManager.services.put("vendor.honor.hardware.hnradio.IRadio/slot1",a);
+  ServiceManager.services.put("vendor.honor.hardware.hnradio.IRadio/slot2",b);
+  AtomicSepMuxStore.value="SEP1 CLEAN 1 1000000000 0\n";
+  HonorRadioCommBroker.initialize(PhoneGlobals.getInstance());Looper.drain();
+  ok(a.registrations==1 && b.registrations==1);ok(HonorRadioCommBroker.snapshot(0).ready());ok(HonorRadioCommBroker.snapshot(1).ready());
+  boolean[] regionalRoute={false},regionalSafe={true};int[] releaseDemands={0};
+  HonorLpaLeaseService.lease.setImsPolicyGate(LpaOperationLease.ImsPolicyOwner.HNCALL_REGIONAL,
+    new Object(),()->regionalRoute[0],()->regionalSafe[0],()->releaseDemands[0]++);
+  ok(HonorRadioCommBroker.snapshot(0).ready()&&releaseDemands[0]==0);
+  try{HonorLpaLeaseService.lease.requireRouteAllowed();throw new AssertionError();}
+  catch(IllegalStateException expected){checks++;}
+  ok(releaseDemands[0]==0); // A passive route assertion cannot undo the accepted cure.
+  try{HonorLpaLeaseService.lease.requestRouteAdmission();throw new AssertionError();}
+  catch(IllegalStateException expected){checks++;}
+  ok(releaseDemands[0]==1&&HonorRadioCommBroker.snapshot(0).ready());
+  int[] notices={0};HonorRadioCommBroker.addStateListener(reply,()->notices[0]++);Looper.drain();ok(notices[0]==1);
+  submit(1,true,1);ok(last(b).serial()>1000000000);
+  b.respond(last(b).serial(),0,0,101);Looper.drain();result(1,HonorRadioCommBroker.Outcome.ACKNOWLEDGED);
+  ok(releaseDemands[0]==1); // Actual QoS START/ACK coexists with an accepted regional vote.
+  regionalSafe[0]=false;ok(!HonorRadioCommBroker.snapshot(0).ready()&&releaseDemands[0]==1);
+  regionalSafe[0]=true;
+  Object policyTicket=HonorLpaLeaseService.lease.beginImsPolicyMutation(LpaOperationLease.ImsPolicyOwner.HNCALL_REGIONAL);
+  ok(!HonorRadioCommBroker.snapshot(0).ready()&&releaseDemands[0]==1);
+  HonorLpaLeaseService.lease.finishImsPolicyMutation(policyTicket);regionalRoute[0]=true;
+  ok(HonorRadioCommBroker.snapshot(0).ready());
+  Sink oldSink=new Sink();
+  var mux=HonorRadioCommBroker.attachMux(oldSink,null);ok(b.registrations==1);
+  int canceled=mux.allocate(1);int beforeCancellation=b.sent.size();ok(mux.cancelNeverSent(canceled));ok(!mux.cancelNeverSent(canceled));
+  try{mux.sendMux(canceled,new MsgPayload());throw new AssertionError();}catch(IllegalStateException expected){checks++;}
+  ok(b.sent.size()==beforeCancellation);ok(!mux.cancelNeverSent(canceled+100));
+  int muxSerial=mux.allocate(900);mux.sendMux(muxSerial,new MsgPayload());ok(!mux.cancelNeverSent(muxSerial));
+  submit(1,true,2);Radio.Sent qos=last(b);ok(qos.message()==101 && qos.serial()>muxSerial);
+  ok(Arrays.equals(qos.payload().bytes,HonorCallQosCodec.encode(true)));ok(qos.payload().nData==0 && qos.payload().nDatas.length==0);
+  long pendingGeneration=HonorRadioCommBroker.snapshot(1).generation();
+  ok(!HonorRadioCommBroker.snapshot(1).ready());
+  try {HonorLpaLeaseService.lease.beginPrimarySelection();throw new AssertionError();}catch(IllegalStateException expected){checks++;}
+  ok(HonorRadioCommBroker.snapshot(1).generation()==pendingGeneration);
+  b.respond(qos.serial(),1,0,101);Looper.drain();ok(results.stream().noneMatch(r->r.requestToken()==2));ok(b.acks==0);
+  b.respond(qos.serial(),2,0,101);Looper.drain();result(2,HonorRadioCommBroker.Outcome.ACKNOWLEDGED);ok(HonorRadioCommBroker.isCallQosDrained(1,2));ok(b.acks==1);ok(oldSink.finals==0);
+  b.respond(qos.serial(),2,0,101);Looper.drain();ok(b.acks==1);result(2,HonorRadioCommBroker.Outcome.ACKNOWLEDGED);
+  b.respond(muxSerial,2,0,1005);Looper.drain();ok(b.acks==2);ok(oldSink.finals==1 && oldSink.type==0 && oldSink.comm);
+  int stale=mux.allocate(muxSerial+1);mux.sendMux(stale,new MsgPayload());mux.retire();
+  Sink freshSink=new Sink();var fresh=HonorRadioCommBroker.attachMux(freshSink,mux);ok(b.registrations==1);
+  int current=fresh.allocate(1);fresh.sendMux(current,new MsgPayload());ok(current>stale);
+  b.respond(stale,2,0,1005);Looper.drain();ok(b.acks==3 && freshSink.finals==0 && oldSink.finals==1);
