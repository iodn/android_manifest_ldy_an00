@@ -0,0 +1,776 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.internal.telephony.honor;
+
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+import android.content.IntentFilter;
+import android.content.pm.PackageManager;
+import android.os.Build;
+import android.os.Handler;
+import android.os.SystemClock;
+import android.os.SystemProperties;
+import android.telephony.SubscriptionManager;
+import android.telephony.TelephonyManager;
+import android.provider.Settings;
+import android.util.Log;
+
+import com.android.internal.telephony.Phone;
+import com.android.internal.telephony.PhoneConfigurationManager;
+import com.android.internal.telephony.PhoneConstants;
+import com.android.internal.telephony.PhoneFactory;
+import com.android.internal.telephony.uicc.UiccController;
+
+/** Source-owned Collie call-QoS integration. Never selects a SIM or changes data preferences. */
+public final class HonorCallQosController implements HnCallHardwareOwner.Listener {
+    private static final String TAG = "LdyAn00CallQos";
+    private static volatile HonorCallQosController instance;
+    private static final java.util.List<java.util.function.Consumer<HonorCompletedCallQoe.Result>>
+            completedListeners = new java.util.ArrayList<>();
+    private static final java.util.List<java.util.function.Consumer<QualifiedConfiguration>>
+            configurationListeners = new java.util.ArrayList<>();
+    private record RecoveryNotice(Handler handler,Runnable callback) {}
+    private static final java.util.List<RecoveryNotice> recoveryNotices=new java.util.ArrayList<>();
+    /** Only enqueues observation; it neither submits a request nor changes native ownership. */
+    static void addRecoveryAdmissionListener(Handler handler,Runnable callback) {
+        java.util.Objects.requireNonNull(handler);java.util.Objects.requireNonNull(callback);
+        UiccController.getInstance().post(()->{
+            recoveryNotices.add(new RecoveryNotice(handler,callback));handler.post(callback);
+        });
+    }
+    private static void recoveryAdmissionChanged() {
+        for(RecoveryNotice notice:java.util.List.copyOf(recoveryNotices))
+            notice.handler().post(notice.callback());
+    }
+    private final Context context;
+    private final Handler handler;
+    private final HnCallHardwareOwner hardware;
+    private static HonorImsDcController.InputsProvider dcInputs;
+    private static HonorImsDcController.Backend dcBackend;
+    private HonorImsDcController dcRecovery;
+    private final Profile[] profiles = new Profile[2];
+    private final Session[] sessions = new Session[2];
+    private final long[] unknownRequests = new long[2];
+    private Phone[] phones = new Phone[0];
+    private boolean queued;
+    private long nextEpoch = 1, nextProfile = 1, nextRequest = 1;
+    private boolean lastAllIdle = true;
+
+    private static final class Profile {
+        final Phone phone;
+        final Object card, uiccProfile;
+        final String iccIdentity;
+        final int subId;
+        final long generation, brokerGeneration;
+        boolean idleAtAdmission;
+        boolean qualified, identityUsable;
+        // Custody of this source's entered START attempt on the hnradio writer/profile.
+        // An hncall observer reconnect alone does not change it; CP-applied state is unknown.
+        boolean ownedStart;
+        long observedBinding, qualitySequence, processedSequence;
+        HonorMtkVoiceQualityDecoder.Quality quality;
+        final HonorImsDefaultOpenState defaultOpen;
+
+        Profile(int slot, Phone phone, Object card, Object uiccProfile, String iccIdentity,
+                long generation, long brokerGeneration,
+                boolean idleAtAdmission) {
+            this.phone = phone;
+            this.card = card;
+            this.uiccProfile = uiccProfile;
+            this.iccIdentity = iccIdentity;
+            subId = phone.getSubId();
+            this.generation = generation;
+            this.brokerGeneration = brokerGeneration;
+            this.idleAtAdmission = idleAtAdmission;
+            defaultOpen = new HonorImsDefaultOpenState(slot);
+        }
+    }
+
+    private static final class Session {
+        final int slot, subId;
+        final Phone phone;
+        final Object card;
+        final long epoch, brokerGeneration, bindingGeneration, profileGeneration;
+        final boolean idleAtAdmission;
+        final HonorCallQosSnapshot cache;
+        final HonorCallQosPolicy policy = new HonorCallQosPolicy();
+        boolean complete, unresolvedSip;
+        long lastSequence, terminalSequence, cycleBarrier, priorTerminalSequence;
+        final java.util.Set<Integer> orphanCalls = new java.util.HashSet<>();
+        Boolean desired, acknowledged, refusedVote;
+        long pending;
+        boolean deferred;
+        Runnable removal;
+
+        Session(int slot, Profile profile, long epoch,
+                HnCallHardwareOwner.Snapshot source, HonorCallQosSnapshot retained,
+                java.util.function.Consumer<HonorCompletedCallQoe.Result> completion) {
+            this.slot = slot;
+            phone = profile.phone;
+            subId = profile.subId;
+            card = profile.card;
+            this.epoch = epoch;
+            brokerGeneration = profile.brokerGeneration;
+            bindingGeneration = source.bindingGeneration();
+            profileGeneration = source.profileGeneration();
+            idleAtAdmission = profile.idleAtAdmission;
+            complete = idleAtAdmission;
+            cache = retained == null ? new HonorCallQosSnapshot(
+                    slot, bindingGeneration, profileGeneration, completion) : retained;
+            cache.setNewCallQualified(complete);
+        }
+    }
+
+    public static void initialize(Context context) {
+        if (!"LDY-AN00".equals(Build.MODEL) || !"ldy_an00".equals(Build.DEVICE)
+                || !HonorCallQosPolicy.supportsPlatform(
+                        SystemProperties.get("ro.board.platform", ""))) return;
+        try {
+            context.getPackageManager().getApplicationInfo("com.hihonor.systemserver", 0);
+            return;
+        } catch (PackageManager.NameNotFoundException expected) {
+            // This product excludes the stock HnCollie host and owns this one hncall client.
+        }
+        UiccController.getInstance().post(() -> {
+            if (instance != null) return;
+            try {
+                HonorRadioCommBroker.initialize(context.getApplicationContext());
+                HonorSubscriberAdoption.initialize(context.getApplicationContext());
+            } catch (IllegalStateException unavailableOwner) {
+                Log.w(TAG, "Shared radio owner unavailable; call QoS remains inactive");
+                return;
+            }
+            instance = new HonorCallQosController(context);
+        });
+    }
+
+    private HonorCallQosController(Context context) {
+        this.context = context.getApplicationContext();
+        handler = new Handler(UiccController.getInstance().getLooper(), message -> {
+            externalEvent();
+            return true;
+        });
+        hardware = new HnCallHardwareOwner(this.context, handler, this);
+        HonorRadioCommBroker.addStateListener(handler, this::brokerChanged);
+        HonorSubscriberAdoption.addListener(handler, this::enqueue);
+        this.context.getSystemService(SubscriptionManager.class)
+                .addOnSubscriptionsChangedListener(command -> handler.post(command),
+                        new SubscriptionManager.OnSubscriptionsChangedListener() {
+                            @Override public void onSubscriptionsChanged() { externalEvent(); }
+                        });
+        PhoneConfigurationManager.registerForMultiSimConfigChange(handler, 1, null);
+        IntentFilter filter = new IntentFilter(TelephonyManager.ACTION_PHONE_STATE_CHANGED);
+        filter.addAction(Intent.ACTION_AIRPLANE_MODE_CHANGED);
+        this.context.registerReceiver(new BroadcastReceiver() {
+            @Override public void onReceive(Context ignored, Intent intent) { externalEvent(); }
+        }, filter, null, handler);
+        attachDcRecovery();
+        enqueue();
+        hardware.start();
+    }
+
+    private void externalEvent() {
+        for (Session session : sessions) {
+            if (session != null) {
+                session.refusedVote = null;
+                session.deferred = false;
+            }
+        }
+        hardware.refresh();
+        enqueue();
+    }
+
+    private void brokerChanged() {
+        for (int slot = 0; slot < 2; slot++) {
+            long token = unknownRequests[slot];
+            if (token != 0 && HonorRadioCommBroker.isCallQosDrained(slot, token)) {
+                unknownRequests[slot] = 0;
+            }
+            Session session = sessions[slot];
+            if (session != null) session.deferred = false;
+        }
+        // A request's own completion readiness event must not retry a native refusal.
+        enqueue();
+    }
+
+    private void enqueue() {
+        if (queued) return;
+        queued = true;
+        handler.post(() -> {
+            queued = false;
+            review();
+        });
+    }
+
+    private void installPhones(Phone[] current) {
+        if (java.util.Arrays.equals(phones, current)) return;
+        for (Phone phone : phones) phone.mCi.unregisterForRadioStateChanged(handler);
+        for (int slot = 0; slot < 2; slot++) retire(slot);
+        phones = current.clone();
+        for (int slot = 0; slot < phones.length; slot++) {
+            phones[slot].mCi.registerForRadioStateChanged(handler, 10 + slot, null);
+        }
+    }
