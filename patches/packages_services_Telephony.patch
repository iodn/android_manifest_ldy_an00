@@ -0,0 +1,32 @@
+/* Copyright (C) 2026 The LineageOS Project. SPDX-License-Identifier: Apache-2.0 */
+package com.android.internal.telephony.honor;
+
+import com.android.internal.telephony.Phone;
+import com.android.internal.telephony.PhoneConstants;
+import com.android.internal.telephony.PhoneFactory;
+
+/** Last-moment cached call-state admission for shared SIM power/route changes. */
+public final class HonorSimRouteCallGuard {
+    private HonorSimRouteCallGuard() {}
+    public static final class CallBusy extends IllegalStateException {
+        private CallBusy() {super("SIM route change blocked by call or emergency state");}
+    }
+    public static void requireIdle() {
+        Phone[] phones=PhoneFactory.getPhones();
+        if(phones==null || phones.length<2)
+            throw new IllegalStateException("SIM route call state unavailable");
+        for(Phone phone:phones) {
+            requireIdle(phone);
+            // Base getState includes IMS calls, but legacy emergency/ECM fields can differ.
+            Phone ims=phone.getImsPhone();
+            if(ims!=null) requireIdle(ims);
+        }
+    }
+    private static void requireIdle(Phone phone) {
+        if(phone==null) throw new IllegalStateException("SIM route call state unavailable");
+        PhoneConstants.State state=phone.getState();
+        if(state==null) throw new IllegalStateException("SIM route call state unavailable");
+        if(state!=PhoneConstants.State.IDLE || phone.isInEmergencyCall()
+                || phone.isInEcm() || phone.isInEmergencySmsMode()) throw new CallBusy();
+    }
+}
