--- /dev/null
+++ b/src/com/android/internal/telephony/honor/HonorRadioCommBroker.java
@@ -0,0 +1,587 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.internal.telephony.honor;
+
+import android.app.Application;
+import android.content.Context;
+import android.os.*;
+import android.os.Process;
+import com.android.internal.telephony.PhoneFactory;
+import vendor.honor.hardware.hnradio.*;
+import java.security.SecureRandom;
+import java.util.*;
+import java.util.concurrent.atomic.AtomicLong;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.concurrent.atomic.AtomicBoolean;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.function.Consumer;
+
+/** Sole Hnradio callback pair per slot. Call QoS and the shared-SIM owner are local clients. */
+final class HonorRadioCommBroker {
+    public enum Outcome { ACKNOWLEDGED, DEFERRED, REFUSED, UNKNOWN }
+    public record CallResult(int slot, long requestToken, Outcome outcome) {}
+    public record Snapshot(long generation, boolean ready) {}
+    interface MuxSink {
+        void response(RadioResponseInfo info,int message,boolean comm);
+        void indication(int message,int[] values);
+        void unavailable();
+    }
+    private static final String SERVICE="vendor.honor.hardware.hnradio.IRadio";
+    private static final long DEADLINE=20_000;
+    private static volatile HonorRadioCommBroker instance;
+    private final Context context;
+    private final Handler worker;
+    private volatile boolean observerInstalled;
+    private final Slot[] slots={new Slot(0),new Slot(1)};
+    private final List<Notice> listeners=new ArrayList<>();
+    private record Notice(Handler handler,Runnable callback) {}
+    private static final class Qos {
+        final HonorRadioCommBroker owner;
+        final int slot; final long token, generation; final Handler handler; final Consumer<CallResult> callback;
+        final AtomicBoolean done=new AtomicBoolean();
+        Qos(HonorRadioCommBroker owner,int slot,long token,long generation,Handler handler,Consumer<CallResult> callback) {
+            this.owner=owner;this.slot=slot;this.token=token;this.generation=generation;this.handler=handler;this.callback=callback;
+        }
+        void finish(Outcome outcome) {
+            if(!done.compareAndSet(false,true))return;
+            if(owner!=null && outcome!=Outcome.UNKNOWN)owner.provenDrained(owner.slots[slot],token);
+            handler.post(()->callback.accept(new CallResult(slot,token,outcome)));
+        }
+    }
+    private static final class Slot {
+        final int id;
+        final AtomicLong generation=new AtomicLong(1);
+        final AtomicLong requestToken=new AtomicLong();
+        final HonorCommRequests requests=new HonorCommRequests(
+                0x10000000+new SecureRandom().nextInt(0x10000000));
+        final Map<Integer,Qos> qos=new HashMap<>();
+        final Set<Integer> uncertain=new HashSet<>();
+        final AtomicInteger uncertainCount=new AtomicInteger();
+        final Map<Long,Boolean> drained=new ConcurrentHashMap<>();
+        final ArrayDeque<Long> drainOrder=new ArrayDeque<>();
+        volatile Endpoint endpoint;
+        MuxConnection mux;
+        long binding;
+        Slot(int id){this.id=id;}
+    }
+    private HonorRadioCommBroker(Context context) {
+        this.context=context;
+        HandlerThread thread=new HandlerThread("HonorRadioComm");thread.start();
+        worker=new Handler(thread.getLooper());
+    }
+    public static synchronized void initialize(Context context) {
+        if(instance!=null)return;
+        SepMuxTrial.requireLdyAn00Identity(Build.MODEL,Build.DEVICE);
+        if(Process.myUid()!=1001 || !"com.android.phone".equals(Application.getProcessName()))
