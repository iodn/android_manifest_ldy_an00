+package com.android.internal.telephony.honor;
+
+public final class RecoverySimPowerTest {
+    private static final String EID="12345678901234567890123456789012";
+    private static int checks;
+    private static void check(boolean value) {checks++;if(!value)throw new AssertionError();}
+    private static void refuse(Runnable action) {
+        try {action.run();} catch(IllegalStateException expected) {checks++;return;}
+        throw new AssertionError("Unexpected power proof");
+    }
+    private static RecoverySimPower start() {return new RecoverySimPower(7,9,100);}
+    private static RecoverySimPower down() {
+        var p=start();p.baseline(7,1,0,true,EID,101);return p;
+    }
+    private static RecoverySimPower up() {
+        var p=down();p.powerCompleted(7,RecoverySimPower.Phase.DOWN,true,102);
+        p.poweredDown(7,1,0,0,103);return p;
+    }
+    private static RecoverySimPower card() {
+        var p=up();p.powerCompleted(7,RecoverySimPower.Phase.UP,true,104);
+        p.route(7,true,105);return p;
+    }
+    private static SepMuxRouteAdoption.Proof observed() {
+        var a=new SepMuxRouteAdoption(null,7,19,100);
+        a.response(7,19,0,0,1,1,0,105);
+        var s=new EuiccReadiness.Snapshot(a.endpoint,0,new Object(),new Object(),new Object(),
+                1,1,0,2,2,true,true,true,true,EID);
+        return a.card(7,true,true,1,0,EID,s,s,106);
+    }
+    public static void main(String[] ignored) throws Exception {
+        var valid=card();var proof=valid.finish(observed(),EID,107);
+        check(proof.generation==7 && proof.serial==9 && valid.phase()==RecoverySimPower.Phase.READY);
+        refuse(()->valid.finish(observed(),EID,108));
+        for(int i=0;i<8;i++) {
+            var p=start();final int n=i;
+            refuse(()->p.baseline(n==0 ? 8:7,n==1 ? 0:1,n==2 ? 1:0,n!=3,
+                    n==4 ? "":EID,n==5 ? 99:n==6 ? 30100:n==7 ? 30101:101));
+            check(p.phase()==RecoverySimPower.Phase.UNKNOWN);
+        }
+        var early=start();refuse(()->early.powerCompleted(7,RecoverySimPower.Phase.UP,true,101));
+        var badDown=down();refuse(()->badDown.powerCompleted(7,RecoverySimPower.Phase.DOWN,false,102));
+        var badUp=up();refuse(()->badUp.powerCompleted(7,RecoverySimPower.Phase.UP,false,104));
+        var wrongEpoch=down();refuse(()->wrongEpoch.powerCompleted(8,RecoverySimPower.Phase.DOWN,true,102));
+        var late=down();refuse(()->late.powerCompleted(7,RecoverySimPower.Phase.DOWN,true,30100));
+        var duplicate=down();duplicate.powerCompleted(7,RecoverySimPower.Phase.DOWN,true,102);
+        refuse(()->duplicate.powerCompleted(7,RecoverySimPower.Phase.DOWN,true,103));
+        for(int i=0;i<3;i++) {
+            var p=down();p.powerCompleted(7,RecoverySimPower.Phase.DOWN,true,102);final int n=i;
+            refuse(()->p.poweredDown(7,n==0 ? 0:1,n==1 ? 1:0,n==2 ? 1:0,103));
+        }
+        var mode=up();mode.powerCompleted(7,RecoverySimPower.Phase.UP,true,104);refuse(()->mode.route(7,false,105));
+        var absent=card();refuse(()->absent.finish(null,EID,107));
+        var wrongEid=card();refuse(()->wrongEid.finish(observed(),"00000000000000000000000000000000",107));
+        var expiry=card();refuse(()->expiry.finish(observed(),EID,30100));
+        class Store implements SepMuxJournal.Store {
+            String value;
+            Store(String value) {this.value=value;}
+            public String read() {return value;}
+            public void writeDurably(String value) {this.value=value;}
+        }
+        var fenceStore=new Store(null);var fence=new LpaRecoveryFence(fenceStore);
+        String before="00000000-0000-0000-0000-000000000001";
+        String after="00000000-0000-0000-0000-000000000002";
+        String app=LpaRecoveryFence.hash("A\n");
+        fence.arm(before,app,1000,"journals");fence.begin(after,app,1000,"journals");
+        var store=new Store("SEP1 UNKNOWN 1 2 1\n");
+        var journal=SepMuxJournal.forRecovery(store,fence);
+        journal.pending(7,9,SepMuxTrial.Selector.EUICC);
+        var cycle=card();var good=cycle.finish(observed(),EID,107);
+        journal.completedRecoveryPower(fence,good);
+        check(store.value.equals("SEP1 CLEAN 7 9 1\n"));
+        try {journal.completedRecoveryPower(fence,good);throw new AssertionError();}
+        catch(java.io.IOException expected) {checks++;}
+        var wrongStore=new Store("SEP1 UNKNOWN 1 2 1\n");
+        var wrongJournal=SepMuxJournal.forRecovery(wrongStore,fence);
+        wrongJournal.pending(6,9,SepMuxTrial.Selector.EUICC);
+        try {wrongJournal.completedRecoveryPower(fence,good);throw new AssertionError();}
+        catch(java.io.IOException expected) {checks++;}
+        check(wrongStore.value.startsWith("SEP1 PENDING"));
+        System.out.println("RECOVERY_SIM_POWER_HOST_PASS checks="+checks);
+    }
+}
