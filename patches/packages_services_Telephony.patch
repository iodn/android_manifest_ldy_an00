diff --git a/tests/src/com/android/internal/telephony/honor/MtkSimTypeTransportTest.java b/tests/src/com/android/internal/telephony/honor/MtkSimTypeTransportTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..ec2207ffb8bf9e2051fe168dc64634ab301d5b7d
--- /dev/null
+++ b/tests/src/com/android/internal/telephony/honor/MtkSimTypeTransportTest.java
@@ -0,0 +1,230 @@
+/* Copyright (C) 2026 The LineageOS Project. SPDX-License-Identifier: Apache-2.0 */
+package com.android.internal.telephony.honor;
+
+import static org.junit.Assert.assertArrayEquals;
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNotNull;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertThrows;
+import static org.junit.Assert.assertTrue;
+
+import android.os.Binder;
+import android.os.Handler;
+import android.os.HandlerThread;
+import android.os.IBinder;
+import android.os.Parcel;
+import android.os.RemoteException;
+import androidx.test.ext.junit.runners.AndroidJUnit4;
+import androidx.test.filters.SmallTest;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+import java.util.concurrent.CopyOnWriteArrayList;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.FutureTask;
+import java.util.concurrent.TimeUnit;
+import java.util.function.Consumer;
+import org.junit.After;
+import org.junit.Before;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+
+/** Real Android Binder/Parcel/Handler, with a local Binder only. Never looks up a vendor service. */
+@RunWith(AndroidJUnit4.class)
+@SmallTest
+public class MtkSimTypeTransportTest {
+    // Independent literals from the exact stock V2 NDK ABI receipt, not production constants.
+    private static final String SIM="vendor.mediatek.hardware.mtkradioex.sim.IMtkRadioExSim";
+    private static final String HASH="dd10c80aa3478fddc0a46cab8597191943a29052";
+    private HandlerThread thread;
+    private Handler worker;
+    private MtkSimTypeTransport transport;
+    private FakeRadio radio;
+    private final RecordingListener listener=new RecordingListener();
+
+    @Before public void setUp() {
+        thread=new HandlerThread("MtkSimTypeTransportTest");thread.start();
+        worker=new Handler(thread.getLooper());
+    }
+    @After public void tearDown() throws Exception {
+        thread.quitSafely();thread.join(5000);assertFalse(thread.isAlive());
+    }
+    private interface Action {void run() throws Exception;}
+    private void onWorker(Action action) throws Exception {
+        FutureTask<Void> task=new FutureTask<>(()->{action.run();return null;});
+        assertTrue(worker.post(task));task.get(5,TimeUnit.SECONDS);
+    }
+    private void create() throws Exception {
+        radio=new FakeRadio();
+        onWorker(()->transport=new MtkSimTypeTransport(radio,worker,listener));
+    }
+    private void register() throws Exception {create();onWorker(transport::registerCallbacks);}
+    private void drain() throws Exception {onWorker(()->{});}
+    private void send(boolean response,int code,Consumer<Parcel> write) throws Exception {
+        Parcel p=Parcel.obtain();
+        try {
+            p.writeInterfaceToken(SIM+(response ? "Response" : "Indication"));write.accept(p);
+            assertTrue((response ? radio.response : radio.indication)
+                    .transact(code,p,null,IBinder.FLAG_ONEWAY));
+        } finally {p.recycle();}
+    }
+    // Sized AIDL object: explicit presence word, 16-byte object, three int32 fields.
+    private static void object(Parcel p,int a,int b,int c) {
+        p.writeInt(1);p.writeInt(16);p.writeInt(a);p.writeInt(b);p.writeInt(c);
+    }
+    private void unavailable() throws Exception {
+        assertTrue(listener.unavailable.await(5,TimeUnit.SECONDS));
+        assertFalse(transport.isHealthy());drain();assertTrue(thread.isAlive());
+    }
+
+    @Test public void rejectsMetadataMismatchBeforeCallbackRegistration() throws Exception {
+        FakeRadio wrongVersion=new FakeRadio();wrongVersion.version=3;
+        onWorker(()->assertThrows(RemoteException.class,
+                ()->new MtkSimTypeTransport(wrongVersion,worker,listener)));
+        assertNull(wrongVersion.response);assertNull(wrongVersion.indication);
+        assertEquals(Arrays.asList(16777215),wrongVersion.codes());
+        FakeRadio wrongHash=new FakeRadio();wrongHash.hash="not-the-stock-hash";
+        onWorker(()->assertThrows(RemoteException.class,
+                ()->new MtkSimTypeTransport(wrongHash,worker,listener)));
+        assertNull(wrongHash.response);assertNull(wrongHash.indication);
+        assertEquals(Arrays.asList(16777215,16777214),wrongHash.codes());
+    }
+    @Test public void registrationIsExplicitOrderedOnceAndDoesNotQuery() throws Exception {
+        create();assertEquals(Arrays.asList(16777215,16777214),radio.codes());
+        assertNull(radio.response);assertNull(radio.indication);
+        onWorker(transport::registerCallbacks);
+        assertEquals(Arrays.asList(16777215,16777214,37),radio.codes());
+        assertEquals(SIM+"Response",radio.response.getInterfaceDescriptor());
+        assertEquals(SIM+"Indication",radio.indication.getInterfaceDescriptor());
+        onWorker(()->assertThrows(IllegalStateException.class,transport::registerCallbacks));
+        assertEquals(Arrays.asList(16777215,16777214,37),radio.codes());
+    }
+    @Test public void callbackBindersExposeExactStableMetadata() throws Exception {
+        register();
+        for(IBinder callback:new IBinder[]{radio.response,radio.indication}) {
+            for(int code:new int[]{16777215,16777214}) {
+                Parcel data=Parcel.obtain(), reply=Parcel.obtain();
+                try {
+                    data.writeInterfaceToken(callback.getInterfaceDescriptor());
+                    assertTrue(callback.transact(code,data,reply,0));reply.readException();
+                    if(code==16777215) assertEquals(2,reply.readInt());
+                    else assertEquals(HASH,reply.readString());
+                    reply.enforceNoDataAvail();
+                } finally {data.recycle();reply.recycle();}
+            }
+        }
+    }
+    @Test public void commandsUseExactRequestCodesAndArgumentOrder() throws Exception {
+        register();onWorker(()->transport.query(71));
+        assertEquals(40,radio.last().code);assertArrayEquals(new int[]{71,0},radio.last().args);
+        onWorker(()->transport.select(73,1));
+        assertEquals(41,radio.last().code);assertArrayEquals(new int[]{73,1,0},radio.last().args);
+        int before=radio.frames.size();
+        onWorker(()->assertThrows(IllegalArgumentException.class,()->transport.select(75,2)));
+        assertEquals(before,radio.frames.size());
+    }
+    @Test public void callbacksDecodeTypedFieldsAndAcknowledgeOnlyExpectedTypes() throws Exception {
+        register();
+        send(true,35,p->{object(p,0,81,0);object(p,1,0,0);});
+        send(true,35,p->{object(p,1,82,0);object(p,1,0,0);});
+        send(true,35,p->{object(p,2,83,7);object(p,1,1,0);});
+        send(true,36,p->object(p,0,84,0));
+        send(true,36,p->object(p,2,85,9));
+        send(false,15,p->{p.writeInt(0);object(p,1,0,0);});
+        send(false,15,p->{p.writeInt(1);object(p,1,1,0);});
+        drain();
+        assertEquals(3,listener.queries.size());
+        assertArrayEquals(new int[]{0,81,0,1,0,0},listener.queries.get(0));
+        assertArrayEquals(new int[]{1,82,0,1,0,0},listener.queries.get(1));
+        assertArrayEquals(new int[]{2,83,7,1,1,0},listener.queries.get(2));
+        assertArrayEquals(new int[]{0,84,0},listener.switches.get(0));
+        assertArrayEquals(new int[]{2,85,9},listener.switches.get(1));
+        assertArrayEquals(new int[]{1,0,0},listener.changes.get(0));
+        assertArrayEquals(new int[]{1,1,0},listener.changes.get(1));
+        assertEquals(3,radio.ackCount());assertTrue(transport.isHealthy());
+        // ACK1 is intentionally delivered as an intermediate result; owner tests must not complete it.
+    }
+    @Test public void unrelatedResponseIsAcknowledgedWithoutDecodingOpaquePayload() throws Exception {
+        register();send(true,1,p->{object(p,2,901,0);p.writeString("opaque-test-payload");});
+        drain();assertEquals(1,radio.ackCount());assertTrue(listener.queries.isEmpty());
+        assertTrue(listener.switches.isEmpty());assertTrue(transport.isHealthy());
+        // A known35/36 with an unreserved serial is rejected by the owner, not by this transport.
+    }
+    @Test public void malformedTupleAfterExpectedAckFailsHealthWithoutCrashingWorker() throws Exception {
+        register();
+        send(true,35,p->{object(p,2,91,0);p.writeInt(1);p.writeInt(12);p.writeInt(1);p.writeInt(1);});
+        unavailable();assertEquals(1,radio.ackCount());assertTrue(listener.queries.isEmpty());
+    }
+    @Test public void malformedHeaderDoesNotCauseSpeculativeAck() throws Exception {
+        register();send(true,35,p->{p.writeInt(1);p.writeInt(4);});
+        unavailable();assertEquals(0,radio.ackCount());
+    }
+    @Test public void listenerFailureInvalidatesTransportButWorkerSurvives() throws Exception {
+        register();listener.throwOnQuery=true;
+        send(true,35,p->{object(p,2,92,0);object(p,1,1,0);});
+        unavailable();assertEquals(1,radio.ackCount());
+    }
+
+    @Test public void expectedOpaqueIndicationIsAcknowledgedAfterLocalFailure() throws Exception {
+        register();listener.throwOnQuery=true;
+        send(true,35,p->{object(p,2,93,0);object(p,1,1,0);});
+        unavailable();assertEquals(1,radio.ackCount());assertEquals(1,listener.queryCalls);
+        send(false,1,p->{p.writeInt(1);p.writeString("opaque-after-failure");});
+        drain();assertEquals(2,radio.ackCount());assertEquals(1,listener.queryCalls);
+        assertTrue(listener.queries.isEmpty());assertTrue(listener.switches.isEmpty());
+        assertTrue(listener.changes.isEmpty());assertFalse(transport.isHealthy());
+        assertTrue(thread.isAlive());
+    }
+
+    private static final class RecordingListener implements MtkSimTypeTransport.Listener {
+        final List<int[]> queries=new ArrayList<>(), switches=new ArrayList<>(), changes=new ArrayList<>();
+        final CountDownLatch unavailable=new CountDownLatch(1);
+        boolean throwOnQuery;int queryCalls;
+        @Override public void queryResult(int t,int s,int e,int support,int mode,int reserved) {
+            queryCalls++;
+            if(throwOnQuery) throw new IllegalStateException("injected listener failure");
+            queries.add(new int[]{t,s,e,support,mode,reserved});
+        }
+        @Override public void switchResult(int t,int s,int e) {switches.add(new int[]{t,s,e});}
+        @Override public void simTypeChanged(int support,int mode,int reserved) {
+            changes.add(new int[]{support,mode,reserved});
+        }
+        @Override public void unavailable() {unavailable.countDown();}
+    }
+    private static final class Frame {
+        final int code;final int[] args;
+        Frame(int code,int...args) {this.code=code;this.args=args;}
+    }
+    private static final class FakeRadio extends Binder {
+        final List<Frame> frames=new CopyOnWriteArrayList<>();
+        int version=2;String hash=HASH;IBinder response,indication;
+        FakeRadio() {attachInterface(null,SIM);markVintfStability();}
+        List<Integer> codes() {
+            List<Integer> codes=new ArrayList<>();for(Frame f:frames) codes.add(f.code);return codes;
+        }
+        Frame last() {return frames.get(frames.size()-1);}
+        long ackCount() {return frames.stream().filter(f->f.code==36).count();}
+        @Override protected boolean onTransact(int code,Parcel data,Parcel reply,int flags)
+                throws RemoteException {
+            data.enforceInterface(SIM);
+            if(code==16777215 || code==16777214) {
+                assertEquals(0,flags);data.enforceNoDataAvail();frames.add(new Frame(code));
+                assertNotNull(reply);reply.writeNoException();
+                if(code==16777215) reply.writeInt(version);else reply.writeString(hash);
+                return true;
+            }
+            assertEquals(IBinder.FLAG_ONEWAY,flags);assertNull(reply);
+            switch(code) {
+                case 37:
+                    response=data.readStrongBinder();indication=data.readStrongBinder();
+                    assertNotNull(response);assertNotNull(indication);frames.add(new Frame(code));break;
+                case 40:frames.add(new Frame(code,data.readInt(),data.readInt()));break;
+                case 41:frames.add(new Frame(code,data.readInt(),data.readInt(),data.readInt()));break;
+                case 36:frames.add(new Frame(code));break;
+                default:throw new AssertionError("Unexpected local request "+code);
+            }
+            data.enforceNoDataAvail();return true;
+        }
+    }
+}
