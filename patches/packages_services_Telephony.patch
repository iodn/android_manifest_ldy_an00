+    private void attachDcRecovery() {
+        if (dcRecovery != null || dcInputs == null || dcBackend == null) return;
+        dcRecovery = new HonorImsDcController(
+                handler, SystemClock::elapsedRealtime, dcInputs, dcBackend);
+        completedListeners.add(result ->
+                dcRecovery.completed(result, isRecoveryQuiescent()));
