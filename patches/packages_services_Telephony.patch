+        check(!t.finalResponseConsumed());
+        t.response(1,77,1005,0,6,103);
+        check(t.state()==SepMuxTrial.State.UNKNOWN && !t.canRequestPhysicalReturn());
+        t.response(1,77,1005,0,0,104);check(!t.canRequestPhysicalReturn());
+        // Both accepted final forms work after endpoint, without changing endpoint state.
+        for(int type:new int[]{0,2}) {
+            t=start();q=t.queryStatus(101);t.status(q,true,true,true,1,true,102);
+            t.response(1,77,1005,type,0,103);
+            check(t.state()==SepMuxTrial.State.TARGET_OBSERVED && !t.canRequestPhysicalReturn());
+            check(t.finalResponseConsumed());
+            t.indication(1,1002,new int[]{1,0},104);
+            q=t.queryStatus(105);t.status(q,true,true,true,1,true,106);
+            check(t.canRequestPhysicalReturn());
+            t.response(1,77,1005,type,6,107);check(t.canRequestPhysicalReturn());
+            t.transportLost();check(t.state()==SepMuxTrial.State.UNKNOWN && !t.canRequestPhysicalReturn());
+        }
+        // Known first0/trailing6 also remains accepted when final precedes endpoint.
+        t=start();t.response(1,77,1005,0,0,101);q=t.queryStatus(102);
+        t.status(q,true,true,true,1,true,103);t.response(1,77,1005,2,6,104);
+        check(!t.canRequestPhysicalReturn());
+        t.indication(1,1002,new int[]{1,0},105);q=t.queryStatus(106);
+        t.status(q,true,true,true,1,true,107);check(t.canRequestPhysicalReturn());
+        // First-final failures, invalid type and expiry cannot be hidden by endpoint.
+        for(int type:new int[]{0,2,9}) {
+            t=start();q=t.queryStatus(101);t.status(q,true,true,true,1,true,102);
+            t.response(1,77,1005,type,6,103);
+            check(t.state()==SepMuxTrial.State.UNKNOWN && !t.canRequestPhysicalReturn());
+        }
+        t=start();q=t.queryStatus(101);t.status(q,true,true,true,1,true,102);
+        t.response(1,77,1005,0,0,360100);
+        check(t.state()==SepMuxTrial.State.UNKNOWN && !t.canRequestPhysicalReturn());
+        t=start();q=t.queryStatus(101);t.status(q,true,true,true,1,true,102);t.tick(360100);
+        check(t.state()==SepMuxTrial.State.UNKNOWN && !t.canRequestPhysicalReturn());
+        t=start();q=t.queryStatus(101);t.status(q,true,true,true,1,true,102);
+        t.response(0,77,1005,0,0,103);t.response(1,76,1005,0,0,104);
+        t.response(1,77,1006,0,0,105);check(!t.finalResponseConsumed() && !t.canRequestPhysicalReturn());
+        t.response(1,77,1005,0,0,106);check(!t.canRequestPhysicalReturn());
+        t.indication(1,1002,new int[]{1,0},107);q=t.queryStatus(108);
+        t.status(q,true,true,true,1,true,109);check(t.canRequestPhysicalReturn());
+        // Modern counterexample: early acceptance plus observed endpoint is not modem completion.
+        t=start();t.response(1,77,1005,0,0,101);q=t.queryStatus(102);
+        t.status(q,true,true,true,1,true,103);check(!t.canRequestPhysicalReturn());
+        t.tick(360100);check(t.state()==SepMuxTrial.State.UNKNOWN);
+        t.indication(1,1002,new int[]{1,0},360101);check(!t.canRequestPhysicalReturn());
+        // An explicit modem failure remains actionable after endpoint observation.
+        t=start();t.response(1,77,1005,0,0,101);q=t.queryStatus(102);
+        t.status(q,true,true,true,1,true,103);t.indication(1,1002,new int[]{3,2},104);
+        check(t.state()==SepMuxTrial.State.UNKNOWN && !t.canRequestPhysicalReturn());
+        // Query issuance, not callback arrival time, defines post-completion freshness.
+        t=start();t.response(1,77,1005,0,0,101);q=t.queryStatus(102);
+        t.indication(1,1002,new int[]{1,0},103);
+        t.status(q,true,true,true,1,true,104);check(!t.canRequestPhysicalReturn());
+        q2=t.queryStatus(105);t.indication(1,1002,new int[]{1,0},106);
+        t.status(q2,true,true,true,1,true,107);check(t.canRequestPhysicalReturn());
+        // Completion before early final still needs both final and a newly issued query.
+        t=start();t.indication(1,1002,new int[]{1,0},101);q=t.queryStatus(102);
+        t.status(q,true,true,true,1,true,103);check(!t.canRequestPhysicalReturn());
+        t.response(1,77,1005,2,0,104);check(t.canRequestPhysicalReturn());
+        // Exact modern pair only; a plausible different producer result is not correlated proof.
+        for(int[] pair:new int[][]{{9,0},{1,0,0},{3,2}}) {
+            t=start();t.indication(1,1002,pair,101);
+            check(t.state()==SepMuxTrial.State.UNKNOWN && !t.canRequestPhysicalReturn());
+        }
+        // Loss/expiry after successful completion but before readback never permits a second op.
+        t=start();t.response(1,77,1005,0,0,101);t.indication(1,1002,new int[]{1,0},102);
+        q=t.queryStatus(103);t.transportLost();t.status(q,true,true,true,1,true,104);
+        check(t.state()==SepMuxTrial.State.UNKNOWN && !t.canRequestPhysicalReturn());
+        t=start();t.response(1,77,1005,0,0,101);t.indication(1,1002,new int[]{1,0},102);
+        q=t.queryStatus(103);t.tick(360100);t.status(q,true,true,true,1,true,360101);
+        check(t.state()==SepMuxTrial.State.UNKNOWN && !t.canRequestPhysicalReturn());
+        System.out.println("PASS checks="+checks+"; production model only; no Binder/modem operations");
+    }
+}
