+        }
+    }
+    private void abandonExact(LpaOperationLease.Scope exact,IBinder client) {
+        try { leases(this).abandonIfOwned(exact,client); } catch(IOException ignored) { }
+    }
+    @Override public IBinder onBind(Intent intent) { return api; }
+    @Override public void onDestroy() {
+        lifetime.destroy();
+        synchronized(HonorLpaLeaseService.class) {
+            if(coordinator!=null) try { coordinator.serviceDestroyed(); } catch(IOException ignored) { }
+        }
+        super.onDestroy();
+    }
+}
