+    java.util.concurrent.CompletableFuture<BlankFacts> freshBlankStatus(LpaOperationLease.Scope scope,IBinder client) {
+        java.util.concurrent.CompletableFuture<BlankFacts> result=new java.util.concurrent.CompletableFuture<>();
