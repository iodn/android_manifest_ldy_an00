+  Method m=HonorEuiccEndpointPreparation.class.getDeclaredMethod("prepare",int.class,int.class,int.class,BooleanSupplier.class,Consumer.class);m.setAccessible(true);
+  m.invoke(null,card,port,uid,current,(Consumer<HonorEuiccEndpointPreparation.Result>)output::add);
+  Handler.runReady();
+ }
+ public static void main(String[]args)throws Exception {
+  reset();var owner=new KnownBlankOwnerAsyncHostTest.Fixture();install(owner.owner);
+  var results=new ArrayList<HonorEuiccEndpointPreparation.Result>();
+  prepare(7,0,10055,()->true,results);check(results.isEmpty());check(owner.transport.queries.size()==1);
+  owner.mode();owner.ci.reply(owner.ci.sent.get(0),IccCardStatus.CardState.CARDSTATE_ABSENT,null);
+  Handler.advance(100);owner.ci.reply(owner.ci.sent.get(1),IccCardStatus.CardState.CARDSTATE_PRESENT,null);
+  check(results.equals(List.of(HonorEuiccEndpointPreparation.Result.READY)));
+  check(owner.endpoints.fence.get()!=null);check(!owner.lease.isKnownBlank());
+  try{install(owner.owner);throw new AssertionError();}catch(IllegalStateException expected){checks++;}
+  reset();owner=new KnownBlankOwnerAsyncHostTest.Fixture();install(owner.owner);results=new ArrayList<>();
+  prepare(8,0,10055,()->true,results);
+  check(results.equals(List.of(HonorEuiccEndpointPreparation.Result.REFUSED)));check(owner.transport.queries.isEmpty());
+  for(int variant=0;variant<4;variant++){
+   reset();owner=new KnownBlankOwnerAsyncHostTest.Fixture();install(owner.owner);results=new ArrayList<>();
+   if(variant==2)owner.lease.ownerLost();if(variant==3)owner.lease.physicalRestored();
+   prepare(7,variant==0?1:0,variant==1?10056:10055,()->true,results);
+   check(results.equals(List.of(variant==3?HonorEuiccEndpointPreparation.Result.NO_HISTORY:HonorEuiccEndpointPreparation.Result.REFUSED)));
+   check(owner.transport.queries.isEmpty());
+  }
+  reset();owner=new KnownBlankOwnerAsyncHostTest.Fixture();install(owner.owner);results=new ArrayList<>();
+  final boolean[] current={true};prepare(7,0,10055,()->current[0],results);owner.mode();current[0]=false;
+  owner.ci.reply(owner.ci.sent.get(0),IccCardStatus.CardState.CARDSTATE_PRESENT,null);
+  check(results.equals(List.of(HonorEuiccEndpointPreparation.Result.REFUSED)));
+  check(owner.lease.isKnownBlank());check(owner.endpoints.fence.get()==null);
+  reset();owner=new KnownBlankOwnerAsyncHostTest.Fixture();install(owner.owner);results=new ArrayList<>();
+  prepare(7,0,10055,()->true,results);owner.mode();Handler.advance(10_001);
+  check(results.equals(List.of(HonorEuiccEndpointPreparation.Result.REFUSED)));check(owner.lease.restoringBlank());
+  owner.ci.reply(owner.ci.sent.get(0),IccCardStatus.CardState.CARDSTATE_PRESENT,null);
+  check(results.size()==1);check(!owner.lease.restoringBlank());check(owner.lease.isKnownBlank());
+  reset();owner=new KnownBlankOwnerAsyncHostTest.Fixture();SystemProperties.enabled=false;install(owner.owner);
+  results=new ArrayList<>();prepare(7,0,10055,()->true,results);
+  check(results.equals(List.of(HonorEuiccEndpointPreparation.Result.NO_HISTORY)));check(owner.transport.queries.isEmpty());
+  reset();android.os.Process.uid=2000;
+  try{HonorEuiccEndpointPreparation.install((a,b,c,d,e)->{});throw new AssertionError();}
