+    }
+    private android.os.Message channelCallback(LpaOperationLease.Scope scope,IBinder client,Channel channel,
+            java.util.concurrent.CompletableFuture<HonorLpaChannelResult> future) {
+        Handler receiver=new Handler(UiccController.getInstance().getLooper()) {
+            @Override public void handleMessage(android.os.Message message) {
+                if(future.isDone()) return; // The exact final callback has already been consumed.
+                HonorLpaChannelResult reply=new HonorLpaChannelResult();reply.handle=channel.id;
+                try {
+                    LpaOperationLease state=leases(HonorLpaLeaseService.this);
+                    synchronized(state) {
+                        requireBinding(scope,client);
+                        if(!(message.obj instanceof android.os.AsyncResult result) || result.userObj!=future
+                                || !(result.result instanceof HonorScopedApduChannel.Outcome outcome)
