+package com.android.internal.telephony.honor;
+import android.content.Context;
+import android.os.*;
+import java.io.IOException;
+import java.util.*;
+
+public final class HnCallHardwareOwnerHostTest {
+ static int checks;
+ static void check(boolean v,String m){checks++;if(!v)throw new AssertionError(m);}
+ static class Store implements SepMuxJournal.Store {
+  String value;boolean fail;
+  public String read(){return value;}
+  public void writeDurably(String s)throws IOException{if(fail)throw new IOException("I/O");value=s;}
+ }
+ static class Native implements IBinder {
+  IBinder callback;int registrations,requests,token,message;byte[] payload;
+  boolean alive=true,failSend;Runnable registerRace,sendRace;
+  final List<DeathRecipient> deaths=new ArrayList<>();
+  public boolean isBinderAlive(){return alive;}
+  public String getInterfaceDescriptor(){return HnCallEventTransport.SERVICE;}
+  public void linkToDeath(DeathRecipient r,int f){deaths.add(r);}
+  public boolean unlinkToDeath(DeathRecipient r,int f){return deaths.remove(r);}
+  public boolean transact(int c,Parcel p,Parcel out,int flags)throws RemoteException {
+   p.rewind();p.enforceInterface(HnCallEventTransport.SERVICE);
+   if(c==16777215){out.writeInt(1);return true;}
+   if(c==16777214){out.writeString(HnCallEventTransport.HASH);return true;}
+   if(c==2){registrations++;callback=(IBinder)p.snapshot().get(1);if(registerRace!=null)registerRace.run();out.writeNoException();return true;}
+   check(c==1&&flags==IBinder.FLAG_ONEWAY&&out==null,"Exact one-way request transaction");
+   token=p.readInt();check(token>0,"Explicit positive native token");
+   check(p.readInt()==1,"Non-null typed HnCallInfo");int start=p.dataPosition(),size=p.readInt();
+   message=p.readInt();check(p.readInt()==1,"Request outer version1");payload=p.createByteArray();
+   check(start+size==p.dataPosition(),"Stable parcelable size covers exact payload");p.enforceNoDataAvail();
+   requests++;if(sendRace!=null)sendRace.run();if(failSend)throw new RemoteException("Ambiguous wire");return true;
+  }
+  void emit(int msg,byte[] bytes)throws Exception {callback.transact(2,event(msg,bytes),null,1);}
+  void reply(int tok,int error,int msg,byte[] bytes)throws Exception {
+   Parcel p=Parcel.obtain();p.writeInterfaceToken(HnCallEventTransport.CALLBACK);p.writeInt(tok);p.writeInt(error);
+   envelope(p,msg,bytes);callback.transact(1,p,null,1);
+  }
+  void die(){alive=false;for(var d:List.copyOf(deaths))d.binderDied();}
+ }
+ static byte[] integer(int v){return new byte[]{(byte)v,(byte)(v>>8),(byte)(v>>16),(byte)(v>>24)};}
+ static void envelope(Parcel p,int msg,byte[] bytes){p.writeInt(1);p.writeInt(16+((bytes.length+3)&~3));p.writeInt(msg);p.writeInt(1);p.writeByteArray(bytes);}
+ static Parcel event(int msg,byte[] bytes){Parcel p=Parcel.obtain();p.writeInterfaceToken(HnCallEventTransport.CALLBACK);envelope(p,msg,bytes);return p;}
+ static class Events implements HnCallHardwareOwner.Listener {
