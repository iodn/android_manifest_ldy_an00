+    /** Reuses the existing sole native callback owner; null means unavailable, never bind another. */
+    static void requestHardwareOwner(java.util.function.Consumer<HnCallHardwareOwner> reply) {
+        UiccController.getInstance().post(() ->
+                reply.accept(instance == null ? null : instance.hardware));
+    }
+
+    /** UiccLooper issues immutable evidence; workers never read the mutable call cache. */
+    static void requestRecoveryAdmission(int slot, Handler replyHandler,
+            java.util.function.Consumer<RecoveryAdmission> reply) {
+        UiccController.getInstance().post(() -> {
+            RecoveryAdmission proof = instance == null
+                    ? new RecoveryAdmission(slot, 0, 0, 0, null, null, false)
+                    : instance.captureRecoveryAdmission(slot);
+            replyHandler.post(() -> reply.accept(proof));
+        });
+    }
+
+    private RecoveryAdmission captureRecoveryAdmission(int slot) {
+        if (slot < 0 || slot >= profiles.length) {
+            return new RecoveryAdmission(slot, 0, 0, 0, null, null, false);
+        }
+        Profile profile = profiles[slot];
+        HnCallHardwareOwner.Snapshot source = hardware.barrier(slot);
+        MtkAssistProfile[] identities = MtkAssistProfile.capture(phones, phones.length);
+        MtkAssistProfile tuple = slot < identities.length ? identities[slot] : null;
+        HonorSubscriberAdoption.Proof adoption =
+                tuple == null ? null : HonorSubscriberAdoption.proof(slot, tuple);
+        boolean qualified = profile != null && profile.qualified && source.ready()
+                && source.profileGeneration() == profile.generation
+                && identityMatches(profile, slot) && subscriberReady(slot)
+                && tuple != null && tuple.usable();
+        return new RecoveryAdmission(slot, source.bindingGeneration(),
+                source.profileGeneration(), profile == null ? 0 : profile.processedSequence,
+                tuple, adoption, qualified && adoption != null && isRecoveryQuiescent());
+    }
+
+    /** UiccLooper-only. Native workers use requestRecoveryAdmission plus atomic receipt recheck. */
+    static boolean isRecoveryQuiescent() {
+        if (instance == null || !instance.allIdle() || !instance.nativeQuiescent()) return false;
+        try {
+            HonorSimRouteCallGuard.requireIdle();
+            return true;
+        } catch (IllegalStateException busyOrUnknown) {
+            return false;
+        }
+    }
+
+    private static boolean idle(Phone phone) {
+        if (phone.getState() != PhoneConstants.State.IDLE) return false;
+        Phone ims = phone.getImsPhone();
+        return ims == null || ims.getState() == PhoneConstants.State.IDLE;
+    }
