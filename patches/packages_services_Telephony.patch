+        h.runOne(); // Current profile deadline; obsolete callback is queued after it.
+        check(b.votes.size()==2,"new profile owns independent deadline");
+        h.runOne();check(b.votes.size()==2,"stale registration cannot mutate successor");
+        i.current=false;c.environmentChanged();
+        check(i.closed==2,"changed adoption/binding retires round");
