+#!/usr/bin/env python3
+"""Actual app/Phone workflow regressions; never accesses a device or builds an APK.
+
+Requires source roots plus retained JDK/Kotlin tools. Native calls and Android dispatch
+are deterministic fixtures; production state machines and extracted method bodies run.
+An acceptance mismatch is reported as a failure, including on the original sources.
+"""
+import argparse, hashlib, json, os, pathlib, subprocess
+
+def method(text, signature):
+    start = text.index(signature)
+    end = text.index("{", start) + 1
+    depth = 1
+    while depth:
+        depth += (text[end] == "{") - (text[end] == "}")
+        end += 1
+    return text[start:end]
+
+def digest(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument("--phone-source", type=pathlib.Path,
+                    default=pathlib.Path(__file__).resolve().parents[2])
+    ap.add_argument("--app-source", required=True, type=pathlib.Path)
+    ap.add_argument("--jdk", required=True, type=pathlib.Path)
+    ap.add_argument("--kotlinc", required=True, type=pathlib.Path)
+    ap.add_argument("--output", required=True, type=pathlib.Path)
+    a = ap.parse_args()
+    out = a.output.resolve()
+    out.mkdir(parents=True, exist_ok=False)
+    fixtures = pathlib.Path(__file__).resolve().with_name("esim-cross-layer-fixtures")
+    phone = a.phone_source / "src/com/android/internal/telephony/honor"
+    app = a.app_source
+    owner = (phone / "HonorSepTrialOwner.java").read_text()
+    service = (phone / "HonorLpaLeaseService.java").read_text()
+    client_path = app / "app-common/src/main/java/im/angry/openeuicc/core/HonorLpaLeaseClient.kt"
+    client = client_path.read_text()
+    finish = service[service.index("        @Override public boolean finishRecovery("):
+                     service.index("        @Override public int protocolVersion()")]
+    start = client.index("                            withChannelAccess { net.typeblog.lpac_jni.ReadOnlyRecovery.read(apdu) }")
+    end = client.index("                            knownBlankForUi=false", start) + len("                            knownBlankForUi=false")
+    fragment = client[start:end]
+    # Sole native-transport seam: deterministic Calls instead of loading liblpac-jni.
+    fragment = fragment.replace("ReadOnlyRecovery.read(apdu)", "ReadOnlyRecovery.read(apdu,calls)")
+    replacements = {
+        "@@FINISH_RECOVERY@@": finish,
+        "@@REQUIRE_BINDING@@": method(service, "    private void requireBinding("),
+        "@@PHONE_LIFECYCLE@@": method(service, "    private static HonorLpaLifecycleTrace lifecycle("),
+        "@@OWNER_LIFECYCLE@@": method(owner, "    private static void lifecycle("),
+        "@@SCOPE_CONVERSION@@": method(service, "    private static LpaOperationLease.Scope scope("),
+        "@@ROUTE_REFUSAL@@": method(owner, "    public enum RouteRefusal"),
+        "@@PREPARATION_NOT_ADMITTED@@": method(owner, "    private static final class PreparationNotAdmitted"),
+        "@@KNOWN_PREPARATION_REFUSAL@@": method(owner, "    public static boolean knownPreparationRefusal("),
+        "@@APP_FINISH_FRAGMENT@@": fragment,
+        "@@KNOWN_NO_GRANT@@": method(client, "            if(knownNoGrant)"),
+        "@@BULK_RESET_METHOD@@": method((app / "app-common/src/main/java/im/angry/openeuicc/core/LocalProfileAssistantWrapper.kt").read_text(),
+                                      "    override fun euiccMemoryReset()"),
+        "@@REQUEST_ROUTE@@": method(owner, "    private void requestRoute("),
+        "@@CLOSE_READINESS@@": method(owner, "    private void closeReadiness("),
+        "@@PREPARE_ASYNC@@": method(owner, "    public static synchronized void prepareAsync(boolean"),
+    }
+    source_pins = []
+    java_names = ["EuiccReadiness", "LpaRecoveryRead", "LpaOperationLease", "LpaRecoveryFence",
+                  "SepMuxJournal", "SepMuxTrial", "SepMuxAdmission", "MtkSimTypeQuery",
+                  "SharedSlotRouteTrial", "RecoverySimPower", "SepMuxRouteAdoption",
+                  "PhysicalSimEvidence"]
+    route_names = [n for n in java_names if n != "LpaRecoveryRead"] + ["EndpointPublication"]
+    kotlin_names = ["ApduInterface", "ReadOnlyRecovery", "LpacJni", "HttpInterface",
+                    "ProfileDownloadCallback", "ProfileDownloadState", "RemoteProfileInfo", "ProfileClass"]
+    def copy(source, destination):
+        destination.parent.mkdir(parents=True, exist_ok=True)
+        destination.write_bytes(source.read_bytes())
+        source_pins.append({"path": str(source.resolve()), "sha256": digest(source)})
+    for group, names in [("recovery", java_names), ("route", route_names)]:
+        src = out / group / "src"
+        src.mkdir(parents=True)
+        for name in names:
+            copy(phone / (name + ".java"), src / (name + ".java"))
+        trace_source = a.phone_source / "honor-lpa-lease/src/com/honor/ldy_an00/lease/HonorLpaLifecycleTrace.java"
+        copy(trace_source, src / trace_source.name)
+        for template in (fixtures / group).iterdir():
+            text = template.read_text()
+            for key, value in replacements.items():
+                text = text.replace(key, value)
+            assert "@@" not in text, template
