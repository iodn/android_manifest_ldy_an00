+ public enum Action {IGNORE, ACK_ONLY, FINAL, FINAL_AND_ACK, INVALID}
+ private final java.util.Set<Integer> pending=new java.util.HashSet<>();
+ public void own(int serial){if(!pending.add(serial))throw new IllegalStateException("Duplicate serial");}
+ public Action response(int serial,int type){
+  if(!pending.contains(serial))return Action.IGNORE;
+  if(type==1)return Action.ACK_ONLY;
+  if(type!=0 && type!=2)return Action.INVALID;
+  pending.remove(serial);return type==2 ? Action.FINAL_AND_ACK : Action.FINAL;
+ }
+ public static boolean forwardLateFinal(int type){return type==0 || type==2;}
+ public static boolean indicationNeedsAck(int type){return type==1;}
+}
diff --git a/src/com/android/internal/telephony/honor/AtomicSepMuxStore.java b/src/com/android/internal/telephony/honor/AtomicSepMuxStore.java
new file mode 100644
index 0000000000000000000000000000000000000000..11876209402f1378948e2ae38572fe238a351361
--- /dev/null
+++ b/src/com/android/internal/telephony/honor/AtomicSepMuxStore.java
@@ -0,0 +1,97 @@
+/* Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0 */
+package com.android.internal.telephony.honor;
+
+import android.content.Context;
+import android.system.ErrnoException;
+import android.system.Os;
+import android.system.OsConstants;
+import android.util.AtomicFile;
+import java.io.File;
+import java.io.FileDescriptor;
+import java.io.FileOutputStream;
+import java.io.FileInputStream;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.util.Arrays;
+
+/** Phone app's private device-encrypted storage, not guest cache or a raw partition. */
+final class AtomicSepMuxStore implements SepMuxJournal.Store {
+    private final File directory,base;
+    private final AtomicFile file;
+    private int limit=128;
+    AtomicSepMuxStore(Context context) throws IOException {
+        this(context,"ldy-an00-sep-epoch");
+    }
+    static AtomicSepMuxStore forMtkSerials(Context context) throws IOException {
+        return new AtomicSepMuxStore(context,"ldy-an00-mtk-serials");
+    }
+    static AtomicSepMuxStore forLpaLease(Context context) throws IOException {
+        return new AtomicSepMuxStore(context,"ldy-an00-lpa-operation");
+    }
+    static AtomicSepMuxStore forLpaRecovery(Context context) throws IOException {
+        AtomicSepMuxStore result=new AtomicSepMuxStore(context,"ldy-an00-lpa-recovery");
+        result.limit=256;return result;
+    }
+    private AtomicSepMuxStore(Context context,String name) throws IOException {
+        Context de=context.createDeviceProtectedStorageContext();
+        directory=de.getNoBackupFilesDir();
+        if(directory==null || !directory.isDirectory()) throw new IOException("DE directory unavailable");
+        base=new File(directory,name);file=new AtomicFile(base);
+        // Persist Context-created directory publication too, before any dispatch.
+        syncDirectory(directory.getParentFile());syncDirectory(directory);
+    }
+    private void noInterruptedWrite() throws IOException {
+        for(String suffix:new String[]{".new",".bak"}) {
+            try {Os.lstat(base.getPath()+suffix);throw new IOException("Interrupted SEP journal publication");}
+            catch(ErrnoException e) {
+                if(e.errno!=OsConstants.ENOENT)throw new IOException(e);
+            }
+        }
+    }
+    @Override public String read() throws IOException {
+        noInterruptedWrite();
+        if(!base.exists()) {
+            // exists() alone conflates EACCES and ENOENT. lstat must confirm absence.
+            try {Os.lstat(base.getPath());throw new IOException("Unreadable SEP journal");}
+            catch(ErrnoException e) {
+                if(e.errno==OsConstants.ENOENT)return null;
+                throw new IOException(e);
+            }
+        }
+        byte[] value;
+        try(FileInputStream in=file.openRead()) {value=in.readNBytes(limit+1);}
+        if(value.length>limit)throw new IOException("Oversize SEP journal");
+        String text=new String(value,StandardCharsets.US_ASCII);
+        if(!Arrays.equals(value,text.getBytes(StandardCharsets.US_ASCII)))
+            throw new IOException("Non-ASCII SEP journal");
+        return text;
+    }
+    @Override public void writeDurably(String value) throws IOException {
+        noInterruptedWrite();
+        byte[] bytes=value.getBytes(StandardCharsets.US_ASCII);
+        FileOutputStream stream=null;
+        try {
+            stream=file.startWrite();stream.write(bytes);
+            // AtomicFile.finishWrite logs sync/rename failures; do not rely on its void result.
+            stream.getFD().sync();
+            file.finishWrite(stream);stream=null;
+            noInterruptedWrite();syncDirectory(directory);
+            if(!value.equals(read())) throw new IOException("SEP journal readback mismatch");
+        } catch(IOException | RuntimeException e) {
+            if(stream!=null)file.failWrite(stream);
+            throw new IOException("SEP journal durable publication failed",e);
+        }
+    }
+    private static void syncDirectory(File path) throws IOException {
+        FileDescriptor fd=null;
+        try {
+            fd=Os.open(path.getPath(),OsConstants.O_RDONLY|OsConstants.O_CLOEXEC,0);
+            if(!OsConstants.S_ISDIR(Os.fstat(fd).st_mode))throw new IOException("Not a directory");
+            Os.fsync(fd);
+        } catch(ErrnoException e) {throw new IOException(e);}
+        finally {
+            if(fd!=null)try {Os.close(fd);}catch(ErrnoException e) {throw new IOException(e);}
+        }
+    }
+}
diff --git a/src/com/android/internal/telephony/honor/EndpointPublication.java b/src/com/android/internal/telephony/honor/EndpointPublication.java
new file mode 100644
index 0000000000000000000000000000000000000000..0cfe6c020db9a305dfd183e40f50d0a7166dfb71
--- /dev/null
+++ b/src/com/android/internal/telephony/honor/EndpointPublication.java
@@ -0,0 +1,85 @@
+/* Copyright (C) 2026 The LineageOS Project. SPDX-License-Identifier: Apache-2.0 */
+package com.android.internal.telephony.honor;
+
+import java.util.concurrent.atomic.AtomicReference;
+
+/** One owner: linearizes admission, endpoint publication and observed transport loss. No RPC. */
+final class EndpointPublication {
+    static final class Ticket {
+        final EuiccReadiness.Epoch retired;
+        private Object adapter;
+        private long generation;
+        private int serial;
+        private int observationSerial=-1;
+        private boolean completed;
+        private Ticket(EuiccReadiness.Epoch retired) { this.retired=retired; }
+    }
+    final AtomicReference<EuiccReadiness.Epoch> fence=new AtomicReference<>();
+    private Ticket current;
+    private boolean lost;
+    synchronized Ticket admit() {
+        if (lost) throw new IllegalStateException("Owner lost; no retry");
+        // Caller invokes synchronously, BEFORE posting worker/journal/mux work.
+        current=new Ticket(fence.getAndSet(null));
+        return current;
+    }
+    /** Passive projection of admitted work, not merely the presence of a completed ticket. */
+    synchronized boolean completedCurrent() {
+        return !lost && current!=null && current.completed;
+    }
+    synchronized boolean hasPendingAdmission() {
+        return !lost && current!=null && !current.completed;
+    }
+    synchronized boolean isCurrent(Ticket ticket) { return !lost && ticket!=null && ticket==current; }
+    synchronized void bind(Ticket ticket, Object adapter, long generation, int serial) {
+        if (!isCurrent(ticket) || ticket.adapter!=null || adapter==null || generation<=0 || serial<=0)
+            throw new IllegalStateException("Stale/invalid endpoint admission");
+        ticket.adapter=adapter; ticket.generation=generation; ticket.serial=serial;
+    }
+    synchronized EuiccReadiness.Epoch completed(Ticket ticket, Object adapter,
+            long generation, int serial, SepMuxTrial.Selector target) {
+        if (!isCurrent(ticket) || ticket.completed || ticket.adapter!=adapter
+                || ticket.generation!=generation || ticket.serial!=serial || ticket.observationSerial!=-1) return null;
+        ticket.completed=true; // Once only, INCLUDING physical completion or later card retirement.
+        if (target!=SepMuxTrial.Selector.EUICC) return null;
+        EuiccReadiness.Epoch epoch=new EuiccReadiness.Epoch(generation,serial);
+        fence.set(epoch);
+        return epoch;
+    }
+    synchronized EuiccReadiness.Epoch observed(Ticket ticket,Object adapter,
+            SepMuxRouteAdoption.Proof proof) {
+        if(!isCurrent(ticket) || ticket.completed || ticket.adapter!=null || adapter==null
+                || proof==null || proof.lastSetterSerial!=0 || proof.observationSerial<=0
+                || proof.endpoint.kind!=EuiccReadiness.Epoch.Kind.CURRENT_READ
+                || proof.endpoint.observationSerial!=proof.observationSerial) return null;
+        ticket.adapter=adapter;ticket.generation=proof.generation;ticket.serial=0;
+        ticket.observationSerial=proof.observationSerial;ticket.completed=true;
+        fence.set(proof.endpoint);return proof.endpoint;
+    }
+    synchronized boolean physicalObserved(Ticket ticket,Object adapter,long generation,
+            MtkSimTypeQuery mode,PhysicalSimEvidence physical,int observationSerial,long now) {
+        if(!isCurrent(ticket) || ticket.completed || ticket.adapter!=null || adapter==null
+                || mode==null || mode.serial()!=observationSerial || !mode.current(generation,now)
+                || !mode.physicalFor(generation) || physical==null
+                || physical.generation!=generation || observationSerial<=0) return false;
+        ticket.adapter=adapter;ticket.generation=generation;ticket.serial=0;
+        ticket.observationSerial=observationSerial;ticket.completed=true;return true;
+    }
+    synchronized boolean rebind(EuiccReadiness.Epoch prior,EuiccReadiness.Epoch replacement) {
+        if(lost || current==null || !current.completed || prior==null || replacement==null
+                || current.generation!=prior.generation || current.serial!=prior.routeSerial
+                || current.observationSerial!=prior.observationSerial
+                || !replacement.sameRoute(prior)
+                || (fence.get()!=null && fence.get()!=prior)) return false;
+        fence.set(replacement);return true;
+    }
+    static boolean notifyKnown(Runnable callback) {
+        try { callback.run(); return true; }
+        catch (RuntimeException e) { return false; } // UI publication must not undo durable completion.
+    }
+    synchronized EuiccReadiness.Epoch retireUi() { return fence.getAndSet(null); }
+    synchronized EuiccReadiness.Epoch lose() {
+        lost=true; current=null;
+        return fence.getAndSet(null); // Before queued worker/observer cleanup.
+    }
+}
diff --git a/src/com/android/internal/telephony/honor/EuiccReadiness.java b/src/com/android/internal/telephony/honor/EuiccReadiness.java
new file mode 100644
index 0000000000000000000000000000000000000000..e8f78afabb20fd813c3367c0bee5aa27777eded3
--- /dev/null
+++ b/src/com/android/internal/telephony/honor/EuiccReadiness.java
@@ -0,0 +1,103 @@
+/* Copyright (C) 2026 The LineageOS Project. SPDX-License-Identifier: Apache-2.0 */
+package com.android.internal.telephony.honor;
+
+/** Pure predicate over actual observer facts; no UI, Binder, APDU or persistence. */
+final class EuiccReadiness {
+    // Identity is per confirmed known EUICC endpoint operation, NOT merely per owner generation.
+    // A new mux retires this token before dispatch; a later operation must publish a new instance.
+    static final class Epoch {
+        final long generation;
+        final int routeSerial;
+        // SET serial and observed GET serial are different namespaces. -1 means no read proof.
+        final int observationSerial;
+        enum Kind { UNQUALIFIED, SETTER, CURRENT_READ }
+        final Kind kind;
+        Epoch(long generation) { this(generation,0); }
+        Epoch(long generation,int routeSerial) { this(generation,routeSerial,-1); }
+        Epoch(long generation,int routeSerial,int observationSerial) {
+            if (generation <= 0 || routeSerial<0 || observationSerial< -1
+                    || routeSerial>0 && observationSerial!=-1
+                    || routeSerial==0 && observationSerial==0)
+                throw new IllegalArgumentException("Invalid epoch");
+            this.generation=generation;this.routeSerial=routeSerial;
+            this.observationSerial=observationSerial;
+            kind=routeSerial>0 ? Kind.SETTER : observationSerial>0 ? Kind.CURRENT_READ : Kind.UNQUALIFIED;
+        }
+        boolean qualifiedRoute() {return routeSerial>0 && observationSerial==-1
+                || routeSerial==0 && observationSerial>0;}
+        boolean sameRoute(Epoch other) {return other!=null && generation==other.generation
+                && routeSerial==other.routeSerial && observationSerial==other.observationSerial;}
+        Epoch replacement() {return new Epoch(generation,routeSerial,observationSerial);}
+    }
+    static final class Snapshot {
+        final Epoch epoch;
+        final long revision;
+        final Object slot, card, port;
+        final int physicalSlot, phone, portIndex, publicCardId, defaultCardId;
+        final boolean embedded, active, mapped, associated;
+        private final String eid;
+        Snapshot(Epoch epoch, long revision, Object slot, Object card, Object port,
+                int physicalSlot, int phone, int portIndex, int publicCardId, int defaultCardId,
+                boolean embedded, boolean active, boolean mapped, boolean associated, String eid) {
+            this.epoch=epoch; this.revision=revision; this.slot=slot; this.card=card; this.port=port;
+            this.physicalSlot=physicalSlot; this.phone=phone; this.portIndex=portIndex;
+            this.publicCardId=publicCardId; this.defaultCardId=defaultCardId;
+            this.embedded=embedded; this.active=active; this.mapped=mapped;
+            this.associated=associated; this.eid=eid;
+        }
+        boolean valid(Epoch expected) {
+            return epoch==expected && revision>=0 && slot!=null && card!=null && port!=null
+                    && physicalSlot==1 && phone==1 && portIndex>=0 && publicCardId>=0
+                    && publicCardId==defaultCardId && embedded && active && mapped
+                    && associated && validEid(eid);
+        }
+        boolean same(Snapshot other) {
+            return other!=null && epoch==other.epoch && revision==other.revision && slot==other.slot && card==other.card
+                    && port==other.port && physicalSlot==other.physicalSlot && phone==other.phone
+                    && portIndex==other.portIndex && publicCardId==other.publicCardId
+                    && defaultCardId==other.defaultCardId && embedded==other.embedded
+                    && active==other.active && mapped==other.mapped && associated==other.associated
+                    && java.util.Objects.equals(eid,other.eid);
+        }
+        String privateEidForReconciliation() {return eid;}
+        boolean matchesProvidedEid(String value) {return value==null || value.isEmpty() || java.util.Objects.equals(eid,value);}
+        boolean sameCardIdentity(Snapshot other) {
+            return other!=null && physicalSlot==other.physicalSlot && phone==other.phone
+                    && portIndex==other.portIndex && publicCardId==other.publicCardId
+                    && defaultCardId==other.defaultCardId && java.util.Objects.equals(eid,other.eid);
+        }
+        @Override public String toString() { return "Snapshot[identifiers omitted]"; }
+    }
+    static boolean eventBoundary(Runnable event, Runnable revoke) {
+        try { event.run(); return true; }
+        catch (RuntimeException e) { revoke.run(); return false; }
+    }
+    static boolean validEid(String eid) {
+        if (eid==null || eid.length()!=32) return false;
+        for (int i=0;i<eid.length();i++) if (eid.charAt(i)<'0' || eid.charAt(i)>'9') return false;
+        return true;
+    }
+    private final Epoch epoch;
+    private Snapshot ready;
+    EuiccReadiness(Epoch epoch) { this.epoch=java.util.Objects.requireNonNull(epoch); }
+    void invalidate() { ready=null; }
+    boolean retireIfCardChanged(java.util.concurrent.atomic.AtomicReference<Epoch> fence,
+            Object watchedCard, Object currentCard) {
+        if (watchedCard==null || watchedCard==currentCard) return false;
+        fence.compareAndSet(epoch,null); // Never clear a newer endpoint's token.
+        invalidate();
+        return true;
+    }
+    boolean observe(Snapshot first, Snapshot second) {
+        ready=first!=null && second!=null && first.valid(epoch) && second.valid(epoch)
+                && first.same(second) ? second : null;
+        return ready!=null;
+    }
+    boolean recheck(Snapshot first, Snapshot second) {
+        if (ready==null || first==null || second==null || !first.valid(epoch)
+                || !second.valid(epoch) || !ready.same(first) || !first.same(second)) {
+            invalidate(); return false;
+        }
+        return true;
+    }
+}
diff --git a/src/com/android/internal/telephony/honor/HonorEuiccReadinessObserver.java b/src/com/android/internal/telephony/honor/HonorEuiccReadinessObserver.java
new file mode 100644
index 0000000000000000000000000000000000000000..3769bc78d0840ff3b9a2ec1c435c3bdc45b8a4d9
--- /dev/null
+++ b/src/com/android/internal/telephony/honor/HonorEuiccReadinessObserver.java
@@ -0,0 +1,154 @@
+/* Copyright (C) 2026 The LineageOS Project. SPDX-License-Identifier: Apache-2.0 */
+package com.android.internal.telephony.honor;
+
+import android.os.AsyncResult;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.Message;
+import android.telephony.UiccCardInfo;
+import android.telephony.UiccPortInfo;
+import com.android.internal.telephony.uicc.UiccCard;
+import com.android.internal.telephony.uicc.UiccController;
+import com.android.internal.telephony.uicc.UiccPort;
+import com.android.internal.telephony.uicc.UiccSlot;
+import com.android.internal.telephony.uicc.euicc.EuiccCard;
+import com.android.internal.telephony.uicc.euicc.EuiccPort;
+import java.util.concurrent.atomic.AtomicReference;
+
+/** Unwired draft. Reads current framework objects; never requests EID/APDU or changes a card. */
+final class HonorEuiccReadinessObserver extends Handler {
+    private static final int ICC_CHANGED=1, EID_READY=2;
+    private static final int PHONE=1, SLOT=1;
+    private final UiccController controller;
+    // Future qualified owner clears BEFORE EVERY mux dispatch (before dispatch admission/journal),
+    // and immediately on owner/card loss. Publish a new token ONLY after known EUICC completion
+    // plus post-completion fresh status, with no unresolved operation; never reuse a token.
+    // This is endpoint eligibility, not EID readiness. Raw owner generation() is not this fence.
+    private final AtomicReference<EuiccReadiness.Epoch> endpointFence;
+    private EuiccReadiness.Epoch epoch;
+    private EuiccReadiness state;
+    private EuiccCard watchedCard;
+    private boolean running;
+    private long revision;
+
+    HonorEuiccReadinessObserver(UiccController controller,
+            AtomicReference<EuiccReadiness.Epoch> endpointFence) {
+        super(controller.getLooper());
+        this.controller=controller;
+        this.endpointFence=java.util.Objects.requireNonNull(endpointFence);
+    }
+    private void requireThread() {
+        if (Looper.myLooper()!=getLooper()) throw new IllegalStateException("Controller thread required");
+    }
+    void start() {
+        requireThread();
+        if (running) throw new IllegalStateException("Already observing");
+        epoch=java.util.Objects.requireNonNull(endpointFence.get());
+        state=new EuiccReadiness(epoch);
+        running=true;
+        controller.registerForIccChanged(this,ICC_CHANGED,null);
+        observe();
+    }
+    void close() {
+        requireThread();
+        running=false;
+        if (state!=null) state.invalidate();
+        controller.unregisterForIccChanged(this);
+        if (watchedCard!=null) watchedCard.unregisterForEidReady(this);
+        watchedCard=null;
+        removeCallbacksAndMessages(null);
+    }
+    // Coordinator also posts close() when retiring the endpoint token; every read checks the fence.
+    private void observe() {
+        if (!running) return;
+        if (endpointFence.get()!=epoch) { close(); return; }
+        UiccCard current=controller.getUiccCardForPhone(PHONE);
+        EuiccCard card=current instanceof EuiccCard ? (EuiccCard)current : null;
+        if (state.retireIfCardChanged(endpointFence,watchedCard,card)) { close(); return; }
+        if (card!=watchedCard) {
+            state.invalidate();
+            if (watchedCard!=null) watchedCard.unregisterForEidReady(this);
+            watchedCard=card;
+            if (card!=null) card.registerForEidReady(this,EID_READY,card);
+        }
+        state.observe(read(),read());
+        if (endpointFence.get()!=epoch) close();
+    }
+    @Override public void handleMessage(Message message) {
+        requireThread();
+        if (!running) return;
+        if (message.what==EID_READY && (!(message.obj instanceof AsyncResult ar)
+                || ar.userObj!=watchedCard)) return; // Old card notification is not evidence.
+        if (message.what==ICC_CHANGED || message.what==EID_READY) {
+            EuiccReadiness.eventBoundary(()->{
+                if (revision==Long.MAX_VALUE) { close(); return; }
+                revision++; // Local observation generation, not a modem/card hardware counter.
+                state.invalidate();
+                observe();
+            },()->{
+                endpointFence.compareAndSet(epoch,null);
+                state.invalidate();
+                try { close(); } catch(RuntimeException ignored) {
+                    // close() already clears running/readiness before local unregistration.
+                }
+            });
+        }
+    }
+    /** Immediate pre-handoff recheck only; this is NOT a lasting authorization or hardware lock. */
+    boolean recheckReady() {
+        requireThread();
+        if (!running || endpointFence.get()!=epoch) { close(); return false; }
+        boolean ready=state.recheck(read(),read());
+        if (endpointFence.get()!=epoch) { close(); return false; }
+        return ready;
+    }
+    boolean matchesLeaseTarget(int slot,int port,int cardId) {
+        if (!recheckReady()) return false;
+        EuiccReadiness.Snapshot snapshot=read();
+        return snapshot!=null && snapshot.valid(epoch) && snapshot.physicalSlot==slot
+                && snapshot.portIndex==port && snapshot.publicCardId==cardId;
+    }
+    EuiccReadiness.Snapshot leaseSnapshot() {
+        return recheckReady() ? read() : null;
+    }
+    private EuiccReadiness.Snapshot read() {
+        if (endpointFence.get()!=epoch || controller.getUiccCardForPhone(PHONE)!=watchedCard) return null;
+        EuiccReadiness.Snapshot snapshot=readCurrent(controller,epoch,revision);
+        return endpointFence.get()==epoch ? snapshot : null;
+    }
+    static EuiccReadiness.Snapshot readCurrent(UiccController controller,EuiccReadiness.Epoch epoch,long revision) {
+
+        int slotIndex=controller.getSlotIdFromPhoneId(PHONE);
+        UiccSlot slot=controller.getUiccSlotForPhone(PHONE);
+        UiccCard card=controller.getUiccCardForPhone(PHONE);
+        UiccPort port=controller.getUiccPortForPhone(PHONE);
+        if (slot==null || !(card instanceof EuiccCard euicc)
+                || !(port instanceof EuiccPort))
+            return null;
+        int portIndex=port.getPortIdx();
+        String eid=euicc.getEid(); // Pure current-value getter. NO EuiccPort.getEid request.
+        int cardId=controller.convertToPublicCardId(eid); // Existing association only, no addCardId.
+        boolean associated=false;
+        for (UiccCardInfo info:controller.getAllUiccCardInfos()) {
+            if (!info.isEuicc() || info.getPhysicalSlotIndex()!=SLOT
+                    || info.getCardId()!=cardId || !java.util.Objects.equals(eid,info.getEid())) continue;
+            for (UiccPortInfo pi:info.getPorts()) {
+                if (pi.getPortIndex()==portIndex && pi.getLogicalSlotIndex()==PHONE && pi.isActive())
+                    associated=true;
+            }
+        }
+        boolean mapped=slotIndex==SLOT && slot.getUiccCard()==card
+                && controller.getUiccCardForSlot(SLOT)==card
+                && port.getPhoneId()==PHONE && slot.getPhoneIdFromPortIndex(portIndex)==PHONE
+                && controller.getPhoneIdFromSlotPortIndex(SLOT,portIndex)==PHONE
+                && card.getUiccPort(portIndex)==port && card.getUiccPortForPhone(PHONE)==port
+                && controller.getUiccPortForSlot(SLOT,portIndex)==port;
+        // isEuicc is current ATR-derived classification (UiccSlot.parseAtr/checkIsEuiccSupported).
+        boolean embedded=slot.isEuicc();
+        boolean active=slot.isActive() && slot.isPortActive(portIndex);
+        associated=associated && java.util.Objects.equals(eid,card.getCardId());
+        int defaultId=controller.getCardIdForDefaultEuicc();
+        return new EuiccReadiness.Snapshot(epoch,revision,slot,card,port,slotIndex,PHONE,portIndex,
+                cardId,defaultId,embedded,active,mapped,associated,eid);
+        }
+}
diff --git a/src/com/android/internal/telephony/honor/HonorLpaLeaseService.java b/src/com/android/internal/telephony/honor/HonorLpaLeaseService.java
new file mode 100644
index 0000000000000000000000000000000000000000..70413aa19a7dd84c8206cc1a01ea1ff7ca264a3e
--- /dev/null
+++ b/src/com/android/internal/telephony/honor/HonorLpaLeaseService.java
@@ -0,0 +1,742 @@
+/* Copyright (C) 2026 The LineageOS Project. SPDX-License-Identifier: Apache-2.0 */
+package com.android.internal.telephony.honor;
+
+import android.app.Service;
+import android.content.Intent;
+import android.content.Context;
+import android.content.pm.ComponentInfo;
+import android.content.pm.PackageManager;
