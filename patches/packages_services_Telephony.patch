+                    updateRoute();
+                }
+            }
+            throw error;
+        }
+    }
+    private boolean fresh(Plan plan) {
+        try { return admission.fresh(plan); }
+        catch (IllegalStateException unavailable) { return false; }
+    }
+    @Override public synchronized boolean notEntered(int slot, int token) {
+        if (reservation == null || reservation.token != token || reservation.plan.slot() != slot)
+            return false;
+        if (reservation.entered || reservation.ticket != null) return false;
+        reservation = null;
+        return true; // Queued worker now cannot find the reservation and cannot dispatch.
+    }
+    @Override public synchronized void profileChanged(int slot, long generation,
+            boolean qualified) {
+        checkSlot(slot);
+        for (Plan plan : plans[slot])
+            if (plan != null && (!qualified
+                    || plan.nativeEpoch().profileGeneration() != generation))
+                plan.policy().retire();
+        if (reservation != null && reservation.plan.slot() == slot
+                && (!qualified
+                    || reservation.plan.nativeEpoch().profileGeneration() != generation))
+            reservation.plan.policy().retire();
+    }
+    @Override public void terminal(HnCallHardwareOwner.Result result) {
+        LpaOperationLease coordinator;
+        synchronized (this) { coordinator = lease; }
+        if (coordinator == null) return;
+        synchronized (coordinator) {
+            synchronized (this) {
+                Reservation request = reservation;
+                if (request == null || !request.entered || request.ticket == null
+                        || request.token != result.token()
+                        || request.plan.slot() != result.slot()
+                        || request.plan.message() != result.messageId()
+                        || request.plan.nativeEpoch().bindingGeneration() != result.bindingGeneration()
+                        || request.plan.nativeEpoch().profileGeneration() != result.profileGeneration())
+                    return;
+                HnCallPolicyJournal journal = journals[result.slot()][index(result.messageId())];
+                try {
+                    if (result.outcome() == HnCallHardwareOwner.Outcome.NATIVE_ACCEPTED
+                            && result.value() != null
+                            && result.value() == (request.plan.enabled() ? 1 : 0)) {
+                        journal.accepted(result.token(), request.plan.settleBaseline()
+                                && request.plan.policy().authorizesBaseline(request.plan.enabled()));
+                        accepted[result.slot()][index(result.messageId())] = result;
+                        reservation = null; updateRoute();
+                        coordinator.finishImsPolicyMutation(request.ticket);
+                        request.ticket = null;
+                    } else { journal.unknown(result.token()); updateRoute(); }
+                } catch (IOException failure) { failed[result.slot()] = true; updateRoute(); }
+            }
+        }
+    }
+    @Override public synchronized void unknown(HnCallHardwareOwner.Result result) {
+        Reservation request = reservation;
+        if (request == null || !request.entered || request.ticket == null
+                        || request.token != result.token() || request.plan.slot() != result.slot())
+            return;
+        if (!request.entered) return;
+        try { journals[result.slot()][index(result.messageId())].unknown(result.token()); }
+        catch (IOException failure) { failed[result.slot()] = true; }
+        updateRoute();
+    }
+    @Override public synchronized boolean uncertain(int slot) {
+        checkSlot(slot);
+        if (failed[slot]) return true;
+        for (HnCallPolicyJournal journal : journals[slot])
+            if (journal != null && journal.uncertain()) return true;
+        return false;
+    }
+    /** Exact process-local late-final evidence; never reconstructed from a clean/missing journal. */
+    synchronized HnCallHardwareOwner.Result lastAccepted(int slot,int message) {
+        checkSlot(slot);return accepted[slot][index(message)];
+    }
+    synchronized HnCallPolicyJournal.Entry owned(int slot, int message) {
+        HnCallPolicyJournal journal = journals[slot][index(message)];
+        return journal == null ? null : journal.entry();
+    }
+    private void updateRoute() {
+        boolean settled = true, safe = true;
+        for (int slot = 0; slot < 2; slot++) {
+            if (failed[slot]) {settled = false; safe = false;}
+            for (HnCallPolicyJournal journal : journals[slot]) {
+                if (journal != null && journal.owned()) settled = false;
+                if (journal != null && journal.uncertain()) safe = false;
+            }
+        }
+        dispatchSafe = safe;
+        routeSettled = settled;
+    }
+    private static String identity(Plan plan) {
+        try {
+            byte[] digest = MessageDigest.getInstance("SHA-256").digest(
+                    (plan.slot() + ":" + plan.subscriber().subscription + ":"
+                            + plan.subscriber().iccid).getBytes(StandardCharsets.UTF_8));
+            StringBuilder text = new StringBuilder();
+            for (byte value : digest) text.append(String.format("%02x", value & 255));
+            return text.toString();
+        } catch (NoSuchAlgorithmException impossible) { throw new AssertionError(impossible); }
+    }
+}
diff --git a/src/com/android/internal/telephony/honor/HnCallPolicyJournal.java b/src/com/android/internal/telephony/honor/HnCallPolicyJournal.java
new file mode 100644
index 0000000000000000000000000000000000000000..d224334040d3952a7bbf215cf889fcc654df0c92
--- /dev/null
+++ b/src/com/android/internal/telephony/honor/HnCallPolicyJournal.java
@@ -0,0 +1,96 @@
+/* Copyright (C) 2026 The LineageOS Project. SPDX-License-Identifier: Apache-2.0 */
+package com.android.internal.telephony.honor;
+
+import java.io.IOException;
+
+/** One feature's durable attempt and accepted logical intent, never CP-applied proof. */
+final class HnCallPolicyJournal {
+    enum Stage { CLEAN, ENTERED, ACCEPTED, UNKNOWN }
+    record Entry(int token, boolean enabled, boolean release, long binding, long profile,
+            long plan, String identity, int baseline, long deadline, Stage stage) {
+        Entry {
+            if (token <= 0 || binding <= 0 || profile <= 0 || plan <= 0
+                    || identity == null || !identity.matches("[0-9a-f]{64}")
+                    || baseline < 0 || baseline > 1 || deadline < 0 || stage == Stage.CLEAN)
+                throw new IllegalArgumentException("Invalid policy provenance");
+        }
+        Entry stage(Stage next) { return new Entry(token, enabled, release, binding, profile,
+                plan, identity, baseline, deadline, next); }
+    }
+    private final SepMuxJournal.Store store;
+    private final String prefix;
+    private Entry entry, prior;
+    private boolean failed;
+    HnCallPolicyJournal(SepMuxJournal.Store store, int slot, int message) throws IOException {
+        this.store = store;
+        prefix = prefix(slot, message);
+        String text = store.read();
+        if (text == null || !text.startsWith(prefix) || !text.endsWith("\n"))
+            throw new IOException("Missing or invalid policy history");
+        if (text.equals(prefix + "CLEAN\n")) return;
+        String[] fields = text.substring(prefix.length(), text.length() - 1).split(" ", -1);
+        if (fields.length != 10) throw new IOException("Invalid policy fields");
+        try {
+            for (int i : new int[]{0, 1, 2, 3, 4, 5, 7, 8})
+                if (!fields[i].matches("0|[1-9][0-9]*")) throw new IllegalArgumentException();
+            if (!fields[1].matches("[01]") || !fields[2].matches("[01]"))
+                throw new IllegalArgumentException();
+            entry = new Entry(Integer.parseInt(fields[0]), fields[1].equals("1"),
+                    fields[2].equals("1"), Long.parseLong(fields[3]), Long.parseLong(fields[4]),
+                    Long.parseLong(fields[5]), fields[6], Integer.parseInt(fields[7]),
+                    Long.parseLong(fields[8]), Stage.valueOf(fields[9]));
+        } catch (IllegalArgumentException bad) { throw new IOException("Invalid policy record", bad); }
+    }
+    private static String prefix(int slot, int message) {
+        if (slot < 0 || slot > 1 || (message != 2004 && message != 2005 && message != 2009))
+            throw new IllegalArgumentException("Policy channel");
+        return "HNPOL1 " + HnCallEventTransport.HASH + " " + slot + " " + message + " ";
+    }
+    static String cleanRecord(int slot, int message) { return prefix(slot, message) + "CLEAN\n"; }
+    Entry entry() { return entry; }
+    boolean uncertain() {
+        return failed || entry != null && entry.stage() != Stage.ACCEPTED;
+    }
+    boolean owned() { return entry != null; }
+    void enter(Entry proposed) throws IOException {
+        if (failed || uncertain() || proposed.stage() != Stage.ENTERED
+                || entry != null && (!entry.identity().equals(proposed.identity())
+                    || entry.baseline() != proposed.baseline()))
+            throw new IOException("Prior policy custody unresolved");
+        prior = entry;
+        publish(proposed);
+    }
+    /** Only a proven not-entered worker path can roll back reservation, never a transport error. */
+    void notSent(int token) throws IOException {
+        if (entry == null || entry.token() != token || entry.stage() != Stage.ENTERED)
+            throw new IOException("No exact unsent reservation");
+        publish(prior);
+        prior = null;
+    }
+    void accepted(int token) throws IOException { accepted(token, true); }
+    void accepted(int token, boolean settlementCurrent) throws IOException {
+        if (entry == null || entry.token() != token) throw new IOException("Wrong policy token");
+        // An exact old final proves native acceptance, not that its baseline is still authorized.
+        publish(entry.release() && settlementCurrent ? null : new Entry(entry.token(),
+                entry.enabled(), false, entry.binding(), entry.profile(), entry.plan(),
+                entry.identity(), entry.baseline(), entry.deadline(), Stage.ACCEPTED));
+        prior = null;
+    }
+    void unknown(int token) throws IOException {
+        if (entry == null || entry.token() != token) throw new IOException("Wrong policy token");
+        publish(entry.stage(Stage.UNKNOWN));
+        prior = null;
+    }
+    private void publish(Entry next) throws IOException {
+        failed = true; // Any publication failure denies subsequent dispatch in this VM.
+        entry = next;
+        String text = prefix + "CLEAN\n";
+        if (next != null) text = prefix + next.token() + " " + (next.enabled() ? 1 : 0) + " "
+                + (next.release() ? 1 : 0) + " " + next.binding() + " " + next.profile() + " "
+                + next.plan() + " " + next.identity() + " " + next.baseline() + " "
+                + next.deadline() + " " + next.stage() + "\n";
+        store.writeDurably(text);
+        if (!text.equals(store.read())) throw new IOException("Policy history readback");
+        failed = false;
+    }
+}
diff --git a/src/com/android/internal/telephony/honor/HnCallPolicyMigration.java b/src/com/android/internal/telephony/honor/HnCallPolicyMigration.java
new file mode 100644
index 0000000000000000000000000000000000000000..48f57c7e21b4c16a63c320900fd1ec7a97912462
--- /dev/null
+++ b/src/com/android/internal/telephony/honor/HnCallPolicyMigration.java
@@ -0,0 +1,48 @@
+/* Copyright (C) 2026 The LineageOS Project. SPDX-License-Identifier: Apache-2.0 */
+package com.android.internal.telephony.honor;
+
+import java.io.IOException;
+
+/** Explicit release/installer qualification; missing files are never an automatic clean bootstrap. */
+final class HnCallPolicyMigration {
+    static final String ROLE = "PRE_POLICY_DISABLED_V1";
+    private HnCallPolicyMigration() {}
+    static void qualify(int slot, SepMuxJournal.Store grant, SepMuxJournal.Store tokens,
+            SepMuxJournal.Store[] features) throws IOException {
+        if (slot < 0 || slot > 1 || features.length != 3) throw new IllegalArgumentException();
+        String prefix = "HNCALLMIG1 " + HnCallEventTransport.HASH + " " + ROLE + " " + slot + " ";
+        String value = grant.read();
+        if (value == null || !value.startsWith(prefix) || !value.endsWith("\n"))
+            throw new IOException("Explicit policy migration qualification missing");
+        String[] fields = value.substring(prefix.length(), value.length() - 1).split(" ", -1);
+        if (fields.length != 3 || !fields[0].matches("[0-9a-f]{32}")
+                || !fields[1].matches("[1-9][0-9]*"))
+            throw new IOException("Invalid migration qualification");
+        int floor;
+        try { floor = Integer.parseInt(fields[1]); }
+        catch (NumberFormatException bad) { throw new IOException("Migration token range", bad); }
+        if (floor == Integer.MAX_VALUE) throw new IOException("Migration token range");
+        if (fields[2].equals("USED")) {
+            if (tokens.read() == null) throw new IOException("Qualified token history missing");
+            for (SepMuxJournal.Store feature : features)
+                if (feature.read() == null) throw new IOException("Qualified policy history missing");
+            return;
+        }
+        if (!fields[2].equals("OPEN")) throw new IOException("Invalid migration phase");
+        for (SepMuxJournal.Store feature : features)
+            if (feature.read() != null) throw new IOException("Policy history cannot be overwritten");
+        // Preserve existing strict read-only-query token history; never reset a high-water.
+        String tokenHistory = tokens.read();
+        if (tokenHistory != null) new HnCallTokens(tokens, slot, false);
+        String used = prefix + fields[0] + " " + floor + " USED\n";
+        grant.writeDurably(used);
+        if (!used.equals(grant.read())) throw new IOException("Migration consumption readback");
+        if (tokenHistory == null)
+            tokens.writeDurably("HNCALLSEQ1 " + slot + " " + HnCallEventTransport.HASH + " " + floor + "\n");
+        for (int i = 0; i < features.length; i++)
+            features[i].writeDurably(HnCallPolicyJournal.cleanRecord(slot, new int[]{2004,2005,2009}[i]));
+        // A crash at any earlier publication leaves consumed qualification and missing history.
+        for (SepMuxJournal.Store feature : features)
+            if (feature.read() == null) throw new IOException("Incomplete migration");
+    }
+}
diff --git a/src/com/android/internal/telephony/honor/HnCallTokens.java b/src/com/android/internal/telephony/honor/HnCallTokens.java
new file mode 100644
index 0000000000000000000000000000000000000000..bd104218f3494373f342eb8ca315ef65c1e24784
--- /dev/null
+++ b/src/com/android/internal/telephony/honor/HnCallTokens.java
@@ -0,0 +1,38 @@
+/* Copyright (C) 2026 The LineageOS Project. SPDX-License-Identifier: Apache-2.0 */
+package com.android.internal.telephony.honor;
+
+import java.io.IOException;
+
+/** Strict, per-slot durable token high-water. Missing history never means first use. */
+final class HnCallTokens {
+    private final SepMuxJournal.Store store;
+    private final String prefix;
+    private int last;
+    private boolean failed;
+
+    HnCallTokens(SepMuxJournal.Store store, int slot, boolean qualifiedInitialHistory)
+            throws IOException {
+        if (slot < 0 || slot > 1) throw new IllegalArgumentException();
+        this.store = store;
+        prefix = "HNCALLSEQ1 " + slot + " " + HnCallEventTransport.HASH + " ";
+        String record = store.read();
+        if (record == null) {
+            if (!qualifiedInitialHistory) throw new IOException("Missing hncall token history");
+        } else {
+            if (!record.startsWith(prefix)
+                    || !record.substring(prefix.length()).matches("[1-9][0-9]*\\n"))
+                throw new IOException("Invalid hncall token provenance");
+            try { last = Integer.parseInt(record.substring(prefix.length(), record.length() - 1)); }
+            catch (NumberFormatException bad) { throw new IOException("Invalid token range", bad); }
+        }
+    }
+    synchronized int allocate() throws IOException {
+        if (failed || last == Integer.MAX_VALUE) throw new IOException("Token allocation unavailable");
+        int next = last + 1;
+        failed = true;
+        store.writeDurably(prefix + next + "\n");
+        last = next;
+        failed = false;
+        return next;
+    }
+}
