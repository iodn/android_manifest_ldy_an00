+        e=new Engine();e.config(0);e.policy.timer(max);e.policy.timer(HonorImsDefaultOpenPolicy.Timer.NO_CELLULAR);
+        check(e.votes.isEmpty(),"type0 inactive");
+    }
+    static class Inputs implements HonorImsDefaultOpenController.Inputs {
+        boolean current=true,enabled=true,lte=true,wifi=true;int closed;long now;
+        List<Consumer<HonorImsDefaultOpenController.Registration>> registrations=new ArrayList<>();
+        Memory memory=new Memory();
+        public HonorImsDefaultOpenController.Eligibility inspect(HonorCallQosController.QualifiedConfiguration c){return new HonorImsDefaultOpenController.Eligibility(current,enabled,lte,wifi,-60);}
+        public HonorImsDefaultOpenPolicy.Memory memory(HonorCallQosController.QualifiedConfiguration c){return memory;}
+        public AutoCloseable registrations(int sub,Consumer<HonorImsDefaultOpenController.Registration> c){registrations.add(c);return ()->closed++;}
+        Runnable changed;public AutoCloseable watch(Runnable r){changed=r;return ()->{};}
+        Boolean cellular;public Boolean cellularInService(int slot){return cellular;}
+        public long wallClockMillis(){return now++;}
+        public boolean temporaryFailure(HonorCompletedCallQoe.Result r){return true;}
+    }
+    static class Backend implements HonorImsDefaultOpenController.Backend {
+        List<HonorImsDefaultOpenController.Vote> votes=new ArrayList<>();int withdraw;
+        public void offer(HonorImsDefaultOpenController.Vote vote){votes.add(vote);}
