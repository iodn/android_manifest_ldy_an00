+    @Override public void event(HnCallHardwareOwner.ObservedEvent event) {
+        int slot = event.slot();
+        if (slot < 0 || slot >= 2) return;
+        Profile profile = profiles[slot];
+        HnCallHardwareOwner.Snapshot source = hardware.barrier(slot);
+        if (profile == null || event.bindingGeneration() != source.bindingGeneration()) return;
+        if (!identityMatches(profile, slot)) {
+            enqueue();
+            return;
+        }
+        bindingAdmission(profile, source);
+        // Queue-consumption proof only; an unqualified configuration is still never relabeled.
+        profile.processedSequence = Math.max(profile.processedSequence, event.sequence());
+        recoveryAdmissionChanged();
+        HonorMtkImsDefaultOpenDecoder.Report configuration =
+                HonorMtkImsDefaultOpenDecoder.decode(slot, event.version(),
+                        event.messageId(), event.payload());
+        if (event.messageId() == 2 && event.profileGeneration() == 0
+                && event.sequence() > profile.qualitySequence) {
+            profile.qualitySequence = event.sequence();
+            profile.quality = null;
+            return;
+        }
+        if (configuration != null && event.profileGeneration() == 0) {
+            profile.defaultOpen.unqualified(event.bindingGeneration(), event.sequence());
+            return;
+        }
+        bindingAdmission(profile, source);
+        if (!profile.qualified || !source.ready() || !subscriberReady(slot)
+                || event.profileGeneration() != profile.generation
+                || event.profileGeneration() != source.profileGeneration()) return;
+        profile.processedSequence = Math.max(profile.processedSequence, event.sequence());
+        if (configuration != null) {
+            profile.defaultOpen.qualify(event.bindingGeneration(), event.profileGeneration());
+            if (profile.defaultOpen.accept(event.bindingGeneration(), event.profileGeneration(),
+                    event.sequence(), configuration)) {
+                configurationAccepted(event, configuration);
+            }
+            return;
+        }
+        HonorMtkVoiceQualityDecoder.Quality quality = HonorMtkVoiceQualityDecoder.decode(
+                slot, event.version(), event.messageId(), event.payload());
+        if (quality != null) {
+            if (event.sequence() > profile.qualitySequence) {
+                profile.qualitySequence = event.sequence();
+                profile.quality = quality; // Observation only; regional recovery is not activated.
+            }
+            return;
+        }
+        Session session = sessions[slot];
+        if (session == null) {
+            session = new Session(slot, profile, nextEpoch++, source, null, this::completedCall);
+            sessions[slot] = session; // Successful-registration event may precede changed().
+        }
+        if (session.bindingGeneration != event.bindingGeneration()
+                || session.profileGeneration != event.profileGeneration()
+                || event.sequence() <= session.lastSequence || !current(session)) return;
+        session.lastSequence = event.sequence();
+        byte[] payload = event.payload();
+        HonorMtkCallEndDecoder.Report endCause = HonorMtkCallEndDecoder.decode(
+                slot, event.version(), event.messageId(), payload);
+        if (endCause != null) {
+            session.cache.accept(endCause, event.sequence());
+            return; // Existing terminal removal remains the only completion authority.
+        }
+        HonorMtkCallInfoDecoder.CallUpdate call = HonorMtkCallInfoDecoder.decode(
+                slot, event.version(), event.messageId(), payload);
+        HonorCompletedSipDecoder.Update functionalSip = call == null
+                ? HonorCompletedSipDecoder.decode(
+                        slot, event.version(), event.messageId(), payload) : null;
+        HonorMtkSipDecoder.SipUpdate sip =
+                functionalSip == null ? null : functionalSip.shared();
