new file mode 100644
index 0000000000000000000000000000000000000000..a39ea0ffe853aff70788d861781c791d6a2d877f
--- /dev/null
+++ b/src/com/android/internal/telephony/honor/LpaRecoveryRead.java
@@ -0,0 +1,54 @@
+/* Copyright (C) 2026 The LineageOS Project. SPDX-License-Identifier: Apache-2.0 */
+package com.android.internal.telephony.honor;
+
+/** Two fixed reads on one new channel. GET RESPONSE is authorized only by the preceding SW1=61. */
+final class LpaRecoveryRead {
+    private int stage,more=-1;
+    private boolean pending;
+    private final java.io.ByteArrayOutputStream bytes=new java.io.ByteArrayOutputStream();
+    private final String eid;
+    LpaRecoveryRead(String eid) {this.eid=eid;}
+    void request(byte[] command,int channel) {
+        if(pending || stage>=2 || command==null || channel<=0 || channel>19)
+            throw new IllegalStateException("No recovery read");
+        int cla=0x80|(channel&15);
+        byte[] expected=more>=0 ? new byte[]{(byte)cla,(byte)0xc0,0,0,(byte)more}
+                : stage==0 ? new byte[]{(byte)cla,(byte)0xe2,(byte)0x91,0,6,(byte)0xbf,0x3e,3,0x5c,1,0x5a}
+                : new byte[]{(byte)cla,(byte)0xe2,(byte)0x91,0,3,(byte)0xbf,0x2d,0};
+        if(!java.util.Arrays.equals(command,expected)) throw new IllegalArgumentException("Recovery permits only EID/profile reads");
+        pending=true;more=-1;
+    }
+    void response(byte[] data) {
+        if(!pending || data==null || data.length<2 || bytes.size()+data.length>65536)
+            throw new IllegalStateException("Unknown recovery response");
+        pending=false;bytes.write(data,0,data.length-2);
+        int sw1=data[data.length-2]&255,sw2=data[data.length-1]&255;
+        if(sw1==0x61) {more=sw2;return;}
+        if(!(sw1==0x90 && sw2==0 || sw1==0x91 || sw1==0x92))
+            throw new IllegalStateException("Card read rejected");
+        byte[] body=bytes.toByteArray();
+        int[] outer=tlv(body,0,stage==0 ? 0xbf3e : 0xbf2d);
+        if(outer[1]!=body.length) throw new IllegalArgumentException("Trailing read data");
+        int[] inner=tlv(body,outer[0],stage==0 ? 0x5a : 0xa0);
+        if(inner[1]!=outer[1]) throw new IllegalArgumentException("Unexpected read response");
+        if(stage==0 && (inner[1]-inner[0]!=16
+                || !java.util.HexFormat.of().formatHex(java.util.Arrays.copyOfRange(body,inner[0],inner[1])).equals(eid)))
+            throw new IllegalArgumentException("Live card identity mismatch");
+        bytes.reset();stage++;
+    }
+    private static int[] tlv(byte[] data,int offset,int tag) {
+        int count=tag>255 ? 2 : 1;
+        if(offset+count>=data.length) throw new IllegalArgumentException("Short DER");
+        for(int i=count-1;i>=0;i--) if((data[offset++]&255)!=((tag>>(8*i))&255))
+            throw new IllegalArgumentException("Wrong DER tag");
+        int length=data[offset++]&255;
+        if((length&128)!=0) {
+            int n=length&127;
+            if(n<1 || n>2 || offset+n>data.length) throw new IllegalArgumentException("Invalid DER length");
+            length=0;while(n-->0) length=(length<<8)|(data[offset++]&255);
+        }
+        if(length>data.length-offset) throw new IllegalArgumentException("Truncated DER");
+        return new int[]{offset,offset+length};
+    }
+    boolean complete() {return stage==2 && !pending && more<0;}
+}
diff --git a/src/com/android/internal/telephony/honor/MtkAssistProfile.java b/src/com/android/internal/telephony/honor/MtkAssistProfile.java
new file mode 100644
index 0000000000000000000000000000000000000000..6c191d43f143d3defdbe631b6649428f3696ccfe
--- /dev/null
+++ b/src/com/android/internal/telephony/honor/MtkAssistProfile.java
@@ -0,0 +1,63 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.internal.telephony.honor;
+
+import com.android.internal.telephony.Phone;
+import com.android.internal.telephony.uicc.IccRecords;
+import com.android.internal.telephony.uicc.UiccController;
+import com.android.internal.telephony.uicc.UiccProfile;
+import android.telephony.SubscriptionManager;
+import java.util.Arrays;
+import java.util.Objects;
+
+/** Subscriber-sensitive identity, separate from the EID/port used for card management. */
+final class MtkAssistProfile {
+    final int subscription;
+    final Object card, port;
+    final UiccProfile profile;
+    final IccRecords phoneRecords, profileRecords;
+    final String iccid;
+    final long epoch;
+    final boolean loaded;
+    private MtkAssistProfile(Phone phone,int slot) {
+        UiccController controller=UiccController.getInstance();
+        subscription=phone.getSubId();
+        card=controller.getUiccCardForPhone(slot);
+        port=controller.getUiccPortForPhone(slot);
+        profile=controller.getUiccProfileForPhone(slot);
+        phoneRecords=phone.getIccRecords();
+        profileRecords=profile==null ? null : profile.getIccRecords();
+        iccid=phone.getFullIccSerialNumber();
+        loaded=phoneRecords!=null && phoneRecords==profileRecords && phoneRecords.getRecordsLoaded();
+        epoch=HonorRadioCommBroker.generation(slot);
+    }
+    /** Visible consistency only; the shared post-mutation adoption fence is a separate requirement. */
+    boolean usable() {
+        return epoch>0 && SubscriptionManager.isValidSubscriptionId(subscription)
+                && card!=null && port!=null && profile!=null && loaded
+                && iccid!=null && !iccid.isEmpty();
+    }
+    static MtkAssistProfile[] capture(Phone[] phones,int count) {
+        if(phones==null || count<0 || count>2 || count>phones.length)return new MtkAssistProfile[0];
+        MtkAssistProfile[] result=new MtkAssistProfile[count];
+        for(int i=0;i<count;i++) {
+            if(phones[i]==null)return new MtkAssistProfile[0];
+            result[i]=new MtkAssistProfile(phones[i],i);
+        }
+        return result;
+    }
+    static boolean current(MtkAssistProfile[] expected,Phone[] phones,int count) {
+        return expected.length==count && Arrays.equals(expected,capture(phones,count));
+    }
+    @Override public boolean equals(Object value) {
+        if(!(value instanceof MtkAssistProfile other))return false;
+        return subscription==other.subscription && card==other.card && port==other.port
+                && profile==other.profile && phoneRecords==other.phoneRecords
+                && profileRecords==other.profileRecords && loaded==other.loaded
+                && epoch==other.epoch && Objects.equals(iccid,other.iccid);
+    }
+    @Override public int hashCode(){return Objects.hash(subscription,iccid,epoch);}
+    @Override public String toString(){return "MtkAssistProfile[identifiers omitted]";}
+}
diff --git a/src/com/android/internal/telephony/honor/MtkAssistSyncState.java b/src/com/android/internal/telephony/honor/MtkAssistSyncState.java
new file mode 100644
index 0000000000000000000000000000000000000000..0eda712227c90d48442087ce415b22b393480a47
--- /dev/null
+++ b/src/com/android/internal/telephony/honor/MtkAssistSyncState.java
@@ -0,0 +1,135 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.internal.telephony.honor;
+
+import java.util.Arrays;
+import java.util.EnumMap;
+
+/** Latest-only state notifications. A radio response acknowledges a request, not modem application. */
+final class MtkAssistSyncState {
+    enum Kind { DATA, DEFAULT_DATA, SCREEN, VOIP }
+    record Notification(int slot, Kind kind, int[] values, long topology, long binding) {
+        Notification { values = values.clone(); }
+        @Override public int[] values() { return values.clone(); }
+    }
+    private static final class Slot {
+        long binding;
+        final EnumMap<Kind, int[]> desired = new EnumMap<>(Kind.class);
+        final EnumMap<Kind, int[]> acknowledged = new EnumMap<>(Kind.class);
+        final EnumMap<Kind, int[]> failed = new EnumMap<>(Kind.class);
+        Notification pending;
+        int serial;
+    }
+    private final Slot[] slots = {new Slot(), new Slot()};
+    private int[] subscriptions = new int[0];
+    private Object[] cards = new Object[0];
+    private long topology;
+
+    void topology(int[] subscriptions, Object[] cards) {
+        if (subscriptions.length != cards.length || subscriptions.length > 2)
+            throw new IllegalArgumentException("Invalid phone topology");
+        if (Arrays.equals(this.subscriptions, subscriptions)
+                && Arrays.equals(this.cards, cards)) return;
+        this.subscriptions = subscriptions.clone();
+        this.cards = cards.clone();
+        invalidate();
+        for (Slot slot : slots) slot.desired.clear();
+    }
+    void invalidate() {
+        topology++;
+        for (Slot slot : slots) {
+            slot.pending = null;
+            slot.acknowledged.clear();
+            slot.failed.clear();
+        }
+    }
+    void binding(int phone, long generation) {
+        Slot slot = slot(phone);
+        if (generation == slot.binding) return;
+        slot.binding = generation;
+        slot.pending = null;
+        slot.acknowledged.clear();
+        slot.failed.clear();
+    }
+    void radioAvailable(int phone) {
+        Slot slot = slot(phone);
+        slot.pending = null;
+        slot.acknowledged.clear();
+        slot.failed.clear();
+    }
+    void data(int phone, boolean enabled, boolean roaming) {
+        offer(phone, Kind.DATA, enabled ? 1 : 0, roaming ? 1 : 0, -2, -2, -2);
+    }
+    void defaultData(int phone) { offer(0, Kind.DEFAULT_DATA, -2, -2, phone, -2, -2); }
+    void clearDefaultData() { slots[0].desired.remove(Kind.DEFAULT_DATA); }
+    void screen(int phone, boolean on) { offer(phone, Kind.SCREEN, on ? 1 : 0); }
+    private void offer(int phone, Kind kind, int... values) {
+        slot(phone).desired.put(kind, values);
+    }
+    Notification next(int phone, boolean routeQuiescent) {
+        return next(phone, routeQuiescent, true, true);
+    }
+    Notification next(int phone, boolean routeQuiescent, boolean dataReady,
+            boolean defaultDataReady) {
+        Slot slot = slot(phone);
+        if (!routeQuiescent || phone >= subscriptions.length || slot.binding == 0
+                || slot.pending != null) return null;
+        for (Kind kind : Kind.values()) {
+            if ((kind == Kind.DATA && !dataReady)
+                    || (kind == Kind.DEFAULT_DATA && !defaultDataReady)) continue;
+            int[] value = slot.desired.get(kind);
+            if (value != null && !Arrays.equals(value, slot.acknowledged.get(kind))
+                    && !Arrays.equals(value, slot.failed.get(kind))) {
+                return new Notification(phone, kind, value, topology, slot.binding);
+            }
+        }
+        return null;
+    }
+    boolean begin(Notification request, int serial) {
+        Slot slot = slot(request.slot());
+        if (serial <= 0 || slot.pending != null || request.topology() != topology
+                || request.binding() != slot.binding
+                || !Arrays.equals(request.values(), slot.desired.get(request.kind()))) return false;
+        slot.pending = request;
+        slot.serial = serial;
+        return true;
+    }
+    int pendingDefaultDataPhone(int phone, long binding, int serial) {
+        Slot slot = slot(phone);
+        Notification request = slot.pending;
+        return request != null && request.binding() == binding && slot.serial == serial
+                && request.kind() == Kind.DEFAULT_DATA ? request.values()[2] : -1;
+    }
+    boolean response(int phone, long binding, Kind method, int serial, int type, int error) {
+        return response(phone, binding, method, serial, type, error, true, true);
+    }
+    boolean response(int phone, long binding, Kind method, int serial, int type, int error,
+            boolean dataReady, boolean defaultDataReady) {
+        Slot slot = slot(phone);
+        Notification request = slot.pending;
+        if (request == null || slot.serial != serial || slot.binding != binding
+                || request.binding() != binding || request.topology() != topology
+                || (request.kind() == Kind.DEFAULT_DATA ? Kind.DATA : request.kind()) != method
+                || (type != 0 && type != 1 && type != 2)) return false;
+        if (type == 1) return false; // Solicited ACK is intermediate.
+        slot.pending = null;
+        if ((request.kind() == Kind.DATA && !dataReady)
+                || (request.kind() == Kind.DEFAULT_DATA && !defaultDataReady)) return true;
+        if (error == 0) slot.acknowledged.put(request.kind(), request.values());
+        else slot.failed.put(request.kind(), request.values());
+        return true;
+    }
+    boolean timeout(int phone, long binding, int serial) {
+        Slot slot = slot(phone);
+        if (slot.pending == null || slot.binding != binding || slot.serial != serial) return false;
+        slot.failed.put(slot.pending.kind(), slot.pending.values());
+        slot.pending = null;
+        return true;
+    }
+    private Slot slot(int phone) {
+        if (phone < 0 || phone >= slots.length) throw new IllegalArgumentException("Invalid phone");
+        return slots[phone];
+    }
+}
