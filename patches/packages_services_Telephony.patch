+    private void configurationAccepted(HnCallHardwareOwner.ObservedEvent event,
+            HonorMtkImsDefaultOpenDecoder.Report report) {
+        MtkAssistProfile[] identities = MtkAssistProfile.capture(phones, phones.length);
+        int slot = event.slot();
+        if (slot >= identities.length || !identities[slot].usable()) return;
+        QualifiedConfiguration observation = new QualifiedConfiguration(slot,
+                event.bindingGeneration(), event.profileGeneration(), event.sequence(), report,
+                identities[slot]);
+        handler.post(() -> {
+            Profile profile = profiles[slot];
+            HnCallHardwareOwner.Snapshot source = hardware.barrier(slot);
+            MtkAssistProfile[] current = MtkAssistProfile.capture(phones, phones.length);
+            if (profile == null || !profile.qualified || !source.ready()
+                    || !subscriberReady(slot) || !identityMatches(profile, slot)
+                    || profile.generation != observation.profileGeneration()
+                    || source.profileGeneration() != observation.profileGeneration()
+                    || source.bindingGeneration() != observation.bindingGeneration()
+                    || profile.defaultOpen.report() != observation.report() || slot >= current.length
+                    || !observation.profileTuple().equals(current[slot])) return;
+            for (var listener : java.util.List.copyOf(configurationListeners)) {
+                listener.accept(observation);
+            }
+        });
+    }
