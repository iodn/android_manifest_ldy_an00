+        check(e.timers.timers.get(max)==600000L,"XML t1 milliseconds");
+        e.policy.registrationFailed(lte,500);
+        check(e.timers.timers.get(retry)==400000L,"XML t2 milliseconds");
+        e.policy.registrationFailed(lte,500);
