+    private final java.util.Set<java.util.concurrent.CompletableFuture<?>> blankReads=new java.util.HashSet<>();
+    private static final class BlankQuery {
+        final LpaOperationLease.Scope scope;final IBinder client;
+        final java.util.concurrent.CompletableFuture<BlankFacts> result;
+        BlankQuery(LpaOperationLease.Scope scope,IBinder client,java.util.concurrent.CompletableFuture<BlankFacts> result) {
