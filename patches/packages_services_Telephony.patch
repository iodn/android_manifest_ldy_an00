+/** Authenticated operation leases and explicit nondestructive recovery; no profile-operation replay. */
+public final class HonorLpaLeaseService extends Service {
+    private static final String PERMISSION="com.android.phone.permission.HONOR_LDY_AN00_LPA_LEASE";
+    // Image-bound controlled trial only; hardware behavior remains unproven.
