index 0000000000000000000000000000000000000000..7b1ba4b467784a7d626f23120bf2b49b31a8823f
--- /dev/null
+++ b/src/com/android/phone/LdyAn00EsimTrialActivity.java
@@ -0,0 +1,131 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.phone;
+import android.app.*;
+import android.os.*;
+import android.os.Process;
+import android.widget.*;
+import com.android.internal.telephony.honor.HonorSepTrialOwner;
+import com.android.internal.telephony.honor.HonorMtkSimTypeProbeOwner;
+
+/** Explicit development-only entry; no operation occurs merely by opening it. */
+public final class LdyAn00EsimTrialActivity extends Activity {
+    private HonorSepTrialOwner owner;
+    private TextView output;
+    private TextView probeOutput;
+    private Button probeButton;
+    private final Handler probeUi=new Handler(Looper.getMainLooper());
+    private int probeDisplayReads;
+    @Override public void onCreate(Bundle state) {
+        super.onCreate(state);
+        if(!"LDY-AN00".equals(Build.MODEL) || !"ldy_an00".equals(Build.DEVICE)
+                || !"userdebug".equals(Build.TYPE) || Process.myUid()!=1001
+                || !"com.android.phone".equals(Application.getProcessName())
+                || !(getApplication() instanceof PhoneApp)) {finish();return;}
+        owner=HonorSepTrialOwner.existingPreparedOwner();
+        LinearLayout layout=new LinearLayout(this);layout.setOrientation(LinearLayout.VERTICAL);
+        output=new TextView(this);
+        output.setText("LDY-AN00 eSIM development trial\nPhysical SIM2 and eSIM share one hardware path. Switching temporarily replaces physical SIM2 and can interrupt mobile service.\nNo profiles will be downloaded/enabled. Owner preparation installs one Honor callback pair; opening this screen does nothing.\nUNKNOWN stops; do not repeat. Endpoint observation does not prove command completion or recovery safety.");
+        output.append("\nOwner: "+HonorSepTrialOwner.existingOwnerState());
+        layout.addView(output);
+        probeOutput=new TextView(this);
+        probeOutput.setAccessibilityLiveRegion(android.view.View.ACCESSIBILITY_LIVE_REGION_POLITE);
+        layout.addView(probeOutput);
+        probeButton=new Button(this);probeButton.setText("Check eSIM support (keeps SIMs selected)");
+        probeButton.setEnabled(HonorMtkSimTypeProbeOwner.preparation()
+                ==HonorMtkSimTypeProbeOwner.Preparation.NOT_ATTEMPTED);
+        probeButton.setOnClickListener(v->new AlertDialog.Builder(this).setMessage(
+            "Run the approved eSIM compatibility check? Continue only in the reviewed fresh-boot trial. This checks support and the selected SIM path without switching SIMs or installing a profile.")
+            .setPositiveButton("Check",(d,w)->startMtkProbe())
+            .setNegativeButton("Cancel",null).show());
+        layout.addView(probeButton);
+        showMtkProbe();
+        Button prepare=new Button(this);prepare.setText("Prepare Honor callback owner");
+        prepare.setOnClickListener(v->new AlertDialog.Builder(this).setMessage(
+            "Install the single development Honor callback owner? This replaces any existing Honor pair; source/image ownership must already be reviewed.")
+            .setPositiveButton("Prepare",(d,w)->{try {HonorSepTrialOwner.prepareAsync(o->{owner=o;show();},error->output.append("\n"+error));}
+                catch(Exception e){output.append("\nSTOP: "+e.getClass().getSimpleName()+": "+e.getMessage());}})
+            .setNegativeButton("Cancel",null).show());
+        layout.addView(prepare);
+        Button trial=new Button(this);trial.setText("Try eSIM visibility once (replaces SIM2)");
+        trial.setOnClickListener(v->confirmRoute(false));
+        layout.addView(trial);
+        Button physical=new Button(this);physical.setText("Return physical SIM2 once (explicit)");
+        physical.setOnClickListener(v->confirmRoute(true));
+        layout.addView(physical);
+        Button refresh=new Button(this);refresh.setText("Show existing diagnostic events");
+        refresh.setOnClickListener(v->show());layout.addView(refresh);
+        ScrollView scroll=new ScrollView(this);scroll.addView(layout);setContentView(scroll);
+        com.android.phone.settings.SettingsConstants.setupEdgeToEdge(this);
+    }
+    private void confirmRoute(boolean physical) {
+        if(owner==null) {output.append("\nPrepare first");return;}
+        HonorSepTrialOwner expected=owner;
+        expected.requestUiSnapshot(snapshot->{
+            if(isFinishing() || isDestroyed() || owner!=expected)return;
+            new AlertDialog.Builder(this).setMessage(physical
+                    ? "Return the shared path to physical SIM2? UNKNOWN refuses; no automatic recovery."
+                    : "Switch physical SIM2 to eSIM? Mobile service may stop; no automatic retry.")
+                .setPositiveButton("Switch",(d,w)->{
+                    if(owner!=expected)return;
+                    if(physical) expected.requestPhysicalSim2Once(snapshot.phaseSerial);
+                    else expected.requestEuiccVisibilityOnce(snapshot.phaseSerial);
+                    show();
+                }).setNegativeButton("Cancel",null).show();
+        });
+    }
+    private void startMtkProbe() {
+        probeButton.setEnabled(false);probeStatus("Preparing eSIM support check…");
+        try {
+            // External controlled-trial review qualifies the first-use history before launch.
+            // This is not inferred from storage absence or supplied by an Intent extra.
+            HonorMtkSimTypeProbeOwner.prepareAsync(true,o->{
+                try {o.queryOnce();}
+                catch(RuntimeException e) {probeStatus("Check unavailable. Do not repeat in this session.");return;}
+                if(!isFinishing() && !isDestroyed()) {probeDisplayReads=0;showMtkProbe();}
+            },error->probeStatus(error));
+        } catch(RuntimeException e) {probeStatus("Check unavailable. Do not repeat in this session.");}
+    }
+    private void probeStatus(String text) {
+        if(!isFinishing() && !isDestroyed() && !text.equals(probeOutput.getText().toString()))
+            probeOutput.setText(text);
+    }
+    private void showMtkProbe() {
+        if(isFinishing() || isDestroyed()) return;
+        HonorMtkSimTypeProbeOwner probe=HonorMtkSimTypeProbeOwner.existingOwner();
+        if(probe==null) {
+            probeStatus("eSIM check: "+HonorMtkSimTypeProbeOwner.preparation());
+            if(HonorMtkSimTypeProbeOwner.preparation()==HonorMtkSimTypeProbeOwner.Preparation.PREPARING
+                    && ++probeDisplayReads<24) {
+                probeUi.removeCallbacksAndMessages(null);
+                probeUi.postDelayed(this::showMtkProbe,500); // Also restore display after rotation.
+            }
+            return; // Observing an existing owner never prepares a callback pair or sends a GET.
+        }
+        probe.requestSnapshot(value->{
+            if(isFinishing() || isDestroyed()) return;
+            String text=switch(value.phase()) {
+                case PHYSICAL -> "Device reports eSIM support. Selected path: physical SIM 2.";
+                case EUICC -> "Device reports eSIM support. Selected path: eSIM.";
+                case WAITING -> "Checking eSIM support…";
+                case PREPARED -> "Compatibility check prepared.";
+                case UNQUALIFIED -> "eSIM support could not be confirmed.";
+                case UNKNOWN, UNAVAILABLE -> "Check incomplete. Do not repeat in this session.";
+            };
+            probeStatus(text);
+            if(value.phase()==HonorMtkSimTypeProbeOwner.Phase.WAITING && ++probeDisplayReads<24) {
+                probeUi.removeCallbacksAndMessages(null);
+                probeUi.postDelayed(this::showMtkProbe,500); // Display only, no additional radio GET.
+            }
+        },this::probeStatus);
+    }
+    @Override protected void onDestroy() {
+        probeUi.removeCallbacksAndMessages(null); // Never cancel/rebind the process-lifetime owner.
+        super.onDestroy();
+    }
+    private void show(){probeDisplayReads=0;showMtkProbe();if(owner==null)owner=HonorSepTrialOwner.existingPreparedOwner();
+        output.append("\nOwner: "+HonorSepTrialOwner.existingOwnerState());
+        if(owner!=null)output.append("\n"+owner.snapshot());}
+}
