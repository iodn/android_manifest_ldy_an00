+        check(HonorImsDefaultOpenPolicy.normalCall(result.apply(null,new HonorCompletedCallQoe.CauseFacts(null,null,null,null)),codes),"known absent fields defaults normal per stock");
+        check(HonorImsDefaultOpenPolicy.normalCall(result.apply(500,new HonorCompletedCallQoe.CauseFacts(500,487,500,500)),codes),"reasonSip normal wins over lower nonnormal fields");
+        check(!HonorImsDefaultOpenPolicy.normalCall(result.apply(487,new HonorCompletedCallQoe.CauseFacts(32,500,27,21)),codes),"reasonSip mismatch is decisive before lower whitelists");
+        check(HonorImsDefaultOpenPolicy.normalCall(result.apply(null,new HonorCompletedCallQoe.CauseFacts(null,null,27,null)),codes),"Q850 normal branch");
+        check(HonorImsDefaultOpenPolicy.normalCall(result.apply(null,new HonorCompletedCallQoe.CauseFacts(null,null,null,21)),codes),"release normal branch");
+        check(HonorImsDefaultOpenPolicy.normalCall(result.apply(487,new HonorCompletedCallQoe.CauseFacts(null,null,null,null)),codes),"SIP normal branch");
+        check(HonorImsDefaultOpenPolicy.normalCall(result.apply(null,new HonorCompletedCallQoe.CauseFacts(32,null,null,null)),codes),"modem normal branch");
+        check(!HonorImsDefaultOpenPolicy.normalCall(result.apply(null,new HonorCompletedCallQoe.CauseFacts(500,null,null,null)),codes),"modem mismatch branch");
+        check(HonorImsDefaultOpenPolicy.normalCall(call(1,2,HonorCompletedCallQoe.Domain.VOLTE,HonorCompletedCallQoe.EndType.NORMAL,false),null),"NORMAL short circuit independent of optional cause/config");
+        check(HonorImsDefaultOpenPolicy.normalCall(call(1,2,HonorCompletedCallQoe.Domain.VOLTE,HonorCompletedCallQoe.EndType.UNKNOWN,false),codes)==null,"UNKNOWN stays nonactionable");
+    }
+    public static void main(String[] args){policy();controller();normality();System.out.println("PASS "+checks+" actual default-open policy/controller checks");}
+}
