@@ -0,0 +1,89 @@
+package com.android.internal.telephony.honor;
+
+/** Executes the production model; no Android Binder, radio or hardware simulation. */
+public final class MtkSimTypeQueryTest {
+    private static int checks;
+    private static void check(boolean value, String name) {
+        checks++;
+        if (!value) throw new AssertionError(name);
+    }
+    private static MtkSimTypeQuery query() { return new MtkSimTypeQuery(7, 11, 100); }
+    private static void result(MtkSimTypeQuery q, int type, int error,
+            int support, int mode, int reserved, long now) {
+        q.onResponse(7, 11, type, error, support, mode, reserved, now);
+    }
+    public static void main(String[] args) {
+        for (int type : new int[] {0, 2}) {
+            for (int mode : new int[] {0, 1}) {
+                var q = query();
+                result(q, type, 0, 1, mode, 0, 99);
+                check(q.mode() == mode, "qualified final selector");
+                check(q.state() == (mode == 0 ? MtkSimTypeQuery.State.PHYSICAL
+                        : MtkSimTypeQuery.State.EUICC), "qualified named state");
+                result(q, type, 0, 1, 1 - mode, 0, 99);
+                check(q.mode() == mode, "duplicate cannot rewrite completed result");
+                q.unavailable();
+                check(q.mode() == -1 && q.state() == MtkSimTypeQuery.State.UNKNOWN,
+                        "owner loss retires completed observation");
+            }
+        }
+        var ack = query();
+        result(ack, 1, 0, 0, 0, 0, 10);
+        check(ack.state() == MtkSimTypeQuery.State.WAITING && ack.mode() == -1,
+                "ACK with no tuple is not physical or completion");
+        result(ack, 2, 0, 1, 1, 0, 20);
+        check(ack.mode() == 1, "final follows intermediate ACK");
+
+        int[][] invalid = {{0, 0, 0}, {0, 1, 0}, {2, 0, 0}, {-1, 1, 0},
+                {1, -1, 0}, {1, 2, 0}, {1, 1, 1}};
+        for (int[] tuple : invalid) {
+            var q = query();
+            result(q, 0, 0, tuple[0], tuple[1], tuple[2], 10);
+            check(q.state() == MtkSimTypeQuery.State.UNQUALIFIED && q.mode() == -1,
+                    "invalid or ambiguous tuple cannot identify endpoint");
+            result(q, 0, 0, 1, 0, 0, 20);
+            check(q.mode() == -1, "late valid tuple cannot resurrect terminal refusal");
+        }
+        var stale = query();
+        stale.onResponse(6, 11, 0, 0, 1, 1, 0, 10);
+        stale.onResponse(7, 10, 0, 0, 1, 1, 0, 10);
+        check(stale.state() == MtkSimTypeQuery.State.WAITING && stale.mode() == -1,
+                "other epoch or serial cannot publish");
+        result(stale, 0, 0, 1, 0, 0, 20);
+        check(stale.mode() == 0, "matching final still accepted after stale callbacks");
+
+        for (int type : new int[] {-1, 3}) {
+            var q = query();
+            result(q, type, 0, 1, 0, 0, 10);
+            check(q.state() == MtkSimTypeQuery.State.UNKNOWN && q.mode() == -1,
+                    "invalid response type cannot complete");
+        }
+        var error = query();
+        result(error, 0, 1, 1, 0, 0, 10);
+        check(error.state() == MtkSimTypeQuery.State.UNKNOWN && error.mode() == -1,
+                "RIL failure cannot publish even a plausible tuple");
+        var deadline = query();
+        result(deadline, 0, 0, 1, 0, 0, 100);
+        check(deadline.state() == MtkSimTypeQuery.State.UNKNOWN && deadline.mode() == -1,
+                "response at deadline is late");
+        var timeout = query();
+        timeout.expire(99);
+        check(timeout.state() == MtkSimTypeQuery.State.WAITING, "not expired before deadline");
+        timeout.expire(100);
+        result(timeout, 0, 0, 1, 1, 0, 101);
+        check(timeout.state() == MtkSimTypeQuery.State.UNKNOWN && timeout.mode() == -1,
+                "late response cannot revive timed-out query");
+        var lost = query();
+        lost.unavailable();
+        result(lost, 0, 0, 1, 0, 0, 10);
+        check(lost.state() == MtkSimTypeQuery.State.UNKNOWN && lost.mode() == -1,
+                "transport or owner loss prevents later publication");
+        for (long[] values : new long[][] {{0, 1, 100}, {1, 0, 100}, {1, 1, 0}}) {
+            boolean refused = false;
+            try { new MtkSimTypeQuery(values[0], (int) values[1], values[2]); }
+            catch (IllegalArgumentException expected) { refused = true; }
+            check(refused, "invalid construction refused");
+        }
+        System.out.println("PASS " + checks + " query checks; production model, not Android/Binder/hardware");
+    }
+}
