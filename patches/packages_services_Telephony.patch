+package com.android.internal.telephony;
+import java.util.*;
+/** No native execution: actual production dispatch/response/guard methods use radio doubles. */
+public final class WorkflowRadioBridge {
+ static RIL ril=new RIL();
+ static RIL.HonorLogicalChannelReceipt receipt;
+ static int radioState;
+ public static void reset(){ril=new RIL();receipt=null;radioState=TelephonyManager.RADIO_POWER_ON;ril.setRadioState(radioState,true);}
+ public static void radioTransition(){radioState=radioState==TelephonyManager.RADIO_POWER_ON?TelephonyManager.RADIO_POWER_OFF:TelephonyManager.RADIO_POWER_ON;ril.setRadioState(radioState,true);}
+ public static boolean open(){
+  Object[] raw={null};Message m=new Message();m.callback=x->raw[0]=x;
+  ril.iccOpenLogicalChannel("synthetic-ISDR",0,m);
+  new Responses(ril).open(1,new Info(ril.last.mSerial,0),new ArrayList<>(Arrays.asList(3,0x90,0)));
+  receipt=raw[0] instanceof int[] ints?ril.captureHonorLogicalChannelReceipt(ints):null;
+  return receipt!=null;
+ }
+ public static boolean transmit(){return ril.transmitHonorLogicalChannel(receipt,0x80,0xe2,0,0,0,null,true,new Message());}
+ public static boolean close(){
+  if(ril.closeHonorLogicalChannel(receipt,true,new Message())!=RIL.HonorCloseResult.DISPATCHED)return false;
+  new Responses(ril).close(2,new Info(ril.last.mSerial,0));return true;
+ }
+ public static void failedBackgroundAfterTransition(){
+  ril.iccOpenLogicalChannel("synthetic-background-card-EID",0,new Message());
+  int serial=ril.last.mSerial;radioTransition();
+  new Responses(ril).open(1,new Info(serial,17),new ArrayList<>(Arrays.asList(5,0x6a,0x82)));
+ }
+ public static boolean uncertain(){return ril.mHonorLogicalChannels.diagnosticState().contains("uncertain=true");}
+ public static boolean oldAuthorityBlocked(){
+  int before=ril.nativeCount;boolean allowed=ril.transmitHonorLogicalChannel(receipt,0,0,0,0,0,null,true,new Message());
+  return !allowed&&before==ril.nativeCount;
+ }
+ public static boolean genuineUnavailableBlocked(){
+  if(!open()||!transmit())throw new AssertionError("unavailable control requires a real current receipt");
+  int before=ril.nativeCount;ril.setRadioState(TelephonyManager.RADIO_POWER_UNAVAILABLE,true);
+  return !transmit()&&ril.closeHonorLogicalChannel(receipt,true,new Message())==RIL.HonorCloseResult.REFUSED&&before==ril.nativeCount;
+ }
+}
