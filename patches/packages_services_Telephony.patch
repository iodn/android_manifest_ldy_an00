diff --git a/tests/host/ldy_an00_esim/SepMuxDeadlineTest.java b/tests/host/ldy_an00_esim/SepMuxDeadlineTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..eab90f81cc0d2940a29858befb5680c20a8388fb
--- /dev/null
+++ b/tests/host/ldy_an00_esim/SepMuxDeadlineTest.java
@@ -0,0 +1,66 @@
+/* Copyright (C) 2026 The LineageOS Project. SPDX-License-Identifier: Apache-2.0 */
+package com.android.internal.telephony.honor;
+
+/** Actual protocol, admission gate and journal; synthetic elapsed clock, no Android/modem calls. */
+public final class SepMuxDeadlineTest {
+    static int checks;
+    static void check(boolean ok) {checks++; if(!ok) throw new AssertionError("check "+checks);}
+    static void refuses(Runnable action) {
+        try {action.run();} catch(IllegalStateException expected) {checks++; return;}
+        throw new AssertionError("not refused");
+    }
+    static SepMuxTrial reserved(long now) {
+        var trial=new SepMuxTrial();
+        trial.begin(new SepMuxTrial.Evidence(1001,"u:r:radio:s0",true,6,
+                SepMuxTrial.VENDOR_HASH,true,true,true),1,77,SepMuxTrial.Selector.EUICC,
+                new SepMuxTrial.Baseline(1,9,true,true,false),now);
+        return trial;
+    }
+    static final class Memory implements SepMuxJournal.Store {
+        String record;
+        public String read() {return record;}
+        public void writeDurably(String value) {record=value;}
+    }
+    public static void main(String[] args) throws Exception {
+        // Admission stays10s, regardless of the native completion observation policy.
+        var gate=new TrialDispatchGate();gate.start(100);gate.check(10099);
+        refuses(()->gate.commitDispatch(10100));check(!gate.stopped());
+        var expired=reserved(100);refuses(()->expired.markDispatched(10100));
+        var backwards=reserved(100);refuses(()->backwards.markDispatched(99));
+        var overflow=reserved(Long.MAX_VALUE-SepMuxTrial.ADMISSION_TIMEOUT_MS);
+        refuses(()->overflow.markDispatched(Long.MAX_VALUE-SepMuxTrial.ADMISSION_TIMEOUT_MS));
+        var before=reserved(100);refuses(()->before.queryStatus(101));
+        check(before.state()==SepMuxTrial.State.UNKNOWN);refuses(()->before.markDispatched(102));
+
+        // Durable journal work can consume admission time; completion starts at its commitment.
+        var disk=new Memory();var journal=new SepMuxJournal(disk);var trial=reserved(100);
+        journal.pending(9,77,SepMuxTrial.Selector.EUICC);
+        trial.markDispatched(10099);refuses(()->trial.markDispatched(10099));
+        trial.response(1,77,1005,0,0,10100);
+        trial.tick(20000);check(trial.state()==SepMuxTrial.State.ACCEPTED_WAITING);
+        check(!trial.canRequestPhysicalReturn() && disk.record.startsWith("SEP1 PENDING "));
+        // Native300s wait is not falsely expired by the former10s admission watchdog.
+        trial.indication(1,1002,new int[]{1,0},310099);
+        var query=trial.queryStatus(310100);
+        trial.status(query,true,true,true,1,true,310101);
+        check(trial.canRequestPhysicalReturn());journal.completed(9,77,trial);
+        check(disk.record.equals("SEP1 CLEAN 9 77 1\n"));
+
+        // Exact observation boundary is still terminal UNKNOWN, never cancellation or clean.
+        var late=reserved(100);late.markDispatched(1099);
+        late.response(1,77,1005,0,0,1100);
+        late.tick(361098);check(late.state()==SepMuxTrial.State.ACCEPTED_WAITING);
+        late.tick(361099);check(late.state()==SepMuxTrial.State.UNKNOWN);
+        late.indication(1,1002,new int[]{1,0},361100);
+        check(!late.canRequestPhysicalReturn());refuses(()->late.markDispatched(361101));
+        var pendingDisk=new Memory();var pending=new SepMuxJournal(pendingDisk);
+        pending.pending(9,77,SepMuxTrial.Selector.EUICC);
+        try {pending.completed(9,77,late);throw new AssertionError("late clean");}
+        catch(java.io.IOException expected) {checks++;}
+        check(pendingDisk.record.startsWith("SEP1 PENDING "));
+        var lost=reserved(100);lost.markDispatched(100);lost.transportLost();
+        lost.indication(1,1002,new int[]{1,0},300100);
+        check(lost.state()==SepMuxTrial.State.UNKNOWN && !lost.canRequestPhysicalReturn());
+        System.out.println("PASS checks="+checks+"; split admission/observation, no cancellation claim");
+    }
+}
diff --git a/tests/host/ldy_an00_esim/SepMuxJournalTest.java b/tests/host/ldy_an00_esim/SepMuxJournalTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..1c1625a79ad8e6f107a51d7d6584bdd8af600253
--- /dev/null
+++ b/tests/host/ldy_an00_esim/SepMuxJournalTest.java
@@ -0,0 +1,91 @@
+package com.android.internal.telephony.honor;
+import java.io.*;
+import java.nio.file.*;
+import java.nio.channels.FileChannel;
+import java.nio.charset.StandardCharsets;
+public final class SepMuxJournalTest {
+ static int checks;
+ interface Action {void run() throws Exception;}
+ static void check(boolean ok) {checks++;if(!ok)throw new AssertionError();}
+ static void rejects(Action a) throws Exception {checks++;try {a.run();}catch(IOException expected){return;}throw new AssertionError("not refused");}
+ static final class Disk implements SepMuxJournal.Store {
+  final Path p;int writes,fail;boolean unreadable;
+  Disk(Path p){this.p=p;}
+  public String read() throws IOException {if(unreadable)throw new IOException("read denied");return Files.exists(p)?Files.readString(p):null;}
+  public void writeDurably(String value) throws IOException {
+   writes++;if(fail==1)throw new IOException("before write");
+   Path n=p.resolveSibling(p.getFileName()+".tmp");
+   Files.writeString(n,value,StandardCharsets.US_ASCII);
+   try(FileChannel f=FileChannel.open(n,StandardOpenOption.WRITE)){f.force(true);}
+   if(fail==2)throw new IOException("before publication");
+   Files.move(n,p,StandardCopyOption.ATOMIC_MOVE,StandardCopyOption.REPLACE_EXISTING);
+   try(FileChannel f=FileChannel.open(p.getParent(),StandardOpenOption.READ)){f.force(true);}
+   if(fail==3)throw new IOException("after durable publication");
+  }
+ }
+ static SepMuxTrial model(long generation,int serial) {
+  SepMuxTrial m=new SepMuxTrial();
+  var evidence=new SepMuxTrial.Evidence(1001,"u:r:radio:s0",true,6,SepMuxTrial.VENDOR_HASH,true,true,true);
+  m.begin(evidence,1,serial,SepMuxTrial.Selector.EUICC,new SepMuxTrial.Baseline(1,generation,true,true,false),0);
+  m.markDispatched(0);
+  return m;
+ }
+ static void complete(SepMuxTrial m) {
+  m.response(1,11,1005,0,0,1);
+  m.indication(1,1002,new int[]{1,0},2);
+  var q=m.queryStatus(3);m.status(q,true,true,true,1,true,4);
+ }
+ public static void main(String[] args) throws Exception {
+  Path dir=Files.createTempDirectory("sep-journal-");
+  Disk disk=new Disk(dir.resolve("epoch"));
+  SepMuxJournal j=new SepMuxJournal(disk);j.requireClean();check(disk.writes==0);
+  // The real production pending() must finish before caller reaches its setter boundary.
+  j.pending(7,11,SepMuxTrial.Selector.EUICC);
+  check(Files.readString(disk.p).equals("SEP1 PENDING 7 11 1\n"));
+  rejects(()->new SepMuxJournal(disk)); // crash immediately BEFORE dispatch remains fenced.
+  int[] dispatched={0};dispatched[0]++; // setter boundary reached only after pending returned.
+  check(dispatched[0]==1);rejects(()->new SepMuxJournal(disk)); // crash AFTER dispatch also fenced.
+  rejects(()->j.pending(7,12,SepMuxTrial.Selector.PHYSICAL));
+  SepMuxTrial m=model(7,11);m.response(1,11,1005,0,0,1);
+  var early=m.queryStatus(2);m.status(early,true,true,true,1,true,3);
+  rejects(()->j.completed(7,11,m)); // early success + endpoint are not modem completion.
+  m.indication(1,1002,new int[]{1,0},4);
+  rejects(()->j.completed(7,11,m)); // completion still requires newly issued status.
+  var fresh=m.queryStatus(5);m.status(fresh,true,true,true,1,true,6);
+  rejects(()->j.completed(8,11,m));rejects(()->j.completed(7,12,m));
+  var other=model(8,11);complete(other);rejects(()->j.completed(7,11,other));
+  j.completed(7,11,m);check(Files.readString(disk.p).equals("SEP1 CLEAN 7 11 1\n"));
+  new SepMuxJournal(disk).requireClean(); // only durable proved completion permits takeover.
+  j.pending(7,12,SepMuxTrial.Selector.PHYSICAL);j.unknown(7,12);
+  check(Files.readString(disk.p).equals("SEP1 UNKNOWN 7 12 0\n"));
+  rejects(()->new SepMuxJournal(disk));
+  var late=new SepMuxTrial();
+  late.begin(new SepMuxTrial.Evidence(1001,"u:r:radio:s0",true,6,SepMuxTrial.VENDOR_HASH,true,true,true),
+    1,12,SepMuxTrial.Selector.PHYSICAL,new SepMuxTrial.Baseline(1,7,true,true,true),0);
+  late.markDispatched(0);
+  late.response(1,12,1005,0,0,1);late.indication(1,1002,new int[]{1,0},2);
+  var lateQuery=late.queryStatus(3);late.status(lateQuery,true,true,false,1,true,4);
+  check(late.canRequestPhysicalReturn());
+  rejects(()->j.completed(7,12,late)); // even matching late success cannot clear explicit UNKNOWN.
+  // Dispatch failure/timeout leaves pending or explicitly unknown; late complete cannot clear.
+  for(String broken:new String[]{"", "SEP1 CLEAN 7 11 1", "SEP1 CLEAN 0 11 1\n", "SEP1 CLEAN 7 2147483648 1\n", "SEP1 CLEAN 9223372036854775808 11 1\n", "SEP1 CLEAN 7 11 2\n", "SEP1 CLEAN 7 11 1\nextra"}) {
+   Files.writeString(disk.p,broken);rejects(()->new SepMuxJournal(disk));
+  }
+  disk.unreadable=true;rejects(()->new SepMuxJournal(disk));disk.unreadable=false;
+  for(int fault=1;fault<=3;fault++) {
+   Files.writeString(disk.p,"SEP1 CLEAN 7 11 1\n");disk.fail=0;
+   SepMuxJournal failed=new SepMuxJournal(disk);disk.fail=fault;int[] setterCalls={0};
+   rejects(()->{failed.pending(7,12,SepMuxTrial.Selector.PHYSICAL);setterCalls[0]++;});
+   check(setterCalls[0]==0);rejects(failed::requireClean);
+   disk.fail=0;
+   if(fault==3)rejects(()->new SepMuxJournal(disk));
+   // Before publication old CLEAN can survive, but no setter was reached in this execution.
+  }
+  Files.writeString(disk.p,"SEP1 CLEAN 7 11 1\n");disk.fail=0;
+  SepMuxJournal completionFail=new SepMuxJournal(disk);completionFail.pending(7,11,SepMuxTrial.Selector.EUICC);
+  var good=model(7,11);complete(good);disk.fail=1;
+  rejects(()->completionFail.completed(7,11,good));rejects(completionFail::requireClean);
+  disk.fail=0;rejects(()->new SepMuxJournal(disk));
+  System.out.println("PASS checks="+checks+"; real-file roundtrip + injected durable-store failures; no Binder/modem/storage-policy proof");
+ }
+}
