+package com.android.internal.telephony.honor;
+import android.content.*;
+import android.os.*;
+import android.telephony.*;
+import android.hardware.display.*;
+import android.media.AudioManager;
+import com.android.internal.telephony.*;
+import com.android.internal.telephony.uicc.UiccController;
+import vendor.honor.hardware.hnradio.*;
+import java.util.*;
+
+/** Real source-owned controllers, broker, and lease; only hardware/framework endpoints are fixtures. */
+public final class AssistAdmissionWakeupHostTest {
+ static int checks,answered;
+ static Context context;static DisplayManager display;static AudioManager audio;
+ static final List<HonorRadioCommBroker.CallResult> outcomes=new ArrayList<>();
+ static final Handler reply=new Handler(new Looper());
+ static final class Store implements SepMuxJournal.Store {
+  String value;public String read(){return value;}public void writeDurably(String v){value=v;}
+ }
+ static final class Radio extends Binder implements IRadio {
+  IRadioResponse response;int serial,requests;
+  public int getInterfaceVersion(){return 6;}public String getInterfaceHash(){return SepMuxTrial.VENDOR_HASH;}
+  public void setResponseFunctionsHn(IRadioResponse r,IRadioIndication i){response=r;}
+  public void sendCommRequest(int s,int m,MsgPayload p){if(m!=101)throw new AssertionError();serial=s;requests++;}
+  public void responseAcknowledgement(){}
+  void complete(){RadioResponseInfo info=new RadioResponseInfo();info.serial=serial;info.type=0;response.sendCommRequestResponse(info,101,new MsgPayload());Handler.drain();}
+ }
+ static void check(boolean value,String reason){checks++;if(!value)throw new AssertionError(reason);}
+ static void ackAll(){
+  int guard=100;
+  while(answered<MtkAssistTransport.sent.size()){
+   if(--guard==0)throw new AssertionError("Assist notification loop");
+   var sent=MtkAssistTransport.sent.get(answered++);sent.transport().respond(sent);Handler.drain();
+  }
+ }
+ static MtkAssistSyncState.Notification last(int slot,MtkAssistSyncState.Kind kind){
+  return MtkAssistTransport.sent.stream().map(MtkAssistTransport.Sent::request)
+   .filter(n->n.slot()==slot && n.kind()==kind).reduce((a,b)->b).orElseThrow();
+ }
+ static long count(int slot,MtkAssistSyncState.Kind kind){
+  return MtkAssistTransport.sent.stream().map(MtkAssistTransport.Sent::request)
+   .filter(n->n.slot()==slot && n.kind()==kind).count();
+ }
+ static void failedLast(){
+  var s=MtkAssistTransport.sent.get(answered++);var t=s.transport();
+  t.handler.post(()->t.listener.response(t.slot,t.generation,
+   s.request().kind()==MtkAssistSyncState.Kind.DEFAULT_DATA?MtkAssistSyncState.Kind.DATA:s.request().kind(),s.serial(),0,2));
+  Handler.drain();
+ }
+ public static void main(String[] args)throws Exception {
+  context=new Context();SubscriptionManager.dds=2;
+  context.services.put(SubscriptionManager.class,new SubscriptionManager());
+  context.services.put(TelephonyManager.class,new TelephonyManager());
+  display=new DisplayManager();context.services.put(DisplayManager.class,display);
+  audio=new AudioManager();context.services.put(AudioManager.class,audio);
+  PhoneFactory.phones=new Phone[]{new Phone(1),new Phone(2)};PhoneFactory.phones[0].settings.user=false;
+  UiccController.cards=new Object[]{new Object(),new Object()};
+  HonorLpaLeaseService.lease=new LpaOperationLease(new Store());
+  for(int slot=1;slot<=2;slot++){
+   ServiceManager.publish("data/slot"+slot,new MtkAssistTransport.FakeBinder());
+   ServiceManager.publish("modem/slot"+slot,new MtkAssistTransport.FakeBinder());
+  }
+  Radio radio=new Radio();
+  ServiceManager.publish("vendor.honor.hardware.hnradio.IRadio/slot1",radio);
+  ServiceManager.publish("vendor.honor.hardware.hnradio.IRadio/slot2",new Radio());
+  HonorRadioCommBroker.initialize(context);
+  HonorMtkStateSync.initialize(context);Handler.drain();ackAll();
+  int[] notices={0};HonorRadioCommBroker.addStateListener(reply,()->notices[0]++);Handler.drain();
+  check(last(0,MtkAssistSyncState.Kind.DATA).values()[0]==0,"initial user data preference");
+  check(last(1,MtkAssistSyncState.Kind.VOIP).values()[0]==0,"initial audio preference");
+  long peerData=count(1,MtkAssistSyncState.Kind.DATA),dds=count(0,MtkAssistSyncState.Kind.DEFAULT_DATA);
+  int constructors=MtkAssistTransport.constructors;
+  if(!"lease".equals(args[0])){
+   HonorRadioCommBroker.sendCallQos(0,true,1,reply,outcomes::add);Handler.drain();
+   check(radio.requests==1 && !HonorRadioCommBroker.snapshot(0).ready(),"actual outstanding QoS gates admission");
+   int before=MtkAssistTransport.sent.size();
+   PhoneFactory.phones[0].settings.user=true;PhoneFactory.phones[0].settings.changed();
+   display.displays[0].state=1;display.changed();audio.mode(2);audio.mode(3);Handler.drain();
+   check(MtkAssistTransport.sent.size()==before,"data/display/audio events deferred while QoS pending");
+   radio.complete();ackAll();
+   check(last(0,MtkAssistSyncState.Kind.DATA).values()[0]==1,"QoS final must automatically wake latest data review");
+   check(last(1,MtkAssistSyncState.Kind.SCREEN).values()[0]==0,"QoS final wakes latest display review");
+   check(last(1,MtkAssistSyncState.Kind.VOIP).values()[0]==1,"QoS final wakes latest audio review");
+   check(count(1,MtkAssistSyncState.Kind.DATA)==peerData,"already ACKed peer data not invalidated");
+   check(count(0,MtkAssistSyncState.Kind.DEFAULT_DATA)==dds,"already ACKed DDS not invalidated");
+   check(MtkAssistTransport.constructors==constructors,"readiness does not rebind Assist callbacks");
+  }
+  // An ordinary operation0 has no native mutation. END itself must notify; no manual settled/readiness poke.
+  audio.mode(0);display.displays[0].state=2;display.changed();Handler.drain();ackAll();
+  var lease=HonorLpaLeaseService.lease;
+  var scope=new LpaOperationLease.Scope("00000000000000000000000000000001",10055,0,0,1,0,7,2,10);
+  Object client=new Object(),endpoint=new Object();
+  long generation=HonorRadioCommBroker.snapshot(0).generation();
+  lease.acquire(scope,client,endpoint,0,1000);
+  check(HonorRadioCommBroker.snapshot(0).generation()==generation,"read-only lease BEGIN does not replace call generation");
+  int before=MtkAssistTransport.sent.size();
+  PhoneFactory.phones[0].settings.roaming=true;PhoneFactory.phones[0].settings.changed();
+  audio.mode(3);display.displays[0].state=1;display.changed();Handler.drain();
+  check(MtkAssistTransport.sent.size()==before,"read-only LPA lease defers fresh notifications");
+  check(lease.complete(scope,client,endpoint,1,true),"real operation0 completion");
+  Handler.drain();ackAll();
+  check(HonorRadioCommBroker.snapshot(0).generation()==generation,"read-only lease END does not replace call generation");
+  check(last(0,MtkAssistSyncState.Kind.DATA).values()[1]==1,"real lease END automatically wakes latest data");
+  check(last(1,MtkAssistSyncState.Kind.VOIP).values()[0]==1,"real lease END wakes audio");
+  check(count(1,MtkAssistSyncState.Kind.DATA)==peerData,"read-only END preserves ACKed peer data");
+  check(count(0,MtkAssistSyncState.Kind.DEFAULT_DATA)==dds,"read-only END preserves ACKed DDS");
+  check(MtkAssistTransport.constructors==constructors,"read-only END preserves bindings");
+  // A terminal data refusal must not be cleared by the broker's readiness notification.
+  PhoneFactory.phones[0].settings.roaming=false;PhoneFactory.phones[0].settings.changed();Handler.drain();
+  failedLast();before=MtkAssistTransport.sent.size();
+  HonorRadioCommBroker.sendCallQos(0,false,2,reply,outcomes::add);Handler.drain();radio.complete();ackAll();
+  check(MtkAssistTransport.sent.size()==before,"admission wake preserves terminal data refusal");
+  // Same for terminal VoIP refusal: no externalEvent()/invalidate() on admission wake.
+  audio.mode(0);Handler.drain();failedLast();before=MtkAssistTransport.sent.size();
+  HonorRadioCommBroker.sendCallQos(0,false,3,reply,outcomes::add);Handler.drain();radio.complete();ackAll();
+  check(MtkAssistTransport.sent.size()==before,"admission wake preserves terminal VoIP refusal");
+  lease.acquire(scope,client,endpoint,2,1000);int unchanged=notices[0];
+  check(!lease.complete(scope,client,endpoint,3,false),"uncertain END remains unknown");
+  Handler.drain();
+  check(notices[0]==unchanged && !HonorRadioCommBroker.snapshot(0).ready(),"UNKNOWN must not publish admission readiness");
+  System.out.println("PASS "+checks+" actual Assist/VoIP+broker+lease admission-wakeup checks");
+ }
+}
