+/* Copyright (C) 2026 The LineageOS Project. SPDX-License-Identifier: Apache-2.0 */
+package com.android.internal.telephony.honor;
+import java.io.*;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.*;
+final class HonorOverseasVonrPolicyTest {
+ static int checks;
+ static void ok(boolean value){if(!value)throw new AssertionError("check "+checks);checks++;}
+ static class Store implements SepMuxJournal.Store {
+  String text;boolean fail;
+  public String read(){return text;}
+  public void writeDurably(String value)throws IOException{if(fail)throw new IOException();text=value;}
+ }
+ static HonorOverseasVonrPolicy.Rates r(Double recent,Double vonr,Double epsfb,Double volte){
+  return new HonorOverseasVonrPolicy.Rates(recent,vonr,epsfb,volte);
+ }
+ static HonorCompletedCallQoe.Result sample(HonorCompletedCallQoe.EndType end,Integer sip,
+     HonorCompletedCallQoe.CauseFacts facts){
+  return new HonorCompletedCallQoe.Result(new HonorCompletedCallQoe.Epoch(0,1,1,1),
+    HonorCompletedCallQoe.Direction.MO,HonorCompletedCallQoe.Domain.VONR,
+    HonorCompletedCallQoe.Stage.STARTING,end,null,sip,null,false,
+    HonorCompletedCallQoe.Function.NONE,facts);
+ }
+ public static void main(String[] args)throws Exception {
+  String xml=Files.readString(Path.of(args[0]));
+  HonorOverseasVonrPolicy.Config config;
+  try(var in=new ByteArrayInputStream(xml.getBytes(StandardCharsets.UTF_8))){
+   config=HonorOverseasVonrPolicy.Config.read(in);
+  }
+  ok(config.permits("44011")&&!config.permits("46000")&&!config.permits("23430"));
+  ok(!config.permits(null)&&!config.permits("44")&&!config.permits("unknown"));
+  ok(config.excluded().size()==15&&config.timerMillis()==60000);
+  var policy=new HonorOverseasVonrPolicy(config);
+  ok(policy.abnormal(r(null,null,null,null)).durationMillis()==180000);
+  ok(policy.abnormal(r(50.0,50.0,null,null)).durationMillis()==180000);
+  ok(policy.abnormal(r(95.0,95.0,90.0,80.0)).kind()==HonorOverseasVonrPolicy.Kind.NONE);
+  ok(policy.abnormal(r(90.0,80.0,90.0,null)).durationMillis()==180000);
+  ok(policy.abnormal(r(80.0,80.0,85.0,null)).durationMillis()==360000);
+  ok(policy.abnormal(r(70.0,70.0,80.0,null)).durationMillis()==540000);
+  var lower=new HonorOverseasVonrPolicy(config);
+  for(int i=0;i<5;i++)ok(lower.abnormal(r(60.0,60.0,95.0,null)).durationMillis()==540000);
+  ok(lower.abnormal(r(60.0,60.0,95.0,null)).kind()==HonorOverseasVonrPolicy.Kind.SUSTAINED);
+  ok(lower.abnormal(r(60.0,81.0,95.0,null)).kind()==HonorOverseasVonrPolicy.Kind.TIMED);
+  ok(lower.abnormal(r(60.0,60.0,90.0,null)).kind()==HonorOverseasVonrPolicy.Kind.TIMED);
+  lower.ownedSimAbsent();
+  ok(lower.abnormal(r(60.0,60.0,95.0,null)).kind()==HonorOverseasVonrPolicy.Kind.TIMED);
+  for(String malformed:new String[]{xml.replace("featureSwitch=\"1\"","featureSwitch=\"2\""),
+    xml.replace("value1=\"90\"","value1=\"20\""),xml.replace("t1=\"60\"","t1=\"-1\""),
+    xml.replace("</xml>","<FeatureSwitch featureSwitch=\"1\"/></xml>")}){
+   try{HonorOverseasVonrPolicy.Config.read(new ByteArrayInputStream(malformed.getBytes(StandardCharsets.UTF_8)));
+    throw new AssertionError("bad config accepted");}catch(IllegalArgumentException expected){checks++;}
+  }
+  Store store=new Store();var history=new HonorOverseasVonrHistory(store,"44011");
+  ok(history.rates(100000).recentVonr()==null);
+  for(int i=0;i<9;i++)history.add(i*1000,HonorOverseasVonrHistory.Domain.VONR,true);
+  ok(history.rates(100000).recentVonr()==null);
+  history.add(10000,HonorOverseasVonrHistory.Domain.VONR,false);
+  ok(history.rates(100000).recentVonr()==90.0&&history.rates(100000).daysVonr()==90.0);
+  for(int i=0;i<10;i++)history.add((20+i)*1000,HonorOverseasVonrHistory.Domain.EPSFB,true);
+  ok(history.rates(100000).daysEpsfb()==100.0);
+  var reopened=new HonorOverseasVonrHistory(store,"44011");
+  ok(reopened.rates(100000).recentVonr()==90.0);
+  long week=7L*24*60*60*1000;
+  reopened.add(week+100000,HonorOverseasVonrHistory.Domain.VOLTE,true);
+  ok(reopened.rates(week+100000).recentVonr()==90.0
+    &&reopened.rates(week+100000).daysVonr()==null&&reopened.rates(week+100000).daysEpsfb()==null);
+  try{new HonorOverseasVonrHistory(store,"44010");throw new AssertionError();}
+  catch(IOException expected){checks++;}
+  Store invalid=new Store();invalid.text="OVNRH1 44011\n0 VONR 2\n";
+  try{new HonorOverseasVonrHistory(invalid,"44011");throw new AssertionError();}
+  catch(IOException expected){checks++;}
+  store.fail=true;
+  try{reopened.add(week+101000,HonorOverseasVonrHistory.Domain.VONR,true);throw new AssertionError();}
+  catch(IOException expected){checks++;}
+  try{reopened.rates(week+101000);throw new AssertionError();}
+  catch(IOException expected){checks++;}
+  Store precise=new Store();var secondPrecision=new HonorOverseasVonrHistory(precise,"44011");
+  for(int i=0;i<10;i++)secondPrecision.add(1000,HonorOverseasVonrHistory.Domain.VONR,i<7);
+  ok(secondPrecision.rates(1999).recentVonr()==null);
+  ok(secondPrecision.rates(2000).recentVonr()==70.0);
+  ok(secondPrecision.rates(week+1000).daysVonr()==null);
+  ok(secondPrecision.rates(30L*24*60*60*1000+1000).recentVonr()==null);
+  HonorOverseasCallNormality normality;
+  try(var stream=Files.newInputStream(Path.of(args[1]))){normality=HonorOverseasCallNormality.read(stream);}
+  var error=HonorCompletedCallQoe.EndType.ERROR;
+  ok(normality.isNormal(sample(error,503,new HonorCompletedCallQoe.CauseFacts(999,487,34,null))));
+  ok(!normality.isNormal(sample(error,487,new HonorCompletedCallQoe.CauseFacts(32,500,17,21))));
+  ok(normality.isNormal(sample(error,503,new HonorCompletedCallQoe.CauseFacts(999,null,null,21))));
+  ok(!normality.isNormal(sample(error,487,new HonorCompletedCallQoe.CauseFacts(32,null,null,2))));
+  ok(normality.isNormal(sample(error,487,new HonorCompletedCallQoe.CauseFacts(999,null,null,null))));
+  ok(normality.isNormal(sample(error,null,new HonorCompletedCallQoe.CauseFacts(32,null,null,null))));
+  ok(normality.isNormal(sample(error,null,new HonorCompletedCallQoe.CauseFacts(null,null,null,null))));
+  ok(normality.isNormal(sample(error,503,null))==null);
+  ok(normality.isNormal(sample(HonorCompletedCallQoe.EndType.UNKNOWN,487,
+    new HonorCompletedCallQoe.CauseFacts(32,null,null,null)))==null);
+  var cs=HonorCompletedCallQoe.EndType.CS;
+  ok(HonorOverseasCallNormality.historySuccess(sample(cs,null,
+    new HonorCompletedCallQoe.CauseFacts(25,null,null,null))));
+  ok(!HonorOverseasCallNormality.historySuccess(sample(cs,null,
+    new HonorCompletedCallQoe.CauseFacts(16,null,null,null))));
+  ok(HonorOverseasCallNormality.historySuccess(sample(cs,null,null))==null);
+  ok(!HonorOverseasCallNormality.historySuccess(sample(error,null,
+    new HonorCompletedCallQoe.CauseFacts(32,null,null,null))));
+  System.out.println("HonorOverseasVonrPolicyTest "+checks+" checks PASS");
+ }
+}
