+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.internal.telephony.honor;
+
+/**
+ * Per-slot read-only observation. An epoch is a qualified native binding and SIM/profile identity,
+ * never a logical call cycle. Missing reports and MBN failures do not imply features are disabled.
+ */
+public final class HonorImsDefaultOpenState {
+    private final int slot;
+    private long bindingGeneration;
+    private long profileGeneration;
+    private long sequence;
+    private HonorMtkImsDefaultOpenDecoder.Report report;
+
+    public HonorImsDefaultOpenState(int slot) {
+        if (slot < 0 || slot >= 2) {
+            throw new IllegalArgumentException("slot");
+        }
+        this.slot = slot;
+    }
+
+    /** Retire the old observation before a real binding/profile change or loss of qualification. */
+    public void qualify(long bindingGeneration, long profileGeneration) {
+        if (bindingGeneration <= 0 || profileGeneration <= 0) {
+            this.bindingGeneration = 0;
+            this.profileGeneration = 0;
+            sequence = 0;
+            report = null;
+        } else if (this.bindingGeneration != bindingGeneration
+                || this.profileGeneration != profileGeneration) {
+            this.bindingGeneration = bindingGeneration;
+            this.profileGeneration = profileGeneration;
+            sequence = 0;
+            report = null;
+        }
+    }
+
+    /** Receipt-time generations and sequence must be supplied by the sole hardware owner. */
+    public boolean accept(long bindingGeneration, long profileGeneration, long observedSequence,
+            HonorMtkImsDefaultOpenDecoder.Report next) {
+        if (next == null || next.slot() != slot || this.bindingGeneration <= 0
+                || this.profileGeneration <= 0 || this.bindingGeneration != bindingGeneration
+                || this.profileGeneration != profileGeneration || observedSequence <= sequence) {
+            return false;
+        }
+        sequence = observedSequence;
+        report = next;
+        return true;
+    }
+
+    /** A newer unqualified report cannot leave an older qualified value looking current. */
+    public void unqualified(long bindingGeneration, long observedSequence) {
+        if (this.bindingGeneration == bindingGeneration && observedSequence > sequence) {
+            sequence = observedSequence;
+            report = null;
+        }
+    }
+
+    /** Null means no current-profile observation; featureBits -1 means a reported lookup failure. */
+    public HonorMtkImsDefaultOpenDecoder.Report report() {
+        return report;
+    }
+}
