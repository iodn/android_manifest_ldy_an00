+        e.config(2);e.policy.cellularService(false);
+        check(e.timers.timers.isEmpty(),"permanent WFC preference excludes new evaluator");
+        e=new Engine();e.config(2);e.policy.registered(wifi);e.policy.registrationFailed(wifi,403);
+        check(!e.memory.blocked&&e.votes.isEmpty(),"registered WFC is not first-registration cure");
