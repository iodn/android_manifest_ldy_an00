@@ -0,0 +1,24 @@
+/* Copyright (C) 2026 The LineageOS Project. SPDX-License-Identifier: Apache-2.0 */
+package com.android.internal.telephony.honor;
+
+/** One callback owner, with an explicit transfer from an already retired owner. */
+final class MtkSimCallbackOwner {
+    static final MtkSimCallbackOwner PROCESS = new MtkSimCallbackOwner();
+    private Object owner;
+    private boolean retired;
+    synchronized void claim(Object token) {
+        if(token==null || owner!=null) throw new IllegalStateException("MTK callback pair already claimed");
+        owner=token; // Retained even if the subsequent remote registration outcome is unknown.
+    }
+    synchronized void retire(Object token) {
+        if (token == null || owner != token)
+            throw new IllegalStateException("MTK retiring owner not current");
+        retired = true;
+    }
+    synchronized void replace(Object previous, Object successor) {
+        if (!retired || previous == null || successor == null || previous == successor || owner != previous)
+            throw new IllegalStateException("MTK callback successor not owned");
+        owner = successor;
+        retired = false;
+    }
+}
