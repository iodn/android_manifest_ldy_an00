index 0000000000000000000000000000000000000000..9014a3b0484abca869d3d1ea2b9b3c93f53c17cc
--- /dev/null
+++ b/src/com/android/internal/telephony/honor/HonorImsDcBroadcastTransport.java
@@ -0,0 +1,59 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.internal.telephony.honor;
+
+import android.app.AppGlobals;
+import android.content.Context;
+import android.content.Intent;
+import android.os.IBinder;
+import android.os.RemoteException;
+import java.util.Objects;
+
+/**
+ * Setting17 submission through the retained MTK IMS owner's stock receiver.
+ *
+ * Does not register or replace any modem callback. The caller must hold reviewed durable
+ * setting custody and recheck the current profile, call state and shared operation lease before
+ * entering this method. A return means Android accepted a broadcast, not receiver execution,
+ * native acceptance or modem application. A thrown exception does not prove nothing was sent.
+ */
+final class HonorImsDcBroadcastTransport {
+    static final String PACKAGE = "com.mediatek.ims";
+    static final String ACTION = "com.hihonor.intent.action.UPDATE_IMSDC_CAP";
+    private final Context context;
+    private final IBinder protectionOwner;
+
+    /** Metadata RPC runs before taking setting custody or the common operation lease. */
+    HonorImsDcBroadcastTransport(Context context) {
+        this.context = Objects.requireNonNull(context);
+        try {
+            var packages = AppGlobals.getPackageManager();
+            if (packages == null || !packages.isProtectedBroadcast(ACTION)) {
+                throw new IllegalStateException("IMS data-channel broadcast is not protected");
+            }
+            protectionOwner = Objects.requireNonNull(packages.asBinder());
+            if (!protectionOwner.isBinderAlive()) {
+                throw new IllegalStateException("IMS broadcast protection owner unavailable");
+            }
+        } catch (RemoteException unavailable) {
+            throw new IllegalStateException("Cannot verify IMS broadcast protection", unavailable);
+        }
+    }
+
+    void dispatch(int logicalPhone, int normalizedMode) {
+        if (logicalPhone < 0 || logicalPhone > 1 || normalizedMode < 0 || normalizedMode > 1) {
+            throw new IllegalArgumentException("Invalid IMS data-channel setting");
+        }
+        // The current PMS only adds protected actions. A replaced/dead system-server cohort
+        // requires a freshly prepared transport; do not perform metadata RPC under the lease.
+        if (!protectionOwner.isBinderAlive()) {
+            throw new IllegalStateException("IMS broadcast protection owner retired");
+        }
+        Intent intent = new Intent(ACTION).setPackage(PACKAGE);
+        intent.putExtra("phoneId", logicalPhone);
+        intent.putExtra("persist.vendor.imsdc_support", normalizedMode);
+        context.sendBroadcast(intent);
+    }
+}
diff --git a/src/com/android/internal/telephony/honor/HonorImsDcController.java b/src/com/android/internal/telephony/honor/HonorImsDcController.java
new file mode 100644
index 0000000000000000000000000000000000000000..c53df774501764d92d405f639c37fb4e5b43393d
--- /dev/null
+++ b/src/com/android/internal/telephony/honor/HonorImsDcController.java
@@ -0,0 +1,230 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.internal.telephony.honor;
+
+import android.os.Handler;
+import java.util.Objects;
+import java.util.function.Consumer;
+import java.util.function.LongSupplier;
+
+/**
+ * Handler-confined runtime DC recovery orchestration. One shared completed-call producer supplies
+ * events; this owns no native listener or call matcher. An injected, custody-qualified backend owns
+ * actual setting17 submission. SUBMITTED/configured values never mean CP-applied state.
+ */
+final class HonorImsDcController {
+    /** Every nullable field is unknown, not a permissive/default false or optional-service zero. */
+    record Inputs(Boolean productEligible, Boolean carrierEligible, Boolean userEnabled,
+            Boolean cityEligible, Integer configuredMode, Integer optionalDcCount,
+            boolean admissionReady, String provenance) {}
+    interface InputsProvider {
+        Inputs read(int slot, long profileEpoch);
+        /** Notify actual user/configuration/admission/screen changes on the supplied handler. */
+        void addListener(Handler handler, Runnable changed);
+    }
+    record Request(int slot, long profileEpoch, long token, int normalizedMode) {}
+    enum Submission { SUBMITTED, DEFERRED, REFUSED, UNKNOWN }
+    /**
+     * Must revalidate fresh CS/IMS/emergency and shared native-call evidence, profile/adoption and
+     * mutation exclusion immediately before entering the native send. Cached allIdle is not authority.
+     * Unresolved original writes remain in this owner's durable custody after controller retirement.
+     */
+    interface Backend { void submit(Request request, Consumer<Submission> reply); }
+
+    private static final class State {
+        final HonorImsDcRecoveryPolicy.Profile profile;
+        final HonorImsDcRecoveryPolicy policy;
+        long binding, pending;
+        boolean ready, allIdle, unknown;
+        HonorImsDcRecoveryPolicy.Change evaluation;
+        boolean whiteSeen;
+        Runnable deadline;
+        Integer submitted, refused;
+        Inputs lastInputs;
+
+        State(int slot, long profileEpoch) {
+            profile = new HonorImsDcRecoveryPolicy.Profile(slot, profileEpoch);
+            policy = new HonorImsDcRecoveryPolicy(profile);
+        }
+    }
+
+    private final Handler handler;
+    private final LongSupplier elapsed;
+    private final InputsProvider inputs;
+    private final Backend backend;
+    private final State[] states = new State[2];
+    private long nextRequest = 1;
+
+    HonorImsDcController(Handler handler, LongSupplier elapsed, InputsProvider inputs,
+            Backend backend) {
+        this.handler = Objects.requireNonNull(handler);
+        this.elapsed = Objects.requireNonNull(elapsed);
+        this.inputs = Objects.requireNonNull(inputs);
+        this.backend = Objects.requireNonNull(backend);
+        inputs.addListener(handler, () -> {
+            for (int slot = 0; slot < states.length; slot++) refresh(slot);
+        });
+    }
+
+    /** Temporary readiness loss preserves the same profile's vote, deadlines and input facts. */
+    void qualify(int slot, long profileEpoch, long binding, boolean ready, boolean allIdle) {
+        if (slot < 0 || slot >= states.length) return;
+        State state = states[slot];
+        if (profileEpoch <= 0) {
+            retire(slot);
+            return;
+        }
+        if (state == null || state.profile.identityEpoch() != profileEpoch) {
+            retire(slot);
+            state = new State(slot, profileEpoch);
+            states[slot] = state;
+        }
+        state.binding = binding;
+        state.ready = ready && binding > 0;
+        state.allIdle = allIdle;
+        refresh(slot);
+    }
+
+    void completed(HonorCompletedCallQoe.Result result) {
+        completed(result, null);
+    }
+
+    void completed(HonorCompletedCallQoe.Result result, Boolean freshlyQuiescent) {
+        if (result == null) return;
+        int slot = result.epoch().slot();
+        State state = states[slot];
+        if (state == null || !state.ready || state.binding != result.epoch().binding()
+                || state.profile.identityEpoch() != result.epoch().profile()) return;
+        if (freshlyQuiescent != null) state.allIdle = freshlyQuiescent;
+        long now = elapsed.getAsLong();
+        if (state.evaluation != null && black(result, state.evaluation.errorCode())) {
+            replace(state, state.policy.onEvaluation(state.profile, state.evaluation.token(),
+                    HonorImsDcRecoveryPolicy.EvaluationResult.FAIL, now));
+        } else if (state.evaluation != null && white(result)) {
+            // Stock time evaluation records white; it does not end or release the vote early.
+            state.whiteSeen = true;
+        }
+        Inputs observed = inputs.read(slot, state.profile.identityEpoch());
+        Integer optionalCount = observed == null ? null : observed.optionalDcCount();
+        replace(state, state.policy.onCall(state.profile, state.binding, result, optionalCount, now));
+        refresh(slot);
+    }
+
+    /** Screen-on and qualified external input changes recompute once; no polling or retry loop. */
+    void refresh(int slot) {
+        State state = states[slot];
+        if (state == null) return;
+        Inputs observed = inputs.read(slot, state.profile.identityEpoch());
+        if (!sameModeInputs(observed, state.lastInputs)) state.refused = null;
+        state.lastInputs = observed;
+        if (observed != null && Objects.equals(state.submitted, observed.configuredMode())) {
+            state.submitted = null; // Observed configured convergence, never CP-applied proof.
+        }
+        if (state.evaluation != null
+                && elapsed.getAsLong() >= state.evaluation.expiresElapsedMillis()) {
+            expire(state, state.evaluation.token());
+        }
+        if (observed == null || observed.provenance() == null
+                || observed.provenance().isEmpty() || !state.ready || !state.allIdle
+                || !observed.admissionReady() || state.unknown || state.pending != 0) return;
+        var decision = HonorImsDcModePolicy.decide(new HonorImsDcModePolicy.Inputs(
+                observed.productEligible(), observed.carrierEligible(), observed.userEnabled(),
+                observed.cityEligible(), observed.configuredMode(),
+                state.policy.recoveryDisabled()));
+        if (decision == HonorImsDcModePolicy.Decision.UNCHANGED) return;
+        int mode = decision == HonorImsDcModePolicy.Decision.ON ? 1 : 0;
+        if (Integer.valueOf(mode).equals(state.submitted)
+                || Integer.valueOf(mode).equals(state.refused) || nextRequest == Long.MAX_VALUE) {
+            return;
+        }
+        long token = nextRequest++;
+        state.pending = token;
+        backend.submit(new Request(slot, state.profile.identityEpoch(), token, mode), outcome ->
+                handler.post(() -> {
+                    if (state.pending != token) return;
+                    state.pending = 0;
+                    // External backend retains original-profile custody after retirement.
+                    if (states[slot] != state) return;
+                    if (outcome == Submission.SUBMITTED) {
+                        state.submitted = mode;
+                        refresh(slot); // Consume latest inputs that arrived during this request.
+                    } else if (outcome == Submission.UNKNOWN || outcome == null) state.unknown = true;
+                    else if (outcome == Submission.REFUSED) state.refused = mode;
+                    // DEFERRED is proven not sent; only an external readiness event retries.
+                }));
+    }
+
+    void retire(int slot) {
+        State state = states[slot];
+        states[slot] = null;
+        if (state == null) return;
+        if (state.deadline != null) handler.removeCallbacks(state.deadline);
+        state.policy.retire(); // No synthetic mode restore or native cancellation.
+    }
+
+    private void replace(State state, HonorImsDcRecoveryPolicy.Change change) {
+        if (change == null) return;
+        if (state.deadline != null) handler.removeCallbacks(state.deadline);
+        state.evaluation = change.disabled() ? change : null;
+        state.whiteSeen = false;
+        state.deadline = null;
+        if (!change.disabled()) return;
+        state.deadline = () -> {
+            if (states[state.profile.slot()] != state) return;
+            expire(state, change.token());
+            refresh(state.profile.slot());
+        };
+        handler.postDelayed(state.deadline,
+                Math.max(0, change.expiresElapsedMillis() - elapsed.getAsLong()));
+    }
+
+    private void expire(State state, long token) {
+        if (state.evaluation == null || state.evaluation.token() != token) return;
+        // Stock white only becomes SUCCESS at timeout; no-white is UNABLE, neither protects.
+        state.policy.onEvaluation(state.profile, token, state.whiteSeen
+                ? HonorImsDcRecoveryPolicy.EvaluationResult.SUCCESS
+                : HonorImsDcRecoveryPolicy.EvaluationResult.UNKNOWN, elapsed.getAsLong());
+        replace(state, state.policy.onDeadline(state.profile, token, elapsed.getAsLong()));
+    }
+
+    private static boolean white(HonorCompletedCallQoe.Result result) {
+        return baseEvaluation(result) && result.endType() == HonorCompletedCallQoe.EndType.NORMAL
+                && ims(result.domain());
+    }
+
+    private static boolean black(HonorCompletedCallQoe.Result result, Integer error) {
+        if (!baseEvaluation(result) || error == null) return false;
+        boolean setup = result.stage() == HonorCompletedCallQoe.Stage.STARTING
+                || result.stage() == HonorCompletedCallQoe.Stage.ALERTING;
+        boolean errorOrCs = result.endType() == HonorCompletedCallQoe.EndType.ERROR
+                || result.endType() == HonorCompletedCallQoe.EndType.CS;
+        return errorOrCs && error.equals(result.sipCode())
+                && (ims(result.domain()) && setup
+                        || result.domain() == HonorCompletedCallQoe.Domain.CS)
+                || error == 488 && ims(result.domain()) && setup
+                        && result.endType() == HonorCompletedCallQoe.EndType.ERROR
+                        && Integer.valueOf(488).equals(result.recvUpdateCode());
+    }
+
+    private static boolean baseEvaluation(HonorCompletedCallQoe.Result result) {
+        return result.direction() == HonorCompletedCallQoe.Direction.MO
+                && Boolean.FALSE.equals(result.dc());
+    }
+
+    private static boolean ims(HonorCompletedCallQoe.Domain domain) {
+        return domain == HonorCompletedCallQoe.Domain.VOLTE
+                || domain == HonorCompletedCallQoe.Domain.VONR
+                || domain == HonorCompletedCallQoe.Domain.EPSFB;
+    }
+
+    private static boolean sameModeInputs(Inputs a, Inputs b) {
+        return a == b || a != null && b != null
+                && Objects.equals(a.productEligible(), b.productEligible())
+                && Objects.equals(a.carrierEligible(), b.carrierEligible())
+                && Objects.equals(a.userEnabled(), b.userEnabled())
+                && Objects.equals(a.cityEligible(), b.cityEligible())
+                && Objects.equals(a.configuredMode(), b.configuredMode());
+    }
+}
diff --git a/src/com/android/internal/telephony/honor/HonorImsDcModePolicy.java b/src/com/android/internal/telephony/honor/HonorImsDcModePolicy.java
new file mode 100644
index 0000000000000000000000000000000000000000..0b20005ee47e3d04331d327e72bb1514edb520d6
--- /dev/null
+++ b/src/com/android/internal/telephony/honor/HonorImsDcModePolicy.java
@@ -0,0 +1,35 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.internal.telephony.honor;
+
+/** Combines known user/city eligibility and the independent recovery vote; no setting is written. */
+final class HonorImsDcModePolicy {
+    enum Decision { UNCHANGED, OFF, ON }
+    /**
+     * configuredMode is normalized configured/desired 0/1, not raw MTK setting 0/2 and not
+     * CP-applied state. A persistent property read alone cannot establish hardware convergence.
+     */
+    record Inputs(Boolean productEligible, Boolean carrierEligible, Boolean userEnabled,
+            Boolean cityEligible, Integer configuredMode, boolean recoveryDisabled) {}
+
+    private HonorImsDcModePolicy() {}
+
+    static Decision decide(Inputs input) {
+        if (input == null || !Boolean.TRUE.equals(input.productEligible())
+                || !Boolean.TRUE.equals(input.carrierEligible()) || input.configuredMode() == null
+                || (input.configuredMode() != 0 && input.configuredMode() != 1)) {
+            return Decision.UNCHANGED;
+        }
+        // An authoritative OFF vote does not depend on unrelated missing eligibility inputs.
+        boolean off = input.recoveryDisabled() || Boolean.FALSE.equals(input.userEnabled())
+                || Boolean.FALSE.equals(input.cityEligible());
+        if (off && input.configuredMode() == 1) return Decision.OFF;
+        if (!off && Boolean.TRUE.equals(input.userEnabled())
+                && Boolean.TRUE.equals(input.cityEligible()) && input.configuredMode() == 0) {
+            return Decision.ON;
+        }
+        return Decision.UNCHANGED;
+    }
+}
diff --git a/src/com/android/internal/telephony/honor/HonorImsDcRecoveryPolicy.java b/src/com/android/internal/telephony/honor/HonorImsDcRecoveryPolicy.java
new file mode 100644
index 0000000000000000000000000000000000000000..161bd185c635b8cb9cbb7e5463aa9373d4b63005
--- /dev/null
+++ b/src/com/android/internal/telephony/honor/HonorImsDcRecoveryPolicy.java
@@ -0,0 +1,128 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.internal.telephony.honor;
+
+import java.util.HashMap;
+import java.util.Map;
+
+/**
+ * Logical per-profile DC recovery vote, not modem state. Consumes each authorized completed-call
+ * result once from the shared producer. It owns no call matcher, observer, native request or clock.
+ * All durations below use the caller's monotonic elapsed milliseconds, never SIP wall timestamps.
+ * Process-death/native vote persistence and restore custody are outside this in-memory policy.
+ */
+final class HonorImsDcRecoveryPolicy {
+    static final long SHORT_MS = 60 * 60_000L;
+    static final long LONG_MS = 1440 * 60_000L;
+    static final long FAILED_CURE_PROTECTION_MS = 24 * 60 * 60_000L;
+
+    record Profile(int slot, long identityEpoch) {
+        Profile {
+            if (slot < 0 || slot > 1 || identityEpoch <= 0) {
+                throw new IllegalArgumentException("Unqualified profile");
+            }
+        }
+    }
+    enum EvaluationResult { SUCCESS, FAIL, UNKNOWN }
+    /**
+     * Replaces this profile's previous current token/deadline/evaluation. Clear only this
+     * recovery vote; disabled=false never means force the hardware ON.
+     */
+    record Change(Profile profile, boolean disabled, long token, long expiresElapsedMillis,
+            int evaluationId, Integer errorCode) {}
+
+    private final Profile profile;
+    private final Map<Integer, Integer> counts = new HashMap<>();
+    private boolean retired, disabled;
+    private long nextToken = 1, token, expires, protectedUntil;
+    private Integer evaluationError;
+
+    HonorImsDcRecoveryPolicy(Profile profile) {
+        this.profile = java.util.Objects.requireNonNull(profile);
+    }
+
+    /**
+     * optionalDcCount=0 is allowed only for a known zero or proven optional-service absence
+     * (the stock unbound/null-service fallback). Null/negative means unknown, not zero.
+     */
+    Change onCall(Profile current, long qualifiedNativeBinding,
+            HonorCompletedCallQoe.Result result, Integer optionalDcCount, long nowElapsedMillis) {
+        if (!current(current) || result == null || nowElapsedMillis < 0
+                || qualifiedNativeBinding <= 0 || result.epoch().slot() != profile.slot()
+                || result.epoch().profile() != profile.identityEpoch()
+                || result.epoch().binding() != qualifiedNativeBinding) return null;
+        if (result.function() == HonorCompletedCallQoe.Function.DC_NORMAL) {
+            counts.clear();
+            return clearVote();
+        }
+        if (result.function() != HonorCompletedCallQoe.Function.DC_ERROR) return null;
+        Integer error = validError(result.sipCode()) ? result.sipCode()
+                : validError(result.recvUpdateCode()) ? result.recvUpdateCode() : null;
+        if (error == null) return null;
+        // Only the ranges below 2, 3, 4 and at-least-4 affect the packaged policy.
+        int count = Math.min(4, counts.getOrDefault(error, 0) + 1);
+        counts.put(error, count);
+        // Stock increments valid failure facts before checking failed-cure protection.
+        if (nowElapsedMillis < protectedUntil || count < 2
+                || optionalDcCount == null || optionalDcCount < 0) return null;
+        long duration = count < (optionalDcCount > 0 ? 4 : 3) ? SHORT_MS : LONG_MS;
+        disabled = true;
+        token = nextToken++;
+        expires = nowElapsedMillis + duration;
+        evaluationError = error;
+        int evaluation = error == 488 ? (duration == SHORT_MS ? 501 : 502)
+                : duration == SHORT_MS ? 503 : 504;
+        return new Change(profile, true, token, expires, evaluation, error);
+    }
+
+    /** An old/superseded deadline cannot release the current profile's newer recovery vote. */
+    Change onDeadline(Profile current, long expectedToken, long nowElapsedMillis) {
+        if (!current(current) || nowElapsedMillis < 0 || !disabled || token != expectedToken
+                || nowElapsedMillis < expires) return null;
+        return clearVote();
+    }
+
+    /** Screen-on expiry fallback uses the same current deadline, without polling. */
+    Change onScreenOn(Profile current, long nowElapsedMillis) {
+        return onDeadline(current, token, nowElapsedMillis);
+    }
+
+    Change onEvaluation(Profile current, long expectedToken, EvaluationResult result,
+            long nowElapsedMillis) {
+        if (!current(current) || nowElapsedMillis < 0 || !disabled || token != expectedToken
+                || result != EvaluationResult.FAIL) return null;
+        protectedUntil = nowElapsedMillis + FAILED_CURE_PROTECTION_MS;
+        counts.remove(evaluationError);
+        return clearVote();
+    }
+
+    /** Actual profile retirement drops local work only; it never fabricates a native restore. */
+    void retire() {
+        retired = true;
+        disabled = false;
+        token = 0;
+        counts.clear();
+        evaluationError = null;
+    }
+
+    boolean recoveryDisabled() { return disabled; }
+    int errorCount(int code) { return counts.getOrDefault(code, 0); }
+
+    private Change clearVote() {
+        if (!disabled) return null;
+        Change change = new Change(profile, false, token, 0, 0, evaluationError);
+        disabled = false;
+        token = 0;
+        expires = 0;
+        evaluationError = null;
+        return change;
+    }
+    private boolean current(Profile current) {
+        return !retired && profile.equals(current);
+    }
+    private static boolean validError(Integer value) {
+        return value != null && (value == 488 || value == 503);
+    }
+}
