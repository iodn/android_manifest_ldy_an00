diff --git a/tests/host/HonorCallQosSnapshotTest.java b/tests/host/HonorCallQosSnapshotTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..b6e249846c2ba2692783a479c7585171dfd15865
--- /dev/null
+++ b/tests/host/HonorCallQosSnapshotTest.java
@@ -0,0 +1,189 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+import com.android.internal.telephony.honor.*;
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.nio.charset.StandardCharsets;
+import java.util.List;
+import static com.android.internal.telephony.honor.HonorCallQosPolicy.Domain.*;
+import static com.android.internal.telephony.honor.HonorCallQosPolicy.Status.*;
+
+public final class HonorCallQosSnapshotTest {
+    private static int checks;
+    private static void check(boolean value) {
+        checks++;
+        if (!value) throw new AssertionError("Check " + checks);
+    }
+    private static HonorMtkCallInfoDecoder.CallUpdate call(int slot, int id, int dir,
+            int domain, int status, int type) {
+        ByteBuffer b = ByteBuffer.allocate(36).order(ByteOrder.LITTLE_ENDIAN);
+        for (int n : new int[] {101,1,id+1,dir,domain,status,type,0,1}) b.putInt(n);
+        return HonorMtkCallInfoDecoder.decode(slot,1,1,b.array());
+    }
+    private static byte[] sipBytes(int type, int dir, int code, String id, String message) {
+        byte[] a = id.getBytes(StandardCharsets.US_ASCII);
+        byte[] c = message.getBytes(StandardCharsets.US_ASCII);
+        ByteBuffer b = ByteBuffer.allocate(28+a.length+c.length).order(ByteOrder.LITTLE_ENDIAN);
+        for (int n : new int[] {100,1,type,dir,code,a.length,c.length}) b.putInt(n);
+        return b.put(a).put(c).array();
+    }
+    private static HonorMtkSipDecoder.SipUpdate sip(int type, int dir, int code,
+            String id, String message) {
+        return HonorMtkSipDecoder.decode(0,1,1,sipBytes(type,dir,code,id,message));
+    }
+    private static HonorCallQosSnapshot.Change one(List<HonorCallQosSnapshot.Change> changes) {
+        check(changes.size() == 1);
+        return changes.get(0);
+    }
+    private static void singleAndUnknown() {
+        HonorCallQosSnapshot s = new HonorCallQosSnapshot(0);
+        check(s.accept(call(0,1,0,12,1008,1),0).isEmpty()); // no fabricated call on CONNECT
+        HonorCallQosSnapshot.Change c = one(s.accept(call(0,1,0,12,1001,81),0));
+        check(c.callId == 1 && c.callCount == 1 && c.emergency && c.status == STARTING);
+        c = one(s.accept(call(0,1,0,12,1001,1),0));
+        check(c.status == STARTING && c.emergency);
+        c = one(s.accept(call(0,1,0,12,1008,1),0));
+        check(c.emergency && c.domain == VOLTE && c.status == CONNECT);
+        c = one(s.accept(call(0,1,0,0,7777,1),0));
+        check(c.status == CONNECT && c.domain == VOLTE && c.emergency); // unknowns re-emit cache
+        c = one(s.accept(call(0,1,0,14,1009,1),0));
+        check(c.emergency && c.domain == VONR && c.status == CONNECT);
+        check(s.accept(call(1,2,0,12,1001,1),0).isEmpty()); // another logical slot
+        c = one(s.accept(call(0,1,0,12,1010,1),100));
+        check(c.status == DISCONNECTED && c.callCount == 1);
+        check(s.nextRemovalTime() == 1100);
+        check(s.expire(1099).isEmpty());
+        check(s.expire(1100).isEmpty()); // no remaining call means no restart event
+        check(s.nextRemovalTime() == Long.MAX_VALUE);
+    }
+    private static void multipleAndDelayedRemoval() {
+        HonorCallQosSnapshot s = new HonorCallQosSnapshot(0);
+        s.accept(call(0,1,0,12,1001,1),0);
+        s.accept(call(0,1,0,12,1008,1),0);
+        HonorCallQosSnapshot.Change c = one(s.accept(call(0,2,1,12,1001,1),10));
+        check(c.callCount == 2 && c.callId == 2);
+        c = one(s.accept(call(0,2,1,12,1010,1),20));
+        check(c.callCount == 2 && c.status == DISCONNECTED);
+        c = one(s.expire(1020));
+        check(c.callCount == 1 && c.callId == 1 && c.status == CONNECT);
+        // A new STARTING for a connected id renews it rather than retaining emergency/domain.
+        c = one(s.accept(call(0,1,0,14,1001,1),1100));
+        check(c.status == STARTING && c.domain == VONR && !c.emergency);
+    }
+    private static void lateEmergencyAndUnknownNotification() {
+        HonorCallQosSnapshot s = new HonorCallQosSnapshot(0);
+        HonorCallQosPolicy policy = new HonorCallQosPolicy();
+        s.accept(call(0,1,0,12,1001,1),0);
+        HonorCallQosSnapshot.Change c = one(s.accept(call(0,1,0,12,1008,1),10));
+        check(policy.onCallChanged(c.slot,c.callCount,c.emergency,c.domain,c.status)
+                == HonorCallQosPolicy.Decision.START);
+        // Neither enum changes: stock still notifies because Optional wrappers differ.
+        c = one(s.accept(call(0,1,0,12,1008,81),20));
+        check(c.emergency && c.status == CONNECT && c.domain == VOLTE);
+        check(policy.onCallChanged(c.slot,c.callCount,c.emergency,c.domain,c.status)
+                == HonorCallQosPolicy.Decision.STOP);
+        c = one(s.accept(call(0,1,0,0,7777,1),30));
+        check(c.emergency && c.status == CONNECT && c.domain == VOLTE);
+        check(policy.onCallChanged(c.slot,c.callCount,c.emergency,c.domain,c.status)
+                == HonorCallQosPolicy.Decision.UNCHANGED);
+    }
+    private static void zeroIdExpiryCorrection() {
+        HonorCallQosSnapshot s = new HonorCallQosSnapshot(0);
+        check(s.accept(call(0,0,0,12,1008,1),0).isEmpty());
+        check(s.nextRemovalTime() == Long.MAX_VALUE); // no incomplete CONNECT timer
+        s.accept(call(0,0,0,12,1001,1),0);
+        s.accept(call(0,0,0,12,1008,1),0);
+        s.accept(call(0,1,1,12,1001,1),10);
+        s.accept(call(0,1,1,12,1008,1),10);
+        HonorCallQosSnapshot.Change c = one(s.accept(call(0,0,0,12,1010,1),20));
+        check(c.callId == 0 && c.callCount == 2);
+        check(s.nextRemovalTime() == 1020);
+        check(s.expire(1019).isEmpty());
+        c = one(s.expire(1020));
+        check(c.callId == 1 && c.callCount == 1 && c.status == CONNECT);
+        check(s.expire(1020).isEmpty());
+        check(s.nextRemovalTime() == Long.MAX_VALUE);
+    }
+    private static void sipReconciliation() {
+        HonorCallQosSnapshot s = new HonorCallQosSnapshot(0);
+        HonorMtkSipDecoder.SipUpdate invite = sip(1,0,0,"alpha",
+                "INVITE sip:local SIP/2.0\r\nTo: <sip:local>\r\nP-Access-Network-Info: 3GPP-E-UTRAN\r\n\r\n");
+        check(invite.initialInvite && invite.domain == VOLTE);
+        HonorCallQosSnapshot.Change c = one(s.accept(invite,0));
+        check(c.callId == 0 && c.status == STARTING);
+        c = one(s.accept(invite,1)); // duplicate is observable, without a second table entry
+        check(c.callCount == 1 && c.callId == 0);
+        c = one(s.accept(call(0,3,0,14,1001,1),10)); // provisional id renamed
+        check(c.callId == 3 && c.callCount == 1 && c.domain == VONR);
+        c = one(s.accept(call(0,3,0,14,1008,1),20));
+        check(c.status == CONNECT);
+        c = one(s.accept(sip(7,0,0,"alpha","BYE sip:local SIP/2.0"),30));
+        check(c.status == CONNECT);
+        c = one(s.accept(call(0,3,0,14,1010,1),40));
+        check(c.status == DISCONNECTED && s.nextRemovalTime() == Long.MAX_VALUE);
+        // Native DISCONNECT first, then terminal SIP: timer removed immediately.
+        s.accept(invite,50);
+        s.accept(call(0,3,0,12,1001,1),60);
+        s.accept(call(0,3,0,12,1008,1),70);
+        s.accept(call(0,3,0,12,1010,1),80);
+        check(s.nextRemovalTime() == 1080);
+        c = one(s.accept(sip(7,1,200,"alpha","SIP/2.0 200 OK"),90));
+        check(c.status == DISCONNECTED);
+        check(s.nextRemovalTime() == Long.MAX_VALUE);
+        // Incoming pre-alert SIP cancellation removes the provisional call.
+        c = one(s.accept(sip(1,1,0,"incoming","INVITE sip:local SIP/2.0\r\nt: local"),100));
+        check(c.callId == 0 && c.status == STARTING);
+        c = one(s.accept(sip(4,1,0,"incoming","CANCEL sip:local SIP/2.0"),110));
+        check(c.status == DISCONNECTED && s.nextRemovalTime() == Long.MAX_VALUE);
+        // Tagged re-INVITE cannot create an absent call.
+        check(s.accept(sip(1,1,0,"tagged","INVITE\r\nTo: local;tag=123"),120).isEmpty());
+        s.clear();
+        check(s.nextRemovalTime() == Long.MAX_VALUE);
+    }
+    private static void sipBoundsAndDomain() {
+        byte[] valid = sipBytes(1,1,0,"id","INVITE\r\nTo: local");
+        check(HonorMtkSipDecoder.decode(1,1,1001,valid).slot == 1);
+        check(HonorMtkSipDecoder.decode(0,2,1,valid) == null);
+        check(HonorMtkSipDecoder.decode(0,1,3,valid) == null);
+        check(HonorMtkSipDecoder.decode(-1,1,1,valid) == null);
+        check(HonorMtkSipDecoder.decode(0,1,1,null) == null);
+        for (int n : new int[] {0,24,27,valid.length-1,valid.length+1}) {
+            check(HonorMtkSipDecoder.decode(0,1,1,java.util.Arrays.copyOf(valid,n)) == null);
+        }
+        for (int offset : new int[] {20,24}) {
+            byte[] bad = valid.clone();
+            ByteBuffer.wrap(bad).order(ByteOrder.LITTLE_ENDIAN).putInt(offset,Integer.MAX_VALUE);
+            check(HonorMtkSipDecoder.decode(0,1,1,bad) == null);
+            ByteBuffer.wrap(bad).order(ByteOrder.LITTLE_ENDIAN).putInt(offset,-1);
+            check(HonorMtkSipDecoder.decode(0,1,1,bad) == null);
+        }
+        check(sip(1,0,0,"id","To: local\r\nP-Access-Network-Info: IEEE-802.11").domain == VOWIFI);
+        check(sip(1,0,0,"id","To: local\r\nP-Access-Network-Info: 3GPP-NR").domain == VONR);
+        check(!sip(1,0,0,"id","To: local;TAG=x").initialInvite);
+        check(!sip(1,0,180,"id","To: local").initialInvite);
+        check(!sip(7,0,0,"id","To: local").initialInvite);
+        check(sip(1,0,0,"id",": \r\nTo: local").initialInvite);
+        check(sip(1,0,0,"id","To: local\r\nP-Access-Network-Info: 3GPP\r\n"
+                + "P-Access-Network-Info: unknown").domain == null);
+        // Native string lengths are BYTES, not Java UTF-16 character counts.
+        byte[] id = "ascii-call-id".getBytes(StandardCharsets.US_ASCII);
+        byte[] message = "INVITE\r\nTo: <sip:é@example>\r\nP-Access-Network-Info: 3GPP-NR"
+                .getBytes(StandardCharsets.UTF_8);
+        ByteBuffer utf8 = ByteBuffer.allocate(28 + id.length + message.length)
+                .order(ByteOrder.LITTLE_ENDIAN);
+        for (int n : new int[] {100,1,1,1,0,id.length,message.length}) utf8.putInt(n);
+        utf8.put(id).put(message);
+        HonorMtkSipDecoder.SipUpdate decoded =
+                HonorMtkSipDecoder.decode(0,1,1,utf8.array());
+        check(decoded.initialInvite && decoded.sipCallId.equals("ascii-call-id")
+                && decoded.domain == VONR);
+    }
+    public static void main(String[] args) {
+        singleAndUnknown(); multipleAndDelayedRemoval(); lateEmergencyAndUnknownNotification();
+        zeroIdExpiryCorrection();
+        sipReconciliation(); sipBoundsAndDomain();
+        System.out.println("PASS " + checks + " snapshot and SIP checks");
+    }
+}
diff --git a/tests/host/HonorCallQosTest.java b/tests/host/HonorCallQosTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..4bd92515602f9bd0caa6fb8720356ce0aa8d6459
--- /dev/null
+++ b/tests/host/HonorCallQosTest.java
@@ -0,0 +1,127 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+import com.android.internal.telephony.honor.HonorCallQosCodec;
+import com.android.internal.telephony.honor.HonorCallQosPolicy;
+import com.android.internal.telephony.honor.HonorMtkCallInfoDecoder;
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.util.Arrays;
+import static com.android.internal.telephony.honor.HonorCallQosPolicy.Decision.*;
+import static com.android.internal.telephony.honor.HonorCallQosPolicy.Domain.*;
+import static com.android.internal.telephony.honor.HonorCallQosPolicy.Status.*;
+
+public final class HonorCallQosTest {
+    private static int checks;
+    private static void check(boolean value) {
+        checks++;
+        if (!value) throw new AssertionError("Check " + checks);
+    }
+    private static byte[] frame(int direction, int domain, int status, int type, int session) {
+        ByteBuffer b = ByteBuffer.allocate(36).order(ByteOrder.LITTLE_ENDIAN);
+        for (int n : new int[] {101, 1, 7, direction, domain, status, type, 5, session}) b.putInt(n);
+        return b.array();
+    }
+    private static HonorMtkCallInfoDecoder.CallUpdate decode(byte[] frame) {
+        return HonorMtkCallInfoDecoder.decode(0, 1, 1, frame);
+    }
+    private static void policy() {
+        check(HonorCallQosPolicy.supportsPlatform("mt6993"));
+        check(HonorCallQosPolicy.supportsPlatform("MT6899"));
+        check(!HonorCallQosPolicy.supportsPlatform(null));
+        check(!HonorCallQosPolicy.supportsPlatform("unknown"));
+        HonorCallQosPolicy p = new HonorCallQosPolicy();
+        check(p.onCallChanged(0, 1, false, VOLTE, STARTING) == UNCHANGED);
+        check(p.onCallChanged(0, 1, false, VOLTE, CONNECT) == START);
+        check(p.onCallChanged(0, 1, false, VOLTE, CONNECT) == UNCHANGED);
+        check(p.onCallChanged(0, 1, false, VONR, ALERTING) == UNCHANGED);
+        check(p.onCallChanged(0, 1, false, VONR, HOLD) == STOP);
+        check(p.onCallChanged(0, 1, false, VONR, CONNECT) == START);
+        check(p.onCallChanged(1, 1, false, VODATA, CONNECT) == START);
+        check(p.stop(0) == STOP);
+        check(p.stop(0) == UNCHANGED);
+        check(p.stop(1) == STOP);
+        for (HonorCallQosPolicy.Domain d : new HonorCallQosPolicy.Domain[] {VOWIFI, CS}) {
+            check(p.onCallChanged(0, 1, false, VOLTE, CONNECT) == START);
+            check(p.onCallChanged(0, 1, false, d, CONNECT) == STOP);
+        }
+        for (int count : new int[] {0, 2, 3}) {
+            check(p.onCallChanged(0, 1, false, VOLTE, CONNECT) == START);
+            check(p.onCallChanged(0, count, false, VOLTE, CONNECT) == STOP);
+        }
+        check(p.onCallChanged(0, 1, false, INVALID, CONNECT) == START);
+        check(p.onCallChanged(0, 1, true, VOLTE, CONNECT) == STOP);
+        for (HonorCallQosPolicy.Status s :
+                new HonorCallQosPolicy.Status[] {DISCONNECTING, DISCONNECTED, null}) {
+            check(p.onCallChanged(0, 1, false, VOLTE, CONNECT) == START);
+            check(p.onCallChanged(0, 1, false, VOLTE, s) == STOP);
+        }
+        check(p.onCallChanged(0, 1, false, VOLTE, WAITING) == UNCHANGED);
+        try { p.stop(2); throw new AssertionError(); }
+        catch (IllegalArgumentException expected) { checks++; }
+        try { p.onCallChanged(0, -1, false, VOLTE, CONNECT); throw new AssertionError(); }
+        catch (IllegalArgumentException expected) { checks++; }
+    }
+    private static void decoder() {
+        HonorMtkCallInfoDecoder.CallUpdate c = decode(frame(0, 12, 1008, 1, 4));
+        check(c.callId == 6 && c.rawCallId == 7 && c.direction == 0 && c.slot == 0);
+        check(c.status == CONNECT && c.domain == VOLTE && !c.emergency && c.srvcc);
+        check(decode(frame(1, 14, 1009, 1, 4)).status == CONNECT);
+        check(decode(frame(0, 12, 1000, 1, 0)).status == STARTING);
+        check(decode(frame(1, 12, 1000, 1, 0)).status == ALERTING);
+        check(decode(frame(0, 12, 1000, 1, 0)).callId == 7);
+        check(decode(frame(0, 12, 1000, 1, 5)).status == DISCONNECTED);
+        check(decode(frame(0, 12, 7777, 1, 5)).status == null);
+        for (int type : new int[] {81, 82, 92, 99, 201, 205}) {
+            check(decode(frame(0, 12, 1008, type, 5)).emergency);
+        }
+        for (int type : new int[] {80, 93, 98, 100, 200, 206}) {
+            check(!decode(frame(0, 12, 1008, type, 5)).emergency);
+        }
+        for (int domain = 0; domain <= 25; domain++) {
+            HonorCallQosPolicy.Domain expected = INVALID;
+            if (domain >= 2 && domain <= 7) expected = VOWIFI;
+            if ((domain >= 8 && domain <= 11) || (domain >= 18 && domain <= 20)) expected = CS;
+            if (domain == 12 || domain == 13) expected = VOLTE;
+            if (domain >= 14 && domain <= 17) expected = VONR;
+            if (domain >= 21 && domain <= 24) expected = VODATA;
+            check(decode(frame(0, domain, 1008, 1, 4)).domain == expected);
+        }
+        byte[] valid = frame(0, 12, 1008, 1, 4);
+        check(HonorMtkCallInfoDecoder.decode(1, 1, 1001, valid).slot == 1);
+        check(HonorMtkCallInfoDecoder.decode(2, 1, 1, valid) == null);
+        check(HonorMtkCallInfoDecoder.decode(0, 2, 1, valid) == null);
+        check(HonorMtkCallInfoDecoder.decode(0, 1, 2, valid) == null);
+        check(decode(null) == null);
+        for (int length : new int[] {0, 4, 32, 35, 37, 40}) check(decode(Arrays.copyOf(valid, length)) == null);
+        valid[0] = 102;
+        check(decode(valid) == null);
+        valid[0] = 101; valid[4] = 2;
+        check(decode(valid) == null);
+        ByteBuffer be = ByteBuffer.allocate(36).order(ByteOrder.BIG_ENDIAN);
+        for (int n : new int[] {101, 1, 7, 0, 12, 1008, 1, 0, 4}) be.putInt(n);
+        check(decode(be.array()) == null);
+    }
+    private static void codec() {
+        byte[] start = HonorCallQosCodec.encode(true);
+        check(Arrays.equals(start, new byte[] {8,2,18,6,8,1,16,4,24,2,18,6,8,1,16,4,24,2}));
+        byte[] stop = HonorCallQosCodec.encode(false);
+        // Independent strict wire walk: service2, exactly UL and DL, all three tagged fields.
+        for (byte[] b : new byte[][] {start, stop}) {
+            check(b.length == 18 && b[0] == 8 && b[1] == 2);
+            for (int offset : new int[] {2, 10}) {
+                check(b[offset] == 18 && b[offset + 1] == 6);
+                check(b[offset + 2] == 8 && b[offset + 4] == 16 && b[offset + 6] == 24);
+            }
+        }
+        check(stop[5] == 0 && stop[7] == 0 && stop[9] == 0
+                && stop[13] == 0 && stop[15] == 0 && stop[17] == 0);
+        start[1] = 99;
+        check(HonorCallQosCodec.encode(true)[1] == 2);
+    }
+    public static void main(String[] args) {
+        policy(); decoder(); codec();
