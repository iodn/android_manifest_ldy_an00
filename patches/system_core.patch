+/* SPDX-License-Identifier: Apache-2.0 */
+#pragma once
+#include <charconv>
+#include <optional>
+#include <string>
+
+namespace android::init {
+// Kept in init so a system_server restart cannot lose the diagnostic-handler snapshot.
+class LockedResetGuard {
+ public:
+  static constexpr const char* kControl = "/sys/kernel/ldy_reset_guard/protected";
+  static constexpr const char* kDiagnostic = "/proc/sys/kernel/combine_key";
+  enum class ReadResult { OK, MISSING, ERROR };
+
+  template <typename Io> bool Apply(bool protect, Io& io) {
+    if (!io.Write(kControl, protect ? "1" : "0")) return false;
+    if (protect) {
+      if (!diagnostic_normal_) {
+        std::string value;
+        auto result = io.Read(kDiagnostic, &value);
+        if (result == ReadResult::MISSING) return true;
+        if (result != ReadResult::OK || !ValidDiagnostic(value)) return false;
+        diagnostic_normal_ = value;
+      }
+      return WriteDiagnostic("0", io);
+    }
+    if (diagnostic_normal_) {
+      if (!WriteDiagnostic(*diagnostic_normal_, io)) return false;
+      diagnostic_normal_.reset();
+    }
+    return true;
+  }
+ private:
+  static bool ValidDiagnostic(const std::string& value) {
+    int number;
+    auto result = std::from_chars(value.data(), value.data() + value.size(), number);
+    return result.ec == std::errc() && result.ptr == value.data() + value.size();
+  }
+  template <typename Io> bool WriteDiagnostic(const std::string& value, Io& io) {
+    std::string actual;
+    return io.Write(kDiagnostic, value) && io.Read(kDiagnostic, &actual) == ReadResult::OK
+        && actual == value;
+  }
+  std::optional<std::string> diagnostic_normal_;
+};
+}  // namespace android::init
